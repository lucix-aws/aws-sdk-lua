    record UpdateWorkspaceOutput
        -- The date and time of the current update.
        updateDateTime: number
    end

    -- An unexpected error has occurred.
    record InternalServerException
        message: string
    end

    -- The resource wasn't found.
    record ResourceNotFoundException
        message: string
    end

    -- The rate exceeds the limit.
    record ThrottlingException
        message: string
    end

    -- Failed
    record ValidationException
        message: string
    end

    -- Access is denied.
    record AccessDeniedException
        message: string
    end

    -- A conflict occurred.
    record ConflictException
        message: string
    end

    -- The service quota was exceeded.
    record ServiceQuotaExceededException
        message: string
    end

    -- The query timeout exception.
    record QueryTimeoutException
        message: string
    end

    -- The connector failed.
    record ConnectorFailureException
        message: string
    end

    -- The connector timed out.
    record ConnectorTimeoutException
        message: string
    end

    -- The number of tags exceeds the limit.
    record TooManyTagsException
        message: string
    end

end

return M
