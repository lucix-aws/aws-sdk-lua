        -- The revision associated with a package version.
        revision: string
        -- A string that contains the status of the package version. It can be one of the following:
        status: string
        -- A PackageVersionOrigin object that contains information
        -- about how the package version was added to the repository.
        origin: PackageVersionOrigin
    end

    record ListPackageVersionsOutput
        -- The default package version to display. This depends on the package format:
        -- For Maven and PyPI packages, it's the most recently published package version.
        -- For npm packages, it's the version referenced by the
        -- latest tag. If the latest tag is not set, it's the most recently published package version.
        defaultDisplayVersion: string
        -- A format of the package.
        format: string
        -- The namespace of the package that contains the requested package versions. The package component that specifies its
        -- namespace depends on its type. For example:
        -- The namespace of a Maven package version is its groupId.
        -- The namespace of an npm or Swift package version is its scope.
        -- The namespace of a generic package is its namespace.
        -- Python, NuGet, Ruby, and Cargo package versions do not contain a corresponding component, package versions
        -- of those formats do not have a namespace.
        namespace: string
        -- The name of the package.
        package: string
        -- The returned list of
        -- PackageVersionSummary
        -- objects.
        versions: {PackageVersionSummary}
        -- If there are additional results, this is the token for the next set of results.
        nextToken: string
    end

    record ListRepositoriesInput
        -- A prefix used to filter returned repositories. Only repositories with names that start
        -- with repositoryPrefix are returned.
        repositoryPrefix: string
        -- The maximum number of results to return per page.
        maxResults: number
        -- The token for the next set of results. Use the value returned in the previous response in the next request to retrieve the next set of results.
        nextToken: string
    end

    -- Details about a repository, including its Amazon Resource Name (ARN), description, and
    -- domain information. The ListRepositories operation returns a list of
    -- RepositorySummary objects.
    record RepositorySummary
        -- The name of the repository.
        name: string
        -- The Amazon Web Services account ID that manages the repository.
        administratorAccount: string
        -- The name of the domain that contains the repository.
        domainName: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The ARN of the repository.
        arn: string
        -- The description of the repository.
        description: string
        -- A timestamp that represents the date and time the repository was created.
        createdTime: number
    end

    record ListRepositoriesOutput
        -- The returned list of RepositorySummary
        -- objects.
        repositories: {RepositorySummary}
        -- If there are additional results, this is the token for the next set of results.
        nextToken: string
    end

    record ListRepositoriesInDomainInput
        -- The name of the domain that contains the returned list of repositories.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- Filter the list of repositories to only include those that are managed by the Amazon Web Services account ID.
        administratorAccount: string
        -- A prefix used to filter returned repositories. Only repositories with names that start with
        -- repositoryPrefix are returned.
        repositoryPrefix: string
        -- The maximum number of results to return per page.
        maxResults: number
        -- The token for the next set of results. Use the value returned in the previous response in the next request to retrieve the next set of results.
        nextToken: string
    end

    record ListRepositoriesInDomainOutput
        -- The returned list of repositories.
        repositories: {RepositorySummary}
        -- If there are additional results, this is the token for the next set of results.
        nextToken: string
    end

    record ListSubPackageGroupsInput
        -- The name of the domain which contains the package group from which to list sub package groups.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The pattern of the package group from which to list sub package groups.
        packageGroup: string
        -- The maximum number of results to return per page.
        maxResults: number
        -- The token for the next set of results. Use the value returned in the previous response in the next request to retrieve the next set of results.
        nextToken: string
    end

    record ListSubPackageGroupsOutput
        -- A list of sub package groups for the requested package group.
        packageGroups: {PackageGroupSummary}
        -- If there are additional results, this is the token for the next set of results.
        nextToken: string
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the resource to get tags for.
        resourceArn: string
    end

    record ListTagsForResourceOutput
        -- A list of tag key and value pairs associated with the specified resource.
        tags: {Tag}
    end

    record PublishPackageVersionInput
        -- The name of the domain that contains the repository that contains the package version to publish.
        domain: string
        -- The 12-digit account number of the AWS account that owns the domain. It does not include dashes or spaces.
        domainOwner: string
        -- The name of the repository that the package version will be published to.
        repository: string
        -- A format that specifies the type of the package version with the requested asset file.
        -- The only supported value is generic.
        format: string
        -- The namespace of the package version to publish.
        namespace: string
        -- The name of the package version to publish.
        package: string
        -- The package version to publish (for example, 3.5.2).
        packageVersion: string
        -- The content of the asset to publish.
        assetContent: function(): string, string
        -- The name of the asset to publish. Asset names can include Unicode letters and numbers, and
        -- the following special characters: ~ ! @ ^ & ( ) - ` _ + [ ] { } ; , .
        -- `
        assetName: string
        -- The SHA256 hash of the assetContent to publish. This value must be calculated
        -- by the caller and provided with the request (see Publishing a generic package in the CodeArtifact User
        -- Guide).
        -- This value is used as an integrity check to verify that the assetContent has
        -- not changed after it was originally sent.
        assetSHA256: string
        -- Specifies whether the package version should remain in the unfinished
        -- state. If omitted, the package version status will be set to Published (see
        -- Package version status in the CodeArtifact User Guide).
        -- Valid values: unfinished
        unfinished: boolean
    end

    record PublishPackageVersionOutput
        -- The format of the package version.
        format: string
        -- The namespace of the package version.
        namespace: string
        -- The name of the package.
        package: string
        -- The version of the package.
        version: string
        -- The revision of the package version.
        versionRevision: string
        -- A string that contains the status of the package version. For more information, see Package version status in the CodeArtifact User Guide.
        status: string
        -- An AssetSummary for the published asset.
        asset: AssetSummary
    end

    record PutDomainPermissionsPolicyInput
        -- The name of the domain on which to set the resource policy.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The current revision of the resource policy to be set. This revision is used for optimistic locking, which
        -- prevents others from overwriting your changes to the domain's resource policy.
        policyRevision: string
        -- A valid displayable JSON Aspen policy string to be set as the access control resource
        -- policy on the provided domain.
        policyDocument: string
    end

    record PutDomainPermissionsPolicyOutput
        -- The resource policy that was set after processing the request.
        policy: ResourcePolicy
    end

    record PutPackageOriginConfigurationInput
        -- The name of the domain that contains the repository that contains the package.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The name of the repository that contains the package.
        repository: string
        -- A format that specifies the type of the package to be updated.
        format: string
        -- The namespace of the package to be updated. The package component that specifies its
        -- namespace depends on its type. For example:
        -- The namespace of a Maven package version is its groupId.
        -- The namespace of an npm or Swift package version is its scope.
        -- The namespace of a generic package is its namespace.
        -- Python, NuGet, Ruby, and Cargo package versions do not contain a corresponding component, package versions
        -- of those formats do not have a namespace.
        namespace: string
        -- The name of the package to be updated.
        package: string
        -- A PackageOriginRestrictions
        -- object that contains information about the upstream and publish package origin restrictions.
        -- The upstream restriction determines if new package versions can be ingested or retained from external connections or upstream repositories.
        -- The publish restriction determines if new package versions can be published directly to the repository.
        -- You must include both the desired upstream and publish restrictions.
        restrictions: PackageOriginRestrictions
    end

    record PutPackageOriginConfigurationOutput
        -- A PackageOriginConfiguration
        -- object that describes the origin configuration set for the package. It contains a
        -- PackageOriginRestrictions
        -- object that describes how new versions of the package can be introduced to the repository.
        originConfiguration: PackageOriginConfiguration
    end

    record PutRepositoryPermissionsPolicyInput
        -- The name of the domain containing the repository to set the resource policy on.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The name of the repository to set the resource policy on.
        repository: string
        -- Sets the revision of the resource policy that specifies permissions to access the repository.
        -- This revision is used for optimistic locking, which prevents others from overwriting your
        -- changes to the repository's resource policy.
        policyRevision: string
        -- A valid displayable JSON Aspen policy string to be set as the access control resource
        -- policy on the provided repository.
        policyDocument: string
    end

    record PutRepositoryPermissionsPolicyOutput
        -- The resource policy that was set after processing the request.
        policy: ResourcePolicy
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the resource that you want to add or update tags for.
        resourceArn: string
        -- The tags you want to modify or add to the resource.
        tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource that you want to remove tags from.
        resourceArn: string
        -- The tag key for each tag that you want to remove from the resource.
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdatePackageGroupInput
        -- The name of the domain which contains the package group to be updated.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The pattern of the package group to be updated.
        packageGroup: string
        -- Contact information which you want to update the requested package group with.
        contactInfo: string
        -- The description you want to update the requested package group with.
        description: string
    end

    record UpdatePackageGroupOutput
        -- The package group and information about it after the request has been processed.
        packageGroup: PackageGroupDescription
    end

    -- Details about an allowed repository for a package group, including its name and origin configuration.
    record PackageGroupAllowedRepository
        -- The name of the allowed repository.
        repositoryName: string
        -- The origin configuration restriction type of the allowed repository.
        originRestrictionType: string
    end

    record UpdatePackageGroupOriginConfigurationInput
        -- The name of the domain which contains the package group for which to update the origin configuration.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The pattern of the package group for which to update the origin configuration.
        packageGroup: string
        -- The origin configuration settings that determine how package versions can enter repositories.
        restrictions: {string : string}
        -- The repository name and restrictions to add to the allowed repository list of the specified package group.
        addAllowedRepositories: {PackageGroupAllowedRepository}
        -- The repository name and restrictions to remove from the allowed repository list of the specified package group.
        removeAllowedRepositories: {PackageGroupAllowedRepository}
    end

    enum PackageGroupAllowedRepositoryUpdateType
        "ADDED"
        "REMOVED"
    end

    record UpdatePackageGroupOriginConfigurationOutput
        -- The package group and information about it after processing the request.
        packageGroup: PackageGroupDescription
        -- Information about the updated allowed repositories after processing the request.
        allowedRepositoryUpdates: {string : {string : {string}}}
    end

    record UpdatePackageVersionsStatusInput
        -- The name of the domain that contains the repository that contains the package versions with a status to be updated.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The repository that contains the package versions with the status you want to update.
        repository: string
        -- A format that specifies the type of the package with the statuses to update.
        format: string
        -- The namespace of the package version to be updated. The package component that specifies its
        -- namespace depends on its type. For example:
        -- The namespace of a Maven package version is its groupId.
        -- The namespace of an npm or Swift package version is its scope.
        -- The namespace of a generic package is its namespace.
        -- Python, NuGet, Ruby, and Cargo package versions do not contain a corresponding component, package versions
        -- of those formats do not have a namespace.
        namespace: string
        -- The name of the package with the version statuses to update.
        package: string
        -- An array of strings that specify the versions of the package with the statuses to update.
        versions: {string}
        -- A map of package versions and package version revisions. The map key is the
        -- package version (for example, 3.5.2), and the map value is the
        -- package version revision.
        versionRevisions: {string : string}
        -- The package version’s expected status before it is updated. If
        -- expectedStatus is provided, the package version's status is updated only if its
        -- status at the time UpdatePackageVersionsStatus is called matches
        -- expectedStatus.
        expectedStatus: string
        -- The status you want to change the package version status to.
        targetStatus: string
    end

    record UpdatePackageVersionsStatusOutput
        -- A list of PackageVersionError objects, one for each package version with
        -- a status that failed to update.
        successfulVersions: {string : SuccessfulPackageVersionInfo}
        -- A list of SuccessfulPackageVersionInfo objects, one for each package version
        -- with a status that successfully updated.
        failedVersions: {string : PackageVersionError}
    end

    record UpdateRepositoryInput
        -- The name of the domain associated with the repository to update.
        domain: string
        -- The 12-digit account number of the Amazon Web Services account that owns the domain. It does not include
        -- dashes or spaces.
        domainOwner: string
        -- The name of the repository to update.
        repository: string
        -- An updated repository description.
        description: string
        -- A list of upstream repositories to associate with the repository. The order of the upstream repositories
        -- in the list determines their priority order when CodeArtifact looks for a requested package version. For more
        -- information, see Working with upstream repositories.
        upstreams: {UpstreamRepository}
    end

    record UpdateRepositoryOutput
        -- The updated repository.
        repository: RepositoryDescription
    end

end

return M
