    -- The operation did not succeed because of an unauthorized access attempt.
    record AccessDeniedException
        message: string
    end

    -- The operation did not succeed because prerequisites are not met.
    record ConflictException
        message: string
        -- The ID of the resource.
        resourceId: string
        -- The type of Amazon Web Services resource.
        resourceType: string
    end

    -- The operation did not succeed because of an error that occurred inside CodeArtifact.
    record InternalServerException
        message: string
    end

    -- The operation did not succeed because the resource requested is not found in the service.
    record ResourceNotFoundException
        message: string
        -- The ID of the resource.
        resourceId: string
        -- The type of Amazon Web Services resource.
        resourceType: string
    end

    -- The operation did not succeed because it would have exceeded a service limit for your account.
    record ServiceQuotaExceededException
        message: string
        -- The ID of the resource.
        resourceId: string
        -- The type of Amazon Web Services resource.
        resourceType: string
    end

    -- The operation did not succeed because too many requests are sent to the service.
    record ThrottlingException
        message: string
        -- The time period, in seconds, to wait before retrying the request.
        retryAfterSeconds: number
    end

    -- The operation did not succeed because a parameter in the request was sent with an invalid value.
    record ValidationException
        message: string
        reason: string
    end

    enum AllowPublish
        "ALLOW"
        "BLOCK"
    end

    enum AllowUpstream
        "ALLOW"
        "BLOCK"
    end

    enum EndpointType
        "dualstack"
        "ipv4"
    end

    enum PackageFormat
        "npm"
        "pypi"
        "maven"
        "nuget"
        "generic"
        "ruby"
        "swift"
        "cargo"
    end

    enum PackageGroupAssociationType
        "STRONG"
        "WEAK"
    end

    enum PackageGroupOriginRestrictionType
        "EXTERNAL_UPSTREAM"
        "INTERNAL_UPSTREAM"
        "PUBLISH"
    end

    enum PackageVersionOriginType
        "INTERNAL"
        "EXTERNAL"
        "UNKNOWN"
    end

    enum PackageVersionSortType
        "PUBLISHED_TIME"
    end

    enum PackageVersionStatus
        "Published"
        "Unfinished"
        "Unlisted"
        "Archived"
        "Disposed"
        "Deleted"
    end

end

return M
