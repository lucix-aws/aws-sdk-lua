    -- The current account doesn't have the IAM permissions required to perform the specified Resolver operation.
    -- This error can also be thrown when a customer has reached the 5120 character limit for a
    -- resource policy for CloudWatch Logs.
    record AccessDeniedException
        Message: string
    end

    -- The requested state transition isn't valid. For example, you can't delete a firewall
    -- domain list if it is in the process of being deleted, or you can't import domains into a
    -- domain list that is in the process of being deleted.
    record ConflictException
        Message: string
    end

    -- We encountered an unknown error. Try again in a few minutes.
    record InternalServiceErrorException
        Message: string
    end

    -- The request caused one or more limits to be exceeded.
    record LimitExceededException
        Message: string
        -- For a LimitExceededException error, the type of resource that exceeded the current limit.
        ResourceType: string
    end

    -- The specified resource doesn't exist.
    record ResourceNotFoundException
        Message: string
        -- For a ResourceNotFoundException error, the type of resource that doesn't exist.
        ResourceType: string
    end

    -- The request was throttled. Try again in a few minutes.
    record ThrottlingException
        Message: string
    end

    -- You have provided an invalid command. If you ran the UpdateFirewallDomains request. supported values are ADD,
    -- REMOVE, or REPLACE a domain.
    record ValidationException
        Message: string
    end

    -- One or more parameters in this request are not valid.
    record InvalidParameterException
        Message: string
        -- For an InvalidParameterException error, the name of the parameter that's invalid.
        FieldName: string
    end

    -- The request is invalid.
    record InvalidRequestException
        Message: string
    end

    -- The resource that you tried to create already exists.
    record ResourceExistsException
        Message: string
        -- For a ResourceExistsException error, the type of resource that the error applies to.
        ResourceType: string
    end

    -- The specified resource isn't available.
    record ResourceUnavailableException
        Message: string
        -- For a ResourceUnavailableException error, the type of resource that isn't available.
        ResourceType: string
    end

    -- Fulfilling the request would cause one or more quotas to be exceeded.
    record ServiceQuotaExceededException
        Message: string
    end

    -- The resource that you tried to update or delete is currently in use.
    record ResourceInUseException
        Message: string
        -- For a ResourceInUseException error, the type of resource that is currently in use.
        ResourceType: string
    end

    -- The specified resource doesn't exist.
    record UnknownResourceException
        Message: string
    end

    -- The value that you specified for NextToken in a List request isn't valid.
    record InvalidNextTokenException
        Message: string
    end

    -- The specified Resolver rule policy is invalid.
    record InvalidPolicyDocument
        Message: string
    end

    -- The specified tag is invalid.
    record InvalidTagException
        Message: string
    end

    enum Action
        "ALLOW"
        "BLOCK"
        "ALERT"
    end

    enum AutodefinedReverseFlag
        "ENABLE"
        "DISABLE"
        "USE_LOCAL_RESOURCE_SETTING"
    end

    enum BlockOverrideDnsType
        "CNAME"
    end

    enum BlockResponse
        "NODATA"
        "NXDOMAIN"
        "OVERRIDE"
    end

    enum ConfidenceThreshold
        "LOW"
        "MEDIUM"
        "HIGH"
    end

    enum DnsThreatProtection
        "DGA"
        "DNS_TUNNELING"
        "DICTIONARY_DGA"
    end

    enum FirewallDomainImportOperation
        "REPLACE"
    end

    enum FirewallDomainListStatus
        "COMPLETE"
        "COMPLETE_IMPORT_FAILED"
        "IMPORTING"
        "DELETING"
        "UPDATING"
    end

    enum FirewallDomainRedirectionAction
        "INSPECT_REDIRECTION_DOMAIN"
        "TRUST_REDIRECTION_DOMAIN"
    end

    enum FirewallDomainUpdateOperation
        "ADD"
        "REMOVE"
        "REPLACE"
    end

    enum FirewallFailOpenStatus
        "ENABLED"
        "DISABLED"
        "USE_LOCAL_RESOURCE_SETTING"
    end

    enum FirewallRuleGroupAssociationStatus
        "COMPLETE"
        "DELETING"
        "UPDATING"
    end

    enum MutationProtectionStatus
        "ENABLED"
        "DISABLED"
    end

    enum ResolverEndpointDirection
        "INBOUND"
        "OUTBOUND"
        "INBOUND_DELEGATION"
    end

    enum ResolverEndpointType
        "IPV6"
        "IPV4"
        "DUALSTACK"
    end

    enum RuleTypeOption
        "FORWARD"
        "SYSTEM"
        "RECURSIVE"
        "DELEGATE"
    end

    enum SortOrder
        "ASCENDING"
        "DESCENDING"
    end

    enum Validation
        "ENABLE"
        "DISABLE"
        "USE_LOCAL_RESOURCE_SETTING"
    end

end

return M
