    record UpdateStudioSessionMappingInput
        -- The ID of the Amazon EMR Studio.
        StudioId: string
        -- The globally unique identifier (GUID) of the user or group. For more information, see
        -- UserId and GroupId in the IAM Identity Center Identity Store API
        -- Reference. Either IdentityName or IdentityId must
        -- be specified.
        IdentityId: string
        -- The name of the user or group to update. For more information, see UserName and DisplayName in the IAM Identity Center Identity Store API
        -- Reference. Either IdentityName or IdentityId must
        -- be specified.
        IdentityName: string
        -- Specifies whether the identity to update is a user or a group.
