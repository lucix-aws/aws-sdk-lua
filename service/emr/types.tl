    -- This exception occurs when there is an internal failure in the Amazon EMR
    -- service.
    record InternalServerException
        -- The message associated with the exception.
        Message: string
    end

    -- This exception occurs when there is something wrong with user input.
    record InvalidRequestException
        -- The error code associated with the exception.
        ErrorCode: string
        -- The message associated with the exception.
        Message: string
    end

    -- Indicates that an error occurred while processing the request and that the request was
    -- not completed.
    record InternalServerError
    end

    enum AuthMode
        "SSO"
        "IAM"
    end

    enum IdcUserAssignment
        "REQUIRED"
        "OPTIONAL"
    end

    enum IdentityType
        "USER"
        "GROUP"
    end

    enum InstanceFleetType
        "MASTER"
        "CORE"
        "TASK"
    end

    enum NotebookExecutionStatus
        "START_PENDING"
        "STARTING"
        "RUNNING"
        "FINISHING"
        "FINISHED"
        "FAILING"
        "FAILED"
        "STOP_PENDING"
        "STOPPING"
        "STOPPED"
    end

    enum OnClusterAppUIType
        "SparkHistoryServer"
        "YarnTimelineService"
        "TezUI"
        "ApplicationMaster"
        "JobHistoryServer"
        "ResourceManager"
    end

    enum OutputNotebookFormat
        "HTML"
    end

    enum PersistentAppUIType
        "SHS"
        "TEZ"
        "YTS"
    end

    enum ProfilerType
        "SHS"
        "TEZUI"
        "YTS"
    end

    enum RepoUpgradeOnBoot
        "SECURITY"
        "NONE"
    end

    enum ScaleDownBehavior
        "TERMINATE_AT_INSTANCE_HOUR"
        "TERMINATE_AT_TASK_COMPLETION"
    end

    enum StepCancellationOption
        "SEND_INTERRUPT"
        "TERMINATE_PROCESS"
    end

end

return M
