    -- The input fails to satisfy the constraints specified by an Amazon Web Services service.
    record BadRequestException
        Message: string
        Reason: string
        Details: BadRequestDetails
    end

    -- There was an internal failure in the AppConfig service.
    record InternalServerException
        Message: string
    end

    -- The number of one more AppConfig resources exceeds the maximum allowed. Verify that your
    -- environment doesn't exceed the following service quotas:
    -- Applications: 100 max
    -- Deployment strategies: 20 max
    -- Configuration profiles: 100 max per application
    -- Environments: 20 max per application
    -- To resolve this issue, you can delete one or more resources and try again. Or, you can
    -- request a quota increase. For more information about quotas and to request an increase, see
    -- Service quotas for AppConfig in the Amazon Web Services General Reference.
    record ServiceQuotaExceededException
        Message: string
    end

    -- The requested resource could not be found.
    record ResourceNotFoundException
        Message: string
        ResourceName: string
    end

    -- The request could not be processed because of conflict in the current state of the
    -- resource.
    record ConflictException
        Message: string
    end

    -- The configuration size is too large.
    record PayloadTooLargeException
        Message: string
        Measure: string
        Limit: number
        Size: number
    end

    enum DeletionProtectionCheck
        "ACCOUNT_DEFAULT"
        "APPLY"
        "BYPASS"
    end

    enum DeploymentState
        "BAKING"
        "VALIDATING"
        "DEPLOYING"
        "COMPLETE"
        "ROLLING_BACK"
        "ROLLED_BACK"
        "REVERTED"
    end

    enum EnvironmentState
        "READY_FOR_DEPLOYMENT"
        "DEPLOYING"
        "ROLLING_BACK"
        "ROLLED_BACK"
        "REVERTED"
    end

    enum GrowthType
        "LINEAR"
        "EXPONENTIAL"
    end

    enum ReplicateTo
        "NONE"
        "SSM_DOCUMENT"
    end

end

return M
