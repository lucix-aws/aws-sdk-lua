local record TagResourceInput
    -- The Amazon Resource Name (ARN) of the resource that you want to tag.
    ResourceArn: string
    -- The tags used to organize, track, or control access for the resource. For example, { "tags": {"key1":"value1", "key2":"value2"} }.
    Tags: {Tag}
end

local record TagResourceOutput
end

local record UntagResourceInput
    -- The Amazon Resource Name (ARN) of the resource that you want to untag.
    ResourceArn: string
    -- The keys of the key-value pairs for the tag or tags you want to remove from the specified resource.
    TagKeys: {string}
end

local record UntagResourceOutput
end

-- The request to update properties of an existing email archive.
local record UpdateArchiveInput
    -- The identifier of the archive to update.
    ArchiveId: string
    -- A new, unique name for the archive.
    ArchiveName: string
    -- A new retention period for emails in the archive.
    Retention: ArchiveRetention
end

-- The response indicating if the archive update succeeded or failed. On success, returns an HTTP 200 status code. On failure, returns an error message.
local record UpdateArchiveOutput
end

local record UpdateIngressPointInput
    -- The identifier for the ingress endpoint you want to update.
    IngressPointId: string
    -- A user friendly name for the ingress endpoint resource.
    IngressPointName: string
    -- The update status of an ingress endpoint.
    StatusToUpdate: string
    -- The identifier of an existing rule set that you attach to an ingress endpoint resource.
    RuleSetId: string
    -- The identifier of an existing traffic policy that you attach to an ingress endpoint resource.
    TrafficPolicyId: string
    -- If you choose an Authenticated ingress endpoint, you must configure either an SMTP password or a secret ARN.
    IngressPointConfiguration: IngressPointConfiguration
    -- The Transport Layer Security (TLS) policy for the ingress point. Valid values are REQUIRED, OPTIONAL. Only ingress endpoints using REQUIRED or OPTIONAL as TlsPolicy can be updated.
    TlsPolicy: string
end

local record UpdateIngressPointOutput
end

local record UpdateRelayInput
    -- The unique relay identifier.
    RelayId: string
    -- The name of the relay resource.
    RelayName: string
    -- The destination relay server address.
    ServerName: string
    -- The destination relay server port.
    ServerPort: number
    -- Authentication for the relay destination server—specify the secretARN where the SMTP credentials are stored.
    Authentication: RelayAuthentication
end

local record UpdateRelayOutput
end

local record UpdateRuleSetInput
    -- The identifier of a rule set you want to update.
    RuleSetId: string
    -- A user-friendly name for the rule set resource.
    RuleSetName: string
    -- A new set of rules to replace the current rules of the rule set—these rules will override all the rules of the rule set.
    Rules: {Rule}
end

local record UpdateRuleSetOutput
end

local record UpdateTrafficPolicyInput
    -- The identifier of the traffic policy that you want to update.
    TrafficPolicyId: string
    -- A user-friendly name for the traffic policy resource.
    TrafficPolicyName: string
    -- The list of conditions to be updated for filtering email traffic.
    PolicyStatements: {PolicyStatement}
    -- Default action instructs the traﬃc policy to either Allow or Deny (block) messages that fall outside of (or not addressed by) the conditions of your policy statements
    DefaultAction: string
    -- The maximum message size in bytes of email which is allowed in by this traffic policy—anything larger will be blocked.
    MaxMessageSizeBytes: number
end

local record UpdateTrafficPolicyOutput
end

