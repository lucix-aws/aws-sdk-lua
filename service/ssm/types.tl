    -- The OpsMetadata object exceeds the maximum number of OpsMetadata keys that you can assign to
    -- an application in Application Manager.
    record OpsMetadataKeyLimitExceededException
        message: string
    end

    -- Another UpdateResourceDataSync request is being processed. Wait a few minutes
    -- and try again.
    record ResourceDataSyncConflictException
        Message: string
    end

