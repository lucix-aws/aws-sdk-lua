        -- The date when the patch baseline was created.
        CreatedDate: number
        -- The date when the patch baseline was last modified.
        ModifiedDate: number
        -- A description of the patch baseline.
        Description: string
        -- Information about the patches to use to update the managed nodes, including target operating
        -- systems and source repositories. Applies to Linux managed nodes only.
        Sources: {PatchSource}
        -- Indicates the compliance status of managed nodes for which security-related patches are
        -- available but were not approved. This preference is specified when the
        -- CreatePatchBaseline or UpdatePatchBaseline commands are run.
        -- Applies to Windows Server managed nodes only.
        AvailableSecurityUpdatesComplianceStatus: string
    end

