        -- Sample values: WindowsServer2012 | Office 2010 |
        -- MicrosoftDefenderAntivirus
        -- PRODUCT_FAMILY
        -- Sample values: Windows | Office
        -- MSRC_SEVERITY
        -- Sample values: ServicePacks | Important | Moderate
        -- CLASSIFICATION
