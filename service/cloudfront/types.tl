    -- Access denied.
    record AccessDenied
        Message: string
    end

    -- The update contains modifications that are not allowed.
    record IllegalUpdate
        Message: string
    end

    -- An argument is invalid.
    record InvalidArgument
        Message: string
    end

    -- The specified distribution does not exist.
    record NoSuchDistribution
        Message: string
    end

    -- Your request contains more CNAMEs than are allowed per distribution.
    record TooManyDistributionCNAMEs
        Message: string
    end

    -- The entity limit has been exceeded.
    record EntityLimitExceeded
        Message: string
    end

    -- The entity was not found.
    record EntityNotFound
        Message: string
    end

    -- The If-Match version is missing or not valid.
    record InvalidIfMatchVersion
        Message: string
    end

    -- The precondition in one or more of the request fields evaluated to false.
    record PreconditionFailed
        Message: string
    end

    -- The CNAME specified is already defined for CloudFront.
    record CNAMEAlreadyExists
        Message: string
    end

    -- The caller reference you attempted to create the distribution with is associated with another distribution.
    record DistributionAlreadyExists
        Message: string
    end

    -- The specified configuration for field-level encryption can't be associated with the specified cache behavior.
    record IllegalFieldLevelEncryptionConfigAssociationWithCacheBehavior
        Message: string
    end

    -- The value of Quantity and the size of Items don't match.
    record InconsistentQuantities
        Message: string
    end

    -- The default root object file name is too big or contains an invalid character.
    record InvalidDefaultRootObject
        Message: string
    end

    -- An invalid error code was specified.
    record InvalidErrorCode
        Message: string
    end

    -- Your request contains forward cookies option which doesn't match with the expectation for the whitelisted list of cookie names. Either list of cookie names has been specified when not allowed or list of cookie names is missing when expected.
    record InvalidForwardCookies
        Message: string
    end

    -- A CloudFront function association is invalid.
    record InvalidFunctionAssociation
        Message: string
    end

    -- The specified geo restriction parameter is not valid.
    record InvalidGeoRestrictionParameter
        Message: string
    end

    -- The headers specified are not valid for an Amazon S3 origin.
    record InvalidHeadersForS3Origin
        Message: string
    end

    -- The specified Lambda@Edge function association is invalid.
    record InvalidLambdaFunctionAssociation
        Message: string
    end

    -- The location code specified is not valid.
    record InvalidLocationCode
        Message: string
    end

    -- The minimum protocol version specified is not valid.
    record InvalidMinimumProtocolVersion
        Message: string
    end

    -- The Amazon S3 origin server specified does not refer to a valid Amazon S3 bucket.
    record InvalidOrigin
        Message: string
    end

    -- The origin access control is not valid.
    record InvalidOriginAccessControl
        Message: string
    end

    -- The origin access identity is not valid or doesn't exist.
    record InvalidOriginAccessIdentity
        Message: string
    end

    -- The keep alive timeout specified for the origin is not valid.
    record InvalidOriginKeepaliveTimeout
        Message: string
    end

    -- The read timeout specified for the origin is not valid.
    record InvalidOriginReadTimeout
        Message: string
    end

    -- You cannot specify SSLv3 as the minimum protocol version if you only want to support only clients that support Server Name Indication (SNI).
    record InvalidProtocolSettings
        Message: string
    end

    -- The query string parameters specified are not valid.
    record InvalidQueryStringParameters
        Message: string
    end

    -- The relative path is too big, is not URL-encoded, or does not begin with a slash (/).
    record InvalidRelativePath
        Message: string
    end

    -- This operation requires the HTTPS protocol. Ensure that you specify the HTTPS protocol in your request, or omit the RequiredProtocols element from your distribution configuration.
    record InvalidRequiredProtocol
        Message: string
    end

    -- A response code is not valid.
    record InvalidResponseCode
