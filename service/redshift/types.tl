    -- The subscription request is invalid because it is a duplicate request. This
    -- subscription request is already in progress.
    record InvalidSubscriptionStateFault
        message: string
    end

    -- An Amazon Redshift event notification subscription with the specified name does not
    -- exist.
    record SubscriptionNotFoundFault
        message: string
    end

    -- The specified HSM client certificate is not in the available state, or
    -- it is still in use by one or more Amazon Redshift clusters.
    record InvalidHsmClientCertificateStateFault
        message: string
    end

    -- The specified HSM configuration is not in the available state, or it
    -- is still in use by one or more Amazon Redshift clusters.
    record InvalidHsmConfigurationStateFault
        message: string
    end

    -- The integration is in an invalid state and can't perform the requested operation.
    record IntegrationConflictStateFault
        message: string
    end

    -- The integration can't be found.
    record IntegrationNotFoundFault
        message: string
    end

    -- The scheduled action cannot be found.
    record ScheduledActionNotFoundFault
        message: string
    end

    -- The snapshot copy grant can't be deleted because it is used by one or more
    -- clusters.
    record InvalidSnapshotCopyGrantStateFault
        message: string
    end

    -- The specified snapshot copy grant can't be found. Make sure that the name is typed
    -- correctly and that the grant exists in the destination region.
    record SnapshotCopyGrantNotFoundFault
        message: string
    end

    -- The cluster snapshot schedule state is not valid.
    record InvalidClusterSnapshotScheduleStateFault
        message: string
    end

    -- The usage limit identifier can't be found.
    record UsageLimitNotFoundFault
        message: string
    end

    -- The owner of the specified snapshot has not authorized your account to access the
    -- snapshot.
    record AccessToSnapshotDeniedFault
        message: string
    end

    -- The reserved-node exchange status wasn't found.
    record ReservedNodeExchangeNotFoundFault
        message: string
    end

    -- The specified TableRestoreRequestId value was not found.
    record TableRestoreNotFoundFault
        message: string
    end

    -- The cluster already has cross-region snapshot copy disabled.
    record SnapshotCopyAlreadyDisabledFault
        message: string
    end

    -- Could not find the specified S3 bucket.
    record BucketNotFoundFault
        message: string
    end

    -- The cluster does not have read bucket or put object permissions on the S3 bucket
    -- specified when enabling logging.
    record InsufficientS3BucketPolicyFault
        message: string
    end

    -- The S3 bucket name is invalid. For more information about naming rules, go to
    -- Bucket
    -- Restrictions and Limitations in the Amazon Simple Storage Service (S3)
    -- Developer Guide.
    record InvalidS3BucketNameFault
        message: string
    end

    -- The string specified for the logging S3 key prefix does not comply with the
    -- documented constraints.
    record InvalidS3KeyPrefixFault
        message: string
    end

    -- Cross-region snapshot copy was temporarily disabled. Try your request
    -- again.
    record CopyToRegionDisabledFault
        message: string
    end

    -- The specified options are incompatible.
    record IncompatibleOrderableOptions
        message: string
    end

    -- The cluster already has cross-region snapshot copy enabled.
    record SnapshotCopyAlreadyEnabledFault
        message: string
    end

    -- The specified region is incorrect or does not exist.
    record UnknownSnapshotCopyRegionFault
        message: string
    end

    -- The request contains one or more invalid parameters.
    -- This error occurs when required parameters are missing,
    -- parameter values are outside acceptable ranges,
    -- or parameter formats are incorrect.
    record RedshiftInvalidParameterFault
        message: string
    end

    -- The resource policy isn't valid.
    record InvalidPolicyFault
        message: string
    end

    -- The number of tables in the cluster exceeds the limit for the requested new cluster
    -- node type.
    record TableLimitExceededFault
        message: string
    end

    -- A request option was specified that is not supported.
    record UnsupportedOptionFault
        message: string
    end

    -- Cluster is already on the latest database revision.
    record ClusterOnLatestRevisionFault
        message: string
    end

    -- A specified subnet is already in use by another cluster.
    record SubnetAlreadyInUse
        message: string
    end

    -- Cross-region snapshot copy was temporarily disabled. Try your request
    -- again.
    record SnapshotCopyDisabledFault
        message: string
    end

    -- The specified snapshot schedule is already being updated.
    record SnapshotScheduleUpdateInProgressFault
        message: string
    end

    -- Request would exceed the user's compute node quota.
    -- For information about increasing your quota, go to Limits in Amazon Redshift
    -- in the Amazon Redshift Cluster Management Guide.
    record ReservedNodeQuotaExceededFault
        message: string
    end

    -- There is a conflict while updating the resource policy.
    record ConflictPolicyUpdateFault
        message: string
    end

    -- The restore is invalid.
    record InvalidRestoreFault
        message: string
    end

    -- You have exceeded the allowed number of table restore requests. Wait for your
    -- current table restore requests to complete before making a new request.
    record InProgressTableRestoreQuotaExceededFault
        message: string
    end

    -- The value specified for the sourceDatabaseName,
    -- sourceSchemaName, or sourceTableName parameter, or a
    -- combination of these, doesn't exist in the snapshot.
    record InvalidTableRestoreArgumentFault
        message: string
    end

    -- The specified CIDR IP range or EC2 security group is not authorized for the
    -- specified cluster security group.
    record AuthorizationNotFoundFault
        message: string
    end

    -- The authorization for this endpoint can't be found.
    record EndpointAuthorizationNotFoundFault
        message: string
    end

    enum ActionType
        "restore-cluster"
        "recommend-node-config"
        "resize-cluster"
    end

    enum ApplicationType
        "None"
        "Lakehouse"
    end

    enum AquaConfigurationStatus
        "enabled"
        "disabled"
        "auto"
    end

    enum AuthorizationStatus
        "Authorized"
        "Revoking"
    end

    enum DataShareStatusForConsumer
        "ACTIVE"
        "AVAILABLE"
    end

    enum DataShareStatusForProducer
        "ACTIVE"
        "AUTHORIZED"
        "PENDING_AUTHORIZATION"
        "DEAUTHORIZED"
        "REJECTED"
    end

    enum DataShareType
        "INTERNAL"
    end

    enum LakehouseIdcRegistration
        "Associate"
        "Disassociate"
    end

    enum LakehouseRegistration
        "Register"
        "Deregister"
    end

    enum LogDestinationType
        "s3"
        "cloudwatch"
    end

    enum NamespaceRegistrationStatus
        "Registering"
        "Deregistering"
    end

    enum PartnerIntegrationStatus
        "Active"
        "Inactive"
        "RuntimeFailure"
        "ConnectionFailure"
    end

    enum ReservedNodeExchangeActionType
        "restore-cluster"
        "resize-cluster"
    end

    enum ScheduledActionState
        "ACTIVE"
        "DISABLED"
    end

    enum ScheduledActionTypeValues
        "ResizeCluster"
        "PauseCluster"
        "ResumeCluster"
    end

    enum SourceType
        "cluster"
        "cluster-parameter-group"
        "cluster-security-group"
        "cluster-snapshot"
        "scheduled-action"
    end

    enum UsageLimitBreachAction
        "log"
        "emit-metric"
        "disable"
    end

    enum UsageLimitFeatureType
        "spectrum"
        "concurrency-scaling"
        "cross-region-datasharing"
        "extra-compute-for-automatic-optimization"
    end

    enum UsageLimitLimitType
        "time"
        "data-scanned"
    end

    enum UsageLimitPeriod
        "daily"
        "weekly"
        "monthly"
    end

    enum ZeroETLIntegrationStatus
        "creating"
        "active"
        "modifying"
        "failed"
        "deleting"
        "syncing"
        "needs_attention"
    end

end

return M
