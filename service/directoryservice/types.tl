        -- The operating system (OS) version of the directory.
        OsVersion: string
        -- Contains information about the hybrid directory configuration for the directory,
        -- including Amazon Web Services System Manager managed node identifiers and DNS IPs.
        HybridSettings: HybridSettingsDescription
        -- The network type of the directory.
        NetworkType: string
    end

