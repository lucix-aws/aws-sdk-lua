    -- A client exception has occurred.
    record ClientException
        Message: string
        RequestId: string
    end

    -- The specified directory has already been shared with this Amazon Web Services account.
    record DirectoryAlreadySharedException
        Message: string
        RequestId: string
    end

    -- The specified entity could not be found.
    record EntityDoesNotExistException
        Message: string
        RequestId: string
    end

    -- One or more parameters are not valid.
    record InvalidParameterException
        Message: string
        RequestId: string
    end

    -- An exception has occurred in Directory Service.
    record ServiceException
        Message: string
        RequestId: string
    end

    -- The specified directory is unavailable.
    record DirectoryUnavailableException
        Message: string
        RequestId: string
    end

    -- The specified entity already exists.
    record EntityAlreadyExistsException
        Message: string
        RequestId: string
    end

    -- The maximum allowed number of IP addresses was exceeded. The default limit is 100 IP
    -- address blocks.
    record IpRouteLimitExceededException
        Message: string
        RequestId: string
    end

    -- You do not have sufficient access to perform this action.
    record AccessDeniedException
        Message: string
        RequestId: string
    end

    -- The Region you specified is the same Region where the Managed Microsoft AD directory was created.
    -- Specify a different Region and try again.
    record DirectoryAlreadyInRegionException
        Message: string
        RequestId: string
    end

    -- The specified directory does not exist in the system.
    record DirectoryDoesNotExistException
        Message: string
        RequestId: string
    end

    -- You have reached the limit for maximum number of simultaneous Region replications per
    -- directory.
    record RegionLimitExceededException
        Message: string
        RequestId: string
    end

    -- The operation is not supported.
    record UnsupportedOperationException
        Message: string
        RequestId: string
    end

    -- The maximum allowed number of tags was exceeded.
    record TagLimitExceededException
        Message: string
        RequestId: string
    end

    -- The maximum number of directories in the region has been reached. You can use the
    -- GetDirectoryLimits operation to determine your directory limits in
    -- the region.
    record DirectoryLimitExceededException
        Message: string
        RequestId: string
    end

    -- An authentication error occurred.
    record AuthenticationFailedException
        -- The textual message for the exception.
        Message: string
        -- The identifier of the request that caused the exception.
        RequestId: string
    end

    -- A directory assessment is automatically created when you create a hybrid directory.
    -- There are two types of assessments: CUSTOMER and SYSTEM. Your
    -- Amazon Web Services account has a limit of 100 CUSTOMER directory assessments.
    -- If you attempt to create a hybrid directory; and you already have 100
    -- CUSTOMER directory assessments;, you will encounter an error. Delete
    -- assessments to free up capacity before trying again.
    -- You can request an increase to your CUSTOMER directory assessment quota
    -- by contacting customer support or delete existing CUSTOMER directory assessments; to
    -- free up capacity.
    record ADAssessmentLimitExceededException
        Message: string
        RequestId: string
    end

    -- The account does not have sufficient permission to perform the operation.
    record InsufficientPermissionsException
        Message: string
        RequestId: string
    end

    -- The maximum number of manual snapshots for the directory has been reached. You can
    -- use the GetSnapshotLimits operation to determine the snapshot limits
    -- for a directory.
    record SnapshotLimitExceededException
        Message: string
        RequestId: string
    end

    -- The certificate is not present in the system for describe or deregister activities.
    record CertificateDoesNotExistException
        Message: string
        RequestId: string
    end

    -- The certificate is being used for the LDAP security connection and cannot be removed
    -- without disabling LDAP security.
    record CertificateInUseException
        Message: string
        RequestId: string
    end

    -- The NextToken value is not valid.
    record InvalidNextTokenException
        Message: string
        RequestId: string
    end

    -- A disable operation for CA enrollment policy is already in progress for this directory.
    record DisableAlreadyInProgressException
        Message: string
        RequestId: string
    end

    -- Client authentication is already enabled.
    record InvalidClientAuthStatusException
        Message: string
        RequestId: string
    end

    -- The directory is already updated to desired update type settings.
    record DirectoryInDesiredStateException
        Message: string
        RequestId: string
    end

    -- The LDAP activities could not be performed because they are limited by the LDAPS
    -- status.
    record InvalidLDAPSStatusException
        Message: string
        RequestId: string
    end

    -- An enable operation for CA enrollment policy is already in progress for this directory.
    record EnableAlreadyInProgressException
        Message: string
        RequestId: string
    end

    -- Client authentication setup could not be completed because at least one valid certificate
    -- must be registered in the system.
    record NoAvailableCertificateException
        Message: string
        RequestId: string
    end

    -- The certificate has already been registered into the system.
    record CertificateAlreadyExistsException
        Message: string
        RequestId: string
    end

    -- The certificate could not be added because the certificate limit has been reached.
    record CertificateLimitExceededException
        Message: string
        RequestId: string
    end

    -- The certificate PEM that was provided has incorrect encoding.
    record InvalidCertificateException
        Message: string
        RequestId: string
    end

    -- The new password provided by the user does not meet the password complexity
    -- requirements defined in your directory.
    record InvalidPasswordException
        Message: string
        RequestId: string
    end

    -- The user provided a username that does not exist in your directory.
    record UserDoesNotExistException
        Message: string
        RequestId: string
    end

    -- The specified shared target is not valid.
    record InvalidTargetException
        Message: string
        RequestId: string
    end

    -- Exception encountered while trying to access your Amazon Web Services organization.
    record OrganizationsException
        Message: string
        RequestId: string
    end

    -- The maximum number of Amazon Web Services accounts that you can share with this directory has been
    -- reached.
    record ShareLimitExceededException
        Message: string
        RequestId: string
    end

    -- The specified directory has not been shared with this Amazon Web Services account.
    record DirectoryNotSharedException
        Message: string
        RequestId: string
    end

    -- The maximum allowed number of domain controllers per directory was exceeded. The
    -- default limit per directory is 20 domain controllers.
    record DomainControllerLimitExceededException
        Message: string
        RequestId: string
    end

    -- The specified directory setting is not compatible with other settings.
    record IncompatibleSettingsException
        Message: string
        RequestId: string
    end

    -- The specified directory setting is not supported.
    record UnsupportedSettingsException
        Message: string
        RequestId: string
    end

    enum CaEnrollmentPolicyStatus
        "InProgress"
        "Success"
        "Failed"
        "Disabling"
        "Disabled"
        "Impaired"
    end

    enum CertificateType
        "ClientCertAuth"
        "ClientLDAPS"
    end

    enum ClientAuthenticationType
        "SmartCard"
        "SmartCardOrPassword"
    end

    enum DataAccessStatus
        "Disabled"
        "Disabling"
        "Enabled"
        "Enabling"
        "Failed"
    end

    enum DirectoryConfigurationStatus
        "Requested"
        "Updating"
        "Updated"
        "Failed"
        "Default"
    end

    enum DirectoryEdition
        "Enterprise"
        "Standard"
        "Hybrid"
    end

    enum DirectorySize
        "Small"
        "Large"
    end

    enum HybridUpdateType
        "SelfManagedInstances"
