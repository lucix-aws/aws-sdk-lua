    record StartADAssessmentInput
        -- Configuration parameters for the directory assessment, including DNS server
        -- information, domain name, Amazon VPC subnet, and Amazon Web Services System Manager managed node
        -- details.
        AssessmentConfiguration: AssessmentConfiguration
        -- The identifier of the directory for which to perform the assessment. This should be an
        -- existing directory. If the assessment is not for an existing directory, this parameter
        -- should be omitted.
        DirectoryId: string
    end

    record StartADAssessmentOutput
        -- The unique identifier of the newly started directory assessment. Use this identifier
        -- to monitor assessment progress and retrieve results.
        AssessmentId: string
    end

    record StartSchemaExtensionInput
        -- The identifier of the directory for which the schema extension will be applied
        -- to.
        DirectoryId: string
        -- If true, creates a snapshot of the directory before applying the schema
        -- extension.
        CreateSnapshotBeforeSchemaExtension: boolean
        -- The LDIF file represented as a string. To construct the LdifContent string, precede
        -- each line as it would be formatted in an ldif file with \n. See the example request below for
        -- more details. The file size can be no larger than 1MB.
        LdifContent: string
        -- A description of the schema extension.
        Description: string
    end

    record StartSchemaExtensionOutput
        -- The identifier of the schema extension that will be applied.
        SchemaExtensionId: string
    end

    -- Identifier that contains details about the directory consumer account with whom the
    -- directory is being unshared.
    record UnshareTarget
        -- Identifier of the directory consumer account.
        Id: string
        -- Type of identifier to be used in the Id field.
        Type: string
    end

    record UnshareDirectoryInput
        -- The identifier of the Managed Microsoft AD directory that you want to stop sharing.
        DirectoryId: string
        -- Identifier for the directory consumer account with whom the directory has to be
        -- unshared.
        UnshareTarget: UnshareTarget
    end

    record UnshareDirectoryOutput
        -- Identifier of the directory stored in the directory consumer account that is to be
        -- unshared from the specified directory (DirectoryId).
        SharedDirectoryId: string
    end

    -- Updates a conditional forwarder.
    record UpdateConditionalForwarderInput
        -- The directory ID of the Amazon Web Services directory for which to update the conditional
        -- forwarder.
        DirectoryId: string
        -- The fully qualified domain name (FQDN) of the remote domain with which you will set up
        -- a trust relationship.
        RemoteDomainName: string
        -- The updated IP addresses of the remote DNS server associated with the conditional
        -- forwarder.
        DnsIpAddrs: {string}
        -- The updated IPv6 addresses of the remote DNS server associated with the conditional
        -- forwarder.
        DnsIpv6Addrs: {string}
    end

    -- The result of an UpdateConditionalForwarder request.
    record UpdateConditionalForwarderOutput
    end

    -- Contains the directory size configuration for update operations.
    record DirectorySizeUpdateSettings
        -- The target directory size for the update operation.
        DirectorySize: string
    end

    -- Contains the network configuration for directory update operations.
    record NetworkUpdateSettings
        -- The target network type for the directory update.
        NetworkType: string
        -- IPv6 addresses of DNS servers or domain controllers in the self-managed directory.
        -- Required only when updating an AD Connector directory.
        CustomerDnsIpsV6: {string}
    end

    record UpdateDirectorySetupInput
        -- The identifier of the directory to update.
        DirectoryId: string
        -- The type of update to perform on the directory.
        UpdateType: string
        -- Operating system configuration to apply during the directory update operation.
        OSUpdateSettings: OSUpdateSettings
        -- Directory size configuration to apply during the update operation.
        DirectorySizeUpdateSettings: DirectorySizeUpdateSettings
        -- Network configuration to apply during the directory update operation.
        NetworkUpdateSettings: NetworkUpdateSettings
        -- Specifies whether to create a directory snapshot before performing the update.
        CreateSnapshotBeforeUpdate: boolean
    end

    record UpdateDirectorySetupOutput
    end

    -- Use to recover to the hybrid directory administrator account credentials.
    record HybridAdministratorAccountUpdate
        -- The Amazon Resource Name (ARN) of the Amazon Web Services Secrets Manager secret that contains the
        -- credentials for the AD administrator user, and enables hybrid domain controllers to
        -- join the managed AD domain. For example:
        -- {"customerAdAdminDomainUsername":"carlos_salazar","customerAdAdminDomainPassword":"ExamplePassword123!"}.
        SecretArn: string
    end

    -- Contains configuration settings for self-managed instances with SSM used in hybrid
    -- directory operations.
    record HybridCustomerInstancesSettings
        -- The IP addresses of the DNS servers or domain controllers in your self-managed AD
        -- environment.
        CustomerDnsIps: {string}
        -- The identifiers of the self-managed instances with SSM used in hybrid
        -- directory.
        InstanceIds: {string}
    end

    record UpdateHybridADInput
        -- The identifier of the hybrid directory to update.
        DirectoryId: string
        -- We create a hybrid directory administrator account when we create a hybrid directory.
        -- Use HybridAdministratorAccountUpdate to recover the hybrid directory
        -- administrator account if you have deleted it.
        -- To recover your hybrid directory administrator account, we need temporary access to a
        -- user in your self-managed AD with administrator permissions in the form of a secret from
        -- Amazon Web Services Secrets Manager. We use these credentials once during recovery and don't store them.
        -- If your hybrid directory administrator account exists, then you don’t need to use
        -- HybridAdministratorAccountUpdate, even if you have updated your
        -- self-managed AD administrator user.
        HybridAdministratorAccountUpdate: HybridAdministratorAccountUpdate
        -- Updates to the self-managed AD configuration, including DNS server IP addresses and
        -- Amazon Web Services System Manager managed node identifiers.
        SelfManagedInstancesSettings: HybridCustomerInstancesSettings
    end

    record UpdateHybridADOutput
        -- The identifier of the updated hybrid directory.
        DirectoryId: string
        -- The identifier of the assessment performed to validate the update configuration. This
        -- assessment ensures the updated settings are compatible with your environment.
        AssessmentId: string
    end

    -- The maximum allowed number of domain controllers per directory was exceeded. The
    -- default limit per directory is 20 domain controllers.
    record DomainControllerLimitExceededException
        Message: string
        RequestId: string
    end

    record UpdateNumberOfDomainControllersInput
        -- Identifier of the directory to which the domain controllers will be added or
        -- removed.
        DirectoryId: string
        -- The number of domain controllers desired in the directory.
        DesiredNumber: number
    end

    record UpdateNumberOfDomainControllersOutput
    end

    -- Contains the inputs for the UpdateRadius operation.
    record UpdateRadiusInput
        -- The identifier of the directory for which to update the RADIUS server
        -- information.
        DirectoryId: string
        -- A RadiusSettings object that contains information about the RADIUS
        -- server.
        RadiusSettings: RadiusSettings
    end

    -- Contains the results of the UpdateRadius operation.
    record UpdateRadiusOutput
    end

    -- The specified directory setting is not compatible with other settings.
    record IncompatibleSettingsException
        Message: string
        RequestId: string
    end

    -- The specified directory setting is not supported.
    record UnsupportedSettingsException
        Message: string
        RequestId: string
    end

    -- Contains information about the configurable settings for a directory.
    record Setting
        -- The name of the directory setting. For example:
        -- TLS_1_0
        Name: string
        -- The value of the directory setting for which to retrieve information. For example, for
        -- TLS_1_0, the valid values are: Enable and
        -- Disable.
        Value: string
    end

    record UpdateSettingsInput
        -- The identifier of the directory for which to update settings.
        DirectoryId: string
        -- The list of Setting objects.
        Settings: {Setting}
    end

    record UpdateSettingsOutput
        -- The identifier of the directory.
        DirectoryId: string
    end

    record UpdateTrustInput
        -- Identifier of the trust relationship.
        TrustId: string
        -- Updates selective authentication for the trust.
        SelectiveAuth: string
    end

    record UpdateTrustOutput
        RequestId: string
        -- Identifier of the trust relationship.
        TrustId: string
    end

    -- Initiates the verification of an existing trust relationship between an Managed Microsoft AD
    -- directory and an external domain.
    record VerifyTrustInput
        -- The unique Trust ID of the trust relationship to verify.
        TrustId: string
    end

    -- Result of a VerifyTrust request.
    record VerifyTrustOutput
        -- The unique Trust ID of the trust relationship that was verified.
        TrustId: string
    end

end

return M
