        -- and ends, and the level of confidence that Amazon Comprehend has in the accuracy of the
        -- detection.
        KeyPhrases: {KeyPhrase}
    end

    record DetectPiiEntitiesInput
        -- A UTF-8 text string. The maximum string size is 100 KB.
