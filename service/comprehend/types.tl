    -- The number of documents in the request exceeds the limit of 25. Try your request again
    -- with fewer documents.
    record BatchSizeLimitExceededException
        Message: string
    end

    -- An internal server error occurred. Retry your request.
    record InternalServerException
        Message: string
    end

    -- The request is invalid.
    record InvalidRequestException
        Message: string
        Reason: string
        Detail: InvalidRequestDetail
    end

    -- The size of the input text exceeds the limit. Use a smaller document.
    record TextSizeLimitExceededException
        Message: string
    end

    -- Amazon Comprehend can't process the language of the input text. For a list of supported languages,
    -- Supported languages in the Comprehend Developer Guide.
    record UnsupportedLanguageException
        Message: string
    end

    -- The specified resource is not available. Check the resource and try your request
    -- again.
    record ResourceUnavailableException
        Message: string
    end

    -- The specified resource name is already in use. Use a different name and try your request
    -- again.
    record ResourceInUseException
        Message: string
    end

    -- The maximum number of resources per account has been exceeded. Review the resources, and
    -- then try your request again.
    record ResourceLimitExceededException
        Message: string
    end

    -- The specified resource ARN was not found. Check the ARN and try your request again.
    record ResourceNotFoundException
        Message: string
    end

    -- The number of requests exceeds the limit. Resubmit your request later.
    record TooManyRequestsException
        Message: string
    end

    -- The request contains more tags than can be associated with a resource (50 tags per
    -- resource). The maximum number of tags includes both existing tags and those included in your
    -- current request.
    record TooManyTagsException
        Message: string
    end

    -- The KMS customer managed key (CMK) entered cannot be validated. Verify the key and
    -- re-enter it.
    record KmsKeyValidationException
        Message: string
    end

    -- The specified job was not found. Check the job ID and try again.
    record JobNotFoundException
        Message: string
    end

    -- The filter specified for the operation is invalid. Specify a different
    -- filter.
    record InvalidFilterException
        Message: string
    end

    -- Concurrent modification of the tags associated with an Amazon Comprehend resource is not
    -- supported.
    record ConcurrentModificationException
        Message: string
    end

    -- The request contains more tag keys than can be associated with a resource (50 tag keys per
    -- resource).
    record TooManyTagKeysException
        Message: string
    end

    enum DatasetType
        "TRAIN"
        "TEST"
    end

    enum DocumentClassifierMode
        "MULTI_CLASS"
        "MULTI_LABEL"
    end

    enum JobStatus
        "SUBMITTED"
        "IN_PROGRESS"
        "COMPLETED"
        "FAILED"
        "STOP_REQUESTED"
        "STOPPED"
    end

    enum LanguageCode
        "en"
        "es"
        "fr"
        "de"
        "it"
        "pt"
        "ar"
        "hi"
        "ja"
        "ko"
        "zh"
        "zh-TW"
    end

    enum ModelType
        "DOCUMENT_CLASSIFIER"
        "ENTITY_RECOGNIZER"
    end

    enum PiiEntitiesDetectionMode
        "ONLY_REDACTION"
        "ONLY_OFFSETS"
    end

    enum SentimentType
        "POSITIVE"
        "NEGATIVE"
        "NEUTRAL"
        "MIXED"
    end

    enum SyntaxLanguageCode
        "en"
        "es"
        "fr"
        "de"
        "it"
        "pt"
    end

end

return M
