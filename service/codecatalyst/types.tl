    record VerifySessionOutput
        -- The system-generated unique ID of the user in Amazon CodeCatalyst.
        identity: string
    end

    -- The request was denied because you don't have sufficient access to perform this action. Verify that you are a member of a role that allows this action.
    record AccessDeniedException
        message: string
    end

    -- The request was denied because the requested operation would cause a conflict with the current state of a service resource associated with the request.
    -- Another user might have updated the resource. Reload, make sure you have the latest data, and then try again.
    record ConflictException
        message: string
    end

    -- The request was denied because the specified resource was not found. Verify that the spelling is correct and that you have access to the resource.
    record ResourceNotFoundException
        message: string
    end

    -- The request was denied because one or more resources has reached its limits for the tier the space belongs to. Either reduce
    -- the number of resources, or change the tier if applicable.
    record ServiceQuotaExceededException
        message: string
    end

    -- The request was denied due to request throttling.
    record ThrottlingException
        message: string
    end

    -- The request was denied because an input failed to satisfy the constraints specified by the service. Check the spelling and input requirements, and then try again.
    record ValidationException
        message: string
    end

end

return M
