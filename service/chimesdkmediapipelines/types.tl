    -- The summary of the media pipeline.
    record MediaPipelineSummary
        -- The ID of the media pipeline in the summary.
        MediaPipelineId: string
        -- The ARN of the media pipeline in the summary.
        MediaPipelineArn: string
    end

    record ListMediaPipelinesOutput
        -- The media pipeline objects in the list.
        MediaPipelines: {MediaPipelineSummary}
        -- The token used to retrieve the next page of results.
        NextToken: string
    end

    record ListTagsForResourceInput
        -- The ARN of the media pipeline associated with any tags. The ARN consists of the pipeline's region, resource ID, and pipeline ID.
        ResourceARN: string
    end

    record ListTagsForResourceOutput
        -- The tags associated with the specified media pipeline.
        Tags: {Tag}
    end

    -- The task configuration settings for the Kinesis video stream source.
    record KinesisVideoStreamSourceTaskConfiguration
        -- The ARN of the stream.
        StreamArn: string
        -- The channel ID.
        ChannelId: number
        -- The unique identifier of the fragment to begin processing.
        FragmentNumber: string
    end

    record StartSpeakerSearchTaskInput
        -- The unique identifier of the resource to be updated. Valid values include the ID and ARN of the media insights pipeline.
        Identifier: string
        -- The ARN of the voice profile domain that will store the voice profile.
        VoiceProfileDomainArn: string
        -- The task configuration for the Kinesis video stream source of the media insights
        -- pipeline.
        KinesisVideoStreamSourceTaskConfiguration: KinesisVideoStreamSourceTaskConfiguration
        -- The unique identifier for the client request. Use a different token for different speaker search tasks.
        ClientRequestToken: string
    end

    record StartSpeakerSearchTaskOutput
        -- The details of the speaker search task.
        SpeakerSearchTask: SpeakerSearchTask
    end

    enum VoiceAnalyticsLanguageCode
        "en-US"
    end

    record StartVoiceToneAnalysisTaskInput
        -- The unique identifier of the resource to be updated. Valid values include the ID and ARN of the media insights pipeline.
        Identifier: string
        -- The language code.
        LanguageCode: string
        -- The task configuration for the Kinesis video stream source of the media insights
        -- pipeline.
        KinesisVideoStreamSourceTaskConfiguration: KinesisVideoStreamSourceTaskConfiguration
        -- The unique identifier for the client request. Use a different token for different voice tone analysis tasks.
        ClientRequestToken: string
    end

    record StartVoiceToneAnalysisTaskOutput
        -- The details of the voice tone analysis task.
        VoiceToneAnalysisTask: VoiceToneAnalysisTask
    end

    record StopSpeakerSearchTaskInput
        -- The unique identifier of the resource to be updated. Valid values include the ID and ARN of the media insights pipeline.
        Identifier: string
        -- The speaker search task ID.
        SpeakerSearchTaskId: string
    end

    record StopSpeakerSearchTaskOutput
    end

    record StopVoiceToneAnalysisTaskInput
        -- The unique identifier of the resource to be updated. Valid values include the ID and ARN of the media insights pipeline.
        Identifier: string
        -- The ID of the voice tone analysis task.
        VoiceToneAnalysisTaskId: string
    end

    record StopVoiceToneAnalysisTaskOutput
    end

    record TagResourceInput
        -- The ARN of the media pipeline associated with any tags. The ARN consists of the pipeline's endpoint region, resource ID, and pipeline ID.
        ResourceARN: string
        -- The tags associated with the specified media pipeline.
        Tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The ARN of the pipeline that you want to untag.
        ResourceARN: string
        -- The key/value pairs in the tag that you want to remove.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateMediaInsightsPipelineConfigurationInput
        -- The unique identifier for the resource to be updated. Valid values include the name and ARN of the media insights pipeline configuration.
        Identifier: string
        -- The ARN of the role used by the service to access Amazon Web Services resources.
        ResourceAccessRoleArn: string
        -- The configuration settings for real-time alerts for the media insights pipeline.
        RealTimeAlertConfiguration: RealTimeAlertConfiguration
        -- The elements in the request, such as a processor for Amazon Transcribe or a sink for a Kinesis Data Stream..
        Elements: {MediaInsightsPipelineConfigurationElement}
    end

    record UpdateMediaInsightsPipelineConfigurationOutput
        -- The updated configuration settings.
        MediaInsightsPipelineConfiguration: MediaInsightsPipelineConfiguration
    end

    enum MediaPipelineStatusUpdate
        "Pause"
        "Resume"
    end

    record UpdateMediaInsightsPipelineStatusInput
        -- The unique identifier of the resource to be updated. Valid values include the ID and ARN of the media insights pipeline.
        Identifier: string
        -- The requested status of the media insights pipeline.
        UpdateStatus: string
    end

    record UpdateMediaInsightsPipelineStatusOutput
    end

    -- The updated Kinesis video stream configuration object.
    record KinesisVideoStreamConfigurationUpdate
        -- The updated time that data is retained.
        DataRetentionInHours: number
    end

    record UpdateMediaPipelineKinesisVideoStreamPoolInput
        -- The unique identifier of the requested resource. Valid values include the name and ARN of the media pipeline Kinesis Video Stream pool.
        Identifier: string
        -- The configuration settings for the video stream.
        StreamConfiguration: KinesisVideoStreamConfigurationUpdate
    end

    record UpdateMediaPipelineKinesisVideoStreamPoolOutput
        -- The video stream pool configuration object.
        KinesisVideoStreamPoolConfiguration: KinesisVideoStreamPoolConfiguration
    end

end

return M
