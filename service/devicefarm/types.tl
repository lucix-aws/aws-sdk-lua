    record UpdateVPCEConfigurationInput
        -- The Amazon Resource Name (ARN) of the VPC endpoint configuration you want to
        -- update.
        arn: string
        -- The friendly name you give to your VPC endpoint configuration to manage your configurations more
        -- easily.
        vpceConfigurationName: string
        -- The name of the VPC endpoint service running in your AWS account that you want Device Farm to test.
        vpceServiceName: string
        -- The DNS (domain) name used to connect to your private service in your VPC. The DNS name must not already
        -- be in use on the internet.
        serviceDnsName: string
        -- An optional description that provides details about your VPC endpoint configuration.
        vpceConfigurationDescription: string
    end

    record UpdateVPCEConfigurationOutput
        -- An object that contains information about your VPC endpoint configuration.
        vpceConfiguration: VPCEConfiguration
    end

    -- An invalid argument was specified.
    record ArgumentException
        -- Any additional information about the exception.
        message: string
    end

    -- A limit was exceeded.
    record LimitExceededException
        -- Any additional information about the exception.
        message: string
    end

    -- The specified entity was not found.
    record NotFoundException
        -- Any additional information about the exception.
        message: string
    end

    -- There was a problem with the service account.
    record ServiceAccountException
        -- Any additional information about the exception.
        message: string
    end

    -- The operation was not successful. Try again.
    record TagOperationException
        message: string
        resourceName: string
    end

    -- An internal exception was raised in the service. Contact aws-devicefarm-support@amazon.com if you see this
    -- error.
    record InternalServiceException
        message: string
    end

    -- The requested object could not be deleted.
    record CannotDeleteException
        message: string
    end

    -- There was an error with the update request, or you do not have sufficient permissions
    -- to update this VPC endpoint configuration.
    record InvalidOperationException
        message: string
    end

    -- Exception gets thrown when a user is not eligible to perform the specified
    -- transaction.
    record NotEligibleException
        -- The HTTP response code of a Not Eligible exception.
        message: string
    end

    -- An entity with the same name already exists.
    record IdempotencyException
        -- Any additional information about the exception.
        message: string
    end

    -- The request doesn't comply with the AWS Identity and Access Management (IAM) tag
    -- policy. Correct your request and then retry it.
    record TagPolicyException
        message: string
        resourceName: string
    end

    -- The list of tags on the repository is over the limit. The maximum number of tags that
    -- can be applied to a repository is 50.
    record TooManyTagsException
        message: string
        resourceName: string
    end

