    -- This exception is thrown if the request contains a semantic error. The precise meaning depends on the API, and is documented in the error message.
    record BadRequestException
        Message: string
    end

    -- The requested operation would cause a conflict with the current state of a service resource associated with the request. Resolve the conflict before retrying this request.
    record ConflictException
        Message: string
    end

    -- You do not have sufficient access to perform this action.
    record ForbiddenException
        Message: string
    end

    -- The server encountered an internal error and is unable to complete the request.
    record InternalServerErrorException
        Message: string
    end

    -- One or more of the resources in the request does not exist in the system.
    record NotFoundException
        Message: string
    end

    -- The service is currently unavailable or busy.
    record ServiceUnavailableException
        Message: string
    end

    -- The request was denied due to request throttling.
    record TooManyRequestsException
        Message: string
    end

    -- Exception raised by Elemental MediaConnect when adding the flow output. See the error message for the operation for more information on the cause of this exception.
    record AddFlowOutputs420Exception
        Message: string
    end

    -- Exception raised by Elemental MediaConnect when creating the bridge. See the error message for the operation for more information on the cause of this exception.
    record CreateBridge420Exception
        Message: string
    end

    -- Exception raised by Elemental MediaConnect when creating the flow. See the error message for the operation for more information on the cause of this exception.
    record CreateFlow420Exception
        Message: string
    end

    -- Exception raised by Elemental MediaConnect when creating the gateway. See the error message for the operation for more information on the cause of this exception.
    record CreateGateway420Exception
        Message: string
    end

    -- The request to create a new router input would exceed the service quotas for the account.
    record RouterInputServiceQuotaExceededException
        Message: string
    end

    -- The request to create a new router network interface would exceed the service quotas (limits) set for the account.
    record RouterNetworkInterfaceServiceQuotaExceededException
        Message: string
    end

    -- The request to create a new router output would exceed the service quotas (limits) set for the account.
    record RouterOutputServiceQuotaExceededException
        Message: string
    end

    -- Exception raised by Elemental MediaConnect when granting the entitlement. See the error message for the operation for more information on the cause of this exception.
    record GrantFlowEntitlements420Exception
        Message: string
    end

    enum BridgePlacement
        "AVAILABLE"
        "LOCKED"
    end

    enum DesiredState
        "ACTIVE"
        "STANDBY"
        "DELETED"
    end

    enum EntitlementStatus
        "ENABLED"
        "DISABLED"
    end

    enum FlowSize
        "MEDIUM"
        "LARGE"
        "LARGE_4X"
    end

    enum InstanceState
        "REGISTERING"
        "ACTIVE"
        "DEREGISTERING"
        "DEREGISTERED"
        "REGISTRATION_ERROR"
        "DEREGISTRATION_ERROR"
    end

    enum MaintenanceScheduleType
        "WINDOW"
    end

    enum MediaStreamType
        "video"
        "audio"
        "ancillary-data"
    end

    enum OutputStatus
        "ENABLED"
        "DISABLED"
    end

    enum Protocol
        "zixi-push"
        "rtp-fec"
        "rtp"
        "zixi-pull"
        "rist"
        "st2110-jpegxs"
        "cdi"
        "srt-listener"
        "srt-caller"
        "fujitsu-qos"
        "udp"
        "ndi-speed-hq"
    end

    enum RouterInputState
        "CREATING"
        "STANDBY"
        "STARTING"
        "ACTIVE"
        "STOPPING"
        "DELETING"
        "UPDATING"
        "ERROR"
        "RECOVERING"
        "MIGRATING"
    end

    enum RouterInputTier
        "INPUT_100"
        "INPUT_50"
        "INPUT_20"
    end

    enum RouterNetworkInterfaceState
        "CREATING"
        "ACTIVE"
        "UPDATING"
        "DELETING"
        "ERROR"
        "RECOVERING"
    end

    enum RouterOutputRoutedState
        "ROUTED"
        "ROUTING"
        "UNROUTED"
    end

    enum RouterOutputState
        "CREATING"
        "STANDBY"
        "STARTING"
        "ACTIVE"
        "STOPPING"
        "DELETING"
        "UPDATING"
        "ERROR"
        "RECOVERING"
        "MIGRATING"
    end

    enum RouterOutputTier
        "OUTPUT_100"
        "OUTPUT_50"
        "OUTPUT_20"
    end

    enum RoutingScope
        "REGIONAL"
        "GLOBAL"
    end

    enum State
        "ENABLED"
        "DISABLED"
    end

    enum Status
        "STANDBY"
        "ACTIVE"
        "UPDATING"
        "DELETING"
        "STARTING"
        "STOPPING"
        "ERROR"
    end

end

return M
