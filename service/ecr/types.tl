        -- The Amazon Web Services account ID associated with the registry that contains the repository. If you do not specify a registry, the default registry is assumed.
        registryId: string
    end

    enum SigningStatus
        "IN_PROGRESS"
        "COMPLETE"
        "FAILED"
    end

    -- The signing status for an image. Each status corresponds to a signing profile.
    record ImageSigningStatus
        -- The ARN of the Amazon Web Services Signer signing profile used to sign the image.
        signingProfileArn: string
        -- The failure code, which is only present if status
        -- is FAILED.
        failureCode: string
        -- A description of why signing the image failed. This field is only
        -- present if status is FAILED.
        failureReason: string
        -- The image's signing status. Possible values are:
        -- IN_PROGRESS - Signing is currently in progress.
        -- COMPLETE - The signature was successfully generated.
        -- FAILED - Signing failed. See
        -- failureCode and failureReason for details.
        status: string
    end

    record DescribeImageSigningStatusOutput
        -- The name of the repository.
        repositoryName: string
        -- An object with identifying information for the image.
        imageId: ImageIdentifier
        -- The Amazon Web Services account ID associated with the registry.
        registryId: string
        -- A list of signing statuses for the specified image. Each status corresponds to a
        -- signing profile.
        signingStatuses: {ImageSigningStatus}
    end

