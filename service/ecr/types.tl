        -- The registry ID associated with the request.
        registryId: string
        -- The Amazon Resource Name (ARN) of the Amazon Web Services Secrets Manager secret associated with the pull through cache
        -- rule.
        credentialArn: string
        -- The ARN of the IAM role associated with the pull through cache rule.
