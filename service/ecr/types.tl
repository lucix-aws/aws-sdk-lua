    -- The specified parameter is invalid. Review the available parameters for the API
    -- request.
    record InvalidParameterException
        -- The error message associated with the exception.
        message: string
    end

    -- The specified repository could not be found. Check the spelling of the specified
    -- repository and ensure that you are performing operations on the correct registry.
    record RepositoryNotFoundException
        -- The error message associated with the exception.
        message: string
    end

    -- These errors are usually caused by a server-side issue.
    record ServerException
        -- The error message associated with the exception.
        message: string
    end

    -- The operation did not succeed because it would have exceeded a service limit for your
    -- account. For more information, see Amazon ECR service quotas in
    -- the Amazon Elastic Container Registry User Guide.
    record LimitExceededException
        -- The error message associated with the exception.
        message: string
    end

    -- The image or images were unable to be pulled using the pull through cache rule. This
    -- is usually caused because of an issue with the Secrets Manager secret containing the credentials
    -- for the upstream registry.
    record UnableToGetUpstreamImageException
        message: string
    end

    -- There was an exception validating this request.
    record ValidationException
        message: string
    end

    -- The specified layer upload does not contain any layer parts.
    record EmptyUploadException
        -- The error message associated with the exception.
        message: string
    end

    -- The layer digest calculation performed by Amazon ECR upon receipt of the image layer does
    -- not match the digest specified.
    record InvalidLayerException
        -- The error message associated with the exception.
        message: string
    end

    -- The operation failed due to a KMS exception.
    record KmsException
        message: string
        -- The error code returned by KMS.
        kmsError: string
    end

    -- The image layer already exists in the associated repository.
    record LayerAlreadyExistsException
        -- The error message associated with the exception.
        message: string
    end

    -- Layer parts must be at least 5 MiB in size.
    record LayerPartTooSmallException
        -- The error message associated with the exception.
        message: string
    end

    -- The upload could not be found, or the specified upload ID is not valid for this
    -- repository.
    record UploadNotFoundException
        -- The error message associated with the exception.
        message: string
    end

    -- A pull through cache rule with these settings already exists for the private
    -- registry.
    record PullThroughCacheRuleAlreadyExistsException
        message: string
    end

    -- The ARN of the secret specified in the pull through cache rule was not found. Update
    -- the pull through cache rule with a valid secret ARN and try again.
    record SecretNotFoundException
        message: string
    end

    -- The secret is unable to be accessed. Verify the resource permissions for the secret
    -- and try again.
    record UnableToAccessSecretException
        message: string
    end

    -- The secret is accessible but is unable to be decrypted. Verify the resource
    -- permisisons and try again.
    record UnableToDecryptSecretValueException
        message: string
    end

    -- The specified upstream registry isn't supported.
    record UnsupportedUpstreamRegistryException
        message: string
    end

    -- An invalid parameter has been specified. Tag keys can have a maximum character length of 128 characters, and tag values can have
    -- a maximum length of 256 characters.
    record InvalidTagParameterException
        message: string
    end

    -- The specified repository already exists in the specified registry.
    record RepositoryAlreadyExistsException
        -- The error message associated with the exception.
        message: string
    end

    -- The list of tags on the repository is over the limit. The maximum number of tags that
    -- can be applied to a repository is 50.
    record TooManyTagsException
        message: string
    end

    -- The repository creation template already exists. Specify a unique prefix and try
    -- again.
    record TemplateAlreadyExistsException
        message: string
    end

    -- The lifecycle policy could not be found, and no policy is set to the
    -- repository.
    record LifecyclePolicyNotFoundException
        message: string
    end

    -- The pull through cache rule was not found. Specify a valid pull through cache rule and
    -- try again.
    record PullThroughCacheRuleNotFoundException
        message: string
    end

    -- The registry doesn't have an associated registry policy.
    record RegistryPolicyNotFoundException
        message: string
    end

    -- The specified repository contains images. To delete a repository that contains images,
    -- you must force the deletion with the force parameter.
    record RepositoryNotEmptyException
        -- The error message associated with the exception.
        message: string
    end

    -- The specified repository creation template can't be found. Verify the registry ID and
    -- prefix and try again.
    record TemplateNotFoundException
        message: string
    end

    -- The specified repository and registry combination does not have an associated
    -- repository policy.
    record RepositoryPolicyNotFoundException
        -- The error message associated with the exception.
        message: string
    end

    -- The specified signing configuration was not found. This occurs when
    -- attempting to retrieve or delete a signing configuration that does not exist.
    record SigningConfigurationNotFoundException
        -- The error message associated with the exception.
        message: string
    end

    -- The specified pull time update exclusion was not found.
    record ExclusionNotFoundException
        message: string
    end

    -- The image requested does not exist in the specified repository.
    record ImageNotFoundException
        message: string
    end

    -- The specified image scan could not be found. Ensure that image scanning is enabled on
    -- the repository and try again.
    record ScanNotFoundException
        message: string
    end

    -- The specified layer is not available because it is not associated with an image.
    -- Unassociated image layers may be cleaned up at any time.
    record LayerInaccessibleException
        -- The error message associated with the exception.
        message: string
    end

    -- The specified layers could not be found, or the specified layer is not valid for this
    -- repository.
    record LayersNotFoundException
        -- The error message associated with the exception.
        message: string
    end

    -- There was an issue getting the upstream layer matching the pull through cache
    -- rule.
    record UnableToGetUpstreamLayerException
        message: string
    end

    -- There is no dry run for this repository.
    record LifecyclePolicyPreviewNotFoundException
        message: string
    end

    -- The referrer or referrers were unable to be listed using the pull through cache rule. This
    -- is usually caused because of an issue with the Secrets Manager secret containing the credentials
    -- for the upstream registry.
    record UnableToListUpstreamImageReferrersException
        message: string
    end

    -- The specified image has already been pushed, and there were no changes to the manifest
    -- or image tag after the last push.
    record ImageAlreadyExistsException
        -- The error message associated with the exception.
        message: string
    end

    -- The specified image digest does not match the digest that Amazon ECR calculated for the
    -- image.
    record ImageDigestDoesNotMatchException
        message: string
    end

    -- The specified image is tagged with a tag that already exists. The repository is
    -- configured for tag immutability.
    record ImageTagAlreadyExistsException
        message: string
    end

    -- The manifest list is referencing an image that does not exist.
    record ReferencedImagesNotFoundException
        message: string
    end

    -- The operation did not succeed because the account is managed by a organization policy.
    record BlockedByOrganizationPolicyException
        message: string
    end

    -- The specified pull time update exclusion already exists for the registry.
    record ExclusionAlreadyExistsException
        message: string
    end

    -- The specified image is archived and cannot be scanned.
    record ImageArchivedException
        message: string
    end

    -- The image is of a type that cannot be scanned.
    record UnsupportedImageTypeException
        message: string
    end

    -- The previous lifecycle policy preview request has not completed. Wait and try
    -- again.
    record LifecyclePolicyPreviewInProgressException
        message: string
    end

    -- The requested image storage class update is not supported.
    record ImageStorageClassUpdateNotSupportedException
        message: string
    end

    -- The layer part size is not valid, or the first byte specified is not consecutive to
    -- the last byte of a previous layer part upload.
    record InvalidLayerPartException
        -- The registry ID associated with the exception.
        registryId: string
        -- The repository name associated with the exception.
        repositoryName: string
        -- The upload ID associated with the exception.
        uploadId: string
        -- The last valid byte received from the layer part upload that is associated with the
        -- exception.
        lastValidByteReceived: number
        -- The error message associated with the exception.
        message: string
    end

    enum ImageStatus
        "ACTIVE"
        "ARCHIVED"
        "ACTIVATING"
    end

    enum ImageTagMutability
        "MUTABLE"
        "IMMUTABLE"
        "IMMUTABLE_WITH_EXCLUSION"
        "MUTABLE_WITH_EXCLUSION"
    end

    enum LifecyclePolicyPreviewStatus
        "IN_PROGRESS"
        "COMPLETE"
        "EXPIRED"
        "FAILED"
    end

    enum ScanType
        "BASIC"
        "ENHANCED"
    end

    enum TargetStorageClass
        "STANDARD"
        "ARCHIVE"
    end

    enum UpstreamRegistry
        "ecr"
        "ecr-public"
        "quay"
        "k8s"
        "docker-hub"
        "github-container-registry"
        "azure-container-registry"
        "gitlab-container-registry"
        "chainguard"
    end

end

return M
