    -- Returned when the caller doesn't have sufficient permissions to invoke the action.
    record OperationNotPermittedFault
        -- A description that may help with diagnosing the cause of the fault.
        message: string
    end

    -- Returned when the named resource cannot be found with in the scope of this operation (region or domain). This could happen if the named resource was never created or is no longer available for this operation.
    record UnknownResourceFault
        -- A description that may help with diagnosing the cause of the fault.
        message: string
    end

    -- Returned when the resource type has not been deprecated.
    record TypeNotDeprecatedFault
        message: string
    end

    -- Returned when the specified activity or workflow type was already deprecated.
    record TypeDeprecatedFault
        -- A description that may help with diagnosing the cause of the fault.
        message: string
    end

    -- Returned when the specified domain has been deprecated.
    record DomainDeprecatedFault
        -- A description that may help with diagnosing the cause of the fault.
        message: string
    end

    -- Returned by any operation if a system imposed limitation has been reached. To address this fault you should either clean up unused resources or increase the limit by contacting AWS.
    record LimitExceededFault
        -- A description that may help with diagnosing the cause of the fault.
        message: string
    end

    -- Returned if the type already exists in the specified domain. You may get this fault if you are registering a type that is either already registered or deprecated, or if you undeprecate a type that is currently registered.
    record TypeAlreadyExistsFault
        -- A description that may help with diagnosing the cause of the fault.
        message: string
    end

    -- Returned if the domain already exists. You may get this fault if you are registering a domain that is either already registered or deprecated, or if you undeprecate a domain that is currently registered.
    record DomainAlreadyExistsFault
        -- A description that may help with diagnosing the cause of the fault.
        message: string
    end

    -- You've exceeded the number of tags allowed for a domain.
    record TooManyTagsFault
        message: string
    end

    -- The StartWorkflowExecution API action was called without the required
    -- parameters set.
    -- Some workflow execution parameters, such as the decision taskList, must be
    -- set to start the execution. However, these parameters might have been set as defaults when the
    -- workflow type was registered. In this case, you can omit these parameters from the
    -- StartWorkflowExecution call and Amazon SWF uses the values defined in the workflow
    -- type.
    -- If these parameters aren't set and no default parameters were defined in the workflow
    -- type, this error is displayed.
    record DefaultUndefinedFault
        message: string
    end

    -- Returned by StartWorkflowExecution when an open execution with the same workflowId is already running in
    -- the specified domain.
    record WorkflowExecutionAlreadyStartedFault
        -- A description that may help with diagnosing the cause of the fault.
        message: string
    end

    enum ChildPolicy
        "TERMINATE"
        "REQUEST_CANCEL"
        "ABANDON"
    end

    enum RegistrationStatus
        "REGISTERED"
        "DEPRECATED"
    end

end

return M
