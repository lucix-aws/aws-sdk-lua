    fieldList: {ValidationExceptionField}
end

-- You do not have sufficient access to perform this action.
local record AccessDeniedException
    message: string
end

-- The server encountered an internal error and is unable to complete the request.
local record InternalServerException
    message: string
    -- The number of seconds to wait before retrying the next request.
    retryAfterSeconds: number
end

-- The resource specified in the request was not found.
local record ResourceNotFoundException
    message: string
    -- The ID of the resource associated with the request.
    resourceId: string
    -- The type of the resource associated with the request.
    resourceType: string
end

-- The request was denied due to request throttling.
local record ThrottlingException
    message: string
    -- The code for the service in Service Quotas.
    serviceCode: string
    -- The code for the quota in Service Quotas.
    quotaCode: string
    -- The number of seconds to wait before retrying the next request.
    retryAfterSeconds: number
end

-- The input fails to satisfy the specified constraints.
local record ValidationException
    message: string
    -- The reason for the exception.
    reason: string
    -- A list of fields that didn't validate.
    fieldList: {ValidationExceptionField}
end

local type SoftwareSetUpdateMode = "USE_LATEST" | "USE_DESIRED"

local type SoftwareSetUpdateSchedule = "USE_MAINTENANCE_WINDOW" | "APPLY_IMMEDIATELY"

local type SoftwareSetValidationStatus = "VALIDATED" | "NOT_VALIDATED"

local type TargetDeviceStatus = "DEREGISTERED" | "ARCHIVED"

