    record MaintenanceSchedule
        -- The time the scheduled maintenance is to start.
        startTime: number
        -- The time the scheduled maintenance is to end.
        endTime: number
    end

    -- The scheduled maintenance for a runtime engine.
    record PendingMaintenance
        -- The maintenance schedule for the runtime engine version.
        schedule: MaintenanceSchedule
        -- The specific runtime engine that the maintenance schedule applies to.
        engineVersion: string
    end

    enum EnvironmentLifecycle
        "Creating"
        "Available"
        "Updating"
        "Deleting"
        "Failed"
        "UnHealthy"
    end

    record GetEnvironmentOutput
        -- The name of the runtime environment. Must be unique within the account.
        name: string
        -- The description of the runtime environment.
        description: string
        -- The Amazon Resource Name (ARN) of the runtime environment.
        environmentArn: string
        -- The unique identifier of the runtime environment.
        environmentId: string
        -- The type of instance underlying the runtime environment.
        instanceType: string
        -- The status of the runtime environment. If the Amazon Web Services Mainframe Modernization environment is missing a connection to
        -- the customer owned dependent resource, the status will be Unhealthy.
        status: string
        -- The target platform for the runtime environment.
        engineType: string
        -- The version of the runtime engine.
        engineVersion: string
        -- The unique identifier for the VPC used with this runtime environment.
        vpcId: string
        -- The unique identifiers of the subnets assigned to this runtime environment.
        subnetIds: {string}
        -- The unique identifiers of the security groups assigned to this runtime
        -- environment.
        securityGroupIds: {string}
        -- The timestamp when the runtime environment was created.
        creationTime: number
        -- The storage configurations defined for the runtime environment.
        storageConfigurations: {StorageConfiguration}
        -- The tags defined for this runtime environment.
        tags: {string : string}
        -- The desired capacity of the high availability configuration for the runtime
        -- environment.
        highAvailabilityConfig: HighAvailabilityConfig
        -- Whether applications running in this runtime environment are publicly accessible.
        publiclyAccessible: boolean
        -- The number of instances included in the runtime environment. A standalone runtime
        -- environment has a maximum of one instance. Currently, a high availability runtime
        -- environment has a maximum of two instances.
        actualCapacity: number
        -- The Amazon Resource Name (ARN) for the load balancer used with the runtime
        -- environment.
        loadBalancerArn: string
        -- The reason for the reported status.
        statusReason: string
        -- The maintenance window for the runtime environment. If you don't
        -- provide a value for the maintenance window, the service assigns a random value.
        preferredMaintenanceWindow: string
        -- Indicates the pending maintenance scheduled on this environment.
        pendingMaintenance: PendingMaintenance
        -- The identifier of a customer managed key.
        kmsKeyId: string
        -- The network type supported by the runtime environment.
        networkType: string
    end

    record ListEnvironmentsInput
        -- A pagination token to control the number of runtime environments displayed in the
        -- list.
        nextToken: string
        -- The maximum number of runtime environments to return.
        maxResults: number
        -- The names of the runtime environments. Must be unique within the account.
        names: {string}
