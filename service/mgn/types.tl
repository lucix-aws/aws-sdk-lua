    record ConflictException
        message: string
        code: string
        -- A conflict occurred when prompting for the Resource ID.
        resourceId: string
        -- A conflict occurred when prompting for resource type.
        resourceType: string
        -- Conflict Exception specific errors.
        errors: {ErrorDetails}
    end

    -- Resource not found exception.
    record ResourceNotFoundException
        message: string
        code: string
        -- Resource ID not found error.
        resourceId: string
        -- Resource type not found error.
        resourceType: string
    end

    -- The request could not be completed because its exceeded the service quota.
    record ServiceQuotaExceededException
        message: string
        code: string
        -- Exceeded the service quota resource ID.
        resourceId: string
        -- Exceeded the service quota resource type.
        resourceType: string
        -- Exceeded the service quota service code.
        serviceCode: string
        -- Exceeded the service quota code.
        quotaCode: string
        -- Exceeded the service quota value.
        quotaValue: number
    end

    -- Uninitialized account exception.
    record UninitializedAccountException
        message: string
        code: string
    end

    -- Validate exception.
    record ValidationException
        message: string
        code: string
        -- Validate exception reason.
        reason: string
        -- Validate exception field list.
        fieldList: {ValidationExceptionField}
    end

    -- Operating denied due to a file permission or access check error.
    record AccessDeniedException
        message: string
        code: string
    end

    -- Reached throttling quota exception.
    record ThrottlingException
        message: string
        -- Reached throttling quota exception service code.
        serviceCode: string
        -- Reached throttling quota exception.
        quotaCode: string
        -- Reached throttling quota exception will retry after x seconds.
        retryAfterSeconds: string
    end

    -- The server encountered an unexpected condition that prevented it from fulfilling the request.
    record InternalServerException
        message: string
        -- The server encountered an unexpected condition that prevented it from fulfilling the request. The request will be retried again after x seconds.
        retryAfterSeconds: number
    end

