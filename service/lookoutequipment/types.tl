    end

    -- Contains information about the specific data set, including name, ARN, and status.
    record DatasetSummary
        -- The name of the dataset.
        DatasetName: string
        -- The Amazon Resource Name (ARN) of the specified dataset.
        DatasetArn: string
        -- Indicates the status of the dataset.
        Status: string
        -- The time at which the dataset was created in Amazon Lookout for Equipment.
        CreatedAt: number
    end

    record ListDatasetsOutput
        -- An opaque pagination token indicating where to continue the listing of datasets.
        NextToken: string
        -- Provides information about the specified dataset, including creation time, dataset ARN,
        -- and status.
        DatasetSummaries: {DatasetSummary}
    end

    record ListInferenceEventsInput
        -- An opaque pagination token indicating where to continue the listing of inference
        -- events.
        NextToken: string
        -- Specifies the maximum number of inference events to list.
        MaxResults: number
        -- The name of the inference scheduler for the inference events listed.
        InferenceSchedulerName: string
        -- Lookout for Equipment will return all the inference events with an end time equal to or greater than
        -- the start time given.
        IntervalStartTime: number
        -- Returns all the inference events with an end start time equal to or greater than less
        -- than the end time given.
        IntervalEndTime: number
    end

    -- Contains information about the specific inference event, including start and end time,
    -- diagnostics information, event duration and so on.
    record InferenceEventSummary
        -- The Amazon Resource Name (ARN) of the inference scheduler being used for the inference
        -- event.
        InferenceSchedulerArn: string
        -- The name of the inference scheduler being used for the inference events.
        InferenceSchedulerName: string
        -- Indicates the starting time of an inference event.
        EventStartTime: number
        -- Indicates the ending time of an inference event.
        EventEndTime: number
        -- An array which specifies the names and values of all sensors contributing to an
