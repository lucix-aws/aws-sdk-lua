        Diagnostics: string
        -- Indicates the size of an inference event in seconds.
        EventDurationInSeconds: number
    end

    record ListInferenceEventsOutput
        -- An opaque pagination token indicating where to continue the listing of inference
        -- executions.
        NextToken: string
        -- Provides an array of information about the individual inference events returned from the
        -- ListInferenceEvents operation, including scheduler used, event start time,
        -- event end time, diagnostics, and so on.
        InferenceEventSummaries: {InferenceEventSummary}
    end

    enum InferenceExecutionStatus
        "IN_PROGRESS"
        "SUCCESS"
        "FAILED"
    end

    record ListInferenceExecutionsInput
        -- An opaque pagination token indicating where to continue the listing of inference
        -- executions.
        NextToken: string
        -- Specifies the maximum number of inference executions to list.
        MaxResults: number
        -- The name of the inference scheduler for the inference execution listed.
        InferenceSchedulerName: string
        -- The time reference in the inferenced dataset after which Amazon Lookout for Equipment started the inference
        -- execution.
