    -- Contains information about the specific inference execution, including input and output
    -- data configuration, inference scheduling information, status, and so on.
    record InferenceExecutionSummary
        -- The name of the machine learning model being used for the inference execution.
        ModelName: string
        -- The Amazon Resource Name (ARN) of the machine learning model used for the inference
        -- execution.
        ModelArn: string
        -- The name of the inference scheduler being used for the inference execution.
        InferenceSchedulerName: string
        -- The Amazon Resource Name (ARN) of the inference scheduler being used for the inference
        -- execution.
        InferenceSchedulerArn: string
        -- Indicates the start time at which the inference scheduler began the specific inference
        -- execution.
        ScheduledStartTime: number
        -- Indicates the time reference in the dataset at which the inference execution began.
        DataStartTime: number
        -- Indicates the time reference in the dataset at which the inference execution stopped.
        DataEndTime: number
        -- Specifies configuration information for the input data for the inference scheduler,
        -- including delimiter, format, and dataset location.
        DataInputConfiguration: InferenceInputConfiguration
        -- Specifies configuration information for the output results from for the inference
        -- execution, including the output Amazon S3 location.
        DataOutputConfiguration: InferenceOutputConfiguration
        -- The S3 object that the inference execution results were uploaded to.
        CustomerResultObject: S3Object
        -- Indicates the status of the inference execution.
        Status: string
        -- Specifies the reason for failure when an inference execution has failed.
        FailedReason: string
        -- The model version used for the inference execution.
        ModelVersion: number
        -- The Amazon Resource Number (ARN) of the model version used for the inference
        -- execution.
        ModelVersionArn: string
    end

    record ListInferenceExecutionsOutput
        -- An opaque pagination token indicating where to continue the listing of inference
        -- executions.
        NextToken: string
        -- Provides an array of information about the individual inference executions returned from
        -- the ListInferenceExecutions operation, including model used, inference
        -- scheduler, data configuration, and so on.
        -- If you don't supply the InferenceSchedulerName request parameter, or
        -- if you supply the name of an inference scheduler that doesn't exist,
        -- ListInferenceExecutions returns an empty array in
        -- InferenceExecutionSummaries.
        InferenceExecutionSummaries: {InferenceExecutionSummary}
    end

    record ListInferenceSchedulersInput
        -- An opaque pagination token indicating where to continue the listing of inference
        -- schedulers.
        NextToken: string
        -- Specifies the maximum number of inference schedulers to list.
        MaxResults: number
        -- The beginning of the name of the inference schedulers to be listed.
        InferenceSchedulerNameBeginsWith: string
        -- The name of the machine learning model used by the inference scheduler to be listed.
        ModelName: string
        -- Specifies the current status of the inference schedulers.
        Status: string
    end

    -- Contains information about the specific inference scheduler, including data delay
    -- offset, model name and ARN, status, and so on.
    record InferenceSchedulerSummary
        -- The name of the machine learning model used for the inference scheduler.
        ModelName: string
        -- The Amazon Resource Name (ARN) of the machine learning model used by the inference
        -- scheduler.
        ModelArn: string
        -- The name of the inference scheduler.
        InferenceSchedulerName: string
        -- The Amazon Resource Name (ARN) of the inference scheduler.
        InferenceSchedulerArn: string
        -- Indicates the status of the inference scheduler.
        Status: string
        -- A period of time (in minutes) by which inference on the data is delayed after the data
        -- starts. For instance, if an offset delay time of five minutes was selected, inference will
        -- not begin on the data until the first data measurement after the five minute mark. For
        -- example, if five minutes is selected, the inference scheduler will wake up at the
        -- configured frequency with the additional five minute delay time to check the customer S3
        -- bucket. The customer can upload data at the same frequency and they don't need to stop and
        -- restart the scheduler when uploading new data.
        DataDelayOffsetInMinutes: number
        -- How often data is uploaded to the source S3 bucket for the input data. This value is the
        -- length of time between data uploads. For instance, if you select 5 minutes, Amazon Lookout
        -- for Equipment will upload the real-time data to the source bucket once every 5 minutes.
        -- This frequency also determines how often Amazon Lookout for Equipment starts a scheduled inference on your
        -- data. In this example, it starts once every 5 minutes.
        DataUploadFrequency: string
        -- Indicates whether the latest execution for the inference scheduler was Anomalous
        -- (anomalous events found) or Normal (no anomalous events found).
        LatestInferenceResult: string
    end

    record ListInferenceSchedulersOutput
        -- An opaque pagination token indicating where to continue the listing of inference
        -- schedulers.
        NextToken: string
        -- Provides information about the specified inference scheduler, including data upload
        -- frequency, model name and ARN, and status.
        InferenceSchedulerSummaries: {InferenceSchedulerSummary}
    end

    record ListLabelGroupsInput
        -- The beginning of the name of the label groups to be listed.
        LabelGroupNameBeginsWith: string
        -- An opaque pagination token indicating where to continue the listing of label groups.
        NextToken: string
        -- Specifies the maximum number of label groups to list.
        MaxResults: number
    end

    -- Contains information about the label group.
    record LabelGroupSummary
        -- The name of the label group.
        LabelGroupName: string
        -- The Amazon Resource Name (ARN) of the label group.
        LabelGroupArn: string
        -- The time at which the label group was created.
        CreatedAt: number
        -- The time at which the label group was updated.
        UpdatedAt: number
    end

    record ListLabelGroupsOutput
        -- An opaque pagination token indicating where to continue the listing of label groups.
        NextToken: string
        -- A summary of the label groups.
        LabelGroupSummaries: {LabelGroupSummary}
    end

    record ListLabelsInput
        -- Returns the name of the label group.
        LabelGroupName: string
        -- Returns all the labels with a end time equal to or later than the start time given.
        IntervalStartTime: number
        -- Returns all labels with a start time earlier than the end time given.
        IntervalEndTime: number
        -- Returns labels with a particular fault code.
        FaultCode: string
        -- Lists the labels that pertain to a particular piece of equipment.
        Equipment: string
        -- An opaque pagination token indicating where to continue the listing of label groups.
        NextToken: string
        -- Specifies the maximum number of labels to list.
        MaxResults: number
    end

    -- Information about the label.
    record LabelSummary
        -- The name of the label group.
        LabelGroupName: string
        -- The ID of the label.
        LabelId: string
        -- The Amazon Resource Name (ARN) of the label group.
        LabelGroupArn: string
        -- The timestamp indicating the start of the label.
        StartTime: number
        -- The timestamp indicating the end of the label.
        EndTime: number
        -- Indicates whether a labeled event represents an anomaly.
        Rating: string
        -- Indicates the type of anomaly associated with the label.
        -- Data in this field will be retained for service usage. Follow best practices for the
        -- security of your data.
        FaultCode: string
        -- Indicates that a label pertains to a particular piece of equipment.
        Equipment: string
        -- The time at which the label was created.
        CreatedAt: number
    end

    record ListLabelsOutput
        -- An opaque pagination token indicating where to continue the listing of datasets.
        NextToken: string
        -- A summary of the items in the label group.
        -- If you don't supply the LabelGroupName request parameter, or if you supply
        -- the name of a label group that doesn't exist, ListLabels returns an empty array in
        -- LabelSummaries.
        LabelSummaries: {LabelSummary}
    end

    record ListModelsInput
        -- An opaque pagination token indicating where to continue the listing of machine learning
        -- models.
        NextToken: string
        -- Specifies the maximum number of machine learning models to list.
        MaxResults: number
        -- The status of the machine learning model.
        Status: string
        -- The beginning of the name of the machine learning models being listed.
        ModelNameBeginsWith: string
        -- The beginning of the name of the dataset of the machine learning models to be listed.
        DatasetNameBeginsWith: string
    end

    -- Provides information about the specified machine learning model, including dataset and
    -- model names and ARNs, as well as status.
    record ModelSummary
        -- The name of the machine learning model.
        ModelName: string
        -- The Amazon Resource Name (ARN) of the machine learning model.
        ModelArn: string
        -- The name of the dataset being used for the machine learning model.
        DatasetName: string
        -- The Amazon Resource Name (ARN) of the dataset used to create the model.
        DatasetArn: string
        -- Indicates the status of the machine learning model.
        Status: string
        -- The time at which the specific model was created.
        CreatedAt: number
        -- The model version that the inference scheduler uses to run an inference
        -- execution.
        ActiveModelVersion: number
        -- The Amazon Resource Name (ARN) of the model version that is set as active. The active
        -- model version is the model version that the inference scheduler uses to run an inference
        -- execution.
        ActiveModelVersionArn: string
        -- Indicates the status of the most recent scheduled retraining run.
        LatestScheduledRetrainingStatus: string
        -- Indicates the most recent model version that was generated by retraining.
        LatestScheduledRetrainingModelVersion: number
        -- Indicates the start time of the most recent scheduled retraining run.
        LatestScheduledRetrainingStartTime: number
        -- Indicates the date that the next scheduled retraining run will start on. Lookout for Equipment truncates
        -- the time you provide to the nearest UTC day.
        NextScheduledRetrainingStartDate: number
        -- Indicates the status of the retraining scheduler.
        RetrainingSchedulerStatus: string
        ModelDiagnosticsOutputConfiguration: ModelDiagnosticsOutputConfiguration
        -- Provides a quality assessment for a model that uses labels. If Lookout for Equipment determines that the
        -- model quality is poor based on training metrics, the value is
        -- POOR_QUALITY_DETECTED. Otherwise, the value is
        -- QUALITY_THRESHOLD_MET.
        -- If the model is unlabeled, the model quality can't
        -- be assessed and the value of ModelQuality is
        -- CANNOT_DETERMINE_QUALITY. In this situation, you can get a model quality
        -- assessment by adding labels to the input dataset and retraining the model.
        -- For information about using labels with your models, see Understanding labeling.
        -- For information about improving the quality of a model, see Best practices with
        -- Amazon Lookout for Equipment.
        ModelQuality: string
    end

    record ListModelsOutput
        -- An opaque pagination token indicating where to continue the listing of machine learning
        -- models.
        NextToken: string
        -- Provides information on the specified model, including created time, model and dataset
        -- ARNs, and status.
        ModelSummaries: {ModelSummary}
    end

    record ListModelVersionsInput
        -- Then name of the machine learning model for which the model versions are to be
        -- listed.
        ModelName: string
        -- If the total number of results exceeds the limit that the response can display, the
        -- response returns an opaque pagination token indicating where to continue the listing of
        -- machine learning model versions. Use this token in the NextToken field in the
        -- request to list the next page of results.
        NextToken: string
        -- Specifies the maximum number of machine learning model versions to list.
        MaxResults: number
        -- Filter the results based on the current status of the model version.
        Status: string
        -- Filter the results based on the way the model version was generated.
        SourceType: string
        -- Filter results to return all the model versions created before this time.
        CreatedAtEndTime: number
        -- Filter results to return all the model versions created after this time.
        CreatedAtStartTime: number
        -- Specifies the highest version of the model to return in the list.
        MaxModelVersion: number
        -- Specifies the lowest version of the model to return in the list.
        MinModelVersion: number
    end

    -- Contains information about the specific model version.
    record ModelVersionSummary
        -- The name of the model that this model version is a version of.
        ModelName: string
        -- The Amazon Resource Name (ARN) of the model that this model version is a version
        -- of.
        ModelArn: string
        -- The version of the model.
        ModelVersion: number
        -- The Amazon Resource Name (ARN) of the model version.
        ModelVersionArn: string
        -- The time when this model version was created.
        CreatedAt: number
        -- The current status of the model version.
        Status: string
        -- Indicates how this model version was generated.
        SourceType: string
        -- Provides a quality assessment for a model that uses labels. If Lookout for Equipment determines that the
        -- model quality is poor based on training metrics, the value is
        -- POOR_QUALITY_DETECTED. Otherwise, the value is
        -- QUALITY_THRESHOLD_MET.
        -- If the model is unlabeled, the model quality can't
        -- be assessed and the value of ModelQuality is
        -- CANNOT_DETERMINE_QUALITY. In this situation, you can get a model quality
        -- assessment by adding labels to the input dataset and retraining the model.
        -- For information about improving the quality of a model, see Best practices with
        -- Amazon Lookout for Equipment.
        ModelQuality: string
    end

    record ListModelVersionsOutput
        -- If the total number of results exceeds the limit that the response can display, the
        -- response returns an opaque pagination token indicating where to continue the listing of
        -- machine learning model versions. Use this token in the NextToken field in the
        -- request to list the next page of results.
        NextToken: string
        -- Provides information on the specified model version, including the created time, model
        -- and dataset ARNs, and status.
        -- If you don't supply the ModelName request parameter, or if you supply the name
        -- of a model that doesn't exist, ListModelVersions returns an empty array in
        -- ModelVersionSummaries.
        ModelVersionSummaries: {ModelVersionSummary}
    end

    record ListRetrainingSchedulersInput
        -- Specify this field to only list retraining schedulers whose machine learning models
        -- begin with the value you specify.
        ModelNameBeginsWith: string
        -- Specify this field to only list retraining schedulers whose status matches the value you
        -- specify.
        Status: string
        -- If the number of results exceeds the maximum, a pagination token is returned. Use the
        -- token in the request to show the next page of retraining schedulers.
        NextToken: string
        -- Specifies the maximum number of retraining schedulers to list.
        MaxResults: number
    end

    -- Provides information about the specified retraining scheduler, including model name,
    -- status, start date, frequency, and lookback window.
    record RetrainingSchedulerSummary
        -- The name of the model that the retraining scheduler is attached to.
        ModelName: string
        -- The ARN of the model that the retraining scheduler is attached to.
        ModelArn: string
        -- The status of the retraining scheduler.
        Status: string
        -- The start date for the retraining scheduler. Lookout for Equipment truncates the time you provide to the
        -- nearest UTC day.
        RetrainingStartDate: number
        -- The frequency at which the model retraining is set. This follows the ISO 8601
        -- guidelines.
        RetrainingFrequency: string
        -- The number of past days of data used for retraining.
        LookbackWindow: string
    end

    record ListRetrainingSchedulersOutput
        -- Provides information on the specified retraining scheduler, including the model name,
        -- model ARN, status, and start date.
        RetrainingSchedulerSummaries: {RetrainingSchedulerSummary}
        -- If the number of results exceeds the maximum, this pagination token is returned. Use
        -- this token in the request to show the next page of retraining schedulers.
        NextToken: string
    end

    record ListSensorStatisticsInput
        -- The name of the dataset associated with the list of Sensor Statistics.
        DatasetName: string
        -- The ingestion job id associated with the list of Sensor Statistics. To get sensor
        -- statistics for a particular ingestion job id, both dataset name and ingestion job id must
        -- be submitted as inputs.
        IngestionJobId: string
        -- Specifies the maximum number of sensors for which to retrieve statistics.
        MaxResults: number
        -- An opaque pagination token indicating where to continue the listing of sensor
        -- statistics.
        NextToken: string
    end

    enum StatisticalIssueStatus
        "POTENTIAL_ISSUE_DETECTED"
        "NO_ISSUE_DETECTED"
    end

    -- Entity that comprises information on categorical values in data.
    record CategoricalValues
        -- Indicates whether there is a potential data issue related to categorical values.
        Status: string
        -- Indicates the number of categories in the data.
        NumberOfCategory: number
    end

    -- Entity that comprises information of count and percentage.
    record CountPercent
        -- Indicates the count of occurences of the given statistic.
        Count: number
        -- Indicates the percentage of occurances of the given statistic.
        Percentage: number
    end

    -- Entity that comprises information on large gaps between consecutive timestamps in data.
    record LargeTimestampGaps
        -- Indicates whether there is a potential data issue related to large gaps in timestamps.
        Status: string
        -- Indicates the number of large timestamp gaps, if there are any.
        NumberOfLargeTimestampGaps: number
        -- Indicates the size of the largest timestamp gap, in days.
        MaxTimestampGapInDays: number
    end

    enum Monotonicity
        "DECREASING"
        "INCREASING"
        "STATIC"
    end

    -- Entity that comprises information on monotonic values in the data.
    record MonotonicValues
        -- Indicates whether there is a potential data issue related to having monotonic values.
        Status: string
        -- Indicates the monotonicity of values. Can be INCREASING, DECREASING, or STATIC.
        Monotonicity: string
    end

    -- Entity that comprises information on operating modes in data.
    record MultipleOperatingModes
        -- Indicates whether there is a potential data issue related to having multiple operating
        -- modes.
        Status: string
    end

    -- Summary of ingestion statistics like whether data exists, number of missing values,
    -- number of invalid values and so on related to the particular sensor.
    record SensorStatisticsSummary
        -- Name of the component to which the particular sensor belongs for which the statistics
        -- belong to.
        ComponentName: string
        -- Name of the sensor that the statistics belong to.
        SensorName: string
        -- Parameter that indicates whether data exists for the sensor that the statistics belong
        -- to.
        DataExists: boolean
        -- Parameter that describes the total number of, and percentage of, values that are
        -- missing for the sensor that the statistics belong to.
        MissingValues: CountPercent
        -- Parameter that describes the total number of, and percentage of, values that are
        -- invalid for the sensor that the statistics belong to.
        InvalidValues: CountPercent
        -- Parameter that describes the total number of invalid date entries associated with the
        -- sensor that the statistics belong to.
        InvalidDateEntries: CountPercent
        -- Parameter that describes the total number of duplicate timestamp records associated
        -- with the sensor that the statistics belong to.
        DuplicateTimestamps: CountPercent
        -- Parameter that describes potential risk about whether data associated with the sensor
        -- is categorical.
        CategoricalValues: CategoricalValues
        -- Parameter that describes potential risk about whether data associated with the sensor
        -- has more than one operating mode.
        MultipleOperatingModes: MultipleOperatingModes
        -- Parameter that describes potential risk about whether data associated with the sensor
        -- contains one or more large gaps between consecutive timestamps.
        LargeTimestampGaps: LargeTimestampGaps
        -- Parameter that describes potential risk about whether data associated with the sensor
        -- is mostly monotonic.
        MonotonicValues: MonotonicValues
        -- Indicates the time reference to indicate the beginning of valid data associated with
        -- the sensor that the statistics belong to.
        DataStartTime: number
        -- Indicates the time reference to indicate the end of valid data associated with the
        -- sensor that the statistics belong to.
        DataEndTime: number
    end

    record ListSensorStatisticsOutput
        -- Provides ingestion-based statistics regarding the specified sensor with respect to
        -- various validation types, such as whether data exists, the number and percentage of missing
        -- values, and the number and percentage of duplicate timestamps.
        SensorStatisticsSummaries: {SensorStatisticsSummary}
        -- An opaque pagination token indicating where to continue the listing of sensor
        -- statistics.
        NextToken: string
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the resource (such as the dataset or model) that is
        -- the focus of the ListTagsForResource operation.
        ResourceArn: string
    end

    record ListTagsForResourceOutput
        -- Any tags associated with the resource.
        Tags: {Tag}
    end

    record PutResourcePolicyInput
        -- The Amazon Resource Name (ARN) of the resource for which the policy is being
        -- created.
        ResourceArn: string
        -- The JSON-formatted resource policy to create.
        ResourcePolicy: string
        -- A unique identifier for a revision of the resource policy.
        PolicyRevisionId: string
        -- A unique identifier for the request. If you do not set the client request token,
        -- Amazon Lookout for Equipment generates one.
        ClientToken: string
    end

    record PutResourcePolicyOutput
        -- The Amazon Resource Name (ARN) of the resource for which the policy was created.
        ResourceArn: string
        -- A unique identifier for a revision of the resource policy.
        PolicyRevisionId: string
    end

    record StartDataIngestionJobInput
        -- The name of the dataset being used by the data ingestion job.
        DatasetName: string
        -- Specifies information for the input data for the data ingestion job, including dataset
        -- S3 location.
        IngestionInputConfiguration: IngestionInputConfiguration
        -- The Amazon Resource Name (ARN) of a role with permission to access the data source for
        -- the data ingestion job.
        RoleArn: string
        -- A unique identifier for the request. If you do not set the client request token, Amazon
        -- Lookout for Equipment generates one.
        ClientToken: string
    end

    record StartDataIngestionJobOutput
        -- Indicates the job ID of the data ingestion job.
        JobId: string
        -- Indicates the status of the StartDataIngestionJob operation.
        Status: string
    end

    record StartInferenceSchedulerInput
        -- The name of the inference scheduler to be started.
        InferenceSchedulerName: string
    end

    record StartInferenceSchedulerOutput
        -- The Amazon Resource Name (ARN) of the machine learning model being used by the inference
        -- scheduler.
        ModelArn: string
        -- The name of the machine learning model being used by the inference scheduler.
        ModelName: string
        -- The name of the inference scheduler being started.
        InferenceSchedulerName: string
        -- The Amazon Resource Name (ARN) of the inference scheduler being started.
        InferenceSchedulerArn: string
        -- Indicates the status of the inference scheduler.
        Status: string
    end

    record StartRetrainingSchedulerInput
        -- The name of the model whose retraining scheduler you want to start.
        ModelName: string
    end

    record StartRetrainingSchedulerOutput
        -- The name of the model whose retraining scheduler is being started.
        ModelName: string
        -- The ARN of the model whose retraining scheduler is being started.
        ModelArn: string
        -- The status of the retraining scheduler.
        Status: string
    end

    record StopInferenceSchedulerInput
        -- The name of the inference scheduler to be stopped.
        InferenceSchedulerName: string
    end

    record StopInferenceSchedulerOutput
        -- The Amazon Resource Name (ARN) of the machine learning model used by the inference
        -- scheduler being stopped.
        ModelArn: string
        -- The name of the machine learning model used by the inference scheduler being stopped.
        ModelName: string
        -- The name of the inference scheduler being stopped.
        InferenceSchedulerName: string
        -- The Amazon Resource Name (ARN) of the inference schedule being stopped.
        InferenceSchedulerArn: string
        -- Indicates the status of the inference scheduler.
        Status: string
    end

    record StopRetrainingSchedulerInput
        -- The name of the model whose retraining scheduler you want to stop.
        ModelName: string
    end

    record StopRetrainingSchedulerOutput
        -- The name of the model whose retraining scheduler is being stopped.
        ModelName: string
        -- The ARN of the model whose retraining scheduler is being stopped.
        ModelArn: string
        -- The status of the retraining scheduler.
        Status: string
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the specific resource to which the tag should be
        -- associated.
        ResourceArn: string
        -- The tag or tags to be associated with a specific resource. Both the tag key and value
        -- are specified.
        Tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource to which the tag is currently associated.
        ResourceArn: string
        -- Specifies the key of the tag to be removed from a specified resource.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateActiveModelVersionInput
        -- The name of the machine learning model for which the active model version is being
        -- set.
        ModelName: string
        -- The version of the machine learning model for which the active model version is being
        -- set.
        ModelVersion: number
    end

    record UpdateActiveModelVersionOutput
        -- The name of the machine learning model for which the active model version was
        -- set.
        ModelName: string
        -- The Amazon Resource Name (ARN) of the machine learning model for which the active model
        -- version was set.
        ModelArn: string
        -- The version that is currently active of the machine learning model for which the active
        -- model version was set.
        CurrentActiveVersion: number
        -- The previous version that was active of the machine learning model for which the active
        -- model version was set.
        PreviousActiveVersion: number
        -- The Amazon Resource Name (ARN) of the machine learning model version that is the current
        -- active model version.
        CurrentActiveVersionArn: string
        -- The Amazon Resource Name (ARN) of the machine learning model version that was the
        -- previous active model version.
        PreviousActiveVersionArn: string
    end

    record UpdateInferenceSchedulerInput
        -- The name of the inference scheduler to be updated.
        InferenceSchedulerName: string
        -- A period of time (in minutes) by which inference on the data is delayed after the data
        -- starts. For instance, if you select an offset delay time of five minutes, inference will
        -- not begin on the data until the first data measurement after the five minute mark. For
        -- example, if five minutes is selected, the inference scheduler will wake up at the
        -- configured frequency with the additional five minute delay time to check the customer S3
        -- bucket. The customer can upload data at the same frequency and they don't need to stop and
        -- restart the scheduler when uploading new data.
        DataDelayOffsetInMinutes: number
        -- How often data is uploaded to the source S3 bucket for the input data. The value chosen
        -- is the length of time between data uploads. For instance, if you select 5 minutes, Amazon
        -- Lookout for Equipment will upload the real-time data to the source bucket once every 5
        -- minutes. This frequency also determines how often Amazon Lookout for Equipment starts a scheduled inference on
        -- your data. In this example, it starts once every 5 minutes.
        DataUploadFrequency: string
        -- Specifies information for the input data for the inference scheduler, including
        -- delimiter, format, and dataset location.
        DataInputConfiguration: InferenceInputConfiguration
        -- Specifies information for the output results from the inference scheduler, including
        -- the output S3 location.
        DataOutputConfiguration: InferenceOutputConfiguration
        -- The Amazon Resource Name (ARN) of a role with permission to access the data source for
        -- the inference scheduler.
        RoleArn: string
    end

    record UpdateInferenceSchedulerOutput
    end

    record UpdateLabelGroupInput
        -- The name of the label group to be updated.
        LabelGroupName: string
        -- Updates the code indicating the type of anomaly associated with the label.
        -- Data in this field will be retained for service usage. Follow best practices for the
        -- security of your data.
        FaultCodes: {string}
    end

    record UpdateLabelGroupOutput
    end

    record UpdateModelInput
        -- The name of the model to update.
        ModelName: string
        LabelsInputConfiguration: LabelsInputConfiguration
        -- The ARN of the model to update.
        RoleArn: string
        -- The Amazon S3 location where you want Amazon Lookout for Equipment to save the pointwise model diagnostics for the model.
        -- You must also specify the RoleArn request parameter.
        ModelDiagnosticsOutputConfiguration: ModelDiagnosticsOutputConfiguration
    end

    record UpdateModelOutput
    end

    record UpdateRetrainingSchedulerInput
        -- The name of the model whose retraining scheduler you want to update.
        ModelName: string
        -- The start date for the retraining scheduler. Lookout for Equipment truncates the time you provide to the
        -- nearest UTC day.
        RetrainingStartDate: number
        -- This parameter uses the ISO 8601 standard to set the frequency at which you want retraining to occur in
        -- terms of Years, Months, and/or Days (note: other parameters like Time are not currently
        -- supported). The minimum value is 30 days (P30D) and the maximum value is 1 year (P1Y). For
        -- example, the following values are valid:
        -- P3M15D – Every 3 months and 15 days
        -- P2M – Every 2 months
        -- P150D – Every 150 days
        RetrainingFrequency: string
        -- The number of past days of data that will be used for retraining.
        LookbackWindow: string
        -- Indicates how the service will use new models. In MANAGED mode, new models
        -- will automatically be used for inference if they have better performance than the current
        -- model. In MANUAL mode, the new models will not be used until they
        -- are manually activated.
        PromoteMode: string
    end

    record UpdateRetrainingSchedulerOutput
    end

end

return M
