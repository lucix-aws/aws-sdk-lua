        -- passed, the account ID corresponding to the credentials of the API caller will be used for
        -- this parameter.
        accountId: string
    end

    record DeleteTaxRegistrationOutput
    end

    -- The location of the Amazon S3 bucket that you specify to download your tax documents to.
    record DestinationS3Location
        -- The name of your Amazon S3 bucket that you specify to download your tax documents to.
        bucket: string
        -- The Amazon S3 object prefix that you specify for your tax document file.
        prefix: string
    end

    -- The exemption certificate.
    record ExemptionCertificate
        -- The exemption certificate file name.
        documentName: string
        -- The exemption certificate file content.
        documentFile: string
    end

    record GetTaxExemptionTypesInput
    end

    record GetTaxExemptionTypesOutput
        -- The supported types of tax exemptions.
        taxExemptionTypes: {TaxExemptionType}
    end

    record GetTaxInheritanceInput
    end

    enum HeritageStatus
        "OptIn"
        "OptOut"
    end

    record GetTaxInheritanceOutput
        -- The tax inheritance status.
        heritageStatus: string
    end

    record GetTaxRegistrationInput
        -- Your unique account identifier.
        accountId: string
    end

    -- Your TRN information.
    record TaxRegistration
        -- Your tax registration unique identifier.
        registrationId: string
        -- Type of your tax registration.
        registrationType: string
        -- The legal name associated with your TRN registration.
        legalName: string
        -- The status of your TRN. This can be either Verified, Pending,
        -- Deleted, or Rejected.
        status: string
        -- The industry that describes your business. For business-to-business (B2B) customers, specify Business. For business-to-consumer (B2C) customers, specify Individual. For business-to-government (B2G), specify Government. Note that certain values may not applicable for the request country. Please refer to country specific information in API document.
        sector: string
        -- The metadata for your tax document.
        taxDocumentMetadatas: {TaxDocumentMetadata}
        -- The email address to receive VAT invoices.
        certifiedEmailId: string
        -- Additional tax information associated with your TRN.
        additionalTaxInformation: AdditionalInfoResponse
        -- The legal address associated with your TRN registration.
        legalAddress: Address
    end

    record GetTaxRegistrationOutput
        -- TRN information of the account mentioned in the request.
        taxRegistration: TaxRegistration
    end

    record GetTaxRegistrationDocumentInput
        -- The Amazon S3 bucket that you specify to download your tax documents to.
        destinationS3Location: DestinationS3Location
        -- The metadata for your tax document.
        taxDocumentMetadata: TaxDocumentMetadata
    end

    record GetTaxRegistrationDocumentOutput
        -- The file path of the Amazon S3 bucket where you want to download your tax document to.
        destinationFilePath: string
        -- The Amazon S3 presigned URL of the tax registration document.
        presignedS3Url: string
    end

    record ListSupplementalTaxRegistrationsInput
        -- The number of taxRegistrations results you want in one response.
        maxResults: number
        -- The token to retrieve the next set of results.
        nextToken: string
    end

    enum SupplementalTaxRegistrationType
        "VAT"
    end

    -- Supplemental TRN details.
    record SupplementalTaxRegistration
        -- The supplemental TRN unique identifier.
        registrationId: string
        -- Type of supplemental TRN. Currently, this can only be VAT.
        registrationType: string
        -- The legal name associated with your TRN registration.
        legalName: string
        address: Address
        -- Unique authority ID for the supplemental TRN.
        authorityId: string
        -- The status of your TRN.
        status: string
    end

    record ListSupplementalTaxRegistrationsOutput
        -- The list of supplemental tax registrations.
        taxRegistrations: {SupplementalTaxRegistration}
        -- The token to retrieve the next set of results.
        nextToken: string
    end

    record ListTaxExemptionsInput
        -- The number of results you want in one response.
        maxResults: number
        -- The token to retrieve the next set of results.
        nextToken: string
    end

    record ListTaxExemptionsOutput
        -- The token to retrieve the next set of results.
        nextToken: string
        -- The tax exemption details map of accountId and tax exemption details.
        taxExemptionDetailsMap: {string : TaxExemptionDetails}
    end

    record ListTaxRegistrationsInput
        -- Number of accountDetails results you want in one response.
        maxResults: number
        -- The token to retrieve the next set of results.
        nextToken: string
    end

    record ListTaxRegistrationsOutput
        -- The list of account details. This contains account Ids and TRN Information for each of the
        -- linked accounts.
        accountDetails: {AccountDetails}
        -- The token to retrieve the next set of results.
        nextToken: string
    end

    -- The supplemental TRN information to provide when adding or updating a supplemental TRN.
    record SupplementalTaxRegistrationEntry
        -- The supplemental TRN unique identifier.
        registrationId: string
        -- Type of supplemental TRN. Currently, this can only be VAT.
        registrationType: string
        -- The legal name associated with your TRN registration.
        legalName: string
        address: Address
    end

    record PutSupplementalTaxRegistrationInput
        -- The supplemental TRN information that will be stored for the caller account ID.
        taxRegistrationEntry: SupplementalTaxRegistrationEntry
    end

    record PutSupplementalTaxRegistrationOutput
        -- Unique authority ID for the supplemental TRN information that was stored.
        authorityId: string
        -- The status of the supplemental TRN stored in the system after processing. Based on the validation occurring on the TRN, the status can be Verified, Pending, Rejected, or Deleted.
        status: string
    end

    record PutTaxExemptionInput
        -- The list of unique account identifiers.
        accountIds: {string}
        authority: Authority
        -- The exemption type. Use the supported tax exemption type description.
        exemptionType: string
        exemptionCertificate: ExemptionCertificate
    end

    record PutTaxExemptionOutput
        -- The customer support case ID.
        caseId: string
    end

    record PutTaxInheritanceInput
        -- The tax inheritance status.
        heritageStatus: string
    end

    record PutTaxInheritanceOutput
    end

    record PutTaxRegistrationInput
        -- Your unique account identifier.
        accountId: string
        -- Your TRN information that will be stored to the account mentioned in
        -- accountId.
        taxRegistrationEntry: TaxRegistrationEntry
    end

    record PutTaxRegistrationOutput
        -- The status of your TRN stored in the system after processing. Based on the validation
        -- occurring on the TRN, the status can be Verified, Pending or
        -- Rejected.
        status: string
    end

end

return M
