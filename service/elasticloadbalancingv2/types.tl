        RuleArn: string
        -- The conditions.
        Conditions: {RuleCondition}
        -- The actions.
        Actions: {Action}
        -- The transforms to apply to requests that match this rule. You can add one host header rewrite transform
        -- and one URL rewrite transform. If you specify Transforms, you can't specify ResetTransforms.
        Transforms: {RuleTransform}
        -- Indicates whether to remove all transforms from the rule. If you specify ResetTransforms,
        -- you can't specify Transforms.
        ResetTransforms: boolean
    end

    record ModifyRuleOutput
        -- Information about the modified rule.
        Rules: {Rule}
    end

    record ModifyTargetGroupInput
        -- The Amazon Resource Name (ARN) of the target group.
        TargetGroupArn: string
        -- The protocol the load balancer uses when performing health checks on targets. For
        -- Application Load Balancers, the default is HTTP. For Network Load Balancers and Gateway Load
        -- Balancers, the default is TCP. The TCP protocol is not supported for health checks if the
        -- protocol of the target group is HTTP or HTTPS. It is supported for health checks only if the
        -- protocol of the target group is TCP, TLS, UDP, or TCP_UDP. The GENEVE, TLS, UDP, TCP_UDP, QUIC, and TCP_QUIC
        -- protocols are not supported for health checks.
        HealthCheckProtocol: string
        -- The port the load balancer uses when performing health checks on targets.
        HealthCheckPort: string
        -- [HTTP/HTTPS health checks] The destination for health checks on the targets.
        -- [HTTP1 or HTTP2 protocol version] The ping path. The default is /.
        -- [GRPC protocol version] The path of a custom health check method with the format
        -- /package.service/method. The default is /Amazon Web Services.ALB/healthcheck.
        HealthCheckPath: string
        -- Indicates whether health checks are enabled. If the target type is lambda,
        -- health checks are disabled by default but can be enabled. If the target type is
        -- instance, ip, or alb, health checks are always
        -- enabled and can't be disabled.
        HealthCheckEnabled: boolean
        -- The approximate amount of time, in seconds, between health checks of an individual target.
        HealthCheckIntervalSeconds: number
        -- [HTTP/HTTPS health checks] The amount of time, in seconds, during which no response means
        -- a failed health check.
        HealthCheckTimeoutSeconds: number
        -- The number of consecutive health checks successes required before considering an unhealthy
        -- target healthy.
        HealthyThresholdCount: number
        -- The number of consecutive health check failures required before considering the target
        -- unhealthy.
        UnhealthyThresholdCount: number
        -- [HTTP/HTTPS health checks] The HTTP or gRPC codes to use when checking for a successful
        -- response from a target. For target groups with a protocol of TCP, TCP_UDP, UDP or TLS the range
        -- is 200-599. For target groups with a protocol of HTTP or HTTPS, the range is 200-499. For target
        -- groups with a protocol of GENEVE, the range is 200-399.
        Matcher: Matcher
    end

    record ModifyTargetGroupOutput
        -- Information about the modified target group.
        TargetGroups: {TargetGroup}
    end

    record ModifyTargetGroupAttributesInput
        -- The Amazon Resource Name (ARN) of the target group.
        TargetGroupArn: string
        -- The target group attributes.
        Attributes: {TargetGroupAttribute}
    end

    record ModifyTargetGroupAttributesOutput
        -- Information about the target group attributes.
        Attributes: {TargetGroupAttribute}
    end

    record ModifyTrustStoreInput
        -- The Amazon Resource Name (ARN) of the trust store.
        TrustStoreArn: string
        -- The Amazon S3 bucket for the ca certificates bundle.
        CaCertificatesBundleS3Bucket: string
        -- The Amazon S3 path for the ca certificates bundle.
        CaCertificatesBundleS3Key: string
        -- The Amazon S3 object version for the ca certificates bundle. If undefined the current version is used.
        CaCertificatesBundleS3ObjectVersion: string
    end

    record ModifyTrustStoreOutput
        -- Information about the modified trust store.
        TrustStores: {TrustStore}
    end

    record RegisterTargetsInput
        -- The Amazon Resource Name (ARN) of the target group.
        TargetGroupArn: string
        -- The targets.
        Targets: {TargetDescription}
    end

    record RegisterTargetsOutput
    end

    record RemoveListenerCertificatesInput
        -- The Amazon Resource Name (ARN) of the listener.
        ListenerArn: string
        -- The certificate to remove. You can specify one certificate per call. Set
        -- CertificateArn to the certificate ARN but do not set
        -- IsDefault.
        Certificates: {Certificate}
    end

    record RemoveListenerCertificatesOutput
    end

    record RemoveTagsInput
        -- The Amazon Resource Name (ARN) of the resource.
        ResourceArns: {string}
        -- The tag keys for the tags to remove.
        TagKeys: {string}
    end

    record RemoveTagsOutput
    end

    record RemoveTrustStoreRevocationsInput
        -- The Amazon Resource Name (ARN) of the trust store.
        TrustStoreArn: string
        -- The revocation IDs of the revocation files you want to remove.
        RevocationIds: {number}
    end

    record RemoveTrustStoreRevocationsOutput
    end

    record SetIpAddressTypeInput
        -- The Amazon Resource Name (ARN) of the load balancer.
        LoadBalancerArn: string
        -- The IP address type. Internal load balancers must use ipv4.
        -- [Application Load Balancers] The possible values are ipv4 (IPv4 addresses),
        -- dualstack (IPv4 and IPv6 addresses), and dualstack-without-public-ipv4
        -- (public IPv6 addresses and private IPv4 and IPv6 addresses).
        -- Application Load Balancer authentication supports IPv4 addresses only when
        -- connecting to an Identity Provider (IdP) or Amazon Cognito endpoint. Without a public
        -- IPv4 address the load balancer can't complete the authentication process, resulting
        -- in HTTP 500 errors.
        -- [Network Load Balancers and Gateway Load Balancers] The possible values are ipv4
        -- (IPv4 addresses) and dualstack (IPv4 and IPv6 addresses).
        IpAddressType: string
    end

    record SetIpAddressTypeOutput
        -- The IP address type.
        IpAddressType: string
    end

    record SetRulePrioritiesInput
        -- The rule priorities.
        RulePriorities: {RulePriorityPair}
    end

    record SetRulePrioritiesOutput
        -- Information about the rules.
        Rules: {Rule}
    end

    record SetSecurityGroupsInput
        -- The Amazon Resource Name (ARN) of the load balancer.
        LoadBalancerArn: string
        -- The IDs of the security groups.
        SecurityGroups: {string}
        -- Indicates whether to evaluate inbound security group rules for traffic sent to a
        -- Network Load Balancer through Amazon Web Services PrivateLink. Applies only if the load balancer
        -- has an associated security group. The default is on.
        EnforceSecurityGroupInboundRulesOnPrivateLinkTraffic: string
    end

    record SetSecurityGroupsOutput
        -- The IDs of the security groups associated with the load balancer.
        SecurityGroupIds: {string}
        -- Indicates whether to evaluate inbound security group rules for traffic sent to a
        -- Network Load Balancer through Amazon Web Services PrivateLink.
        EnforceSecurityGroupInboundRulesOnPrivateLinkTraffic: string
    end

    record SetSubnetsInput
        -- The Amazon Resource Name (ARN) of the load balancer.
        LoadBalancerArn: string
        -- The IDs of the public subnets. You can specify only one subnet per Availability Zone. You
        -- must specify either subnets or subnet mappings.
        -- [Application Load Balancers] You must specify subnets from at least two Availability
        -- Zones.
        -- [Application Load Balancers on Outposts] You must specify one Outpost subnet.
        -- [Application Load Balancers on Local Zones] You can specify subnets from one or more Local
        -- Zones.
        -- [Network Load Balancers] You can specify subnets from one or more Availability Zones.
        -- [Gateway Load Balancers] You can specify subnets from one or more Availability Zones.
        -- You must include all subnets that were enabled previously, with their existing configurations,
        -- plus any additional subnets.
        Subnets: {string}
        -- The IDs of the public subnets. You can specify only one subnet per Availability Zone. You
        -- must specify either subnets or subnet mappings.
        -- [Application Load Balancers] You must specify subnets from at least two Availability
        -- Zones. You can't specify Elastic IP addresses for your subnets.
        -- [Application Load Balancers on Outposts] You must specify one Outpost subnet.
        -- [Application Load Balancers on Local Zones] You can specify subnets from one or more Local
        -- Zones.
        -- [Network Load Balancers] You can specify subnets from one or more Availability Zones. You
        -- can specify one Elastic IP address per subnet if you need static IP addresses for your
        -- internet-facing load balancer. For internal load balancers, you can specify one private IP
        -- address per subnet from the IPv4 range of the subnet. For internet-facing load balancer, you
        -- can specify one IPv6 address per subnet.
        -- [Gateway Load Balancers] You can specify subnets from one or more Availability
        -- Zones.
        SubnetMappings: {SubnetMapping}
        -- The IP address type.
        -- [Application Load Balancers] The possible values are ipv4 (IPv4 addresses),
        -- dualstack (IPv4 and IPv6 addresses), and dualstack-without-public-ipv4
        -- (public IPv6 addresses and private IPv4 and IPv6 addresses).
        -- [Network Load Balancers and Gateway Load Balancers] The possible values are ipv4
        -- (IPv4 addresses) and dualstack (IPv4 and IPv6 addresses).
        IpAddressType: string
        -- [Network Load Balancers with UDP listeners] Indicates whether to use an IPv6 prefix
        -- from each subnet for source NAT. The IP address type must be dualstack.
        -- The default value is off.
        EnablePrefixForIpv6SourceNat: string
    end

    record SetSubnetsOutput
        -- Information about the subnets.
        AvailabilityZones: {AvailabilityZone}
        -- The IP address type.
        IpAddressType: string
        -- [Network Load Balancers] Indicates whether to use an IPv6 prefix from each subnet for source NAT.
        EnablePrefixForIpv6SourceNat: string
    end

    -- The specified certificate does not exist.
    record CertificateNotFoundException
        Message: string
    end

    -- The specified listener does not exist.
    record ListenerNotFoundException
        Message: string
    end

    -- You've reached the limit on the number of certificates per load balancer.
    record TooManyCertificatesException
        Message: string
    end

    -- A tag key was specified more than once.
    record DuplicateTagKeysException
        Message: string
    end

    -- The specified load balancer does not exist.
    record LoadBalancerNotFoundException
        Message: string
    end

    -- The specified rule does not exist.
    record RuleNotFoundException
        Message: string
    end

    -- The specified target group does not exist.
    record TargetGroupNotFoundException
        Message: string
    end

    -- You've reached the limit on the number of tags for this resource.
    record TooManyTagsException
        Message: string
    end

    -- The specified trust store does not exist.
    record TrustStoreNotFoundException
        Message: string
    end

    -- The provided revocation file is an invalid format, or uses an incorrect algorithm.
    record InvalidRevocationContentException
        Message: string
    end

    -- The specified revocation file does not exist.
    record RevocationContentNotFoundException
        Message: string
    end

    -- The specified trust store has too many revocation entries.
    record TooManyTrustStoreRevocationEntriesException
        Message: string
    end

    -- The specified ALPN policy is not supported.
    record ALPNPolicyNotSupportedException
        Message: string
    end

    -- A listener with the specified port already exists.
    record DuplicateListenerException
        Message: string
    end

    -- The specified configuration is not valid with this protocol.
    record IncompatibleProtocolsException
        Message: string
    end

    -- The requested configuration is not valid.
    record InvalidConfigurationRequestException
        Message: string
    end

    -- The requested action is not valid.
    record InvalidLoadBalancerActionException
        Message: string
    end

    -- The specified SSL policy does not exist.
    record SSLPolicyNotFoundException
        Message: string
    end

    -- You've reached the limit on the number of load balancers per target group.
    record TargetGroupAssociationLimitException
        Message: string
    end

    -- You've reached the limit on the number of actions per rule.
    record TooManyActionsException
        Message: string
    end

    -- You've reached the limit on the number of listeners per load balancer.
    record TooManyListenersException
        Message: string
    end

    -- You've reached the limit on the number of times a target can be registered with a load
    -- balancer.
    record TooManyRegistrationsForTargetIdException
        Message: string
    end

    -- You've reached the limit on the number of targets.
    record TooManyTargetsException
        Message: string
    end

    -- You've reached the limit on the number of unique target groups per load balancer across
    -- all listeners. If a target group is used by multiple actions for a load balancer, it is
    -- counted as only one use.
    record TooManyUniqueTargetGroupsPerLoadBalancerException
        Message: string
    end

    -- The specified trust store is not active.
    record TrustStoreNotReadyException
        Message: string
    end

    -- The specified protocol is not supported.
    record UnsupportedProtocolException
        Message: string
    end

    -- The specified allocation ID does not exist.
    record AllocationIdNotFoundException
        Message: string
    end

    -- The specified Availability Zone is not supported.
    record AvailabilityZoneNotSupportedException
        Message: string
    end

    -- A load balancer with the specified name already exists.
    record DuplicateLoadBalancerNameException
        Message: string
    end

    -- The requested scheme is not valid.
    record InvalidSchemeException
        Message: string
    end

    -- The specified security group does not exist.
    record InvalidSecurityGroupException
        Message: string
    end

    -- The specified subnet is out of available addresses.
    record InvalidSubnetException
        Message: string
    end

    -- This operation is not allowed.
    record OperationNotPermittedException
        Message: string
    end

    -- A specified resource is in use.
    record ResourceInUseException
        Message: string
    end

    -- The specified subnet does not exist.
    record SubnetNotFoundException
        Message: string
    end

    -- You've reached the limit on the number of load balancers for your Amazon Web Services
    -- account.
    record TooManyLoadBalancersException
        Message: string
    end

    -- The specified priority is in use.
    record PriorityInUseException
        Message: string
    end

    -- You've reached the limit on the number of rules per load balancer.
    record TooManyRulesException
        Message: string
    end

    -- You've reached the limit on the number of target groups for your Amazon Web Services
    -- account.
    record TooManyTargetGroupsException
        Message: string
    end

    -- A target group with the specified name already exists.
    record DuplicateTargetGroupNameException
        Message: string
    end

    -- The specified ca certificate bundle does not exist.
    record CaCertificatesBundleNotFoundException
        Message: string
    end

    -- A trust store with the specified name already exists.
    record DuplicateTrustStoreNameException
        Message: string
    end

    -- The specified ca certificate bundle is in an invalid format, or corrupt.
    record InvalidCaCertificatesBundleException
        Message: string
    end

    -- You've reached the limit on the number of trust stores for your Amazon Web Services account.
    record TooManyTrustStoresException
        Message: string
    end

    -- The specified association can't be within the same account.
    record DeleteAssociationSameAccountException
        Message: string
    end

    -- The specified association does not exist.
    record TrustStoreAssociationNotFoundException
        Message: string
    end

    -- The specified trust store is currently in use.
    record TrustStoreInUseException
        Message: string
    end

    -- The specified target does not exist, is not in the same VPC as the target group, or has an
    -- unsupported instance type.
    record InvalidTargetException
        Message: string
    end

    -- The health of the specified targets could not be retrieved due to an internal
    -- error.
    record HealthUnavailableException
        Message: string
    end

    -- The specified revocation ID does not exist.
    record RevocationIdNotFoundException
        Message: string
    end

    -- The specified resource does not exist.
    record ResourceNotFoundException
        Message: string
    end

    -- You've exceeded the daily capacity decrease limit for this reservation.
    record CapacityDecreaseRequestsLimitExceededException
        Message: string
    end

    -- There is a pending capacity reservation.
    record CapacityReservationPendingException
        Message: string
    end

    -- You've exceeded the capacity units limit.
    record CapacityUnitsLimitExceededException
        Message: string
    end

    -- There is insufficient capacity to reserve.
    record InsufficientCapacityException
        Message: string
    end

    -- This operation is not allowed while a prior request has not been completed.
    record PriorRequestNotCompleteException
        Message: string
    end

    enum EnablePrefixForIpv6SourceNatEnum
        "on"
        "off"
    end

    enum EnforceSecurityGroupInboundRulesOnPrivateLinkTrafficEnum
        "on"
        "off"
    end

    enum IpAddressType
        "ipv4"
        "dualstack"
        "dualstack-without-public-ipv4"
    end

    enum LoadBalancerSchemeEnum
        "internet-facing"
        "internal"
    end

    enum LoadBalancerTypeEnum
        "application"
        "network"
        "gateway"
    end

    enum ProtocolEnum
        "HTTP"
        "HTTPS"
        "TCP"
        "TLS"
        "UDP"
        "TCP_UDP"
        "GENEVE"
        "QUIC"
        "TCP_QUIC"
    end

    enum TargetGroupIpAddressTypeEnum
        "ipv4"
        "ipv6"
    end

    enum TargetTypeEnum
        "instance"
        "ip"
        "lambda"
        "alb"
    end

end

return M
