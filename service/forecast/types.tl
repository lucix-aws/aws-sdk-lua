        -- Maximum key length - 128 Unicode characters in UTF-8.
        -- Maximum value length - 256 Unicode characters in UTF-8.
        -- If your tagging schema is used across multiple services and resources, remember that
        -- other services may have restrictions on allowed characters. Generally allowed characters
        -- are: letters, numbers, and spaces representable in UTF-8, and the following characters: +
        -- - = . _ : / @.
        -- Tag keys and values are case sensitive.
        -- Do not use aws:, AWS:, or any upper or lowercase combination
        -- of such as a prefix for keys as it is reserved for Amazon Web Services use. You cannot edit or delete tag
        -- keys with this prefix. Values can have this prefix. If a tag value has aws as
        -- its prefix but the key does not, then Forecast considers it to be a user tag and will
        -- count against the limit of 50 tags. Tags with only the key prefix of aws do
        -- not count against your tags per resource limit.
        Tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) that identifies the resource for which to list the tags.
        ResourceArn: string
        -- The keys of the tags to be removed.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateDatasetGroupInput
        -- The ARN of the dataset group.
        DatasetGroupArn: string
        -- An array of the Amazon Resource Names (ARNs) of the datasets to add to the dataset
        -- group.
        DatasetArns: {string}
    end

    record UpdateDatasetGroupOutput
    end

    -- We can't process the request because it includes an invalid value or a value that exceeds
    -- the valid range.
    record InvalidInputException
        Message: string
    end

    -- The limit on the number of resources per account has been exceeded.
    record LimitExceededException
        Message: string
    end

    -- There is already a resource with this name. Try again with a different name.
    record ResourceAlreadyExistsException
        Message: string
    end

    -- The specified resource is in use.
    record ResourceInUseException
        Message: string
    end

    -- We can't find a resource with that Amazon Resource Name (ARN). Check the ARN and try
    -- again.
    record ResourceNotFoundException
        Message: string
    end

    -- The token is not valid. Tokens expire after 24 hours.
    record InvalidNextTokenException
        Message: string
    end

    enum AutoMLOverrideStrategy
        "LatencyOptimized"
        "AccuracyOptimized"
    end

    enum DatasetType
        "TARGET_TIME_SERIES"
        "RELATED_TIME_SERIES"
        "ITEM_METADATA"
    end

    enum Domain
        "RETAIL"
        "CUSTOM"
        "INVENTORY_PLANNING"
        "EC2_CAPACITY"
        "WORK_FORCE"
        "WEB_TRAFFIC"
        "METRICS"
    end

    enum ImportMode
        "FULL"
        "INCREMENTAL"
    end

    enum OptimizationMetric
        "WAPE"
        "RMSE"
        "AverageWeightedQuantileLoss"
        "MASE"
        "MAPE"
    end

end

return M
