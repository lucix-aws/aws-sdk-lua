    record UpdateTableStorageOptimizerOutput
        -- A response indicating the success of failure of the operation.
        Result: string
    end

    -- Access to a resource was denied.
    record AccessDeniedException
        -- A message describing the problem.
        Message: string
    end

    -- Two processes are trying to modify a resource simultaneously.
    record ConcurrentModificationException
        -- A message describing the problem.
        Message: string
    end

    -- A specified entity does not exist.
    record EntityNotFoundException
        -- A message describing the problem.
        Message: string
    end

    -- An internal service error occurred.
    record InternalServiceException
        -- A message describing the problem.
        Message: string
    end

    -- The input provided was not valid.
    record InvalidInputException
        -- A message describing the problem.
        Message: string
    end

    -- The operation timed out.
    record OperationTimeoutException
        -- A message describing the problem.
        Message: string
    end

    -- Contains details about an error related to a transaction commit that was in progress.
    record TransactionCommitInProgressException
        -- A message describing the error.
        Message: string
    end

    -- Contains details about an error where the specified transaction has already been committed and cannot be used for UpdateTableObjects.
    record TransactionCommittedException
        -- A message describing the error.
        Message: string
    end

    -- Contains details about an error related to a transaction that was cancelled.
    record TransactionCanceledException
        -- A message describing the error.
        Message: string
    end

    -- A resource to be created or added already exists.
    record AlreadyExistsException
        -- A message describing the problem.
        Message: string
    end

    -- A resource numerical limit was exceeded.
    record ResourceNumberLimitExceededException
        -- A message describing the problem.
        Message: string
    end

    -- Contains details about an error related to a resource which is not ready for a transaction.
    record ResourceNotReadyException
        -- A message describing the error.
        Message: string
    end

    -- Contains details about an error where the query request expired.
    record ExpiredException
        -- A message describing the error.
        Message: string
    end

    -- Contains details about an error related to statistics not being ready.
    record StatisticsNotReadyYetException
        -- A message describing the error.
        Message: string
    end

    -- Contains details about an error where the query request was throttled.
    record ThrottledException
        -- A message describing the error.
        Message: string
    end

    -- An encryption operation failed.
    record GlueEncryptionException
        -- A message describing the problem.
        Message: string
    end

    -- Multiple resources exist with the same Amazon S3 location
    record ConflictException
        -- A message describing the problem.
        Message: string
    end

    -- The engine does not support filtering data based on the enforced permissions. For example, if you call the GetTemporaryGlueTableCredentials operation with SupportedPermissionType equal to ColumnPermission, but cell-level permissions exist on the table, this exception is thrown.
    record PermissionTypeMismatchException
        -- A message describing the problem.
        Message: string
    end

    -- Contains details about an error related to work units not being ready.
    record WorkUnitsNotReadyYetException
        -- A message describing the error.
        Message: string
    end

    enum ApplicationStatus
        "ENABLED"
        "DISABLED"
    end

    enum CredentialsScope
        "READ"
        "READWRITE"
    end

    enum DataLakeResourceType
        "CATALOG"
        "DATABASE"
        "TABLE"
        "DATA_LOCATION"
        "LF_TAG"
        "LF_TAG_POLICY"
        "LF_TAG_POLICY_DATABASE"
        "LF_TAG_POLICY_TABLE"
        "LF_NAMED_TAG_EXPRESSION"
    end

    enum OptimizerType
        "COMPACTION"
        "GARBAGE_COLLECTION"
        "ALL"
    end

    enum QueryStateString
        "PENDING"
        "WORKUNITS_AVAILABLE"
        "ERROR"
        "FINISHED"
        "EXPIRED"
    end

    enum ResourceShareType
        "FOREIGN"
        "ALL"
    end

    enum TransactionStatus
        "ACTIVE"
        "COMMITTED"
        "ABORTED"
        "COMMIT_IN_PROGRESS"
    end

    enum TransactionStatusFilter
        "ALL"
        "COMPLETED"
        "ACTIVE"
        "COMMITTED"
        "ABORTED"
    end

    enum TransactionType
        "READ_AND_WRITE"
        "READ_ONLY"
    end

end

return M
