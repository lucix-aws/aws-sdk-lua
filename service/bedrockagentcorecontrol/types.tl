    -- This exception is thrown when a request is denied per access permissions
    record AccessDeniedException
        message: string
    end

    -- This exception is thrown when there is a conflict performing an operation
    record ConflictException
        message: string
    end

    -- This exception is thrown if there was an unexpected error during processing of request
    record InternalServerException
        message: string
    end

    -- This exception is thrown when a request is made beyond the service quota
    record ServiceQuotaExceededException
        message: string
    end

    -- This exception is thrown when the number of requests exceeds the limit
    record ThrottlingException
        message: string
    end

    -- The input fails to satisfy the constraints specified by the service.
    record ValidationException
        message: string
        reason: string
        fieldList: {ValidationExceptionField}
    end

    -- This exception is thrown when a resource referenced by the operation does not exist
    record ResourceNotFoundException
        message: string
    end

    -- Exception thrown when decryption of a secret fails.
    record DecryptionFailure
        message: string
    end

    -- Exception thrown when encryption of a secret fails.
    record EncryptionFailure
        message: string
    end

    -- Exception thrown when a resource limit is exceeded.
    record ResourceLimitExceededException
        message: string
    end

    -- This exception is thrown when the JWT bearer token is invalid or not found for OAuth bearer token based access
    record UnauthorizedException
        message: string
    end

    -- An internal error occurred.
    record ServiceException
        message: string
    end

    -- API rate limit has been exceeded.
    record ThrottledException
        message: string
    end

    -- Exception thrown when a resource is modified concurrently by multiple requests.
    record ConcurrentModificationException
        message: string
    end

