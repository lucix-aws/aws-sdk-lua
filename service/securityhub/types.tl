        Message: string
        Code: string
    end

    -- The request was rejected because it attempted to create resources beyond the current Amazon Web Services
    -- account or throttling limits. The error code describes the limit exceeded.
    record LimitExceededException
        Message: string
        Code: string
    end

    -- The request was rejected because we can't find the specified resource.
    record ResourceNotFoundException
        Message: string
        Code: string
    end

    -- You don't have permission to perform the action specified in the request.
    record AccessDeniedException
        Message: string
        Code: string
    end

    -- The request causes conflict with the current state of the service resource.
    record ConflictException
        Message: string
        Code: string
    end

    -- The request has failed due to an internal failure of the service.
    record InternalServerException
        Message: string
        Code: string
    end

    -- The limit on the number of requests per second was exceeded.
    record ThrottlingException
        Message: string
        Code: string
    end

    -- The request has failed validation because it's missing required fields or has invalid inputs.
    record ValidationException
        Message: string
        Code: string
    end

    -- The resource specified in the request conflicts with an existing resource.
    record ResourceConflictException
        Message: string
        Code: string
    end

    -- The request was rejected because it would exceed the service quota limit.
    record ServiceQuotaExceededException
        Message: string
        Code: string
    end

    -- The request failed because one or more organizational units specified in the request don't exist within the caller's organization.
    record OrganizationalUnitNotFoundException
        Message: string
        Code: string
    end

    -- The request failed because one or more organizations specified in the request don't exist or don't belong to the caller's organization.
    record OrganizationNotFoundException
        Message: string
        Code: string
    end

    -- The request was rejected because it conflicts with the resource's availability. For example, you tried
    -- to update a security control that's currently in the UPDATING state.
    record ResourceInUseException
        Message: string
        Code: string
    end

    enum AssociationType
        "INHERITED"
        "APPLIED"
    end

    enum AutoEnableStandards
        "NONE"
        "DEFAULT"
    end

    enum ConfigurationPolicyAssociationStatus
        "PENDING"
        "SUCCESS"
        "FAILED"
    end

    enum ConnectorProviderName
        "JIRA_CLOUD"
        "SERVICENOW"
    end

    enum ConnectorStatus
        "CONNECTED"
        "FAILED_TO_CONNECT"
        "PENDING_CONFIGURATION"
        "PENDING_AUTHORIZATION"
    end

    enum ControlFindingGenerator
        "STANDARD_CONTROL"
        "SECURITY_CONTROL"
    end

    enum ControlStatus
        "ENABLED"
        "DISABLED"
    end

    enum GranularityField
        "Daily"
        "Weekly"
        "Monthly"
    end

    enum RecommendationStatus
        "IN_PROGRESS"
        "SUCCEEDED"
        "FAILED"
    end

    enum RecommendationType
        "UNUSED_PERMISSION_RECOMMENDATION"
    end

    enum RecordState
        "ACTIVE"
        "ARCHIVED"
    end

    enum RuleStatus
        "ENABLED"
        "DISABLED"
    end

    enum RuleStatusV2
        "ENABLED"
        "DISABLED"
    end

    enum SecurityHubFeature
        "SecurityHub"
        "SecurityHubV2"
    end

    enum SortOrder
        "asc"
        "desc"
    end

    enum TargetType
        "ACCOUNT"
        "ORGANIZATIONAL_UNIT"
        "ROOT"
    end

    enum TicketCreationMode
        "DRYRUN"
    end

    enum VerificationState
        "UNKNOWN"
        "TRUE_POSITIVE"
        "FALSE_POSITIVE"
        "BENIGN_POSITIVE"
    end

end

return M
