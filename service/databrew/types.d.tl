    -- see Cron
    -- expressions in the Glue DataBrew Developer
    -- Guide.
    CronExpression: string
    -- The name of the schedule to update.
    Name: string
end

local record UpdateScheduleOutput
    -- The name of the schedule that was updated.
    Name: string
end

