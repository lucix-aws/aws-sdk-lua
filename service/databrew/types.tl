    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- A DataBrew resource from which you want to remove a tag or tags. The value for this
        -- parameter is an Amazon Resource Name (ARN).
        ResourceArn: string
        -- The tag keys (names) of one or more tags to be removed.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateDatasetInput
        -- The name of the dataset to be updated.
        Name: string
        -- The file format of a dataset that is created from an Amazon S3 file or folder.
        Format: string
        FormatOptions: FormatOptions
        Input: Input
        -- A set of options that defines how DataBrew interprets an Amazon S3 path of the dataset.
        PathOptions: PathOptions
    end

    record UpdateDatasetOutput
        -- The name of the dataset that you updated.
        Name: string
    end

    record UpdateProfileJobInput
        -- Configuration for profile jobs. Used to select columns, do evaluations,
        -- and override default parameters of evaluations. When configuration is null, the
        -- profile job will run with default settings.
        Configuration: ProfileConfiguration
        -- The Amazon Resource Name (ARN) of an encryption key that is used to protect the
        -- job.
        EncryptionKeyArn: string
        -- The encryption mode for the job, which can be one of the following:
        -- SSE-KMS - Server-side encryption with keys managed by KMS.
        -- SSE-S3 - Server-side encryption with keys managed by Amazon
        -- S3.
        EncryptionMode: string
        -- The name of the job to be updated.
        Name: string
        -- Enables or disables Amazon CloudWatch logging for the job. If logging is enabled,
        -- CloudWatch writes one log stream for each job run.
        LogSubscription: string
        -- The maximum number of compute nodes that DataBrew can use when the job processes
        -- data.
        MaxCapacity: number
        -- The maximum number of times to retry the job after a job run fails.
        MaxRetries: number
        OutputLocation: S3Location
        -- List of validation configurations that are applied to the profile job.
        ValidationConfigurations: {ValidationConfiguration}
        -- The Amazon Resource Name (ARN) of the Identity and Access Management (IAM) role to
        -- be assumed when DataBrew runs the job.
        RoleArn: string
        -- The job's timeout in minutes. A job that attempts to run longer than this timeout
        -- period ends with a status of TIMEOUT.
        Timeout: number
        -- Sample configuration for Profile Jobs only. Determines the number of rows on which the
        -- Profile job will be executed. If a JobSample value is not provided for profile jobs, the
        -- default value will be used. The default value is CUSTOM_ROWS for the mode parameter and
        -- 20000 for the size parameter.
        JobSample: JobSample
    end

    record UpdateProfileJobOutput
        -- The name of the job that was updated.
        Name: string
    end

    record UpdateProjectInput
        Sample: Sample
        -- The Amazon Resource Name (ARN) of the IAM role to be assumed for this request.
        RoleArn: string
        -- The name of the project to be updated.
        Name: string
    end

    record UpdateProjectOutput
        -- The date and time that the project was last modified.
        LastModifiedDate: number
        -- The name of the project that you updated.
        Name: string
    end

    record UpdateRecipeInput
        -- A description of the recipe.
        Description: string
        -- The name of the recipe to be updated.
        Name: string
        -- One or more steps to be performed by the recipe. Each step consists of an action, and
        -- the conditions under which the action should succeed.
        Steps: {RecipeStep}
    end

    record UpdateRecipeOutput
        -- The name of the recipe that was updated.
        Name: string
    end

    record UpdateRecipeJobInput
        -- The Amazon Resource Name (ARN) of an encryption key that is used to protect the
        -- job.
        EncryptionKeyArn: string
        -- The encryption mode for the job, which can be one of the following:
        -- SSE-KMS - Server-side encryption with keys managed by KMS.
        -- SSE-S3 - Server-side encryption with keys managed by Amazon S3.
        EncryptionMode: string
        -- The name of the job to update.
        Name: string
        -- Enables or disables Amazon CloudWatch logging for the job. If logging is enabled,
        -- CloudWatch writes one log stream for each job run.
        LogSubscription: string
        -- The maximum number of nodes that DataBrew can consume when the job processes
        -- data.
        MaxCapacity: number
        -- The maximum number of times to retry the job after a job run fails.
        MaxRetries: number
        -- One or more artifacts that represent the output from running the job.
        Outputs: {Output}
        -- One or more artifacts that represent the Glue Data Catalog output from running the job.
        DataCatalogOutputs: {DataCatalogOutput}
        -- Represents a list of JDBC database output objects which defines the output destination for a
        -- DataBrew recipe job to write into.
        DatabaseOutputs: {DatabaseOutput}
        -- The Amazon Resource Name (ARN) of the Identity and Access Management (IAM) role to
        -- be assumed when DataBrew runs the job.
        RoleArn: string
        -- The job's timeout in minutes. A job that attempts to run longer than this timeout
        -- period ends with a status of TIMEOUT.
        Timeout: number
    end

    record UpdateRecipeJobOutput
        -- The name of the job that you updated.
        Name: string
    end

    record UpdateRulesetInput
        -- The name of the ruleset to be updated.
        Name: string
        -- The description of the ruleset.
        Description: string
        -- A list of rules that are defined with the ruleset. A rule includes one or more
        -- checks to be validated on a DataBrew dataset.
        Rules: {Rule}
    end

    record UpdateRulesetOutput
        -- The name of the updated ruleset.
        Name: string
    end

    record UpdateScheduleInput
        -- The name or names of one or more jobs to be run for this schedule.
        JobNames: {string}
        -- The date or dates and time or times when the jobs are to be run. For more information,
        -- see Cron
        -- expressions in the Glue DataBrew Developer
        -- Guide.
        CronExpression: string
        -- The name of the schedule to update.
        Name: string
    end

    record UpdateScheduleOutput
        -- The name of the schedule that was updated.
        Name: string
    end

    -- Updating or deleting a resource can cause an inconsistent state.
    record ConflictException
        Message: string
    end

    -- One or more resources can't be found.
    record ResourceNotFoundException
        Message: string
    end

    -- The input parameters for this request failed validation.
    record ValidationException
        Message: string
    end

    -- Access to the specified resource was denied.
    record AccessDeniedException
        Message: string
    end

    -- A service quota is exceeded.
    record ServiceQuotaExceededException
        Message: string
    end

    -- An internal service failure occurred.
    record InternalServerException
        Message: string
    end

    enum EncryptionMode
        "SSE-KMS"
        "SSE-S3"
    end

    enum InputFormat
        "CSV"
        "JSON"
        "PARQUET"
        "EXCEL"
        "ORC"
    end

    enum JobRunState
        "STARTING"
        "RUNNING"
        "STOPPING"
        "STOPPED"
        "SUCCEEDED"
        "FAILED"
        "TIMEOUT"
    end

    enum JobType
        "PROFILE"
        "RECIPE"
    end

    enum LogSubscription
        "ENABLE"
        "DISABLE"
    end

    enum SessionStatus
        "ASSIGNED"
        "FAILED"
        "INITIALIZING"
        "PROVISIONING"
        "READY"
        "RECYCLING"
        "ROTATING"
        "TERMINATED"
        "TERMINATING"
        "UPDATING"
    end

    enum Source
        "S3"
        "DATA-CATALOG"
        "DATABASE"
    end

end

return M
