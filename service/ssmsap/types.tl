        -- The Amazon Resource Name of the SAP HANA database that replaces the current SAP HANA connection with the SAP_ABAP application.
        DatabaseArn: string
    end

    record UpdateApplicationSettingsOutput
        -- The update message.
        Message: string
        -- The IDs of the operations.
        OperationIds: {string}
    end

end

return M
