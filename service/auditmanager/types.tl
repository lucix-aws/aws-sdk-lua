        -- Specifies whether the signature key is valid.
        signatureValid: boolean
        -- The signature algorithm that's used to code sign the assessment report file.
        signatureAlgorithm: string
        -- The date and time signature that specifies when the assessment report was created.
        signatureDateTime: string
        -- The unique identifier for the validation signature key.
        signatureKeyId: string
        -- Represents any errors that occurred when validating the assessment report.
        validationErrors: {string}
    end

    -- Your account isn't registered with Audit Manager. Check the delegated
    -- administrator setup on the Audit Manager settings page, and try again.
    record AccessDeniedException
        message: string
    end

    -- An internal service error occurred during the processing of your request. Try again
    -- later.
    record InternalServerException
        message: string
    end

    -- The resource that's specified in the request can't be found.
    record ResourceNotFoundException
        message: string
        -- The unique identifier for the resource.
        resourceId: string
        -- The type of resource that's affected by the error.
        resourceType: string
    end

    -- The request has invalid or missing parameters.
    record ValidationException
        message: string
        -- The reason the request failed validation.
        reason: string
        -- The fields that caused the error, if applicable.
        fields: {ValidationExceptionField}
    end

    -- The request was denied due to request throttling.
    record ThrottlingException
        message: string
    end

    -- You've reached your account quota for this resource type. To perform the requested
    -- action, delete some existing resources or request a quota increase from
    -- the Service Quotas console. For a list of Audit Manager service quotas, see Quotas and
    -- restrictions for Audit Manager.
    record ServiceQuotaExceededException
        message: string
    end

    enum AccountStatus
        "ACTIVE"
        "INACTIVE"
        "PENDING_ACTIVATION"
    end

    enum AssessmentStatus
        "ACTIVE"
        "INACTIVE"
    end

    enum ControlSetStatus
        "ACTIVE"
        "UNDER_REVIEW"
        "REVIEWED"
    end

    enum ControlStatus
        "UNDER_REVIEW"
        "REVIEWED"
        "INACTIVE"
    end

    enum ControlType
        "Standard"
        "Custom"
        "Core"
    end

    enum DataSourceType
        "AWS_Cloudtrail"
        "AWS_Config"
        "AWS_Security_Hub"
        "AWS_API_Call"
        "MANUAL"
    end

    enum FrameworkType
        "Standard"
        "Custom"
    end

    enum SettingAttribute
        "ALL"
        "IS_AWS_ORG_ENABLED"
        "SNS_TOPIC"
        "DEFAULT_ASSESSMENT_REPORTS_DESTINATION"
        "DEFAULT_PROCESS_OWNERS"
        "EVIDENCE_FINDER_ENABLEMENT"
        "DEREGISTRATION_POLICY"
        "DEFAULT_EXPORT_DESTINATION"
    end

    enum ShareRequestAction
        "ACCEPT"
        "DECLINE"
        "REVOKE"
    end

    enum ShareRequestType
        "SENT"
        "RECEIVED"
    end

end

return M
