    -- A generic error indicating a failure with a client request.
    record BadRequest
        Message: string
    end

    -- No Amazon FSx file systems were found based upon supplied parameters.
    record FileSystemNotFound
        Message: string
    end

    -- A generic error indicating a server-side failure.
    record InternalServerError
        Message: string
    end

    -- The data repository task could not be canceled because the task has already ended.
    record DataRepositoryTaskEnded
        Message: string
    end

    -- The data repository task or tasks you specified could not be found.
    record DataRepositoryTaskNotFound
        Message: string
    end

    -- The requested operation is not supported for this resource or API.
    record UnsupportedOperation
        Message: string
    end

    -- No Amazon FSx backups were found based upon the supplied parameters.
    record BackupNotFound
        Message: string
    end

    -- The error returned when a second request is received with the same client request
    -- token but different parameters settings. A client request token should always uniquely
    -- identify a single request.
    record IncompatibleParameterError
        -- A parameter that is incompatible with the earlier request.
        Parameter: string
        Message: string
    end

    -- Amazon FSx doesn't support Multi-AZ Windows File Server copy backup in the
    -- destination Region, so the copied backup can't be restored.
    record IncompatibleRegionForMultiAZ
        Message: string
    end

    -- The Key Management Service (KMS) key of the destination backup is not
    -- valid.
    record InvalidDestinationKmsKey
        Message: string
    end

    -- The Region provided for SourceRegion is not valid or is in a different
    -- Amazon Web Services partition.
    record InvalidRegion
        Message: string
    end

    -- The Key Management Service (KMS) key of the source backup is not
    -- valid.
    record InvalidSourceKmsKey
        Message: string
    end

    -- An error indicating that a particular service limit was exceeded. You can increase
    -- some service limits by contacting Amazon Web Services Support.
    record ServiceLimitExceeded
        -- Enumeration of the service limit that was exceeded.
        Limit: string
        Message: string
    end

    -- The request was rejected because the lifecycle status of the source backup isn't
    -- AVAILABLE.
    record SourceBackupUnavailable
        Message: string
        BackupId: string
    end

    -- An access point with that name already exists in the Amazon Web Services Region in your Amazon Web Services account.
    record AccessPointAlreadyOwnedByYou
        -- An error code indicating that an access point with that name already exists in the Amazon Web Services Region in your Amazon Web Services account.
        ErrorCode: string
        Message: string
    end

    -- The access point specified doesn't exist.
    record InvalidAccessPoint
        -- An error code indicating that the access point specified doesn't exist.
        ErrorCode: string
        Message: string
    end

    -- The action or operation requested is invalid. Verify that the action is typed correctly.
    record InvalidRequest
        -- An error code indicating that the action or operation requested is invalid.
        ErrorCode: string
        Message: string
    end

    -- You have reached the maximum number of S3 access points attachments allowed for your account in this Amazon Web Services Region, or for the file system. For more information, or to request an increase,
    -- see Service quotas on FSx resources in the FSx for OpenZFS User Guide.
    record TooManyAccessPoints
        -- An error code indicating that you have reached the maximum number of S3 access points attachments allowed for your account in this Amazon Web Services Region, or for the file system.
        ErrorCode: string
        Message: string
    end

    -- No Amazon FSx volumes were found based upon the supplied parameters.
    record VolumeNotFound
        Message: string
    end

    -- Another backup is already under way. Wait for completion before initiating
    -- additional backups of this file system.
    record BackupInProgress
        Message: string
    end

    -- An existing data repository task is currently executing on the file system.
    -- Wait until the existing task has completed, then create the new task.
    record DataRepositoryTaskExecuting
        Message: string
    end

    -- One or more network settings specified in the request are invalid.
    record InvalidNetworkSettings
        -- Error message explaining what's wrong with network settings.
        Message: string
        -- The subnet ID that is either invalid or not part of the VPC specified.
        InvalidSubnetId: string
        -- The security group ID is either invalid or not part of the VPC specified.
        InvalidSecurityGroupId: string
        -- The route table ID is either invalid or not part of the VPC specified.
        InvalidRouteTableId: string
    end

    -- An invalid value for PerUnitStorageThroughput was provided. Please create your file system again, using a valid value.
    record InvalidPerUnitStorageThroughput
        Message: string
    end

    -- A cache configuration is required for this operation.
    record MissingFileCacheConfiguration
        Message: string
    end

    -- An Active Directory error.
    record ActiveDirectoryError
        -- The directory ID of the directory that an error pertains to.
        ActiveDirectoryId: string
        -- The type of Active Directory error.
        Type: string
        Message: string
    end

    -- The path provided for data repository export isn't valid.
    record InvalidExportPath
        Message: string
    end

    -- The path provided for data repository import isn't valid.
    record InvalidImportPath
        Message: string
    end

    -- A file system configuration is required for this operation.
    record MissingFileSystemConfiguration
        Message: string
    end

    -- A volume configuration is required for this operation.
    record MissingVolumeConfiguration
        Message: string
    end

    -- No FSx for ONTAP SVMs were found based upon the supplied parameters.
    record StorageVirtualMachineNotFound
        Message: string
    end

    -- You can't delete a backup while it's being copied.
    record BackupBeingCopied
        Message: string
        BackupId: string
    end

    -- You can't delete a backup while it's being used to restore a file
    -- system.
    record BackupRestoring
        Message: string
        -- The ID of a file system being restored from the backup.
        FileSystemId: string
    end

    -- No data repository associations were found based upon the supplied parameters.
    record DataRepositoryAssociationNotFound
        Message: string
    end

    -- No caches were found based upon supplied parameters.
    record FileCacheNotFound
        Message: string
    end

    -- No Amazon FSx snapshots were found based on the supplied parameters.
    record SnapshotNotFound
        Message: string
    end

    -- You have filtered the response to a data repository type that is not supported.
    record InvalidDataRepositoryType
        Message: string
    end

    -- The access point specified was not found.
    record S3AccessPointAttachmentNotFound
        Message: string
    end

    -- The resource specified for the tagging operation is not a resource type owned by
    -- Amazon FSx. Use the API of the relevant service to perform the operation.
    record NotServiceResourceError
        -- The Amazon Resource Name (ARN) of the non-Amazon FSx resource.
        ResourceARN: string
        Message: string
    end

    -- The resource specified does not support tagging.
    record ResourceDoesNotSupportTagging
        -- The Amazon Resource Name (ARN) of the resource that doesn't support
        -- tagging.
        ResourceARN: string
        Message: string
    end

    -- The resource specified by the Amazon Resource Name (ARN) can't be found.
    record ResourceNotFound
        -- The resource ARN of the resource that can't be found.
        ResourceARN: string
        Message: string
    end

    enum BackupLifecycle
        "AVAILABLE"
        "CREATING"
        "TRANSFERRING"
        "DELETED"
        "FAILED"
        "PENDING"
        "COPYING"
    end

    enum DataRepositoryLifecycle
        "CREATING"
        "AVAILABLE"
        "MISCONFIGURED"
        "UPDATING"
        "DELETING"
        "FAILED"
    end

    enum DataRepositoryTaskLifecycle
        "PENDING"
        "EXECUTING"
        "FAILED"
        "SUCCEEDED"
        "CANCELED"
        "CANCELING"
    end

    enum DataRepositoryTaskType
        "EXPORT_TO_REPOSITORY"
        "IMPORT_METADATA_FROM_REPOSITORY"
        "RELEASE_DATA_FROM_FILESYSTEM"
        "AUTO_RELEASE_DATA"
    end

    enum FileCacheLifecycle
        "AVAILABLE"
        "CREATING"
        "DELETING"
        "UPDATING"
        "FAILED"
    end

    enum FileCacheType
        "LUSTRE"
    end

    enum FileSystemLifecycle
        "AVAILABLE"
        "CREATING"
        "FAILED"
        "DELETING"
        "MISCONFIGURED"
        "UPDATING"
        "MISCONFIGURED_UNAVAILABLE"
    end

    enum FileSystemType
        "WINDOWS"
        "LUSTRE"
        "ONTAP"
        "OPENZFS"
    end

    enum NetworkType
        "IPV4"
        "DUAL"
    end

    enum OpenZFSCopyStrategy
        "CLONE"
        "FULL_COPY"
        "INCREMENTAL_COPY"
    end

    enum S3AccessPointAttachmentLifecycle
        "AVAILABLE"
        "CREATING"
        "DELETING"
        "UPDATING"
        "FAILED"
        "MISCONFIGURED"
    end

    enum S3AccessPointAttachmentType
        "OPENZFS"
        "ONTAP"
    end

    enum SnapshotLifecycle
        "PENDING"
        "CREATING"
        "DELETING"
        "AVAILABLE"
    end

    enum StorageType
        "SSD"
        "HDD"
        "INTELLIGENT_TIERING"
    end

    enum StorageVirtualMachineLifecycle
        "CREATED"
        "CREATING"
        "DELETING"
        "FAILED"
        "MISCONFIGURED"
        "PENDING"
    end

    enum StorageVirtualMachineRootVolumeSecurityStyle
        "UNIX"
        "NTFS"
        "MIXED"
    end

    enum VolumeLifecycle
        "CREATING"
        "CREATED"
        "DELETING"
        "FAILED"
        "MISCONFIGURED"
        "PENDING"
        "AVAILABLE"
    end

    enum VolumeType
        "ONTAP"
        "OPENZFS"
    end

end

return M
