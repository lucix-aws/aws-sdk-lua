        -- The list of key-value pairs to associate with the pipe.
        Tags: {string : string}
        -- The time the pipe was created.
        CreationTime: number
        -- When the pipe was last updated, in ISO-8601 format (YYYY-MM-DDThh:mm:ss.sTZD).
        LastModifiedTime: number
        -- The logging configuration settings for the pipe.
        LogConfiguration: PipeLogConfiguration
        -- The identifier of the KMS
        -- customer managed key for EventBridge to use to encrypt pipe data, if one has been specified.
        -- For more information, see Data encryption in EventBridge in the Amazon EventBridge User Guide.
        KmsKeyIdentifier: string
    end

    record ListPipesInput
        -- A value that will return a subset of the pipes associated with this account. For
        -- example, "NamePrefix": "ABC" will return all endpoints with "ABC" in the
        -- name.
        NamePrefix: string
        -- The state the pipe should be in.
        DesiredState: string
        -- The state the pipe is in.
        CurrentState: string
        -- The prefix matching the pipe source.
        SourcePrefix: string
        -- The prefix matching the pipe target.
        TargetPrefix: string
        -- If nextToken is returned, there are more results available. The value of nextToken is a unique pagination token for each page.
        -- Make the call again using the returned token to retrieve the next page. Keep all other arguments unchanged. Each pagination token expires after 24 hours. Using an expired pagination
        -- token will return an HTTP 400 InvalidToken error.
        NextToken: string
        -- The maximum number of pipes to include in the response.
        Limit: number
    end

    -- An object that represents a pipe. Amazon EventBridgePipes connect event sources to
    -- targets and reduces the need for specialized knowledge and integration code.
    record Pipe
        -- The name of the pipe.
        Name: string
        -- The ARN of the pipe.
        Arn: string
        -- The state the pipe should be in.
        DesiredState: string
        -- The state the pipe is in.
        CurrentState: string
        -- The reason the pipe is in its current state.
        StateReason: string
        -- The time the pipe was created.
        CreationTime: number
