        "Creating"
        "Created"
        "CreateFailed"
        "Deleting"
        "DeleteFailed"
    end

    enum LastUpdateStatusValue
        "Successful"
        "Failed"
        "InProgress"
    end

    -- A value that indicates whether the update was successful.
