    ImageName: string
    -- The description of the WorkSpace image.
    ImageDescription: string
    -- The tags. Each WorkSpaces resource can have a maximum of 50 tags.
    Tags: {Tag}
    -- If specified, the version of Microsoft Office to subscribe to. Valid only for Windows 10 and 11
    -- BYOL images. For more information about subscribing to Office for BYOL images, see Bring
    -- Your Own Windows Desktop Licenses.
    -- Although this parameter is an array, only one item is allowed at this
