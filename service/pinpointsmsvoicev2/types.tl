    -- The request was denied because you don't have sufficient permissions to access the resource.
    record AccessDeniedException
        Message: string
        -- The reason for the exception.
        Reason: string
    end

    -- Your request has conflicting operations. This can occur if you're trying to perform more than one operation on the same resource at the same time or it could be that the requested action isn't valid for the current state or configuration of the resource.
    record ConflictException
        Message: string
        -- The reason for the exception.
        Reason: string
        -- The type of resource that caused the exception.
        ResourceType: string
        -- The unique identifier of the request.
        ResourceId: string
    end

    -- The API encountered an unexpected error and couldn't complete the request. You might be able to successfully issue the request again in the future.
    record InternalServerException
        Message: string
        -- The unique identifier of the request.
        RequestId: string
    end

    -- A requested resource couldn't be found.
    record ResourceNotFoundException
        Message: string
        -- The type of resource that caused the exception.
        ResourceType: string
        -- The unique identifier of the resource.
        ResourceId: string
    end

    -- The request would cause a service quota to be exceeded.
    record ServiceQuotaExceededException
        Message: string
        -- The reason for the exception.
        Reason: string
    end

    -- An error that occurred because too many requests were sent during a certain amount of time.
    record ThrottlingException
        Message: string
    end

    -- A validation exception for a field.
    record ValidationException
        Message: string
        -- The reason for the exception.
        Reason: string
        -- The field that failed validation.
        Fields: {ValidationExceptionField}
    end

end

return M
