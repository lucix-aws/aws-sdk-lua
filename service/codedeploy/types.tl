        message: string
    end

    -- No GitHub account connection exists with the named specified in the call.
    record GitHubAccountTokenDoesNotExistException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The call is missing a required GitHub account connection name.
    record GitHubAccountTokenNameRequiredException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The format of the specified GitHub account connection name is invalid.
    record InvalidGitHubAccountTokenNameException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The API used does not support the deployment.
    record OperationNotSupportedException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The specified resource could not be validated.
    record ResourceValidationException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- A bucket name is required, but was not provided.
    record BucketNameFilterRequiredException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The bucket name either doesn't exist or was specified in an invalid format.
    record InvalidBucketNameFilterException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The deployed state filter was specified in an invalid format.
    record InvalidDeployedStateFilterException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The specified key prefix filter was specified in an invalid format.
    record InvalidKeyPrefixFilterException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The next token was specified in an invalid format.
    record InvalidNextTokenException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The column name to sort by is either not present or was specified in an invalid
    -- format.
    record InvalidSortByException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The sort order was specified in an invalid format.
    record InvalidSortOrderException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- An instance type was specified for an in-place deployment. Instance types are
    -- supported for blue/green deployments only.
    record InvalidDeploymentInstanceTypeException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The specified instance status does not exist.
    record InvalidInstanceStatusException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- An invalid instance type was specified for instances in a blue/green deployment. Valid
    -- values include "Blue" for an original environment and "Green" for a replacement
    -- environment.
    record InvalidInstanceTypeException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The target filter name is invalid.
    record InvalidTargetFilterNameException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The external ID was specified in an invalid format.
    record InvalidExternalIdException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The specified time range was specified in an invalid format.
    record InvalidTimeRangeException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The registration status was specified in an invalid format.
    record InvalidRegistrationStatusException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The tag filter was specified in an invalid format.
    record InvalidTagFilterException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The specified ARN is not supported. For example, it might be an ARN for a resource
    -- that is not expected.
    record ArnNotSupportedException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The specified ARN is not in a valid format.
    record InvalidArnException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The ARN of a resource is required, but was not found.
    record ResourceArnRequiredException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- A lifecycle event hook is invalid. Review the hooks section in your
    -- AppSpec file to ensure the lifecycle events and hooks functions are
    -- valid.
    record InvalidLifecycleEventHookExecutionIdException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The result of a Lambda validation function that verifies a lifecycle event
    -- is invalid. It should return Succeeded or Failed.
    record InvalidLifecycleEventHookExecutionStatusException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- An attempt to return the status of an already completed lifecycle event
    -- occurred.
    record LifecycleEventAlreadyCompletedException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- No IAM ARN was included in the request. You must use an IAM session ARN or user ARN in the request.
    record IamArnRequiredException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The request included an IAM session ARN that has already been used to
    -- register a different instance.
    record IamSessionArnAlreadyRegisteredException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The specified user ARN is already registered with an on-premises instance.
    record IamUserArnAlreadyRegisteredException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- An user ARN was not specified.
    record IamUserArnRequiredException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The specified on-premises instance name is already registered.
    record InstanceNameAlreadyRegisteredException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The IAM session ARN was specified in an invalid format.
    record InvalidIamSessionArnException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- The user ARN was specified in an invalid format.
    record InvalidIamUserArnException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    -- Both an user ARN and an IAM session ARN were included in the request.
    -- Use only one ARN type.
    record MultipleIamArnsProvidedException
        -- The message that corresponds to the exception thrown by CodeDeploy.
        message: string
    end

    enum ApplicationRevisionSortBy
        "registerTime"
        "firstUsedTime"
        "lastUsedTime"
    end

    enum ComputePlatform
        "Server"
        "Lambda"
        "ECS"
    end

    enum DeploymentWaitType
        "READY_WAIT"
        "TERMINATION_WAIT"
    end

    enum FileExistsBehavior
        "DISALLOW"
        "OVERWRITE"
        "RETAIN"
    end

    enum LifecycleEventStatus
        "Pending"
        "InProgress"
        "Succeeded"
        "Failed"
        "Skipped"
        "Unknown"
    end

    enum ListStateFilterAction
        "include"
        "exclude"
        "ignore"
    end

    enum OutdatedInstancesStrategy
        "UPDATE"
        "IGNORE"
    end

    enum RegistrationStatus
        "Registered"
        "Deregistered"
    end

    enum SortOrder
        "ascending"
        "descending"
    end

    enum StopStatus
        "Pending"
        "Succeeded"
    end

end

return M
