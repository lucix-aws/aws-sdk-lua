    -- You don't have sufficient permission to perform this action.
    record AccessDeniedException
        message: string
    end

    -- The request couldn't be completed because the server temporarily failed.
    record InternalServerException
        message: string
        -- The number of seconds to wait before retrying the command.
        retryAfterSeconds: number
    end

    -- A service quota was exceeded.
    record LimitExceededException
        message: string
        -- The identifier of the resource that was exceeded.
        resourceId: string
        -- The type of resource that was exceeded.
        resourceType: string
    end

    -- The resource wasn't found.
    record ResourceNotFoundException
        message: string
        -- The identifier of the resource that wasn't found.
        resourceId: string
        -- The type of resource that wasn't found.
        resourceType: string
    end

    -- The request couldn't be completed due to throttling.
    record ThrottlingException
        message: string
        -- The quota identifier of the applied throttling rules for this request.
        quotaCode: string
        -- The code for the service that couldn't be completed due to throttling.
        serviceCode: string
        -- The number of seconds to wait before retrying the command.
        retryAfterSeconds: number
    end

    -- The input fails to satisfy the constraints specified by an Amazon Web Services service.
    record ValidationException
        message: string
        -- The reason the input failed to satisfy the constraints specified by an Amazon Web Services
        -- service.
        reason: string
        -- The list of fields that fail to satisfy the constraints specified by an Amazon Web Services
        -- service.
        fieldList: {ValidationExceptionField}
    end

    -- The request has conflicting operations. This can occur if you're trying to perform
    -- more than one operation on the same resource at the same time.
    record ConflictException
        message: string
        -- The resource on which there are conflicting operations.
        resource: string
        -- The type of resource on which there are conflicting operations..
        resourceType: string
    end

    -- The request couldn't be completed because it contains signal decoders with one or more
    -- validation errors.
    record DecoderManifestValidationException
        -- The request couldn't be completed because of invalid signals in the request.
        invalidSignals: {InvalidSignalDecoder}
        -- The request couldn't be completed because of invalid network interfaces in the
        -- request.
        invalidNetworkInterfaces: {InvalidNetworkInterface}
        message: string
    end

    -- The request couldn't be completed because it contains signals that aren't
    -- valid.
    record InvalidSignalsException
        message: string
        -- The signals which caused the exception.
        invalidSignals: {InvalidSignal}
    end

    -- The specified node type doesn't match the expected node type for a node. You can
    -- specify the node type as branch, sensor, actuator, or attribute.
    record InvalidNodeException
        -- The specified node type isn't valid.
        invalidNodes: {Node}
        -- The reason the node validation failed.
        reason: string
        message: string
    end

    enum CampaignStatus
        "CREATING"
        "WAITING_FOR_APPROVAL"
        "RUNNING"
        "SUSPENDED"
    end

    enum Compression
        "OFF"
        "SNAPPY"
    end

    enum DefaultForUnmappedSignalsType
        "CUSTOM_DECODING"
    end

    enum DiagnosticsMode
        "OFF"
        "SEND_ACTIVE_DTCS"
    end

    enum EncryptionStatus
        "PENDING"
        "SUCCESS"
        "FAILURE"
    end

    enum EncryptionType
        "KMS_BASED_ENCRYPTION"
        "FLEETWISE_DEFAULT_ENCRYPTION"
    end

    enum ListResponseScope
        "METADATA_ONLY"
    end

    enum ManifestStatus
        "ACTIVE"
        "DRAFT"
        "INVALID"
        "VALIDATING"
    end

    enum RegistrationStatus
        "REGISTRATION_PENDING"
        "REGISTRATION_SUCCESS"
        "REGISTRATION_FAILURE"
    end

    enum SignalNodeType
        "SENSOR"
        "ACTUATOR"
        "ATTRIBUTE"
        "BRANCH"
        "CUSTOM_STRUCT"
        "CUSTOM_PROPERTY"
    end

    enum SpoolingMode
        "OFF"
        "TO_DISK"
    end

    enum UpdateCampaignAction
        "APPROVE"
        "SUSPEND"
        "RESUME"
        "UPDATE"
    end

    enum UpdateMode
        "Overwrite"
        "Merge"
    end

    enum VehicleAssociationBehavior
        "CreateIotThing"
        "ValidateIotThingExists"
    end

end

return M
