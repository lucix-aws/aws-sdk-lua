    botName: string
    -- The description of the bot.
    description: string
    -- The Amazon Resource Name (ARN) of an IAM role that has permission to
    -- access the bot.
    roleArn: string
    -- Settings for managing data privacy of the bot and its conversations
    -- with users.
    dataPrivacy: DataPrivacy
    -- The maximum time in seconds that Amazon Lex retains the data gathered in
    -- a conversation.
    idleSessionTTLInSeconds: number
    -- The current status of the bot. When the status is
    -- Available the bot is ready to be used in conversations
    -- with users.
    botStatus: string
    -- A timestamp of the date and time that the bot was created.
    creationDateTime: number
    -- A timestamp of the date and time that the bot was last
    -- updated.
    lastUpdatedDateTime: number
    -- The type of the bot that was described.
    botType: string
    -- The list of bots in the network that was described.
    botMembers: {BotMember}
    -- If the botStatus is Failed, this contains
    -- a list of reasons that the bot couldn't be built.
    failureReasons: {string}
    -- Contains the configuration for error logging that specifies where and how bot errors are recorded, including destinations like CloudWatch Logs.
    errorLogSettings: ErrorLogSettings
end

local record DescribeBotAliasInput
    -- The identifier of the bot alias to describe.
    botAliasId: string
    -- The identifier of the bot associated with the bot alias to
    -- describe.
