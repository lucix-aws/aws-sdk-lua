        -- Name field and possibly several more in the Subject Alternative
        -- Names field. One of the domain names in the certificate should match the
        -- value that you specify for FullyQualifiedDomainName. If the endpoint
        -- responds to the client_hello message with a certificate that does not
        -- include the domain name that you specified in FullyQualifiedDomainName, a
        -- health checker will retry the handshake. In the second attempt, the health checker will
        -- omit FullyQualifiedDomainName from the client_hello
        -- message.
        EnableSNI: boolean
        -- A complex type that contains one Region element for each region that you
        -- want Amazon Route 53 health checkers to check the specified endpoint from.
        Regions: {string}
        -- A complex type that identifies the CloudWatch alarm that you want Amazon Route 53
        -- health checkers to use to determine whether the specified health check is
        -- healthy.
        AlarmIdentifier: AlarmIdentifier
        -- When CloudWatch has insufficient data about the metric to determine the alarm state,
        -- the status that you want Amazon Route 53 to assign to the health check:
        -- Healthy: Route 53 considers the health check to be
        -- healthy.
        -- Unhealthy: Route 53 considers the health check to be
        -- unhealthy.
        -- LastKnownStatus: By default, Route 53 uses the status of the
        -- health check from the last time CloudWatch had sufficient data to determine the
        -- alarm state. For new health checks that have no last known status, the status
        -- for the health check is healthy.
        InsufficientDataHealthStatus: string
        -- A complex type that contains one ResettableElementName element for each
        -- element that you want to reset to the default value. Valid values for
        -- ResettableElementName include the following:
        -- ChildHealthChecks: Amazon Route 53 resets ChildHealthChecks to null.
        -- FullyQualifiedDomainName: Route 53 resets FullyQualifiedDomainName. to null.
        -- Regions: Route 53 resets the Regions list to the default set of regions.
        -- ResourcePath: Route 53 resets ResourcePath to null.
        ResetElements: {string}
    end

    -- A complex type that contains the response to the UpdateHealthCheck
    -- request.
    record UpdateHealthCheckOutput
        -- A complex type that contains the response to an UpdateHealthCheck
        -- request.
        HealthCheck: HealthCheck
    end

    -- A request to update the comment for a hosted zone.
    record UpdateHostedZoneCommentInput
        -- The ID for the hosted zone that you want to update the comment for.
        Id: string
        -- The new comment for the hosted zone. If you don't specify a value for
        -- Comment, Amazon Route 53 deletes the existing value of the
        -- Comment element, if any.
        Comment: string
    end

    -- A complex type that contains the response to the UpdateHostedZoneComment
    -- request.
    record UpdateHostedZoneCommentOutput
        -- A complex type that contains the response to the UpdateHostedZoneComment
        -- request.
        HostedZone: HostedZone
    end

    record UpdateHostedZoneFeaturesInput
        -- The ID of the hosted zone for which you want to update features. This is the unique identifier for your hosted zone.
        HostedZoneId: string
        -- Specifies whether to enable accelerated recovery for the hosted zone. Set to true to enable accelerated recovery, or false to disable it.
        EnableAcceleratedRecovery: boolean
    end

    record UpdateHostedZoneFeaturesOutput
    end

    -- A complex type that contains information about the traffic policy that you want to
    -- update the comment for.
    record UpdateTrafficPolicyCommentInput
        -- The value of Id for the traffic policy that you want to update the
        -- comment for.
        Id: string
        -- The value of Version for the traffic policy that you want to update the
        -- comment for.
        Version: number
        -- The new comment for the specified traffic policy and version.
        Comment: string
    end

    -- A complex type that contains the response information for the traffic policy.
    record UpdateTrafficPolicyCommentOutput
        -- A complex type that contains settings for the specified traffic policy.
        TrafficPolicy: TrafficPolicy
    end

    -- A complex type that contains information about the resource record sets that you want
    -- to update based on a specified traffic policy instance.
    record UpdateTrafficPolicyInstanceInput
        -- The ID of the traffic policy instance that you want to update.
        Id: string
        -- The TTL that you want Amazon Route 53 to assign to all of the updated resource record
        -- sets.
        TTL: number
        -- The ID of the traffic policy that you want Amazon Route 53 to use to update resource
        -- record sets for the specified traffic policy instance.
        TrafficPolicyId: string
        -- The version of the traffic policy that you want Amazon Route 53 to use to update
        -- resource record sets for the specified traffic policy instance.
        TrafficPolicyVersion: number
    end

    -- A complex type that contains information about the resource record sets that Amazon
    -- Route 53 created based on a specified traffic policy.
    record UpdateTrafficPolicyInstanceOutput
        -- A complex type that contains settings for the updated traffic policy instance.
        TrafficPolicyInstance: TrafficPolicyInstance
    end

    -- Another user submitted a request to create, update, or delete the object at the same
    -- time that you did. Retry the request.
    record ConcurrentModification
        message: string
    end

    -- The input is not valid.
    record InvalidInput
        message: string
    end

    -- The key-signing key (KSK) status isn't valid or another KSK has the status
    -- INTERNAL_FAILURE.
    record InvalidKeySigningKeyStatus
        message: string
    end

    -- The KeyManagementServiceArn that you specified isn't valid to use with DNSSEC
    -- signing.
    record InvalidKMSArn
        message: string
    end

    -- Your hosted zone status isn't valid for this operation. In the hosted zone, change the
    -- status to enable DNSSEC or disable DNSSEC.
    record InvalidSigningStatus
        message: string
    end

    -- The specified key-signing key (KSK) doesn't exist.
    record NoSuchKeySigningKey
        message: string
    end

    -- The cause of this error depends on the operation that you're performing:
    -- Create a public hosted zone: Two hosted zones
    -- that have the same name or that have a parent/child relationship (example.com
    -- and test.example.com) can't have any common name servers. You tried to create a
    -- hosted zone that has the same name as an existing hosted zone or that's the
    -- parent or child of an existing hosted zone, and you specified a delegation set
    -- that shares one or more name servers with the existing hosted zone. For more
    -- information, see CreateReusableDelegationSet.
    -- Create a private hosted zone: A hosted zone
    -- with the specified name already exists and is already associated with the Amazon
    -- VPC that you specified.
    -- Associate VPCs with a private hosted zone:
    -- The VPC that you specified is already associated with another hosted zone that
    -- has the same name.
    record ConflictingDomainExists
        message: string
    end

    -- The VPC ID that you specified either isn't a valid ID or the current account is not
    -- authorized to access this VPC.
    record InvalidVPCId
        message: string
    end

    -- This operation can't be completed because the current account has reached the
    -- limit on the resource you are trying to create. To request a higher limit, create a case with the Amazon Web Services Support
    -- Center.
    record LimitsExceeded
        message: string
    end

    -- No hosted zone exists with the ID that you specified.
    record NoSuchHostedZone
        message: string
    end

    -- Associating the specified VPC with the specified hosted zone has not been
    -- authorized.
    record NotAuthorizedException
        message: string
    end

    -- If Amazon Route 53 can't process a request before the next request arrives, it will
    -- reject subsequent requests for the same hosted zone and return an HTTP 400
    -- error (Bad request). If Route 53 returns this error repeatedly
    -- for the same request, we recommend that you wait, in intervals of increasing duration,
    -- before you try the request again.
    record PriorRequestNotComplete
        message: string
    end

    -- You're trying to associate a VPC with a public hosted zone. Amazon Route 53 doesn't
    -- support associating a VPC with a public hosted zone.
    record PublicZoneVPCAssociation
        message: string
    end

    -- This CIDR block is already in use.
    record CidrBlockInUseException
        Message: string
    end

    -- The CIDR collection version you provided, doesn't match the one in the
    -- ListCidrCollections operation.
    record CidrCollectionVersionMismatchException
        Message: string
    end

    -- The CIDR collection you specified, doesn't exist.
    record NoSuchCidrCollectionException
        Message: string
    end

    -- This exception contains a list of messages that might contain one or more error
    -- messages. Each error message indicates one error in the change batch.
    record InvalidChangeBatch
        messages: {string}
        message: string
    end

    -- No health check exists with the specified ID.
    record NoSuchHealthCheck
        message: string
    end

    -- The limit on the number of requests per second was exceeded.
    record ThrottlingException
        message: string
    end

    -- A CIDR collection with this name and a different caller reference already exists in this account.
    record CidrCollectionAlreadyExistsException
        Message: string
    end

    -- The health check you're attempting to create already exists. Amazon Route 53 returns
    -- this error when you submit a request that has the following values:
    -- The same value for CallerReference as an existing health check,
    -- and one or more values that differ from the existing health check that has the
    -- same caller reference.
    -- The same value for CallerReference as a health check that you
    -- created and later deleted, regardless of the other settings in the
    -- request.
    record HealthCheckAlreadyExists
        message: string
    end

    -- This health check can't be created because the current account has reached the limit
    -- on the number of active health checks.
    -- For information about default limits, see Limits in the
    -- Amazon Route 53 Developer Guide.
    -- For information about how to get the current limit for an account, see GetAccountLimit. To request a higher limit, create a case with the Amazon Web Services Support
    -- Center.
    -- You have reached the maximum number of active health checks for an Amazon Web Services account. To request a higher limit, create a case with the Amazon Web Services Support
    -- Center.
    record TooManyHealthChecks
        message: string
    end

    -- You can create a hosted zone that has the same name as an existing hosted zone
    -- (example.com is common), but there is a limit to the number of hosted zones that have
    -- the same name. If you get this error, Amazon Route 53 has reached that limit. If you own
    -- the domain name and Route 53 generates this error, contact Customer Support.
    record DelegationSetNotAvailable
        message: string
    end

    -- A reusable delegation set with the specified ID does not exist.
    record DelegationSetNotReusable
        message: string
    end

    -- The hosted zone you're trying to create already exists. Amazon Route 53 returns this
    -- error when a hosted zone has already been created with the specified
    -- CallerReference.
    record HostedZoneAlreadyExists
        message: string
    end

    -- The specified domain name is not valid.
    record InvalidDomainName
        message: string
    end

    -- A reusable delegation set with the specified ID does not exist.
    record NoSuchDelegationSet
        message: string
    end

    -- This operation can't be completed either because the current account has reached the
    -- limit on the number of hosted zones or because you've reached the limit on the number of
    -- hosted zones that can be associated with a reusable delegation set.
    -- For information about default limits, see Limits in the
    -- Amazon Route 53 Developer Guide.
    -- To get the current limit on hosted zones that can be created by an account, see GetAccountLimit.
    -- To get the current limit on hosted zones that can be associated with a reusable
    -- delegation set, see GetReusableDelegationSetLimit.
    -- To request a higher limit, create a
    -- case with the Amazon Web Services Support Center.
    record TooManyHostedZones
        message: string
    end

    -- Parameter name is not valid.
    record InvalidArgument
        message: string
    end

    -- The key-signing key (KSK) name that you specified isn't a valid name.
    record InvalidKeySigningKeyName
        message: string
    end

    -- You've already created a key-signing key (KSK) with this name or with the same customer managed key ARN.
    record KeySigningKeyAlreadyExists
        message: string
    end

    -- You've reached the limit for the number of key-signing keys (KSKs). Remove at least
    -- one KSK, and then try again.
    record TooManyKeySigningKeys
        message: string
    end

    -- Amazon Route 53 doesn't have the permissions required to create log streams and send
    -- query logs to log streams. Possible causes include the following:
    -- There is no resource policy that specifies the log group ARN in the value for
    -- Resource.
    -- The resource policy that includes the log group ARN in the value for
    -- Resource doesn't have the necessary permissions.
    -- The resource policy hasn't finished propagating yet.
    -- The Key management service (KMS) key you specified doesn’t exist or it can’t
    -- be used with the log group associated with query log. Update or provide a
    -- resource policy to grant permissions for the KMS key.
    -- The Key management service (KMS) key you specified is marked as
    -- disabled for the log group associated with query log. Update or provide
    -- a resource policy to grant permissions for the KMS key.
    record InsufficientCloudWatchLogsResourcePolicy
        message: string
    end

    -- There is no CloudWatch Logs log group with the specified ARN.
    record NoSuchCloudWatchLogsLogGroup
        message: string
    end

    -- You can create only one query logging configuration for a hosted zone, and a query
    -- logging configuration already exists for this hosted zone.
    record QueryLoggingConfigAlreadyExists
        message: string
    end

    -- A delegation set with the same owner and caller reference combination has already been
    -- created.
    record DelegationSetAlreadyCreated
        message: string
    end

    -- The specified delegation set has already been marked as reusable.
    record DelegationSetAlreadyReusable
        message: string
    end

    -- The specified HostedZone can't be found.
    record HostedZoneNotFound
        message: string
    end

    -- The format of the traffic policy document that you specified in the
    -- Document element is not valid.
    record InvalidTrafficPolicyDocument
        message: string
    end

    -- This traffic policy can't be created because the current account has reached the limit
    -- on the number of traffic policies.
    -- For information about default limits, see Limits in the
    -- Amazon Route 53 Developer Guide.
    -- To get the current limit for an account, see GetAccountLimit.
    -- To request a higher limit, create a
    -- case with the Amazon Web Services Support Center.
    record TooManyTrafficPolicies
        message: string
    end

    -- A traffic policy that has the same value for Name already exists.
    record TrafficPolicyAlreadyExists
        message: string
    end

    -- No traffic policy exists with the specified ID.
    record NoSuchTrafficPolicy
        message: string
    end

    -- This traffic policy instance can't be created because the current account has reached
    -- the limit on the number of traffic policy instances.
    -- For information about default limits, see Limits in the
    -- Amazon Route 53 Developer Guide.
    -- For information about how to get the current limit for an account, see GetAccountLimit.
    -- To request a higher limit, create a
    -- case with the Amazon Web Services Support Center.
    record TooManyTrafficPolicyInstances
        message: string
    end

    -- There is already a traffic policy instance with the specified ID.
    record TrafficPolicyInstanceAlreadyExists
        message: string
    end

    -- This traffic policy version can't be created because you've reached the limit of 1000
    -- on the number of versions that you can create for the current traffic policy.
    -- To create more traffic policy versions, you can use GetTrafficPolicy
    -- to get the traffic policy document for a specified traffic policy version, and then use
    -- CreateTrafficPolicy to create a new traffic policy using the traffic policy
    -- document.
    record TooManyTrafficPolicyVersionsForCurrentPolicy
        message: string
    end

    -- You've created the maximum number of authorizations that can be created for the
    -- specified hosted zone. To authorize another VPC to be associated with the hosted zone,
    -- submit a DeleteVPCAssociationAuthorization request to remove an existing
    -- authorization. To get a list of existing authorizations, submit a
    -- ListVPCAssociationAuthorizations request.
    record TooManyVPCAssociationAuthorizations
        message: string
    end

    -- The key-signing key (KSK) is specified in a parent DS record.
    record KeySigningKeyInParentDSRecord
        message: string
    end

    -- The key-signing key (KSK) that you specified can't be deactivated because it's the
    -- only KSK for a currently-enabled DNSSEC. Disable DNSSEC signing, or add or enable
    -- another KSK.
    record KeySigningKeyInUse
        message: string
    end

    -- This CIDR collection is in use, and isn't empty.
    record CidrCollectionInUseException
        Message: string
    end

    -- This error code is not in use.
    record HealthCheckInUse
        message: string
    end

    -- The hosted zone contains resource records that are not SOA or NS records.
    record HostedZoneNotEmpty
        message: string
    end

    -- There is no DNS query logging configuration with the specified ID.
    record NoSuchQueryLoggingConfig
        message: string
    end

    -- The specified delegation contains associated hosted zones which must be deleted before
    -- the reusable delegation set can be deleted.
    record DelegationSetInUse
        message: string
    end

    -- One or more traffic policy instances were created by using the specified traffic
    -- policy.
    record TrafficPolicyInUse
        message: string
    end

    -- No traffic policy instance exists with the specified ID.
    record NoSuchTrafficPolicyInstance
        message: string
    end

    -- The VPC that you specified is not authorized to be associated with the hosted
    -- zone.
    record VPCAssociationAuthorizationNotFound
        message: string
    end

    -- The hosted zone doesn't have any DNSSEC resources.
    record DNSSECNotFound
        message: string
    end

    -- The VPC that you're trying to disassociate from the private hosted zone is the last
    -- VPC that is associated with the hosted zone. Amazon Route 53 doesn't support
    -- disassociating the last VPC from a hosted zone.
    record LastVPCAssociation
        message: string
    end

    -- The specified VPC and hosted zone are not currently associated.
    record VPCAssociationNotFound
        -- The specified VPC or hosted zone weren't found.
        message: string
    end

    -- The hosted zone nameservers don't match the parent nameservers. The hosted zone and
    -- parent must have the same nameservers.
    record HostedZonePartiallyDelegated
        message: string
    end

    -- A key-signing key (KSK) with ACTIVE status wasn't found.
    record KeySigningKeyWithActiveStatusNotFound
        message: string
    end

    -- A change with the specified change ID does not exist.
    record NoSuchChange
        message: string
    end

    -- Amazon Route 53 doesn't support the specified geographic location. For a list of
    -- supported geolocation codes, see the GeoLocation data
    -- type.
    record NoSuchGeoLocation
        message: string
    end

    -- The resource you're trying to access is unsupported on this Amazon Route 53
    -- endpoint.
    record IncompatibleVersion
        message: string
    end

    -- The specified hosted zone is a public hosted zone, not a private hosted zone.
    record HostedZoneNotPrivate
        message: string
    end

    -- The CIDR collection location doesn't match any locations in your account.
    record NoSuchCidrLocationException
        Message: string
    end

    -- The value that you specified to get the second or subsequent page of results is
    -- invalid.
    record InvalidPaginationToken
        message: string
    end

    -- The value of HealthCheckVersion in the request doesn't match the value of
    -- HealthCheckVersion in the health check.
    record HealthCheckVersionMismatch
        message: string
    end

    -- You tried to update a traffic policy instance by using a traffic policy version that
    -- has a different DNS type than the current type for the instance. You specified the type
    -- in the JSON document in the CreateTrafficPolicy or
    -- CreateTrafficPolicyVersionrequest.
    record ConflictingTypes
        message: string
    end

    enum AccountLimitType
        "MAX_HEALTH_CHECKS_BY_OWNER"
        "MAX_HOSTED_ZONES_BY_OWNER"
        "MAX_TRAFFIC_POLICY_INSTANCES_BY_OWNER"
        "MAX_REUSABLE_DELEGATION_SETS_BY_OWNER"
        "MAX_TRAFFIC_POLICIES_BY_OWNER"
    end

    enum HostedZoneLimitType
        "MAX_RRSETS_BY_ZONE"
        "MAX_VPCS_ASSOCIATED_BY_ZONE"
    end

    enum HostedZoneType
        "PrivateHostedZone"
    end

    enum InsufficientDataHealthStatus
        "Healthy"
        "Unhealthy"
        "LastKnownStatus"
    end

    enum RRType
        "SOA"
        "A"
        "TXT"
        "NS"
        "CNAME"
        "MX"
        "NAPTR"
        "PTR"
        "SRV"
        "SPF"
        "AAAA"
        "CAA"
        "DS"
        "TLSA"
        "SSHFP"
        "SVCB"
        "HTTPS"
    end

    enum ReusableDelegationSetLimitType
        "MAX_ZONES_BY_REUSABLE_DELEGATION_SET"
    end

    enum TagResourceType
        "healthcheck"
        "hostedzone"
    end

    enum VPCRegion
        "us-east-1"
        "us-east-2"
        "us-west-1"
        "us-west-2"
        "eu-west-1"
        "eu-west-2"
        "eu-west-3"
        "eu-central-1"
        "eu-central-2"
        "ap-east-1"
        "me-south-1"
        "us-gov-west-1"
        "us-gov-east-1"
        "us-iso-east-1"
        "us-iso-west-1"
        "us-isob-east-1"
        "me-central-1"
        "ap-southeast-1"
        "ap-southeast-2"
        "ap-southeast-3"
        "ap-south-1"
        "ap-south-2"
        "ap-northeast-1"
        "ap-northeast-2"
        "ap-northeast-3"
        "eu-north-1"
        "sa-east-1"
        "ca-central-1"
        "cn-north-1"
        "cn-northwest-1"
        "af-south-1"
        "eu-south-1"
        "eu-south-2"
        "ap-southeast-4"
        "il-central-1"
        "ca-west-1"
        "ap-southeast-5"
        "mx-central-1"
        "us-isof-south-1"
        "us-isof-east-1"
        "ap-southeast-7"
        "ap-east-2"
        "eu-isoe-west-1"
        "ap-southeast-6"
        "us-isob-west-1"
        "eusc-de-east-1"
    end

end

return M
