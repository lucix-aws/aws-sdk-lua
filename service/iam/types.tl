    -- The request was rejected because trusted access is not enabled for IAM in Organizations. For details, see IAM and Organizations in the Organizations User Guide.
    record ServiceAccessNotEnabledException
        Message: string
    end

    -- The request failed because outbound identity federation is already disabled for your Amazon Web Services account. You cannot disable the feature multiple times
    record FeatureDisabledException
        message: string
    end

    -- The request was rejected because the authentication code was not recognized. The error
    -- message describes the specific error.
    record InvalidAuthenticationCodeException
        message: string
    end

    -- The request was rejected because the account making the request is not the management
    -- account for the organization.
    record CallerIsNotManagementAccountException
        Message: string
    end

    -- The request failed because outbound identity federation is already enabled for your Amazon Web Services account. You
    -- cannot enable the feature multiple times. To fetch the current configuration (including the unique issuer URL), use the GetOutboundWebIdentityFederationInfo operation.
    record FeatureEnabledException
