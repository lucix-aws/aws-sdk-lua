    record KeyPairMismatchException
        message: string
    end

    -- The request was rejected because the certificate was malformed or expired. The error
    -- message describes the specific error.
    record MalformedCertificateException
        message: string
    end

    -- The request was rejected because the same certificate is associated with an IAM user in
