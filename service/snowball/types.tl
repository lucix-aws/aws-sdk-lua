    end

    -- The NextToken string was altered unexpectedly, and the operation has
    -- stopped. Run the operation without changing the NextToken string, and try
    -- again.
    record InvalidNextTokenException
        Message: string
    end

    enum ImpactLevel
        "IL2"
        "IL4"
        "IL5"
        "IL6"
        "IL99"
    end

    enum JobType
        "IMPORT"
        "EXPORT"
        "LOCAL_USE"
    end

    enum LongTermPricingType
        "OneYear"
        "ThreeYear"
        "OneMonth"
    end

    enum RemoteManagement
        "INSTALLED_ONLY"
        "INSTALLED_AUTOSTART"
        "NOT_INSTALLED"
    end

    enum ServiceName
        "KUBERNETES"
        "EKS_ANYWHERE"
    end

    enum ShipmentState
        "RECEIVED"
        "RETURNED"
    end

    enum ShippingLabelStatus
        "InProgress"
        "TimedOut"
        "Succeeded"
        "Failed"
    end

    enum ShippingOption
        "SECOND_DAY"
        "NEXT_DAY"
        "EXPRESS"
        "STANDARD"
    end

    enum SnowballCapacity
        "T50"
        "T80"
        "T100"
        "T42"
        "T98"
        "T8"
        "T14"
        "T32"
        "NoPreference"
        "T240"
        "T13"
    end

    enum SnowballType
        "STANDARD"
        "EDGE"
        "EDGE_C"
        "EDGE_CG"
        "EDGE_S"
        "SNC1_HDD"
        "SNC1_SSD"
        "V3_5C"
        "V3_5S"
        "RACK_5U_C"
    end

end

return M
