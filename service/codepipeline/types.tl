        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The client token was specified in an invalid format
    record InvalidClientTokenException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- Unable to modify the tag due to a simultaneous update request.
    record ConcurrentModificationException
        message: string
    end

    -- The specified resource tags are invalid.
    record InvalidTagsException
        message: string
    end

    -- The number of pipelines associated with the Amazon Web Services account has exceeded
    -- the limit allowed for the account.
    record LimitExceededException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The tags limit for a resource has been exceeded.
    record TooManyTagsException
        message: string
    end

    -- The action declaration was specified in an invalid format.
    record InvalidActionDeclarationException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- Reserved for future use.
    record InvalidBlockerDeclarationException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The stage declaration was specified in an invalid format.
    record InvalidStageDeclarationException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The structure was specified in an invalid format.
    record InvalidStructureException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The specified pipeline name is already in use.
    record PipelineNameInUseException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The specified webhook was entered in an invalid format or cannot be
    -- found.
    record WebhookNotFoundException
    end

    -- The pipeline was specified in an invalid format or cannot be found.
    record PipelineNotFoundException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The stage was specified in an invalid format or cannot be found.
    record StageNotFoundException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The specified action type cannot be found.
    record ActionTypeNotFoundException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The pipeline version was specified in an invalid format or cannot be
    -- found.
    record PipelineVersionNotFoundException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The pipeline execution was specified in an invalid format or cannot be found, or an
    -- execution ID does not belong to the specified pipeline.
    record PipelineExecutionNotFoundException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The job was specified in an invalid format or cannot be found.
    record InvalidJobException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The next token was specified in an invalid format. Make sure that the next token
    -- you provide is the token returned by a previous call.
    record InvalidNextTokenException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The action execution was not found.
    record ActionExecutionNotFoundException
        message: string
    end

    -- The specified resource ARN is invalid.
    record InvalidArnException
        message: string
    end

    -- The resource was specified in an invalid format.
    record ResourceNotFoundException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The pipeline has reached the limit for concurrent pipeline executions.
    record ConcurrentPipelineExecutionsLimitExceededException
        message: string
    end

    -- Unable to override because the condition does not allow overrides.
    record ConditionNotOverridableException
        message: string
    end

    -- Your request cannot be handled because the pipeline is busy handling ongoing
    -- activities. Try again later.
    record ConflictException
        message: string
    end

    -- The stage has failed in a later run of the pipeline and the
    -- pipelineExecutionId associated with the request is out of
    -- date.
    record NotLatestPipelineExecutionException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The specified action cannot be found.
    record ActionNotFoundException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The approval action has already been approved or rejected.
    record ApprovalAlreadyCompletedException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The approval request already received a response or has expired.
    record InvalidApprovalTokenException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The job state was specified in an invalid format.
    record InvalidJobStateException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- Exceeded the total size limit for all variables in the pipeline.
    record OutputVariablesSizeExceededException
        message: string
    end

    -- The specified authentication type is in an invalid format.
    record InvalidWebhookAuthenticationParametersException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The specified event filter rule is in an invalid format.
    record InvalidWebhookFilterPatternException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- Unable to retry. The pipeline structure or stage state might have changed while
    -- actions awaited retry, or the stage contains no failed
    -- actions.
    record StageNotRetryableException
        -- The message provided to the user in the event of an exception.
        message: string
    end

    -- The specified pipeline execution is outdated and cannot be used as a target pipeline
    -- execution for rollback.
    record PipelineExecutionOutdatedException
        message: string
    end

    -- Unable to roll back the stage. The cause might be if the pipeline version has changed
    -- since the target pipeline execution was deployed, the stage is currently running, or an
    -- incorrect target pipeline execution ID was provided.
    record UnableToRollbackStageException
        message: string
    end

    -- The pipeline execution is already in a Stopping state. If you already
    -- chose to stop and wait, you cannot make that request again. You can choose to stop and
    -- abandon now, but be aware that this option can lead to failed tasks or out of sequence
    -- tasks. If you already chose to stop and abandon, you cannot make that request
    -- again.
    record DuplicatedStopRequestException
        message: string
    end

    -- Unable to stop the pipeline execution. The execution might already be in a
    -- Stopped state, or it might no longer be in progress.
    record PipelineExecutionNotStoppableException
        message: string
    end

    -- The request failed because of an unknown error, exception, or failure.
    record RequestFailedException
        message: string
    end

    enum ActionCategory
        "Source"
        "Build"
        "Deploy"
        "Test"
        "Invoke"
        "Approval"
        "Compute"
    end

    enum ActionOwner
        "AWS"
        "ThirdParty"
        "Custom"
    end

    enum ConditionType
        "BEFORE_ENTRY"
        "ON_SUCCESS"
    end

    enum JobStatus
        "Created"
        "Queued"
        "Dispatched"
        "InProgress"
        "TimedOut"
        "Succeeded"
        "Failed"
    end

    enum RuleOwner
        "AWS"
    end

    enum StageRetryMode
        "FAILED_ACTIONS"
        "ALL_ACTIONS"
    end

    enum StageTransitionType
        "Inbound"
        "Outbound"
    end

end

return M
