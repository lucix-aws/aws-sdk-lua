    EngineVersion: string
    -- Indicates that major version upgrades are allowed. Changing this parameter doesn't result
    -- in an outage and the change is asynchronously applied as soon as possible.
    AllowMajorVersionUpgrade: boolean
    -- Indicates that minor version upgrades are applied automatically to the DB instance during
