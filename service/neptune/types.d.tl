-- User already has a DB cluster with the given identifier.
local record DBClusterAlreadyExistsFault
    -- A message describing the details of the problem.
    message: string
end

-- DBClusterIdentifier does not refer to an existing DB cluster.
local record DBClusterNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- DBClusterParameterGroupName does not refer to an
-- existing DB Cluster parameter group.
local record DBClusterParameterGroupNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- User attempted to create a new DB cluster and the user has already reached the maximum allowed DB cluster quota.
local record DBClusterQuotaExceededFault
    -- A message describing the details of the problem.
    message: string
end

-- DBClusterSnapshotIdentifier does not refer to an existing
-- DB cluster snapshot.
local record DBClusterSnapshotNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- DBSubnetGroupName does not refer to an
-- existing DB subnet group.
local record DBSubnetGroupNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- The DB cluster does not have enough capacity for the current operation.
local record InsufficientDBClusterCapacityFault
    -- A message describing the details of the problem.
    message: string
end

-- There is insufficient storage available for the current action. You may
-- be able to resolve this error by updating your subnet group to use different
-- Availability Zones that have more storage available.
local record InsufficientStorageClusterCapacityFault
    -- A message describing the details of the problem.
    message: string
end

-- The supplied value is not a valid DB cluster snapshot state.
local record InvalidDBClusterSnapshotStateFault
    -- A message describing the details of the problem.
    message: string
end

-- The DB cluster is not in a valid state.
local record InvalidDBClusterStateFault
    -- A message describing the details of the problem.
    message: string
end

-- The state of the DB snapshot does not allow deletion.
local record InvalidDBSnapshotStateFault
    -- A message describing the details of the problem.
    message: string
end

-- Cannot restore from vpc backup to non-vpc DB instance.
local record InvalidRestoreFault
    -- A message describing the details of the problem.
    message: string
end

-- The requested subnet is invalid, or multiple subnets were requested that are
-- not all in a common VPC.
local record InvalidSubnet
    -- A message describing the details of the problem.
    message: string
end

-- DB subnet group does not cover all Availability Zones after it is created
-- because users' change.
local record InvalidVPCNetworkStateFault
    -- A message describing the details of the problem.
    message: string
end

-- Error accessing KMS key.
local record KMSKeyNotAccessibleFault
    -- A message describing the details of the problem.
    message: string
end

-- The designated option group could not be found.
local record OptionGroupNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- Request would result in user exceeding the allowed amount of storage available across all DB instances.
local record StorageQuotaExceededFault
    -- A message describing the details of the problem.
    message: string
end

-- DBClusterIdentifier does not refer to an existing DB cluster.
local record DBClusterNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- The DB cluster is not in a valid state.
local record InvalidDBClusterStateFault
    -- A message describing the details of the problem.
    message: string
end

-- The specified DB instance is not in the available state.
local record InvalidDBInstanceStateFault
    -- A message describing the details of the problem.
    message: string
end

-- DBClusterIdentifier does not refer to an existing DB cluster.
local record DBClusterNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- The DB cluster is not in a valid state.
local record InvalidDBClusterStateFault
    -- A message describing the details of the problem.
    message: string
end

-- The specified DB instance is not in the available state.
local record InvalidDBInstanceStateFault
    -- A message describing the details of the problem.
    message: string
end

-- DBClusterIdentifier does not refer to an existing DB cluster.
local record DBClusterNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- The GlobalClusterIdentifier doesn't refer to an existing global database cluster.
local record GlobalClusterNotFoundFault
    -- A message describing the details of the problem.
    message: string
end

-- The DB cluster is not in a valid state.
local record InvalidDBClusterStateFault
    -- A message describing the details of the problem.
    message: string
end

-- The global cluster is in an invalid state and can't perform the requested operation.
local record InvalidGlobalClusterStateFault
    -- A message describing the details of the problem.
    message: string
end

