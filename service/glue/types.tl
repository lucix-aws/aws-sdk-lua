        "CONDITIONAL"
        "ON_DEMAND"
        "EVENT"
    end

    enum ViewUpdateAction
        "ADD"
        "REPLACE"
        "ADD_OR_REPLACE"
        "DROP"
    end

    enum WorkerType
        "Standard"
        "G.1X"
        "G.2X"
        "G.025X"
        "G.4X"
        "G.8X"
        "Z.2X"
    end

end

