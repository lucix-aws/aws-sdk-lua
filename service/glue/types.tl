    -- A resource to be created or added already exists.
    record AlreadyExistsException
        -- A message describing the problem.
        Message: string
    end

    -- A specified entity does not exist
    record EntityNotFoundException
        -- A message describing the problem.
        Message: string
        -- Indicates whether or not the exception relates to a federated source.
        FromFederationSource: boolean
    end

    -- An encryption operation failed.
    record GlueEncryptionException
        -- The message describing the problem.
        Message: string
    end

    -- An internal service error occurred.
    record InternalServiceException
        -- A message describing the problem.
        Message: string
    end

    -- The input provided was not valid.
    record InvalidInputException
        -- A message describing the problem.
        Message: string
        -- Indicates whether or not the exception relates to a federated source.
        FromFederationSource: boolean
    end

    -- The operation timed out.
    record OperationTimeoutException
        -- A message describing the problem.
        Message: string
    end

    -- A resource numerical limit was exceeded.
    record ResourceNumberLimitExceededException
        -- A message describing the problem.
        Message: string
    end

    -- A resource was not ready for a transaction.
    record ResourceNotReadyException
        -- A message describing the problem.
        Message: string
    end

    -- Access to a resource was denied.
    record AccessDeniedException
        -- A message describing the problem.
        Message: string
    end

    -- A federation source failed.
    record FederationSourceException
        -- The error code of the problem.
        FederationSourceErrorCode: string
        -- The message describing the problem.
        Message: string
    end

    -- A federation source failed, but the operation may be retried.
    record FederationSourceRetryableException
        -- A message describing the problem.
        Message: string
    end

    -- An error that indicates your data is in an invalid state.
    record InvalidStateException
        -- A message describing the problem.
        Message: string
    end

    -- The throttling threshhold was exceeded.
    record ThrottlingException
        -- A message describing the problem.
        Message: string
    end

    -- The session is in an invalid state to perform a requested operation.
    record IllegalSessionStateException
        -- A message describing the problem.
        Message: string
    end

    -- Two processes are trying to modify a resource simultaneously.
    record ConcurrentModificationException
        -- A message describing the problem.
        Message: string
    end

    -- A federated resource already exists.
    record FederatedResourceAlreadyExistsException
        -- The message describing the problem.
        Message: string
        -- The associated Glue resource already exists.
        AssociatedGlueResource: string
    end

    -- An exception thrown when you try to start another job while running a column stats generation job.
    record ColumnStatisticsTaskRunningException
        -- A message describing the problem.
        Message: string
    end

    -- The same unique identifier was associated with two different records.
    record IdempotentParameterMismatchException
        -- A message describing the problem.
        Message: string
    end

    -- A value could not be validated.
    record ValidationException
        -- A message describing the problem.
        Message: string
    end

    -- The CreatePartitions API was called on a table that has indexes enabled.
    record ConflictException
        -- A message describing the problem.
        Message: string
    end

    -- The requested operation conflicts with another operation.
    record IntegrationConflictOperationFault
        -- A message describing the problem.
        Message: string
    end

    -- The data processed through your integration exceeded your quota.
    record IntegrationQuotaExceededFault
        -- A message describing the problem.
        Message: string
    end

    -- An internal server error occurred.
    record InternalServerException
        -- A message describing the problem.
        Message: string
    end

    -- The KMS key specified is not accessible.
    record KMSKeyNotAccessibleFault
        -- A message describing the problem.
        Message: string
    end

    -- The resource could not be found.
    record ResourceNotFoundException
        -- A message describing the problem.
        Message: string
    end

    -- The operation is not available in the region.
    record OperationNotSupportedException
        -- A message describing the problem.
        Message: string
    end

    -- The operation cannot be performed because the crawler is already running.
    record CrawlerRunningException
        -- A message describing the problem.
        Message: string
    end

    -- The specified scheduler is transitioning.
    record SchedulerTransitioningException
        -- A message describing the problem.
        Message: string
    end

    -- The specified integration could not be found.
    record IntegrationNotFoundFault
        -- A message describing the problem.
        Message: string
    end

    -- The integration is in an invalid state.
    record InvalidIntegrationStateFault
        -- A message describing the problem.
        Message: string
    end

    -- A specified condition was not satisfied.
    record ConditionCheckFailureException
        -- A message describing the problem.
        Message: string
    end

    -- The target resource could not be found.
    record TargetResourceNotFound
        -- A message describing the problem.
        Message: string
    end

    -- The operation timed out.
    record PermissionTypeMismatchException
        -- There is a mismatch between the SupportedPermissionType used in the query request
        -- and the permissions defined on the target table.
        Message: string
    end

    -- Too many jobs are being run concurrently.
    record ConcurrentRunsExceededException
        -- A message describing the problem.
        Message: string
    end

    -- The workflow is in an invalid state to perform a requested operation.
    record IllegalWorkflowStateException
        -- A message describing the problem.
        Message: string
    end

    -- The blueprint is in an invalid state to perform a requested operation.
    record IllegalBlueprintStateException
        -- A message describing the problem.
        Message: string
    end

    -- There is no applicable schedule.
    record NoScheduleException
        -- A message describing the problem.
        Message: string
    end

    -- The specified scheduler is already running.
    record SchedulerRunningException
        -- A message describing the problem.
        Message: string
    end

    -- Exception thrown when a task is already in running state.
    record MaterializedViewRefreshTaskRunningException
        Message: string
    end

    -- The machine learning transform is not ready to run.
    record MLTransformNotReadyException
        -- A message describing the problem.
        Message: string
    end

    -- An exception thrown when you try to stop a task run when there is no task running.
    record ColumnStatisticsTaskNotRunningException
        -- A message describing the problem.
        Message: string
    end

    -- An exception thrown when you try to stop a task run.
    record ColumnStatisticsTaskStoppingException
        -- A message describing the problem.
        Message: string
    end

    -- The specified crawler is not running.
    record CrawlerNotRunningException
        -- A message describing the problem.
        Message: string
    end

    -- The specified crawler is stopping.
    record CrawlerStoppingException
        -- A message describing the problem.
        Message: string
    end

    -- The specified scheduler is not running.
    record SchedulerNotRunningException
        -- A message describing the problem.
        Message: string
    end

    -- Exception thrown when stopping a task that is not in running state.
    record MaterializedViewRefreshTaskNotRunningException
        Message: string
    end

    -- Exception thrown when a task is already in stopping state.
    record MaterializedViewRefreshTaskStoppingException
        Message: string
    end

    -- There was a version conflict.
    record VersionMismatchException
        -- A message describing the problem.
        Message: string
    end

    enum Compatibility
        "NONE"
        "DISABLED"
        "BACKWARD"
        "BACKWARD_ALL"
        "FORWARD"
        "FORWARD_ALL"
        "FULL"
        "FULL_ALL"
    end

