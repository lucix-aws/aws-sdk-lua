    end

    enum SchemaStatus
        "AVAILABLE"
        "PENDING"
        "DELETING"
    end

    enum SchemaVersionStatus
        "AVAILABLE"
        "PENDING"
        "FAILURE"
        "DELETING"
    end

    enum SourceControlAuthStrategy
        "PERSONAL_ACCESS_TOKEN"
        "AWS_SECRETS_MANAGER"
    end

    enum SourceControlProvider
        "GITHUB"
