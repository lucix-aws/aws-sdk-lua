    end

    -- Hls Akamai Settings
    record HlsAkamaiSettings
        -- Number of seconds to wait before retrying connection to the CDN if the connection is lost.
        ConnectionRetryInterval: number
        -- Size in seconds of file cache for streaming outputs.
        FilecacheDuration: number
        -- Specify whether or not to use chunked transfer encoding to Akamai. User should contact Akamai to enable this feature.
        HttpTransferMode: string
        -- Number of retry attempts that will be made before the Live Event is put into an error state. Applies only if the CDN destination URI begins with "s3" or "mediastore". For other URIs, the value is always 3.
        NumRetries: number
        -- If a streaming output fails, number of seconds to wait until a restart is initiated. A value of 0 means never restart.
        RestartDelay: number
        -- Salt for authenticated Akamai.
        Salt: string
        -- Token parameter for authenticated akamai. If not specified, _gda_ is used.
        Token: string
    end

    -- Hls Basic Put Settings
    record HlsBasicPutSettings
        -- Number of seconds to wait before retrying connection to the CDN if the connection is lost.
        ConnectionRetryInterval: number
        -- Size in seconds of file cache for streaming outputs.
        FilecacheDuration: number
        -- Number of retry attempts that will be made before the Live Event is put into an error state. Applies only if the CDN destination URI begins with "s3" or "mediastore". For other URIs, the value is always 3.
        NumRetries: number
        -- If a streaming output fails, number of seconds to wait until a restart is initiated. A value of 0 means never restart.
        RestartDelay: number
    end

    enum HlsMediaStoreStorageClass
        "TEMPORAL"
    end

    -- Hls Media Store Settings
    record HlsMediaStoreSettings
        -- Number of seconds to wait before retrying connection to the CDN if the connection is lost.
        ConnectionRetryInterval: number
        -- Size in seconds of file cache for streaming outputs.
        FilecacheDuration: number
        -- When set to temporal, output files are stored in non-persistent memory for faster reading and writing.
        MediaStoreStorageClass: string
        -- Number of retry attempts that will be made before the Live Event is put into an error state. Applies only if the CDN destination URI begins with "s3" or "mediastore". For other URIs, the value is always 3.
        NumRetries: number
        -- If a streaming output fails, number of seconds to wait until a restart is initiated. A value of 0 means never restart.
        RestartDelay: number
    end

    -- Hls S3 Settings
    record HlsS3Settings
        -- Specify the canned ACL to apply to each S3 request. Defaults to none.
        CannedAcl: string
    end

    enum HlsWebdavHttpTransferMode
        "CHUNKED"
        "NON_CHUNKED"
    end

    -- Hls Webdav Settings
    record HlsWebdavSettings
        -- Number of seconds to wait before retrying connection to the CDN if the connection is lost.
        ConnectionRetryInterval: number
        -- Size in seconds of file cache for streaming outputs.
        FilecacheDuration: number
        -- Specify whether or not to use chunked transfer encoding to WebDAV.
        HttpTransferMode: string
        -- Number of retry attempts that will be made before the Live Event is put into an error state. Applies only if the CDN destination URI begins with "s3" or "mediastore". For other URIs, the value is always 3.
        NumRetries: number
        -- If a streaming output fails, number of seconds to wait until a restart is initiated. A value of 0 means never restart.
        RestartDelay: number
    end

