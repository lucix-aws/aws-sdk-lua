        "LIVE"
        "VOD"
    end

    enum HlsOutputSelection
        "MANIFESTS_AND_SEGMENTS"
        "SEGMENTS_ONLY"
        "VARIANT_MANIFESTS_AND_SEGMENTS"
    end

