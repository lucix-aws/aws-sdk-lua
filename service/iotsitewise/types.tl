        message: string
    end

    -- The query timed out.
    record QueryTimeoutException
        message: string
    end

    -- The validation failed for this query.
    record ValidationException
        message: string
    end

    -- You are not authorized.
    record UnauthorizedException
        message: string
    end

    -- You've reached the quota for the number of tags allowed for a resource. For more
    -- information, see Tag naming limits and
    -- requirements in the Amazon Web Services General Reference.
    record TooManyTagsException
        message: string
