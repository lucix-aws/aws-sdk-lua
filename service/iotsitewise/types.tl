    record UpdateAssetModelInput
        -- The ID of the asset model to update. This can be either the actual ID in UUID format, or else externalId: followed by the external ID, if it has one.
        -- For more information, see Referencing objects with external IDs in the IoT SiteWise User Guide.
        assetModelId: string
