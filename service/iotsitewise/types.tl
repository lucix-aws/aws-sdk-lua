    -- Your request exceeded a rate limit. For example, you might have exceeded the number of
    -- IoT SiteWise assets that can be created per second, the allowed number of messages per second, and so
    -- on.
    -- For more information, see Quotas in the IoT SiteWise User Guide.
    record ThrottlingException
        message: string
    end

    -- The requested service is unavailable.
    record ServiceUnavailableException
        message: string
    end

    -- The precondition in one or more of the request-header fields evaluated to
    -- FALSE.
