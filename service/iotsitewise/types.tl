    end

    -- The resource already exists.
    record ResourceAlreadyExistsException
        message: string
        -- The ID of the resource that already exists.
        resourceId: string
        -- The ARN of the resource that already exists.
        resourceArn: string
    end

    -- The requested resource can't be found.
