    end

    -- A list of validation messages for a specified configuration template.
    record ValidateConfigurationSettingsInput
        -- The name of the application that the configuration template or environment belongs
        -- to.
        ApplicationName: string
        -- The name of the configuration template to validate the settings against.
        -- Condition: You cannot specify both this and an environment name.
        TemplateName: string
        -- The name of the environment to validate the settings against.
        -- Condition: You cannot specify both this and a configuration template name.
        EnvironmentName: string
        -- A list of the options and desired values to evaluate.
        OptionSettings: {ConfigurationOptionSetting}
    end

    -- Provides a list of validation messages.
    record ValidateConfigurationSettingsOutput
        -- A list of ValidationMessage.
        Messages: {ValidationMessage}
    end

    -- The specified account does not have sufficient privileges for one or more AWS
    -- services.
    record InsufficientPrivilegesException
        -- The exception error message.
        message: string
    end

    -- A generic service exception has occurred.
    record ElasticBeanstalkServiceException
        -- The exception error message.
        message: string
    end

    -- Cannot modify the managed action in its current state.
    record ManagedActionInvalidStateException
        -- The exception error message.
        message: string
    end

    -- The specified account has reached its limit of environments.
    record TooManyEnvironmentsException
        -- The exception error message.
        message: string
    end

    -- The specified account has reached its limit of applications.
    record TooManyApplicationsException
        -- The exception error message.
        message: string
    end

    -- AWS CodeBuild is not available in the specified region.
    record CodeBuildNotInServiceRegionException
        -- The exception error message.
        message: string
    end

    -- The specified S3 bucket does not belong to the S3 region in which the service is
    -- running. The following regions are supported:
    -- IAD/us-east-1
    -- PDX/us-west-2
    -- DUB/eu-west-1
    record S3LocationNotInServiceRegionException
        -- The exception error message.
        message: string
    end

    -- The specified account has reached its limit of application versions.
    record TooManyApplicationVersionsException
        -- The exception error message.
        message: string
    end

    -- The specified account has reached its limit of Amazon S3 buckets.
    record TooManyBucketsException
        -- The exception error message.
        message: string
    end

    -- The specified account has reached its limit of configuration templates.
    record TooManyConfigurationTemplatesException
        -- The exception error message.
        message: string
    end

    -- You have exceeded the maximum number of allowed platforms associated with the account.
    record TooManyPlatformsException
        -- The exception error message.
        message: string
    end

    -- The specified account does not have a subscription to Amazon S3.
    record S3SubscriptionRequiredException
        -- The exception error message.
        message: string
    end

    -- Unable to perform the specified operation because another operation that effects an
    -- element in this activity is already in progress.
    record OperationInProgressException
        -- The exception error message.
        message: string
    end

    -- Unable to delete the Amazon S3 source bundle associated with the application version.
    -- The application version was deleted successfully.
    record SourceBundleDeletionException
        -- The exception error message.
        message: string
    end

    -- You cannot delete the platform version because there are still environments running on it.
    record PlatformVersionStillReferencedException
        -- The exception error message.
        message: string
    end

    -- One or more input parameters is not valid. Please correct the input parameters and try
    -- the operation again.
    record InvalidRequestException
        -- The exception error message.
        message: string
    end

    -- A resource doesn't exist for the specified Amazon Resource Name (ARN).
    record ResourceNotFoundException
        -- The exception error message.
        message: string
    end

    -- The type of the specified Amazon Resource Name (ARN) isn't supported for this operation.
    record ResourceTypeNotSupportedException
        -- The exception error message.
        message: string
    end

    -- The number of tags in the resource would exceed the number of tags that each resource
    -- can have.
    -- To calculate this, the operation considers both the number of tags the resource already has
    -- and the tags this operation would add if it succeeded.
    record TooManyTagsException
        -- The exception error message.
        message: string
    end

    enum ActionStatus
        "Scheduled"
        "Pending"
        "Running"
        "Unknown"
    end

    enum ActionType
        "InstanceRefresh"
        "PlatformUpdate"
        "Unknown"
    end

    enum ConfigurationDeploymentStatus
        "deployed"
        "pending"
        "failed"
    end

    enum EnvironmentHealth
        "Green"
        "Yellow"
        "Red"
        "Grey"
    end

    enum EnvironmentHealthStatus
        "NoData"
        "Unknown"
        "Pending"
        "Ok"
        "Info"
        "Warning"
        "Degraded"
        "Severe"
        "Suspended"
    end

    enum EnvironmentInfoType
        "tail"
        "bundle"
        "analyze"
    end

    enum EnvironmentStatus
        "Aborting"
        "Launching"
        "Updating"
        "LinkingFrom"
        "LinkingTo"
        "Ready"
        "Terminating"
        "Terminated"
    end

    enum EventSeverity
        "TRACE"
        "DEBUG"
        "INFO"
        "WARN"
        "ERROR"
        "FATAL"
    end

end

return M
