        -- The display name of the dashboard.
        Name: string
        -- Status associated with the dashboard version.
        -- CREATION_IN_PROGRESS
        -- CREATION_SUCCESSFUL
        -- CREATION_FAILED
        -- UPDATE_IN_PROGRESS
        -- UPDATE_SUCCESSFUL
        -- UPDATE_FAILED
        -- DELETED
        ResourceStatus: string
        -- The ARN of the theme of the dashboard.
