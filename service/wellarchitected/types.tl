    end

    record UpgradeProfileVersionInput
        WorkloadId: string
        -- The profile ARN.
        ProfileArn: string
        MilestoneName: string
        ClientRequestToken: string
    end

    record UpgradeProfileVersionOutput
    end

    record UpgradeReviewTemplateLensReviewInput
        -- The ARN of the review template.
        TemplateArn: string
        LensAlias: string
        ClientRequestToken: string
    end

    record UpgradeReviewTemplateLensReviewOutput
    end

end

return M
