        StackSetName: string
        -- [Self-managed permissions] The account IDs of one or more Amazon Web Services accounts in which you want
        -- to update parameter values for stack instances. The overridden parameter values will be
        -- applied to all stack instances in the specified accounts and Amazon Web Services Regions.
        -- You can specify Accounts or DeploymentTargets, but not
        -- both.
