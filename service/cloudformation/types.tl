    end

    -- The output for ValidateTemplate action.
    record ValidateTemplateOutput
        -- A list of TemplateParameter structures.
        Parameters: {TemplateParameter}
        -- The description found within the template.
        Description: string
        -- The capabilities found within the template. If your template contains IAM resources, you
        -- must specify the CAPABILITY_IAM or CAPABILITY_NAMED_IAM value for this parameter when you use
        -- the CreateStack or UpdateStack actions with your template;
        -- otherwise, those actions return an InsufficientCapabilities error.
        -- For more information, see Acknowledging IAM resources in CloudFormation templates.
        Capabilities: {string}
        -- The list of resources that generated the values in the Capabilities response
        -- element.
        CapabilitiesReason: string
        -- A list of the transforms that are declared in the template.
        DeclaredTransforms: {string}
    end

    -- The specified operation isn't valid.
    record InvalidOperationException
        Message: string
    end

    -- The specified ID refers to an operation that doesn't exist.
    record OperationNotFoundException
        Message: string
    end

    -- An error occurred during a CloudFormation registry operation.
    record CFNRegistryException
        -- A message with details about the error that occurred.
        Message: string
    end

    -- The specified extension doesn't exist in the CloudFormation registry.
    record TypeNotFoundException
        -- A message with details about the error that occurred.
        Message: string
    end

    -- The specified extension configuration can't be found.
    record TypeConfigurationNotFoundException
        -- A message with details about the error that occurred.
        Message: string
    end

    -- A client request token already exists.
    record TokenAlreadyExistsException
        Message: string
    end

    -- The resource with the name requested already exists.
    record AlreadyExistsException
        Message: string
    end

    -- The template contains resources with capabilities that weren't specified in the Capabilities parameter.
    record InsufficientCapabilitiesException
        Message: string
    end

    -- The quota for the resource has already been reached.
    -- For information about resource and stack limitations, see CloudFormation quotas in the
    -- CloudFormation User Guide.
    record LimitExceededException
        Message: string
    end

    -- No more than 5 generated templates can be in an InProgress or Pending status at one
    -- time. This error is also returned if a generated template that is in an InProgress or
    -- Pending status is attempted to be updated or deleted.
    record ConcurrentResourcesLimitExceededException
        Message: string
    end

    -- The specified operation ID already exists.
    record OperationIdAlreadyExistsException
        Message: string
    end

    -- Another operation is currently in progress for this StackSet. Only one operation can be performed for a stack
    -- set at a given time.
    record OperationInProgressException
        Message: string
    end

    -- The specified StackSet doesn't exist.
    record StackSetNotFoundException
        Message: string
    end

    -- Another operation has been performed on this StackSet since the specified operation was performed.
    record StaleRequestException
        Message: string
    end

    -- The specified resource exists, but has been changed.
    record CreatedButModifiedException
        Message: string
    end

    -- The specified name is already in use.
    record NameAlreadyExistsException
        Message: string
    end

    -- The specified change set can't be used to update the stack. For example, the change set status might be
    -- CREATE_IN_PROGRESS, or the stack status might be UPDATE_IN_PROGRESS.
    record InvalidChangeSetStatusException
        Message: string
    end

    -- The generated template was not found.
    record GeneratedTemplateNotFoundException
        Message: string
    end

    -- You can't yet delete this StackSet, because it still contains one or more stack instances. Delete all stack
    -- instances from the StackSet before deleting the StackSet.
    record StackSetNotEmptyException
        Message: string
    end

    -- The specified change set name or ID doesn't exit. To view valid change sets for a stack, use the
    -- ListChangeSets operation.
    record ChangeSetNotFoundException
        Message: string
    end

    -- The resource scan was not found.
    record ResourceScanNotFoundException
        Message: string
    end

    -- The specified stack instance doesn't exist.
    record StackInstanceNotFoundException
        Message: string
    end

    -- The specified stack refactor can't be found.
    record StackRefactorNotFoundException
        Message: string
    end

    -- The specified target doesn't have any requested Hook invocations.
    record HookResultNotFoundException
        Message: string
    end

    -- The specified stack ARN doesn't exist or stack doesn't exist corresponding to the ARN in input.
    record StackNotFoundException
        Message: string
    end

    -- A resource scan is currently in progress. Only one can be run at a time for an account in a Region.
    record ResourceScanInProgressException
        Message: string
    end

    -- Error reserved for use by the CloudFormation CLI. CloudFormation doesn't
    -- return this error to users.
    record InvalidStateTransitionException
        Message: string
    end

    -- Error reserved for use by the CloudFormation CLI. CloudFormation doesn't
    -- return this error to users.
    record OperationStatusCheckFailedException
        Message: string
    end

    -- The limit on resource scans has been exceeded. Reasons include:
    -- Exceeded the daily quota for resource scans.
    -- A resource scan recently failed. You must wait 10 minutes before starting a new resource scan.
    -- The last resource scan failed after exceeding 100,000 resources. When this happens, you must wait 24 hours
    -- before starting a new resource scan.
    record ResourceScanLimitExceededException
        Message: string
    end

