        -- AWS::IAM::InstanceProfile
        -- AWS::IAM::Policy
        -- AWS::IAM::Role
        -- AWS::IAM::User
        -- AWS::IAM::UserToGroupAddition
        -- For more information, see Acknowledging IAM resources in CloudFormation templates.
        -- CAPABILITY_AUTO_EXPAND
