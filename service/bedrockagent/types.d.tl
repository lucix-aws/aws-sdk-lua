    -- The configuration that specifies how nodes in the flow are executed in parallel.
    concurrencyConfiguration: FlowAliasConcurrencyConfiguration
    -- The unique identifier of the flow.
    flowId: string
    -- The unique identifier of the alias.
    id: string
    -- The Amazon Resource Name (ARN) of the flow.
    arn: string
    -- The time at which the flow was created.
    createdAt: number
    -- The time at which the alias was last updated.
    updatedAt: number
end

local record UpdateKnowledgeBaseInput
    -- The unique identifier of the knowledge base to update.
    knowledgeBaseId: string
    -- Specifies a new name for the knowledge base.
    name: string
    -- Specifies a new description for the knowledge base.
    description: string
    -- Specifies a different Amazon Resource Name (ARN) of the IAM role with permissions to invoke API operations on the knowledge base.
    roleArn: string
    -- Specifies the configuration for the embeddings model used for the knowledge base. You must use the same configuration as when the knowledge base was created.
    knowledgeBaseConfiguration: KnowledgeBaseConfiguration
    -- Specifies the configuration for the vector store used for the knowledge base. You must use the same configuration as when the knowledge base was created.
    storageConfiguration: StorageConfiguration
end

local record UpdateKnowledgeBaseOutput
    -- Contains details about the knowledge base.
    knowledgeBase: KnowledgeBase
end

local record UpdatePromptInput
    -- A name for the prompt.
    name: string
    -- A description for the prompt.
    description: string
    -- The Amazon Resource Name (ARN) of the KMS key to encrypt the prompt.
    customerEncryptionKeyArn: string
    -- The name of the default variant for the prompt. This value must match the name field in the relevant PromptVariant object.
    defaultVariant: string
    -- A list of objects, each containing details about a variant of the prompt.
    variants: {PromptVariant}
    -- The unique identifier of the prompt.
    promptIdentifier: string
end

local record UpdatePromptOutput
    -- The name of the prompt.
    name: string
    -- The description of the prompt.
    description: string
    -- The Amazon Resource Name (ARN) of the KMS key to encrypt the prompt.
    customerEncryptionKeyArn: string
    -- The name of the default variant for the prompt. This value must match the name field in the relevant PromptVariant object.
    defaultVariant: string
    -- A list of objects, each containing details about a variant of the prompt.
    variants: {PromptVariant}
    -- The unique identifier of the prompt.
    id: string
    -- The Amazon Resource Name (ARN) of the prompt.
    arn: string
    -- The version of the prompt. When you update a prompt, the version updated is the DRAFT version.
    version: string
    -- The time at which the prompt was created.
    createdAt: number
    -- The time at which the prompt was last updated.
    updatedAt: number
end

