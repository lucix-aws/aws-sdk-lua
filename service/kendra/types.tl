        -- document storage capacity of zero indicates that the index is using the default capacity. For
        -- more information on the default capacity for an index and adjusting this, see Adjusting
        -- capacity.
        CapacityUnits: CapacityUnitsConfiguration
        -- The user token configuration for the Amazon Kendra index.
        UserTokenConfigurations: {UserTokenConfiguration}
        -- The user context policy for the Amazon Kendra index.
        UserContextPolicy: string
        -- Whether you have enabled IAM Identity Center identity source for your users and
