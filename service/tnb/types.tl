    record ValidateSolNetworkPackageContentInput
        -- Network service descriptor file.
        nsdInfoId: string
        -- Network package content type.
        contentType: string
        -- Network package file.
        file: string
    end

    -- Validates network package content metadata.
    -- A network package is a .zip file in CSAR (Cloud Service Archive) format defines the function packages you want to deploy and the Amazon Web Services infrastructure you want to deploy them on.
    record ValidateSolNetworkPackageContentMetadata
        nsd: NetworkArtifactMeta
    end

    record ValidateSolNetworkPackageContentOutput
        -- Network package ID.
        id: string
        -- Network package ARN.
        arn: string
        -- Network service descriptor ID.
        nsdId: string
        -- Network service descriptor name.
        nsdName: string
        -- Network service descriptor version.
        nsdVersion: string
        -- Function package IDs.
        vnfPkgIds: {string}
        -- Network package metadata.
        metadata: ValidateSolNetworkPackageContentMetadata
    end

end

return M
