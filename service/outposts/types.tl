    -- A pricing option for the specified Outpost.
    record PricingOption
        -- The type of pricing model.
        PricingType: string
        -- The subscription pricing details for this pricing option.
        SubscriptionPricingDetails: SubscriptionPricingDetails
    end

    enum PricingResult
        "PRICED"
        "UNABLE_TO_PRICE"
    end

    record GetRenewalPricingOutput
        -- The result of the pricing request.
        PricingResult: string
        -- The pricing options for the specified Outpost.
        PricingOptions: {PricingOption}
    end

    record GetSiteInput
        -- The ID or the Amazon Resource Name (ARN) of the site.
        SiteId: string
    end

    record GetSiteOutput
        Site: Site
    end

    record GetSiteAddressInput
        -- The ID or the Amazon Resource Name (ARN) of the site.
        SiteId: string
        -- The type of the address you request.
        AddressType: string
    end

    record GetSiteAddressOutput
        SiteId: string
        -- The type of the address you receive.
        AddressType: string
        -- Information about the address.
        Address: Address
    end

    record ListAssetInstancesInput
        -- The ID of the Outpost.
        OutpostIdentifier: string
        -- Filters the results by asset ID.
        AssetIdFilter: {string}
        -- Filters the results by instance ID.
        InstanceTypeFilter: {string}
        -- Filters the results by account ID.
        AccountIdFilter: {string}
        -- Filters the results by Amazon Web Services service.
        AwsServiceFilter: {string}
        MaxResults: number
        NextToken: string
    end

    record ListAssetInstancesOutput
        -- List of instances owned by all accounts on the Outpost. Does not include Amazon EBS or Amazon S3
        -- instances.
        AssetInstances: {AssetInstance}
        NextToken: string
    end

    record ListAssetsInput
        -- The ID or the Amazon Resource Name (ARN) of the Outpost.
        OutpostIdentifier: string
        -- Filters the results by the host ID of a Dedicated Host.
        HostIdFilter: {string}
        MaxResults: number
        NextToken: string
        -- Filters the results by state.
        StatusFilter: {string}
        -- Filters the results by asset type.
        -- COMPUTE - Server asset used for customer compute
        -- STORAGE - Server asset used by storage services
        -- POWERSHELF - Powershelf assets
        -- SWITCH - Switch assets
        -- NETWORKING - Asset managed by Amazon Web Services for networking purposes
        AssetTypeFilter: {string}
    end

    record ListAssetsOutput
        -- Information about the hardware assets.
        Assets: {AssetInfo}
        NextToken: string
    end

    record ListBlockingInstancesForCapacityTaskInput
        -- The ID or ARN of the Outpost associated with the specified capacity task.
        OutpostIdentifier: string
        -- The ID of the capacity task.
        CapacityTaskId: string
        MaxResults: number
        NextToken: string
    end

    record ListBlockingInstancesForCapacityTaskOutput
        -- A list of all running Amazon EC2 instances on the Outpost. Stopping one or more of these
        -- instances can free up the capacity needed to run the capacity task.
        BlockingInstances: {BlockingInstance}
        NextToken: string
    end

    record ListCapacityTasksInput
        -- Filters the results by an Outpost ID or an Outpost ARN.
        OutpostIdentifierFilter: string
        MaxResults: number
        NextToken: string
        -- A list of statuses. For example, REQUESTED or
        -- WAITING_FOR_EVACUATION.
        CapacityTaskStatusFilter: {string}
    end

    record ListCapacityTasksOutput
        -- Lists all the capacity tasks.
        CapacityTasks: {CapacityTaskSummary}
        NextToken: string
    end

    record ListCatalogItemsInput
        NextToken: string
        MaxResults: number
        -- Filters the results by item class.
        ItemClassFilter: {string}
        -- Filters the results by storage option.
        SupportedStorageFilter: {string}
        -- Filters the results by EC2 family (for example, M5).
        EC2FamilyFilter: {string}
    end

    record ListCatalogItemsOutput
        -- Information about the catalog items.
        CatalogItems: {CatalogItem}
        NextToken: string
    end

    record ListOrdersInput
        -- The ID or the Amazon Resource Name (ARN) of the Outpost.
        OutpostIdentifierFilter: string
        NextToken: string
        MaxResults: number
    end

    -- A summary of line items in your order.
    record OrderSummary
        -- The ID of the Outpost.
        OutpostId: string
        -- The ID of the order.
        OrderId: string
        -- The type of order.
        OrderType: string
        -- The status of the order.
        -- PREPARING - Order is received and is being prepared.
        -- IN_PROGRESS - Order is either being built, shipped, or installed. For
        -- more information, see the LineItem status.
        -- COMPLETED - Order is complete.
        -- CANCELLED - Order is cancelled.
        -- ERROR - Customer should contact support.
        -- The following statuses are deprecated: RECEIVED, PENDING,
        -- PROCESSING, INSTALLING, and FULFILLED.
        Status: string
        -- The status of all line items in the order.
        LineItemCountsByStatus: {string : number}
        -- The submission date for the order.
        OrderSubmissionDate: number
        -- The fulfilment date for the order.
        OrderFulfilledDate: number
    end

    record ListOrdersOutput
        -- Information about the orders.
        Orders: {OrderSummary}
        NextToken: string
    end

    record ListOutpostsInput
        NextToken: string
        MaxResults: number
        -- Filters the results by the lifecycle status.
        LifeCycleStatusFilter: {string}
        -- Filters the results by Availability Zone (for example, us-east-1a).
        AvailabilityZoneFilter: {string}
        -- Filters the results by AZ ID (for example, use1-az1).
        AvailabilityZoneIdFilter: {string}
    end

    record ListOutpostsOutput
        Outposts: {Outpost}
        NextToken: string
    end

    record ListSitesInput
        NextToken: string
        MaxResults: number
        -- Filters the results by country code.
        OperatingAddressCountryCodeFilter: {string}
        -- Filters the results by state or region.
        OperatingAddressStateOrRegionFilter: {string}
        -- Filters the results by city.
        OperatingAddressCityFilter: {string}
    end

    record ListSitesOutput
        Sites: {Site}
        NextToken: string
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        ResourceArn: string
    end

    record ListTagsForResourceOutput
        -- The resource tags.
        Tags: {string : string}
    end

    record StartCapacityTaskInput
        -- The ID or ARN of the Outposts associated with the specified capacity task.
        OutpostIdentifier: string
        -- The ID of the Amazon Web Services Outposts order associated with the specified capacity task.
        OrderId: string
        -- The ID of the Outpost asset. An Outpost asset can be a single server within an Outposts
        -- rack or an Outposts server configuration.
        AssetId: string
        -- The instance pools specified in the capacity task.
        InstancePools: {InstanceTypeCapacity}
        -- List of user-specified running instances that must not be stopped in order to free up the
        -- capacity needed to run the capacity task.
        InstancesToExclude: InstancesToExclude
        -- You can request a dry run to determine if the instance type and instance size changes is
        -- above or below available instance capacity. Requesting a dry run does not make any changes to
        -- your plan.
        DryRun: boolean
        -- Specify one of the following options in case an instance is blocking the capacity task
        -- from running.
        -- WAIT_FOR_EVACUATION - Checks every 10 minutes over 48 hours to determine
        -- if instances have stopped and capacity is available to complete the task.
        -- FAIL_TASK - The capacity task fails.
        TaskActionOnBlockingInstances: string
    end

    record StartCapacityTaskOutput
        -- ID of the capacity task that you want to start.
        CapacityTaskId: string
        -- ID of the Outpost associated with the capacity task.
        OutpostId: string
        -- ID of the Amazon Web Services Outposts order of the host associated with the capacity task.
        OrderId: string
        -- The ID of the asset. An Outpost asset can be a single server within an Outposts rack or an
        -- Outposts server configuration.
        AssetId: string
        -- List of the instance pools requested in the specified capacity task.
        RequestedInstancePools: {InstanceTypeCapacity}
        -- User-specified instances that must not be stopped in order to free up the capacity needed
        -- to run the capacity task.
        InstancesToExclude: InstancesToExclude
        -- Results of the dry run showing if the specified capacity task is above or below the
        -- available instance capacity.
        DryRun: boolean
        -- Status of the specified capacity task.
        CapacityTaskStatus: string
        -- Reason that the specified capacity task failed.
        Failed: CapacityTaskFailure
        -- Date that the specified capacity task was created.
        CreationDate: number
        -- Date that the specified capacity task ran successfully.
        CompletionDate: number
        -- Date that the specified capacity task was last modified.
        LastModifiedDate: number
        -- User-specified option in case an instance is blocking the capacity task from
        -- running.
        -- WAIT_FOR_EVACUATION - Checks every 10 minutes over 48 hours to determine
        -- if instances have stopped and capacity is available to complete the task.
        -- FAIL_TASK - The capacity task fails.
        TaskActionOnBlockingInstances: string
    end

    record StartConnectionInput
        -- The serial number of the dongle.
        DeviceSerialNumber: string
        -- The ID of the Outpost server.
        AssetId: string
        -- The public key of the client.
        ClientPublicKey: string
        -- The device index of the network interface on the Outpost server.
        NetworkInterfaceDeviceIndex: number
    end

    record StartConnectionOutput
        -- The ID of the connection.
        ConnectionId: string
        -- The underlay IP address.
        UnderlayIpAddress: string
    end

    record StartOutpostDecommissionInput
        -- The ID or ARN of the Outpost that you want to decommission.
        OutpostIdentifier: string
        -- Validates the request without starting the decommission process.
        ValidateOnly: boolean
    end

    record StartOutpostDecommissionOutput
        -- The status of the decommission request.
        Status: string
        -- The resources still associated with the Outpost that you are decommissioning.
        BlockingResourceTypes: {string}
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        ResourceArn: string
        -- The tags to add to the resource.
        Tags: {string : string}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        ResourceArn: string
        -- The tag keys.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateOutpostInput
        -- The ID or ARN of the Outpost.
        OutpostId: string
        Name: string
        Description: string
        -- The type of hardware for this Outpost.
        SupportedHardwareType: string
    end

    record UpdateOutpostOutput
        Outpost: Outpost
    end

    record UpdateSiteInput
        -- The ID or the Amazon Resource Name (ARN) of the site.
        SiteId: string
        Name: string
        Description: string
        -- Notes about a site.
        Notes: string
    end

    record UpdateSiteOutput
        Site: Site
    end

    record UpdateSiteAddressInput
        -- The ID or the Amazon Resource Name (ARN) of the site.
        SiteId: string
        -- The type of the address.
        AddressType: string
        -- The address for the site.
        Address: Address
    end

    record UpdateSiteAddressOutput
        -- The type of the address.
        AddressType: string
        -- Information about an address.
        Address: Address
    end

    record UpdateSiteRackPhysicalPropertiesInput
        -- The ID or the Amazon Resource Name (ARN) of the site.
        SiteId: string
        -- The power draw, in kVA, available at the hardware placement position for the rack.
        PowerDrawKva: string
        -- The power option that you can provide for hardware.
        -- Single-phase AC feed: 200 V to 277 V, 50 Hz or 60 Hz
        -- Three-phase AC feed: 346 V to 480 V, 50 Hz or 60 Hz
        PowerPhase: string
        -- The power connector that Amazon Web Services should plan to provide for connections to the hardware.
        -- Note the correlation between PowerPhase and PowerConnector.
        -- Single-phase AC feed
        -- L6-30P – (common in US); 30A; single phase
        -- IEC309 (blue) – P+N+E, 6hr; 32 A; single
        -- phase
        -- Three-phase AC feed
        -- AH530P7W (red) – 3P+N+E, 7hr; 30A; three
        -- phase
        -- AH532P6W (red) – 3P+N+E, 6hr; 32A; three
        -- phase
        -- CS8365C – (common in US); 3P+E, 50A; three
        -- phase
        PowerConnector: string
        -- Indicates whether the power feed comes above or below the rack.
        PowerFeedDrop: string
        -- The uplink speed the rack should support for the connection to the Region.
        UplinkGbps: string
        -- Racks come with two Outpost network devices. Depending on the supported uplink speed at
        -- the site, the Outpost network devices provide a variable number of uplinks. Specify the number
        -- of uplinks for each Outpost network device that you intend to use to connect the rack to your
        -- network. Note the correlation between UplinkGbps and UplinkCount.
        -- 1Gbps - Uplinks available: 1, 2, 4, 6, 8
        -- 10Gbps - Uplinks available: 1, 2, 4, 8, 12, 16
        -- 40 and 100 Gbps- Uplinks available: 1, 2, 4
        UplinkCount: string
        -- The type of fiber that you will use to attach the Outpost to your network.
        FiberOpticCableType: string
        -- The type of optical standard that you will use to attach the Outpost to your network. This
        -- field is dependent on uplink speed, fiber type, and distance to the upstream device.
        -- For more information
        -- about networking requirements for racks, see Network
        -- in the Amazon Web Services Outposts User Guide.
        -- OPTIC_10GBASE_SR: 10GBASE-SR
        -- OPTIC_10GBASE_IR: 10GBASE-IR
        -- OPTIC_10GBASE_LR: 10GBASE-LR
        -- OPTIC_40GBASE_SR: 40GBASE-SR
        -- OPTIC_40GBASE_ESR: 40GBASE-ESR
        -- OPTIC_40GBASE_IR4_LR4L: 40GBASE-IR (LR4L)
        -- OPTIC_40GBASE_LR4: 40GBASE-LR4
        -- OPTIC_100GBASE_SR4: 100GBASE-SR4
        -- OPTIC_100GBASE_CWDM4: 100GBASE-CWDM4
        -- OPTIC_100GBASE_LR4: 100GBASE-LR4
        -- OPTIC_100G_PSM4_MSA: 100G PSM4 MSA
        -- OPTIC_1000BASE_LX: 1000Base-LX
        -- OPTIC_1000BASE_SX : 1000Base-SX
        OpticalStandard: string
        -- The maximum rack weight that this site can support. NO_LIMIT is over 2000lbs.
        MaximumSupportedWeightLbs: string
    end

    record UpdateSiteRackPhysicalPropertiesOutput
        Site: Site
    end

end

return M
