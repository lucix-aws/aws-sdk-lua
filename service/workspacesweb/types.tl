    -- Access is denied.
    record AccessDeniedException
        message: string
    end

    -- There is a conflict.
    record ConflictException
        message: string
        -- Identifier of the resource affected.
        resourceId: string
        -- Type of the resource affected.
        resourceType: string
    end

    -- There is an internal server error.
    record InternalServerException
        message: string
        -- Advice to clients on when the call can be safely retried.
        retryAfterSeconds: number
    end

    -- The resource cannot be found.
    record ResourceNotFoundException
        message: string
        -- Hypothetical identifier of the resource affected.
        resourceId: string
        -- Hypothetical type of the resource affected.
        resourceType: string
    end

    -- There is a throttling error.
    record ThrottlingException
        message: string
        -- The originating service.
        serviceCode: string
        -- The originating quota.
        quotaCode: string
        -- Advice to clients on when the call can be safely retried.
        retryAfterSeconds: number
    end

    -- There is a validation error.
    record ValidationException
        message: string
        -- Reason the request failed validation
        reason: string
        -- The field that caused the error.
        fieldList: {ValidationExceptionField}
    end

    -- The service quota has been exceeded.
    record ServiceQuotaExceededException
        message: string
        -- Identifier of the resource affected.
        resourceId: string
        -- Type of the resource affected.
        resourceType: string
        -- The originating service.
        serviceCode: string
        -- The originating quota.
        quotaCode: string
    end

    -- There are too many tags.
    record TooManyTagsException
        message: string
        -- Name of the resource affected.
        resourceName: string
    end

    enum SessionSortBy
        "StartTimeAscending"
        "StartTimeDescending"
    end

    enum SessionStatus
        "Active"
        "Terminated"
    end

end

return M
