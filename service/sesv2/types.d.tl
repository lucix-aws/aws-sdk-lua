local record GetDeliverabilityTestReportOutput
    -- An object that contains the results of the predictive inbox placement test.
    DeliverabilityTestReport: DeliverabilityTestReport
    -- An object that specifies how many test messages that were sent during the predictive inbox placement test were
    -- delivered to recipients' inboxes, how many were sent to recipients' spam folders, and
    -- how many weren't delivered.
    OverallPlacement: PlacementStatistics
    -- An object that describes how the test email was handled by several email providers,
    -- including Gmail, Hotmail, Yahoo, AOL, and others.
    IspPlacements: {IspPlacement}
    -- An object that contains the message that you sent when you performed this
    -- predictive inbox placement test.
    Message: string
    -- An array of objects that define the tags (keys and values) that are associated with
    -- the predictive inbox placement test.
    Tags: {Tag}
end

-- Retrieve all the deliverability data for a specific campaign. This data is available
-- for a campaign only if the campaign sent email by using a domain that the
-- Deliverability dashboard is enabled for (PutDeliverabilityDashboardOption
-- operation).
local record GetDomainDeliverabilityCampaignInput
    -- The unique identifier for the campaign. The Deliverability dashboard automatically generates
    -- and assigns this identifier to a campaign.
    CampaignId: string
end

-- An object that contains all the deliverability data for a specific campaign. This data
-- is available for a campaign only if the campaign sent email by using a domain that the
-- Deliverability dashboard is enabled for.
local record GetDomainDeliverabilityCampaignOutput
    -- An object that contains the deliverability data for the campaign.
    DomainDeliverabilityCampaign: DomainDeliverabilityCampaign
end

-- A request to obtain deliverability metrics for a domain.
local record GetDomainStatisticsReportInput
    -- The domain that you want to obtain deliverability metrics for.
    Domain: string
    -- The first day (in Unix time) that you want to obtain domain deliverability metrics
    -- for.
    StartDate: number
    -- The last day (in Unix time) that you want to obtain domain deliverability metrics for.
    -- The EndDate that you specify has to be less than or equal to 30 days after
    -- the StartDate.
    EndDate: number
end

-- An object that includes statistics that are related to the domain that you
-- specified.
local record GetDomainStatisticsReportOutput
    -- An object that contains deliverability metrics for the domain that you specified. The
    -- data in this object is a summary of all of the data that was collected from the
    -- StartDate to the EndDate.
    OverallVolume: OverallVolume
    -- An object that contains deliverability metrics for the domain that you specified. This
    -- object contains data for each day, starting on the StartDate and ending on
    -- the EndDate.
    DailyVolumes: {DailyVolume}
end

-- A request to return validation insights about an email address.
local record GetEmailAddressInsightsInput
    -- The email address to analyze for validation insights.
    EmailAddress: string
end

-- Validation insights about an email address.
local record GetEmailAddressInsightsOutput
    -- Detailed validation results for the email address.
    MailboxValidation: MailboxValidation
end

-- A request to return details about an email identity.
local record GetEmailIdentityInput
    -- The email identity.
    EmailIdentity: string
end

-- Details about an email identity.
local record GetEmailIdentityOutput
    -- The email identity type. Note: the MANAGED_DOMAIN identity type is not
    -- supported.
    IdentityType: string
    -- The feedback forwarding configuration for the identity.
    -- If the value is true, you receive email notifications when bounce or
    -- complaint events occur. These notifications are sent to the address that you specified
    -- in the Return-Path header of the original email.
    -- You're required to have a method of tracking bounces and complaints. If you haven't
    -- set up another mechanism for receiving bounce or complaint notifications (for example,
    -- by setting up an event destination), you receive an email notification when these events
    -- occur (even if this setting is disabled).
    FeedbackForwardingStatus: boolean
    -- Specifies whether or not the identity is verified. You can only send email from
    -- verified email addresses or domains. For more information about verifying identities,
    -- see the Amazon Pinpoint User Guide.
    VerifiedForSendingStatus: boolean
    -- An object that contains information about the DKIM attributes for the identity.
    DkimAttributes: DkimAttributes
    -- An object that contains information about the Mail-From attributes for the email
    -- identity.
    MailFromAttributes: MailFromAttributes
    -- A map of policy names to policies.
    Policies: {string : string}
    -- An array of objects that define the tags (keys and values) that are associated with
    -- the email identity.
    Tags: {Tag}
    -- The configuration set used by default when sending from this identity.
    ConfigurationSetName: string
    -- The verification status of the identity. The status can be one of the following:
    -- PENDING – The verification process was initiated, but Amazon SES
    -- hasn't yet been able to verify the identity.
    -- SUCCESS – The verification process completed
    -- successfully.
    -- FAILED – The verification process failed.
    -- TEMPORARY_FAILURE – A temporary issue is preventing Amazon SES
    -- from determining the verification status of the identity.
    -- NOT_STARTED – The verification process hasn't been
    -- initiated for the identity.
    VerificationStatus: string
    -- An object that contains additional information about the verification status for the
    -- identity.
    VerificationInfo: VerificationInfo
end

-- A request to return the policies of an email identity.
local record GetEmailIdentityPoliciesInput
    -- The email identity.
    EmailIdentity: string
end

-- Identity policies associated with email identity.
local record GetEmailIdentityPoliciesOutput
    -- A map of policy names to policies.
    Policies: {string : string}
end

-- Represents a request to display the template object (which includes the subject line,
-- HTML part and text part) for the template you specify.
local record GetEmailTemplateInput
    -- The name of the template.
    TemplateName: string
end

-- The following element is returned by the service.
local record GetEmailTemplateOutput
    -- The name of the template.
    TemplateName: string
    -- The content of the email template, composed of a subject line, an HTML part, and a
    -- text-only part.
    TemplateContent: EmailTemplateContent
    -- An array of objects that define the tags (keys and values) that are associated with
    -- the email template.
    Tags: {Tag}
end

-- Represents a request to retrieve information about an export job using the export job
-- ID.
local record GetExportJobInput
    -- The export job ID.
    JobId: string
end

-- An HTTP 200 response if the request succeeds, or an error message if the request
-- fails.
local record GetExportJobOutput
    -- The export job ID.
    JobId: string
    -- The type of source of the export job.
    ExportSourceType: string
    -- The status of the export job.
    JobStatus: string
    -- The destination of the export job.
    ExportDestination: ExportDestination
    -- The data source of the export job.
    ExportDataSource: ExportDataSource
    -- The timestamp of when the export job was created.
    CreatedTimestamp: number
    -- The timestamp of when the export job was completed.
    CompletedTimestamp: number
    -- The failure details about an export job.
    FailureInfo: FailureInfo
    -- The statistics about the export job.
    Statistics: ExportStatistics
end

-- Represents a request for information about an import job using the import job
-- ID.
local record GetImportJobInput
    -- The ID of the import job.
    JobId: string
end

-- An HTTP 200 response if the request succeeds, or an error message if the request
-- fails.
local record GetImportJobOutput
    -- A string that represents the import job ID.
    JobId: string
    -- The destination of the import job.
    ImportDestination: ImportDestination
    -- The data source of the import job.
    ImportDataSource: ImportDataSource
    -- The failure details about an import job.
    FailureInfo: FailureInfo
    -- The status of the import job.
    JobStatus: string
    -- The time stamp of when the import job was created.
    CreatedTimestamp: number
    -- The time stamp of when the import job was completed.
    CompletedTimestamp: number
    -- The current number of records processed.
    ProcessedRecordsCount: number
    -- The number of records that failed processing because of invalid input or other
    -- reasons.
    FailedRecordsCount: number
end

-- A request to return information about a message.
local record GetMessageInsightsInput
    -- A MessageId is a unique identifier for a message, and is
    -- returned when sending emails through Amazon SES.
    MessageId: string
end

-- Information about a message.
local record GetMessageInsightsOutput
    -- A unique identifier for the message.
    MessageId: string
    -- The from address used to send the message.
    FromEmailAddress: string
    -- The subject line of the message.
    Subject: string
    -- A list of tags, in the form of name/value pairs, that were applied to the email you sent, along with Amazon SES
    -- Auto-Tags.
    EmailTags: {MessageTag}
    -- A set of insights associated with the message.
    Insights: {EmailInsights}
end

-- Represents a request to display the multi-region endpoint (global-endpoint).
local record GetMultiRegionEndpointInput
    -- The name of the multi-region endpoint (global-endpoint).
    EndpointName: string
end

-- An HTTP 200 response if the request succeeds, or an error message if the request
-- fails.
local record GetMultiRegionEndpointOutput
    -- The name of the multi-region endpoint (global-endpoint).
    EndpointName: string
    -- The ID of the multi-region endpoint (global-endpoint).
    EndpointId: string
    -- Contains routes information for the multi-region endpoint (global-endpoint).
    Routes: {Route}
    -- The status of the multi-region endpoint (global-endpoint).
    -- CREATING – The resource is being provisioned.
    -- READY – The resource is ready to use.
    -- FAILED – The resource failed to be provisioned.
    -- DELETING – The resource is being deleted as requested.
    Status: string
    -- The time stamp of when the multi-region endpoint (global-endpoint) was created.
    CreatedTimestamp: number
    -- The time stamp of when the multi-region endpoint (global-endpoint) was last updated.
    LastUpdatedTimestamp: number
end

-- Represents a request to retrieve information about a specific reputation entity.
local record GetReputationEntityInput
    -- The unique identifier for the reputation entity. For resource-type entities,
    -- this is the Amazon Resource Name (ARN) of the resource.
    ReputationEntityReference: string
    -- The type of reputation entity. Currently, only RESOURCE type entities are supported.
    ReputationEntityType: string
end

-- Information about the requested reputation entity.
local record GetReputationEntityOutput
    -- The reputation entity information, including status records, policy configuration,
    -- and reputation impact.
    ReputationEntity: ReputationEntity
end

