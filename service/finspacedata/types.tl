        "ENABLED"
        "DISABLED"
    end

    enum ChangeType
        "REPLACE"
        "APPEND"
        "MODIFY"
    end

    enum DataViewStatus
        "RUNNING"
        "STARTING"
        "FAILED"
        "CANCELLED"
        "TIMEOUT"
        "SUCCESS"
        "PENDING"
        "FAILED_CLEANUP_FAILED"
    end

    enum DatasetKind
        "TABULAR"
        "NON_TABULAR"
    end

    enum DatasetStatus
        "PENDING"
        "FAILED"
        "SUCCESS"
        "RUNNING"
    end

    enum IngestionStatus
        "PENDING"
        "FAILED"
        "SUCCESS"
        "RUNNING"
        "STOP_REQUESTED"
    end

    enum UserStatus
        "CREATING"
        "ENABLED"
        "DISABLED"
    end

    enum UserType
        "SUPER_USER"
        "APP_USER"
    end

    enum locationType
        "INGESTION"
        "SAGEMAKER"
    end

end

return M
