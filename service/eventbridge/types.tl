    -- There is concurrent modification on a rule, target, archive, or replay.
    record ConcurrentModificationException
        message: string
    end

    -- This exception occurs due to unexpected causes.
    record InternalException
        message: string
    end

    -- The specified state is not a valid state for an event source.
    record InvalidStateException
        message: string
    end

    -- The operation you are attempting is not available in this region.
    record OperationDisabledException
        message: string
    end

    -- An entity that you specified does not exist.
    record ResourceNotFoundException
        message: string
    end

    -- An error occurred because a replay can be canceled only when the state is Running or
    -- Starting.
    record IllegalStatusException
        message: string
    end

    -- The request failed because it attempted to create resource beyond the allowed service
    -- quota.
    record LimitExceededException
        message: string
    end

    -- The resource you are trying to create already exists.
    record ResourceAlreadyExistsException
        message: string
    end

    -- The event pattern is not valid.
    record InvalidEventPatternException
        message: string
    end

    -- You do not have the necessary permissions for this action.
    record AccessDeniedException
        message: string
    end

    -- This request cannot be completed due to throttling issues.
    record ThrottlingException
        message: string
    end

    -- This rule was created by an Amazon Web Services service on behalf of your account. It is
    -- managed by that service. If you see this error in response to DeleteRule or
    -- RemoveTargets, you can use the Force parameter in those calls to
    -- delete the rule or remove targets from the rule. You cannot modify these managed rules by
    -- using DisableRule, EnableRule, PutTargets,
    -- PutRule, TagResource, or UntagResource.
    record ManagedRuleException
        message: string
    end

    -- The event bus policy is too long. For more information, see the limits.
    record PolicyLengthExceededException
        message: string
    end

    enum ApiDestinationHttpMethod
        "POST"
        "GET"
        "HEAD"
        "OPTIONS"
        "PUT"
        "PATCH"
        "DELETE"
    end

    enum ApiDestinationState
        "ACTIVE"
        "INACTIVE"
    end

    enum ArchiveState
        "ENABLED"
        "DISABLED"
        "CREATING"
        "UPDATING"
        "CREATE_FAILED"
        "UPDATE_FAILED"
    end

    enum ConnectionAuthorizationType
        "BASIC"
        "OAUTH_CLIENT_CREDENTIALS"
        "API_KEY"
    end

    enum ConnectionState
        "CREATING"
        "UPDATING"
        "DELETING"
        "AUTHORIZED"
        "DEAUTHORIZED"
        "AUTHORIZING"
        "DEAUTHORIZING"
        "ACTIVE"
        "FAILED_CONNECTIVITY"
    end

    enum EndpointState
        "ACTIVE"
        "CREATING"
        "UPDATING"
        "DELETING"
        "CREATE_FAILED"
        "UPDATE_FAILED"
        "DELETE_FAILED"
    end

    enum EventSourceState
        "PENDING"
        "ACTIVE"
        "DELETED"
    end

    enum ReplayState
        "STARTING"
        "RUNNING"
        "CANCELLING"
        "COMPLETED"
        "CANCELLED"
        "FAILED"
    end

    enum RuleState
        "ENABLED"
        "DISABLED"
        "ENABLED_WITH_ALL_CLOUDTRAIL_MANAGEMENT_EVENTS"
    end

end

return M
