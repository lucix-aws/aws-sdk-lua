end

local record CreateUserInput
    -- The ID of the user. This value is stored as a lowercase string.
    UserId: string
    -- The username of the user.
    UserName: string
    -- The options are valkey or redis.
    Engine: string
    -- Passwords used for this user. You can create up to two passwords for each user.
    Passwords: {string}
    -- Access permissions string used for this user.
    AccessString: string
    -- Indicates a password is not required for this user.
    NoPasswordRequired: boolean
    -- A list of tags to be added to this resource. A tag is a key-value pair. A tag key must
    -- be accompanied by a tag value, although null is accepted.
    Tags: {Tag}
    -- Specifies how to authenticate the user.
    AuthenticationMode: AuthenticationMode
end

local record CreateUserOutput
    -- The ID of the user.
    UserId: string
    -- The username of the user.
    UserName: string
    -- Indicates the user status. Can be "active", "modifying" or "deleting".
    Status: string
    -- The options are valkey or redis.
    Engine: string
    -- The minimum engine version required, which is Redis OSS 6.0
    MinimumEngineVersion: string
    -- Access permissions string used for this user.
    AccessString: string
    -- Returns a list of the user group IDs the user belongs to.
    UserGroupIds: {string}
    -- Denotes whether the user requires a password to authenticate.
    Authentication: Authentication
    -- The Amazon Resource Name (ARN) of the user.
    ARN: string
