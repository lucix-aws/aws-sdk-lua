        -- The Amazon Resource Name (ARN) of the resource set.
        ResourceSetArn: string
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the resource to return tags for. The Firewall Manager resources that support tagging are policies, applications lists, and protocols lists.
        ResourceArn: string
        -- The tags to add to the resource.
        TagList: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource to return tags for. The Firewall Manager resources that support tagging are policies, applications lists, and protocols lists.
        ResourceArn: string
        -- The keys of the tags to remove from the resource.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    -- The operation failed because of a system problem, even though the request was valid. Retry
    -- your request.
    record InternalErrorException
        Message: string
    end

    -- The parameters of the request were invalid.
    record InvalidInputException
        Message: string
    end

    -- The operation failed because there was nothing to do or the operation wasn't possible. For example, you might have
    -- submitted an AssociateAdminAccount request for an account ID that
    -- was already set as the Firewall Manager administrator. Or you might have tried to access a Region
    -- that's disabled by default, and that you need to enable for the Firewall Manager
    -- administrator account and for Organizations before you can access it.
    record InvalidOperationException
        Message: string
    end

    -- The operation exceeds a resource limit, for example, the maximum number of
    -- policy objects that you can create for an Amazon Web Services account. For more information,
    -- see Firewall
    -- Manager Limits in the WAF Developer Guide.
    record LimitExceededException
        Message: string
    end

    -- The specified resource was not found.
    record ResourceNotFoundException
        Message: string
    end

    -- The value of the Type parameter is invalid.
    record InvalidTypeException
        Message: string
    end

    enum AccountRoleStatus
        "READY"
        "CREATING"
        "PENDING_DELETION"
        "DELETING"
        "DELETED"
    end

    enum MarketplaceSubscriptionOnboardingStatus
        "NO_SUBSCRIPTION"
        "NOT_COMPLETE"
        "COMPLETE"
    end

    enum OrganizationStatus
        "ONBOARDING"
        "ONBOARDING_COMPLETE"
        "OFFBOARDING"
        "OFFBOARDING_COMPLETE"
    end

    enum SecurityServiceType
        "WAF"
        "WAFV2"
        "SHIELD_ADVANCED"
        "SECURITY_GROUPS_COMMON"
        "SECURITY_GROUPS_CONTENT_AUDIT"
        "SECURITY_GROUPS_USAGE_AUDIT"
        "NETWORK_FIREWALL"
        "DNS_FIREWALL"
        "THIRD_PARTY_FIREWALL"
        "IMPORT_NETWORK_FIREWALL"
        "NETWORK_ACL_COMMON"
    end

    enum ThirdPartyFirewall
        "PALO_ALTO_NETWORKS_CLOUD_NGFW"
        "FORTIGATE_CLOUD_NATIVE_FIREWALL"
    end

    enum ThirdPartyFirewallAssociationStatus
        "ONBOARDING"
        "ONBOARD_COMPLETE"
        "OFFBOARDING"
        "OFFBOARD_COMPLETE"
        "NOT_EXIST"
    end

end

return M
