local record UpdateKxClusterDatabasesOutput
end

local record UpdateKxDatabaseInput
    -- A unique identifier for the kdb environment.
    environmentId: string
    -- The name of the kdb database.
    databaseName: string
    -- A description of the database.
    description: string
    -- A token that ensures idempotency. This token expires in 10 minutes.
    clientToken: string
end

local record UpdateKxDatabaseOutput
    -- The name of the kdb database.
    databaseName: string
    -- A unique identifier for the kdb environment.
    environmentId: string
    -- A description of the database.
    description: string
    -- The last time that the database was modified. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.
    lastModifiedTimestamp: number
end

local record UpdateKxDataviewInput
    -- A unique identifier for the kdb environment, where you want to update the dataview.
    environmentId: string
    -- The name of the database.
    databaseName: string
    -- The name of the dataview that you want to update.
    dataviewName: string
    -- The description for a dataview.
    description: string
    -- A unique identifier for the changeset.
    changesetId: string
    -- The configuration that contains the database path of the data that you want to place on each selected volume. Each segment must have a unique database path for each volume. If you do not explicitly specify any database path for a volume, they are accessible from the cluster through the default S3/object store segment.
    segmentConfigurations: {KxDataviewSegmentConfiguration}
    -- A token that ensures idempotency. This token expires in 10 minutes.
    clientToken: string
end

local record UpdateKxDataviewOutput
    -- A unique identifier for the kdb environment, where you want to update the dataview.
    environmentId: string
    -- The name of the database.
    databaseName: string
    -- The name of the database under which the dataview was created.
    dataviewName: string
    -- The number of availability zones you want to assign per volume. Currently, FinSpace only supports SINGLE for volumes. This places dataview in a single AZ.
    azMode: string
    -- The identifier of the availability zones.
    availabilityZoneId: string
    -- A unique identifier for the changeset.
    changesetId: string
    -- The configuration that contains the database path of the data that you want to place on each selected volume. Each segment must have a unique database path for each volume. If you do not explicitly specify any database path for a volume, they are accessible from the cluster through the default S3/object store segment.
    segmentConfigurations: {KxDataviewSegmentConfiguration}
    -- The current active changeset versions of the database on the given dataview.
    activeVersions: {KxDataviewActiveVersion}
    -- The status of dataview creation.
    -- CREATING – The dataview creation is in progress.
    -- UPDATING – The dataview is in the process of being updated.
    -- ACTIVE – The dataview is active.
    status: string
    -- The option to specify whether you want to apply all the future additions and corrections automatically to the dataview when new changesets are ingested. The default value is false.
    autoUpdate: boolean
    -- Returns True if the dataview is created as writeable and False otherwise.
    readWrite: boolean
    -- A description of the dataview.
    description: string
    -- The timestamp at which the dataview was created in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.
    createdTimestamp: number
    -- The last time that the dataview was updated in FinSpace. The value is determined as epoch time in milliseconds. For example, the value for Monday, November 1, 2021 12:00:00 PM UTC is specified as 1635768000000.
    lastModifiedTimestamp: number
end

local record UpdateKxEnvironmentInput
    -- A unique identifier for the kdb environment.
    environmentId: string
    -- The name of the kdb environment.
    name: string
    -- A description of the kdb environment.
    description: string
    -- A token that ensures idempotency. This token expires in 10 minutes.
    clientToken: string
end

local record UpdateKxEnvironmentOutput
    -- The name of the kdb environment.
    name: string
    -- A unique identifier for the kdb environment.
    environmentId: string
    -- The unique identifier of the AWS account that is used to create the kdb environment.
    awsAccountId: string
    -- The status of the kdb environment.
    status: string
    -- The status of the network configuration.
    tgwStatus: string
    -- The status of DNS configuration.
    dnsStatus: string
    -- Specifies the error message that appears if a flow fails.
    errorMessage: string
    -- The description of the environment.
    description: string
    -- The ARN identifier of the environment.
    environmentArn: string
    -- The KMS key ID to encrypt your data in the FinSpace environment.
    kmsKeyId: string
    -- A unique identifier for the AWS environment infrastructure account.
    dedicatedServiceAccountId: string
    transitGatewayConfiguration: TransitGatewayConfiguration
    -- A list of DNS server name and server IP. This is used to set up Route-53 outbound resolvers.
    customDNSConfiguration: {CustomDNSServer}
    -- The timestamp at which the kdb environment was created in FinSpace.
    creationTimestamp: number
    -- The timestamp at which the kdb environment was updated.
    updateTimestamp: number
    -- The identifier of the availability zones where subnets for the environment are created.
    availabilityZoneIds: {string}
end

