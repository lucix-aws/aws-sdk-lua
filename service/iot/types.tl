    -- An unexpected error has occurred.
    record InternalFailureException
        -- The message for the exception.
        message: string
    end

    -- The request is not valid.
    record InvalidRequestException
        -- The message for the exception.
        message: string
    end

    -- The specified resource does not exist.
    record ResourceNotFoundException
        -- The message for the exception.
        message: string
    end

    -- The service is temporarily unavailable.
    record ServiceUnavailableException
        -- The message for the exception.
        message: string
    end

    -- The rate exceeds the limit.
    record ThrottlingException
        -- The message for the exception.
        message: string
    end

    -- You can't revert the certificate transfer because the transfer is already
    -- complete.
    record TransferAlreadyCompletedException
        -- The message for the exception.
        message: string
    end

    -- You are not authorized to perform this operation.
    record UnauthorizedException
        -- The message for the exception.
        message: string
    end

    -- The request conflicts with the current state of the resource.
    record ConflictException
        message: string
        -- A resource with the same name already exists.
        resourceId: string
    end

    -- Internal error from the service that indicates an unexpected error or that the service
    -- is unavailable.
    record InternalServerException
        message: string
    end

    -- Service quota has been exceeded.
    record ServiceQuotaExceededException
        message: string
    end

    -- The request is not valid.
    record ValidationException
        message: string
    end

    -- A limit has been exceeded.
    record LimitExceededException
        -- The message for the exception.
        message: string
    end

    -- An exception thrown when the version of an entity specified with the
    -- expectedVersion parameter does not match the latest version in the
    -- system.
    record VersionConflictException
        -- The message for the exception.
        message: string
    end

    -- An attempt was made to change to an invalid state, for example by deleting a job or a
    -- job execution which is "IN_PROGRESS" without setting the force
    -- parameter.
    record InvalidStateTransitionException
        -- The message for the exception.
        message: string
    end

    -- A conflicting resource update exception. This exception is thrown when two pending
    -- updates cause a conflict.
    record ConflictingResourceUpdateException
        -- The message for the exception.
        message: string
    end

    -- An unexpected error has occurred.
    record InternalException
        -- The message for the exception.
        message: string
    end

    -- The resource already exists.
    record ResourceAlreadyExistsException
        -- The message for the exception.
        message: string
        -- The ID of the resource that caused the exception.
        resourceId: string
        -- The ARN of the resource that caused the exception.
        resourceArn: string
    end

    -- The certificate is invalid.
    record CertificateValidationException
        -- Additional information about the exception.
        message: string
    end

    -- The query is invalid.
    record InvalidQueryException
        -- The message for the exception.
        message: string
    end

    -- The index is not ready.
    record IndexNotReadyException
        -- The message for the exception.
        message: string
    end

    -- The aggregation is invalid.
    record InvalidAggregationException
        message: string
    end

    -- The policy documentation is not valid.
    record MalformedPolicyException
        -- The message for the exception.
        message: string
    end

    -- The number of policy versions exceeds the limit.
    record VersionsLimitExceededException
        -- The message for the exception.
        message: string
    end

    -- The Rule-SQL expression can't be parsed correctly.
    record SqlParseException
        -- The message for the exception.
        message: string
    end

    -- You can't delete the resource because it is attached to one or more
    -- resources.
    record DeleteConflictException
        -- The message for the exception.
        message: string
    end

    -- The certificate operation is not allowed.
    record CertificateStateException
        -- The message for the exception.
        message: string
    end

    -- The resource is not configured.
    record NotConfiguredException
        -- The message for the exception.
        message: string
    end

    -- The registration code is invalid.
    record RegistrationCodeValidationException
        -- Additional information about the exception.
        message: string
    end

    -- Unable to verify the CA certificate used to sign the device certificate you are
    -- attempting to register. This is happens when you have registered more than one CA
    -- certificate that has the same subject field and public key.
    record CertificateConflictException
        -- The message for the exception.
        message: string
    end

    -- The resource registration failed.
    record ResourceRegistrationFailureException
        -- The message for the exception.
        message: string
    end

    -- This exception occurs if you attempt to start a task with the same task-id as an existing task but with a different clientRequestToken.
    record TaskAlreadyExistsException
        message: string
    end

    -- The response is invalid.
    record InvalidResponseException
        -- The message for the exception.
        message: string
    end

    -- You can't transfer the certificate because authorization policies are still
    -- attached.
    record TransferConflictException
        -- The message for the exception.
        message: string
    end

