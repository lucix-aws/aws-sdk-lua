        "SNAPSHOT"
    end

    enum TemplateType
        "FLEET_PROVISIONING"
        "JITP"
    end

    enum ThingPrincipalType
        "EXCLUSIVE_THING"
        "NON_EXCLUSIVE_THING"
    end

    enum TopicRuleDestinationStatus
        "ENABLED"
        "IN_PROGRESS"
        "DISABLED"
        "ERROR"
        "DELETING"
    end

    enum VerificationState
        "FALSE_POSITIVE"
        "BENIGN_POSITIVE"
        "TRUE_POSITIVE"
        "UNKNOWN"
    end

end

return M
