        "RuleName"
        "MqttTopic"
    end

    enum FuotaTaskStatus
        "Pending"
        "FuotaSession_Waiting"
        "In_FuotaSession"
        "FuotaDone"
        "Delete_Waiting"
    end

    enum IdentifierType
        "PartnerAccountId"
        "DevEui"
        "GatewayEui"
        "WirelessDeviceId"
        "WirelessGatewayId"
    end

    enum ImportTaskStatus
        "INITIALIZING"
        "INITIALIZED"
        "PENDING"
        "COMPLETE"
        "FAILED"
        "DELETING"
    end

    enum LogLevel
        "INFO"
        "ERROR"
        "DISABLED"
    end

    enum OnboardStatus
        "INITIALIZED"
        "PENDING"
        "ONBOARDED"
        "FAILED"
    end

    enum PartnerType
        "Sidewalk"
    end

    enum PositionResourceType
        "WirelessDevice"
        "WirelessGateway"
