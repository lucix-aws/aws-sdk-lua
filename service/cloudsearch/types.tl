    -- The result of a DescribeScalingParameters request. Contains the scaling parameters configured for the domain specified in the request.
    record DescribeScalingParametersOutput
        ScalingParameters: ScalingParametersStatus
    end

    -- Container for the parameters to the DescribeServiceAccessPolicies operation. Specifies the name of the domain you want to describe. To show the active configuration and exclude any pending changes, set the Deployed option to true.
    record DescribeServiceAccessPoliciesInput
        -- The name of the domain you want to describe.
        DomainName: string
        -- Whether to display the deployed configuration (true) or include any pending changes (false). Defaults to false.
        Deployed: boolean
    end

    -- The configured access rules for the domain's document and search endpoints, and the current status of those rules.
    record AccessPoliciesStatus
        Options: string
        Status: OptionStatus
    end

    -- The result of a DescribeServiceAccessPolicies request.
    record DescribeServiceAccessPoliciesOutput
        -- The access rules configured for the domain specified in the request.
        AccessPolicies: AccessPoliciesStatus
    end

    -- Container for the parameters to the DescribeSuggester operation. Specifies the name of the domain you want to describe. To restrict the response to particular suggesters, specify the names of the suggesters you want to describe. To show the active configuration and exclude any pending changes, set the Deployed option to true.
    record DescribeSuggestersInput
        -- The name of the domain you want to describe.
        DomainName: string
        -- The suggesters you want to describe.
        SuggesterNames: {string}
        -- Whether to display the deployed configuration (true) or include any pending changes (false). Defaults to false.
        Deployed: boolean
    end

    -- The result of a DescribeSuggesters request.
    record DescribeSuggestersOutput
        -- The suggesters configured for the domain specified in the request.
        Suggesters: {SuggesterStatus}
    end

    -- Container for the parameters to the IndexDocuments operation. Specifies the name of the domain you want to re-index.
    record IndexDocumentsInput
        DomainName: string
    end

    -- The result of an IndexDocuments request. Contains the status of the indexing operation, including the fields being indexed.
    record IndexDocumentsOutput
        -- The names of the fields that are currently being indexed.
        FieldNames: {string}
    end

    record ListDomainNamesInput
    end

    -- The result of a ListDomainNames request. Contains a list of the domains owned by an account.
    record ListDomainNamesOutput
        -- The names of the search domains owned by an account.
        DomainNames: {string : string}
    end

    -- Container for the parameters to the UpdateAvailabilityOptions operation. Specifies the name of the domain you want to update and the Multi-AZ availability option.
    record UpdateAvailabilityOptionsInput
        DomainName: string
        -- You expand an existing search domain to a second Availability Zone by setting the Multi-AZ option to true. Similarly, you can turn off the Multi-AZ option to downgrade the domain to a single Availability Zone by setting the Multi-AZ option to false.
        MultiAZ: boolean
    end

    -- The result of a UpdateAvailabilityOptions request. Contains the status of the domain's availability options.
    record UpdateAvailabilityOptionsOutput
        -- The newly-configured availability options. Indicates whether Multi-AZ is enabled for the domain.
        AvailabilityOptions: AvailabilityOptionsStatus
    end

    -- Container for the parameters to the UpdateDomainEndpointOptions operation. Specifies the name of the domain you want to update and the domain endpoint options.
    record UpdateDomainEndpointOptionsInput
        -- A string that represents the name of a domain.
        DomainName: string
        -- Whether to require that all requests to the domain arrive over HTTPS. We recommend Policy-Min-TLS-1-2-2019-07 for TLSSecurityPolicy. For compatibility with older clients, the default is Policy-Min-TLS-1-0-2019-07.
        DomainEndpointOptions: DomainEndpointOptions
    end

    -- The result of a UpdateDomainEndpointOptions request. Contains the configuration and status of the domain's endpoint options.
    record UpdateDomainEndpointOptionsOutput
        -- The newly-configured domain endpoint options.
        DomainEndpointOptions: DomainEndpointOptionsStatus
    end

    -- Container for the parameters to the UpdateScalingParameters operation. Specifies the name of the domain you want to update and the scaling parameters you want to configure.
    record UpdateScalingParametersInput
        DomainName: string
        ScalingParameters: ScalingParameters
    end

    -- The result of a UpdateScalingParameters request. Contains the status of the newly-configured scaling parameters.
    record UpdateScalingParametersOutput
        ScalingParameters: ScalingParametersStatus
    end

    -- Container for the parameters to the UpdateServiceAccessPolicies operation. Specifies the name of the domain you want to update and the access rules you want to configure.
    record UpdateServiceAccessPoliciesInput
        DomainName: string
        -- The access rules you want to configure. These rules replace any existing rules.
        AccessPolicies: string
    end

    -- The result of an UpdateServiceAccessPolicies request. Contains the new access policies.
    record UpdateServiceAccessPoliciesOutput
        -- The access rules configured for the domain.
        AccessPolicies: AccessPoliciesStatus
    end

end

return M
