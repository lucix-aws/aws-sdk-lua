    -- The operation to be performed on the provided source fields.
    record ConnectorOperator
        -- The operation to be performed on the provided Amplitude source fields.
        Amplitude: string
        -- The operation to be performed on the provided Datadog source fields.
        Datadog: string
        -- The operation to be performed on the provided Dynatrace source fields.
        Dynatrace: string
        -- The operation to be performed on the provided Google Analytics source fields.
        GoogleAnalytics: string
        -- The operation to be performed on the provided Infor Nexus source fields.
        InforNexus: string
        -- The operation to be performed on the provided Marketo source fields.
        Marketo: string
        -- The operation to be performed on the provided Amazon S3 source fields.
        S3: string
        -- The operation to be performed on the provided Salesforce source fields.
        Salesforce: string
        -- The operation to be performed on the provided ServiceNow source fields.
        ServiceNow: string
        -- The operation to be performed on the provided Singular source fields.
        Singular: string
        -- The operation to be performed on the provided Slack source fields.
        Slack: string
        -- The operation to be performed on the provided Trend Micro source fields.
        Trendmicro: string
        -- The operation to be performed on the provided Veeva source fields.
        Veeva: string
        -- The operation to be performed on the provided Zendesk source fields.
        Zendesk: string
        -- The operation to be performed on the provided SAPOData source fields.
        SAPOData: string
        -- Operators supported by the custom connector.
        CustomConnector: string
        -- The operation to be performed on the provided Salesforce Pardot source fields.
        Pardot: string
    end

    -- The OAuth 2.0 properties required for OAuth 2.0 authentication.
    record OAuth2Properties
        -- The token URL required for OAuth 2.0 authentication.
        tokenUrl: string
        -- The OAuth 2.0 grant type used by connector for OAuth 2.0 authentication.
        oAuth2GrantType: string
        -- Associates your token URL with a map of properties that you define. Use this parameter to
        -- provide any additional details that the connector requires to authenticate your
        -- request.
        tokenUrlCustomProperties: {string : string}
    end

    -- The profile properties required by the custom connector.
    record CustomConnectorProfileProperties
        -- A map of properties that are required to create a profile for the custom connector.
        profileProperties: {string : string}
        oAuth2Properties: OAuth2Properties
    end

    -- The connector-specific profile properties required by Datadog.
    record DatadogConnectorProfileProperties
        -- The location of the Datadog resource.
        instanceUrl: string
    end

    -- The connector-specific profile properties required by Dynatrace.
    record DynatraceConnectorProfileProperties
        -- The location of the Dynatrace resource.
        instanceUrl: string
    end

    -- The connector-specific profile properties required by Google Analytics.
    record GoogleAnalyticsConnectorProfileProperties
    end

    -- The connector-specific properties required when using Amazon Honeycode.
    record HoneycodeConnectorProfileProperties
    end

    -- The connector-specific profile properties required by Infor Nexus.
    record InforNexusConnectorProfileProperties
        -- The location of the Infor Nexus resource.
        instanceUrl: string
    end

    -- The connector-specific profile properties required when using Marketo.
    record MarketoConnectorProfileProperties
        -- The location of the Marketo resource.
        instanceUrl: string
    end

    -- The connector-specific profile properties required when using Salesforce Pardot.
    record PardotConnectorProfileProperties
        -- The location of the Salesforce Pardot resource.
        instanceUrl: string
        -- Indicates whether the connector profile applies to a sandbox or production
        -- environment.
        isSandboxEnvironment: boolean
        -- The business unit id of Salesforce Pardot instance.
        businessUnitId: string
    end

    -- The connector-specific profile properties when using Amazon Redshift.
    record RedshiftConnectorProfileProperties
        -- The JDBC URL of the Amazon Redshift cluster.
        databaseUrl: string
        -- A name for the associated Amazon S3 bucket.
        bucketName: string
        -- The object key for the destination bucket in which Amazon AppFlow places the files.
        bucketPrefix: string
        -- The Amazon Resource Name (ARN) of IAM role that grants Amazon Redshift
        -- read-only access to Amazon S3. For more information, and for the polices that you
        -- attach to this role, see Allow Amazon Redshift to access your Amazon AppFlow data in Amazon S3.
        roleArn: string
        -- The Amazon Resource Name (ARN) of an IAM role that permits Amazon AppFlow to access your Amazon Redshift database through the Data API. For more
        -- information, and for the polices that you attach to this role, see Allow Amazon AppFlow to access Amazon Redshift databases with the Data
        -- API.
        dataApiRoleArn: string
        -- Indicates whether the connector profile defines a connection to an Amazon Redshift
        -- Serverless data warehouse.
        isRedshiftServerless: boolean
        -- The unique ID that's assigned to an Amazon Redshift cluster.
        clusterIdentifier: string
        -- The name of an Amazon Redshift workgroup.
        workgroupName: string
        -- The name of an Amazon Redshift database.
        databaseName: string
    end

    -- The connector-specific profile properties required when using Salesforce.
    record SalesforceConnectorProfileProperties
        -- The location of the Salesforce resource.
        instanceUrl: string
        -- Indicates whether the connector profile applies to a sandbox or production environment.
        isSandboxEnvironment: boolean
        -- If the connection mode for the connector profile is private, this parameter sets whether
        -- Amazon AppFlow uses the private network to send metadata and authorization calls to
        -- Salesforce. Amazon AppFlow sends private calls through Amazon Web Services PrivateLink. These
        -- calls travel through Amazon Web Services infrastructure without being exposed to the public
        -- internet.
        -- Set either of the following values:
        -- true
        -- Amazon AppFlow sends all calls to Salesforce over the private network.
        -- These private calls are:
        -- Calls to get metadata about your Salesforce records. This metadata describes
        -- your Salesforce objects and their fields.
        -- Calls to get or refresh access tokens that allow Amazon AppFlow to access
        -- your Salesforce records.
        -- Calls to transfer your Salesforce records as part of a flow run.
        -- false
        -- The default value. Amazon AppFlow sends some calls to Salesforce privately and
        -- other calls over the public internet.
        -- The public calls are:
        -- Calls to get metadata about your Salesforce records.
        -- Calls to get or refresh access tokens.
        -- The private calls are:
        -- Calls to transfer your Salesforce records as part of a flow run.
        usePrivateLinkForMetadataAndAuthorization: boolean
    end

    -- The OAuth properties required for OAuth type authentication.
    record OAuthProperties
        -- The token url required to fetch access/refresh tokens using authorization code and also
        -- to refresh expired access token using refresh token.
        tokenUrl: string
        -- The authorization code url required to redirect to SAP Login Page to fetch authorization
        -- code for OAuth type authentication.
        authCodeUrl: string
        -- The OAuth scopes required for OAuth type authentication.
        oAuthScopes: {string}
    end

    -- The connector-specific profile properties required when using SAPOData.
    record SAPODataConnectorProfileProperties
        -- The location of the SAPOData resource.
        applicationHostUrl: string
        -- The application path to catalog service.
        applicationServicePath: string
        -- The port number of the SAPOData instance.
        portNumber: number
        -- The client number for the client creating the connection.
        clientNumber: string
        -- The logon language of SAPOData instance.
        logonLanguage: string
        -- The SAPOData Private Link service name to be used for private data transfers.
        privateLinkServiceName: string
        -- The SAPOData OAuth properties required for OAuth type authentication.
        oAuthProperties: OAuthProperties
        -- If you set this parameter to true, Amazon AppFlow bypasses the single
        -- sign-on (SSO) settings in your SAP account when it accesses your SAP OData instance.
        -- Whether you need this option depends on the types of credentials that you applied to your
        -- SAP OData connection profile. If your profile uses basic authentication credentials, SAP SSO
        -- can prevent Amazon AppFlow from connecting to your account with your username and
        -- password. In this case, bypassing SSO makes it possible for Amazon AppFlow to connect
        -- successfully. However, if your profile uses OAuth credentials, this parameter has no
        -- affect.
        disableSSO: boolean
    end

