    -- The exception that occurs when you do not have sufficient permissions to perform an action. Verify that your IAM policy includes the necessary permissions for the operation you are trying to perform.
    record AccessDeniedException
        message: string
    end

    -- The exception that occurs when the specified resource does not exist. This can happen when using an invalid identifier or when trying to access a resource that has been deleted.
    record ResourceNotFoundException
        message: string
    end

    -- The service encountered an internal error. Try your request again later.
    record ServiceException
        message: string
    end

    -- The exception that occurs when the request would cause a service quota to be exceeded. Review your service quotas and either reduce your request rate or request a quota increase.
    record ServiceQuotaExceededException
        message: string
    end

    -- The request was denied due to request throttling. Reduce the frequency of requests and try again.
    record ThrottledException
        message: string
    end

    -- The exception that occurs when the input fails to satisfy the constraints specified by the service. Check the error message for details about which input parameter is invalid and correct your request.
    record ValidationException
        message: string
        reason: string
        fieldList: {ValidationExceptionField}
    end

    -- The exception that occurs when the service encounters an unexpected internal error. This is a temporary condition that will resolve itself with retries. We recommend implementing exponential backoff retry logic in your application.
    record InternalServerException
        message: string
    end

    -- The exception that occurs when the request was denied due to request throttling. This happens when you exceed the allowed request rate for an operation. Reduce the frequency of requests or implement exponential backoff retry logic in your application.
    record ThrottlingException
        message: string
    end

    -- This exception is thrown when the JWT bearer token is invalid or not found for OAuth bearer token based access
    record UnauthorizedException
        message: string
    end

    -- The exception that occurs when the request conflicts with the current state of the resource. This can happen when trying to modify a resource that is currently being modified by another request, or when trying to create a resource that already exists.
    record ConflictException
        message: string
    end

    -- The input fails to satisfy the constraints specified by AgentCore. Check your input values and try again.
    record InvalidInputException
        message: string
    end

    -- The exception that occurs when there is a retryable conflict performing an operation. This is a temporary condition that may resolve itself with retries. We recommend implementing exponential backoff retry logic in your application.
    record RetryableConflictException
        message: string
    end

    -- An exception thrown when attempting to create a resource with an identifier that already exists.
    record DuplicateIdException
        message: string
    end

    -- The exception that occurs when there is an error in the runtime client. This can happen due to network issues, invalid configuration, or other client-side problems. Check the error message for specific details about the error.
    record RuntimeClientError
        message: string
    end

    enum ABTestExecutionStatus
        "PAUSED"
        "RUNNING"
        "STOPPED"
        "NOT_STARTED"
    end

    enum ABTestStatus
        "CREATING"
        "ACTIVE"
        "CREATE_FAILED"
        "UPDATING"
        "UPDATE_FAILED"
        "DELETING"
        "DELETE_FAILED"
        "FAILED"
    end

    enum BatchEvaluationStatus
        "PENDING"
        "IN_PROGRESS"
        "COMPLETED"
        "COMPLETED_WITH_ERRORS"
        "FAILED"
        "STOPPING"
        "STOPPED"
        "DELETING"
    end

    enum BrowserSessionStatus
        "READY"
        "TERMINATED"
    end

    enum CodeInterpreterSessionStatus
        "READY"
        "TERMINATED"
    end

    enum Oauth2FlowType
        "USER_FEDERATION"
        "M2M"
        "ON_BEHALF_OF_TOKEN_EXCHANGE"
    end

    enum RecommendationStatus
        "PENDING"
        "IN_PROGRESS"
        "COMPLETED"
        "FAILED"
        "DELETING"
    end

    enum RecommendationType
        "SYSTEM_PROMPT_RECOMMENDATION"
        "TOOL_DESCRIPTION_RECOMMENDATION"
    end

    enum SessionStatus
        "IN_PROGRESS"
        "FAILED"
    end

    enum ToolName
        "executeCode"
        "executeCommand"
        "readFiles"
        "listFiles"
        "removeFiles"
        "writeFiles"
        "startCommandExecution"
        "getTask"
        "stopTask"
    end

end

return M
