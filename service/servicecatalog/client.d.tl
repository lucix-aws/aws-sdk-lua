    updateServiceAction: function(Client, types.UpdateServiceActionInput): Operation<types.UpdateServiceActionOutput>
    -- Updates the specified TagOption.
    updateTagOption: function(Client, types.UpdateTagOptionInput): Operation<types.UpdateTagOptionOutput>
end

local record M
