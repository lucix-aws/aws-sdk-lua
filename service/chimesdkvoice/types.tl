        Code: string
        Message: string
    end

    -- The service is currently unavailable.
    record ServiceUnavailableException
        Code: string
        Message: string
    end

    -- The number of customer requests exceeds the request rate limit.
    record ThrottledClientException
        Code: string
        Message: string
    end

    -- The client isn't authorized to request a resource.
    record UnauthorizedClientException
        Code: string
        Message: string
    end

    -- The request exceeds the resource limit.
    record ResourceLimitExceededException
        Code: string
        Message: string
    end

    -- Multiple instances of the same request were made simultaneously.
    record ConflictException
        Code: string
        Message: string
    end

    -- Access to the target resource is no longer available at the origin server. This condition is likely to be permanent.
    record GoneException
        Code: string
        Message: string
    end

    -- A well-formed request couldn't be followed due to semantic errors.
    record UnprocessableEntityException
        Code: string
        Message: string
    end

