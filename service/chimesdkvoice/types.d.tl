local record ValidateE911AddressInput
    -- The AWS account ID.
    AwsAccountId: string
    -- The address street number, such as 200 or 2121.
    StreetNumber: string
    -- The address street information, such as 8th Avenue.
    StreetInfo: string
    -- The address city, such as Portland.
    City: string
    -- The address state, such as ME.
    State: string
    -- The country in the address being validated as two-letter country code in ISO 3166-1
    -- alpha-2 format, such as US. For more information, see ISO 3166-1 alpha-2 in
    -- Wikipedia.
    Country: string
    -- The dress postal code, such 04352.
    PostalCode: string
end

local record ValidateE911AddressOutput
    -- Number indicating the result of address validation.
    -- Each possible result is defined as follows:
    -- 0 - Address validation succeeded.
    -- 1 - Address validation succeeded. The address was a close enough
    -- match and has been corrected as part of the address object.
    -- 2 - Address validation failed. You should re-submit the validation
    -- request with candidates from the CandidateAddressList result, if it's a
    -- close match.
    ValidationResult: number
    -- The ID that represents the address.
    AddressExternalId: string
    -- The validated address.
    Address: Address
    -- The list of address suggestions..
    CandidateAddressList: {CandidateAddress}
end

