        deliveries: {Delivery}
        nextToken: string
    end

    record DescribeDeliveryDestinationsInput
        nextToken: string
        -- Optionally specify the maximum number of delivery destinations to return in the
        -- response.
        limit: number
    end

    record DescribeDeliveryDestinationsOutput
        -- An array of structures. Each structure contains information about one delivery destination
        -- in the account.
        deliveryDestinations: {DeliveryDestination}
        nextToken: string
    end

    record DescribeDeliverySourcesInput
        nextToken: string
        -- Optionally specify the maximum number of delivery sources to return in the
        -- response.
        limit: number
    end

    record DescribeDeliverySourcesOutput
        -- An array of structures. Each structure contains information about one delivery source in
        -- the account.
        deliverySources: {DeliverySource}
        nextToken: string
    end

    record DescribeDestinationsInput
        -- The prefix to match. If you don't specify a value, no prefix filter is
        -- applied.
        DestinationNamePrefix: string
        -- The token for the next set of items to return. (You received this token from a previous
        -- call.)
        nextToken: string
        -- The maximum number of items returned. If you don't specify a value, the default maximum
        -- value of 50 items is used.
        limit: number
    end

    -- Represents a cross-account destination that receives subscription log events.
    record Destination
        -- The name of the destination.
        destinationName: string
        -- The Amazon Resource Name (ARN) of the physical target where the log events are
        -- delivered (for example, a Kinesis stream).
        targetArn: string
        -- A role for impersonation, used when delivering log events to the target.
        roleArn: string
        -- An IAM policy document that governs which Amazon Web Services accounts can create
        -- subscription filters against this destination.
        accessPolicy: string
        -- The ARN of this destination.
        arn: string
        -- The creation time of the destination, expressed as the number of milliseconds after Jan
        -- 1, 1970 00:00:00 UTC.
        creationTime: number
    end

    record DescribeDestinationsOutput
        -- The destinations.
        destinations: {Destination}
        nextToken: string
    end

    enum ExportTaskStatusCode
        "CANCELLED"
        "COMPLETED"
        "FAILED"
        "PENDING"
        "PENDING_CANCEL"
        "RUNNING"
    end

    record DescribeExportTasksInput
