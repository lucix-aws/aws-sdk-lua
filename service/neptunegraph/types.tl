    -- Raised when a conflict is encountered.
    record ConflictException
        -- A message describing the problem.
        message: string
        -- The reason for the conflict exception.
        reason: string
    end

    -- A failure occurred on the server.
    record InternalServerException
        -- A message describing the problem.
        message: string
    end

    -- A specified resource could not be located.
    record ResourceNotFoundException
        -- A message describing the problem.
        message: string
    end

    -- The exception was interrupted by throttling.
    record ThrottlingException
        -- A message describing the problem.
        message: string
    end

    -- A resource could not be validated.
    record ValidationException
        -- A message describing the problem.
        message: string
        -- The reason that the resource could not be validated.
        reason: string
    end

    -- Raised in case of an authentication or authorization failure.
    record AccessDeniedException
        -- A message describing the problem.
        message: string
    end

    -- A service quota was exceeded.
    record ServiceQuotaExceededException
        message: string
        -- The identifier of the resource that exceeded quota.
        resourceId: string
        -- The type of the resource that exceeded quota. Ex: Graph, Snapshot
        resourceType: string
        -- The service code that exceeded quota.
        serviceCode: string
        -- Service quota code of the resource for which quota was exceeded.
        quotaCode: string
    end

    -- Request cannot be processed due to known reasons. Eg. partition full.
    record UnprocessableException
        message: string
        -- The reason for the unprocessable exception.
        reason: string
    end

