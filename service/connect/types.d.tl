    -- The unique identifier of the attached file resource.
    FileId: string
    -- The time of Creation of the file resource as an ISO timestamp. It's specified in ISO 8601 format:
    -- yyyy-MM-ddThh:mm:ss.SSSZ. For example, 2024-05-03T02:41:28.172Z.
    CreationTime: string
    -- The current status of the attached file.
    FileStatus: string
    -- A case-sensitive name of the attached file being uploaded.
    FileName: string
    -- The size of the attached file in bytes.
    FileSizeInBytes: number
    -- The resource to which the attached file is (being) uploaded to. Cases are the only current supported
    -- resource.
    AssociatedResourceArn: string
    -- The use case for the file.
    FileUseCaseType: string
    -- Represents the identity that created the file.
    CreatedBy: CreatedByInfo
    -- URL and expiry to be used when downloading the attached file.
    DownloadUrlMetadata: DownloadUrlMetadata
    -- The tags used to organize, track, or control access for this resource. For example, { "Tags":
    -- {"key1":"value1", "key2":"value2"} }.
    Tags: {string : string}
end

