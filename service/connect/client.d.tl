    -- Administrator Guide:
    -- Concepts: Web and mobile messaging capabilities in Amazon Connect
    -- Amazon Connect Chat security best practices
    startContactStreaming: function(Client, types.StartContactStreamingInput): types.StartContactStreamingOutput, table
