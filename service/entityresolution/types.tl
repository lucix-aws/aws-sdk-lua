        -- The timestamp of when the ID namespace was created.
        createdAt: number
        -- The timestamp of when the ID namespace was last updated.
        updatedAt: number
    end

    record UpdateMatchingWorkflowInput
        -- The name of the workflow to be retrieved.
        workflowName: string
        -- A description of the workflow.
        description: string
        -- A list of InputSource objects, which have the fields InputSourceARN and SchemaName.
        inputSourceConfig: {InputSource}
        -- A list of OutputSource objects, each of which contains fields outputS3Path, applyNormalization, KMSArn, and output.
        outputSourceConfig: {OutputSource}
        -- An object which defines the resolutionType and the ruleBasedProperties.
        resolutionTechniques: ResolutionTechniques
        -- Optional. An object that defines the incremental run type. This object contains only the incrementalRunType field, which appears as "Automatic" in the console. For workflows where resolutionType is ML_MATCHING or PROVIDER, incremental processing is not supported.
        incrementalRunConfig: IncrementalRunConfig
        -- The Amazon Resource Name (ARN) of the IAM role. Entity Resolution assumes this role to create resources on your behalf as part of workflow execution.
        roleArn: string
    end

    record UpdateMatchingWorkflowOutput
        -- The name of the workflow.
        workflowName: string
        -- A description of the workflow.
        description: string
        -- A list of InputSource objects, which have the fields InputSourceARN and SchemaName.
        inputSourceConfig: {InputSource}
        -- A list of OutputSource objects, each of which contains fields outputS3Path, applyNormalization, KMSArn, and output.
        outputSourceConfig: {OutputSource}
        -- An object which defines the resolutionType and the ruleBasedProperties.
        resolutionTechniques: ResolutionTechniques
        -- An object which defines an incremental run type and has only incrementalRunType as a field.
        incrementalRunConfig: IncrementalRunConfig
        -- The Amazon Resource Name (ARN) of the IAM role. Entity Resolution assumes this role to create resources on your behalf as part of workflow execution.
        roleArn: string
    end

    record UpdateSchemaMappingInput
        -- The name of the schema. There can't be multiple SchemaMappings with the same name.
        schemaName: string
        -- A description of the schema.
        description: string
        -- A list of MappedInputFields. Each MappedInputField corresponds to a column the source data table, and contains column name plus additional information that Entity Resolution uses for matching.
        mappedInputFields: {SchemaInputAttribute}
    end

    record UpdateSchemaMappingOutput
        -- The name of the schema.
        schemaName: string
        -- The ARN (Amazon Resource Name) that Entity Resolution generated for the SchemaMapping.
        schemaArn: string
        -- A description of the schema.
        description: string
        -- A list of MappedInputFields. Each MappedInputField corresponds to a column the source data table, and contains column name plus additional information that Entity Resolution uses for matching.
        mappedInputFields: {SchemaInputAttribute}
    end

    -- You do not have sufficient access to perform this action.
    record AccessDeniedException
        message: string
    end

    -- The request couldn't be processed because of conflict in the current state of the resource. Example: Workflow already exists, Schema already exists, Workflow is currently running, etc.
    record ConflictException
        message: string
    end

    -- This exception occurs when there is an internal failure in the Entity Resolution service.
    record InternalServerException
        message: string
    end

    -- The resource couldn't be found.
    record ResourceNotFoundException
        message: string
    end

    -- The request was denied due to request throttling.
    record ThrottlingException
        message: string
    end

    -- The input fails to satisfy the constraints specified by Entity Resolution.
    record ValidationException
        message: string
    end

    -- The request was rejected because it attempted to create resources beyond the current Entity Resolution account limits. The error message describes the limit exceeded.
    record ExceedsLimitException
        message: string
        -- The name of the quota that has been breached.
        quotaName: string
        -- The current quota value for the customers.
        quotaValue: number
    end

    enum DeleteUniqueIdStatus
        "COMPLETED"
        "ACCEPTED"
    end

    enum IdNamespaceType
        "SOURCE"
        "TARGET"
    end

    enum JobStatus
        "RUNNING"
        "SUCCEEDED"
        "FAILED"
        "QUEUED"
    end

    enum JobType
        "BATCH"
        "INCREMENTAL"
        "DELETE_ONLY"
    end

    enum ProcessingType
        "CONSISTENT"
        "EVENTUAL"
        "EVENTUAL_NO_LOOKUP"
    end

    enum ServiceType
        "ASSIGNMENT"
        "ID_MAPPING"
    end

    enum StatementEffect
        "Allow"
        "Deny"
    end

end

return M
