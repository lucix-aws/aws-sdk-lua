end

-- Make a request to simulate the invocation of an Authorizer.
local record TestInvokeAuthorizerInput
    -- The string identifier of the associated RestApi.
    restApiId: string
    -- Specifies a test invoke authorizer request's Authorizer ID.
    authorizerId: string
    -- A key-value map of headers to simulate an incoming invocation request. This is where the incoming authorization token, or identity source, should be specified.
    headers: {string : string}
    -- The headers as a map from string to list of values to simulate an incoming invocation request. This is where the incoming authorization token, or identity source, may be specified.
    multiValueHeaders: {string : {string}}
    -- The URI path, including query string, of the simulated invocation request. Use this to specify path parameters and query string parameters.
    pathWithQueryString: string
    -- The simulated request body of an incoming invocation request.
    body: string
    -- A key-value map of stage variables to simulate an invocation on a deployed Stage.
    stageVariables: {string : string}
    -- A key-value map of additional context variables.
    additionalContext: {string : string}
end

-- Represents the response of the test invoke request for a custom Authorizer
local record TestInvokeAuthorizerOutput
    -- The HTTP status code that the client would have received. Value is 0 if the authorizer succeeded.
    clientStatus: number
    -- The API Gateway execution log for the test authorizer request.
    log: string
    -- The execution latency, in ms, of the test authorizer request.
    latency: number
    -- The principal identity returned by the Authorizer
    principalId: string
    -- The JSON policy document returned by the Authorizer
    policy: string
    -- The authorization response.
    authorization: {string : {string}}
    -- The open identity claims, with any supported custom attributes, returned from the Cognito Your User Pool configured for the API.
    claims: {string : string}
end

-- Make a request to simulate the invocation of a Method.
local record TestInvokeMethodInput
    -- The string identifier of the associated RestApi.
    restApiId: string
    -- Specifies a test invoke method request's resource ID.
    resourceId: string
    -- Specifies a test invoke method request's HTTP method.
    httpMethod: string
    -- The URI path, including query string, of the simulated invocation request. Use this to specify path parameters and query string parameters.
    pathWithQueryString: string
    -- The simulated request body of an incoming invocation request.
    body: string
    -- A key-value map of headers to simulate an incoming invocation request.
    headers: {string : string}
    -- The headers as a map from string to list of values to simulate an incoming invocation request.
    multiValueHeaders: {string : {string}}
    -- A ClientCertificate identifier to use in the test invocation. API Gateway will use the certificate when making the HTTPS request to the defined back-end endpoint.
    clientCertificateId: string
    -- A key-value map of stage variables to simulate an invocation on a deployed Stage.
    stageVariables: {string : string}
end

-- Represents the response of the test invoke request in the HTTP method.
local record TestInvokeMethodOutput
    -- The HTTP status code.
    status: number
    -- The body of the HTTP response.
    body: string
    -- The headers of the HTTP response.
    headers: {string : string}
    -- The headers of the HTTP response as a map from string to list of values.
    multiValueHeaders: {string : {string}}
    -- The API Gateway execution log for the test invoke request.
    log: string
    -- The execution latency, in ms, of the test invoke request.
    latency: number
end

