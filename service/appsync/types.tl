    -- You don't have access to perform this operation on this resource.
    record AccessDeniedException
        message: string
    end

    -- The request is not well formed. For example, a value is invalid or a required field is
    -- missing. Check the field values, and then try again.
    record BadRequestException
        message: string
        reason: string
        detail: BadRequestDetail
    end

    -- An internal AppSync error occurred. Try your request again.
    record InternalFailureException
        message: string
    end

    -- The resource specified in the request was not found. Check the resource, and then try
    -- again.
    record NotFoundException
        message: string
    end

    -- Another modification is in progress at this time and it must complete before you can
    -- make your change.
    record ConcurrentModificationException
        message: string
    end

    -- The request exceeded a limit. Try your request again.
    record LimitExceededException
        message: string
    end

    -- You aren't authorized to perform this operation.
    record UnauthorizedException
        message: string
    end

    -- The operation exceeded the service quota for this resource.
    record ServiceQuotaExceededException
        message: string
    end

    -- The API key exceeded a limit. Try your request again.
    record ApiKeyLimitExceededException
        message: string
    end

    -- The API key expiration must be set to a value between 1 and 365 days from creation (for
    -- CreateApiKey) or from update (for UpdateApiKey).
    record ApiKeyValidityOutOfBoundsException
        message: string
    end

    -- A conflict with a previous successful update is detected. This typically occurs when the
    -- previous update did not have time to propagate before the next update was made. A retry
    -- (with appropriate backoff logic) is the recommended response to this exception.
    record ConflictException
        message: string
    end

    -- The GraphQL API exceeded a limit. Try your request again.
    record ApiLimitExceededException
        message: string
    end

    -- The GraphQL schema is not valid.
    record GraphQLSchemaException
        message: string
    end

