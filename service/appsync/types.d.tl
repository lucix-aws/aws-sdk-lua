-- (with appropriate backoff logic) is the recommended response to this exception.
local record ConflictException
    message: string
end

-- An internal AppSync error occurred. Try your request again.
local record InternalFailureException
    message: string
end

-- The resource specified in the request was not found. Check the resource, and then try
-- again.
local record NotFoundException
    message: string
end

-- The operation exceeded the service quota for this resource.
local record ServiceQuotaExceededException
    message: string
end

-- You aren't authorized to perform this operation.
local record UnauthorizedException
    message: string
end

