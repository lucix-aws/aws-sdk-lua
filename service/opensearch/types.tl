        message: string
    end

    -- Request processing failed because of an unknown error, exception, or internal failure.
    record InternalException
        -- A description of the error.
        message: string
    end

    -- An exception for accessing or deleting a resource that doesn't exist.
    record ValidationException
        -- A description of the error.
        message: string
    end

    -- An error occurred because you don't have permissions to access the resource.
    record AccessDeniedException
        -- A description of the error.
        message: string
    end

    -- An error occurred because the client attempts to remove a resource that is currently in use.
    record ConflictException
        -- A description of the error.
        message: string
    end

    -- An exception for trying to create or access a sub-resource that's either invalid or not supported.
    record InvalidTypeException
        -- A description of the error.
        message: string
    end

    -- An exception for creating a resource that already exists.
    record ResourceAlreadyExistsException
        -- A description of the error.
        message: string
    end

    -- The request was denied due to request throttling. Reduce the frequency of your requests and try again.
    record ThrottlingException
        -- A description of the error.
        message: string
    end

    -- Request processing failed because you provided an invalid pagination token.
    record InvalidPaginationTokenException
        -- A description of the error.
        message: string
    end

    -- An exception for when a request would cause a service quota to be exceeded.
    record ServiceQuotaExceededException
        -- A description of the error.
        message: string
    end

    -- An exception for attempting to schedule a domain action during an unavailable time slot.
    record SlotNotAvailableException
        -- Alternate time slots during which OpenSearch Service has available capacity to schedule a domain action.
        SlotSuggestions: {number}
        -- A description of the error.
        message: string
    end

