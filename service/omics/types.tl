    -- You do not have sufficient access to perform this action.
    record AccessDeniedException
        message: string
    end

    -- An unexpected error occurred. Try the request again.
    record InternalServerException
        message: string
    end

    -- The operation is not supported by Amazon Omics, or the API does not exist.
    record NotSupportedOperationException
        message: string
    end

    -- The request timed out.
    record RequestTimeoutException
        message: string
    end

    -- The target resource was not found in the current Region.
    record ResourceNotFoundException
        message: string
    end

    -- The request exceeds a service quota.
    record ServiceQuotaExceededException
        message: string
    end

    -- The request was denied due to request throttling.
    record ThrottlingException
        message: string
    end

    -- The input fails to satisfy the constraints specified by an AWS service.
    record ValidationException
        message: string
    end

    -- The request cannot be applied to the target resource in its current state.
    record ConflictException
        message: string
    end

    -- The ranges specified in the request are not valid.
    record RangeNotSatisfiableException
        message: string
    end

    enum StoreType
        "SEQUENCE_STORE"
        "REFERENCE_STORE"
    end

end

return M
