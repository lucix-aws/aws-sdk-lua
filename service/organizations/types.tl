    -- The policy is attached to one or more entities. You must detach it from all roots,
    -- OUs, and accounts before performing this operation.
    record PolicyInUseException
        Message: string
    end

    -- We can't find a resource policy request with the parameter that you specified.
    record ResourcePolicyNotFoundException
        Message: string
    end

    -- The specified account is not a delegated administrator for this Amazon Web Services service.
    record AccountNotRegisteredException
        Message: string
    end

    -- We can't find an create account request with the CreateAccountRequestId
    -- that you specified.
    record CreateAccountStatusNotFoundException
        Message: string
    end

    -- If you ran this action on the management account, this policy type is not enabled. If
    -- you ran the action on a member account, the account doesn't have an effective policy of
    -- this type. Contact the administrator of your organization about attaching a policy of
    -- this type to the account.
    record EffectivePolicyNotFoundException
        Message: string
    end

    -- We can't find a transfer that you specified.
    record ResponsibilityTransferNotFoundException
        Message: string
    end

    -- The policy isn't attached to the specified target in the specified root.
    record PolicyNotAttachedException
        Message: string
    end

    -- We can't find a root with the RootId that you specified.
    record RootNotFoundException
        Message: string
    end

    -- The specified policy type is already enabled in the specified root.
    record PolicyTypeAlreadyEnabledException
        Message: string
    end

    -- You can't invite an existing account to your organization until you verify that you
    -- own the email address associated with the management account. For more information, see
    -- Email address
    -- verification in the Organizations User Guide.
    record AccountOwnerNotVerifiedException
        Message: string
    end

    -- A handshake with the same action and target already exists. For example, if you
    -- invited an account to join your organization, the invited account might already have a
    -- pending invitation from this organization. If you intend to resend an invitation to an
    -- account, ensure that existing handshakes that might be considered duplicates are
    -- canceled or declined.
    record DuplicateHandshakeException
        Message: string
    end

    -- We can't find an organizational unit (OU) or Amazon Web Services account with the
    -- ChildId that you specified.
    record ChildNotFoundException
        Message: string
    end

    -- We can't find the destination container (a root or OU) with the ParentId
    -- that you specified.
    record DestinationParentNotFoundException
        Message: string
    end

    -- That account is already present in the specified destination.
    record DuplicateAccountException
        Message: string
    end

    -- We can't find a source root or OU with the ParentId that you
    -- specified.
    record SourceParentNotFoundException
        Message: string
    end

    -- The specified account is already a delegated administrator for this Amazon Web Services
    -- service.
    record AccountAlreadyRegisteredException
        Message: string
    end

    -- The responsibility transfer can't transition to the requested state because it's not
    -- in a valid state for this operation.
    record InvalidResponsibilityTransferTransitionException
        Message: string
    end

    -- The responsibility transfer is already in the status that you specified.
    record ResponsibilityTransferAlreadyInStatusException
        Message: string
    end

    enum ChildType
        "ACCOUNT"
        "ORGANIZATIONAL_UNIT"
    end

    enum EffectivePolicyType
        "TAG_POLICY"
        "BACKUP_POLICY"
        "AISERVICES_OPT_OUT_POLICY"
        "CHATBOT_POLICY"
        "DECLARATIVE_POLICY_EC2"
        "SECURITYHUB_POLICY"
        "INSPECTOR_POLICY"
        "UPGRADE_ROLLOUT_POLICY"
        "BEDROCK_POLICY"
        "S3_POLICY"
        "NETWORK_SECURITY_DIRECTOR_POLICY"
    end

    enum IAMUserAccessToBilling
        "ALLOW"
        "DENY"
    end

    enum OrganizationFeatureSet
        "ALL"
        "CONSOLIDATED_BILLING"
    end

    enum PolicyType
        "SERVICE_CONTROL_POLICY"
        "RESOURCE_CONTROL_POLICY"
        "TAG_POLICY"
        "BACKUP_POLICY"
        "AISERVICES_OPT_OUT_POLICY"
        "CHATBOT_POLICY"
        "DECLARATIVE_POLICY_EC2"
        "SECURITYHUB_POLICY"
        "INSPECTOR_POLICY"
        "UPGRADE_ROLLOUT_POLICY"
        "BEDROCK_POLICY"
        "S3_POLICY"
        "NETWORK_SECURITY_DIRECTOR_POLICY"
    end

    enum ResponsibilityTransferType
        "BILLING"
    end

end

return M
