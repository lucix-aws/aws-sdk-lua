    -- logicalStackName
    -- resourceGroupName
    -- terraformSourceName
    -- eksSourceName
    -- Each logicalResourceIds object includes the following fields:
    -- identifier
    -- Identifier of the resource.
    -- Type: String
    -- logicalStackName
    -- The name of the CloudFormation stack this resource belongs to.
