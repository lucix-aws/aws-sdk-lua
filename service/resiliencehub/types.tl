        "Failed"
        "Success"
    end

    enum RecommendationTemplateStatus
        "Pending"
        "InProgress"
        "Failed"
        "Success"
    end

    enum ResiliencyPolicyTier
        "MissionCritical"
        "Critical"
        "Important"
        "CoreServices"
        "NonCritical"
        "NotApplicable"
    end

    enum ResourceImportStatusType
        "Pending"
        "InProgress"
        "Failed"
        "Success"
    end

    enum ResourceImportStrategyType
        "AddOnly"
        "ReplaceAll"
    end

    enum ResourceResolutionStatusType
        "Pending"
        "InProgress"
        "Failed"
        "Success"
    end

    enum ResourcesGroupingRecGenStatusType
        "Pending"
        "InProgress"
        "Failed"
        "Success"
    end

    enum TemplateFormat
        "CfnYaml"
        "CfnJson"
    end

