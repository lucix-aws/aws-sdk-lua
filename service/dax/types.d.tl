-- The requested DAX cluster is not in the
-- available state.
local record InvalidClusterStateFault
    message: string
end

-- Two or more incompatible parameters were specified.
local record InvalidParameterCombinationException
    message: string
end

-- One or more parameters in a parameter group are in an invalid state.
local record InvalidParameterGroupStateFault
    message: string
end

-- The value for a parameter is invalid.
local record InvalidParameterValueException
    message: string
end

-- The specified parameter group does not exist.
local record ParameterGroupNotFoundFault
    message: string
end

-- The specified service linked role (SLR) was not found.
local record ServiceLinkedRoleNotFoundFault
    message: string
end

-- Two or more incompatible parameters were specified.
local record InvalidParameterCombinationException
    message: string
end

-- One or more parameters in a parameter group are in an invalid state.
local record InvalidParameterGroupStateFault
    message: string
end

-- The value for a parameter is invalid.
local record InvalidParameterValueException
    message: string
end

-- The specified parameter group does not exist.
local record ParameterGroupNotFoundFault
    message: string
end

-- The specified service linked role (SLR) was not found.
local record ServiceLinkedRoleNotFoundFault
    message: string
end

-- An invalid subnet identifier was specified.
local record InvalidSubnet
    message: string
end

-- The specified service linked role (SLR) was not found.
local record ServiceLinkedRoleNotFoundFault
    message: string
end

-- The requested subnet group name does not refer to an existing subnet
-- group.
local record SubnetGroupNotFoundFault
    message: string
end

-- The requested subnet is being used by another subnet group.
local record SubnetInUse
    message: string
end

-- The specified subnet can't be used for the requested network type. This error
-- occurs when either there aren't enough subnets of the required network type to create
-- the cluster, or when you try to use a subnet that doesn't support the requested network
-- type (for example, trying to create a dual-stack cluster with a subnet that doesn't have
-- IPv6 CIDR).
local record SubnetNotAllowedFault
    message: string
end

-- The request cannot be processed because it would exceed the allowed number of
-- subnets in a subnet group.
local record SubnetQuotaExceededFault
    message: string
end

local type ClusterEndpointEncryptionType = "NONE" | "TLS"

local type NetworkType = "ipv4" | "ipv6" | "dual_stack"

local type SourceType = "CLUSTER" | "PARAMETER_GROUP" | "SUBNET_GROUP"

local record M
    CreateClusterInput: CreateClusterInput
    CreateClusterOutput: CreateClusterOutput
    CreateParameterGroupInput: CreateParameterGroupInput
    CreateParameterGroupOutput: CreateParameterGroupOutput
    CreateSubnetGroupInput: CreateSubnetGroupInput
    CreateSubnetGroupOutput: CreateSubnetGroupOutput
