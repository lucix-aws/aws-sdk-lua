        -- The instance's package name.
        PackageName: string
        -- The instance's package version.
        PackageVersion: string
        -- The instance's package patch version.
        PackagePatchVersion: string
        -- The instance's name.
        NodeName: string
        -- The instance's current status.
        CurrentStatus: string
    end

    record ListApplicationInstanceNodeInstancesOutput
        -- A list of node instances.
        NodeInstances: {NodeInstance}
        -- A pagination token that's included if more results are available.
        NextToken: string
    end

    enum StatusFilter
        "DEPLOYMENT_SUCCEEDED"
        "DEPLOYMENT_ERROR"
        "REMOVAL_SUCCEEDED"
        "REMOVAL_FAILED"
        "PROCESSING_DEPLOYMENT"
        "PROCESSING_REMOVAL"
        "DEPLOYMENT_FAILED"
    end

    record ListApplicationInstancesInput
        -- The application instances' device ID.
        DeviceId: string
        -- Only include instances with a specific status.
        StatusFilter: string
        -- The maximum number of application instances to return in one page of results.
        MaxResults: number
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        NextToken: string
    end

    record ListApplicationInstancesOutput
        -- A list of application instances.
        ApplicationInstances: {ApplicationInstance}
        -- A pagination token that's included if more results are available.
        NextToken: string
    end

    enum ListDevicesSortBy
        "DEVICE_ID"
        "CREATED_TIME"
        "NAME"
        "DEVICE_AGGREGATED_STATUS"
    end

    enum SortOrder
        "ASCENDING"
        "DESCENDING"
    end

    record ListDevicesInput
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        NextToken: string
        -- The maximum number of devices to return in one page of results.
        MaxResults: number
        -- The target column to be sorted on. Default column sort is CREATED_TIME.
        SortBy: string
        -- The sorting order for the returned list. SortOrder is DESCENDING by default based on CREATED_TIME. Otherwise, SortOrder is ASCENDING.
        SortOrder: string
        -- Filter based on device's name. Prefixes supported.
        NameFilter: string
        -- Filter based on a device's status.
        DeviceAggregatedStatusFilter: string
    end

    record ListDevicesOutput
        -- A list of devices.
        Devices: {Device}
        -- A pagination token that's included if more results are available.
        NextToken: string
    end

    record ListDevicesJobsInput
        -- Filter results by the job's target device ID.
        DeviceId: string
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        NextToken: string
        -- The maximum number of device jobs to return in one page of results.
        MaxResults: number
    end

    record ListDevicesJobsOutput
        -- A list of jobs.
        DeviceJobs: {DeviceJob}
        -- A pagination token that's included if more results are available.
        NextToken: string
    end

    record ListNodeFromTemplateJobsInput
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        NextToken: string
        -- The maximum number of node from template jobs to return in one page of results.
        MaxResults: number
    end

    -- A job to create a camera stream node.
    record NodeFromTemplateJob
        -- The job's ID.
        JobId: string
        -- The job's template type.
        TemplateType: string
        -- The job's status.
        Status: string
        -- The job's status message.
        StatusMessage: string
        -- When the job was created.
        CreatedTime: number
        -- The node's name.
        NodeName: string
    end

    record ListNodeFromTemplateJobsOutput
        -- A list of jobs.
        NodeFromTemplateJobs: {NodeFromTemplateJob}
        -- A pagination token that's included if more results are available.
        NextToken: string
    end

    record ListNodesInput
        -- Search for nodes by category.
        Category: string
        -- Search for nodes by the account ID of the nodes' owner.
        OwnerAccount: string
        -- Search for nodes by name.
        PackageName: string
        -- Search for nodes by version.
        PackageVersion: string
        -- Search for nodes by patch version.
        PatchVersion: string
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        NextToken: string
        -- The maximum number of nodes to return in one page of results.
        MaxResults: number
    end

    -- An application node that represents a camera stream, a model, code, or output.
    record Node
        -- The node's ID.
        NodeId: string
        -- The node's name.
        Name: string
        -- The node's category.
        Category: string
        -- The account ID of the node's owner.
        OwnerAccount: string
        -- The node's package name.
        PackageName: string
        -- The node's package ID.
        PackageId: string
        -- The node's ARN.
        PackageArn: string
        -- The node's package version.
        PackageVersion: string
        -- The node's patch version.
        PatchVersion: string
        -- The node's description.
        Description: string
        -- When the node was created.
        CreatedTime: number
    end

    record ListNodesOutput
        -- A list of nodes.
        Nodes: {Node}
        -- A pagination token that's included if more results are available.
        NextToken: string
    end

    record ListPackageImportJobsInput
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        NextToken: string
        -- The maximum number of package import jobs to return in one page of results.
        MaxResults: number
    end

    -- A job to import a package version.
    record PackageImportJob
        -- The job's ID.
        JobId: string
        -- The job's type.
        JobType: string
        -- The job's status.
        Status: string
        -- The job's status message.
        StatusMessage: string
        -- When the job was created.
        CreatedTime: number
        -- When the job was updated.
        LastUpdatedTime: number
    end

    record ListPackageImportJobsOutput
        -- A list of package import jobs.
        PackageImportJobs: {PackageImportJob}
        -- A pagination token that's included if more results are available.
        NextToken: string
    end

    record ListPackagesInput
        -- The maximum number of packages to return in one page of results.
        MaxResults: number
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        NextToken: string
    end

    -- A package summary.
    record PackageListItem
        -- The package's ID.
        PackageId: string
        -- The package's name.
        PackageName: string
        -- The package's ARN.
        Arn: string
        -- When the package was created.
        CreatedTime: number
        -- The package's tags.
        Tags: {string : string}
    end

    record ListPackagesOutput
        -- A list of packages.
        Packages: {PackageListItem}
        -- A pagination token that's included if more results are available.
        NextToken: string
    end

    record ListTagsForResourceInput
        -- The resource's ARN.
        ResourceArn: string
    end

    record ListTagsForResourceOutput
        -- A list of tags.
        Tags: {string : string}
    end

    enum NodeSignalValue
        "PAUSE"
        "RESUME"
    end

    -- A signal to a camera node to start or stop processing video.
    record NodeSignal
        -- The camera node's name, from the application manifest.
        NodeInstanceId: string
        -- The signal value.
        Signal: string
    end

    record ProvisionDeviceInput
        -- A name for the device.
        Name: string
        -- A description for the device.
        Description: string
        -- Tags for the device.
        Tags: {string : string}
        -- A networking configuration for the device.
        NetworkingConfiguration: NetworkPayload
    end

    record ProvisionDeviceOutput
        -- The device's ID.
        DeviceId: string
        -- The device's ARN.
        Arn: string
        -- The device's status.
        Status: string
        -- The device's configuration bundle.
        Certificates: string
        -- The device's IoT thing name.
        IotThingName: string
    end

    record RegisterPackageVersionInput
        -- An owner account.
        OwnerAccount: string
        -- A package ID.
        PackageId: string
        -- A package version.
        PackageVersion: string
        -- A patch version.
        PatchVersion: string
        -- Whether to mark the new version as the latest version.
        MarkLatest: boolean
    end

    record RegisterPackageVersionOutput
    end

    record RemoveApplicationInstanceInput
        -- An application instance ID.
        ApplicationInstanceId: string
    end

    record RemoveApplicationInstanceOutput
    end

    record SignalApplicationInstanceNodeInstancesInput
        -- An application instance ID.
        ApplicationInstanceId: string
        -- A list of signals.
        NodeSignals: {NodeSignal}
    end

    record SignalApplicationInstanceNodeInstancesOutput
        -- An application instance ID.
        ApplicationInstanceId: string
    end

    record TagResourceInput
        -- The resource's ARN.
        ResourceArn: string
        -- Tags for the resource.
        Tags: {string : string}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The resource's ARN.
        ResourceArn: string
        -- Tag keys to remove.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateDeviceMetadataInput
        -- The device's ID.
        DeviceId: string
        -- A description for the device.
        Description: string
    end

    record UpdateDeviceMetadataOutput
        -- The device's ID.
        DeviceId: string
    end

end

return M
