        "BINARY"
        "MULTICLASS"
    end

    enum SortOrder
        "asc"
        "dsc"
    end

    enum TaggableResourceType
        "BatchPrediction"
        "DataSource"
        "Evaluation"
        "MLModel"
    end

end

return M
