    -- The effect of the rule when it matches. Allowed values are ALLOW or DENY.
    Effect: string
    -- Device types that the updated rule will match.
    DeviceTypes: {string}
    -- Device types that the updated rule will not match. All other device types will match.
    NotDeviceTypes: {string}
    -- Device models that the updated rule will match.
    DeviceModels: {string}
    -- Device models that the updated rule will not match. All other device models will match.
    NotDeviceModels: {string}
    -- Device operating systems that the updated rule will match.
    DeviceOperatingSystems: {string}
    -- Device operating systems that the updated rule will not match. All other device operating systems will match.
    NotDeviceOperatingSystems: {string}
    -- User agents that the updated rule will match.
    DeviceUserAgents: {string}
    -- User agents that the updated rule will not match. All other user agents will match.
    NotDeviceUserAgents: {string}
end

local record UpdateMobileDeviceAccessRuleOutput
end

local record UpdatePrimaryEmailAddressInput
    -- The organization that contains the user, group, or resource to update.
    OrganizationId: string
    -- The user, group, or resource to update.
    -- The identifier can accept UseriD, ResourceId, or GroupId, Username, Resourcename, or Groupname, or email. The following identity formats are available:
    -- Entity ID: 12345678-1234-1234-1234-123456789012, r-0123456789a0123456789b0123456789, or S-1-1-12-1234567890-123456789-123456789-1234
    -- Email address: entity@domain.tld
    -- Entity name: entity
    EntityId: string
    -- The value of the email to be updated as primary.
    Email: string
end

local record UpdatePrimaryEmailAddressOutput
end

local record UpdateResourceInput
    -- The identifier associated with the organization for which the resource is
    -- updated.
    OrganizationId: string
    -- The identifier of the resource to be updated.
    -- The identifier can accept ResourceId, Resourcename, or email. The following identity formats are available:
    -- Resource ID: r-0123456789a0123456789b0123456789
    -- Email address: resource@domain.tld
    -- Resource name: resource
    ResourceId: string
    -- The name of the resource to be updated.
    Name: string
    -- The resource's booking options to be updated.
    BookingOptions: BookingOptions
    -- Updates the resource description.
    Description: string
    -- Updates the resource type.
    Type: string
    -- If enabled, the resource is hidden from the global address list.
    HiddenFromGlobalAddressList: boolean
end

local record UpdateResourceOutput
end

local record UpdateUserInput
    -- The identifier for the organization under which the user exists.
    OrganizationId: string
    -- The identifier for the user to be updated.
    -- The identifier can be the UserId, Username, or email. The following identity formats are available:
    -- User ID: 12345678-1234-1234-1234-123456789012 or S-1-1-12-1234567890-123456789-123456789-1234
    -- Email address: user@domain.tld
    -- User name: user
    UserId: string
    -- Updates the user role.
    -- You cannot pass SYSTEM_USER or RESOURCE.
    Role: string
    -- Updates the display name of the user.
    DisplayName: string
    -- Updates the user's first name.
    FirstName: string
    -- Updates the user's last name.
    LastName: string
    -- If enabled, the user is hidden from the global address list.
    HiddenFromGlobalAddressList: boolean
    -- Updates the user's initials.
    Initials: string
    -- Updates the user's contact details.
    Telephone: string
    -- Updates the user's street address.
    Street: string
    -- Updates the user's job title.
    JobTitle: string
    -- Updates the user's city.
    City: string
    -- Updates the user's company.
    Company: string
    -- Updates the user's zip code.
    ZipCode: string
    -- Updates the user's department.
    Department: string
    -- Updates the user's country.
    Country: string
    -- Updates the user's office.
    Office: string
    -- User ID from the IAM Identity Center. If this parameter is empty it will be updated automatically when the user logs in for the first time to the mailbox associated with WorkMail.
    IdentityProviderUserId: string
end

local record UpdateUserOutput
end

