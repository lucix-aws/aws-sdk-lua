    -- USAGE_TYPE
    -- USAGE_TYPE_GROUP
    -- RECORD_TYPE
    -- OPERATING_SYSTEM
    -- TENANCY
    -- SCOPE
    -- PLATFORM
    -- SUBSCRIPTION_ID
    -- LEGAL_ENTITY_NAME
    -- DEPLOYMENT_OPTION
    -- DATABASE_ENGINE
    -- INSTANCE_TYPE_FAMILY
    -- BILLING_ENTITY
    -- RESERVATION_ID
    -- SAVINGS_PLAN_ARN
