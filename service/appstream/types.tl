        Stack: Stack
    end

    record UpdateThemeForStackInput
        -- The name of the stack for the theme.
        StackName: string
        -- The links that are displayed in the footer of the streaming application catalog page. These links are helpful resources for users, such as the organization's IT support and product marketing sites.
        FooterLinks: {ThemeFooterLink}
        -- The title that is displayed at the top of the browser tab during users' application streaming sessions.
        TitleText: string
        -- The color theme that is applied to website links, text, and buttons. These colors are also applied as accents in the background for the streaming application catalog page.
        ThemeStyling: string
        -- The organization logo that appears on the streaming application catalog page.
        OrganizationLogoS3Location: S3Location
        -- The S3 location of the favicon. The favicon enables users to recognize their application streaming site in a browser full of tabs or bookmarks. It is displayed at the top of the browser tab for the application streaming site during users' streaming sessions.
        FaviconS3Location: S3Location
        -- Specifies whether custom branding should be applied to catalog page or not.
        State: string
        -- The attributes to delete.
        AttributesToDelete: {string}
    end

    record UpdateThemeForStackOutput
        -- The theme object that contains the metadata of the custom branding.
        Theme: Theme
    end

    -- An API error occurred. Wait a few minutes and try again.
    record ConcurrentModificationException
        Message: string
    end

    -- Indicates an incorrect combination of parameters, or a missing parameter.
    record InvalidParameterCombinationException
        Message: string
    end

    -- The requested limit exceeds the permitted limit for an account.
    record LimitExceededException
        Message: string
    end

    -- The attempted operation is not permitted.
    record OperationNotPermittedException
        Message: string
    end

    -- The specified resource was not found.
    record ResourceNotFoundException
        Message: string
    end

    -- The entitlement can't be found.
    record EntitlementNotFoundException
        Message: string
    end

    -- The image can't be updated because it's not compatible for updates.
    record IncompatibleImageException
        Message: string
    end

    -- The resource cannot be created because your AWS account is suspended. For assistance, contact AWS Support.
    record InvalidAccountStatusException
        Message: string
    end

    -- The specified resource already exists.
    record ResourceAlreadyExistsException
        Message: string
    end

    -- The specified resource exists and is not in use, but isn't available.
    record ResourceNotAvailableException
        Message: string
    end

    -- The specified role is invalid.
    record InvalidRoleException
        Message: string
    end

    -- WorkSpaces Applications can’t process the request right now because the Describe calls from your AWS account are being throttled by Amazon EC2. Try again later.
    record RequestLimitExceededException
        Message: string
    end

    -- The entitlement already exists.
    record EntitlementAlreadyExistsException
        Message: string
    end

    -- The exception that is thrown when a dry run operation is requested. This indicates that the validation checks have been performed successfully, but no actual resources were created or modified.
    record DryRunOperationException
        Message: string
    end

    -- The specified resource is in use.
    record ResourceInUseException
        Message: string
    end

    enum AgentSoftwareVersion
        "CURRENT_LATEST"
        "ALWAYS_LATEST"
    end

