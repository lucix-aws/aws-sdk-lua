    -- Indicates that something is wrong with a parameter's value. For example, the value is
    -- out of range.
    record InvalidParameterValueException
        Code: string
        Message: string
        Type: string
        Context: string
    end

    -- Indicates that something is wrong with the input to the request. For example, a
    -- parameter is of the wrong type.
    record InvalidRequestException
        Code: string
        Message: string
        Type: string
        Context: string
    end

    -- Indicates that a required parameter is missing.
    record MissingParameterValueException
        Code: string
        Message: string
        Type: string
        Context: string
    end

    -- A resource that is required for the action doesn't exist.
    record ResourceNotFoundException
        Code: string
        Message: string
        Type: string
        Context: string
    end

    -- The request failed due to a temporary failure of the server.
    record ServiceUnavailableException
        Code: string
        Message: string
        Type: string
        Context: string
    end

    -- Backup is already performing an action on this recovery point. It can't
    -- perform the action you requested until the first action finishes. Try again later.
    record InvalidResourceStateException
        Code: string
        Message: string
        Type: string
        Context: string
    end

    -- The required resource already exists.
    record AlreadyExistsException
        Code: string
        Message: string
        CreatorRequestId: string
        Arn: string
        Type: string
        Context: string
    end

    -- A limit in the request has been exceeded; for example, a maximum number of items allowed
    -- in a request.
    record LimitExceededException
        Code: string
        Message: string
        Type: string
        Context: string
    end

    -- Backup can't perform the action that you requested until it finishes
    -- performing a previous action. Try again later.
    record ConflictException
        Code: string
        Message: string
        Type: string
        Context: string
    end

    -- A dependent Amazon Web Services service or resource returned an error to the Backup service, and the action cannot be completed.
    record DependencyFailureException
        Code: string
        Message: string
        Type: string
        Context: string
    end

