    record StartScanJobInput
        -- The name of a logical container where backups are stored. Backup vaults are identified by names that
        -- are unique to the account used to create them and the Amazon Web Services Region where they are created.
        -- Pattern: ^[a-zA-Z0-9\-\_]{2,50}$
