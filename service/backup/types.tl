        -- CloudFormation - CloudFormation
        -- DynamoDB - Amazon DynamoDB
        -- EBS - Amazon Elastic Block Store
        -- EC2 - Amazon Elastic Compute Cloud
        -- EFS - Amazon Elastic File System
        -- EKS - Amazon Elastic Kubernetes Service
        -- FSx - Amazon FSx
