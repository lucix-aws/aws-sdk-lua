        -- A conflict occurred with the current state of the resource.
        conflictException: ConflictException
        -- A dependency failed during the operation.
        dependencyFailedException: DependencyFailedException
        -- A bad gateway error occurred.
        badGatewayException: BadGatewayException
    end

    -- Response structure for the agentic retrieve stream operation.
    record AgenticRetrieveStreamOutput
        -- The output stream containing retrieval results and trace events.
        stream: function(): string, string
    end

    -- Details about a caller.
    record Caller
        -- The caller's agent alias ARN.
        agentAliasArn: string
    end

    -- The event in the custom orchestration sequence. Events are the responses which the custom orchestration Lambda function sends as response to the agent.
    record CustomOrchestrationTraceEvent
        -- The text that prompted the event at this step.
        text: string
    end

    -- The trace behavior for the custom orchestration.
    record CustomOrchestrationTrace
        -- The unique identifier of the trace.
        traceId: string
        -- The event details used with the custom orchestration.
        event: CustomOrchestrationTraceEvent
    end

    -- Contains information about the failure of the interaction.
    record FailureTrace
        -- The unique identifier of the trace.
        traceId: string
        -- The reason the interaction failed.
        failureReason: string
        -- The failure code for the trace.
        failureCode: number
        -- Information about the failure that occurred.
        metadata: Metadata
    end

    enum GuardrailContentPolicyAction
        "BLOCKED"
    end

    enum GuardrailContentFilterConfidence
        "NONE"
        "LOW"
        "MEDIUM"
        "HIGH"
    end

    enum GuardrailContentFilterType
        "INSULTS"
        "HATE"
        "SEXUAL"
        "VIOLENCE"
        "MISCONDUCT"
        "PROMPT_ATTACK"
    end

    -- Details of the content filter used in the Guardrail.
    record GuardrailContentFilter
        -- The confidence level regarding the content detected in the filter by the Guardrail.
        confidence: string
        -- The action placed on the content by the Guardrail filter.
        action: string
    end

    -- The details of the policy assessment in the Guardrails filter.
    record GuardrailContentPolicyAssessment
        -- The filter details of the policy assessment used in the Guardrails filter.
        filters: {GuardrailContentFilter}
    end

    enum GuardrailSensitiveInformationPolicyAction
        "BLOCKED"
        "ANONYMIZED"
    end

    enum GuardrailPiiEntityType
        "ADDRESS"
        "AGE"
        "AWS_ACCESS_KEY"
        "AWS_SECRET_KEY"
        "CA_HEALTH_NUMBER"
        "CA_SOCIAL_INSURANCE_NUMBER"
        "CREDIT_DEBIT_CARD_CVV"
        "CREDIT_DEBIT_CARD_EXPIRY"
        "CREDIT_DEBIT_CARD_NUMBER"
        "DRIVER_ID"
        "EMAIL"
        "INTERNATIONAL_BANK_ACCOUNT_NUMBER"
        "IP_ADDRESS"
        "LICENSE_PLATE"
        "MAC_ADDRESS"
        "NAME"
        "PASSWORD"
        "PHONE"
        "PIN"
        "SWIFT_CODE"
        "UK_NATIONAL_HEALTH_SERVICE_NUMBER"
        "UK_NATIONAL_INSURANCE_NUMBER"
        "UK_UNIQUE_TAXPAYER_REFERENCE_NUMBER"
        "URL"
        "USERNAME"
        "US_BANK_ACCOUNT_NUMBER"
        "US_BANK_ROUTING_NUMBER"
        "US_INDIVIDUAL_TAX_IDENTIFICATION_NUMBER"
        "US_PASSPORT_NUMBER"
        "US_SOCIAL_SECURITY_NUMBER"
        "VEHICLE_IDENTIFICATION_NUMBER"
    end

    -- The Guardrail filter to identify and remove personally identifiable information (PII).
    record GuardrailPiiEntityFilter
        -- The match to settings in the Guardrail filter to identify and remove PII.
        match: string
        -- The action of the Guardrail filter to identify and remove PII.
        action: string
    end

    -- The details for the regex filter used in the Guardrail.
    record GuardrailRegexFilter
        -- The name details for the regex filter used in the Guardrail.
        name: string
        -- The regex details for the regex filter used in the Guardrail.
        regex: string
        -- The match details for the regex filter used in the Guardrail.
        match: string
        -- The action details for the regex filter used in the Guardrail.
        action: string
    end

    -- The details of the sensitive policy assessment used in the Guardrail.
    record GuardrailSensitiveInformationPolicyAssessment
        -- The details of the PII entities used in the sensitive policy assessment for the Guardrail.
        piiEntities: {GuardrailPiiEntityFilter}
        -- The details of the regexes used in the sensitive policy assessment for the Guardrail.
        regexes: {GuardrailRegexFilter}
    end

    enum GuardrailTopicPolicyAction
        "BLOCKED"
    end

    enum GuardrailTopicType
        "DENY"
    end

    -- The details for a specific topic defined in the Guardrail.
    record GuardrailTopic
        -- The name details on a specific topic in the Guardrail.
        name: string
        -- The action details on a specific topic in the Guardrail.
        action: string
    end

    -- The details of the policy assessment used in the Guardrail.
    record GuardrailTopicPolicyAssessment
        -- The topic details of the policy assessment used in the Guardrail.
        topics: {GuardrailTopic}
    end

    enum GuardrailWordPolicyAction
        "BLOCKED"
    end

    -- The custom word details for the filter in the Guardrail.
    record GuardrailCustomWord
        -- The match details for the custom word filter in the Guardrail.
        match: string
        -- The action details for the custom word filter in the Guardrail.
        action: string
    end

    enum GuardrailManagedWordType
        "PROFANITY"
    end

    -- The managed word details for the filter in the Guardrail.
    record GuardrailManagedWord
        -- The match details for the managed word filter in the Guardrail.
        match: string
        -- The action details for the managed word filter in the Guardrail.
        action: string
    end

    -- The assessment details for words defined in the Guardrail filter.
    record GuardrailWordPolicyAssessment
        -- The custom word details for words defined in the Guardrail filter.
        customWords: {GuardrailCustomWord}
        -- The managed word lists for words defined in the Guardrail filter.
        managedWordLists: {GuardrailManagedWord}
    end

    -- Assessment details of the content analyzed by Guardrails.
    record GuardrailAssessment
        -- Topic policy details of the Guardrail.
        topicPolicy: GuardrailTopicPolicyAssessment
        -- Content policy details of the Guardrail.
        contentPolicy: GuardrailContentPolicyAssessment
        -- Word policy details of the Guardrail.
        wordPolicy: GuardrailWordPolicyAssessment
        -- Sensitive Information policy details of Guardrail.
        sensitiveInformationPolicy: GuardrailSensitiveInformationPolicyAssessment
    end

    -- The trace details used in the Guardrail.
    record GuardrailTrace
        -- The trace action details used with the Guardrail.
        action: string
        -- The details of the trace Id used in the Guardrail Trace.
        traceId: string
        -- The details of the input assessments used in the Guardrail Trace.
        inputAssessments: {GuardrailAssessment}
        -- The details of the output assessments used in the Guardrail Trace.
        outputAssessments: {GuardrailAssessment}
        -- Contains information about the Guardrail output.
        metadata: Metadata
    end

    -- Contains information about the code interpreter being invoked.
    record CodeInterpreterInvocationInput
        -- The code for the code interpreter to use.
        code: string
        -- Files that are uploaded for code interpreter to use.
        files: {string}
    end

    enum InvocationType
        "ACTION_GROUP"
        "KNOWLEDGE_BASE"
        "FINISH"
        "ACTION_GROUP_CODE_INTERPRETER"
        "AGENT_COLLABORATOR"
    end

    -- Contains details about the knowledge base to look up and the query to be made.
    record KnowledgeBaseLookupInput
        -- The query made to the knowledge base.
        text: string
        -- The unique identifier of the knowledge base to look up.
        knowledgeBaseId: string
    end

    -- Contains information pertaining to the action group or knowledge base that is being invoked.
    record InvocationInput
        -- The unique identifier of the trace.
        traceId: string
        -- Specifies whether the agent is invoking an action group or a knowledge base.
        invocationType: string
        -- Contains information about the action group to be invoked.
        actionGroupInvocationInput: ActionGroupInvocationInput
        -- Contains details about the knowledge base to look up and the query to be made.
        knowledgeBaseLookupInput: KnowledgeBaseLookupInput
        -- Contains information about the code interpreter to be invoked.
        codeInterpreterInvocationInput: CodeInterpreterInvocationInput
        -- The collaborator's invocation input.
        agentCollaboratorInvocationInput: AgentCollaboratorInvocationInput
    end

    -- Specifications about the inference parameters that were provided alongside the prompt. These are specified in the PromptOverrideConfiguration object that was set when the agent was created or updated. For more information, see Inference parameters for foundation models.
    record InferenceConfiguration
        -- The likelihood of the model selecting higher-probability options while generating a response. A lower value makes the model more likely to choose higher-probability options, while a higher value makes the model more likely to choose lower-probability options.
        temperature: number
        -- While generating a response, the model determines the probability of the following token at each point of generation. The value that you set for Top P determines the number of most-likely candidates from which the model chooses the next token in the sequence. For example, if you set topP to 0.8, the model only selects the next token from the top 80% of the probability distribution of next tokens.
        topP: number
        -- While generating a response, the model determines the probability of the following token at each point of generation. The value that you set for topK is the number of most-likely candidates from which the model chooses the next token in the sequence. For example, if you set topK to 50, the model selects the next token from among the top 50 most likely choices.
        topK: number
        -- The maximum number of tokens allowed in the generated response.
        maximumLength: number
        -- A list of stop sequences. A stop sequence is a sequence of characters that causes the model to stop generating the response.
        stopSequences: {string}
    end

    enum CreationMode
        "DEFAULT"
        "OVERRIDDEN"
    end

    enum PromptType
        "PRE_PROCESSING"
        "ORCHESTRATION"
        "KNOWLEDGE_BASE_RESPONSE_GENERATION"
        "POST_PROCESSING"
        "ROUTING_CLASSIFIER"
    end

    -- The input for the pre-processing step. The type matches the agent step. The text contains the prompt. The inferenceConfiguration, parserMode, and overrideLambda values are set in the PromptOverrideConfiguration object that was set when the agent was created or updated.
    record ModelInvocationInput
        -- The unique identifier of the trace.
        traceId: string
        -- The text that prompted the agent at this step.
        text: string
        -- The ARN of the Lambda function to use when parsing the raw foundation model output in parts of the agent sequence.
        overrideLambda: string
        -- Specifies whether the default prompt template was OVERRIDDEN. If it was, the basePromptTemplate that was set in the PromptOverrideConfiguration object when the agent was created or updated is used instead.
        promptCreationMode: string
        -- Specifications about the inference parameters that were provided alongside the prompt. These are specified in the PromptOverrideConfiguration object that was set when the agent was created or updated. For more information, see Inference parameters for foundation models.
        inferenceConfiguration: InferenceConfiguration
        -- Specifies whether to override the default parser Lambda function when parsing the raw foundation model output in the part of the agent sequence defined by the promptType.
        parserMode: string
        -- The identifier of a foundation model.
        foundationModel: string
    end

    -- Contains the raw output from the foundation model.
    record RawResponse
        -- The foundation model's raw output content.
        content: string
    end

    -- Contains information about the reasoning that the model used to return the content in the content block.
    record ReasoningTextBlock
        -- Text describing the reasoning that the model used to return the content in the content block.
        text: string
        -- A hash of all the messages in the conversation to ensure that the content in the reasoning text block isn't tampered with. You must submit the signature in subsequent Converse requests, in addition to the previous messages. If the previous messages are tampered with, the response throws an error.
        signature: string
    end

    -- Contains content regarding the reasoning that the foundation model made with respect to the content in the content block. Reasoning refers to a Chain of Thought (CoT) that the model generates to enhance the accuracy of its final response.
    record ReasoningContentBlock
        -- Contains information about the reasoning that the model used to return the content in the content block.
        reasoningText: ReasoningTextBlock
        -- The content in the reasoning that was encrypted by the model provider for trust and safety reasons.
        redactedContent: string
    end

    -- The foundation model output from the orchestration step.
    record OrchestrationModelInvocationOutput
        -- The unique identifier of the trace.
        traceId: string
        -- Contains details of the raw response from the foundation model output.
        rawResponse: RawResponse
        -- Contains information about the foundation model output from the orchestration step.
        metadata: Metadata
        -- Contains content about the reasoning that the model made during the orchestration step.
        reasoningContent: ReasoningContentBlock
    end

    -- Contains the JSON-formatted string returned by the API invoked by the code interpreter.
    record CodeInterpreterInvocationOutput
        -- Contains the successful output returned from code execution
        executionOutput: string
        -- Contains the error returned from code execution.
        executionError: string
        -- Contains output files, if generated by code execution.
        files: {string}
        -- Indicates if the execution of the code timed out.
        executionTimeout: boolean
        -- Contains information about the output from the code interpreter.
        metadata: Metadata
    end

    -- Contains details about the response to the user.
    record FinalResponse
        -- The text in the response to the user.
        text: string
        -- Contains information about the invoke agent operation.
        metadata: Metadata
    end

    -- Contains information about an audio segment retrieved from a knowledge base, including its location and transcription. This data type is used in the following API operations: Retrieve response – in the audio field
    record AudioSegment
        -- The S3 URI where this specific audio segment is stored in the multimodal storage destination.
        s3Uri: string
        -- The text transcription of the audio segment content.
        transcription: string
    end

    enum RetrievalResultContentColumnType
        "BLOB"
        "BOOLEAN"
        "DOUBLE"
        "NULL"
        "LONG"
        "STRING"
    end

    -- Contains information about a column with a cell to return in retrieval.
    record RetrievalResultContentColumn
        -- The name of the column.
        columnName: string
        -- The value in the column.
        columnValue: string
    end

    enum RetrievalResultContentType
        "TEXT"
        "IMAGE"
        "ROW"
        "AUDIO"
        "VIDEO"
    end

    -- Contains information about a video segment retrieved from a knowledge base, including its location and summary. This data type is used in the following API operations: Retrieve response – in the video field
    record VideoSegment
        -- The S3 URI where this specific video segment is stored in the multimodal storage destination.
        s3Uri: string
        -- A text summary describing the content of the video segment.
        summary: string
    end

    -- Contains information about a chunk of text from a data source in the knowledge base. If the result is from a structured data source, the cell in the database and the type of the value is also identified. This data type is used in the following API operations: Retrieve response – in the content field RetrieveAndGenerate response – in the content field InvokeAgent response – in the content field
    record RetrievalResultContent
        -- The cited text from the data source.
        text: string
        -- A data URI with base64-encoded content from the data source. The URI is in the following format: returned in the following format: data:image/jpeg;base64,${base64-encoded string}.
        byteContent: string
        -- Video segment information when the retrieval result contains video content.
        video: VideoSegment
        -- Audio segment information when the retrieval result contains audio content.
        audio: AudioSegment
        -- Specifies information about the rows with the cells to return in retrieval.
        row: {RetrievalResultContentColumn}
    end

    -- The Confluence data source location.
    record RetrievalResultConfluenceLocation
        -- The Confluence host URL for the data source location.
        url: string
    end

    -- Contains information about the location of a document in a custom data source.
    record RetrievalResultCustomDocumentLocation
        -- The ID of the document.
        id: string
    end

    -- The Google Drive location of a retrieval result.
    record RetrievalResultGoogleDriveLocation
        -- The Google Drive URL for the data source location.
        url: string
    end

    -- The location of a result in Amazon Kendra.
    record RetrievalResultKendraDocumentLocation
        -- The document's uri.
        uri: string
    end

    -- The Microsoft OneDrive location of a retrieval result.
    record RetrievalResultOneDriveLocation
        -- The OneDrive URL for the data source location.
        url: string
    end

    -- The S3 data source location. This data type is used in the following API operations: Retrieve response – in the s3Location field RetrieveAndGenerate response – in the s3Location field InvokeAgent response – in the s3Location field
    record RetrievalResultS3Location
        -- The S3 URI for the data source location.
        uri: string
    end

    -- The Salesforce data source location.
    record RetrievalResultSalesforceLocation
        -- The Salesforce host URL for the data source location.
        url: string
    end

    -- The SharePoint data source location.
    record RetrievalResultSharePointLocation
        -- The SharePoint site URL for the data source location.
        url: string
    end

    -- Contains information about the SQL query used to retrieve the result.
    record RetrievalResultSqlLocation
        -- The SQL query used to retrieve the result.
        query: string
    end

    enum RetrievalResultLocationType
        "S3"
        "WEB"
        "CONFLUENCE"
        "SALESFORCE"
        "SHAREPOINT"
        "CUSTOM"
        "KENDRA"
        "SQL"
        "ONEDRIVE"
        "GOOGLEDRIVE"
    end

    -- The web URL/URLs data source location.
    record RetrievalResultWebLocation
        -- The web URL/URLs for the data source location.
        url: string
    end

    -- Contains information about the data source location. This data type is used in the following API operations: Retrieve response – in the location field RetrieveAndGenerate response – in the location field InvokeAgent response – in the location field
    record RetrievalResultLocation
        -- The S3 data source location.
        s3Location: RetrievalResultS3Location
        -- The web URL/URLs data source location.
        webLocation: RetrievalResultWebLocation
        -- The Confluence data source location.
        confluenceLocation: RetrievalResultConfluenceLocation
        -- The Salesforce data source location.
        salesforceLocation: RetrievalResultSalesforceLocation
        -- The SharePoint data source location.
        sharePointLocation: RetrievalResultSharePointLocation
        -- Specifies the location of a document in a custom data source.
        customDocumentLocation: RetrievalResultCustomDocumentLocation
        -- The location of a document in Amazon Kendra.
        kendraDocumentLocation: RetrievalResultKendraDocumentLocation
        -- Specifies information about the SQL query used to retrieve the result.
        sqlLocation: RetrievalResultSqlLocation
        -- The Microsoft OneDrive data source location.
        oneDriveLocation: RetrievalResultOneDriveLocation
        -- The Google Drive data source location.
        googleDriveLocation: RetrievalResultGoogleDriveLocation
    end

    -- Contains metadata about a source cited for the generated response. This data type is used in the following API operations: RetrieveAndGenerate response – in the retrievedReferences field InvokeAgent response – in the retrievedReferences field
    record RetrievedReference
        -- Contains the cited text from the data source.
        content: RetrievalResultContent
        -- Contains information about the location of the data source.
        location: RetrievalResultLocation
        -- Contains metadata attributes and their values for the file in the data source. For more information, see Metadata and filtering.
        metadata: {string : any}
    end

    -- Contains details about the results from looking up the knowledge base.
    record KnowledgeBaseLookupOutput
        -- Contains metadata about the sources cited for the generated response.
        retrievedReferences: {RetrievedReference}
        -- Contains information about the knowledge base output.
        metadata: Metadata
    end

    enum Source
        "ACTION_GROUP"
        "KNOWLEDGE_BASE"
        "PARSER"
    end

    -- Contains details about the agent's response to reprompt the input.
    record RepromptResponse
        -- The text reprompting the input.
        text: string
        -- Specifies what output is prompting the agent to reprompt the input.
        source: string
    end

    enum Type
        "ACTION_GROUP"
        "AGENT_COLLABORATOR"
        "KNOWLEDGE_BASE"
        "FINISH"
        "ASK_USER"
        "REPROMPT"
    end

    -- Contains the result or output of an action group or knowledge base, or the response to the user.
    record Observation
        -- The unique identifier of the trace.
        traceId: string
        -- Contains the JSON-formatted string returned by the API invoked by the action group.
        actionGroupInvocationOutput: ActionGroupInvocationOutput
        -- A collaborator's invocation output.
        agentCollaboratorInvocationOutput: AgentCollaboratorInvocationOutput
        -- Contains details about the results from looking up the knowledge base.
        knowledgeBaseLookupOutput: KnowledgeBaseLookupOutput
        -- Contains details about the response to the user.
        finalResponse: FinalResponse
        -- Contains details about the response to reprompt the input.
        repromptResponse: RepromptResponse
        -- Contains the JSON-formatted string returned by the API invoked by the code interpreter.
        codeInterpreterInvocationOutput: CodeInterpreterInvocationOutput
    end

    -- Contains the reasoning, based on the input, that the agent uses to justify carrying out an action group or getting information from a knowledge base.
    record Rationale
        -- The unique identifier of the trace step.
        traceId: string
        -- The reasoning or thought process of the agent, based on the input.
        text: string
    end

    -- Details about the orchestration step, in which the agent determines the order in which actions are executed and which knowledge bases are retrieved.
    record OrchestrationTrace
        -- Details about the reasoning, based on the input, that the agent uses to justify carrying out an action group or getting information from a knowledge base.
        rationale: Rationale
        -- Contains information pertaining to the action group or knowledge base that is being invoked.
        invocationInput: InvocationInput
        -- Details about the observation (the output of the action group Lambda or knowledge base) made by the agent.
        observation: Observation
        -- The input for the orchestration step. The type is ORCHESTRATION. The text contains the prompt. The inferenceConfiguration, parserMode, and overrideLambda values are set in the PromptOverrideConfiguration object that was set when the agent was created or updated.
        modelInvocationInput: ModelInvocationInput
        -- Contains information pertaining to the output from the foundation model that is being invoked.
        modelInvocationOutput: OrchestrationModelInvocationOutput
    end

    -- Details about the response from the Lambda parsing of the output from the post-processing step.
    record PostProcessingParsedResponse
        -- The text returned by the parser.
        text: string
    end

    -- The foundation model output from the post-processing step.
    record PostProcessingModelInvocationOutput
        -- The unique identifier of the trace.
        traceId: string
        -- Details about the response from the Lambda parsing of the output of the post-processing step.
        parsedResponse: PostProcessingParsedResponse
        -- Details of the raw response from the foundation model output.
        rawResponse: RawResponse
        -- Contains information about the foundation model output from the post-processing step.
        metadata: Metadata
        -- Contains content about the reasoning that the model made during the post-processing step.
        reasoningContent: ReasoningContentBlock
    end

    -- Details about the post-processing step, in which the agent shapes the response.
    record PostProcessingTrace
        -- The input for the post-processing step. The type is POST_PROCESSING. The text contains the prompt. The inferenceConfiguration, parserMode, and overrideLambda values are set in the PromptOverrideConfiguration object that was set when the agent was created or updated.
        modelInvocationInput: ModelInvocationInput
        -- The foundation model output from the post-processing step.
        modelInvocationOutput: PostProcessingModelInvocationOutput
    end

    -- Details about the response from the Lambda parsing of the output from the pre-processing step.
    record PreProcessingParsedResponse
        -- The text returned by the parsing of the pre-processing step, explaining the steps that the agent plans to take in orchestration, if the user input is valid.
        rationale: string
        -- Whether the user input is valid or not. If false, the agent doesn't proceed to orchestration.
        isValid: boolean
    end

    -- The foundation model output from the pre-processing step.
    record PreProcessingModelInvocationOutput
        -- The unique identifier of the trace.
        traceId: string
        -- Details about the response from the Lambda parsing of the output of the pre-processing step.
        parsedResponse: PreProcessingParsedResponse
        -- Details of the raw response from the foundation model output.
        rawResponse: RawResponse
        -- Contains information about the foundation model output from the pre-processing step.
        metadata: Metadata
        -- Contains content about the reasoning that the model made during the pre-processing step.
        reasoningContent: ReasoningContentBlock
    end

    -- Details about the pre-processing step, in which the agent contextualizes and categorizes user inputs.
    record PreProcessingTrace
        -- The input for the pre-processing step. The type is PRE_PROCESSING. The text contains the prompt. The inferenceConfiguration, parserMode, and overrideLambda values are set in the PromptOverrideConfiguration object that was set when the agent was created or updated.
        modelInvocationInput: ModelInvocationInput
        -- The foundation model output from the pre-processing step.
        modelInvocationOutput: PreProcessingModelInvocationOutput
    end

    -- Invocation output from a routing classifier model.
    record RoutingClassifierModelInvocationOutput
        -- The invocation's trace ID.
        traceId: string
        -- The invocation's raw response.
        rawResponse: RawResponse
        -- The invocation's metadata.
        metadata: Metadata
    end

    -- A trace for a routing classifier.
    record RoutingClassifierTrace
        -- The classifier's invocation input.
        invocationInput: InvocationInput
        -- The classifier's observation.
        observation: Observation
        -- The classifier's model invocation input.
        modelInvocationInput: ModelInvocationInput
        -- The classifier's model invocation output.
        modelInvocationOutput: RoutingClassifierModelInvocationOutput
    end

    -- Contains one part of the agent's reasoning process and results from calling API actions and querying knowledge bases. You can use the trace to understand how the agent arrived at the response it provided the customer. For more information, see Trace enablement.
    record Trace
        -- The trace details for a trace defined in the Guardrail filter.
        guardrailTrace: GuardrailTrace
        -- Details about the pre-processing step, in which the agent contextualizes and categorizes user inputs.
        preProcessingTrace: PreProcessingTrace
        -- Details about the orchestration step, in which the agent determines the order in which actions are executed and which knowledge bases are retrieved.
        orchestrationTrace: OrchestrationTrace
        -- Details about the post-processing step, in which the agent shapes the response..
        postProcessingTrace: PostProcessingTrace
        -- A routing classifier's trace.
        routingClassifierTrace: RoutingClassifierTrace
        -- Contains information about the failure of the interaction.
        failureTrace: FailureTrace
        -- Details about the custom orchestration step in which the agent determines the order in which actions are executed.
        customOrchestrationTrace: CustomOrchestrationTrace
    end

    -- Contains information about the agent and session, alongside the agent's reasoning process and results from calling API actions and querying knowledge bases and metadata about the trace. You can use the trace to understand how the agent arrived at the response it provided the customer. For more information, see Trace enablement.
    record TracePart
        -- The unique identifier of the session with the agent.
        sessionId: string
        -- Contains one part of the agent's reasoning process and results from calling API actions and querying knowledge bases. You can use the trace to understand how the agent arrived at the response it provided the customer. For more information, see Trace enablement.
        trace: Trace
        -- The part's caller chain.
        callerChain: {Caller}
        -- The time of the trace.
        eventTime: number
        -- The part's collaborator name.
        collaboratorName: string
        -- The unique identifier of the agent.
        agentId: string
        -- The unique identifier of the alias of the agent.
        agentAliasId: string
        -- The version of the agent.
        agentVersion: string
    end

    record CheckIngestedDocumentAclInput
        -- The unique identifier of the knowledge base that contains the document.
        knowledgeBaseId: string
        -- The unique identifier of the data source that contains the document.
        dataSourceId: string
        -- The unique identifier of the document to check access for.
        documentId: string
        -- The context object containing identity information for access control filtering, including user ID and optional group memberships used to evaluate the document access control list (ACL).
        userContext: UserContext
    end

    record CheckIngestedDocumentAclOutput
        -- Specifies whether the user has access to the document based on the ingested access control list (ACL). Returns true if the user is allowed access, and false otherwise.
        hasAccess: boolean
    end

