    end

    enum KeyLastUsageTrackingOperation
        "Decrypt"
        "DeriveSharedSecret"
        "Encrypt"
        "GenerateDataKey"
        "GenerateDataKeyPair"
        "GenerateDataKeyPairWithoutPlaintext"
        "GenerateDataKeyWithoutPlaintext"
