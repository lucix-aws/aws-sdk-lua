        Tags: {Tag}
        -- Indicates whether subtitles were generated with your transcription.
        Subtitles: SubtitlesOutput
        -- Provides the name and language of all custom language models, custom vocabularies, and
        -- custom vocabulary filters that you included in your request.
        LanguageIdSettings: {string : LanguageIdSettings}
        -- Provides information about the toxicity detection settings applied to your transcription.
        ToxicityDetection: {ToxicityDetectionSettings}
