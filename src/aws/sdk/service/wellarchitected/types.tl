        QuestionId: string
        SelectedChoices: {string}
        -- A list of choices to update on a question in your workload. The String key corresponds to the choice ID to be updated.
        ChoiceUpdates: {string : ChoiceUpdate}
        Notes: string
        IsApplicable: boolean
        -- The reason why a question is not applicable to your workload.
        Reason: string
    end

    -- Output of a update answer call.
    record UpdateAnswerOutput
        WorkloadId: string
        LensAlias: string
        -- The ARN for the lens.
        LensArn: string
        Answer: Answer
    end

    record UpdateGlobalSettingsInput
        -- The status of organization sharing settings.
        OrganizationSharingStatus: string
        -- The status of discovery support settings.
        DiscoveryIntegrationStatus: string
        -- The status of Jira integration settings.
        JiraConfiguration: AccountJiraConfigurationInput
    end

    record UpdateGlobalSettingsOutput
    end

    record UpdateIntegrationInput
        WorkloadId: string
        ClientRequestToken: string
        -- Which integrated service to update.
        IntegratingService: string
    end

    record UpdateIntegrationOutput
    end

    -- Input for update lens review.
    record UpdateLensReviewInput
        WorkloadId: string
        LensAlias: string
        LensNotes: string
        PillarNotes: {string : string}
        -- Configuration of the Jira integration.
        JiraConfiguration: JiraSelectedQuestionConfiguration
    end

    -- Output of a update lens review call.
    record UpdateLensReviewOutput
        WorkloadId: string
        LensReview: LensReview
    end

    record UpdateProfileInput
        -- The profile ARN.
        ProfileArn: string
        -- The profile description.
        ProfileDescription: string
        -- Profile questions.
        ProfileQuestions: {ProfileQuestionUpdate}
    end

    record UpdateProfileOutput
        -- The profile.
        Profile: Profile
    end

    record UpdateReviewTemplateInput
        -- The review template ARN.
        TemplateArn: string
        -- The review template name.
        TemplateName: string
        -- The review template description.
        Description: string
        Notes: string
        -- A list of lens aliases or ARNs to apply to the review template.
        LensesToAssociate: {string}
        -- A list of lens aliases or ARNs to unapply to the review template. The wellarchitected lens cannot be unapplied.
        LensesToDisassociate: {string}
    end

    record UpdateReviewTemplateOutput
        -- A review template.
        ReviewTemplate: ReviewTemplate
    end

    record UpdateReviewTemplateAnswerInput
        -- The review template ARN.
        TemplateArn: string
        LensAlias: string
        QuestionId: string
        SelectedChoices: {string}
        -- A list of choices to be updated.
        ChoiceUpdates: {string : ChoiceUpdate}
        Notes: string
        IsApplicable: boolean
        -- The update reason.
        Reason: string
    end

    record UpdateReviewTemplateAnswerOutput
        -- The review template ARN.
        TemplateArn: string
        LensAlias: string
        -- An answer of the question.
        Answer: ReviewTemplateAnswer
    end

    record UpdateReviewTemplateLensReviewInput
        -- The review template ARN.
        TemplateArn: string
        LensAlias: string
        LensNotes: string
        PillarNotes: {string : string}
    end

    record UpdateReviewTemplateLensReviewOutput
        -- The review template ARN.
        TemplateArn: string
        -- A lens review of a question.
        LensReview: ReviewTemplateLensReview
    end

    -- Input for Update Share Invitation
    record UpdateShareInvitationInput
        -- The ID assigned to the share invitation.
        ShareInvitationId: string
        ShareInvitationAction: string
    end

    record UpdateShareInvitationOutput
        -- The updated workload or custom lens share invitation.
        ShareInvitation: ShareInvitation
    end

    -- Input to update a workload.
    record UpdateWorkloadInput
        WorkloadId: string
        WorkloadName: string
        Description: string
        Environment: string
        AccountIds: {string}
        AwsRegions: {string}
        NonAwsRegions: {string}
        PillarPriorities: {string}
        ArchitecturalDesign: string
        ReviewOwner: string
        -- Flag indicating whether the workload owner has acknowledged that the Review owner field is required. If a Review owner is not added to the workload within 60 days of acknowledgement, access to the workload is restricted until an owner is added.
        IsReviewOwnerUpdateAcknowledged: boolean
        IndustryType: string
        Industry: string
        Notes: string
        ImprovementStatus: string
        -- Well-Architected discovery configuration settings to associate to the workload.
        DiscoveryConfig: WorkloadDiscoveryConfig
        -- List of AppRegistry application ARNs to associate to the workload.
        Applications: {string}
        -- Configuration of the Jira integration.
        JiraConfiguration: WorkloadJiraConfigurationInput
    end

    -- Output of an update workload call.
    record UpdateWorkloadOutput
        Workload: Workload
    end

    -- Input for Update Workload Share
    record UpdateWorkloadShareInput
        ShareId: string
        WorkloadId: string
        PermissionType: string
    end

    -- A workload share return object.
    record WorkloadShare
        ShareId: string
        SharedBy: string
        SharedWith: string
        PermissionType: string
        Status: string
        WorkloadName: string
        WorkloadId: string
    end

    -- Input for Update Workload Share
    record UpdateWorkloadShareOutput
        WorkloadId: string
        WorkloadShare: WorkloadShare
    end

    record UpgradeLensReviewInput
        WorkloadId: string
        LensAlias: string
        MilestoneName: string
        ClientRequestToken: string
    end

    record UpgradeLensReviewOutput
    end

    record UpgradeProfileVersionInput
        WorkloadId: string
        -- The profile ARN.
        ProfileArn: string
        MilestoneName: string
        ClientRequestToken: string
    end

    record UpgradeProfileVersionOutput
    end

    record UpgradeReviewTemplateLensReviewInput
        -- The ARN of the review template.
        TemplateArn: string
        LensAlias: string
        ClientRequestToken: string
    end

    record UpgradeReviewTemplateLensReviewOutput
    end

end

return M
