    -- Sets the start date and end date for retrieving a cost estimate. The start date is
    -- inclusive, but the end date is exclusive. For example, if start is
    -- 2017-01-01 and end is 2017-05-01, then the cost and
    -- usage data is retrieved from 2017-01-01 up to and including
    -- 2017-04-30 but not including 2017-05-01.
    record TimePeriod
        -- The beginning of the time period. The start date is inclusive. For example, if
        -- start is 2017-01-01, Lightsail for Research retrieves cost and usage data starting
        -- at 2017-01-01 up to the end date. The start date must be equal to or no later
        -- than the current date to avoid a validation error.
        start: number
    end

    -- An estimate that's associated with a time period.
    record EstimateByTime
        -- The amount of cost or usage that's measured for the cost estimate.
        usageCost: number
        -- The unit of measurement that's used for the cost estimate.
        pricingUnit: string
        -- The number of pricing units used to calculate the total number of hours. For example, 1
        -- unit equals 1 hour.
        unit: number
        -- The currency of the estimate in USD.
        currency: string
        -- The period of time, in days, that an estimate covers. The period has a start date and an
        -- end date. The start date must come before the end date.
        timePeriod: TimePeriod
    end

    -- Describes the estimated cost for resources in your Lightsail for Research account.
    record CostEstimate
        -- The types of usage that are included in the estimate, such as costs, usage, or data
        -- transfer.
        usageType: string
        -- The cost estimate result that's associated with a time period.
        resultsByTime: {EstimateByTime}
    end

