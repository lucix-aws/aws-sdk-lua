        LastModifiedDate: number
        -- The latest revision of the attribution after the update.
        LatestRevision: string
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the resource to list tags for.
        resourceArn: string
    end

    record ListTagsForResourceOutput
        -- The tags associated with the resource.
        tags: {Tag}
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the resource to tag.
        resourceArn: string
        -- The tags to add to the resource.
        tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource to remove tags from.
        resourceArn: string
        -- The tag keys to remove from the resource.
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

end

return M
