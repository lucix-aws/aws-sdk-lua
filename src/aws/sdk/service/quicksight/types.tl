    -- Border settings configuration for visual elements, including visibility, width, and color properties.
    record BorderSettings
        -- Visibility setting for the border.
        BorderVisibility: string
        -- Width of the border. Valid range is from 1px to 8px.
        BorderWidth: string
        -- Color of the border.
        BorderColor: string
    end

    -- The options that determine the default presentation of all bar series in BarChartVisual.
    record BarChartDefaultSeriesSettings
        -- Decal settings for all bar series in the visual.
        DecalSettings: DecalSettings
        -- Border settings for all bar series in the visual.
        BorderSettings: BorderSettings
    end

    -- The dimension type field with categorical type columns..
    record CategoricalDimensionField
        -- The custom field ID.
        FieldId: string
        -- The column that is used in the CategoricalDimensionField.
        Column: ColumnIdentifier
        -- The custom hierarchy ID.
        HierarchyId: string
        -- The format configuration of the field.
        FormatConfiguration: StringFormatConfiguration
    end

    -- The dimension type field with date type columns.
    record DateDimensionField
        -- The custom field ID.
        FieldId: string
        -- The column that is used in the DateDimensionField.
        Column: ColumnIdentifier
        -- The date granularity of the DateDimensionField. Choose one of the following options:
        -- YEAR
        -- QUARTER
        -- MONTH
        -- WEEK
        -- DAY
        -- HOUR
        -- MINUTE
        -- SECOND
        -- MILLISECOND
        DateGranularity: string
        -- The custom hierarchy ID.
        HierarchyId: string
        -- The format configuration of the field.
        FormatConfiguration: DateTimeFormatConfiguration
    end

    -- The dimension type field with numerical type columns.
    record NumericalDimensionField
        -- The custom field ID.
