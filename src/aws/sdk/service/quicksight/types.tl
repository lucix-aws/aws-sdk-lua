        -- AUTO
        -- RIGHT
        -- BOTTOM
        -- LEFT
        Position: string
        -- The width of the legend. If this value is omitted, a default width is used when rendering.
        Width: string
        -- The height of the legend. If this value is omitted, a default height is used when
