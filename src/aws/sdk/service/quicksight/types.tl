        VersionArn: string
        -- The ID for the dashboard.
        DashboardId: string
        -- The status of the dashboard creation request.
        CreationStatus: string
        -- The HTTP status of the request.
        Status: number
        -- The Amazon Web Services request ID for this operation.
        RequestId: string
