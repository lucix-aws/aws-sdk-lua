    -- The forecast properties setup of a forecast in the line chart.
    record TimeBasedForecastProperties
        -- The periods forward setup of a forecast computation.
        PeriodsForward: number
        -- The periods backward setup of a forecast computation.
        PeriodsBackward: number
        -- The upper boundary setup of a forecast computation.
        UpperBoundary: number
        -- The lower boundary setup of a forecast computation.
        LowerBoundary: number
        -- The prediction interval setup of a forecast computation.
        PredictionInterval: number
        -- The seasonality setup of a forecast computation. Choose one of the following options:
        -- NULL: The input is set to NULL.
        -- NON_NULL: The input is set to a custom value.
        Seasonality: number
    end

    -- Provides the forecast to meet the target for a particular date.
    record WhatIfPointScenario
        -- The date that you need the forecast results for.
        Date: number
        -- The target value that you want to meet for the provided date.
        Value: number
    end

    -- Provides the forecast to meet the target for a particular date range.
    record WhatIfRangeScenario
        -- The start date in the date range that you need the forecast results for.
        StartDate: number
        -- The end date in the date range that you need the forecast results for.
        EndDate: number
        -- The target value that you want to meet for the provided date range.
        Value: number
    end

    -- The forecast scenario of a forecast in the line chart.
    record ForecastScenario
        -- The what-if analysis forecast setup with the target date.
        WhatIfPointScenario: WhatIfPointScenario
        -- The what-if analysis forecast setup with the date range.
        WhatIfRangeScenario: WhatIfRangeScenario
    end

    -- The forecast configuration that is used in a line chart's display properties.
    record ForecastConfiguration
        -- The forecast properties setup of a forecast in the line
        -- chart.
        ForecastProperties: TimeBasedForecastProperties
        -- The forecast scenario of a forecast in the line chart.
        Scenario: ForecastScenario
    end

    enum MissingDataTreatmentOption
        "INTERPOLATE"
        "SHOW_AS_ZERO"
        "SHOW_AS_BLANK"
    end

    -- The configuration options that determine how missing data is treated during the rendering of a line chart.
    record MissingDataConfiguration
        -- The treatment option that determines how missing data should be rendered. Choose
        -- from the following options:
        -- INTERPOLATE: Interpolate missing values between the prior and the next known value.
        -- SHOW_AS_ZERO: Show missing values as the value 0.
        -- SHOW_AS_BLANK: Display a blank space when rendering missing data.
        TreatmentOption: string
    end

    -- The series axis configuration of a line chart.
    record LineSeriesAxisDisplayOptions
        -- The options that determine the presentation of the line series axis.
        AxisOptions: AxisDisplayOptions
        -- The configuration options that determine how missing data is treated during the rendering of a line chart.
        MissingDataConfigurations: {MissingDataConfiguration}
    end

    -- The options that determine the presentation of a line series in the visual
    record LineChartSeriesSettings
        -- Line styles options for a line series in LineChartVisual.
        LineStyleSettings: LineChartLineStyleSettings
        -- Marker styles options for a line series in LineChartVisual.
        MarkerStyleSettings: LineChartMarkerStyleSettings
        -- Decal settings for a line series in LineChartVisual.
        DecalSettings: DecalSettings
    end

    -- The data field series item configuration of a line chart.
    record DataFieldSeriesItem
        -- The field ID of the field that you are setting the axis binding to.
        FieldId: string
        -- The field value of the field that you are setting the axis binding to.
        FieldValue: string
        -- The axis that you are binding the field to.
        AxisBinding: string
        -- The options that determine the presentation of line series associated to the field.
