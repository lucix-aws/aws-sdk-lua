    enum TopBottomSortOrder
        "PERCENT_DIFFERENCE"
        "ABSOLUTE_DIFFERENCE"
    end

    enum TopBottomComputationType
        "TOP"
        "BOTTOM"
    end

    -- The top movers and bottom movers computation setup.
