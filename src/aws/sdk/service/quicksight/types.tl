    -- The title format text configuration for a sheet control. This is a tagged union type. Specify either PlainText or RichText, but not both.
    record ControlTitleFormatText
        -- The plain text format of the title text.
        PlainText: string
        -- The rich text format of the title text.
        RichText: string
    end

    -- The default configuration for all dependent controls of the filter.
    record DefaultFilterControlConfiguration
        -- The title of the DefaultFilterControlConfiguration. This title is shared by all controls that are tied to this filter.
        Title: string
        -- The control option for the DefaultFilterControlConfiguration.
        ControlOptions: DefaultFilterControlOptions
        -- The title text format configuration for the default filter control.
        ControlTitleFormatText: ControlTitleFormatText
    end

    -- A CategoryFilter filters text values.
    -- For more information, see Adding text filters in the Amazon Quick Suite User Guide.
    record CategoryFilter
        -- An identifier that uniquely identifies a filter within a dashboard, analysis, or template.
        FilterId: string
        -- The column that the filter is applied to.
        Column: ColumnIdentifier
        -- The configuration for a CategoryFilter.
        Configuration: CategoryFilterConfiguration
        -- The default configurations for the associated controls. This applies only for filters that are scoped to multiple sheets.
        DefaultFilterControlConfiguration: DefaultFilterControlConfiguration
    end

    -- A CategoryInnerFilter filters text values for the NestedFilter.
    record CategoryInnerFilter
        Column: ColumnIdentifier
        Configuration: CategoryFilterConfiguration
        DefaultFilterControlConfiguration: DefaultFilterControlConfiguration
    end

    -- The InnerFilter defines the subset of data to be used with the NestedFilter.
    record InnerFilter
        -- A CategoryInnerFilter filters text values for the NestedFilter.
        CategoryInnerFilter: CategoryInnerFilter
    end

    -- A NestedFilter filters data with a subset of data that is defined by the nested inner filter.
    record NestedFilter
        -- An identifier that uniquely identifies a filter within a dashboard, analysis, or template.
        FilterId: string
        -- The column that the filter is applied to.
        Column: ColumnIdentifier
        -- A boolean condition to include or exclude the subset that is defined by the values of the nested inner filter.
        IncludeInnerSet: boolean
        -- The InnerFilter defines the subset of data to be used with the NestedFilter.
        InnerFilter: InnerFilter
    end

    enum NumericEqualityMatchOperator
        "EQUALS"
        "DOES_NOT_EQUAL"
    end

    enum NumericFilterSelectAllOptions
        "FILTER_ALL_VALUES"
    end

    -- A NumericEqualityFilter filters values that are equal to the specified value.
    record NumericEqualityFilter
        -- An identifier that uniquely identifies a filter within a dashboard, analysis, or template.
        FilterId: string
        -- The column that the filter is applied to.
        Column: ColumnIdentifier
        -- The input value.
        Value: number
        -- Select all of the values. Null is not the assigned value of select all.
        -- FILTER_ALL_VALUES
        SelectAllOptions: string
        -- The match operator that is used to determine if a filter should be applied.
        MatchOperator: string
        -- The aggregation function of the filter.
        AggregationFunction: AggregationFunction
        -- The parameter whose value should be used for the filter value.
        ParameterName: string
        -- This option determines how null values should be treated when filtering data.
        -- ALL_VALUES: Include null values in filtered results.
        -- NULLS_ONLY: Only include null values in filtered results.
        -- NON_NULLS_ONLY: Exclude null values from filtered results.
        NullOption: string
        -- The default configurations for the associated controls. This applies only for filters that are scoped to multiple sheets.
        DefaultFilterControlConfiguration: DefaultFilterControlConfiguration
    end

    -- The value input pf the numeric range filter.
    record NumericRangeFilterValue
        -- The static value of the numeric range filter.
        StaticValue: number
        -- The parameter that is used in the numeric range.
        Parameter: string
    end

    -- A NumericRangeFilter filters values that are within the value range.
    record NumericRangeFilter
        -- An identifier that uniquely identifies a filter within a dashboard, analysis, or template.
        FilterId: string
        -- The column that the filter is applied to.
        Column: ColumnIdentifier
        -- Determines whether the minimum value in the filter value range should be included in the filtered results.
        IncludeMinimum: boolean
        -- Determines whether the maximum value in the filter value range should be included in the filtered results.
        IncludeMaximum: boolean
        -- The minimum value for the filter value range.
        RangeMinimum: NumericRangeFilterValue
        -- The maximum value for the filter value range.
        RangeMaximum: NumericRangeFilterValue
        -- Select all of the values. Null is not the assigned value of select all.
        -- FILTER_ALL_VALUES
        SelectAllOptions: string
        -- The aggregation function of the filter.
        AggregationFunction: AggregationFunction
        -- This option determines how null values should be treated when filtering data.
        -- ALL_VALUES: Include null values in filtered results.
        -- NULLS_ONLY: Only include null values in filtered results.
        -- NON_NULLS_ONLY: Exclude null values from filtered results.
        NullOption: string
        -- The default configurations for the associated controls. This applies only for filters that are scoped to multiple sheets.
        DefaultFilterControlConfiguration: DefaultFilterControlConfiguration
    end

    enum AnchorOption
        "NOW"
    end

    -- The date configuration of the filter.
    record AnchorDateConfiguration
        -- The options for the date configuration. Choose one of the options below:
        -- NOW
        AnchorOption: string
        -- The name of the parameter that is used for the anchor date configuration.
        ParameterName: string
    end

    -- The exclude period of TimeRangeFilter or RelativeDatesFilter.
    record ExcludePeriodConfiguration
        -- The amount or number of the exclude period.
        Amount: number
        -- The granularity or unit (day, month, year) of the exclude period.
        Granularity: string
        -- The status of the exclude period. Choose from the following options:
        -- ENABLED
        -- DISABLED
        Status: string
    end

    enum RelativeDateType
        "PREVIOUS"
        "THIS"
        "LAST"
        "NOW"
        "NEXT"
    end

    -- A RelativeDatesFilter filters relative dates values.
    record RelativeDatesFilter
        -- An identifier that uniquely identifies a filter within a dashboard, analysis, or template.
        FilterId: string
        -- The column that the filter is applied to.
        Column: ColumnIdentifier
        -- The date configuration of the filter.
        AnchorDateConfiguration: AnchorDateConfiguration
        -- The minimum granularity (period granularity) of the relative dates filter.
        MinimumGranularity: string
        -- The level of time precision that is used to aggregate DateTime values.
        TimeGranularity: string
        -- The range date type of the filter. Choose one of the options below:
        -- PREVIOUS
        -- THIS
        -- LAST
        -- NOW
        -- NEXT
        RelativeDateType: string
        -- The date value of the filter.
        RelativeDateValue: number
        -- The parameter whose value should be used for the filter value.
        ParameterName: string
        -- This option determines how null values should be treated when filtering data.
        -- ALL_VALUES: Include null values in filtered results.
        -- NULLS_ONLY: Only include null values in filtered results.
        -- NON_NULLS_ONLY: Exclude null values from filtered results.
        NullOption: string
        -- The configuration for the exclude period of the filter.
        ExcludePeriodConfiguration: ExcludePeriodConfiguration
        -- The default configurations for the associated controls. This applies only for filters that are scoped to multiple sheets.
        DefaultFilterControlConfiguration: DefaultFilterControlConfiguration
    end

    -- The rolling date configuration of a date time filter.
    record RollingDateConfiguration
        -- The data set that is used in the rolling date configuration.
        DataSetIdentifier: string
        -- The expression of the rolling date configuration.
        Expression: string
    end

    -- A TimeEqualityFilter filters values that are equal to a given value.
    record TimeEqualityFilter
        -- An identifier that uniquely identifies a filter within a dashboard, analysis, or template.
        FilterId: string
        -- The column that the filter is applied to.
        Column: ColumnIdentifier
        -- The value of a TimeEquality filter.
        -- This field is mutually exclusive to RollingDate and ParameterName.
        Value: number
        -- The parameter whose value should be used for the filter value.
        -- This field is mutually exclusive to Value and RollingDate.
        ParameterName: string
        -- The level of time precision that is used to aggregate DateTime values.
        TimeGranularity: string
        -- The rolling date input for the TimeEquality filter.
        -- This field is mutually exclusive to Value and ParameterName.
        RollingDate: RollingDateConfiguration
        -- The default configurations for the associated controls. This applies only for filters that are scoped to multiple sheets.
        DefaultFilterControlConfiguration: DefaultFilterControlConfiguration
    end

    -- The value of a time range filter.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record TimeRangeFilterValue
        -- The static input value.
        StaticValue: number
        -- The rolling date input value.
        RollingDate: RollingDateConfiguration
        -- The parameter type input value.
        Parameter: string
    end

    -- A TimeRangeFilter filters values that are between two specified values.
    record TimeRangeFilter
        -- An identifier that uniquely identifies a filter within a dashboard, analysis, or template.
        FilterId: string
        -- The column that the filter is applied to.
        Column: ColumnIdentifier
        -- Determines whether the minimum value in the filter value range should be included in the filtered results.
        IncludeMinimum: boolean
        -- Determines whether the maximum value in the filter value range should be included in the filtered results.
        IncludeMaximum: boolean
        -- The minimum value for the filter value range.
        RangeMinimumValue: TimeRangeFilterValue
        -- The maximum value for the filter value range.
        RangeMaximumValue: TimeRangeFilterValue
        -- This option determines how null values should be treated when filtering data.
        -- ALL_VALUES: Include null values in filtered results.
        -- NULLS_ONLY: Only include null values in filtered results.
        -- NON_NULLS_ONLY: Exclude null values from filtered results.
        NullOption: string
        -- The exclude period of the time range filter.
        ExcludePeriodConfiguration: ExcludePeriodConfiguration
        -- The level of time precision that is used to aggregate DateTime values.
        TimeGranularity: string
        -- The default configurations for the associated controls. This applies only for filters that are scoped to multiple sheets.
        DefaultFilterControlConfiguration: DefaultFilterControlConfiguration
    end

    -- A TopBottomFilter filters values that are at the top or the bottom.
    record TopBottomFilter
        -- An identifier that uniquely identifies a filter within a dashboard, analysis, or template.
        FilterId: string
        -- The column that the filter is applied to.
        Column: ColumnIdentifier
        -- The number of items to include in the top bottom filter results.
        Limit: number
        -- The aggregation and sort configuration of the top bottom filter.
        AggregationSortConfigurations: {AggregationSortConfiguration}
        -- The level of time precision that is used to aggregate DateTime values.
        TimeGranularity: string
        -- The parameter whose value should be used for the filter value.
        ParameterName: string
        -- The default configurations for the associated controls. This applies only for filters that are scoped to multiple sheets.
        DefaultFilterControlConfiguration: DefaultFilterControlConfiguration
    end

    -- With a Filter, you can remove portions of data from a particular visual or view.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record Filter
        -- A CategoryFilter filters text values.
        -- For more information, see Adding text filters in the Amazon Quick Suite User Guide.
        CategoryFilter: CategoryFilter
        -- A NumericRangeFilter filters numeric values that are either inside or outside a given numeric range.
        NumericRangeFilter: NumericRangeFilter
        -- A NumericEqualityFilter filters numeric values that equal or do not equal a given numeric value.
        NumericEqualityFilter: NumericEqualityFilter
        -- A TimeEqualityFilter filters date-time values that equal or do not equal
        -- a given date/time value.
        TimeEqualityFilter: TimeEqualityFilter
        -- A TimeRangeFilter filters date-time values that are either inside or outside a given date/time range.
        TimeRangeFilter: TimeRangeFilter
        -- A RelativeDatesFilter filters date values that are relative to a given date.
        RelativeDatesFilter: RelativeDatesFilter
        -- A TopBottomFilter filters data to the top or bottom values for a given column.
        TopBottomFilter: TopBottomFilter
        -- A NestedFilter filters data with a subset of data that is defined by the nested inner filter.
        NestedFilter: NestedFilter
    end

    enum FilterVisualScope
        "ALL_VISUALS"
        "SELECTED_VISUALS"
    end

    -- The filter that is applied to the options.
    record SheetVisualScopingConfiguration
        -- The selected sheet that the filter is applied to.
        SheetId: string
        -- The scope of the applied entities. Choose one of the following options:
        -- ALL_VISUALS
        -- SELECTED_VISUALS
        Scope: string
        -- The selected visuals that the filter is applied to.
        VisualIds: {string}
    end

    -- The configuration for applying a filter to specific sheets or visuals. You can apply this filter to multiple visuals that are on one sheet or to all visuals on a sheet.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record SelectedSheetsFilterScopeConfiguration
        -- The sheet ID and visual IDs of the sheet and visuals that the filter is applied to.
        SheetVisualScopingConfigurations: {SheetVisualScopingConfiguration}
    end

    -- The scope configuration for a FilterGroup.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record FilterScopeConfiguration
        -- The configuration for applying a filter to specific sheets.
        SelectedSheets: SelectedSheetsFilterScopeConfiguration
        -- The configuration that applies a filter to all sheets. When you choose AllSheets as the value for a FilterScopeConfiguration, this filter is applied to all visuals of all sheets in an Analysis, Dashboard, or Template. The AllSheetsFilterScopeConfiguration is chosen.
        AllSheets: AllSheetsFilterScopeConfiguration
    end

    -- A grouping of individual filters. Filter groups are applied to the same group of visuals.
    -- For more information, see Adding filter conditions (group filters) with AND and OR operators in the Amazon Quick Suite User Guide.
    record FilterGroup
        -- The value that uniquely identifies a FilterGroup within a dashboard, template, or analysis.
        FilterGroupId: string
        -- The list of filters that are present in a FilterGroup.
        Filters: {Filter}
        -- The configuration that specifies what scope to apply to a FilterGroup.
        -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
        ScopeConfiguration: FilterScopeConfiguration
        -- The status of the FilterGroup.
        Status: string
        -- The filter new feature which can apply filter group to all data sets. Choose one of the following options:
        -- ALL_DATASETS
        -- SINGLE_DATASET
        CrossDataset: string
    end

    enum VisualHighlightTrigger
        "DATA_POINT_CLICK"
        "DATA_POINT_HOVER"
        "NONE"
    end

    -- Defines what initiates a highlight operation on a visual, such as a click or hover.
    record VisualHighlightOperation
        -- Specifies whether a highlight operation is initiated by a click or hover, or whether it's disabled.
        Trigger: string
    end

    -- A list of custom actions applied to visuals in an analysis or sheet.
    record VisualCustomActionDefaults
        -- A list of highlight operations available for visuals in an analysis or sheet.
        highlightOperation: VisualHighlightOperation
    end

    enum QBusinessInsightsStatus
        "ENABLED"
        "DISABLED"
    end

    -- The configuration for a customizable message displayed on a visual. Supports parameter substitution in text fields.
    record VisualMessageConfiguration
        -- Specifies whether the custom message is displayed on the visual. When set to true, the custom message appears in place of the default message. When set to false or omitted, the default message is displayed.
        Enabled: boolean
        -- The title text of the message that is displayed on the visual.
        Title: string
        -- Specifies whether the title of the message is displayed.
        TitleVisibility: string
        -- The description text of the message that is displayed on the visual.
        Description: string
        -- Specifies whether the description of the message is displayed.
        DescriptionVisibility: string
        -- The display text of the hyperlink that is shown in the message.
        LinkText: string
        -- The destination URL of the hyperlink that is shown in the message. Only valid http, https, and mailto URLs are supported.
        LinkUrl: string
        -- Specifies whether the hyperlink in the message is displayed.
        LinkVisibility: string
    end

    -- The messages that are displayed on a visual under specific conditions, such as when the visual returns no data.
    record VisualMessages
        -- The message that is displayed on a visual when there is no data to display.
        NoDataMessage: VisualMessageConfiguration
    end

    enum DayOfTheWeek
        "SUNDAY"
        "MONDAY"
        "TUESDAY"
        "WEDNESDAY"
        "THURSDAY"
        "FRIDAY"
        "SATURDAY"
    end

    -- An array of analysis level configurations.
    record AssetOptions
        -- Determines the timezone for the analysis.
        Timezone: string
        -- Determines the week start day for an analysis.
        WeekStart: string
        -- Determines whether insight summaries from Amazon Q Business are allowed in Dashboard Q&A.
        QBusinessInsightsStatus: string
        -- A list of dataset ARNS to exclude from Dashboard Q&A.
        ExcludedDataSetArns: {string}
        -- A list of visual custom actions for the analysis.
        CustomActionDefaults: VisualCustomActionDefaults
        -- The configuration options for the messages that are displayed on visuals in the analysis.
        VisualMessages: VisualMessages
    end

    -- Defines different defaults to the users or groups based on mapping.
    record DynamicDefaultValue
        -- The column that contains the username.
        UserNameColumn: ColumnIdentifier
        -- The column that contains the group name.
        GroupNameColumn: ColumnIdentifier
        -- The column that contains the default value of each user or group.
        DefaultValueColumn: ColumnIdentifier
    end

    -- The default values of the DateTimeParameterDeclaration.
    record DateTimeDefaultValues
        -- The dynamic value of the DataTimeDefaultValues. Different defaults are displayed according to users, groups, and values mapping.
        DynamicValue: DynamicDefaultValue
        -- The static values of the DataTimeDefaultValues.
        StaticValues: {number}
        -- The rolling date of the DataTimeDefaultValues. The date is determined from the dataset based on input expression.
        RollingDate: RollingDateConfiguration
    end

    -- A dataset parameter that is mapped to an analysis parameter.
    record MappedDataSetParameter
        -- A unique name that identifies a dataset within the analysis or dashboard.
        DataSetIdentifier: string
        -- The name of the dataset parameter.
        DataSetParameterName: string
    end

    enum ValueWhenUnsetOption
        "RECOMMENDED_VALUE"
        "NULL"
    end

    -- The configuration that defines the default value of a DateTime parameter when a value has not been set.
    record DateTimeValueWhenUnsetConfiguration
        -- The built-in options for default values. The value can be one of the following:
        -- RECOMMENDED: The recommended value.
        -- NULL: The NULL value.
        ValueWhenUnsetOption: string
        -- A custom value that's used when the value of a parameter isn't set.
        CustomValue: number
    end

    -- A parameter declaration for the DateTime data type.
    record DateTimeParameterDeclaration
        -- The name of the parameter that is being declared.
        Name: string
        -- The default values of a parameter. If the parameter is a single-value parameter, a maximum of one default value can be provided.
        DefaultValues: DateTimeDefaultValues
        -- The level of time precision that is used to aggregate DateTime values.
        TimeGranularity: string
        -- The configuration that defines the default value of a DateTime parameter when a value has not been set.
        ValueWhenUnset: DateTimeValueWhenUnsetConfiguration
        MappedDataSetParameters: {MappedDataSetParameter}
    end

    -- The default values of the DecimalParameterDeclaration.
    record DecimalDefaultValues
        -- The dynamic value of the DecimalDefaultValues. Different defaults are displayed according to users, groups, and values mapping.
        DynamicValue: DynamicDefaultValue
        -- The static values of the DecimalDefaultValues.
        StaticValues: {number}
    end

    enum ParameterValueType
        "MULTI_VALUED"
        "SINGLE_VALUED"
    end

    -- The configuration that defines the default value of a Decimal parameter when a value has not been set.
    record DecimalValueWhenUnsetConfiguration
        -- The built-in options for default values. The value can be one of the following:
        -- RECOMMENDED: The recommended value.
        -- NULL: The NULL value.
        ValueWhenUnsetOption: string
        -- A custom value that's used when the value of a parameter isn't set.
        CustomValue: number
    end

    -- A parameter declaration for the Decimal data type.
    record DecimalParameterDeclaration
        -- The value type determines whether the parameter is a single-value or multi-value parameter.
        ParameterValueType: string
        -- The name of the parameter that is being declared.
        Name: string
        -- The default values of a parameter. If the parameter is a single-value parameter, a maximum of one default value can be provided.
        DefaultValues: DecimalDefaultValues
        -- The configuration that defines the default value of a Decimal parameter when a value has not been set.
        ValueWhenUnset: DecimalValueWhenUnsetConfiguration
        MappedDataSetParameters: {MappedDataSetParameter}
    end

