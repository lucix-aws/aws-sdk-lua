        -- quicksight:StartFlowSession
        -- quicksight:StopFlowSession
        -- quicksight:GetFlowSession
        -- quicksight:CreatePresignedUrl
        -- quicksight:GetFlowStages
        Actions: {string}
        -- The Amazon Resource Name (ARN) of the principal.
