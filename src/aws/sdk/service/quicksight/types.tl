        -- The availability status of the textbox menu. If the value of this property is set to ENABLED, dashboard readers can interact with the textbox menu.
        AvailabilityStatus: string
    end

    -- The general textbox interactions setup for textbox publish options.
    record TextBoxInteractionOptions
        -- The menu options for the textbox.
        TextBoxMenuOption: TextBoxMenuOption
    end

    -- A text box.
    record SheetTextBox
        -- The unique identifier for a text box. This identifier must be unique within the context of a dashboard, template, or analysis. Two dashboards, analyses, or templates can have text boxes that share identifiers.
        SheetTextBoxId: string
        -- The content that is displayed in the text box.
        Content: string
        -- The general textbox interactions setup for a textbox.
        Interactions: TextBoxInteractionOptions
    end

    enum SelectedFieldOptions
        "ALL_FIELDS"
    end

    -- The configuration of selected fields in theCustomActionFilterOperation.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record FilterOperationSelectedFieldsConfiguration
        -- Chooses the fields that are filtered in CustomActionFilterOperation.
        SelectedFields: {string}
        -- A structure that contains the options that choose which fields are filtered in the CustomActionFilterOperation.
        -- Valid values are defined as follows:
        -- ALL_FIELDS: Applies the filter operation to all fields.
        SelectedFieldOptions: string
        -- The selected columns of a dataset.
        SelectedColumns: {ColumnIdentifier}
    end

    enum TargetVisualOptions
        "ALL_VISUALS"
    end

    -- The configuration of the same-sheet target visuals that you want to be filtered.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record SameSheetTargetVisualConfiguration
        -- A list of the target visual IDs that are located in the same sheet of the analysis.
        TargetVisuals: {string}
        -- The options that choose the target visual in the same sheet.
        -- Valid values are defined as follows:
        -- ALL_VISUALS: Applies the filter operation to all visuals in the same sheet.
        TargetVisualOptions: string
    end

    -- The configuration of target visuals that you want to be filtered.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record FilterOperationTargetVisualsConfiguration
        -- The configuration of the same-sheet target visuals that you want to be filtered.
        SameSheetTargetVisualConfiguration: SameSheetTargetVisualConfiguration
    end

    -- The filter operation that filters data included in a visual or in an entire sheet.
    record CustomActionFilterOperation
        -- The configuration that chooses the fields to be filtered.
        SelectedFieldsConfiguration: FilterOperationSelectedFieldsConfiguration
        -- The configuration that chooses the target visuals to be filtered.
        TargetVisualsConfiguration: FilterOperationTargetVisualsConfiguration
    end

    -- The operation that is defined by the custom action.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record VisualCustomActionOperation
        -- The filter operation that filters data included in a visual or in an entire sheet.
        FilterOperation: CustomActionFilterOperation
        -- The navigation operation that navigates between different sheets in the same analysis.
        NavigationOperation: CustomActionNavigationOperation
        -- The URL operation that opens a link to another webpage.
        URLOperation: CustomActionURLOperation
        -- The set parameter operation that sets parameters in custom action.
        SetParametersOperation: CustomActionSetParametersOperation
    end

    enum VisualCustomActionTrigger
        "DATA_POINT_CLICK"
        "DATA_POINT_MENU"
    end

    -- A custom action defined on a visual.
    record VisualCustomAction
        -- The ID of the VisualCustomAction.
        CustomActionId: string
        -- The name of the VisualCustomAction.
        Name: string
        -- The status of the VisualCustomAction.
        Status: string
        -- The trigger of the VisualCustomAction.
        -- Valid values are defined as follows:
        -- DATA_POINT_CLICK: Initiates a custom action by a left pointer click on a data point.
        -- DATA_POINT_MENU: Initiates a custom action by right pointer click from the menu.
        Trigger: string
        -- A list of VisualCustomActionOperations.
        -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
        ActionOperations: {VisualCustomActionOperation}
    end

    enum BarsArrangement
        "CLUSTERED"
        "STACKED"
        "STACKED_PERCENT"
    end

    -- The options that determine how a date axis is displayed.
    record DateAxisOptions
        -- Determines whether or not missing dates are displayed.
        MissingDateVisibility: string
    end

    -- The options that are saved for future extension.
    record AxisDisplayDataDrivenRange
    end

    -- The minimum and maximum setup for an axis display range.
    record AxisDisplayMinMaxRange
        -- The minimum setup for an axis display range.
        Minimum: number
        -- The maximum setup for an axis display range.
        Maximum: number
    end

    -- The range setup of a numeric axis display range.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record AxisDisplayRange
        -- The minimum and maximum setup of an axis display range.
        MinMax: AxisDisplayMinMaxRange
        -- The data-driven setup of an axis display range.
        DataDriven: AxisDisplayDataDrivenRange
    end

    -- The liner axis scale setup.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record AxisLinearScale
        -- The step count setup of a linear axis.
        StepCount: number
        -- The step size setup of a linear axis.
        StepSize: number
    end

    -- The logarithmic axis scale setup.
    record AxisLogarithmicScale
        -- The base setup of a logarithmic axis scale.
        Base: number
    end

    -- The scale setup
    -- options for a numeric axis display.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record AxisScale
        -- The linear axis scale setup.
        Linear: AxisLinearScale
        -- The logarithmic axis scale setup.
        Logarithmic: AxisLogarithmicScale
    end

    -- The options for an axis with a numeric field.
    record NumericAxisOptions
        -- The scale setup of a numeric axis.
        Scale: AxisScale
        -- The range setup of a numeric axis.
        Range: AxisDisplayRange
    end

    -- The data options for an axis.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record AxisDataOptions
        -- The options for an axis with a numeric field.
        NumericAxisOptions: NumericAxisOptions
        -- The options for an axis with a date field.
