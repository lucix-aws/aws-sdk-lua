    end

    -- The label options for an axis on a chart.
    record ChartAxisLabelOptions
        -- The visibility of an axis label on a chart. Choose one of the following options:
        -- VISIBLE: Shows the axis.
        -- HIDDEN: Hides the axis.
        Visibility: string
        -- The visibility configuration of the sort icon on a chart's axis label.
        SortIconVisibility: string
        -- The label options for a chart axis.
        AxisLabelOptions: {AxisLabelOptions}
    end

    -- The contribution analysis visual display for a line, pie, or bar chart.
    record ContributionAnalysisDefault
        -- The measure field that is used in the contribution analysis.
        MeasureFieldId: string
        -- The dimensions columns that are used in the contribution analysis,
        -- usually a list of ColumnIdentifiers.
        ContributorDimensions: {ColumnIdentifier}
    end

    -- The option that specifies individual data values for labels.
    record DataPathLabelType
        -- The field ID of the field that the data label needs to be applied to.
        FieldId: string
        -- The actual value of the field that is labeled.
        FieldValue: string
        -- The visibility of the data label.
        Visibility: string
    end

    -- The field label type.
    record FieldLabelType
        -- Indicates the field that is targeted by the field
