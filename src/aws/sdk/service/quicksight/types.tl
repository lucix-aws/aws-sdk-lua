        "TUESDAY"
        "WEDNESDAY"
        "THURSDAY"
        "FRIDAY"
        "SATURDAY"
    end

    -- The refresh on entity for weekly or monthly schedules.
    record ScheduleRefreshOnEntity
        -- The day of the week that you want to schedule a refresh on.
        DayOfWeek: string
        -- The day of the month that you want to schedule refresh on.
        DayOfMonth: string
    end

    -- Specifies the interval between each scheduled refresh of a dataset.
    record RefreshFrequency
        -- The interval between scheduled refreshes. Valid values are as follows:
        -- MINUTE15: The dataset refreshes every 15 minutes. This value is only supported for incremental refreshes. This interval can only be used for one schedule per dataset.
        -- MINUTE30:The dataset refreshes every 30 minutes. This value is only supported for incremental refreshes. This interval can only be used for one schedule per dataset.
        -- HOURLY: The dataset refreshes every hour. This interval can only be used for one schedule per dataset.
        -- DAILY: The dataset refreshes every day.
        -- WEEKLY: The dataset refreshes every week.
        -- MONTHLY: The dataset refreshes every month.
        Interval: string
        -- The day of the week that you want to schedule the refresh on. This value is required for weekly and monthly refresh intervals.
        RefreshOnDay: ScheduleRefreshOnEntity
        -- The timezone that you want the refresh schedule to use. The timezone ID must match a corresponding ID found on java.util.time.getAvailableIDs().
        Timezone: string
        -- The time of day that you want the datset to refresh. This value is expressed in HH:MM format. This field is not required for schedules that refresh hourly.
        TimeOfTheDay: string
    end

    -- The refresh schedule of a dataset.
    record RefreshSchedule
        -- An identifier for the refresh schedule.
        ScheduleId: string
        -- The frequency for the refresh schedule.
        ScheduleFrequency: RefreshFrequency
        -- Time after which the refresh schedule can be started, expressed in YYYY-MM-DDTHH:MM:SS format.
        StartAfterDateTime: number
        -- The type of refresh that a datset undergoes. Valid values are as follows:
        -- FULL_REFRESH: A complete refresh of a dataset.
        -- INCREMENTAL_REFRESH: A partial refresh of some rows of a dataset, based on the time window specified.
        -- For more information on full and incremental refreshes, see Refreshing SPICE data in the Amazon Quick Suite User Guide.
        RefreshType: string
        -- The Amazon Resource Name (ARN) for the refresh schedule.
        Arn: string
    end

