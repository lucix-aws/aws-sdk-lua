        -- The configuration of info icon label options.
        InfoIconLabelOptions: SheetControlInfoIconLabelOptions
    end

    -- A list of selectable values that are used in a control.
    record FilterSelectableValues
        -- The values that are used in the FilterSelectableValues.
        Values: {string}
    end

    enum SheetControlListType
        "MULTI_SELECT"
        "SINGLE_SELECT"
    end

    -- The default options that correspond to the Dropdown filter control type.
    record DefaultFilterDropDownControlOptions
        -- The display options of a control.
        DisplayOptions: DropDownControlDisplayOptions
        -- The type of the FilterDropDownControl. Choose one of the following options:
        -- MULTI_SELECT: The user can select multiple entries from a dropdown menu.
        -- SINGLE_SELECT: The user can select a single entry from a dropdown menu.
        Type: string
        -- A list of selectable values that are used in a control.
        SelectableValues: FilterSelectableValues
        -- The visibility configuration of the Apply button on a FilterDropDownControl.
        CommitMode: string
        -- The sort configuration for the values displayed in the control. Only one sort configuration can be applied per control.
        ControlSortConfigurations: {ControlSortConfiguration}
    end

    -- The configuration of the search options in a list control.
    record ListControlSearchOptions
        -- The visibility configuration of the search options in a list control.
        Visibility: string
    end

    -- The display options of a control.
    record ListControlDisplayOptions
        -- The configuration of the search options in a list control.
        SearchOptions: ListControlSearchOptions
        -- The configuration of the Select all options in a list control.
        SelectAllOptions: ListControlSelectAllOptions
        -- The options to configure the title visibility, name, and font size.
        TitleOptions: LabelOptions
        -- The configuration of info icon label options.
        InfoIconLabelOptions: SheetControlInfoIconLabelOptions
    end

    -- The default options that correspond to the List filter control type.
    record DefaultFilterListControlOptions
        -- The display options of a control.
        DisplayOptions: ListControlDisplayOptions
        -- The type of the DefaultFilterListControlOptions. Choose one of the following options:
        -- MULTI_SELECT: The user can select multiple entries from the list.
        -- SINGLE_SELECT: The user can select a single entry from the list.
        Type: string
        -- A list of selectable values that are used in a control.
        SelectableValues: FilterSelectableValues
        -- The sort configuration for the values displayed in the control. Only one sort configuration can be applied per control.
        ControlSortConfigurations: {ControlSortConfiguration}
    end

    -- The display options of a control.
    record RelativeDateTimeControlDisplayOptions
        -- The options to configure the title visibility, name, and font size.
        TitleOptions: LabelOptions
        -- Customize how dates are formatted in controls.
        DateTimeFormat: string
        -- The configuration of info icon label options.
        InfoIconLabelOptions: SheetControlInfoIconLabelOptions
    end

    -- The default options that correspond to the RelativeDateTime filter control type.
    record DefaultRelativeDateTimeControlOptions
        -- The display options of a control.
        DisplayOptions: RelativeDateTimeControlDisplayOptions
        -- The visibility configuration of the Apply button on a RelativeDateTimeControl.
        CommitMode: string
    end

    -- The display options of a control.
    record SliderControlDisplayOptions
        -- The options to configure the title visibility, name, and font size.
        TitleOptions: LabelOptions
        -- The configuration of info icon label options.
        InfoIconLabelOptions: SheetControlInfoIconLabelOptions
    end

    enum SheetControlSliderType
        "SINGLE_POINT"
        "RANGE"
    end

    -- The default options that correspond to the Slider filter control type.
    record DefaultSliderControlOptions
        -- The display options of a control.
        DisplayOptions: SliderControlDisplayOptions
        -- The type of the DefaultSliderControlOptions. Choose one of the following options:
        -- SINGLE_POINT: Filter against(equals) a single data point.
        -- RANGE: Filter data that is in a specified range.
        Type: string
        -- The larger value that is displayed at the right of the slider.
        MaximumValue: number
        -- The smaller value that is displayed at the left of the slider.
        MinimumValue: number
        -- The number of increments that the slider bar is divided into.
        StepSize: number
    end

    -- The configuration of the placeholder options in a text control.
    record TextControlPlaceholderOptions
        -- The visibility configuration of the placeholder options in a text control.
        Visibility: string
    end

    -- The display options of a control.
    record TextAreaControlDisplayOptions
        -- The options to configure the title visibility, name, and font size.
        TitleOptions: LabelOptions
        -- The configuration of the placeholder options in a text area control.
        PlaceholderOptions: TextControlPlaceholderOptions
        -- The configuration of info icon label options.
        InfoIconLabelOptions: SheetControlInfoIconLabelOptions
    end

    -- The default options that correspond to the TextArea filter control type.
    record DefaultTextAreaControlOptions
        -- The delimiter that is used to separate the lines in text.
