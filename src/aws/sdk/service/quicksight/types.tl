    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record CustomActionNavigationOperation
        -- The configuration that chooses the navigation target.
        LocalNavigationConfiguration: LocalNavigationConfiguration
    end

    -- The customized parameter values.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record CustomParameterValues
        -- A list of string-type parameter values.
        StringValues: {string}
        -- A list of integer-type parameter values.
        IntegerValues: {number}
        -- A list of decimal-type parameter values.
        DecimalValues: {number}
        -- A list of datetime-type parameter values.
        DateTimeValues: {number}
    end

    -- The configuration of custom values for the destination parameter in DestinationParameterValueConfiguration.
    record CustomValuesConfiguration
        -- Includes the null value in custom action parameter values.
        IncludeNullValue: boolean
        CustomValues: CustomParameterValues
    end

    enum SelectAllValueOptions
        "ALL_VALUES"
    end

    -- The configuration of destination parameter values.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record DestinationParameterValueConfiguration
        -- The configuration of custom values for destination parameter in DestinationParameterValueConfiguration.
        CustomValuesConfiguration: CustomValuesConfiguration
        -- The configuration that selects all options.
        SelectAllValueOptions: string
        -- The source parameter name of the destination parameter.
        SourceParameterName: string
        -- The source field ID of the destination parameter.
        SourceField: string
        SourceColumn: ColumnIdentifier
    end

    -- The configuration of adding parameters in action.
    record SetParameterValueConfiguration
        -- The destination parameter name of the SetParameterValueConfiguration.
        DestinationParameterName: string
        Value: DestinationParameterValueConfiguration
    end

    -- The set parameter operation that sets parameters in custom action.
    record CustomActionSetParametersOperation
        -- The parameter that determines the value configuration.
        ParameterValueConfigurations: {SetParameterValueConfiguration}
    end

    enum URLTargetConfiguration
        "NEW_TAB"
        "NEW_WINDOW"
        "SAME_TAB"
    end

    -- The URL operation that opens a link to another webpage.
    record CustomActionURLOperation
        -- THe URL link of the CustomActionURLOperation.
        URLTemplate: string
        -- The target of the CustomActionURLOperation.
        -- Valid values are defined as follows:
        -- NEW_TAB: Opens the target URL in a new browser tab.
        -- NEW_WINDOW: Opens the target URL in a new browser window.
        -- SAME_TAB: Opens the target URL in the same browser tab.
        URLTarget: string
    end

    -- The operation that is defined by the custom action.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record ImageCustomActionOperation
        NavigationOperation: CustomActionNavigationOperation
        URLOperation: CustomActionURLOperation
        SetParametersOperation: CustomActionSetParametersOperation
    end

    enum WidgetStatus
        "ENABLED"
        "DISABLED"
    end

    enum ImageCustomActionTrigger
        "CLICK"
        "MENU"
    end

    -- A custom action defined on an image.
    record ImageCustomAction
        -- The ID of the custom action.
        CustomActionId: string
        -- The name of the custom action.
        Name: string
        -- The status of the custom action.
        Status: string
        -- The trigger of the VisualCustomAction.
        -- Valid values are defined as follows:
        -- CLICK: Initiates a custom action by a left pointer click on a data point.
        -- MENU: Initiates a custom action by right pointer click from the menu.
        Trigger: string
        -- A list of ImageCustomActionOperations.
        -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
        ActionOperations: {ImageCustomActionOperation}
    end

    -- The menu options for the interactions of an image.
    record ImageMenuOption
        -- The availability status of the image menu. If the value of this property is set to ENABLED, dashboard readers can interact with the image menu.
        AvailabilityStatus: string
    end

    -- The general image interactions setup for image publish options.
    record ImageInteractionOptions
        -- The menu options for the image.
        ImageMenuOption: ImageMenuOption
    end

    enum SheetImageScalingType
        "SCALE_TO_WIDTH"
        "SCALE_TO_HEIGHT"
        "SCALE_TO_CONTAINER"
        "SCALE_NONE"
    end

    -- Determines how the image is scaled
    record SheetImageScalingConfiguration
        -- The scaling option to use when fitting the image inside the container.
        -- Valid values are defined as follows:
        -- SCALE_TO_WIDTH: The image takes up the entire width of the container. The image aspect ratio is preserved.
        -- SCALE_TO_HEIGHT: The image takes up the entire height of the container. The image aspect ratio is preserved.
        -- SCALE_TO_CONTAINER: The image takes up the entire width and height of the container. The image aspect ratio is not preserved.
        -- SCALE_NONE: The image is displayed in its original size and is not scaled to the container.
        ScalingType: string
    end

    -- The source of the static file that contains the image.
    record SheetImageStaticFileSource
        -- The ID of the static file that contains the image.
        StaticFileId: string
    end

    -- The source of the image.
    record SheetImageSource
        -- The source of the static file that contains the image.
        SheetImageStaticFileSource: SheetImageStaticFileSource
    end

    -- The text that appears in the sheet image tooltip.
    record SheetImageTooltipText
        -- The plain text format.
        PlainText: string
    end

    enum Visibility
        "HIDDEN"
        "VISIBLE"
    end

    -- The tooltip configuration for a sheet image.
    record SheetImageTooltipConfiguration
        -- The text that appears in the tooltip.
        TooltipText: SheetImageTooltipText
        -- The visibility of the tooltip.
        Visibility: string
    end

    -- An image that is located on a sheet.
    record SheetImage
        -- The ID of the sheet image.
        SheetImageId: string
        -- The source of the image.
        Source: SheetImageSource
        -- Determines how the image is scaled.
        Scaling: SheetImageScalingConfiguration
        -- The tooltip to be shown when hovering over the image.
        Tooltip: SheetImageTooltipConfiguration
        -- The alt text for the image.
        ImageContentAltText: string
        -- The general image interactions setup for an image.
        Interactions: ImageInteractionOptions
        -- A list of custom actions that are configured for an image.
        Actions: {ImageCustomAction}
    end

    -- A sheet, which is an object that contains a set of visuals that
    -- are viewed together on one page in Quick Sight. Every analysis and dashboard
    -- contains at least one sheet. Each sheet contains at least one visualization widget, for
    -- example a chart, pivot table, or narrative insight. Sheets can be associated with other
    -- components, such as controls, filters, and so on.
    record Sheet
        -- The unique identifier associated with a sheet.
        SheetId: string
        -- The name of a sheet. This name is displayed on the sheet's tab in the Quick Sight
        -- console.
        Name: string
        -- A list of images on a sheet.
        Images: {SheetImage}
    end

    -- Metadata structure for an analysis in Quick Sight
    record Analysis
        -- The ID of the analysis.
        AnalysisId: string
        -- The Amazon Resource Name (ARN) of the analysis.
        Arn: string
        -- The descriptive name of the analysis.
        Name: string
        -- Status associated with the analysis.
        Status: string
        -- Errors associated with the analysis.
        Errors: {AnalysisError}
        -- The ARNs of the datasets of the analysis.
        DataSetArns: {string}
        -- The ARNs of the topics associated with the analysis.
        TopicArns: {string}
        -- The ARN of the theme of the analysis.
        ThemeArn: string
        -- The time that the analysis was created.
        CreatedTime: number
        -- The time that the analysis was last updated.
        LastUpdatedTime: number
        -- A list of the associated sheets with the unique identifier and name of each sheet.
        Sheets: {Sheet}
    end

    -- The options that determine the sizing of the canvas used in a free-form layout.
    record FreeFormLayoutScreenCanvasSizeOptions
        -- The width that the view port will be optimized for when the layout renders.
        OptimizedViewPortWidth: string
    end

    -- Configuration options for the canvas of a free-form layout.
    record FreeFormLayoutCanvasSizeOptions
        -- The options that determine the sizing of the canvas used in a free-form layout.
        ScreenCanvasSizeOptions: FreeFormLayoutScreenCanvasSizeOptions
    end

    -- The options that determine the default settings of a free-form layout configuration.
    record DefaultFreeFormLayoutConfiguration
        -- Determines the screen canvas size options for a free-form layout.
        CanvasSizeOptions: FreeFormLayoutCanvasSizeOptions
    end

    enum ResizeOption
        "FIXED"
        "RESPONSIVE"
    end

    -- The options that determine the sizing of the canvas used in a grid layout.
    record GridLayoutScreenCanvasSizeOptions
        -- This value determines the layout behavior when the viewport is resized.
        -- FIXED: A fixed width will be used when optimizing the layout. In
        -- the Quick Sight console, this option is called Classic.
        -- RESPONSIVE: The width of the canvas will be responsive and
        -- optimized to the view port. In the Quick Sight console, this option is called Tiled.
        ResizeOption: string
        -- The width that the view port will be optimized for when the layout renders.
        OptimizedViewPortWidth: string
    end

    -- Configuration options for the canvas of a grid layout.
    record GridLayoutCanvasSizeOptions
        -- The options that determine the sizing of the canvas used in a grid layout.
        ScreenCanvasSizeOptions: GridLayoutScreenCanvasSizeOptions
    end

    -- The options that determine the default settings for a grid layout configuration.
    record DefaultGridLayoutConfiguration
        -- Determines the screen canvas size options for a grid layout.
        CanvasSizeOptions: GridLayoutCanvasSizeOptions
    end

    -- The options that determine the default settings for interactive layout configuration.
    record DefaultInteractiveLayoutConfiguration
        -- The options that determine the default settings for a grid layout configuration.
        Grid: DefaultGridLayoutConfiguration
        -- The options that determine the default settings of a free-form layout configuration.
        FreeForm: DefaultFreeFormLayoutConfiguration
    end

    -- The configuration of spacing (often a margin or padding).
    record Spacing
        -- Define the top spacing.
        Top: string
        -- Define the bottom spacing.
        Bottom: string
        -- Define the left spacing.
        Left: string
        -- Define the right spacing.
        Right: string
    end

    enum PaperOrientation
        "PORTRAIT"
        "LANDSCAPE"
    end

    enum PaperSize
        "US_LETTER"
        "US_LEGAL"
        "US_TABLOID_LEDGER"
        "A0"
        "A1"
        "A2"
        "A3"
        "A4"
        "A5"
        "JIS_B4"
        "JIS_B5"
    end

    -- The options for a paper canvas of a section-based layout.
    record SectionBasedLayoutPaperCanvasSizeOptions
        -- The paper size that is used to define canvas dimensions.
        PaperSize: string
        -- The paper orientation that
        -- is used to define canvas dimensions. Choose one of the following
        -- options:
        -- PORTRAIT
        -- LANDSCAPE
        PaperOrientation: string
        -- Defines the spacing between the canvas content and the top, bottom, left, and right edges.
        PaperMargin: Spacing
    end

    -- The options for the canvas of a section-based layout.
    record SectionBasedLayoutCanvasSizeOptions
        -- The options for a paper canvas of a section-based layout.
        PaperCanvasSizeOptions: SectionBasedLayoutPaperCanvasSizeOptions
    end

    -- The options that determine the default settings for a section-based layout configuration.
    record DefaultSectionBasedLayoutConfiguration
        -- Determines the screen canvas size options for a section-based layout.
        CanvasSizeOptions: SectionBasedLayoutCanvasSizeOptions
    end

    -- The options that determine the default settings for a paginated layout configuration.
    record DefaultPaginatedLayoutConfiguration
        -- The options that determine the default settings for a section-based layout configuration.
        SectionBased: DefaultSectionBasedLayoutConfiguration
    end

    enum SheetContentType
        "PAGINATED"
        "INTERACTIVE"
    end

    -- The configuration for default new sheet settings.
    record DefaultNewSheetConfiguration
        -- The options that determine the default settings for interactive layout configuration.
        InteractiveLayoutConfiguration: DefaultInteractiveLayoutConfiguration
        -- The options that determine the default settings for a paginated layout configuration.
        PaginatedLayoutConfiguration: DefaultPaginatedLayoutConfiguration
        -- The option that determines the sheet content type.
        SheetContentType: string
    end

    -- The configuration for default analysis settings.
    record AnalysisDefaults
        -- The configuration for default new sheet settings.
        DefaultNewSheetConfiguration: DefaultNewSheetConfiguration
    end

    -- The calculated field of an analysis.
    record CalculatedField
        -- The data set that is used in this calculated field.
        DataSetIdentifier: string
        -- The topic that is used in this calculated field.
        TopicIdentifier: string
        -- The name of the calculated field.
        Name: string
        -- The expression of the calculated field.
        Expression: string
    end

    enum SpecialValue
        "EMPTY"
        "NULL"
        "OTHER"
    end

    -- Determines the color that's applied to a particular data value in a column.
    record CustomColor
        -- The data value that the color is applied to.
        FieldValue: string
        -- The color that is applied to the data value.
        Color: string
        -- The value of a special data value.
        SpecialValue: string
    end

    -- The color configurations for a column.
    record ColorsConfiguration
        -- A list of up to 50 custom colors.
        CustomColors: {CustomColor}
    end

    enum DecalPatternType
        "SOLID"
        "DIAGONAL_MEDIUM"
        "CIRCLE_MEDIUM"
        "DIAMOND_GRID_MEDIUM"
        "CHECKERBOARD_MEDIUM"
        "TRIANGLE_MEDIUM"
        "DIAGONAL_OPPOSITE_MEDIUM"
        "DIAMOND_MEDIUM"
        "DIAGONAL_LARGE"
        "CIRCLE_LARGE"
        "DIAMOND_GRID_LARGE"
        "CHECKERBOARD_LARGE"
        "TRIANGLE_LARGE"
        "DIAGONAL_OPPOSITE_LARGE"
        "DIAMOND_LARGE"
        "DIAGONAL_SMALL"
        "CIRCLE_SMALL"
        "DIAMOND_GRID_SMALL"
        "CHECKERBOARD_SMALL"
        "TRIANGLE_SMALL"
        "DIAGONAL_OPPOSITE_SMALL"
        "DIAMOND_SMALL"
    end

    enum DecalStyleType
        "Manual"
        "Auto"
    end

    -- Decal settings for accessibility features that define visual patterns and styling for data elements.
    record DecalSettings
        -- Field value of the field that you are setting the decal pattern to. Applicable only for field level settings.
        ElementValue: string
        -- Visibility setting for the decal pattern.
        DecalVisibility: string
        -- Color configuration for the decal pattern.
        DecalColor: string
        -- Type of pattern used for the decal, such as solid, diagonal, or circular patterns in various sizes.
        -- SOLID: Solid fill pattern.
        -- DIAGONAL_SMALL: Small diagonal stripes pattern.
        -- DIAGONAL_MEDIUM: Medium diagonal stripes pattern.
        -- DIAGONAL_LARGE: Large diagonal stripes pattern.
        -- DIAGONAL_OPPOSITE_SMALL: Small cross-diagonal stripes pattern.
        -- DIAGONAL_OPPOSITE_MEDIUM: Medium cross-diagonal stripes pattern.
        -- DIAGONAL_OPPOSITE_LARGE: Large cross-diagonal stripes pattern.
        -- CIRCLE_SMALL: Small circle pattern.
        -- CIRCLE_MEDIUM: Medium circle pattern.
        -- CIRCLE_LARGE: Large circle pattern.
        -- DIAMOND_SMALL: Small diamonds pattern.
        -- DIAMOND_MEDIUM: Medium diamonds pattern.
        -- DIAMOND_LARGE: Large diamonds pattern.
        -- DIAMOND_GRID_SMALL: Small diamond grid pattern.
        -- DIAMOND_GRID_MEDIUM: Medium diamond grid pattern.
        -- DIAMOND_GRID_LARGE: Large diamond grid pattern.
        -- CHECKERBOARD_SMALL: Small checkerboard pattern.
        -- CHECKERBOARD_MEDIUM: Medium checkerboard pattern.
        -- CHECKERBOARD_LARGE: Large checkerboard pattern.
        -- TRIANGLE_SMALL: Small triangles pattern.
        -- TRIANGLE_MEDIUM: Medium triangles pattern.
        -- TRIANGLE_LARGE: Large triangles pattern.
        DecalPatternType: string
        -- Style type for the decal, which can be either manual or automatic. This field is only applicable for line series.
        -- Manual: Apply manual line and marker configuration for line series.
        -- Auto: Apply automatic line and marker configuration for line series.
        DecalStyleType: string
    end

    -- Decal settings configuration for a column
    record DecalSettingsConfiguration
        -- A list of up to 50 decal settings.
        CustomDecalSettings: {DecalSettings}
    end

    -- The options that determine the null value format configuration.
    record NullValueFormatConfiguration
        -- Determines the null string of null values.
        NullString: string
    end

    -- The option that determines the decimal places configuration.
    record DecimalPlacesConfiguration
        -- The values of the decimal places.
        DecimalPlaces: number
    end

    enum NegativeValueDisplayMode
        "POSITIVE"
        "NEGATIVE"
    end

    -- The options that determine the negative value configuration.
    record NegativeValueConfiguration
        -- Determines the display mode of the negative value configuration.
        DisplayMode: string
    end

    enum NumberScale
        "NONE"
        "AUTO"
        "THOUSANDS"
        "MILLIONS"
        "BILLIONS"
        "TRILLIONS"
        "LAKHS"
        "CRORES"
    end

    enum NumericSeparatorSymbol
        "COMMA"
        "DOT"
        "SPACE"
    end

    enum DigitGroupingStyle
        "DEFAULT"
        "LAKHS"
    end

    -- The options that determine the thousands separator configuration.
    record ThousandSeparatorOptions
        -- Determines the thousands separator symbol.
        Symbol: string
        -- Determines the visibility of the thousands separator.
        Visibility: string
        -- Determines the way numbers are styled to accommodate different readability standards. The DEFAULT value uses the standard international grouping system and groups numbers by the thousands. The LAKHS value uses the Indian numbering system and groups numbers by lakhs and crores.
        GroupingStyle: string
    end

    -- The options that determine the numeric separator configuration.
    record NumericSeparatorConfiguration
        -- Determines the decimal separator.
        DecimalSeparator: string
        -- The options that determine the thousands separator configuration.
        ThousandsSeparator: ThousandSeparatorOptions
    end

    -- The options that determine the currency display format configuration.
    record CurrencyDisplayFormatConfiguration
        -- Determines the prefix value of the currency format.
        Prefix: string
        -- Determines the suffix value of the currency format.
        Suffix: string
        -- The options that determine the numeric separator configuration.
        SeparatorConfiguration: NumericSeparatorConfiguration
        -- Determines the symbol for the currency format.
        Symbol: string
        -- The option that determines the decimal places configuration.
        DecimalPlacesConfiguration: DecimalPlacesConfiguration
        -- Determines the number scale value for the currency format.
        NumberScale: string
        -- The options that determine the negative value configuration.
        NegativeValueConfiguration: NegativeValueConfiguration
        -- The options that determine the null value format configuration.
        NullValueFormatConfiguration: NullValueFormatConfiguration
    end

    -- The options that determine the number display format configuration.
    record NumberDisplayFormatConfiguration
        -- Determines the prefix value of the number format.
        Prefix: string
        -- Determines the suffix value of the number format.
        Suffix: string
        -- The options that determine the numeric separator configuration.
        SeparatorConfiguration: NumericSeparatorConfiguration
        -- The option that determines the decimal places configuration.
        DecimalPlacesConfiguration: DecimalPlacesConfiguration
        -- Determines the number scale value of the number format.
        NumberScale: string
        -- The options that determine the negative value configuration.
        NegativeValueConfiguration: NegativeValueConfiguration
        -- The options that determine the null value format configuration.
        NullValueFormatConfiguration: NullValueFormatConfiguration
    end

    -- The options that determine the percentage display format configuration.
    record PercentageDisplayFormatConfiguration
        -- Determines the prefix value of the percentage format.
        Prefix: string
        -- Determines the suffix value of the percentage format.
        Suffix: string
        -- The options that determine the numeric separator configuration.
        SeparatorConfiguration: NumericSeparatorConfiguration
        -- The option that determines the decimal places configuration.
        DecimalPlacesConfiguration: DecimalPlacesConfiguration
        -- The options that determine the negative value configuration.
        NegativeValueConfiguration: NegativeValueConfiguration
        -- The options that determine the null value format configuration.
        NullValueFormatConfiguration: NullValueFormatConfiguration
    end

    -- The options that determine the numeric format configuration.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record NumericFormatConfiguration
        -- The options that determine the number display format configuration.
        NumberDisplayFormatConfiguration: NumberDisplayFormatConfiguration
        -- The options that determine the currency display format configuration.
        CurrencyDisplayFormatConfiguration: CurrencyDisplayFormatConfiguration
        -- The options that determine the percentage display format configuration.
        PercentageDisplayFormatConfiguration: PercentageDisplayFormatConfiguration
    end

    -- Formatting configuration for DateTime fields.
    record DateTimeFormatConfiguration
        -- Determines the DateTime format.
        DateTimeFormat: string
        -- The options that determine the null value format configuration.
        NullValueFormatConfiguration: NullValueFormatConfiguration
        -- The formatting configuration for numeric DateTime fields.
        NumericFormatConfiguration: NumericFormatConfiguration
    end

    -- Formatting configuration for number fields.
    record NumberFormatConfiguration
        -- The options that determine the numeric format configuration.
        FormatConfiguration: NumericFormatConfiguration
    end

    -- Formatting configuration for string fields.
    record StringFormatConfiguration
        -- The options that determine the null value format configuration.
        NullValueFormatConfiguration: NullValueFormatConfiguration
        -- The formatting configuration for numeric strings.
        NumericFormatConfiguration: NumericFormatConfiguration
    end

    -- The formatting configuration for all types of field.
    record FormatConfiguration
        -- Formatting configuration for string fields.
        StringFormatConfiguration: StringFormatConfiguration
        -- Formatting configuration for number fields.
        NumberFormatConfiguration: NumberFormatConfiguration
        -- Formatting configuration for DateTime fields.
        DateTimeFormatConfiguration: DateTimeFormatConfiguration
    end

    enum ColumnRole
        "DIMENSION"
        "MEASURE"
    end

    -- The general configuration of a column.
    record ColumnConfiguration
        -- The column.
        Column: ColumnIdentifier
        -- The format configuration of a column.
        FormatConfiguration: FormatConfiguration
        -- The role of the column.
        Role: string
        -- The color configurations of the column.
        ColorsConfiguration: ColorsConfiguration
        -- Decal configuration of the column.
        DecalSettingsConfiguration: DecalSettingsConfiguration
    end

    -- A data set.
    record DataSetIdentifierDeclaration
        -- The identifier of the data set, typically the data set's name.
        Identifier: string
        -- The Amazon Resource Name (ARN) of the data set.
        DataSetArn: string
    end

    enum CrossDatasetTypes
        "ALL_DATASETS"
        "SINGLE_DATASET"
    end

    enum CategoryFilterMatchOperator
        "EQUALS"
        "DOES_NOT_EQUAL"
        "CONTAINS"
        "DOES_NOT_CONTAIN"
        "STARTS_WITH"
        "ENDS_WITH"
    end

    enum FilterNullOption
        "ALL_VALUES"
        "NULLS_ONLY"
        "NON_NULLS_ONLY"
    end

    enum CategoryFilterSelectAllOptions
        "FILTER_ALL_VALUES"
    end

    -- A custom filter that filters based on a single value. This filter can be partially matched.
    record CustomFilterConfiguration
        -- The match operator that is used to determine if a filter should be applied.
        MatchOperator: string
        -- The category value for the filter.
        -- This field is mutually exclusive to ParameterName.
        CategoryValue: string
        -- Select all of the values. Null is not the assigned value of select all.
        -- FILTER_ALL_VALUES
        SelectAllOptions: string
        -- The parameter whose value should be used for the filter value.
        -- This field is mutually exclusive to CategoryValue.
        ParameterName: string
        -- This option determines how null values should be treated when filtering data.
        -- ALL_VALUES: Include null values in filtered results.
        -- NULLS_ONLY: Only include null values in filtered results.
        -- NON_NULLS_ONLY: Exclude null values from filtered results.
        NullOption: string
    end

    -- A list of custom filter values.
    record CustomFilterListConfiguration
        -- The match operator that is used to determine if a filter should be applied.
        MatchOperator: string
        -- The list of category values for the filter.
        CategoryValues: {string}
        -- Select all of the values. Null is not the assigned value of select all.
        -- FILTER_ALL_VALUES
        SelectAllOptions: string
        -- This option determines how null values should be treated when filtering data.
        -- ALL_VALUES: Include null values in filtered results.
        -- NULLS_ONLY: Only include null values in filtered results.
        -- NON_NULLS_ONLY: Exclude null values from filtered results.
        NullOption: string
    end

    -- A list of filter configurations.
    record FilterListConfiguration
        -- The match operator that is used to determine if a filter should be applied.
        MatchOperator: string
        -- The list of category values for the filter.
        CategoryValues: {string}
        -- Select all of the values. Null is not the assigned value of select all.
        -- FILTER_ALL_VALUES
        SelectAllOptions: string
        -- This option determines how null values should be treated when filtering data.
        -- ALL_VALUES: Include null values in filtered results.
        -- NULLS_ONLY: Only include null values in filtered results.
        -- NON_NULLS_ONLY: Exclude null values from filtered results.
        NullOption: string
    end

    -- The configuration for a CategoryFilter.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record CategoryFilterConfiguration
        -- A list of filter configurations. In the Quick Sight console, this filter type is called a filter list.
        FilterListConfiguration: FilterListConfiguration
        -- A list of custom filter values. In the Quick Sight console, this filter type is called a custom filter list.
        CustomFilterListConfiguration: CustomFilterListConfiguration
        -- A custom filter that filters based on a single value. This filter can be partially matched.
        CustomFilterConfiguration: CustomFilterConfiguration
    end

    enum CommitMode
        "AUTO"
        "MANUAL"
    end

    -- A control to display info icons for filters and parameters.
    record SheetControlInfoIconLabelOptions
        -- The visibility configuration of info icon label options.
        Visibility: string
        -- The text content of info icon.
        InfoIconText: string
    end

    enum FontDecoration
        "UNDERLINE"
        "NONE"
    end

    enum RelativeFontSize
        "EXTRA_SMALL"
        "SMALL"
        "MEDIUM"
        "LARGE"
        "EXTRA_LARGE"
    end

    -- The option that determines the text display size.
    record FontSize
        -- The lexical name for the text size, proportional to its surrounding context.
        Relative: string
        -- The font size that you want to use in px.
        Absolute: string
    end

    enum FontStyle
        "NORMAL"
        "ITALIC"
    end

    enum FontWeightName
        "NORMAL"
        "BOLD"
    end

    -- The option that determines the text display weight, or boldness.
    record FontWeight
        -- The lexical name for the level of boldness of the text display.
        Name: string
    end

    -- Configures the display properties of the given text.
    record FontConfiguration
        -- The option that determines the text display size.
        FontSize: FontSize
        -- Determines the appearance of decorative lines on the text.
        FontDecoration: string
        -- Determines the color of the text.
        FontColor: string
        -- The option that determines the text display weight, or boldness.
        FontWeight: FontWeight
        -- Determines the text display face that is inherited by the given font family.
        FontStyle: string
        -- The font family that you want to use.
        FontFamily: string
    end

    -- The share label options for the labels.
    record LabelOptions
        -- Determines whether or not the label is visible.
        Visibility: string
        -- The font configuration of the label.
        FontConfiguration: FontConfiguration
        -- The text for the label.
        CustomLabel: string
    end

    -- The display options of a control.
    record DateTimePickerControlDisplayOptions
        -- The options to configure the title visibility, name, and font size.
        TitleOptions: LabelOptions
        -- Customize how dates are formatted in controls.
        DateTimeFormat: string
        -- The configuration of info icon label options.
        InfoIconLabelOptions: SheetControlInfoIconLabelOptions
        -- The helper text visibility of the DateTimePickerControlDisplayOptions.
        HelperTextVisibility: string
        -- The date icon visibility of the DateTimePickerControlDisplayOptions.
        DateIconVisibility: string
    end

    enum SheetControlDateTimePickerType
        "SINGLE_VALUED"
        "DATE_RANGE"
    end

    -- The default options that correspond to the filter control type of a DateTimePicker.
    record DefaultDateTimePickerControlOptions
        -- The date time picker type of the DefaultDateTimePickerControlOptions. Choose one of the following options:
        -- SINGLE_VALUED: The filter condition is a fixed date.
