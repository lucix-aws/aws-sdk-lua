        FieldId: string
        -- The visibility of the field label.
        Visibility: string
    end

    -- The maximum label of a data path label.
    record MaximumLabelType
        -- The visibility of the maximum label.
        Visibility: string
    end

    -- The minimum label of a data path label.
    record MinimumLabelType
        -- The visibility of the minimum label.
        Visibility: string
    end

    -- The range ends label type of a data path label.
    record RangeEndsLabelType
        -- The visibility of the range ends label.
        Visibility: string
    end

    -- The option that determines the data label type.
    -- This is a union type structure. For this structure to be valid, only one of the attributes can be defined.
    record DataLabelType
        -- Determines the label configuration for the entire field.
        FieldLabelType: FieldLabelType
        -- The option that specifies individual data values for labels.
        DataPathLabelType: DataPathLabelType
        -- Determines the label configuration for range end value in a visual.
        RangeEndsLabelType: RangeEndsLabelType
        -- Determines the label configuration for the minimum value in a visual.
        MinimumLabelType: MinimumLabelType
        -- Determines the label configuration for the maximum value in a visual.
        MaximumLabelType: MaximumLabelType
    end

    enum DataLabelContent
        "VALUE"
        "PERCENT"
        "VALUE_AND_PERCENT"
    end

    enum DataLabelOverlap
        "DISABLE_OVERLAP"
        "ENABLE_OVERLAP"
    end

    enum DataLabelPosition
        "INSIDE"
        "OUTSIDE"
        "LEFT"
        "TOP"
        "BOTTOM"
        "RIGHT"
    end

    -- The options that determine the presentation of the data labels.
    record DataLabelOptions
        -- Determines the visibility of the data labels.
        Visibility: string
        -- Determines the visibility of the category field labels.
        CategoryLabelVisibility: string
        -- Determines the visibility of the measure field labels.
        MeasureLabelVisibility: string
        -- The option that determines the data label type.
        DataLabelTypes: {DataLabelType}
        -- Determines the position of the data labels.
        Position: string
        -- Determines the content of the data labels.
        LabelContent: string
        -- Determines the font configuration of the data labels.
        LabelFontConfiguration: FontConfiguration
        -- Determines the color of the data labels.
        LabelColor: string
        -- Determines whether overlap is enabled or disabled for the data labels.
