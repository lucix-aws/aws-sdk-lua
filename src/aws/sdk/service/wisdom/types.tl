    record SearchQuickResponsesOutput
        -- The results of the quick response search.
        results: {QuickResponseSearchResultData}
        -- The token for the next set of results. Use the value returned in the previous
        -- response in the next request to retrieve the next set of results.
        nextToken: string
    end

    record StartContentUploadInput
        -- The identifier of the knowledge base. This should not be a QUICK_RESPONSES type knowledge
        -- base if you're storing Wisdom Content resource to it. Can be either the ID or the ARN. URLs cannot contain the ARN.
        knowledgeBaseId: string
        -- The type of content to upload.
        contentType: string
        -- The expected expiration time of the generated presigned URL, specified in minutes.
        presignedUrlTimeToLive: number
    end

    record StartContentUploadOutput
        -- The identifier of the upload.
        uploadId: string
        -- The URL of the upload.
        url: string
        -- The expiration time of the URL as an epoch timestamp.
        urlExpiry: number
        -- The headers to include in the upload.
        headersToInclude: {string : string}
    end

    record StartImportJobInput
        -- The identifier of the knowledge base. This should not be a QUICK_RESPONSES type knowledge
        -- base if you're storing Wisdom Content resource to it. Can be either the ID or the ARN. URLs cannot contain the ARN.
        -- For importing Wisdom quick responses, this should be a QUICK_RESPONSES type knowledge base.
        knowledgeBaseId: string
        -- The type of the import job.
        -- For importing quick response resource, set the value to QUICK_RESPONSES.
        importJobType: string
        -- A pointer to the uploaded asset. This value is returned by StartContentUpload.
        uploadId: string
        -- The tags used to organize, track, or control access for this resource.
        clientToken: string
        -- The metadata fields of the imported Wisdom resources.
        metadata: {string : string}
        -- The configuration information of the external source that the resource data are imported from.
        externalSourceConfiguration: ExternalSourceConfiguration
    end

    record StartImportJobOutput
        -- The import job.
        importJob: ImportJobData
    end

    record UpdateKnowledgeBaseTemplateUriInput
        -- The identifier of the knowledge base. This should not be a QUICK_RESPONSES type knowledge
        -- base if you're storing Wisdom Content resource to it. Can be either the ID or the ARN. URLs cannot contain the ARN.
        knowledgeBaseId: string
        -- The template URI to update.
        templateUri: string
    end

    record UpdateKnowledgeBaseTemplateUriOutput
        -- The knowledge base to update.
        knowledgeBase: KnowledgeBaseData
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        resourceArn: string
    end

    record ListTagsForResourceOutput
        -- The tags used to organize, track, or control access for this resource.
        tags: {string : string}
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        resourceArn: string
        -- The tags used to organize, track, or control access for this resource.
        tags: {string : string}
    end

    record TagResourceOutput
    end

    -- Amazon Connect Wisdom throws this exception if you have too many tags in your tag set.
    record TooManyTagsException
        message: string
        -- The specified resource name.
        resourceName: string
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        resourceArn: string
        -- The tag keys.
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

end

return M
