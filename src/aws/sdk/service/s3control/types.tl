        -- For using this parameter with S3 on Outposts with the Amazon Web Services SDK and CLI, you must specify the ARN of the bucket accessed in the format arn:aws:s3-outposts:::outpost//bucket/. For example, to access the bucket reports through Outpost my-outpost owned by account 123456789012 in Region us-west-2, use the URL encoding of arn:aws:s3-outposts:us-west-2:123456789012:outpost/my-outpost/bucket/reports. The value must be URL encoded.
        Bucket: string
        Tagging: Tagging
    end

    record PutBucketTaggingOutput
    end

    enum MFADelete
        "Enabled"
        "Disabled"
    end

    -- Describes the versioning state of an Amazon S3 on Outposts bucket. For more information, see
    -- PutBucketVersioning.
    record VersioningConfiguration
        -- Specifies whether MFA delete is enabled or disabled in the bucket versioning
        -- configuration for the S3 on Outposts bucket.
        MFADelete: string
        -- Sets the versioning state of the S3 on Outposts bucket.
        Status: string
    end

    record PutBucketVersioningInput
        -- The Amazon Web Services account ID of the S3 on Outposts bucket.
        AccountId: string
        -- The S3 on Outposts bucket to set the versioning state for.
        Bucket: string
        -- The concatenation of the authentication device's serial number, a space, and the value
        -- that is displayed on your authentication device.
        MFA: string
        -- The root-level tag for the VersioningConfiguration parameters.
        VersioningConfiguration: VersioningConfiguration
    end

    record PutBucketVersioningOutput
    end

    record PutJobTaggingInput
        -- The Amazon Web Services account ID associated with the S3 Batch Operations job.
        AccountId: string
        -- The ID for the S3 Batch Operations job whose tags you want to replace.
        JobId: string
        -- The set of tags to associate with the S3 Batch Operations job.
        Tags: {S3Tag}
    end

    record PutJobTaggingOutput
    end

    -- Amazon S3 throws this exception if you have too many tags in your tag set.
    record TooManyTagsException
        Message: string
    end

    record PutMultiRegionAccessPointPolicyOperationInput
        -- The Amazon Web Services account ID for the owner of the Multi-Region Access Point.
        AccountId: string
        -- An idempotency token used to identify the request and guarantee that requests are
        -- unique.
        ClientToken: string
        -- A container element containing the details of the policy for the Multi-Region Access Point.
        Details: PutMultiRegionAccessPointPolicyInput
    end

    record PutMultiRegionAccessPointPolicyOutput
        -- The request token associated with the request. You can use this token with DescribeMultiRegionAccessPointOperation to determine the status of asynchronous
        -- requests.
        RequestTokenARN: string
    end

    record PutPublicAccessBlockInput
        -- The PublicAccessBlock configuration that you want to apply to the specified
        -- Amazon Web Services account.
        PublicAccessBlockConfiguration: PublicAccessBlockConfiguration
        -- The account ID for the Amazon Web Services account whose PublicAccessBlock configuration
        -- you want to set.
        AccountId: string
    end

    record PutPublicAccessBlockOutput
    end

    record PutStorageLensConfigurationInput
        -- The ID of the S3 Storage Lens configuration.
        ConfigId: string
        -- The account ID of the requester.
        AccountId: string
        -- The S3 Storage Lens configuration.
        StorageLensConfiguration: StorageLensConfiguration
        -- The tag set of the S3 Storage Lens configuration.
        -- You can set up to a maximum of 50 tags.
        Tags: {StorageLensTag}
    end

    record PutStorageLensConfigurationOutput
    end

    record PutStorageLensConfigurationTaggingInput
        -- The ID of the S3 Storage Lens configuration.
        ConfigId: string
        -- The account ID of the requester.
        AccountId: string
        -- The tag set of the S3 Storage Lens configuration.
        -- You can set up to a maximum of 50 tags.
        Tags: {StorageLensTag}
    end

    record PutStorageLensConfigurationTaggingOutput
    end

    record SubmitMultiRegionAccessPointRoutesInput
        -- The Amazon Web Services account ID for the owner of the Multi-Region Access Point.
        AccountId: string
        -- The Multi-Region Access Point ARN.
        Mrap: string
        -- The different routes that make up the new route configuration. Active routes return a
        -- value of 100, and passive routes return a value of 0.
        RouteUpdates: {MultiRegionAccessPointRoute}
    end

    record SubmitMultiRegionAccessPointRoutesOutput
    end

    record TagResourceInput
        -- The Amazon Web Services account ID that created the S3 resource that you're trying to add tags to or the requester's account ID.
        AccountId: string
        -- The Amazon Resource Name (ARN) of the S3 resource that you're applying tags to. The tagged resource can be a directory bucket, S3 Storage Lens group or S3 Access Grants instance, registered location, or grant.
        ResourceArn: string
        -- The Amazon Web Services resource tags that you want to add to the specified S3 resource.
        Tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Web Services account ID that owns the resource that you're trying to remove the tags from.
        AccountId: string
        -- The Amazon Resource Name (ARN) of the S3 resource that you're removing tags from. The tagged resource can be a directory bucket, S3 Storage Lens group or S3 Access Grants instance, registered location, or grant.
        ResourceArn: string
        -- The array of tag key-value pairs that you're trying to remove from of the S3 resource.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateAccessGrantsLocationInput
        -- The Amazon Web Services account ID of the S3 Access Grants instance.
        AccountId: string
        -- The ID of the registered location that you are updating. S3 Access Grants assigns this ID when you register the location. S3 Access Grants assigns the ID default to the default location s3:// and assigns an auto-generated ID to other locations that you register.
        -- The ID of the registered location to which you are granting access. S3 Access Grants assigned this ID when you registered the location. S3 Access Grants assigns the ID default to the default location s3:// and assigns an auto-generated ID to other locations that you register.
        -- If you are passing the default location, you cannot create an access grant for the entire default location. You must also specify a bucket or a bucket and prefix in the Subprefix field.
        AccessGrantsLocationId: string
        -- The Amazon Resource Name (ARN) of the IAM role for the registered location. S3 Access Grants assumes this role to manage access to the registered location.
        IAMRoleArn: string
    end

    record UpdateAccessGrantsLocationOutput
        -- The date and time when you registered the location.
        CreatedAt: number
        -- The ID of the registered location to which you are granting access. S3 Access Grants assigned this ID when you registered the location. S3 Access Grants assigns the ID default to the default location s3:// and assigns an auto-generated ID to other locations that you register.
        AccessGrantsLocationId: string
        -- The Amazon Resource Name (ARN) of the registered location that you are updating.
        AccessGrantsLocationArn: string
        -- The S3 URI path of the location that you are updating. You cannot update the scope of the registered location. The location scope can be the default S3 location s3://, the S3 path to a bucket s3://, or the S3 path to a bucket and prefix s3:///.
        LocationScope: string
        -- The Amazon Resource Name (ARN) of the IAM role of the registered location. S3 Access Grants assumes this role to manage access to the registered location.
        IAMRoleArn: string
    end

    record UpdateJobPriorityInput
        -- The Amazon Web Services account ID associated with the S3 Batch Operations job.
        AccountId: string
        -- The ID for the job whose priority you want to update.
        JobId: string
        -- The priority you want to assign to this job.
        Priority: number
    end

    record UpdateJobPriorityOutput
        -- The ID for the job whose priority Amazon S3 updated.
        JobId: string
        -- The new priority assigned to the specified job.
        Priority: number
    end

    record JobStatusException
        Message: string
    end

    enum RequestedJobStatus
        "Cancelled"
        "Ready"
    end

    record UpdateJobStatusInput
        -- The Amazon Web Services account ID associated with the S3 Batch Operations job.
        AccountId: string
        -- The ID of the job whose status you want to update.
        JobId: string
        -- The status that you want to move the specified job to.
        RequestedJobStatus: string
        -- A description of the reason why you want to change the specified job's status. This
        -- field can be any string up to the maximum length.
        StatusUpdateReason: string
    end

    record UpdateJobStatusOutput
        -- The ID for the job whose status was updated.
        JobId: string
        -- The current status for the specified job.
        Status: string
        -- The reason that the specified job's status was updated.
        StatusUpdateReason: string
    end

    record UpdateStorageLensGroupInput
        -- The name of the Storage Lens group that you want to update.
        Name: string
        -- The Amazon Web Services account ID of the Storage Lens group owner.
        AccountId: string
        -- The JSON file that contains the Storage Lens group configuration.
        StorageLensGroup: StorageLensGroup
    end

    record UpdateStorageLensGroupOutput
    end

end

return M
