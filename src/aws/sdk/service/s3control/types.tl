        "Active"
        "Cancelled"
        "Cancelling"
        "Complete"
        "Completing"
        "Failed"
        "Failing"
        "New"
        "Paused"
        "Pausing"
        "Preparing"
        "Ready"
        "Suspended"
    end

    -- A container element for the job configuration and status information returned by a
