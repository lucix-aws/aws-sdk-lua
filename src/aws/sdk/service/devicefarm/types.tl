        -- The number of seconds the URL stays active from creation.
        expires: number
    end

    enum UploadType
        "ANDROID_APP"
        "IOS_APP"
        "WEB_APP"
        "EXTERNAL_DATA"
        "APPIUM_JAVA_JUNIT_TEST_PACKAGE"
        "APPIUM_JAVA_TESTNG_TEST_PACKAGE"
