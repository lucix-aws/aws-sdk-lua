        -- WARNED
        -- FAILED
        -- SKIPPED
        -- ERRORED
        -- STOPPED
        result: string
        -- The test's start time.
        started: number
        -- The test's stop time.
        stopped: number
        -- The test's result counters.
        counters: Counters
        -- A message about the test's result.
        message: string
