    enum InsightsType
        "TEST_REPORT"
    end

    -- Represents a latitude and longitude pair, expressed in geographic coordinate system degrees (for
    -- example, 47.6204, -122.3491).
    -- Elevation is currently not supported.
    record Location
        -- The latitude.
        latitude: number
        -- The longitude.
        longitude: number
    end

    -- Represents the set of radios and their states on a device. Examples of radios
    -- include Wi-Fi, GPS, Bluetooth, and NFC.
    record Radios
        -- True if Wi-Fi is enabled at the beginning of the test. Otherwise, false.
        wifi: boolean
        -- True if Bluetooth is enabled at the beginning of the test. Otherwise, false.
        bluetooth: boolean
        -- True if NFC is enabled at the beginning of the test. Otherwise, false.
        nfc: boolean
        -- True if GPS is enabled at the beginning of the test. Otherwise, false.
        gps: boolean
    end

    -- Represents the settings for a run. Includes things like location, radio states,
    -- auxiliary apps, and network profiles.
    record ScheduleRunConfiguration
        -- The ARN of the extra data for the run. The extra data is a .zip file that AWS Device Farm extracts to
        -- external data for Android or the app's sandbox for iOS.
        extraDataPackageArn: string
        -- Reserved for internal use.
        networkProfileArn: string
        -- Information about the locale that is used for the run.
        locale: string
        -- Information about the location that is used for the run.
        location: Location
        -- An array of ARNs for your VPC endpoint configurations.
        vpceConfigurationArns: {string}
        -- The device proxy to be configured on the device for the run.
        deviceProxy: DeviceProxy
        -- Input CustomerArtifactPaths object for the scheduled run
        -- configuration.
        customerArtifactPaths: CustomerArtifactPaths
        -- Information about the radio states for the run.
        radios: Radios
        -- A list of upload ARNs for app packages to be installed with your app.
        auxiliaryApps: {string}
        -- Specifies the billing method for a test run: metered or
        -- unmetered. If the parameter is not specified, the default value is
        -- metered.
        -- If you have purchased unmetered device slots, you must set this parameter to unmetered to
        -- make use of them. Otherwise, your run counts against your metered time.
        billingMethod: string
        -- Environment variables associated with the run.
        environmentVariables: {EnvironmentVariable}
        -- An IAM role to be assumed by the test host for the run.
        executionRoleArn: string
        -- The types of insights to generate for a run. Specify one or more values to opt in to
        -- insights generation when scheduling a run.
        -- Insights are currently supported for custom mode runs with Instrumentation, Appium Java TestNG,
        -- and XCTest UI test types.
        insightsTypes: {string}
    end

    enum TestType
        "BUILTIN_FUZZ"
        "APPIUM_JAVA_JUNIT"
        "APPIUM_JAVA_TESTNG"
        "APPIUM_PYTHON"
        "APPIUM_NODE"
        "APPIUM_RUBY"
        "APPIUM_WEB_JAVA_JUNIT"
        "APPIUM_WEB_JAVA_TESTNG"
        "APPIUM_WEB_PYTHON"
        "APPIUM_WEB_NODE"
        "APPIUM_WEB_RUBY"
        "INSTRUMENTATION"
        "XCTEST"
        "XCTEST_UI"
    end

    -- Represents test settings. This data structure is passed in as the test parameter to ScheduleRun. For an
    -- example of the JSON request syntax, see ScheduleRun.
    record ScheduleRunTest
        -- The ARN of the uploaded test to be run.
        testPackageArn: string
        -- The ARN of the YAML-formatted test specification.
        testSpecArn: string
        -- The test's filter.
        filter: string
        -- The test's parameters, such as test framework parameters and fixture settings.
        -- Parameters are represented by name-value pairs of strings.
        -- For fuzz tests (Android only):
        -- event_count: The number of events, between 1 and 10000, that the UI fuzz
        -- test should perform.
        -- throttle: The time, in ms, between 0 and 1000, that the UI fuzz test should
        -- wait between events.
        -- seed: A seed to use for randomizing the UI fuzz test. Using the same seed
        -- value between tests ensures identical event sequences.
        -- For Instrumentation:
        -- filter: A test filter string. Examples:
        -- Running a single test case: com.android.abc.Test1
        -- Running a single test: com.android.abc.Test1#smoke
        -- Running multiple tests:
        -- com.android.abc.Test1,com.android.abc.Test2
        -- For XCTest and XCTestUI:
        -- filter: A test filter string. Examples:
        -- Running a single test class: LoginTests
        -- Running a multiple test classes: LoginTests,SmokeTests
        -- Running a single test: LoginTests/testValid
        -- Running multiple tests:
        -- LoginTests/testValid,LoginTests/testInvalid
        parameters: {string : string}
    end

    -- Represents a request to the get device pool compatibility operation.
    record GetDevicePoolCompatibilityInput
        -- The device pool's ARN.
        devicePoolArn: string
        -- The ARN of the app that is associated with the specified device pool.
        appArn: string
        -- The test type for the specified device pool.
        -- Allowed values include the following:
        -- BUILTIN_FUZZ.
        -- APPIUM_JAVA_JUNIT.
        -- APPIUM_JAVA_TESTNG.
        -- APPIUM_PYTHON.
        -- APPIUM_NODE.
        -- APPIUM_RUBY.
        -- APPIUM_WEB_JAVA_JUNIT.
        -- APPIUM_WEB_JAVA_TESTNG.
        -- APPIUM_WEB_PYTHON.
        -- APPIUM_WEB_NODE.
        -- APPIUM_WEB_RUBY.
        -- INSTRUMENTATION.
        -- XCTEST.
        -- XCTEST_UI.
        testType: string
        -- Information about the uploaded test to be run against the device pool.
        test: ScheduleRunTest
        -- An object that contains information about the settings for a run.
        configuration: ScheduleRunConfiguration
        -- The ARN of the project for which you want to check
        -- device pool compatibility.
        projectArn: string
    end

    -- Represents information about incompatibility.
    record IncompatibilityMessage
        -- A message about the incompatibility.
        message: string
    end

    -- Represents a device pool compatibility result.
    record DevicePoolCompatibilityResult
        -- The device (phone or tablet) to return information about.
        device: Device
        -- Whether the result was compatible with the device pool.
        compatible: boolean
        -- Information about the compatibility.
        incompatibilityMessages: {IncompatibilityMessage}
    end

    -- Represents the result of describe device pool compatibility request.
    record GetDevicePoolCompatibilityOutput
        -- Information about compatible devices.
        compatibleDevices: {DevicePoolCompatibilityResult}
        -- Information about incompatible devices.
        incompatibleDevices: {DevicePoolCompatibilityResult}
    end

    record GetInstanceProfileInput
        -- The Amazon Resource Name (ARN) of an instance profile.
        arn: string
    end

    record GetInstanceProfileOutput
        -- An object that contains information about an instance profile.
        instanceProfile: InstanceProfile
    end

    -- Represents a request to the get job operation.
    record GetJobInput
        -- The job's ARN.
        arn: string
    end

    enum ReportStatus
        "PENDING"
        "RUNNING"
        "COMPLETED"
        "SKIPPED"
        "ERRORED"
    end

    -- Contains aggregated metrics across all tests in a job.
    record TestReportMetrics
        -- The total number of tests in the job.
        testsTotal: number
        -- The number of tests that passed.
        testsPassed: number
        -- The number of tests that failed.
        testsFailed: number
        -- The number of tests that were skipped.
        testsSkipped: number
        -- The number of tests that errored.
        testsErrored: number
        -- The number of tests with other result types.
        testsOther: number
        -- The percentage of tests that passed.
        testsPassedPercentage: number
        -- The total execution duration of all tests in the job, in seconds.
        totalTestExecutionDurationSeconds: number
        -- The median execution duration of tests in the job, in seconds.
        medianTestExecutionDurationSeconds: number
    end

    -- Contains aggregated test-level metrics for a job.
    record TestReport
        -- A message associated with the test report.
        message: string
        -- The aggregated test-level metrics for the job.
        metrics: TestReportMetrics
        -- A URL to the detailed test results.
        testDetailsUrl: string
    end

    -- Contains insights for a job, including report status, and test-level aggregated metrics such as per test execution time and median test execution time.
    record JobInsights
        -- The status of the insights report for the job.
        status: string
        -- The test-level aggregated report for the job.
        testReport: TestReport
    end

    -- Represents a device.
    record Job
        -- The job's ARN.
        arn: string
        -- The job's name.
        name: string
        -- When the job was created.
        created: number
        -- The job's status.
        -- Allowed values include:
        -- PENDING
        -- PENDING_CONCURRENCY
        -- PENDING_DEVICE
        -- PROCESSING
        -- SCHEDULING
        -- PREPARING
        -- RUNNING
        -- COMPLETED
        -- STOPPING
        status: string
        -- The job's result.
        -- Allowed values include:
        -- PENDING
        -- PASSED
        -- WARNED
        -- FAILED
        -- SKIPPED
        -- ERRORED
        -- STOPPED
        result: string
        -- The job's start time.
        started: number
        -- The job's stop time.
        stopped: number
        -- The job's result counters.
        counters: Counters
        -- A message about the job's result.
        message: string
        -- The device (phone or tablet).
        device: Device
        -- The ARN of the instance.
        instanceArn: string
        -- Represents the total (metered or unmetered) minutes used by the job.
        deviceMinutes: DeviceMinutes
        -- The endpoint for streaming device video.
        videoEndpoint: string
        -- This value is set to true if video capture is enabled. Otherwise, it is set to false.
        videoCapture: boolean
        -- The insights for the job, including the report status and test-level metrics. This field contains data only if you specified insightsTypes when you scheduled the run.
        insights: JobInsights
    end

    -- Represents the result of a get job request.
    record GetJobOutput
        -- An object that contains information about the requested job.
        job: Job
    end

    record GetNetworkProfileInput
        -- The ARN of the network profile to return information about.
        arn: string
    end

    record GetNetworkProfileOutput
        -- The network profile.
        networkProfile: NetworkProfile
    end

    -- Represents the request to retrieve the offering status for the specified customer
    -- or account.
    record GetOfferingStatusInput
        -- An identifier that was returned from the previous call to this operation, which can
        -- be used to return the next set of items in the list.
        nextToken: string
    end

    -- A number that represents the monetary amount for an offering or transaction.
    record MonetaryAmount
        -- The numerical amount of an offering or transaction.
        amount: number
        -- The currency code of a monetary amount. For example, USD means U.S. dollars.
        currencyCode: string
    end

    enum RecurringChargeFrequency
        "MONTHLY"
    end

    -- Specifies whether charges for devices are recurring.
    record RecurringCharge
        -- The cost of the recurring charge.
        cost: MonetaryAmount
        -- The frequency in which charges recur.
        frequency: string
    end

    enum OfferingType
        "RECURRING"
    end

    -- Represents the metadata of a device offering.
    record Offering
        -- The ID that corresponds to a device offering.
        id: string
        -- A string that describes the offering.
        description: string
        -- The platform of the device (for example, ANDROID or IOS).
        platform: string
        -- Specifies whether there are recurring charges for the offering.
        recurringCharges: {RecurringCharge}
    end

    enum OfferingTransactionType
        "PURCHASE"
        "RENEW"
        "SYSTEM"
    end

    -- The status of the offering.
    record OfferingStatus
        -- Represents the metadata of an offering status.
        offering: Offering
        -- The number of available devices in the offering.
        quantity: number
        -- The date on which the offering is effective.
        effectiveOn: number
    end

    -- Returns the status result for a device offering.
    record GetOfferingStatusOutput
        -- When specified, gets the offering status for the current period.
        current: {string : OfferingStatus}
        -- When specified, gets the offering status for the next period.
        nextPeriod: {string : OfferingStatus}
        -- An identifier that was returned from the previous call to this operation, which can
        -- be used to return the next set of items in the list.
        nextToken: string
    end

    -- Exception gets thrown when a user is not eligible to perform the specified
    -- transaction.
    record NotEligibleException
        -- The HTTP response code of a Not Eligible exception.
        message: string
    end

    -- Represents a request to the get project operation.
    record GetProjectInput
        -- The project's ARN.
        arn: string
    end

    -- Represents the result of a get project request.
    record GetProjectOutput
        -- The project to get information about.
        project: Project
    end

    -- Represents the request to get information about the specified remote access
    -- session.
    record GetRemoteAccessSessionInput
        -- The Amazon Resource Name (ARN) of the remote access session about which you want to
        -- get session information.
        arn: string
    end

    -- Represents the response from the server that lists detailed information about the
    -- remote access session.
    record GetRemoteAccessSessionOutput
        -- A container that lists detailed information about the remote access
        -- session.
        remoteAccessSession: RemoteAccessSession
    end

    -- Represents a request to the get run operation.
    record GetRunInput
        -- The run's ARN.
        arn: string
    end

    enum DeviceFilterAttribute
        "ARN"
        "PLATFORM"
        "OS_VERSION"
        "MODEL"
        "AVAILABILITY"
        "FORM_FACTOR"
        "MANUFACTURER"
        "REMOTE_ACCESS_ENABLED"
        "REMOTE_DEBUG_ENABLED"
        "INSTANCE_ARN"
        "INSTANCE_LABELS"
        "FLEET_TYPE"
    end

    -- Represents a device filter used to select a set of devices to be included in a test
    -- run. This data structure is passed in as the deviceSelectionConfiguration
    -- parameter to ScheduleRun. For an example of the JSON request syntax, see
    -- ScheduleRun.
    -- It is also passed in as the filters parameter to
    -- ListDevices. For an example of the JSON request syntax, see ListDevices.
    record DeviceFilter
        -- The aspect of a device such as platform or model used as the selection criteria in a
        -- device filter.
        -- The supported operators for each attribute are provided in the following list.
        -- ARN
        -- The Amazon Resource Name (ARN) of the device (for example,
        -- arn:aws:devicefarm:us-west-2::device:12345Example).
        -- Supported operators: EQUALS, IN, NOT_IN
        -- PLATFORM
        -- The device platform. Valid values are ANDROID or IOS.
        -- Supported operators: EQUALS
        -- OS_VERSION
        -- The operating system version (for example, 10.3.2).
        -- Supported operators: EQUALS, GREATER_THAN,
        -- GREATER_THAN_OR_EQUALS, IN,
        -- LESS_THAN, LESS_THAN_OR_EQUALS,
        -- NOT_IN
        -- MODEL
        -- The device model (for example, iPad 5th Gen).
        -- Supported operators: CONTAINS, EQUALS,
        -- IN, NOT_IN
        -- AVAILABILITY
        -- The current availability of the device. Valid values are AVAILABLE,
        -- HIGHLY_AVAILABLE, BUSY, or TEMPORARY_NOT_AVAILABLE.
        -- Supported operators: EQUALS
        -- FORM_FACTOR
        -- The device form factor. Valid values are PHONE or TABLET.
        -- Supported operators: EQUALS
        -- MANUFACTURER
        -- The device manufacturer (for example, Apple).
        -- Supported operators: EQUALS, IN,
        -- NOT_IN
        -- REMOTE_ACCESS_ENABLED
        -- Whether the device is enabled for remote access. Valid values are TRUE or
        -- FALSE.
        -- Supported operators: EQUALS
        -- REMOTE_DEBUG_ENABLED
        -- Whether the device is enabled for remote debugging. Valid values are TRUE or FALSE.
        -- Supported operators: EQUALS
        -- Because remote debugging is no
        -- longer supported, this filter is ignored.
        -- INSTANCE_ARN
        -- The Amazon Resource Name (ARN) of the device instance.
        -- Supported operators: EQUALS, IN,
        -- NOT_IN
        -- INSTANCE_LABELS
        -- The label of the device instance.
        -- Supported operators: CONTAINS
        -- FLEET_TYPE
        -- The fleet type. Valid values are PUBLIC or PRIVATE.
        -- Supported operators: EQUALS
        attribute: string
        -- Specifies how Device Farm compares the filter's attribute to the value. See the attribute
        -- descriptions.
        operator: string
        -- An array of one or more filter values used in a device filter.
        -- Operator Values
        -- The IN and NOT_IN operators can take a values array that has more than one
        -- element.
        -- The other operators require an array with a single element.
        -- Attribute Values
        -- The PLATFORM attribute can be set to ANDROID or IOS.
        -- The AVAILABILITY attribute can be set to AVAILABLE, HIGHLY_AVAILABLE, BUSY, or
        -- TEMPORARY_NOT_AVAILABLE.
        -- The FORM_FACTOR attribute can be set to PHONE or TABLET.
        -- The FLEET_TYPE attribute can be set to PUBLIC or PRIVATE.
        values: {string}
    end

    -- Contains the run results requested by the device selection configuration and how many devices were
    -- returned. For an example of the JSON response syntax, see ScheduleRun.
    record DeviceSelectionResult
        -- The filters in a device selection result.
        filters: {DeviceFilter}
        -- The number of devices that matched the device filter selection criteria.
        matchedDevicesCount: number
        -- The maximum number of devices to be selected by a device filter and included in a test
        -- run.
        maxDevices: number
    end

    -- Contains aggregated metrics across all jobs in a run.
    record JobReportMetrics
        -- The total number of jobs in the run.
        jobsTotal: number
        -- The number of jobs that passed.
        jobsPassed: number
        -- The number of jobs that failed.
        jobsFailed: number
        -- The number of jobs that were skipped.
        jobsSkipped: number
        -- The number of jobs that errored.
        jobsErrored: number
        -- The number of jobs that were stopped.
        jobsStopped: number
        -- The percentage of jobs that passed.
        jobsPassedPercentage: number
        -- The total execution duration of all jobs in the run, in seconds.
        totalJobExecutionDurationSeconds: number
        -- The average execution duration of jobs in the run, in seconds.
        averageJobExecutionDurationSeconds: number
        -- The median execution duration of jobs in the run, in seconds.
        medianJobExecutionDurationSeconds: number
    end

    -- Contains aggregated job-level metrics for a run.
    record JobReport
        -- A message associated with the job report.
        message: string
        -- The aggregated job-level metrics for the run.
        metrics: JobReportMetrics
        -- A URL to the detailed job results.
        jobDetailsUrl: string
    end

    -- Contains insights for a run, including report status, and job-level aggregated metrics such as per job execution time and median job execution time.
    record RunInsights
        -- The status of the insights report for the run.
        status: string
        -- The job-level aggregated report for the run.
        jobReport: JobReport
    end

    enum ExecutionResultCode
        "PARSING_FAILED"
        "VPC_ENDPOINT_SETUP_FAILED"
    end

    -- Represents a test run on a set of devices with a given app package, test parameters, and so
    -- on.
    record Run
        -- The run's ARN.
        arn: string
        -- The run's name.
        name: string
        -- The run's platform.
        -- Allowed values include:
        -- ANDROID
        -- IOS
        platform: string
        -- When the run was created.
        created: number
        -- The run's status.
        -- Allowed values include:
        -- PENDING
        -- PENDING_CONCURRENCY
        -- PENDING_DEVICE
        -- PROCESSING
        -- SCHEDULING
        -- PREPARING
        -- RUNNING
        -- COMPLETED
        -- STOPPING
        status: string
        -- The run's result.
        -- Allowed values include:
        -- PENDING
        -- PASSED
        -- WARNED
        -- FAILED
        -- SKIPPED
        -- ERRORED
        -- STOPPED
        result: string
        -- The run's start time.
        started: number
        -- The run's stop time.
        stopped: number
        -- The run's result counters.
        counters: Counters
        -- A message about the run's result.
        message: string
        -- The total number of jobs for the run.
        totalJobs: number
        -- The total number of completed jobs.
        completedJobs: number
        -- Specifies the billing method for a test run: metered or
        -- unmetered. If the parameter is not specified, the default value is
        -- metered.
        -- If you have unmetered device slots, you must set this to unmetered to use them.
        -- Otherwise, the run is counted toward metered device minutes.
        billingMethod: string
        -- Represents the total (metered or unmetered) minutes used by the test run.
        deviceMinutes: DeviceMinutes
        -- The network profile being used for a test run.
        networkProfile: NetworkProfile
        -- The device proxy configured for the devices in the run.
        deviceProxy: DeviceProxy
        -- Read-only URL for an object in an S3 bucket where you can get the parsing results of the test package.
        -- If the test package doesn't parse, the reason why it doesn't parse appears in the file that this URL points
        -- to.
        parsingResultUrl: string
        -- Supporting field for the result field. Set only if result is SKIPPED.
        -- PARSING_FAILED if the result is skipped because of test package parsing failure.
        resultCode: string
        -- For fuzz tests, this is a seed to use for randomizing the UI fuzz test. Using the same
        -- seed value between tests ensures identical event sequences.
        seed: number
        -- An app to upload or that has been uploaded.
        appUpload: string
        -- For fuzz tests, this is the number of events, between 1 and 10000, that the UI fuzz
        -- test should perform.
        eventCount: number
        -- The number of minutes the job executes before it times out.
        jobTimeoutMinutes: number
        -- The ARN of the device pool for the run.
        devicePoolArn: string
        -- Information about the locale that is used for the run.
        locale: string
        -- Information about the radio states for the run.
        radios: Radios
        -- Information about the location that is used for the run.
        location: Location
        -- Output CustomerArtifactPaths object for the test run.
        customerArtifactPaths: CustomerArtifactPaths
        -- The Device Farm console URL for the recording of the run.
        webUrl: string
        -- When set to true, for private devices, Device Farm does not sign your app again. For public
        -- devices, Device Farm always signs your apps again.
        -- For more information about how Device Farm re-signs your apps, see Do you modify my app? in the AWS Device
        -- Farm FAQs.
        skipAppResign: boolean
        -- The ARN of the YAML-formatted test specification for the run.
        testSpecArn: string
        -- The results of a device filter used to select the devices for a test run.
        deviceSelectionResult: DeviceSelectionResult
        -- The VPC security groups and subnets that are attached to a project.
        vpcConfig: VpcConfig
        -- The IAM role associated with the run.
        executionRoleArn: string
        -- Environment variables associated with the run.
        environmentVariables: {EnvironmentVariable}
        -- The types of insights requested for the run.
        insightsTypes: {string}
        -- The insights for the run, including the report status and job-level metrics. This field contains data only if you specified insightsTypes when you scheduled the run.
        insights: RunInsights
    end

    -- Represents the result of a get run request.
    record GetRunOutput
        -- The run to get results from.
        run: Run
    end

