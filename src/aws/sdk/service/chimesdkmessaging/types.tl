        -- The ARN of the channel.
        ChannelArn: string
        -- The content of the channel message.
        Content: string
        -- The type of message, STANDARD or CONTROL.
        -- STANDARD messages can be up to 4KB in size and contain metadata. Metadata is arbitrary,
        -- and you can use it in a variety of ways, such as containing a link to an attachment.
        -- CONTROL messages are limited to 30 bytes and do not contain metadata.
        Type: string
        -- Boolean that controls whether the message is persisted on the back end. Required.
        Persistence: string
        -- The optional metadata for each message.
        Metadata: string
        -- The Idempotency token for each client request.
        ClientRequestToken: string
        -- The ARN of the AppInstanceUser or AppInstanceBot
        -- that makes the API call.
        ChimeBearer: string
        -- The push notification configuration of the message.
        PushNotification: PushNotificationConfiguration
        -- The attributes for the message, used for message filtering along with a FilterRule defined in the PushNotificationPreferences.
        MessageAttributes: {string : MessageAttributeValue}
        -- The ID of the SubChannel in the request.
        SubChannelId: string
        -- The content type of the channel message.
        ContentType: string
        -- The target of a message. Must be a member of the channel, such as another user, a bot, or the sender. Only the target and the sender can view targeted messages.
        -- Only users who can see targeted messages can take actions on them. However, administrators can delete targeted messages that they can’t see.
        Target: {Target}
    end

