    enum SearchFieldKey
        "MEMBERS"
    end

    enum SearchFieldOperator
        "EQUALS"
        "INCLUDES"
    end

    -- A Field of the channel that you want to search.
    -- This operation isn't supported for AppInstanceUsers with a large number of memberships.
    record SearchField
        -- An enum value that indicates the key to search the channel on. MEMBERS allows you to search channels based on memberships. You can use it with the EQUALS
        -- operator to get channels whose memberships are equal to the specified values, and with the INCLUDES operator to get channels whose memberships include the specified values.
        Key: string
        -- The values that you want to search for, a list of strings. The values must be AppInstanceUserArns specified as a list of strings.
        -- This operation isn't supported for AppInstanceUsers with a large number of memberships.
        Values: {string}
        -- The operator used to compare field values, currently EQUALS or INCLUDES. Use the EQUALS operator to find channels whose memberships equal the specified values.
        -- Use the INCLUDES operator to find channels whose memberships include the specified values.
        Operator: string
    end

    record SearchChannelsInput
        -- The AppInstanceUserArn of the user making the API call.
        ChimeBearer: string
        -- A list of the Field objects in the channel being searched.
        Fields: {SearchField}
        -- The maximum number of channels that you want returned.
        MaxResults: number
        -- The token returned from previous API requests until the number of channels is reached.
        NextToken: string
    end

