        -- The identifier of the Amazon Web Services account to share or unshare the image
        -- with.
        -- Before sharing the image, confirm that you are sharing to the correct Amazon Web Services account ID.
        SharedAccountId: string
    end

    record UpdateWorkspaceImagePermissionOutput
    end

    record UpdateWorkspacesPoolInput
        -- The identifier of the specified pool to update.
        PoolId: string
        -- Describes the specified pool to update.
        Description: string
        -- The identifier of the bundle.
        BundleId: string
        -- The identifier of the directory.
        DirectoryId: string
        -- The desired capacity for the pool.
        Capacity: Capacity
        -- The persistent application settings for users in the pool.
        ApplicationSettings: ApplicationSettingsRequest
        -- Indicates the timeout settings of the specified pool.
        TimeoutSettings: TimeoutSettings
        -- The desired running mode for the pool. The running mode can only be updated when the pool is in a stopped state.
        RunningMode: string
    end

    record UpdateWorkspacesPoolOutput
        -- Describes the specified pool.
        WorkspacesPool: WorkspacesPool
    end

end

return M
