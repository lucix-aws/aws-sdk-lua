        -- of nextToken is a unique pagination token for each page. Send the request
        -- again using the returned token to retrieve the next page.
        NextToken: string
    end

    record ListVpcEndpointAccessInput
        -- The name of the OpenSearch Service domain to retrieve access information for.
        DomainName: string
        -- If your initial ListVpcEndpointAccess operation returns a
        -- nextToken, you can include the returned nextToken in
        -- subsequent ListVpcEndpointAccess operations, which returns results in the
        -- next page.
        NextToken: string
    end

    record ListVpcEndpointAccessOutput
        -- A list of IAM
        -- principals that can currently access the domain.
        AuthorizedPrincipalList: {AuthorizedPrincipal}
        -- When nextToken is returned, there are more results available. The value
        -- of nextToken is a unique pagination token for each page. Send the request
        -- again using the returned token to retrieve the next page.
        NextToken: string
    end

    record ListVpcEndpointsInput
        -- If your initial ListVpcEndpoints operation returns a
        -- nextToken, you can include the returned nextToken in
        -- subsequent ListVpcEndpoints operations, which returns results in the next
        -- page.
        NextToken: string
    end

    record ListVpcEndpointsOutput
        -- Information about each endpoint.
        VpcEndpointSummaryList: {VpcEndpointSummary}
        -- When nextToken is returned, there are more results available. The value
        -- of nextToken is a unique pagination token for each page. Send the request
        -- again using the returned token to retrieve the next page.
        NextToken: string
    end

    record ListVpcEndpointsForDomainInput
        -- The name of the domain to list associated VPC endpoints for.
        DomainName: string
        -- If your initial ListEndpointsForDomain operation returns a
        -- nextToken, you can include the returned nextToken in
        -- subsequent ListEndpointsForDomain operations, which returns results in the
        -- next page.
        NextToken: string
    end

    record ListVpcEndpointsForDomainOutput
        -- Information about each endpoint associated with the domain.
        VpcEndpointSummaryList: {VpcEndpointSummary}
        -- When nextToken is returned, there are more results available. The value
        -- of nextToken is a unique pagination token for each page. Send the request
        -- again using the returned token to retrieve the next page.
        NextToken: string
    end

    -- Container for request parameters to the PurchaseReservedInstanceOffering
    -- operation.
    record PurchaseReservedInstanceOfferingInput
        -- The ID of the Reserved Instance offering to purchase.
        ReservedInstanceOfferingId: string
        -- A customer-specified identifier to track this reservation.
        ReservationName: string
        -- The number of OpenSearch instances to reserve.
        InstanceCount: number
    end

    -- Represents the output of a PurchaseReservedInstanceOffering
    -- operation.
    record PurchaseReservedInstanceOfferingOutput
        -- The ID of the Reserved Instance offering that was purchased.
        ReservedInstanceId: string
        -- The customer-specified identifier used to track this reservation.
        ReservationName: string
    end

    record PutDefaultApplicationSettingInput
        applicationArn: string
        -- Set to true to set the specified ARN as the default application. Set to false to clear
        -- the default application.
        setAsDefault: boolean
    end

    record PutDefaultApplicationSettingOutput
        applicationArn: string
    end

    -- The base configuration for registering a capability. Contains capability-specific configuration such as AI settings.
    record CapabilityBaseRequestConfig
        -- Configuration settings for AI-powered capabilities.
        aiConfig: AIConfig
    end

    -- Container for the parameters to the RegisterCapability operation.
    record RegisterCapabilityInput
        -- The unique identifier of the OpenSearch UI application to register the capability for.
        applicationId: string
        -- The name of the capability to register. Must be between 3 and 30 characters and contain only alphanumeric characters and hyphens. This identifies the type of capability being enabled for the application. For registering AI Assistant capability, use ai-capability
        capabilityName: string
        -- The configuration settings for the capability being registered. This includes capability-specific settings such as AI configuration.
        capabilityConfig: CapabilityBaseRequestConfig
    end

    -- The base configuration returned for a registered capability.
    record CapabilityBaseResponseConfig
        -- Configuration settings for AI-powered capabilities.
        aiConfig: AIConfig
    end

    -- The result of a RegisterCapability request. Contains details about the registered capability.
    record RegisterCapabilityOutput
        -- The name of the registered capability.
        capabilityName: string
        -- The unique identifier of the OpenSearch UI application.
        applicationId: string
        -- The current status of the capability. Possible values: creating, create_failed, active, updating, update_failed, deleting, delete_failed.
        status: string
        -- The configuration settings for the registered capability.
        capabilityConfig: CapabilityBaseResponseConfig
    end

    -- An exception for when a request would cause a service quota to be exceeded.
    record ServiceQuotaExceededException
        -- A description of the error.
        message: string
    end

    -- Container for the request parameters to the RejectInboundConnection
    -- operation.
    record RejectInboundConnectionInput
        -- The unique identifier of the inbound connection to reject.
        ConnectionId: string
    end

    -- Represents the output of a RejectInboundConnection operation.
    record RejectInboundConnectionOutput
        -- Contains details about the rejected inbound connection.
        Connection: InboundConnection
    end

    -- Container for the request parameters to the RemoveTags operation.
    record RemoveTagsInput
        -- The Amazon Resource Name (ARN) of the domain, data source, or application from which
        -- you want to delete the specified tags.
        ARN: string
        -- The list of tag keys to remove from the domain, data source, or application.
        TagKeys: {string}
    end

    record RemoveTagsOutput
    end

    record RevokeVpcEndpointAccessInput
        -- The name of the OpenSearch Service domain.
        DomainName: string
        -- The account ID to revoke access from.
        Account: string
        -- The service SP to revoke access from.
        Service: string
        -- The options for the service, including the supported Regions for the endpoint
        -- access.
        ServiceOptions: ServiceOptions
    end

    record RevokeVpcEndpointAccessOutput
    end

    -- Container for the request parameters to the
    -- RollbackServiceSoftwareUpdate operation.
    record RollbackServiceSoftwareUpdateInput
        -- The name of the domain to roll back the service software update on.
        DomainName: string
    end

    -- Details about the rollback options for a service software update.
    record RollbackServiceSoftwareOptions
        -- The current service software version on the domain.
        CurrentVersion: string
        -- The service software version that the domain will roll back to.
        NewVersion: string
        -- Whether a service software rollback is available for the domain.
        RollbackAvailable: boolean
        -- A description of the rollback status.
        Description: string
    end

    -- Contains details about the rolled-back service software update.
    record RollbackServiceSoftwareUpdateOutput
        -- The rollback options for the service software update.
        RollbackServiceSoftwareOptions: RollbackServiceSoftwareOptions
    end

    -- Container for the parameters to the StartDomainMaintenance
    -- operation.
    record StartDomainMaintenanceInput
        -- The name of the domain.
        DomainName: string
        -- The name of the action.
        Action: string
        -- The ID of the data node.
        NodeId: string
    end

    -- The result of a StartDomainMaintenance request that information about the
    -- requested action.
    record StartDomainMaintenanceOutput
        -- The request ID of requested action.
        MaintenanceId: string
    end

    enum ScheduleAt
        "NOW"
        "TIMESTAMP"
        "OFF_PEAK_WINDOW"
    end

    -- Container for the request parameters to the StartServiceSoftwareUpdate
    -- operation.
    record StartServiceSoftwareUpdateInput
        -- The name of the domain that you want to update to the latest service software.
        DomainName: string
        -- When to start the service software update.
        -- NOW - Immediately schedules the update to happen in the current
        -- hour if there's capacity available.
        -- TIMESTAMP - Lets you specify a custom date and time to apply the
        -- update. If you specify this value, you must also provide a value for
        -- DesiredStartTime.
        -- OFF_PEAK_WINDOW - Marks the update to be picked up during an
        -- upcoming off-peak window. There's no guarantee that the update will happen
        -- during the next immediate window. Depending on capacity, it might happen in
        -- subsequent days.
        -- Default: NOW if you don't specify a value for
        -- DesiredStartTime, and TIMESTAMP if you do.
        ScheduleAt: string
        -- The Epoch timestamp when you want the service software update to start. You only need
        -- to specify this parameter if you set ScheduleAt to
        -- TIMESTAMP.
        DesiredStartTime: number
    end

    -- Represents the output of a StartServiceSoftwareUpdate operation. Contains
    -- the status of the update.
    record StartServiceSoftwareUpdateOutput
        -- The current status of the OpenSearch Service software update.
        ServiceSoftwareOptions: ServiceSoftwareOptions
    end

    record UpdateApplicationInput
        -- The unique identifier for the OpenSearch application to be updated.
        id: string
        -- The data sources to associate with the OpenSearch application.
        dataSources: {DataSource}
        -- The configuration settings to modify for the OpenSearch application.
        appConfigs: {AppConfig}
    end

    record UpdateApplicationOutput
        -- The unique identifier of the updated OpenSearch application.
        id: string
        -- The name of the updated OpenSearch application.
        name: string
        arn: string
        -- The data sources associated with the updated OpenSearch application.
        dataSources: {DataSource}
        -- The IAM Identity Center configuration for the updated OpenSearch application.
        iamIdentityCenterOptions: IamIdentityCenterOptions
        -- The configuration settings for the updated OpenSearch application.
        appConfigs: {AppConfig}
        -- The timestamp when the OpenSearch application was originally created.
        createdAt: number
        -- The timestamp when the OpenSearch application was last updated.
        lastUpdatedAt: number
    end

    -- Container for the parameters to the UpdateDataSource operation.
    record UpdateDataSourceInput
        -- The name of the domain.
        DomainName: string
        -- The name of the data source to modify.
        Name: string
        -- The type of data source.
        DataSourceType: DataSourceType
        -- A new description of the data source.
        Description: string
        -- The status of the data source update.
        Status: string
    end

    -- The result of an UpdateDataSource operation.
    record UpdateDataSourceOutput
        -- A message associated with the updated data source.
        Message: string
    end

    record UpdateDirectQueryDataSourceInput
        -- A unique, user-defined label to identify the data source within your OpenSearch
        -- Service environment.
        DataSourceName: string
        -- The supported Amazon Web Services service that you want to use as the source for
        -- direct queries in OpenSearch Service.
        DataSourceType: DirectQueryDataSourceType
        -- An optional text field for providing additional context and details about the data
        -- source.
        Description: string
        -- An optional list of Amazon Resource Names (ARNs) for the OpenSearch collections that are
        -- associated with the direct query data source. This field is required for CloudWatchLogs
        -- and SecurityLake datasource types.
        OpenSearchArns: {string}
        -- An optional IAM access policy document that defines the updated permissions for accessing the direct query data source.
        -- The policy document must be in valid JSON format and follow IAM policy syntax. If not specified, the existing access policy if present remains unchanged.
        DataSourceAccessPolicy: string
    end

    record UpdateDirectQueryDataSourceOutput
        -- The unique, system-generated identifier that represents the data source.
        DataSourceArn: string
    end

    enum DryRunMode
        "Basic"
        "Verbose"
    end

    -- Container for the request parameters to the UpdateDomain
    -- operation.
    record UpdateDomainConfigInput
        -- The name of the domain that you're updating.
        DomainName: string
        -- Changes that you want to make to the cluster configuration, such as the instance type
        -- and number of EC2 instances.
        ClusterConfig: ClusterConfig
        -- The type and size of the EBS volume to attach to instances in the domain.
        EBSOptions: EBSOptions
        -- Option to set the time, in UTC format, for the daily automated snapshot. Default value
        -- is 0 hours.
        SnapshotOptions: SnapshotOptions
        -- Options to specify the subnets and security groups for a VPC endpoint. For more
        -- information, see Launching your Amazon
        -- OpenSearch Service domains using a VPC.
        VPCOptions: VPCOptions
        -- Key-value pairs to configure Amazon Cognito authentication for OpenSearch
        -- Dashboards.
        CognitoOptions: CognitoOptions
        -- Key-value pairs to specify advanced configuration options. The following key-value
        -- pairs are supported:
        -- "rest.action.multi.allow_explicit_index": "true" | "false" - Note
        -- the use of a string rather than a boolean. Specifies whether explicit references
        -- to indexes are allowed inside the body of HTTP requests. If you want to
        -- configure access policies for domain sub-resources, such as specific indexes and
        -- domain APIs, you must disable this property. Default is true.
        -- "indices.fielddata.cache.size": "80" - Note the use of a string
        -- rather than a boolean. Specifies the percentage of heap space allocated to field
        -- data. Default is unbounded.
        -- "indices.query.bool.max_clause_count": "1024" - Note the use of a
        -- string rather than a boolean. Specifies the maximum number of clauses allowed in
        -- a Lucene boolean query. Default is 1,024. Queries with more than the permitted
        -- number of clauses result in a TooManyClauses error.
        -- For more information, see Advanced cluster parameters.
        AdvancedOptions: {string : string}
        -- Identity and Access Management (IAM) access policy as a JSON-formatted string.
        AccessPolicies: string
        -- Specify either dual stack or IPv4 as your IP address type. Dual stack allows you to
        -- share domain resources across IPv4 and IPv6 address types, and is the recommended
        -- option. If your IP address type is currently set to dual stack, you can't change it.
        IPAddressType: string
        -- Options to publish OpenSearch logs to Amazon CloudWatch Logs.
        LogPublishingOptions: {string : LogPublishingOption}
        -- Encryption at rest options for the domain.
        EncryptionAtRestOptions: EncryptionAtRestOptions
        -- Additional options for the domain endpoint, such as whether to require HTTPS for all
        -- traffic.
        DomainEndpointOptions: DomainEndpointOptions
        -- Node-to-node encryption options for the domain.
        NodeToNodeEncryptionOptions: NodeToNodeEncryptionOptions
        -- Options for fine-grained access control.
        AdvancedSecurityOptions: AdvancedSecurityOptionsInput
        IdentityCenterOptions: IdentityCenterOptionsInput
        -- Options for Auto-Tune.
        AutoTuneOptions: AutoTuneOptions
        -- This flag, when set to True, specifies whether the UpdateDomain request
        -- should return the results of a dry run analysis without actually applying the change. A
        -- dry run determines what type of deployment the update will cause.
        DryRun: boolean
        -- The type of dry run to perform.
        -- Basic only returns the type of deployment (blue/green or dynamic)
        -- that the update will cause.
        -- Verbose runs an additional check to validate the changes you're
        -- making. For more information, see Validating a domain update.
        DryRunMode: string
        -- Off-peak window options for the domain.
        OffPeakWindowOptions: OffPeakWindowOptions
        -- Service software update options for the domain.
        SoftwareUpdateOptions: SoftwareUpdateOptions
        -- Options for all machine learning features for the specified domain.
        AIMLOptions: AIMLOptionsInput
        -- Specifies the deployment strategy options for the domain.
        DeploymentStrategyOptions: DeploymentStrategyOptions
    end

    -- The results of an UpdateDomain request. Contains the status of the domain
    -- being updated.
    record UpdateDomainConfigOutput
        -- The status of the updated domain.
        DomainConfig: DomainConfig
        -- Results of the dry run performed in the update domain request.
        DryRunResults: DryRunResults
        -- The status of the dry run being performed on the domain, if any.
        DryRunProgressStatus: DryRunProgressStatus
    end

    record UpdateIndexInput
        DomainName: string
        -- The name of the index to update.
        IndexName: string
        -- The updated JSON schema for the index including any changes to mappings, settings, and semantic enrichment configuration.
        IndexSchema: any
    end

    record UpdateIndexOutput
        -- The status of the index update operation.
        Status: string
    end

    -- Container for request parameters to the UpdatePackage operation.
    record UpdatePackageInput
        -- The unique identifier for the package.
        PackageID: string
        -- Amazon S3 bucket and key for the package.
        PackageSource: PackageSource
        -- A new description of the package.
        PackageDescription: string
        -- Commit message for the updated file, which is shown as part of
        -- GetPackageVersionHistoryResponse.
        CommitMessage: string
        -- The updated configuration details for a package.
        PackageConfiguration: PackageConfiguration
        -- Encryption options for a package.
        PackageEncryptionOptions: PackageEncryptionOptions
    end

    -- Container for the response returned by the UpdatePackage
    -- operation.
    record UpdatePackageOutput
        -- Information about a package.
        PackageDetails: PackageDetails
    end

    enum PackageScopeOperationEnum
        "ADD"
        "OVERRIDE"
        "REMOVE"
    end

    record UpdatePackageScopeInput
        -- ID of the package whose scope is being updated.
        PackageID: string
        -- The operation to perform on the package scope (e.g., add/remove/override
        -- users).
        Operation: string
        -- List of users to be added or removed from the package scope.
        PackageUserList: {string}
    end

    record UpdatePackageScopeOutput
        -- ID of the package whose scope was updated.
        PackageID: string
        -- The operation that was performed on the package scope.
        Operation: string
        -- List of users who have access to the package after the scope update.
        PackageUserList: {string}
    end

    -- An exception for attempting to schedule a domain action during an unavailable time slot.
    record SlotNotAvailableException
        -- Alternate time slots during which OpenSearch Service has available capacity to schedule a domain action.
        SlotSuggestions: {number}
        -- A description of the error.
        message: string
    end

    record UpdateScheduledActionInput
        -- The name of the domain to reschedule an action for.
        DomainName: string
        -- The unique identifier of the action to reschedule. To retrieve this ID, send a ListScheduledActions request.
        ActionID: string
        -- The type of action to reschedule. Can be one of SERVICE_SOFTWARE_UPDATE,
        -- JVM_HEAP_SIZE_TUNING, or JVM_YOUNG_GEN_TUNING. To retrieve
        -- this value, send a ListScheduledActions request.
        ActionType: string
        -- When to schedule the action.
        -- NOW - Immediately schedules the update to happen in the current
        -- hour if there's capacity available.
        -- TIMESTAMP - Lets you specify a custom date and time to apply the
        -- update. If you specify this value, you must also provide a value for
        -- DesiredStartTime.
        -- OFF_PEAK_WINDOW - Marks the action to be picked up during an
        -- upcoming off-peak window. There's no guarantee that the change will be
        -- implemented during the next immediate window. Depending on capacity, it might
        -- happen in subsequent days.
        ScheduleAt: string
        -- The time to implement the change, in Coordinated Universal Time (UTC). Only specify
        -- this parameter if you set ScheduleAt to TIMESTAMP.
        DesiredStartTime: number
    end

    record UpdateScheduledActionOutput
        -- Information about the rescheduled action.
        ScheduledAction: ScheduledAction
    end

    record UpdateVpcEndpointInput
        -- The unique identifier of the endpoint.
        VpcEndpointId: string
        -- The security groups and/or subnets to add, remove, or modify.
        VpcOptions: VPCOptions
    end

    record UpdateVpcEndpointOutput
        -- The endpoint to be updated.
        VpcEndpoint: VpcEndpoint
    end

    -- Container for the request parameters to the UpgradeDomain
    -- operation.
    record UpgradeDomainInput
        -- Name of the OpenSearch Service domain that you want to upgrade.
        DomainName: string
        -- OpenSearch or Elasticsearch version to which you want to upgrade, in the format
        -- Opensearch_X.Y or Elasticsearch_X.Y.
        TargetVersion: string
        -- When true, indicates that an upgrade eligibility check needs to be performed. Does not
        -- actually perform the upgrade.
        PerformCheckOnly: boolean
        -- Only supports the override_main_response_version parameter and not other
        -- advanced options. You can only include this option when upgrading to an OpenSearch
        -- version. Specifies whether the domain reports its version as 7.10 so that it continues
        -- to work with Elasticsearch OSS clients and plugins.
        AdvancedOptions: {string : string}
    end

    -- Container for the response returned by UpgradeDomain operation.
    record UpgradeDomainOutput
        -- The unique identifier of the domain upgrade.
        UpgradeId: string
        -- The name of the domain that was upgraded.
        DomainName: string
        -- OpenSearch or Elasticsearch version that the domain was upgraded to.
        TargetVersion: string
        -- When true, indicates that an upgrade eligibility check was performed.
        PerformCheckOnly: boolean
        -- The advanced options configuration for the domain.
        AdvancedOptions: {string : string}
        -- Container for information about a configuration change happening on a domain.
        ChangeProgressDetails: ChangeProgressDetails
    end

end

return M
