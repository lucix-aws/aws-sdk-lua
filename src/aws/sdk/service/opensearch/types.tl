        -- Options to specify the subnets and security groups for an Amazon OpenSearch Service
        -- VPC endpoint.
        VpcOptions: VPCDerivedInfo
        -- The current status of the endpoint.
        Status: string
        -- The connection endpoint ID for connecting to the domain.
