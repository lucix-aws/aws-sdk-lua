        StartDate: number
        -- The end date for the metric point. The ending time must be formatted as yyyy-mm-ddThh:mm:ss. For example, 2022-06-12T12:00:00.000Z.
        EndDate: number
        Value: number
        -- The status of the metric point.
        Status: string
    end

