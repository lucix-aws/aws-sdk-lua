        OwnerId: string
        -- The description for the snapshot.
        Description: string
        -- The size of the volume, in GiB.
        VolumeSize: number
        -- Indicates whether the snapshot is encrypted.
        Encrypted: boolean
        -- The Amazon Resource Name (ARN) of the KMS key that was used to protect the
