    -- Describes a packet header statement.
    record PacketHeaderStatement
        -- The source addresses.
        SourceAddresses: {string}
        -- The destination addresses.
        DestinationAddresses: {string}
        -- The source ports.
        SourcePorts: {string}
        -- The destination ports.
