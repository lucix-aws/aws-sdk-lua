        -- io1: 100 - 64,000 IOPS
        -- io2: 100 - 256,000 IOPS
        -- Instances built on the Nitro System can support up to 256,000 IOPS. Other instances can support up to 32,000
        -- IOPS.
        Iops: number
        -- The identifier of the KMS key to use for Amazon EBS encryption.
        -- If this parameter is not specified, your KMS key for Amazon EBS is used. If KmsKeyId is
        -- specified, the encrypted state must be true.
