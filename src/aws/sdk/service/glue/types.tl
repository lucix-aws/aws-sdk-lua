    end

    enum S3EncryptionMode
        "DISABLED"
        "SSE-KMS"
        "SSE-S3"
    end

    -- Specifies how Amazon Simple Storage Service (Amazon S3) data should be encrypted.
    record S3Encryption
        -- The encryption mode to use for Amazon S3 data.
