    -- Specifies a transform that removes rows of repeating data from a data set.
    record DropDuplicates
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names.
        Inputs: {string}
        -- The name of the columns to be merged or removed if repeating.
        Columns: {{string}}
    end

    -- Specifies a transform that chooses the data property keys that you want to drop.
    record DropFields
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names.
        Inputs: {string}
        -- A JSON path to a variable in the data structure.
        Paths: {{string}}
    end

    -- Represents whether certain values are recognized as null values for removal.
    record NullCheckBoxList
        -- Specifies that an empty string is considered as a null value.
        IsEmpty: boolean
        -- Specifies that a value spelling out the word 'null' is considered as a null value.
        IsNullString: boolean
        -- Specifies that an integer value of -1 is considered as a null value.
        IsNegOne: boolean
    end

    -- A structure representing the datatype of the value.
    record Datatype
        -- The datatype of the value.
        Id: string
        -- A label assigned to the datatype.
        Label: string
    end

    -- Represents a custom null value such as a zeros or other value being used as a null placeholder unique to the dataset.
    record NullValueField
        -- The value of the null placeholder.
        Value: string
        -- The datatype of the value.
        Datatype: Datatype
    end

    -- Specifies a transform that removes columns from the dataset if all values in the column are 'null'. By default, Glue Studio will recognize null objects, but some values such as empty strings, strings that are "null", -1 integers or other placeholders such as zeros, are not automatically recognized as nulls.
    record DropNullFields
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names.
        Inputs: {string}
        -- A structure that represents whether certain values are recognized as null values for removal.
        NullCheckBoxList: NullCheckBoxList
        -- A structure that specifies a list of NullValueField structures that represent a custom null value such as zero or other value being used as a null placeholder unique to the dataset.
        -- The DropNullFields transform removes custom null values only if both the value of the null placeholder and the datatype match the data.
        NullTextList: {NullValueField}
    end

    enum ParamType
        "str"
        "int"
        "float"
        "complex"
        "bool"
        "list"
        "null"
    end

    -- Specifies the parameters in the config file of the dynamic transform.
    record TransformConfigParameter
        -- Specifies the name of the parameter in the config file of the dynamic transform.
        Name: string
        -- Specifies the parameter type in the config file of the dynamic transform.
        Type: string
        -- Specifies the validation rule in the config file of the dynamic transform.
        ValidationRule: string
        -- Specifies the validation message in the config file of the dynamic transform.
        ValidationMessage: string
        -- Specifies the value of the parameter in the config file of the dynamic transform.
        Value: {string}
        -- Specifies the list type of the parameter in the config file of the dynamic transform.
        ListType: string
        -- Specifies whether the parameter is optional or not in the config file of the dynamic transform.
        IsOptional: boolean
    end

    -- Specifies the set of parameters needed to perform the dynamic transform.
    record DynamicTransform
        -- Specifies the name of the dynamic transform.
        Name: string
        -- Specifies the name of the dynamic transform as it appears in the Glue Studio visual editor.
        TransformName: string
        -- Specifies the inputs for the dynamic transform that are required.
        Inputs: {string}
        -- Specifies the parameters of the dynamic transform.
        Parameters: {TransformConfigParameter}
        -- Specifies the name of the function of the dynamic transform.
        FunctionName: string
        -- Specifies the path of the dynamic transform source and config files.
        Path: string
        -- This field is not used and will be deprecated in future release.
        Version: string
        -- Specifies the data schema for the dynamic transform.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies additional options for DynamoDB ELT catalog operations.
    record DDBELTCatalogAdditionalOptions
        -- Specifies the DynamoDB export configuration for the ELT operation.
        DynamodbExport: string
        -- Specifies whether to unnest DynamoDB JSON format. When set to true, nested JSON structures in DynamoDB items are flattened.
        DynamodbUnnestDDBJson: boolean
    end

    -- Specifies a DynamoDB data source in the Glue Data Catalog.
    record DynamoDBCatalogSource
        -- The name of the data source.
        Name: string
        -- The name of the database to read from.
        Database: string
        -- The name of the table in the database to read from.
        Table: string
        -- Specifies whether Point-in-Time Recovery (PITR) is enabled for the DynamoDB table. When set to true,
        -- allows reading from a specific point in time. The default value is false.
        PitrEnabled: boolean
        -- Specifies additional connection options for the DynamoDB data source.
        AdditionalOptions: DDBELTCatalogAdditionalOptions
    end

    enum DdbExportType
        "ddb"
        "s3"
    end

    -- Specifies connection options for DynamoDB ELT (Extract, Load, Transform) operations. This structure contains configuration parameters for connecting
    -- to and extracting data from DynamoDB tables using the ELT connector.
    record DDBELTConnectionOptions
        -- Specifies the export type for DynamoDB data extraction. This parameter determines how data is exported from the DynamoDB table during the ELT process.
        DynamodbExport: string
        -- A boolean value that specifies whether to unnest DynamoDB JSON format during data extraction. When set to true, the connector will
        -- flatten nested JSON structures from DynamoDB items. When set to false, the original DynamoDB JSON structure is preserved.
        DynamodbUnnestDDBJson: boolean
        -- The Amazon Resource Name (ARN) of the DynamoDB table to extract data from. This parameter specifies the source table for the ELT operation.
        DynamodbTableArn: string
        -- The name of the Amazon S3 bucket used for intermediate storage during the DynamoDB ELT process. This bucket is used to temporarily store exported
        -- DynamoDB data before it is processed by the ELT job.
        DynamodbS3Bucket: string
        -- The S3 object key prefix for files stored in the intermediate S3 bucket during the DynamoDB ELT process. This prefix helps organize and identify the
        -- temporary files created during data extraction.
        DynamodbS3Prefix: string
        -- The Amazon Web Services account ID of the owner of the S3 bucket specified in DynamodbS3Bucket. This parameter is required when the S3 bucket is owned by
        -- a different Amazon Web Services account than the one running the ELT job, enabling cross-account access to the intermediate storage bucket.
        DynamodbS3BucketOwner: string
        -- The Amazon Resource Name (ARN) of the Amazon Web Services Security Token Service (STS) role to assume for accessing DynamoDB and S3 resources during
        -- the ELT operation.
        -- This role must have the necessary permissions to read from the DynamoDB table and write to the intermediate S3 bucket.
        DynamodbStsRoleArn: string
    end

    -- Specifies a DynamoDB ELT connector source for extracting data from DynamoDB tables.
    record DynamoDBELTConnectorSource
        -- The name of the DynamoDB ELT connector source.
        Name: string
        -- The connection options for the DynamoDB ELT connector source.
        ConnectionOptions: DDBELTConnectionOptions
        -- Specifies the data schema for the DynamoDB ELT connector source.
        OutputSchemas: {GlueSchema}
    end

