        -- The update behavior when the crawler finds a changed schema.
        UpdateBehavior: string
        -- Specifies the table in the database that the schema change policy applies to.
        Table: string
        -- Specifies the database that the schema change policy applies to.
        Database: string
    end

    -- Specifies a target that writes to a Delta Lake data source in Amazon S3.
    record S3DeltaDirectTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- Specifies native partitioning using a sequence of keys.
        PartitionKeys: {{string}}
        -- The Amazon S3 path of your Delta Lake data source to write to.
        Path: string
        -- Specifies how the data is compressed. This is generally not necessary if the data has a standard file extension. Possible values are "gzip" and "bzip").
        Compression: string
        -- Specifies the number of target partitions for distributing Delta Lake dataset files across Amazon S3.
        NumberTargetPartitions: string
        -- Specifies the data output format for the target.
        Format: string
        -- Specifies additional connection options for the connector.
        AdditionalOptions: {string : string}
        -- A policy that specifies update behavior for the crawler.
        SchemaChangePolicy: DirectSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 Delta direct target. When set to true,
        -- data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
    end

    -- Specifies a Delta Lake data source stored in Amazon S3.
    record S3DeltaSource
        -- The name of the Delta Lake source.
        Name: string
        -- A list of the Amazon S3 paths to read from.
        Paths: {string}
        -- Specifies additional connection options.
        AdditionalDeltaOptions: {string : string}
        -- Specifies additional options for the connector.
        AdditionalOptions: S3DirectSourceAdditionalOptions
        -- Specifies the data schema for the Delta Lake source.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a data target that writes to Amazon S3.
    record S3DirectTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- Specifies native partitioning using a sequence of keys.
        PartitionKeys: {{string}}
        -- A single Amazon S3 path to write to.
        Path: string
        -- Specifies how the data is compressed. This is generally not necessary if the data has a standard file extension. Possible values are "gzip" and "bzip").
        Compression: string
        -- Specifies the number of target partitions when writing data directly to Amazon S3.
        NumberTargetPartitions: string
        -- Specifies the data output format for the target.
        Format: string
        -- A policy that specifies update behavior for the crawler.
        SchemaChangePolicy: DirectSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 direct target. When set to true,
        -- data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
        -- Specifies the data schema for the S3 direct target.
        OutputSchemas: {GlueSchema}
    end

    enum ParquetCompressionType
        "snappy"
        "lzo"
        "gzip"
        "brotli"
        "lz4"
        "uncompressed"
        "none"
    end

    -- Specifies an S3 Excel data source.
    record S3ExcelSource
        -- The name of the S3 Excel data source.
        Name: string
        -- The S3 paths where the Excel files are located.
        Paths: {string}
        -- The compression format used for the Excel files.
        CompressionType: string
        -- Patterns to exclude specific files or paths from processing.
        Exclusions: {string}
        -- Defines the size of file groups for batch processing.
        GroupSize: string
        -- Specifies how files should be grouped for processing.
        GroupFiles: string
        -- Indicates whether to recursively process subdirectories.
        Recurse: boolean
        -- The maximum number of processing bands to use.
        MaxBand: number
        -- The maximum number of files to process in each band.
        MaxFilesInBand: number
        -- Additional configuration options for S3 direct source processing.
        AdditionalOptions: S3DirectSourceAdditionalOptions
        -- The number of rows to process from each Excel file.
        NumberRows: number
        -- The number of rows to skip at the end of each Excel file.
        SkipFooter: number
        -- The Glue schemas to apply to the processed data.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a data target that writes to Amazon S3 in Apache Parquet columnar storage.
    record S3GlueParquetTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- Specifies native partitioning using a sequence of keys.
        PartitionKeys: {{string}}
        -- A single Amazon S3 path to write to.
        Path: string
        -- Specifies how the data is compressed. This is generally not necessary if the data has a standard file extension. Possible values are "gzip" and "bzip").
        Compression: string
        -- Specifies the number of target partitions for Parquet files when writing to Amazon S3 using Glue.
        NumberTargetPartitions: string
        -- A policy that specifies update behavior for the crawler.
        SchemaChangePolicy: DirectSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 Glue Parquet target. When set to true,
        -- data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
    end

    -- Specifies a target that writes to a Hudi data source in the Glue Data Catalog.
    record S3HudiCatalogTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- Specifies native partitioning using a sequence of keys.
        PartitionKeys: {{string}}
        -- The name of the table in the database to write to.
        Table: string
        -- The name of the database to write to.
        Database: string
        -- Specifies additional connection options for the connector.
        AdditionalOptions: {string : string}
        -- A policy that specifies update behavior for the crawler.
        SchemaChangePolicy: CatalogSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 Hudi catalog target. When set to true,
        -- data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
        -- Specifies the data schema for the S3 Hudi catalog target.
        OutputSchemas: {GlueSchema}
    end

    enum HudiTargetCompressionType
        "gzip"
        "lzo"
        "uncompressed"
        "snappy"
    end

    -- Specifies a target that writes to a Hudi data source in Amazon S3.
    record S3HudiDirectTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- The Amazon S3 path of your Hudi data source to write to.
        Path: string
        -- Specifies how the data is compressed. This is generally not necessary if the data has a standard file extension. Possible values are "gzip" and "bzip").
        Compression: string
        -- Specifies the number of target partitions for distributing Hudi dataset files across Amazon S3.
        NumberTargetPartitions: string
        -- Specifies native partitioning using a sequence of keys.
        PartitionKeys: {{string}}
        -- Specifies the data output format for the target.
        Format: string
        -- Specifies additional connection options for the connector.
        AdditionalOptions: {string : string}
        -- A policy that specifies update behavior for the crawler.
        SchemaChangePolicy: DirectSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 Hudi direct target. When set to true,
        -- data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
    end

    -- Specifies a Hudi data source stored in Amazon S3.
    record S3HudiSource
        -- The name of the Hudi source.
        Name: string
        -- A list of the Amazon S3 paths to read from.
        Paths: {string}
        -- Specifies additional connection options.
        AdditionalHudiOptions: {string : string}
        -- Specifies additional options for the connector.
        AdditionalOptions: S3DirectSourceAdditionalOptions
        -- Specifies the data schema for the Hudi source.
        OutputSchemas: {GlueSchema}
    end

    enum HyperTargetCompressionType
        "uncompressed"
    end

    -- Specifies a HyperDirect data target that writes to Amazon S3.
    record S3HyperDirectTarget
        -- The unique identifier for the HyperDirect target node.
        Name: string
        -- Specifies the input source for the HyperDirect target.
        Inputs: {string}
        -- Specifies the data output format for the HyperDirect target.
        Format: string
        -- Defines the partitioning strategy for the output data.
        PartitionKeys: {{string}}
        -- The S3 location where the output data will be written.
        Path: string
        -- The compression type to apply to the output data.
        Compression: string
        -- Defines how schema changes are handled during write operations.
        SchemaChangePolicy: DirectSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 Hyper direct target. When set to true, data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
        -- Specifies the data schema for the S3 Hyper direct target.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies an Apache Iceberg catalog target that writes data to Amazon S3 and registers the table in the Glue Data Catalog.
    record S3IcebergCatalogTarget
        -- The name of the Iceberg catalog target.
        Name: string
        -- The input connection for the Iceberg catalog target.
        Inputs: {string}
        -- A list of partition keys for the Iceberg table.
        PartitionKeys: {{string}}
        -- The name of the table to write to in the catalog.
        Table: string
        -- The name of the database to write to.
        Database: string
        -- Specifies additional connection options for the Iceberg catalog target.
        AdditionalOptions: {string : string}
        -- The policy for handling schema changes in the catalog target.
        SchemaChangePolicy: CatalogSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 Iceberg catalog target. When set to true, data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
    end

    enum IcebergTargetCompressionType
        "gzip"
        "lzo"
        "uncompressed"
        "snappy"
    end

    -- Specifies a target that writes to an Iceberg data source in Amazon S3.
    record S3IcebergDirectTarget
        -- Specifies the unique identifier for the Iceberg target node in your data pipeline.
        Name: string
        -- Defines the single input source that provides data to this Iceberg target.
        Inputs: {string}
        -- Specifies the columns used to partition the Iceberg table data in S3.
        PartitionKeys: {{string}}
        -- Defines the S3 location where the Iceberg table data will be stored.
        Path: string
        -- Specifies the file format used for storing Iceberg table data (e.g., Parquet, ORC).
        Format: string
        -- Provides additional configuration options for customizing the Iceberg table behavior.
        AdditionalOptions: {string : string}
        -- Defines how schema changes are handled when writing data to the Iceberg table.
        SchemaChangePolicy: DirectSchemaChangePolicy
        AutoDataQuality: AutoDataQuality
        -- Specifies the compression codec used for Iceberg table files in S3.
        Compression: string
        -- Sets the number of target partitions for distributing Iceberg table files across S3.
        NumberTargetPartitions: string
        -- Specifies the data schema for the S3 Iceberg direct target.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a JSON data store stored in Amazon S3.
    record S3JsonSource
        -- The name of the data store.
        Name: string
        -- A list of the Amazon S3 paths to read from.
        Paths: {string}
        -- Specifies how the data is compressed. This is generally not necessary if the data has a standard file extension. Possible values are "gzip" and "bzip").
        CompressionType: string
        -- A string containing a JSON list of Unix-style glob patterns to exclude. For example, "[\"**.pdf\"]" excludes all PDF files.
        Exclusions: {string}
        -- The target group size in bytes. The default is computed based on the input data size and the size of your cluster. When there are fewer than 50,000 input files, "groupFiles" must be set to "inPartition" for this to take effect.
        GroupSize: string
        -- Grouping files is turned on by default when the input contains more than 50,000 files. To turn on grouping with fewer than 50,000 files, set this parameter to "inPartition". To disable grouping when there are more than 50,000 files, set this parameter to "none".
        GroupFiles: string
        -- If set to true, recursively reads files in all subdirectories under the specified paths.
        Recurse: boolean
        -- This option controls the duration in milliseconds after which the s3 listing is likely to be consistent. Files with modification timestamps falling within the last maxBand milliseconds are tracked specially when using JobBookmarks to account for Amazon S3 eventual consistency. Most users don't need to set this option. The default is 900000 milliseconds, or 15 minutes.
        MaxBand: number
        -- This option specifies the maximum number of files to save from the last maxBand seconds. If this number is exceeded, extra files are skipped and only processed in the next job run.
        MaxFilesInBand: number
        -- Specifies additional connection options.
        AdditionalOptions: S3DirectSourceAdditionalOptions
        -- A JsonPath string defining the JSON data.
        JsonPath: string
        -- A Boolean value that specifies whether a single record can span multiple lines. This can occur when a field contains a quoted new-line character. You must set this option to True if any record spans multiple lines. The default value is False, which allows for more aggressive file-splitting during parsing.
        Multiline: boolean
        -- Specifies the data schema for the S3 JSON source.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies an Apache Parquet data store stored in Amazon S3.
    record S3ParquetSource
        -- The name of the data store.
        Name: string
        -- A list of the Amazon S3 paths to read from.
        Paths: {string}
        -- Specifies how the data is compressed. This is generally not necessary if the data has a standard file extension. Possible values are "gzip" and "bzip").
        CompressionType: string
        -- A string containing a JSON list of Unix-style glob patterns to exclude. For example, "[\"**.pdf\"]" excludes all PDF files.
        Exclusions: {string}
        -- The target group size in bytes. The default is computed based on the input data size and the size of your cluster. When there are fewer than 50,000 input files, "groupFiles" must be set to "inPartition" for this to take effect.
        GroupSize: string
        -- Grouping files is turned on by default when the input contains more than 50,000 files. To turn on grouping with fewer than 50,000 files, set this parameter to "inPartition". To disable grouping when there are more than 50,000 files, set this parameter to "none".
        GroupFiles: string
        -- If set to true, recursively reads files in all subdirectories under the specified paths.
        Recurse: boolean
        -- This option controls the duration in milliseconds after which the s3 listing is likely to be consistent. Files with modification timestamps falling within the last maxBand milliseconds are tracked specially when using JobBookmarks to account for Amazon S3 eventual consistency. Most users don't need to set this option. The default is 900000 milliseconds, or 15 minutes.
        MaxBand: number
        -- This option specifies the maximum number of files to save from the last maxBand seconds. If this number is exceeded, extra files are skipped and only processed in the next job run.
        MaxFilesInBand: number
        -- Specifies additional connection options.
        AdditionalOptions: S3DirectSourceAdditionalOptions
        -- Specifies the data schema for the S3 Parquet source.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a transform that chooses the data property keys that you want to keep.
    record SelectFields
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names.
        Inputs: {string}
        -- A JSON path to a variable in the data structure.
        Paths: {{string}}
    end

    -- Specifies a transform that chooses one DynamicFrame from a collection of DynamicFrames. The output is the selected DynamicFrame
    record SelectFromCollection
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names.
        Inputs: {string}
        -- The index for the DynamicFrame to be selected.
        Index: number
    end

    -- Specifies configuration for Snowflake nodes in Glue Studio.
    record SnowflakeNodeData
        -- Specifies how retrieved data is specified. Valid values: "table",
        -- "query".
        SourceType: string
        -- Specifies a Glue Data Catalog Connection to a Snowflake endpoint.
        Connection: Option
        -- Specifies a Snowflake database schema for your node to use.
        Schema: string
        -- Specifies a Snowflake table for your node to use.
        Table: string
        -- Specifies a Snowflake database for your node to use.
        Database: string
        -- Not currently used.
        TempDir: string
        -- Not currently used.
        IamRole: Option
        -- Specifies additional options passed to the Snowflake connector. If options are specified
        -- elsewhere in this node, this will take precedence.
        AdditionalOptions: {string : string}
        -- A SQL string used to retrieve data with the query sourcetype.
        SampleQuery: string
        -- A SQL string run before the Snowflake connector performs its standard actions.
        PreAction: string
        -- A SQL string run after the Snowflake connector performs its standard actions.
        PostAction: string
        -- Specifies what action to take when writing to a table with preexisting data. Valid values:
        -- append, merge, truncate, drop.
        Action: string
        -- Used when Action is append. Specifies the resolution behavior when a row
        -- already exists. If true, preexisting rows will be updated. If false, those rows will be inserted.
        Upsert: boolean
        -- Specifies a merge action. Valid values: simple, custom. If
        -- simple, merge behavior is defined by MergeWhenMatched and
        -- MergeWhenNotMatched. If custom, defined by MergeClause.
        MergeAction: string
        -- Specifies how to resolve records that match preexisting data when merging. Valid values:
        -- update, delete.
        MergeWhenMatched: string
        -- Specifies how to process records that do not match preexisting data when merging. Valid
        -- values: insert, none.
        MergeWhenNotMatched: string
        -- A SQL statement that specifies a custom merge behavior.
        MergeClause: string
        -- The name of a staging table used when performing merge or upsert append
        -- actions. Data is written to this table, then moved to table by a generated
        -- postaction.
        StagingTable: string
        -- Specifies the columns combined to identify a record when detecting matches for merges and
        -- upserts. A list of structures with value, label and
        -- description keys. Each structure describes a column.
        SelectedColumns: {Option}
        -- Specifies whether automatic query pushdown is enabled. If pushdown
        -- is enabled, then when a query is run on Spark, if part of the query can be "pushed down" to
        -- the
        -- Snowflake server, it is pushed down. This improves performance of some queries.
        AutoPushdown: boolean
        -- Manually defines the target schema for the node. A list of structures with value
        -- , label and description keys. Each structure defines a column.
        TableSchema: {Option}
    end

    -- Specifies a Snowflake data source.
    record SnowflakeSource
        -- The name of the Snowflake data source.
        Name: string
        -- Configuration for the Snowflake data source.
        Data: SnowflakeNodeData
        -- Specifies user-defined schemas for your output data.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a Snowflake target.
    record SnowflakeTarget
        -- The name of the Snowflake target.
        Name: string
        -- Specifies the data of the Snowflake target node.
        Data: SnowflakeNodeData
        -- The nodes that are inputs to the data target.
        Inputs: {string}
    end

    -- Specifies a connector to an Apache Spark data source.
    record SparkConnectorSource
        -- The name of the data source.
        Name: string
        -- The name of the connection that is associated with the connector.
        ConnectionName: string
        -- The name of a connector that assists with accessing the data store in Glue Studio.
        ConnectorName: string
        -- The type of connection, such as marketplace.spark or custom.spark, designating a connection to an Apache Spark data store.
        ConnectionType: string
        -- Additional connection options for the connector.
        AdditionalOptions: {string : string}
        -- Specifies data schema for the custom spark source.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a target that uses an Apache Spark connector.
    record SparkConnectorTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- The name of a connection for an Apache Spark connector.
        ConnectionName: string
        -- The name of an Apache Spark connector.
        ConnectorName: string
        -- The type of connection, such as marketplace.spark or custom.spark, designating a connection to an Apache Spark data store.
        ConnectionType: string
        -- Additional connection options for the connector.
        AdditionalOptions: {string : string}
        -- Specifies the data schema for the custom spark target.
        OutputSchemas: {GlueSchema}
    end

    -- Represents a single entry in the list of values for SqlAliases.
    record SqlAlias
        -- A table, or a column in a table.
        From: string
        -- A temporary name given to a table, or a column in a table.
        Alias: string
    end

    -- Specifies a transform where you enter a SQL query using Spark SQL syntax to transform the data. The output is a single DynamicFrame.
    record SparkSQL
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names. You can associate a table name with each input node to use in the SQL query. The name you choose must meet the Spark SQL naming restrictions.
        Inputs: {string}
        -- A SQL query that must use Spark SQL syntax and return a single data set.
        SqlQuery: string
        -- A list of aliases. An alias allows you to specify what name to use in the SQL for a given input. For example, you have a datasource named "MyDataSource". If you specify From as MyDataSource, and Alias as SqlName, then in your SQL you can do:
        -- select *
        -- from SqlName
        -- and that gets data from MyDataSource.
        SqlAliases: {SqlAlias}
        -- Specifies the data schema for the SparkSQL transform.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a transform that writes samples of the data to an Amazon S3 bucket.
    record Spigot
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names.
        Inputs: {string}
        -- A path in Amazon S3 where the transform will write a subset of records from the dataset to a JSON file in an Amazon S3 bucket.
        Path: string
        -- Specifies a number of records to write starting from the beginning of the dataset.
        Topk: number
        -- The probability (a decimal value with a maximum value of 1) of picking any given record. A value of 1 indicates that each row read from the dataset should be included in the sample output.
        Prob: number
    end

    -- Specifies a transform that splits data property keys into two DynamicFrames. The output is a collection of DynamicFrames: one with selected data property keys, and one with the remaining data property keys.
    record SplitFields
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names.
        Inputs: {string}
        -- A JSON path to a variable in the data structure.
        Paths: {{string}}
    end

    enum UnionType
        "ALL"
        "DISTINCT"
    end

    -- Specifies a transform that combines the rows from two or more datasets into a single result.
    record Union
        -- The name of the transform node.
        Name: string
        -- The node ID inputs to the transform.
        Inputs: {string}
        -- Indicates the type of Union transform.
        -- Specify ALL to join all rows from data sources to the resulting DynamicFrame. The resulting union does not remove duplicate rows.
        -- Specify DISTINCT to remove duplicate rows in the resulting DynamicFrame.
        UnionType: string
    end

    -- Specifies code that runs when a job is run.
    record JobCommand
        -- The name of the job command. For an Apache Spark ETL job, this must be
        -- glueetl. For a Python shell job, it must be pythonshell.
        -- For an Apache Spark streaming ETL job, this must be gluestreaming. For a Ray job,
        -- this must be glueray.
        Name: string
        -- Specifies the Amazon Simple Storage Service (Amazon S3) path to a script that runs a
        -- job.
        ScriptLocation: string
        -- The Python version being used to run a Python shell job. Allowed values are 2 or 3.
        PythonVersion: string
        -- In Ray jobs, Runtime is used to specify the versions of Ray, Python and additional
        -- libraries available in your environment. This field is not used in other job types. For
        -- supported runtime environment values, see Supported Ray runtime environments
        -- in the Glue Developer Guide.
        Runtime: string
    end

    -- Specifies the connections used by a job.
    record ConnectionsList
        -- A list of connections used by the job.
        Connections: {string}
    end

    enum ExecutionClass
        "FLEX"
        "STANDARD"
    end

    -- An execution property of a job.
    record ExecutionProperty
        -- The maximum number of concurrent runs allowed for the job.
        -- The default is 1. An error is returned when this threshold is reached.
        -- The maximum value you can specify is controlled by a service limit.
        MaxConcurrentRuns: number
    end

    enum JobMode
        "SCRIPT"
        "VISUAL"
        "NOTEBOOK"
    end

    enum SourceControlAuthStrategy
        "PERSONAL_ACCESS_TOKEN"
        "AWS_SECRETS_MANAGER"
    end

    enum SourceControlProvider
        "GITHUB"
        "GITLAB"
        "BITBUCKET"
        "AWS_CODE_COMMIT"
    end

    -- The details for a source control configuration for a job, allowing synchronization of job artifacts to or from a remote repository.
    record SourceControlDetails
        -- The provider for the remote repository.
        Provider: string
        -- The name of the remote repository that contains the job artifacts.
        Repository: string
        -- The owner of the remote repository that contains the job artifacts.
        Owner: string
        -- An optional branch in the remote repository.
        Branch: string
        -- An optional folder in the remote repository.
        Folder: string
        -- The last commit ID for a commit in the remote repository.
        LastCommitId: string
        -- The type of authentication, which can be an authentication token stored in Amazon Web Services Secrets Manager, or a personal access token.
        AuthStrategy: string
        -- The value of an authorization token.
        AuthToken: string
    end

    -- A structure used as a protocol between query engines and Lake Formation or Glue. Contains both a Lake Formation generated authorization identifier and information from the request's authorization context.
    record QuerySessionContext
        -- A unique identifier generated by the query engine for the query.
        QueryId: string
        -- A timestamp provided by the query engine for when the query started.
        QueryStartTime: number
        -- An identifier string for the consumer cluster.
        ClusterId: string
        -- A cryptographically generated query identifier generated by Glue or Lake Formation.
        QueryAuthorizationId: string
        -- An opaque string-string map passed by the query engine.
        AdditionalContext: {string : string}
    end

    record BatchGetPartitionInput
        -- The ID of the Data Catalog where the partitions in question reside.
        -- If none is supplied, the Amazon Web Services account ID is used by default.
        CatalogId: string
        -- The name of the catalog database where the partitions reside.
        DatabaseName: string
        -- The name of the partitions' table.
        TableName: string
        -- A list of partition values identifying the partitions to retrieve.
        PartitionsToGet: {PartitionValueList}
        AuditContext: AuditContext
        QuerySessionContext: QuerySessionContext
    end

    -- Represents a slice of table data.
    record Partition
        -- The values of the partition.
        Values: {string}
        -- The name of the catalog database in which to create the partition.
        DatabaseName: string
        -- The name of the database table in which to create the partition.
        TableName: string
        -- The time at which the partition was created.
        CreationTime: number
        -- The last time at which the partition was accessed.
        LastAccessTime: number
        -- Provides information about the physical
        -- location where the partition is stored.
        StorageDescriptor: StorageDescriptor
        -- These key-value pairs define partition parameters.
        Parameters: {string : string}
        -- The last time at which column statistics were computed for this
        -- partition.
        LastAnalyzedTime: number
        -- The ID of the Data Catalog in which the partition resides.
        CatalogId: string
    end

    record BatchGetPartitionOutput
        -- A list of the requested partitions.
        Partitions: {Partition}
        -- A list of the partition values in the request for which partitions were not
        -- returned.
        UnprocessedKeys: {PartitionValueList}
    end

    enum FederationSourceErrorCode
        "AccessDeniedException"
        "EntityNotFoundException"
        "InvalidCredentialsException"
        "InvalidInputException"
        "InvalidResponseException"
        "OperationTimeoutException"
        "OperationNotSupportedException"
        "InternalServiceException"
        "PartialFailureException"
        "ThrottlingException"
    end

    -- A federation source failed.
    record FederationSourceException
        -- The error code of the problem.
        FederationSourceErrorCode: string
        -- The message describing the problem.
        Message: string
    end

    -- A federation source failed, but the operation may be retried.
    record FederationSourceRetryableException
        -- A message describing the problem.
        Message: string
    end

    -- An error that indicates your data is in an invalid state.
    record InvalidStateException
        -- A message describing the problem.
        Message: string
    end

    enum TableOptimizerType
        "compaction"
        "retention"
        "orphan_file_deletion"
    end

    -- Represents a table optimizer to retrieve in the BatchGetTableOptimizer operation.
    record BatchGetTableOptimizerEntry
        -- The Catalog ID of the table.
        catalogId: string
        -- The name of the database in the catalog in which the table resides.
        databaseName: string
        -- The name of the table.
        tableName: string
    end

    record BatchGetTableOptimizerInput
        -- A list of BatchGetTableOptimizerEntry objects specifying the table optimizers to retrieve.
        Entries: {BatchGetTableOptimizerEntry}
    end

    -- Contains details on one of the errors in the error list returned by the BatchGetTableOptimizer operation.
    record BatchGetTableOptimizerError
        -- An ErrorDetail object containing code and message details about the error.
        error: ErrorDetail
        -- The Catalog ID of the table.
        catalogId: string
        -- The name of the database in the catalog in which the table resides.
        databaseName: string
        -- The name of the table.
        tableName: string
    end

    enum CompactionStrategy
        "binpack"
        "sort"
        "z-order"
    end

    -- The configuration for an Iceberg compaction optimizer. This configuration defines parameters for optimizing the layout of data files in Iceberg tables.
    record IcebergCompactionConfiguration
        -- The strategy to use for compaction. Valid values are:
        -- binpack: Combines small files into larger files, typically targeting sizes over 100MB, while applying any pending deletes.
        -- This is the recommended compaction strategy for most use cases.
        -- sort: Organizes data based on specified columns which are sorted hierarchically during compaction, improving query
        -- performance for filtered operations. This strategy is recommended when your queries frequently filter on specific columns. To use this strategy,
        -- you must first define a sort order in your Iceberg table properties using the sort_order table property.
        -- z-order: Optimizes data organization by blending multiple attributes into a single scalar value that can be used for sorting,
        -- allowing efficient querying across multiple dimensions. This strategy is recommended when you need to query data across multiple dimensions
        -- simultaneously. To use this strategy, you must first define a sort order in your Iceberg table properties using the
        -- sort_order table property.
        -- If an input is not provided, the default value 'binpack' will be used.
        strategy: string
        -- The minimum number of data files that must be present in a partition before compaction will actually compact files. This parameter helps control when compaction is triggered, preventing unnecessary compaction operations on partitions with few files. If an input is not provided, the default value 100 will be used.
        minInputFiles: number
        -- The minimum number of deletes that must be present in a data file to make it eligible for compaction. This parameter helps optimize compaction by focusing on files that contain a significant number of delete operations, which can improve query performance by removing deleted records. If an input is not provided, the default value 1 will be used.
        deleteFileThreshold: number
    end

    -- The configuration for a compaction optimizer. This configuration defines how data files in your table will be compacted to improve
    -- query performance and reduce storage costs.
    record CompactionConfiguration
        -- The configuration for an Iceberg compaction optimizer.
        icebergConfiguration: IcebergCompactionConfiguration
    end

    -- The configuration for an Iceberg orphan file deletion optimizer.
    record IcebergOrphanFileDeletionConfiguration
        -- The number of days that orphan files should be retained before file deletion. If an input is not provided, the default value 3 will be used.
        orphanFileRetentionPeriodInDays: number
        -- Specifies a directory in which to look for files (defaults to the table's location). You may choose a sub-directory rather than the top-level table location.
        location: string
        -- The interval in hours between orphan file deletion job runs. This parameter controls how frequently the orphan file deletion optimizer will run to clean up orphan files. The value must be between 3 and 168 hours (7 days). If an input is not provided, the default value 24 will be used.
        runRateInHours: number
    end

    -- The configuration for an orphan file deletion optimizer.
    record OrphanFileDeletionConfiguration
        -- The configuration for an Iceberg orphan file deletion optimizer.
        icebergConfiguration: IcebergOrphanFileDeletionConfiguration
    end

    -- The configuration for an Iceberg snapshot retention optimizer.
    record IcebergRetentionConfiguration
        -- The number of days to retain the Iceberg snapshots. If an input is not provided, the corresponding Iceberg table configuration field will be used or if not present, the default value 5 will be used.
        snapshotRetentionPeriodInDays: number
        -- The number of Iceberg snapshots to retain within the retention period. If an input is not provided, the corresponding Iceberg table configuration field will be used or if not present, the default value 1 will be used.
        numberOfSnapshotsToRetain: number
        -- If set to false, snapshots are only deleted from table metadata, and the underlying data and metadata files are not deleted.
        cleanExpiredFiles: boolean
        -- The interval in hours between retention job runs. This parameter controls how frequently the retention optimizer will run to clean up expired snapshots. The value must be between 3 and 168 hours (7 days). If an input is not provided, the default value 24 will be used.
        runRateInHours: number
    end

    -- The configuration for a snapshot retention optimizer.
    record RetentionConfiguration
        -- The configuration for an Iceberg snapshot retention optimizer.
        icebergConfiguration: IcebergRetentionConfiguration
    end

    -- An object that describes the VPC configuration for a table optimizer.
    -- This configuration is necessary to perform optimization on tables that are in a customer VPC.
    record TableOptimizerVpcConfiguration
        -- The name of the Glue connection used for the VPC for the table optimizer.
        glueConnectionName: string
    end

    -- Contains details on the configuration of a table optimizer. You pass this configuration when creating or updating a table optimizer.
    record TableOptimizerConfiguration
        -- A role passed by the caller which gives the service permission to update the resources associated with the optimizer on the caller's behalf.
        roleArn: string
        -- Whether table optimization is enabled.
        enabled: boolean
        -- A TableOptimizerVpcConfiguration object representing the VPC configuration for a table optimizer.
        -- This configuration is necessary to perform optimization on tables that are in a customer VPC.
        vpcConfiguration: TableOptimizerVpcConfiguration
        -- The configuration for a compaction optimizer. This configuration defines how data files in your table will be compacted to
        -- improve query performance and reduce storage costs.
        compactionConfiguration: CompactionConfiguration
        -- The configuration for a snapshot retention optimizer.
        retentionConfiguration: RetentionConfiguration
        -- The configuration for an orphan file deletion optimizer.
        orphanFileDeletionConfiguration: OrphanFileDeletionConfiguration
    end

    enum ConfigurationSource
        "catalog"
        "table"
    end

    -- Compaction metrics for Iceberg for the optimizer run.
    record IcebergCompactionMetrics
        -- The number of bytes removed by the compaction job run.
        NumberOfBytesCompacted: number
        -- The number of files removed by the compaction job run.
        NumberOfFilesCompacted: number
        -- The number of DPU hours consumed by the job.
        DpuHours: number
        -- The number of DPUs consumed by the job, rounded up to the nearest whole number.
        NumberOfDpus: number
        -- The duration of the job in hours.
        JobDurationInHour: number
    end

    -- A structure that contains compaction metrics for the optimizer run.
    record CompactionMetrics
        -- A structure containing the Iceberg compaction metrics for the optimizer run.
        IcebergMetrics: IcebergCompactionMetrics
    end

    enum TableOptimizerEventType
        "starting"
        "completed"
        "failed"
        "in_progress"
    end

    -- Metrics for the optimizer run.
    -- This structure is deprecated. See the individual metric members for compaction, retention, and orphan file deletion.
    record RunMetrics
        -- The number of bytes removed by the compaction job run.
        NumberOfBytesCompacted: string
        -- The number of files removed by the compaction job run.
        NumberOfFilesCompacted: string
        -- The number of DPUs consumed by the job, rounded up to the nearest whole number.
        NumberOfDpus: string
        -- The duration of the job in hours.
        JobDurationInHour: string
    end

    -- Orphan file deletion metrics for Iceberg for the optimizer run.
    record IcebergOrphanFileDeletionMetrics
        -- The number of orphan files deleted by the orphan file deletion job run.
        NumberOfOrphanFilesDeleted: number
        -- The number of DPU hours consumed by the job.
        DpuHours: number
        -- The number of DPUs consumed by the job, rounded up to the nearest whole number.
        NumberOfDpus: number
        -- The duration of the job in hours.
        JobDurationInHour: number
    end

    -- A structure that contains orphan file deletion metrics for the optimizer run.
    record OrphanFileDeletionMetrics
        -- A structure containing the Iceberg orphan file deletion metrics for the optimizer run.
        IcebergMetrics: IcebergOrphanFileDeletionMetrics
    end

    -- Snapshot retention metrics for Iceberg for the optimizer run.
    record IcebergRetentionMetrics
        -- The number of data files deleted by the retention job run.
        NumberOfDataFilesDeleted: number
        -- The number of manifest files deleted by the retention job run.
        NumberOfManifestFilesDeleted: number
        -- The number of manifest lists deleted by the retention job run.
        NumberOfManifestListsDeleted: number
        -- The number of DPU hours consumed by the job.
        DpuHours: number
        -- The number of DPUs consumed by the job, rounded up to the nearest whole number.
        NumberOfDpus: number
        -- The duration of the job in hours.
        JobDurationInHour: number
    end

    -- A structure that contains retention metrics for the optimizer run.
    record RetentionMetrics
        -- A structure containing the Iceberg retention metrics for the optimizer run.
        IcebergMetrics: IcebergRetentionMetrics
    end

    -- Contains details for a table optimizer run.
    record TableOptimizerRun
        -- An event type representing the status of the table optimizer run.
        eventType: string
        -- Represents the epoch timestamp at which the compaction job was started within Lake Formation.
        startTimestamp: number
        -- Represents the epoch timestamp at which the compaction job ended.
        endTimestamp: number
        -- A RunMetrics object containing metrics for the optimizer run.
        -- This member is deprecated. See the individual metric members for compaction, retention, and orphan file deletion.
        metrics: RunMetrics
        -- An error that occured during the optimizer run.
        error: string
        -- A CompactionMetrics object containing metrics for the optimizer run.
        compactionMetrics: CompactionMetrics
        -- The strategy used for the compaction run. Indicates which algorithm was applied to determine how files were selected and combined during the
        -- compaction process. Valid values are:
        -- binpack: Combines small files into larger files, typically targeting sizes over 100MB, while applying any pending deletes.
        -- This is the recommended compaction strategy for most use cases.
        -- sort: Organizes data based on specified columns which are sorted hierarchically during compaction, improving query
        -- performance for filtered operations. This strategy is recommended when your queries frequently filter on specific columns. To use this strategy,
        -- you must first define a sort order in your Iceberg table properties using the sort_order table property.
        -- z-order: Optimizes data organization by blending multiple attributes into a single scalar value that can be used for sorting,
        -- allowing efficient querying across multiple dimensions. This strategy is recommended when you need to query data across multiple dimensions
        -- simultaneously. To use this strategy, you must first define a sort order in your Iceberg table properties using the
        -- sort_order table property.
        compactionStrategy: string
        -- A RetentionMetrics object containing metrics for the optimizer run.
        retentionMetrics: RetentionMetrics
        -- An OrphanFileDeletionMetrics object containing metrics for the optimizer run.
        orphanFileDeletionMetrics: OrphanFileDeletionMetrics
    end

    -- Contains details about an optimizer associated with a table.
    record TableOptimizer
        -- A TableOptimizerConfiguration object that was specified when creating or updating a table optimizer.
        configuration: TableOptimizerConfiguration
        -- A TableOptimizerRun object representing the last run of the table optimizer.
        lastRun: TableOptimizerRun
        -- Specifies the source of the optimizer configuration. This indicates how the table optimizer was configured and which entity or service
        -- initiated the configuration.
        configurationSource: string
    end

    -- Contains details for one of the table optimizers returned by the BatchGetTableOptimizer operation.
    record BatchTableOptimizer
        -- The Catalog ID of the table.
        catalogId: string
        -- The name of the database in the catalog in which the table resides.
        databaseName: string
        -- The name of the table.
        tableName: string
        -- A TableOptimizer object that contains details on the configuration and last run of a table optimizer.
        tableOptimizer: TableOptimizer
    end

    record BatchGetTableOptimizerOutput
        -- A list of BatchTableOptimizer objects.
        TableOptimizers: {BatchTableOptimizer}
        -- A list of errors from the operation.
        Failures: {BatchGetTableOptimizerError}
    end

    -- The throttling threshhold was exceeded.
    record ThrottlingException
        -- A message describing the problem.
        Message: string
    end

    record BatchGetTriggersInput
        -- A list of trigger names, which may be the names returned from the ListTriggers operation.
        TriggerNames: {string}
    end

    -- Batch condition that must be met (specified number of events received or batch time window expired)
    -- before EventBridge event trigger fires.
    record EventBatchingCondition
        -- Number of events that must be received from Amazon EventBridge before EventBridge event trigger fires.
        BatchSize: number
        -- Window of time in seconds after which EventBridge event trigger fires. Window starts when first event is received.
        BatchWindow: number
    end

    enum CrawlState
        "RUNNING"
        "CANCELLING"
        "CANCELLED"
        "SUCCEEDED"
        "FAILED"
        "ERROR"
    end

    enum LogicalOperator
        "EQUALS"
    end

    enum JobRunState
        "STARTING"
        "RUNNING"
        "STOPPING"
        "STOPPED"
        "SUCCEEDED"
        "FAILED"
        "TIMEOUT"
        "ERROR"
        "WAITING"
        "EXPIRED"
    end

    -- Defines a condition under which a trigger fires.
    record Condition
        -- A logical operator.
        LogicalOperator: string
        -- The name of the job whose JobRuns this condition applies to, and on which
        -- this trigger waits.
        JobName: string
        -- The condition state. Currently, the only job states that a trigger can listen for are SUCCEEDED, STOPPED, FAILED, and TIMEOUT. The only crawler states that a trigger can listen for are SUCCEEDED, FAILED, and CANCELLED.
        State: string
        -- The name of the crawler to which this condition applies.
        CrawlerName: string
        -- The state of the crawler to which this condition applies.
        CrawlState: string
    end

    enum Logical
        "AND"
        "ANY"
    end

    -- Defines the predicate of the trigger, which determines when it fires.
    record Predicate
        -- An optional field if only one condition is listed. If multiple conditions are listed, then
        -- this field is required.
        Logical: string
        -- A list of the conditions that determine when the trigger will fire.
        Conditions: {Condition}
    end

    enum TriggerState
        "CREATING"
        "CREATED"
        "ACTIVATING"
        "ACTIVATED"
        "DEACTIVATING"
        "DEACTIVATED"
        "DELETING"
        "UPDATING"
    end

    enum TriggerType
        "SCHEDULED"
        "CONDITIONAL"
        "ON_DEMAND"
        "EVENT"
    end

    -- Information about a specific trigger.
    record Trigger
        -- The name of the trigger.
        Name: string
        -- The name of the workflow associated with the trigger.
        WorkflowName: string
        -- Reserved for future use.
        Id: string
        -- The type of trigger that this is.
        Type: string
        -- The current state of the trigger.
        State: string
        -- A description of this trigger.
        Description: string
        -- A cron expression used to specify the schedule (see Time-Based
        -- Schedules for Jobs and Crawlers. For example, to run
        -- something every day at 12:15 UTC, you would specify:
        -- cron(15 12 * * ? *).
        Schedule: string
        -- The actions initiated by this trigger.
        Actions: {Action}
        -- The predicate of this trigger, which defines when it will fire.
        Predicate: Predicate
        -- Batch condition that must be met (specified number of events received or batch time window expired)
        -- before EventBridge event trigger fires.
        EventBatchingCondition: EventBatchingCondition
    end

    record BatchGetTriggersOutput
        -- A list of trigger definitions.
        Triggers: {Trigger}
        -- A list of names of triggers not found.
        TriggersNotFound: {string}
    end

    record BatchGetWorkflowsInput
        -- A list of workflow names, which may be the names returned from the ListWorkflows operation.
        Names: {string}
        -- Specifies whether to include a graph when returning the workflow resource metadata.
        IncludeGraph: boolean
    end

    -- The details of a blueprint.
    record BlueprintDetails
        -- The name of the blueprint.
        BlueprintName: string
        -- The run ID for this blueprint.
        RunId: string
    end

    -- An edge represents a directed connection between two Glue components that are part of the workflow the
    -- edge belongs to.
    record Edge
        -- The unique of the node within the workflow where the edge starts.
        SourceId: string
        -- The unique of the node within the workflow where the edge ends.
        DestinationId: string
    end

    -- The details of a crawl in the workflow.
    record Crawl
        -- The state of the crawler.
        State: string
        -- The date and time on which the crawl started.
        StartedOn: number
        -- The date and time on which the crawl completed.
        CompletedOn: number
        -- The error message associated with the crawl.
        ErrorMessage: string
        -- The log group associated with the crawl.
        LogGroup: string
        -- The log stream associated with the crawl.
        LogStream: string
    end

    -- The details of a Crawler node present in the workflow.
    record CrawlerNodeDetails
        -- A list of crawls represented by the crawl node.
        Crawls: {Crawl}
    end

    -- A job run that was used in the predicate of a conditional trigger
    -- that triggered this job run.
    record Predecessor
        -- The name of the job definition used by the predecessor job run.
        JobName: string
        -- The job-run ID of the predecessor job run.
        RunId: string
    end

    -- Contains information about a job run.
    record JobRun
        -- The ID of this job run.
        Id: string
        -- The number of the attempt to run this job.
        Attempt: number
        -- The ID of the previous run of this job. For example, the JobRunId specified
        -- in the StartJobRun action.
        PreviousRunId: string
        -- The name of the trigger that started this job run.
        TriggerName: string
        -- The name of the job definition being used in this run.
        JobName: string
        -- A mode that describes how a job was created. Valid values are:
        -- SCRIPT - The job was created using the Glue Studio script editor.
        -- VISUAL - The job was created using the Glue Studio visual editor.
        -- NOTEBOOK - The job was created using an interactive sessions notebook.
        -- When the JobMode field is missing or null, SCRIPT is assigned as the default value.
        JobMode: string
        -- Specifies whether job run queuing is enabled for the job run.
        -- A value of true means job run queuing is enabled for the job run. If false or not populated, the job run will not be considered for queueing.
        JobRunQueuingEnabled: boolean
        -- The date and time at which this job run was started.
        StartedOn: number
        -- The last time that this job run was modified.
        LastModifiedOn: number
        -- The date and time that this job run completed.
        CompletedOn: number
        -- The current state of the job run. For more information about the statuses of jobs that have terminated abnormally, see Glue Job Run Statuses.
        JobRunState: string
        -- The job arguments associated with this run. For this job run, they replace the default
        -- arguments set in the job definition itself.
        -- You can specify arguments here that your own job-execution script
        -- consumes, as well as arguments that Glue itself consumes.
        -- Job arguments may be logged. Do not pass plaintext secrets as arguments. Retrieve secrets
        -- from a Glue Connection, Secrets Manager or other secret management
        -- mechanism if you intend to keep them within the Job.
        -- For information about how to specify and consume your own Job arguments, see the Calling Glue APIs in Python topic in the developer guide.
        -- For information about the arguments you can provide to this field when configuring Spark jobs,
        -- see the Special Parameters Used by Glue topic in the developer guide.
        -- For information about the arguments you can provide to this field when configuring Ray
        -- jobs, see Using
        -- job parameters in Ray jobs in the developer guide.
        Arguments: {string : string}
        -- An error message associated with this job run.
        ErrorMessage: string
        -- A list of predecessors to this job run.
        PredecessorRuns: {Predecessor}
        -- This field is deprecated. Use MaxCapacity instead.
        -- The number of Glue data processing units (DPUs) allocated to this JobRun.
        -- From 2 to 100 DPUs can be allocated; the default is 10. A DPU is a relative measure
        -- of processing power that consists of 4 vCPUs of compute capacity and 16 GB of memory.
        -- For more information, see the Glue
        -- pricing page.
        AllocatedCapacity: number
        -- The amount of time (in seconds) that the job run consumed resources.
        ExecutionTime: number
        -- The JobRun timeout in minutes. This is the maximum time that a job run can
        -- consume resources before it is terminated and enters TIMEOUT status. This value overrides the timeout value set in the parent job.
        -- Jobs must have timeout values less than 7 days or 10080 minutes. Otherwise, the jobs will throw an exception.
        -- When the value is left blank, the timeout is defaulted to 2,880 minutes for Glue version 4.0 and earlier, or 480 minutes for Glue version 5.0 and later.
        -- Any existing Glue jobs that had a timeout value greater than 7 days will be defaulted to 7 days. For instance if you have specified a timeout of 20 days for a batch job, it will be stopped on the 7th day.
        -- For streaming jobs, if you have set up a maintenance window, it will be restarted during the maintenance window after 7 days.
        Timeout: number
        -- For Glue version 1.0 or earlier jobs, using the standard worker type, the number of
        -- Glue data processing units (DPUs) that can be allocated when this job runs. A DPU is
        -- a relative measure of processing power that consists of 4 vCPUs of compute capacity and 16 GB
        -- of memory. For more information, see the
        -- Glue pricing page.
        -- For Glue version 2.0+ jobs, you cannot specify a Maximum capacity.
        -- Instead, you should specify a Worker type and the Number of workers.
        -- Do not set MaxCapacity if using WorkerType and NumberOfWorkers.
        -- The value that can be allocated for MaxCapacity depends on whether you are
        -- running a Python shell job, an Apache Spark ETL job, or an Apache Spark streaming ETL
        -- job:
        -- When you specify a Python shell job (JobCommand.Name="pythonshell"), you can
        -- allocate either 0.0625 or 1 DPU. The default is 0.0625 DPU.
        -- When you specify an Apache Spark ETL job (JobCommand.Name="glueetl") or Apache
        -- Spark streaming ETL job (JobCommand.Name="gluestreaming"), you can allocate from 2 to 100 DPUs.
        -- The default is 10 DPUs. This job type cannot have a fractional DPU allocation.
        MaxCapacity: number
        -- The type of predefined worker that is allocated when a job runs. Accepts a value of
        -- G.1X, G.2X, G.4X, G.8X or G.025X for Spark jobs. Accepts the value Z.2X for Ray jobs.
        -- For the G.1X worker type, each worker maps to 1 DPU (4 vCPUs, 16 GB of memory) with 94GB disk, and provides 1 executor per worker. We recommend this worker type for workloads such as data transforms, joins, and queries, to offers a scalable and cost effective way to run most jobs.
        -- For the G.2X worker type, each worker maps to 2 DPU (8 vCPUs, 32 GB of memory) with 138GB disk, and provides 1 executor per worker. We recommend this worker type for workloads such as data transforms, joins, and queries, to offers a scalable and cost effective way to run most jobs.
        -- For the G.4X worker type, each worker maps to 4 DPU (16 vCPUs, 64 GB of memory) with 256GB disk, and provides 1 executor per worker. We recommend this worker type for jobs whose workloads contain your most demanding transforms, aggregations, joins, and queries. This worker type is available only for Glue version 3.0 or later Spark ETL jobs in the following Amazon Web Services Regions: US East (Ohio), US East (N. Virginia), US West (Oregon), Asia Pacific (Singapore), Asia Pacific (Sydney), Asia Pacific (Tokyo), Canada (Central), Europe (Frankfurt), Europe (Ireland), and Europe (Stockholm).
        -- For the G.8X worker type, each worker maps to 8 DPU (32 vCPUs, 128 GB of memory) with 512GB disk, and provides 1 executor per worker. We recommend this worker type for jobs whose workloads contain your most demanding transforms, aggregations, joins, and queries. This worker type is available only for Glue version 3.0 or later Spark ETL jobs, in the same Amazon Web Services Regions as supported for the G.4X worker type.
        -- For the G.025X worker type, each worker maps to 0.25 DPU (2 vCPUs, 4 GB of memory) with 84GB disk, and provides 1 executor per worker. We recommend this worker type for low volume streaming jobs. This worker type is only available for Glue version 3.0 or later streaming jobs.
        -- For the Z.2X worker type, each worker maps to 2 M-DPU (8vCPUs, 64 GB of memory) with 128 GB disk, and provides up to 8 Ray workers based on the autoscaler.
        WorkerType: string
        -- The number of workers of a defined workerType that are allocated when a job runs.
        NumberOfWorkers: number
        -- The name of the SecurityConfiguration structure to be used with this job
        -- run.
        SecurityConfiguration: string
        -- The name of the log group for secure logging that can be server-side encrypted in Amazon
        -- CloudWatch using KMS. This name can be /aws-glue/jobs/, in which case the
        -- default encryption is NONE. If you add a role name and
        -- SecurityConfiguration name (in other words,
        -- /aws-glue/jobs-yourRoleName-yourSecurityConfigurationName/), then that security
        -- configuration is used to encrypt the log group.
        LogGroupName: string
        -- Specifies configuration properties of a job run notification.
        NotificationProperty: NotificationProperty
        -- In Spark jobs, GlueVersion determines the versions of Apache Spark and Python
        -- that Glue available in a job. The Python version indicates the version
        -- supported for jobs of type Spark.
        -- Ray jobs should set GlueVersion to 4.0 or greater. However,
        -- the versions of Ray, Python and additional libraries available in your Ray job are determined
        -- by the Runtime parameter of the Job command.
        -- For more information about the available Glue versions and corresponding
        -- Spark and Python versions, see Glue version in the developer
        -- guide.
        -- Jobs that are created without specifying a Glue version default to Glue 5.1.
        GlueVersion: string
        -- This field can be set for either job runs with execution class FLEX or when Auto Scaling is enabled, and represents the total time each executor ran during the lifecycle of a job run in seconds, multiplied by a DPU factor (1 for G.1X, 2 for G.2X, or 0.25 for G.025X workers). This value may be different than the executionEngineRuntime * MaxCapacity as in the case of Auto Scaling jobs, as the number of executors running at a given time may be less than the MaxCapacity. Therefore, it is possible that the value of DPUSeconds is less than executionEngineRuntime * MaxCapacity.
        DPUSeconds: number
        -- Indicates whether the job is run with a standard or flexible execution class. The standard execution-class is ideal for time-sensitive workloads that require fast job startup and dedicated resources.
        -- The flexible execution class is appropriate for time-insensitive jobs whose start and completion times may vary.
        -- Only jobs with Glue version 3.0 and above and command type glueetl will be allowed to set ExecutionClass to FLEX. The flexible execution class is available for Spark jobs.
        ExecutionClass: string
        -- This field specifies a day of the week and hour for a maintenance window for streaming jobs. Glue periodically performs maintenance activities. During these maintenance windows, Glue will need to restart your streaming jobs.
        -- Glue will restart the job within 3 hours of the specified maintenance window. For instance, if you set up the maintenance window for Monday at 10:00AM GMT, your jobs will be restarted between 10:00AM GMT to 1:00PM GMT.
        MaintenanceWindow: string
        -- The name of an Glue usage profile associated with the job run.
        ProfileName: string
        -- This field holds details that pertain to the state of a job run. The field is nullable.
        -- For example, when a job run is in a WAITING state as a result of job run queuing, the field has the reason why the job run is in that state.
        StateDetail: string
        -- This inline session policy to the StartJobRun API allows you to dynamically restrict the permissions of the specified
        -- execution role for the scope of the job, without requiring the creation of additional IAM roles.
        ExecutionRoleSessionPolicy: string
    end

    -- The details of a Job node present in the workflow.
    record JobNodeDetails
        -- The information for the job runs represented by the job node.
        JobRuns: {JobRun}
    end

    -- The details of a Trigger node present in the workflow.
    record TriggerNodeDetails
        -- The information of the trigger represented by the trigger node.
        Trigger: Trigger
    end

    enum NodeType
        "CRAWLER"
        "JOB"
        "TRIGGER"
    end

    -- A node represents an Glue component (trigger, crawler, or job) on a workflow graph.
    record Node
        -- The type of Glue component represented by the node.
        Type: string
        -- The name of the Glue component represented by the node.
        Name: string
        -- The unique Id assigned to the node within the workflow.
        UniqueId: string
        -- Details of the Trigger when the node represents a Trigger.
        TriggerDetails: TriggerNodeDetails
        -- Details of the Job when the node represents a Job.
        JobDetails: JobNodeDetails
        -- Details of the crawler when the node represents a crawler.
        CrawlerDetails: CrawlerNodeDetails
    end

    -- A workflow graph represents the complete workflow containing all the Glue components present in the
    -- workflow and all the directed connections between them.
    record WorkflowGraph
        -- A list of the the Glue components belong to the workflow represented as nodes.
        Nodes: {Node}
        -- A list of all the directed connections between the nodes belonging to the workflow.
        Edges: {Edge}
    end

    -- The batch condition that started the workflow run. Either the number of events in the batch size arrived,
    -- in which case the BatchSize member is non-zero, or the batch window expired, in which case the BatchWindow
    -- member is non-zero.
    record StartingEventBatchCondition
        -- Number of events in the batch.
        BatchSize: number
        -- Duration of the batch window in seconds.
        BatchWindow: number
    end

    -- Workflow run statistics provides statistics about the workflow run.
    record WorkflowRunStatistics
        -- Total number of Actions in the workflow run.
        TotalActions: number
        -- Total number of Actions that timed out.
        TimeoutActions: number
        -- Total number of Actions that have failed.
        FailedActions: number
        -- Total number of Actions that have stopped.
        StoppedActions: number
        -- Total number of Actions that have succeeded.
        SucceededActions: number
        -- Total number Actions in running state.
        RunningActions: number
        -- Indicates the count of job runs in the ERROR state in the workflow run.
        ErroredActions: number
        -- Indicates the count of job runs in WAITING state in the workflow run.
        WaitingActions: number
    end

    enum WorkflowRunStatus
        "RUNNING"
        "COMPLETED"
        "STOPPING"
        "STOPPED"
        "ERROR"
    end

    -- A workflow run is an execution of a workflow providing all the runtime information.
    record WorkflowRun
        -- Name of the workflow that was run.
        Name: string
        -- The ID of this workflow run.
        WorkflowRunId: string
        -- The ID of the previous workflow run.
        PreviousRunId: string
        -- The workflow run properties which were set during the run.
        WorkflowRunProperties: {string : string}
        -- The date and time when the workflow run was started.
        StartedOn: number
        -- The date and time when the workflow run completed.
        CompletedOn: number
        -- The status of the workflow run.
        Status: string
        -- This error message describes any error that may have occurred in starting the workflow run. Currently the only error message is "Concurrent runs exceeded for workflow: foo."
        ErrorMessage: string
        -- The statistics of the run.
        Statistics: WorkflowRunStatistics
        -- The graph representing all the Glue components that belong to the workflow as nodes and directed
        -- connections between them as edges.
        Graph: WorkflowGraph
        -- The batch condition that started the workflow run.
        StartingEventBatchCondition: StartingEventBatchCondition
    end

    -- A workflow is a collection of multiple dependent Glue
    -- jobs and crawlers that are run to complete a complex ETL task. A
    -- workflow manages the execution and monitoring of all its jobs and crawlers.
    record Workflow
        -- The name of the workflow.
        Name: string
        -- A description of the workflow.
        Description: string
        -- A collection of properties to be used as part of each execution of the workflow.
        -- The run properties are made available to each job in the workflow. A job can modify
        -- the properties for the next jobs in the flow.
        DefaultRunProperties: {string : string}
        -- The date and time when the workflow was created.
        CreatedOn: number
        -- The date and time when the workflow was last modified.
        LastModifiedOn: number
        -- The information about the last execution of the workflow.
        LastRun: WorkflowRun
        -- The graph representing all the Glue components that belong to the workflow as nodes and directed
        -- connections between them as edges.
        Graph: WorkflowGraph
        -- You can use this parameter to prevent unwanted multiple updates to data, to control costs, or in some cases, to prevent exceeding the maximum number of concurrent runs of any of the component jobs. If you leave this parameter blank, there is no limit to the number of concurrent workflow runs.
        MaxConcurrentRuns: number
        -- This structure indicates the details of the blueprint that this particular workflow is created from.
        BlueprintDetails: BlueprintDetails
    end

    record BatchGetWorkflowsOutput
        -- A list of workflow resource metadata.
        Workflows: {Workflow}
        -- A list of names of workflows not found.
        MissingWorkflows: {string}
    end

    -- An Inclusion Annotation.
    record DatapointInclusionAnnotation
        -- The ID of the data quality profile the statistic belongs to.
        ProfileId: string
        -- The Statistic ID.
        StatisticId: string
        -- The inclusion annotation value to apply to the statistic.
        InclusionAnnotation: string
    end

    record BatchPutDataQualityStatisticAnnotationInput
        -- A list of DatapointInclusionAnnotation's. The InclusionAnnotations must contain a profileId and statisticId.
        -- If there are multiple InclusionAnnotations, the list must refer to a single statisticId across multiple profileIds.
        InclusionAnnotations: {DatapointInclusionAnnotation}
        -- Client Token.
        ClientToken: string
    end

    record BatchPutDataQualityStatisticAnnotationOutput
        -- A list of AnnotationError's.
        FailedInclusionAnnotations: {AnnotationError}
    end

    record BatchStopJobRunInput
        -- The name of the job definition for which to stop job runs.
        JobName: string
        -- A list of the JobRunIds that should be stopped for that job
        -- definition.
        JobRunIds: {string}
    end

    -- Records an error that occurred when attempting to stop a
    -- specified job run.
    record BatchStopJobRunError
        -- The name of the job definition that is used in the job run in question.
        JobName: string
        -- The JobRunId of the job run in question.
        JobRunId: string
        -- Specifies details about the error that was encountered.
        ErrorDetail: ErrorDetail
    end

    -- Records a successful request to stop a specified JobRun.
    record BatchStopJobRunSuccessfulSubmission
        -- The name of the job definition used in the job run that was stopped.
        JobName: string
        -- The JobRunId of the job run that was stopped.
        JobRunId: string
    end

    record BatchStopJobRunOutput
        -- A list of the JobRuns that were successfully submitted for stopping.
        SuccessfulSubmissions: {BatchStopJobRunSuccessfulSubmission}
        -- A list of the errors that were encountered in trying to stop JobRuns,
        -- including the JobRunId for which each error was encountered and details about the
        -- error.
        Errors: {BatchStopJobRunError}
    end

    -- A structure that contains the values and structure used to update a partition.
    record BatchUpdatePartitionRequestEntry
        -- A list of values defining the partitions.
        PartitionValueList: {string}
        -- The structure used to update a partition.
        PartitionInput: PartitionInput
    end

    record BatchUpdatePartitionInput
        -- The ID of the catalog in which the partition is to be updated. Currently, this should be
        -- the Amazon Web Services account ID.
        CatalogId: string
        -- The name of the metadata database in which the partition is
        -- to be updated.
        DatabaseName: string
        -- The name of the metadata table in which the partition is to be updated.
        TableName: string
        -- A list of up to 100 BatchUpdatePartitionRequestEntry objects to update.
        Entries: {BatchUpdatePartitionRequestEntry}
    end

    -- Contains information about a batch update partition error.
    record BatchUpdatePartitionFailureEntry
        -- A list of values defining the partitions.
        PartitionValueList: {string}
        -- The details about the batch update partition error.
        ErrorDetail: ErrorDetail
    end

    record BatchUpdatePartitionOutput
        -- The errors encountered when trying to update the requested partitions. A list of BatchUpdatePartitionFailureEntry objects.
        Errors: {BatchUpdatePartitionFailureEntry}
    end

