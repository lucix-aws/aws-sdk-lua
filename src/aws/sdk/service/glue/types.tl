    end

    -- Permissions granted to a principal.
    record PrincipalPermissions
        -- The principal who is granted permissions.
        Principal: DataLakePrincipal
        -- The permissions that are granted to the principal.
        Permissions: {string}
    end

    -- A catalog that points to an entity outside the Glue Data Catalog.
    record FederatedCatalog
        -- A unique identifier for the federated catalog.
        Identifier: string
        -- The name of the connection to an external data source, for example a Redshift-federated catalog.
        ConnectionName: string
        -- The type of connection used to access the federated catalog, specifying the protocol or method for connection to the
        -- external data source.
        ConnectionType: string
    end

    enum OverwriteChildResourcePermissionsWithDefaultEnum
        "Accept"
        "Deny"
    end

    -- A structure that describes a target catalog for resource linking.
    record TargetRedshiftCatalog
        -- The Amazon Resource Name (ARN) of the catalog resource.
        CatalogArn: string
    end

    -- A structure that describes catalog properties.
    record CatalogInput
        -- Description string, not more than 2048 bytes long, matching the URI address multi-line string pattern. A description of the catalog.
        Description: string
        -- A FederatedCatalog object. A FederatedCatalog structure that references an entity outside the Glue Data Catalog, for example a Redshift database.
        FederatedCatalog: FederatedCatalog
        -- A map array of key-value pairs that define the parameters and properties of the catalog.
        Parameters: {string : string}
        -- A TargetRedshiftCatalog object that describes a target catalog for resource linking.
        TargetRedshiftCatalog: TargetRedshiftCatalog
        -- A CatalogProperties object that specifies data lake access properties and other custom properties.
        CatalogProperties: CatalogProperties
        -- An array of PrincipalPermissions objects. Creates a set of default permissions on the table(s) for principals. Used by Amazon Web Services Lake Formation. Typically should be explicitly set as an empty list.
        CreateTableDefaultPermissions: {PrincipalPermissions}
        -- An array of PrincipalPermissions objects. Creates a set of default permissions on the database(s) for principals. Used by Amazon Web Services Lake Formation. Typically should be explicitly set as an empty list.
        CreateDatabaseDefaultPermissions: {PrincipalPermissions}
        -- Allows third-party engines to access data in Amazon S3 locations that are registered with Lake Formation.
        AllowFullTableExternalDataAccess: string
        -- Overwrites existing Amazon Web Services Lake Formation permissions with CatalogInput$CreateTableDefaultPermissions and CatalogInput$CreateDatabaseDefaultPermissions for all child resources.
        OverwriteChildResourcePermissionsWithDefault: string
    end

    record CreateCatalogInput
        -- The name of the catalog to create.
        Name: string
        -- A CatalogInput object that defines the metadata for the catalog.
        CatalogInput: CatalogInput
        -- A map array of key-value pairs, not more than 50 pairs. Each key is a UTF-8 string, not less than 1 or more than 128 bytes long. Each value is a UTF-8 string, not more than 256 bytes long. The tags you assign to the catalog.
        Tags: {string : string}
    end

    record CreateCatalogOutput
    end

    -- A federated resource already exists.
    record FederatedResourceAlreadyExistsException
        -- The message describing the problem.
        Message: string
        -- The associated Glue resource already exists.
        AssociatedGlueResource: string
    end

    enum CsvHeaderOption
        "UNKNOWN"
        "PRESENT"
        "ABSENT"
    end

    enum CsvSerdeOption
        "OpenCSVSerDe"
        "LazySimpleSerDe"
        "None"
    end

    -- Specifies a custom CSV classifier for CreateClassifier to create.
    record CreateCsvClassifierRequest
        -- The name of the classifier.
        Name: string
        -- A custom symbol to denote what separates each column entry in the row.
        Delimiter: string
        -- A custom symbol to denote what combines content into a single column value. Must be different from the column delimiter.
        QuoteSymbol: string
        -- Indicates whether the CSV file contains a header.
        ContainsHeader: string
        -- A list of strings representing column names.
        Header: {string}
        -- Specifies not to trim values before identifying the type of column values. The default value is true.
        DisableValueTrimming: boolean
        -- Enables the processing of files that contain only one column.
        AllowSingleColumn: boolean
        -- Enables the configuration of custom datatypes.
        CustomDatatypeConfigured: boolean
        -- Creates a list of supported custom datatypes.
        CustomDatatypes: {string}
        -- Sets the SerDe for processing CSV in the classifier, which will be applied in the Data Catalog. Valid values are OpenCSVSerDe, LazySimpleSerDe, and None. You can specify the None value when you want the crawler to do the detection.
        Serde: string
    end

    -- Specifies a grok classifier for CreateClassifier
    -- to create.
    record CreateGrokClassifierRequest
        -- An identifier of the data format that the classifier matches,
        -- such as Twitter, JSON, Omniture logs, Amazon CloudWatch Logs, and so on.
        Classification: string
        -- The name of the new classifier.
        Name: string
        -- The grok pattern used by this classifier.
        GrokPattern: string
        -- Optional custom grok patterns used by this classifier.
        CustomPatterns: string
    end

    -- Specifies a JSON classifier for CreateClassifier to create.
    record CreateJsonClassifierRequest
        -- The name of the classifier.
        Name: string
        -- A JsonPath string defining the JSON data for the classifier to classify.
        -- Glue supports a subset of JsonPath, as described in Writing JsonPath Custom Classifiers.
        JsonPath: string
    end

    -- Specifies an XML classifier for CreateClassifier to create.
    record CreateXMLClassifierRequest
        -- An identifier of the data format that the classifier matches.
        Classification: string
        -- The name of the classifier.
        Name: string
        -- The XML tag designating the element that contains each record in an XML document being
        -- parsed. This can't identify a self-closing element (closed by />). An empty
        -- row element that contains only attributes can be parsed as long as it ends with a closing tag
        -- (for example, is okay, but
        -- is not).
        RowTag: string
    end

    record CreateClassifierInput
        -- A GrokClassifier object specifying the classifier
        -- to create.
        GrokClassifier: CreateGrokClassifierRequest
        -- An XMLClassifier object specifying the classifier
        -- to create.
        XMLClassifier: CreateXMLClassifierRequest
        -- A JsonClassifier object specifying the classifier
        -- to create.
        JsonClassifier: CreateJsonClassifierRequest
        -- A CsvClassifier object specifying the classifier
        -- to create.
        CsvClassifier: CreateCsvClassifierRequest
    end

    record CreateClassifierOutput
    end

