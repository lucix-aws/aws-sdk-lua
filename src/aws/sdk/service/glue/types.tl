        -- The connectionType, as provided to the underlying Glue library. This node type supports
        -- the following connection types:
        -- opensearch
        -- azuresql
        -- azurecosmos
        -- bigquery
        -- saphana
        -- teradata
        -- vertica
        ConnectionType: string
        -- A map specifying connection options for the node. You can find standard connection options for the
        -- corresponding connection type in the
