    enum PiiType
        "RowAudit"
        "RowHashing"
        "RowMasking"
        "RowPartialMasking"
        "ColumnAudit"
        "ColumnHashing"
        "ColumnMasking"
    end

    -- Specifies a transform that identifies, removes or masks PII data.
    record PIIDetection
        -- The name of the transform node.
        Name: string
        -- The node ID inputs to the transform.
        Inputs: {string}
        -- Indicates the type of PIIDetection transform.
        PiiType: string
        -- Indicates the types of entities the PIIDetection transform will identify as PII data.
        -- PII type entities include: PERSON_NAME, DATE, USA_SNN, EMAIL, USA_ITIN, USA_PASSPORT_NUMBER, PHONE_NUMBER, BANK_ACCOUNT,
        -- IP_ADDRESS, MAC_ADDRESS, USA_CPT_CODE, USA_HCPCS_CODE, USA_NATIONAL_DRUG_CODE, USA_MEDICARE_BENEFICIARY_IDENTIFIER,
        -- USA_HEALTH_INSURANCE_CLAIM_NUMBER,CREDIT_CARD,USA_NATIONAL_PROVIDER_IDENTIFIER,USA_DEA_NUMBER,USA_DRIVING_LICENSE
        EntityTypesToDetect: {string}
        -- Indicates the output column name that will contain any entity type detected in that row.
        OutputColumnName: string
        -- Indicates the fraction of the data to sample when scanning for PII entities.
        SampleFraction: number
        -- Indicates the fraction of the data that must be met in order for a column to be identified as PII data.
        ThresholdFraction: number
        -- Indicates the value that will replace the detected entity.
        MaskValue: string
        -- Specifies whether to redact the detected PII text. When set to true, PII content is replaced with redaction characters.
        RedactText: string
        -- The character used to replace detected PII content when redaction is enabled. The default redaction character is *.
        RedactChar: string
        -- A regular expression pattern used to identify additional PII content beyond the standard detection algorithms.
        MatchPattern: string
        -- The number of characters to exclude from redaction on the left side of detected PII content. This allows preserving context around the sensitive data.
        NumLeftCharsToExclude: number
        -- The number of characters to exclude from redaction on the right side of detected PII content. This allows preserving context around the sensitive data.
        NumRightCharsToExclude: number
        -- Additional parameters for configuring PII detection behavior and sensitivity settings.
        DetectionParameters: string
        -- The sensitivity level for PII detection. Higher sensitivity levels detect more potential PII but may result in more false positives.
        DetectionSensitivity: string
    end

    -- Specifies a PostgresSQL data source in the Glue Data Catalog.
    record PostgreSQLCatalogSource
        -- The name of the data source.
        Name: string
        -- The name of the database to read from.
        Database: string
        -- The name of the table in the database to read from.
        Table: string
    end

    -- Specifies a target that uses Postgres SQL.
    record PostgreSQLCatalogTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- The name of the database to write to.
        Database: string
        -- The name of the table in the database to write to.
        Table: string
    end

    -- A reference to a Glue DataBrew recipe.
    record RecipeReference
        -- The ARN of the DataBrew recipe.
        RecipeArn: string
        -- The RecipeVersion of the DataBrew recipe.
        RecipeVersion: string
    end

    -- Actions defined in the Glue Studio data preparation recipe node.
    record RecipeAction
        -- The operation of the recipe action.
        Operation: string
        -- The parameters of the recipe action.
        Parameters: {string : string}
    end

    -- Condition expression defined in the Glue Studio data preparation recipe node.
    record ConditionExpression
        -- The condition of the condition expression.
        Condition: string
        -- The value of the condition expression.
        Value: string
        -- The target column of the condition expressions.
        TargetColumn: string
    end

    -- A recipe step used in a Glue Studio data preparation recipe node.
    record RecipeStep
        -- The transformation action of the recipe step.
        Action: RecipeAction
        -- The condition expressions for the recipe step.
        ConditionExpressions: {ConditionExpression}
    end

    -- A Glue Studio node that uses a Glue DataBrew recipe in Glue jobs.
    record Recipe
        -- The name of the Glue Studio node.
        Name: string
        -- The nodes that are inputs to the recipe node, identified by id.
        Inputs: {string}
        -- A reference to the DataBrew recipe used by the node.
        RecipeReference: RecipeReference
        -- Transform steps used in the recipe node.
        RecipeSteps: {RecipeStep}
    end

    -- Specifies an Amazon Redshift data store.
    record RedshiftSource
        -- The name of the Amazon Redshift data store.
        Name: string
        -- The database to read from.
        Database: string
        -- The database table to read from.
        Table: string
        -- The Amazon S3 path where temporary data can be staged when copying out of the database.
        RedshiftTmpDir: string
        -- The IAM role with permissions.
        TmpDirIAMRole: string
    end

    -- The options to configure an upsert operation when writing to a Redshift target .
    record UpsertRedshiftTargetOptions
        -- The physical location of the Redshift table.
        TableLocation: string
        -- The name of the connection to use to write to Redshift.
        ConnectionName: string
        -- The keys used to determine whether to perform an update or insert.
        UpsertKeys: {string}
    end

    -- Specifies a target that uses Amazon Redshift.
    record RedshiftTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- The name of the database to write to.
        Database: string
        -- The name of the table in the database to write to.
        Table: string
        -- The Amazon S3 path where temporary data can be staged when copying out of the database.
        RedshiftTmpDir: string
        -- The IAM role with permissions.
        TmpDirIAMRole: string
        -- The set of options to configure an upsert operation when writing to a Redshift target.
        UpsertRedshiftOptions: UpsertRedshiftTargetOptions
    end

    -- Specifies a Relational database data source in the Glue Data Catalog.
    record RelationalCatalogSource
        -- The name of the data source.
        Name: string
        -- The name of the database to read from.
        Database: string
        -- The name of the table in the database to read from.
        Table: string
    end

    -- Specifies a transform that renames a single data property key.
    record RenameField
        -- The name of the transform node.
        Name: string
        -- The data inputs identified by their node names.
        Inputs: {string}
        -- A JSON path to a variable in the data structure for the source data.
        SourcePath: {string}
        -- A JSON path to a variable in the data structure for the target data.
        TargetPath: {string}
    end

    -- Specifies a group of filters with a logical operator that determines how the filters are combined to evaluate routing conditions.
    record GroupFilters
        -- The name of the filter group.
        GroupName: string
        -- A list of filter expressions that define the conditions for this group.
        Filters: {FilterExpression}
        -- The logical operator used to combine the filters in this group. Determines whether all filters must match (AND) or any filter can match (OR).
        LogicalOperator: string
    end

    -- Specifies a route node that directs data to different output paths based on defined filtering conditions.
    record Route
        -- The name of the route node.
        Name: string
        -- The input connection for the route node.
        Inputs: {string}
        -- A list of group filters that define the routing conditions and criteria for directing data to different output paths.
        GroupFiltersList: {GroupFilters}
    end

    -- Specifies a Delta Lake data source that is registered in the Glue Data Catalog. The data source must be stored in Amazon S3.
    record S3CatalogDeltaSource
        -- The name of the Delta Lake data source.
        Name: string
        -- The name of the database to read from.
        Database: string
        -- The name of the table in the database to read from.
        Table: string
        -- Specifies additional connection options.
        AdditionalDeltaOptions: {string : string}
        -- Specifies the data schema for the Delta Lake source.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a Hudi data source that is registered in the Glue Data Catalog. The Hudi data source must be stored in Amazon S3.
    record S3CatalogHudiSource
        -- The name of the Hudi data source.
        Name: string
        -- The name of the database to read from.
        Database: string
        -- The name of the table in the database to read from.
        Table: string
        -- Specifies additional connection options.
        AdditionalHudiOptions: {string : string}
        -- Specifies the data schema for the Hudi source.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies an Apache Iceberg data source that is registered in the Glue Data Catalog. The Iceberg data source must be stored in Amazon S3.
    record S3CatalogIcebergSource
        -- The name of the Iceberg data source.
        Name: string
        -- The name of the database to read from.
        Database: string
        -- The name of the table in the database to read from.
        Table: string
        -- Specifies additional connection options for the Iceberg data source.
        AdditionalIcebergOptions: {string : string}
        -- Specifies the data schema for the Iceberg source.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies an Amazon S3 data store in the Glue Data Catalog.
    record S3CatalogSource
        -- The name of the data store.
        Name: string
        -- The database to read from.
        Database: string
        -- The database table to read from.
        Table: string
        -- Partitions satisfying this predicate are deleted. Files within the retention period in these partitions are not deleted. Set to "" – empty by default.
        PartitionPredicate: string
        -- Specifies additional connection options.
        AdditionalOptions: S3SourceAdditionalOptions
    end

    -- Specifies a data target that writes to Amazon S3 using the Glue Data Catalog.
    record S3CatalogTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- Specifies native partitioning using a sequence of keys.
        PartitionKeys: {{string}}
        -- The name of the table in the database to write to.
        Table: string
        -- The name of the database to write to.
        Database: string
        -- A policy that specifies update behavior for the crawler.
        SchemaChangePolicy: CatalogSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 catalog target.
        -- When set to true, data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
    end

    -- Specifies additional connection options for the Amazon S3 data store.
    record S3DirectSourceAdditionalOptions
        -- Sets the upper limit for the target size of the dataset in bytes that will be processed.
        BoundedSize: number
        -- Sets the upper limit for the target number of files that will be processed.
        BoundedFiles: number
        -- Sets option to enable a sample path.
        EnableSamplePath: boolean
        -- If enabled, specifies the sample path.
        SamplePath: string
    end

    enum CompressionType
        "gzip"
        "bzip2"
    end

    enum QuoteChar
        "quote"
        "quillemet"
        "single_quote"
        "disabled"
    end

    enum Separator
        "comma"
        "ctrla"
        "pipe"
        "semicolon"
        "tab"
    end

    -- Specifies a command-separated value (CSV) data store stored in Amazon S3.
    record S3CsvSource
        -- The name of the data store.
        Name: string
        -- A list of the Amazon S3 paths to read from.
        Paths: {string}
        -- Specifies how the data is compressed. This is generally not necessary if the data has a standard file extension. Possible values are "gzip" and "bzip").
        CompressionType: string
        -- A string containing a JSON list of Unix-style glob patterns to exclude. For example, "[\"**.pdf\"]" excludes all PDF files.
        Exclusions: {string}
        -- The target group size in bytes. The default is computed based on the input data size and the size of your cluster. When there are fewer than 50,000 input files, "groupFiles" must be set to "inPartition" for this to take effect.
        GroupSize: string
        -- Grouping files is turned on by default when the input contains more than 50,000 files. To turn on grouping with fewer than 50,000 files, set this parameter to "inPartition". To disable grouping when there are more than 50,000 files, set this parameter to "none".
        GroupFiles: string
        -- If set to true, recursively reads files in all subdirectories under the specified paths.
        Recurse: boolean
        -- This option controls the duration in milliseconds after which the s3 listing is likely to be consistent. Files with modification timestamps falling within the last maxBand milliseconds are tracked specially when using JobBookmarks to account for Amazon S3 eventual consistency. Most users don't need to set this option. The default is 900000 milliseconds, or 15 minutes.
        MaxBand: number
        -- This option specifies the maximum number of files to save from the last maxBand seconds. If this number is exceeded, extra files are skipped and only processed in the next job run.
        MaxFilesInBand: number
        -- Specifies additional connection options.
        AdditionalOptions: S3DirectSourceAdditionalOptions
        -- Specifies the delimiter character. The default is a comma: ",", but any other character can be specified.
        Separator: string
        -- Specifies a character to use for escaping. This option is used only when reading CSV files. The default value is none. If enabled, the character which immediately follows is used as-is, except for a small set of well-known escapes (\n, \r, \t, and \0).
        Escaper: string
        -- Specifies the character to use for quoting. The default is a double quote: '"'. Set this to -1 to turn off quoting entirely.
        QuoteChar: string
        -- A Boolean value that specifies whether a single record can span multiple lines. This can occur when a field contains a quoted new-line character. You must set this option to True if any record spans multiple lines. The default value is False, which allows for more aggressive file-splitting during parsing.
        Multiline: boolean
        -- A Boolean value that specifies whether to treat the first line as a header. The default value is False.
        WithHeader: boolean
        -- A Boolean value that specifies whether to write the header to output. The default value is True.
        WriteHeader: boolean
        -- A Boolean value that specifies whether to skip the first data line. The default value is False.
        SkipFirst: boolean
        -- A Boolean value that specifies whether to use the advanced SIMD CSV reader along with Apache Arrow based columnar memory formats. Only available in Glue version 3.0.
        OptimizePerformance: boolean
        -- Specifies the data schema for the S3 CSV source.
        OutputSchemas: {GlueSchema}
    end

    -- Specifies a target that writes to a Delta Lake data source in the Glue Data Catalog.
    record S3DeltaCatalogTarget
        -- The name of the data target.
        Name: string
        -- The nodes that are inputs to the data target.
        Inputs: {string}
        -- Specifies native partitioning using a sequence of keys.
        PartitionKeys: {{string}}
        -- The name of the table in the database to write to.
        Table: string
        -- The name of the database to write to.
        Database: string
        -- Specifies additional connection options for the connector.
        AdditionalOptions: {string : string}
        -- A policy that specifies update behavior for the crawler.
        SchemaChangePolicy: CatalogSchemaChangePolicy
        -- Specifies whether to automatically enable data quality evaluation for the S3 Delta catalog target. When set to true,
        -- data quality checks are performed automatically during the write operation.
        AutoDataQuality: AutoDataQuality
        -- Specifies the data schema for the S3 Delta catalog target.
        OutputSchemas: {GlueSchema}
    end

