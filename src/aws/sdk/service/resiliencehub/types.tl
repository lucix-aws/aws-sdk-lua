        -- Name of the resiliency policy.
        policyName: string
        -- Description of the resiliency policy.
        policyDescription: string
        -- Specifies a high-level geographical location constraint for where your resilience policy data can be stored.
        dataLocationConstraint: string
        -- The tier for this resiliency policy, ranging from the highest severity
        -- (MissionCritical) to lowest (NonCritical).
        tier: string
        -- Resiliency policy to be created, including the recovery time objective (RTO) and recovery point objective (RPO) in seconds.
        policy: {string : FailurePolicy}
    end

    record UpdateResiliencyPolicyOutput
        -- The resiliency policy that was updated, including the recovery time objective
        -- (RTO) and recovery point objective (RPO) in seconds.
