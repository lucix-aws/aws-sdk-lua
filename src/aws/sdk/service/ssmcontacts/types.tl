    record ListPreviewRotationShiftsInput
        -- The date and time a rotation would begin. The first shift is calculated from this date
        -- and time.
        RotationStartTime: number
        -- Used to filter the range of calculated shifts before sending the response back to the
        -- user.
        StartTime: number
        -- The date and time a rotation shift would end.
        EndTime: number
        -- The contacts that would be assigned to a rotation.
        Members: {string}
        -- The time zone the rotation’s activity would be based on, in Internet Assigned Numbers
        -- Authority (IANA) format. For example: "America/Los_Angeles", "UTC", or "Asia/Seoul".
        TimeZoneId: string
        -- Information about how long a rotation would last before restarting at the beginning of
        -- the shift order.
        Recurrence: RecurrenceSettings
        -- Information about changes that would be made in a rotation override.
        Overrides: {PreviewOverride}
        -- A token to start the list. This token is used to get the next set of results.
        NextToken: string
        -- The maximum number of items to return for this call. The call also returns a token that
        -- can be specified in a subsequent call to get the next set of results.
        MaxResults: number
    end

    -- Information about overrides to an on-call rotation shift.
    record ShiftDetails
        -- The Amazon Resources Names (ARNs) of the contacts who were replaced in a shift when an
        -- override was created. If the override is deleted, these contacts are restored to the
        -- shift.
        OverriddenContactIds: {string}
    end

    enum ShiftType
        "REGULAR"
        "OVERRIDDEN"
    end

    -- Information about a shift that belongs to an on-call rotation.
    record RotationShift
        -- The Amazon Resource Names (ARNs) of the contacts who are part of the shift rotation.
        ContactIds: {string}
        -- The time a shift rotation begins.
        StartTime: number
        -- The time a shift rotation ends.
        EndTime: number
        -- The type of shift rotation.
        Type: string
        -- Additional information about an on-call rotation shift.
        ShiftDetails: ShiftDetails
    end

    record ListPreviewRotationShiftsOutput
        -- Details about a rotation shift, including times, types, and contacts.
        RotationShifts: {RotationShift}
        -- The token for the next set of items to return. This token is used to get the next set of
        -- results.
        NextToken: string
    end

    record ListRotationOverridesInput
        -- The Amazon Resource Name (ARN) of the rotation to retrieve information about.
        RotationId: string
        -- The date and time for the beginning of a time range for listing overrides.
        StartTime: number
        -- The date and time for the end of a time range for listing overrides.
        EndTime: number
        -- A token to start the list. Use this token to get the next set of results.
        NextToken: string
        -- The maximum number of items to return for this call. The call also returns a token that
        -- you can specify in a subsequent call to get the next set of results.
        MaxResults: number
    end

    -- Information about an override specified for an on-call rotation.
    record RotationOverride
        -- The Amazon Resource Name (ARN) of the override to an on-call rotation.
        RotationOverrideId: string
        -- The Amazon Resource Names (ARNs) of the contacts assigned to the override of the on-call
        -- rotation.
        NewContactIds: {string}
        -- The time a rotation override begins.
        StartTime: number
        -- The time a rotation override ends.
        EndTime: number
        -- The time a rotation override was created.
        CreateTime: number
    end

    record ListRotationOverridesOutput
        -- A list of rotation overrides in the specified time range.
        RotationOverrides: {RotationOverride}
        -- The token for the next set of items to return. Use this token to get the next set of
        -- results.
        NextToken: string
    end

    record ListRotationsInput
        -- A filter to include rotations in list results based on their common prefix. For example,
        -- entering prod returns a list of all rotation names that begin with prod, such
        -- as production and prod-1.
        RotationNamePrefix: string
        -- A token to start the list. Use this token to get the next set of results.
        NextToken: string
        -- The maximum number of items to return for this call. The call also returns a token that
        -- you can specify in a subsequent call to get the next set of results.
        MaxResults: number
    end

    -- Information about a rotation in an on-call schedule.
    record Rotation
        -- The Amazon Resource Name (ARN) of the rotation.
        RotationArn: string
        -- The name of the rotation.
        Name: string
        -- The Amazon Resource Names (ARNs) of the contacts assigned to the rotation team.
        ContactIds: {string}
        -- The date and time the rotation becomes active.
        StartTime: number
        -- The time zone the rotation’s activity is based on, in Internet Assigned Numbers
        -- Authority (IANA) format. For example: "America/Los_Angeles", "UTC", or "Asia/Seoul".
        TimeZoneId: string
        -- Information about when an on-call rotation is in effect and how long the rotation period
        -- lasts.
        Recurrence: RecurrenceSettings
    end

    record ListRotationsOutput
        -- The token for the next set of items to return. Use this token to get the next set of
        -- results.
        NextToken: string
        -- Information about rotations that meet the filter criteria.
        Rotations: {Rotation}
    end

    record ListRotationShiftsInput
        -- The Amazon Resource Name (ARN) of the rotation to retrieve shift information about.
        RotationId: string
        -- The date and time for the beginning of the time range to list shifts for.
        StartTime: number
        -- The date and time for the end of the time range to list shifts for.
        EndTime: number
        -- A token to start the list. Use this token to get the next set of results.
        NextToken: string
        -- The maximum number of items to return for this call. The call also returns a token that
        -- you can specify in a subsequent call to get the next set of results.
        MaxResults: number
    end

    record ListRotationShiftsOutput
        -- Information about shifts that meet the filter criteria.
        RotationShifts: {RotationShift}
        -- The token for the next set of items to return. Use this token to get the next set of
        -- results.
        NextToken: string
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the contact, escalation plan, rotation, or on-call
        -- schedule.
        ResourceARN: string
    end

    record ListTagsForResourceOutput
        -- The tags related to the contact or escalation plan.
        Tags: {Tag}
    end

    record PutContactPolicyInput
        -- The Amazon Resource Name (ARN) of the contact or escalation plan.
        ContactArn: string
        -- Details of the resource policy.
        Policy: string
    end

    record PutContactPolicyOutput
    end

    record SendActivationCodeInput
        -- The Amazon Resource Name (ARN) of the contact channel.
        ContactChannelId: string
    end

    record SendActivationCodeOutput
    end

    record StartEngagementInput
        -- The Amazon Resource Name (ARN) of the contact being engaged.
        ContactId: string
        -- The user that started the engagement.
        Sender: string
        -- The secure subject of the message that was sent to the contact. Use this field for
        -- engagements to VOICE or EMAIL.
        Subject: string
        -- The secure content of the message that was sent to the contact. Use this field for
        -- engagements to VOICE or EMAIL.
        Content: string
        -- The insecure subject of the message that was sent to the contact. Use this field for
        -- engagements to SMS.
        PublicSubject: string
        -- The insecure content of the message that was sent to the contact. Use this field for
        -- engagements to SMS.
        PublicContent: string
        -- The ARN of the incident that the engagement is part of.
        IncidentId: string
        -- A token ensuring that the operation is called only once with the specified
        -- details.
        IdempotencyToken: string
    end

    record StartEngagementOutput
        -- The ARN of the engagement.
        EngagementArn: string
    end

    record StopEngagementInput
        -- The Amazon Resource Name (ARN) of the engagement.
        EngagementId: string
        -- The reason that you're stopping the engagement.
        Reason: string
    end

    record StopEngagementOutput
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the contact or escalation plan.
        ResourceARN: string
        -- A list of tags that you are adding to the contact or escalation plan.
        Tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the contact or escalation plan.
        ResourceARN: string
        -- The key of the tag that you want to remove.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateContactInput
        -- The Amazon Resource Name (ARN) of the contact or escalation plan you're updating.
        ContactId: string
        -- The full name of the contact or escalation plan.
        DisplayName: string
        -- A list of stages. A contact has an engagement plan with stages for specified contact
        -- channels. An escalation plan uses these stages to contact specified contacts.
        Plan: Plan
    end

    record UpdateContactOutput
    end

    record UpdateContactChannelInput
        -- The Amazon Resource Name (ARN) of the contact channel you want to update.
        ContactChannelId: string
        -- The name of the contact channel.
        Name: string
        -- The details that Incident Manager uses when trying to engage the contact channel.
        DeliveryAddress: ContactChannelAddress
    end

    record UpdateContactChannelOutput
    end

    record UpdateRotationInput
        -- The Amazon Resource Name (ARN) of the rotation to update.
        RotationId: string
        -- The Amazon Resource Names (ARNs) of the contacts to include in the updated rotation.
        -- Only the PERSONAL contact type is supported. The contact types
        -- ESCALATION and ONCALL_SCHEDULE are not supported for this
        -- operation.
        -- The order in which you list the contacts is their shift order in the rotation
        -- schedule.
        ContactIds: {string}
        -- The date and time the rotation goes into effect.
        StartTime: number
        -- The time zone to base the updated rotation’s activity on, in Internet Assigned Numbers
        -- Authority (IANA) format. For example: "America/Los_Angeles", "UTC", or "Asia/Seoul". For
        -- more information, see the Time Zone
        -- Database on the IANA website.
        -- Designators for time zones that don’t support Daylight Savings Time Rules, such as
        -- Pacific Standard Time (PST), aren't supported.
        TimeZoneId: string
        -- Information about how long the updated rotation lasts before restarting at the beginning
        -- of the shift order.
        Recurrence: RecurrenceSettings
    end

    record UpdateRotationOutput
    end

end

return M
