        -- An API operation can return fewer results than the maximum even when there are
        -- more results available. You should check NextToken after every operation to ensure
        -- that you receive all of the results.
        MaxResults: number
    end

    -- Information about an Amazon Web Services service.
    record ServiceInfo
        -- Specifies the service identifier. To find the service code value
        -- for an Amazon Web Services service, use the ListServices operation.
        ServiceCode: string
        -- Specifies the service name.
        ServiceName: string
    end

    record ListServicesOutput
        -- If present, indicates that more output is available than is
        -- included in the current response. Use this value in the NextToken request parameter
        -- in a subsequent call to the operation to get the next part of the output. You should repeat this
        -- until the NextToken response element comes back as null.
        NextToken: string
        -- The list of the Amazon Web Services service names and service codes.
        Services: {ServiceInfo}
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) for the applied quota for which you want to list tags.
        -- You can get this information by using the Service Quotas console, or by listing the quotas
        -- using the list-service-quotas CLI command or the ListServiceQuotas Amazon Web Services API operation.
        ResourceARN: string
    end

    record ListTagsForResourceOutput
        -- A complex data type that contains zero or more tag elements.
        Tags: {Tag}
    end

    record PutServiceQuotaIncreaseRequestIntoTemplateInput
        -- Specifies the quota identifier. To find the quota code for a specific
        -- quota, use the ListServiceQuotas operation, and look for the
        -- QuotaCode response in the output for the quota you want.
        QuotaCode: string
        -- Specifies the service identifier. To find the service code value
        -- for an Amazon Web Services service, use the ListServices operation.
        ServiceCode: string
        -- Specifies the Amazon Web Services Region to which the template applies.
        AwsRegion: string
        -- Specifies the new, increased value for the quota.
        DesiredValue: number
    end

    record PutServiceQuotaIncreaseRequestIntoTemplateOutput
        -- Information about the quota increase request.
        ServiceQuotaIncreaseRequestInTemplate: ServiceQuotaIncreaseRequestInTemplate
    end

    -- You have exceeded your service quota. To perform the requested action, remove some of
    -- the relevant resources, or use Service Quotas to request a service quota increase.
    record QuotaExceededException
        Message: string
    end

    record RequestServiceQuotaIncreaseInput
        -- Specifies the service identifier. To find the service code value
        -- for an Amazon Web Services service, use the ListServices operation.
        ServiceCode: string
        -- Specifies the quota identifier. To find the quota code for a specific
        -- quota, use the ListServiceQuotas operation, and look for the
        -- QuotaCode response in the output for the quota you want.
        QuotaCode: string
        -- Specifies the new, increased value for the quota.
        DesiredValue: number
        -- Specifies the resource with an Amazon Resource Name (ARN).
        ContextId: string
        -- Specifies if an Amazon Web Services Support case can be opened for the quota increase request. This parameter is optional.
        -- By default, this flag is set to True and Amazon Web Services may create a support case for some quota increase requests.
        -- You can set this flag to False
        -- if you do not want a support case created when you request a quota increase. If you set the flag to False,
        -- Amazon Web Services does not open a support case and updates the request status to Not approved.
        SupportCaseAllowed: boolean
    end

    record RequestServiceQuotaIncreaseOutput
        -- Information about the quota increase request.
        RequestedQuota: RequestedServiceQuotaChange
    end

    record StartAutoManagementInput
        -- Sets the opt-in level for Automatic Management. Only Amazon Web Services account level is supported.
        OptInLevel: string
        -- Sets the opt-in type for Automatic Management. There are two modes: Notify only and Notify and Auto-Adjust. Currently, only
        -- NotifyOnly is available.
        OptInType: string
        -- The User Notifications Amazon Resource Name (ARN) for Automatic Management notifications.
        NotificationArn: string
        -- List of Amazon Web Services services excluded from Automatic Management.
        -- You won't be notified of Service Quotas utilization for Amazon Web Services services added to the
        -- Automatic Management exclusion list.
        ExclusionList: {string : {string}}
    end

    record StartAutoManagementOutput
    end

    record StartQuotaUtilizationReportInput
    end

    record StartQuotaUtilizationReportOutput
        -- A unique identifier for the quota utilization report. Use this identifier with the
        -- GetQuotaUtilizationReport operation to retrieve the report results.
        ReportId: string
        -- The current status of the report generation. The status will be PENDING
        -- when the report is first initiated.
        Status: string
        -- An optional message providing additional information about the report generation status.
        -- This field may contain details about the report initiation or indicate if an existing recent
        -- report is being reused.
        Message: string
    end

    record StopAutoManagementInput
    end

    record StopAutoManagementOutput
    end

    -- The specified tag is a reserved word and cannot be used.
    record TagPolicyViolationException
        Message: string
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) for the applied quota. You can get this information by
        -- using the Service Quotas console, or by listing the quotas using the list-service-quotas CLI command or the ListServiceQuotas Amazon Web Services API operation.
        ResourceARN: string
        -- The tags that you want to add to the resource.
        Tags: {Tag}
    end

    record TagResourceOutput
    end

    -- You've exceeded the number of tags allowed for a resource. For more information, see
    -- Tag
    -- restrictions in the Service Quotas User Guide.
    record TooManyTagsException
        Message: string
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) for the applied quota that you want to untag. You can
        -- get this information by using the Service Quotas console, or by listing the quotas using the
        -- list-service-quotas CLI command or the ListServiceQuotas Amazon Web Services API operation.
        ResourceARN: string
        -- The keys of the tags that you want to remove from the resource.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateAutoManagementInput
        -- Information on the opt-in type for your Automatic Management configuration.
        -- There are two modes: Notify only and Notify and Auto-Adjust. Currently, only
        -- NotifyOnly is available.
        OptInType: string
        -- The User Notifications Amazon Resource Name (ARN) for Automatic Management notifications you want
        -- to update.
        NotificationArn: string
        -- List of Amazon Web Services services you want to exclude from Automatic Management.
        -- You won't be notified of Service Quotas utilization for Amazon Web Services services added to the
        -- Automatic Management exclusion list.
        ExclusionList: {string : {string}}
    end

    record UpdateAutoManagementOutput
    end

end

return M
