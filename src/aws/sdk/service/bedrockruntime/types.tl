        role: string
        -- The content blocks for the message.
        content: {GuardrailChecksContentBlock}
    end

    record InvokeGuardrailChecksInput
        -- The messages to evaluate against the specified guardrail checks. Each message includes a role and one or more content blocks.
        messages: {GuardrailChecksMessage}
        -- The inline check configurations that specify which guardrail checks to run against the messages.
        checks: GuardrailChecksConfig
    end

    -- The evaluation result for a single content filter category.
    record GuardrailChecksContentFilterResultEntry
        -- The content filter category that was evaluated.
        category: string
        -- The severity score for the category, ranging from 0.0 to 1.0. Higher values indicate greater severity.
        severityScore: number
    end

    -- The content filter check results.
    record GuardrailChecksContentFilterResult
        -- The per-category content filter results.
        results: {GuardrailChecksContentFilterResultEntry}
    end

    -- The evaluation result for a single prompt attack category.
    record GuardrailChecksPromptAttackResultEntry
        -- The prompt attack category that was evaluated.
        category: string
        -- The severity score for the category, ranging from 0.0 to 1.0. Higher values indicate greater severity.
        severityScore: number
    end

    -- The prompt attack check results.
    record GuardrailChecksPromptAttackResult
        -- The per-category prompt attack results.
        results: {GuardrailChecksPromptAttackResultEntry}
    end

    -- The detection result for a single sensitive information entity found in the evaluated messages.
    record GuardrailChecksSensitiveInformationResultEntry
        -- The confidence score for the detection, ranging from 0.0 to 1.0. Higher values indicate greater confidence.
        confidenceScore: number
        -- The start character offset of the detected entity within the content block.
        beginOffset: number
        -- The end character offset of the detected entity within the content block.
        endOffset: number
        -- The zero-based index of the message in the input messages array where the entity was detected.
        messageIndex: number
        -- The zero-based index of the content block within the message where the entity was detected.
        contentIndex: number
    end

    -- The sensitive information check results.
    record GuardrailChecksSensitiveInformationResult
        -- The detected sensitive information entities.
        results: {GuardrailChecksSensitiveInformationResultEntry}
        -- Specifies whether the results were truncated because the number of detected entities exceeded the maximum limit.
        truncated: boolean
    end

    -- The results from the guardrail checks evaluation, organized by check type.
    record GuardrailChecksResults
        -- The content filter check results.
        contentFilter: GuardrailChecksContentFilterResult
        -- The prompt attack check results.
        promptAttack: GuardrailChecksPromptAttackResult
        -- The sensitive information check results.
        sensitiveInformation: GuardrailChecksSensitiveInformationResult
    end

    -- The text unit usage for the content filter check.
    record GuardrailChecksContentFilterUsage
        -- The number of text units consumed by the content filter check.
        textUnits: number
    end

    -- The text unit usage for the prompt attack check.
    record GuardrailChecksPromptAttackUsage
        -- The number of text units consumed by the prompt attack check.
        textUnits: number
    end

    -- The text unit usage for the sensitive information check.
    record GuardrailChecksSensitiveInformationUsage
        -- The number of text units consumed by the sensitive information check.
        textUnits: number
    end

    -- The text unit usage for the guardrail checks evaluation, organized by check type.
    record GuardrailChecksUsageResults
        -- The text unit usage for the content filter check.
        contentFilter: GuardrailChecksContentFilterUsage
        -- The text unit usage for the prompt attack check.
        promptAttack: GuardrailChecksPromptAttackUsage
        -- The text unit usage for the sensitive information check.
        sensitiveInformation: GuardrailChecksSensitiveInformationUsage
    end

    record InvokeGuardrailChecksOutput
        -- The per-check results containing findings from the guardrail evaluation.
        results: GuardrailChecksResults
        -- The per-check text unit consumption for the guardrail evaluation.
        usage: GuardrailChecksUsageResults
    end

    enum GuardrailTrace
        "enabled"
        "disabled"
        "enabled_full"
    end

    -- Configuration information for a guardrail that you use with the Converse operation.
    record GuardrailConfiguration
        -- The identifier for the guardrail.
        guardrailIdentifier: string
        -- The version of the guardrail.
        guardrailVersion: string
        -- The trace behavior for the guardrail.
        trace: string
    end

    -- Base inference parameters to pass to a model in a call to Converse or ConverseStream. For more information, see Inference parameters for foundation models. If you need to pass additional parameters that the model supports, use the additionalModelRequestFields request field in the call to Converse or ConverseStream. For more information, see Model parameters.
    record InferenceConfiguration
        -- The maximum number of tokens to allow in the generated response. The default value is the maximum allowed value for the model that you are using. For more information, see Inference parameters for foundation models.
        maxTokens: number
        -- The likelihood of the model selecting higher-probability options while generating a response. A lower value makes the model more likely to choose higher-probability options, while a higher value makes the model more likely to choose lower-probability options. The default value is the default value for the model that you are using. For more information, see Inference parameters for foundation models.
        temperature: number
        -- The percentage of most-likely candidates that the model considers for the next token. For example, if you choose a value of 0.8 for topP, the model selects from the top 80% of the probability distribution of tokens that could be next in the sequence. The default value is the default value for the model that you are using. For more information, see Inference parameters for foundation models.
        topP: number
        -- A list of stop sequences. A stop sequence is a sequence of characters that causes the model to stop generating the response.
        stopSequences: {string}
    end

    -- A block containing error information when content processing fails.
    record ErrorBlock
        -- A human-readable error message describing what went wrong during content processing.
        message: string
    end

    enum AudioFormat
        "mp3"
        "opus"
        "wav"
        "aac"
        "flac"
        "mp4"
        "ogg"
        "mkv"
        "mka"
        "x-aac"
        "m4a"
        "mpeg"
        "mpga"
        "pcm"
        "webm"
    end

    -- A storage location in an Amazon S3 bucket.
    record S3Location
        -- An object URI starting with s3://.
        uri: string
        -- If the bucket belongs to another AWS account, specify that account's ID.
        bucketOwner: string
    end

    -- The source of audio data, which can be provided either as raw bytes or a reference to an S3 location.
    record AudioSource
        -- Audio data encoded in base64.
        bytes: string
        -- A reference to audio data stored in an Amazon S3 bucket. To see which models support S3 uploads, see Supported models and features for Converse.
        s3Location: S3Location
    end

    -- An audio content block that contains audio data in various supported formats.
    record AudioBlock
        -- The format of the audio data, such as MP3, WAV, FLAC, or other supported audio formats.
        format: string
        -- The source of the audio data, which can be provided as raw bytes or an S3 location.
        source: AudioSource
        -- Error information if the audio block could not be processed or contains invalid data.
        error: ErrorBlock
    end

    enum CacheTTL
        "5m"
        "1h"
    end

    enum CachePointType
        "default"
    end

    -- Defines a section of content to be cached for reuse in subsequent API calls.
    record CachePointBlock
        -- Optional TTL duration for cache entries. When specified, enables extended TTL caching with the specified duration. When omitted, uses type value for caching behavior.
        ttl: string
    end

    -- Specifies a character-level location within a document, providing precise positioning information for cited content using start and end character indices.
    record DocumentCharLocation
        -- The index of the document within the array of documents provided in the request.
        documentIndex: number
        -- The starting character position of the cited content within the document.
        start: number
    end

    -- Specifies a chunk-level location within a document, providing positioning information for cited content using logical document segments or chunks.
    record DocumentChunkLocation
        -- The index of the document within the array of documents provided in the request.
        documentIndex: number
        -- The starting chunk identifier or index of the cited content within the document.
        start: number
    end

    -- Specifies a page-level location within a document, providing positioning information for cited content using page numbers.
    record DocumentPageLocation
        -- The index of the document within the array of documents provided in the request.
        documentIndex: number
        -- The starting page number of the cited content within the document.
        start: number
    end

    -- Specifies a search result location within the content array, providing positioning information for cited content using search result index and block positions.
    record SearchResultLocation
        -- The index of the search result content block where the cited content is found.
        searchResultIndex: number
        -- The starting position in the content array where the cited content begins.
        start: number
    end

    -- Provides the URL and domain information for the website that was cited when performing a web search.
    record WebLocation
        -- The URL that was cited when performing a web search.
        url: string
        -- The domain that was cited when performing a web search.
        domain: string
    end

    -- Specifies the precise location within a source document where cited content can be found. This can include character-level positions, page numbers, or document chunks depending on the document type and indexing method.
    record CitationLocation
        -- The web URL that was cited for this reference.
        web: WebLocation
        -- The character-level location within the document where the cited content is found.
        documentChar: DocumentCharLocation
        -- The page-level location within the document where the cited content is found.
        documentPage: DocumentPageLocation
        -- The chunk-level location within the document where the cited content is found, typically used for documents that have been segmented into logical chunks.
        documentChunk: DocumentChunkLocation
        -- The search result location where the cited content is found, including the search result index and block positions within the content array.
        searchResultLocation: SearchResultLocation
    end

    -- Contains the actual text content from a source document that is being cited or referenced in the model's response.
    record CitationSourceContent
        -- The text content from the source document that is being cited.
        text: string
    end

    -- Contains information about a citation that references a specific source document. Citations provide traceability between the model's generated response and the source documents that informed that response.
    record Citation
        -- The title or identifier of the source document being cited.
        title: string
        -- The source from the original search result that provided the cited content.
        source: string
        -- The specific content from the source document that was referenced or cited in the generated response.
        sourceContent: {CitationSourceContent}
        -- The precise location within the source document where the cited content can be found, including character positions, page numbers, or chunk identifiers.
        location: CitationLocation
    end

    -- Contains the generated text content that corresponds to or is supported by a citation from a source document.
    record CitationGeneratedContent
        -- The text content that was generated by the model and is supported by the associated citation.
        text: string
    end

    -- A content block that contains both generated text and associated citation information. This block type is returned when document citations are enabled, providing traceability between the generated content and the source documents that informed the response.
    record CitationsContentBlock
        -- The generated content that is supported by the associated citations.
        content: {CitationGeneratedContent}
        -- An array of citations that reference the source documents used to generate the associated content.
        citations: {Citation}
    end

    -- Configuration settings for enabling and controlling document citations in Converse API responses. When enabled, the model can include citation information that links generated content back to specific source documents.
    record CitationsConfig
        -- Specifies whether citations from the selected document should be used in the model's response. When set to true, the model can generate citations that reference the source documents used to inform the response.
        enabled: boolean
    end

    enum DocumentFormat
        "pdf"
        "csv"
        "doc"
        "docx"
        "xls"
        "xlsx"
        "html"
        "txt"
        "md"
    end

    -- Contains the actual content of a document that can be processed by the model and potentially cited in the response.
    record DocumentContentBlock
        -- The text content of the document.
        text: string
    end

    -- Contains the content of a document.
    record DocumentSource
        -- The raw bytes for the document. If you use an Amazon Web Services SDK, you don't need to encode the bytes in base64.
        bytes: string
        -- The location of a document object in an Amazon S3 bucket. To see which models support S3 uploads, see Supported models and features for Converse.
        s3Location: S3Location
        -- The text content of the document source.
        text: string
        -- The structured content of the document source, which may include various content blocks such as text, images, or other document elements.
        content: {DocumentContentBlock}
    end

    -- A document to include in a message.
    record DocumentBlock
        -- The format of a document, or its extension.
        format: string
        -- A name for the document. The name can only contain the following characters: Alphanumeric characters Whitespace characters (no more than one in a row) Hyphens Parentheses Square brackets This field is vulnerable to prompt injections, because the model might inadvertently interpret it as instructions. Therefore, we recommend that you specify a neutral name.
        name: string
        -- Contains the content of the document.
        source: DocumentSource
        -- Contextual information about how the document should be processed or interpreted by the model when generating citations.
        context: string
        -- Configuration settings that control how citations should be generated for this specific document.
        citations: CitationsConfig
    end

    enum GuardrailConverseImageFormat
        "png"
        "jpeg"
    end

    -- The image source (image bytes) of the guardrail converse image source.
    record GuardrailConverseImageSource
        -- The raw image bytes for the image.
        bytes: string
    end

    -- An image block that contains images that you want to assess with a guardrail.
    record GuardrailConverseImageBlock
        -- The format details for the image type of the guardrail converse image block.
        format: string
        -- The image source (image bytes) of the guardrail converse image block.
        source: GuardrailConverseImageSource
    end

    enum GuardrailConverseContentQualifier
        "grounding_source"
        "query"
        "guard_content"
    end

    -- A text block that contains text that you want to assess with a guardrail. For more information, see GuardrailConverseContentBlock.
    record GuardrailConverseTextBlock
        -- The text that you want to guard.
        text: string
        -- The qualifier details for the guardrails contextual grounding filter.
        qualifiers: {string}
    end

    -- A content block for selective guarding with the Converse or ConverseStream API operations.
    record GuardrailConverseContentBlock
        -- The text to guard.
        text: GuardrailConverseTextBlock
        -- Image within converse content block to be evaluated by the guardrail.
        image: GuardrailConverseImageBlock
    end

    enum ImageFormat
        "png"
        "jpeg"
        "gif"
        "webp"
    end

    -- The source for an image.
    record ImageSource
        -- The raw image bytes for the image. If you use an AWS SDK, you don't need to encode the image bytes in base64.
        bytes: string
        -- The location of an image object in an Amazon S3 bucket. To see which models support S3 uploads, see Supported models and features for Converse.
        s3Location: S3Location
    end

    -- Image content for a message.
    record ImageBlock
        -- The format of the image.
        format: string
        -- The source for the image.
        source: ImageSource
        -- Error information if the image block could not be processed or contains invalid data.
        error: ErrorBlock
    end

    -- Contains the reasoning that the model used to return the output.
    record ReasoningTextBlock
        -- The reasoning that the model used to return the output.
        text: string
        -- A token that verifies that the reasoning text was generated by the model. If you pass a reasoning block back to the API in a multi-turn conversation, include the text and its signature unmodified.
        signature: string
    end

    -- Contains content regarding the reasoning that is carried out by the model with respect to the content in the content block. Reasoning refers to a Chain of Thought (CoT) that the model generates to enhance the accuracy of its final response.
    record ReasoningContentBlock
        -- The reasoning that the model used to return the output.
        reasoningText: ReasoningTextBlock
        -- The content in the reasoning that was encrypted by the model provider for safety reasons. The encryption doesn't affect the quality of responses.
        redactedContent: string
    end

    -- A block within a search result that contains the content.
    record SearchResultContentBlock
        -- The actual text content
        text: string
    end

    -- A search result block that enables natural citations with proper source attribution for retrieved content. This field is only supported by Anthropic Claude Opus 4.1, Opus 4, Sonnet 4.5, Sonnet 4, Sonnet 3.7, and 3.5 Haiku models.
    record SearchResultBlock
        -- The source URL or identifier for the content.
        source: string
        -- A descriptive title for the search result.
        title: string
        -- An array of search result content block.
        content: {SearchResultContentBlock}
        -- Configuration setting for citations
        citations: CitationsConfig
    end

    -- A reference to a tool in the tool configuration. Used with ToolAdditionBlock and ToolRemovalBlock to identify which tool to add or remove mid-conversation.
    record ToolReference
        -- The name of the tool. Must match the name of a tool declared in the top-level tool configuration.
        name: string
        -- The name of the MCP server that provides the tool. Required when referencing an MCP tool.
        serverName: string
    end

    -- A content block for adding a tool to the available tool set mid-conversation. Each block references a single tool via its tool field. Use within a system role message to make a tool available without re-sending the full tool configuration.
    record ToolAdditionBlock
        -- A reference to the tool to add to the available tool set.
        tool: ToolReference
    end

    -- A content block for removing a tool from the available tool set mid-conversation. Each block references a single tool via its tool field. Use within a system role message to remove a tool without re-sending the full tool configuration.
    record ToolRemovalBlock
        -- A reference to the tool to remove from the available tool set.
        tool: ToolReference
    end

    enum VideoFormat
        "mkv"
        "mov"
        "mp4"
        "webm"
        "flv"
        "mpeg"
        "mpg"
        "wmv"
        "three_gp"
    end

    -- A video source. You can upload a smaller video as a base64-encoded string as long as the encoded file is less than 25MB. You can also transfer videos up to 1GB in size from an S3 bucket.
    record VideoSource
        -- Video content encoded in base64.
        bytes: string
        -- The location of a video object in an Amazon S3 bucket. To see which models support S3 uploads, see Supported models and features for Converse.
        s3Location: S3Location
    end

    -- A video block.
    record VideoBlock
        -- The block's format.
        format: string
        -- The block's source.
        source: VideoSource
    end

    -- The tool result content block. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record ToolResultContentBlock
        -- A tool result that is JSON format data.
        json: any
        -- A tool result that is text.
        text: string
        -- A tool result that is an image. This field is only supported by Amazon Nova and Anthropic Claude 3 and 4 models.
        image: ImageBlock
        -- A tool result that is a document.
        document: DocumentBlock
        -- A tool result that is video.
        video: VideoBlock
        -- A tool result that is a search result.
        searchResult: SearchResultBlock
    end

    enum ToolResultStatus
        "success"
        "error"
    end

    -- A tool result block that contains the results for a tool request that the model previously made. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record ToolResultBlock
        -- The ID of the tool request that this is the result for.
        toolUseId: string
        -- The content for tool result content block.
        content: {ToolResultContentBlock}
        -- The status for the tool result content block. This field is only supported by Amazon Nova and Anthropic Claude 3 and 4 models.
        status: string
    end

    enum ToolUseType
        "server_tool_use"
    end

    -- A tool use content block. Contains information about a tool that the model is requesting be run., The model uses the result from the tool to generate a response. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record ToolUseBlock
        -- The ID for the tool request.
        toolUseId: string
        -- The name of the tool that the model wants to use.
        name: string
        -- The input to pass to the tool.
        input: any
    end

    -- A block of content for a message that you pass to, or receive from, a model with the Converse or ConverseStream API operations.
    record ContentBlock
        -- Text to include in the message.
        text: string
        -- Image to include in the message. This field is only supported by Anthropic Claude 3 models.
        image: ImageBlock
        -- A document to include in the message.
        document: DocumentBlock
        -- Video to include in the message.
        video: VideoBlock
        -- An audio content block containing audio data in the conversation.
        audio: AudioBlock
        -- Information about a tool use request from a model.
        toolUse: ToolUseBlock
        -- The result for a tool request that a model makes.
        toolResult: ToolResultBlock
        -- Contains the content to assess with the guardrail. If you don't specify guardContent in a call to the Converse API, the guardrail (if passed in the Converse API) assesses the entire message. For more information, see Use a guardrail with the Converse API in the Amazon Bedrock User Guide.
        guardContent: GuardrailConverseContentBlock
        -- CachePoint to include in the message.
        cachePoint: CachePointBlock
        -- Contains content regarding the reasoning that is carried out by the model. Reasoning refers to a Chain of Thought (CoT) that the model generates to enhance the accuracy of its final response.
        reasoningContent: ReasoningContentBlock
        -- A content block that contains both generated text and associated citation information, providing traceability between the response and source documents.
        citationsContent: CitationsContentBlock
        -- Search result to include in the message.
        searchResult: SearchResultBlock
        toolAddition: ToolAdditionBlock
        toolRemoval: ToolRemovalBlock
    end

    enum ConversationRole
        "user"
        "assistant"
        "system"
    end

    -- A message input, or returned from, a call to Converse or ConverseStream.
    record Message
        -- The role that the message plays in the message.
        role: string
        -- The message content. Note the following restrictions: You can include up to 20 images. Each image's size, height, and width must be no more than 3.75 MB, 8000 px, and 8000 px, respectively. You can include up to five documents. Each document's size must be no more than 4.5 MB. If you include a ContentBlock with a document field in the array, you must also include a ContentBlock with a text field. You can only include images and documents if the role is user.
        content: {ContentBlock}
    end

    -- JSON schema structured output format options.
    record JsonSchemaDefinition
        -- The JSON schema to constrain the model's output. For more information, see JSON Schema Reference.
        schema: string
        -- The name of the JSON schema.
        name: string
        -- A description of the JSON schema.
        description: string
    end

    -- The structure that the model's output must adhere to.
    record OutputFormatStructure
        -- A JSON schema structure that the model's output must adhere to.
        jsonSchema: JsonSchemaDefinition
    end

    enum OutputFormatType
        "json_schema"
    end

    -- Structured output parameters to control the model's response.
    record OutputFormat
        -- The structure that the model's output must adhere to.
        structure: OutputFormatStructure
    end

    -- Output configuration for a model response in a call to Converse or ConverseStream.
    record OutputConfig
        -- Structured output parameters to control the model's text response.
        textFormat: OutputFormat
        -- The effort level for the model to use when generating a response. Higher effort levels allow the model to spend more time reasoning before responding. Supported values are low, medium, high, xhigh, and max. When extended thinking is disabled, the effort level is capped at high. Use effort high or below, or enable thinking to use higher effort levels.
        effort: string
    end

    enum PerformanceConfigLatency
        "standard"
        "optimized"
    end

    -- Performance settings for a model.
    record PerformanceConfiguration
        -- To use a latency-optimized version of the model, set to optimized.
        latency: string
    end

    -- Contains a map of variables in a prompt from Prompt management to an object containing the values to fill in for them when running model invocation. For more information, see How Prompt management works.
    record PromptVariableValues
        -- The text value that the variable maps to.
        text: string
    end

    enum ServiceTierType
        "priority"
        "default"
        "flex"
        "reserved"
    end

    -- Specifies the processing tier configuration used for serving the request.
    record ServiceTier
    end

    -- Contains configurations for instructions to provide the model for how to handle input. To learn more, see Using the Converse API.
    record SystemContentBlock
        -- A system prompt for the model.
        text: string
        -- A content block to assess with the guardrail. Use with the Converse or ConverseStream API operations. For more information, see Use a guardrail with the Converse API in the Amazon Bedrock User Guide.
        guardContent: GuardrailConverseContentBlock
        -- CachePoint to include in the system prompt.
        cachePoint: CachePointBlock
    end

    -- The model must request at least one tool (no text is generated). For example, {"any" : {}}. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record AnyToolChoice
    end

    -- The Model automatically decides if a tool should be called or whether to generate text instead. For example, {"auto" : {}}. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide
    record AutoToolChoice
    end

    -- The model must request a specific tool. For example, {"tool" : {"name" : "Your tool name"}}. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide This field is only supported by Anthropic Claude 3 models.
    record SpecificToolChoice
        -- The name of the tool that the model must request.
        name: string
    end

    -- Determines which tools the model should request in a call to Converse or ConverseStream. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record ToolChoice
        -- (Default). The Model automatically decides if a tool should be called or whether to generate text instead.
        auto: AutoToolChoice
        -- The model must request at least one tool (no text is generated).
        any: AnyToolChoice
        -- The Model must request the specified tool. Only supported by Anthropic Claude 3 and Amazon Nova models.
        tool: SpecificToolChoice
    end

    -- Specifies a system-defined tool for the model to use. System-defined tools are tools that are created and provided by the model provider.
    record SystemTool
        -- The name of the system-defined tool that you want to call.
        name: string
    end

    -- The schema for the tool. The top level schema type must be object. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record ToolInputSchema
        -- The JSON schema for the tool. For more information, see JSON Schema Reference.
        json: any
    end

    -- The specification for the tool. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record ToolSpecification
        -- The name for the tool.
        name: string
        -- The description for the tool.
        description: string
        -- The input schema for the tool in JSON format.
        inputSchema: ToolInputSchema
        -- Flag to enable structured output enforcement on a tool usage response.
        strict: boolean
    end

    -- Information about a tool that you can use with the Converse API. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record Tool
        -- The specfication for the tool.
        toolSpec: ToolSpecification
        -- Specifies the system-defined tool that you want use.
        systemTool: SystemTool
        -- CachePoint to include in the tool configuration.
        cachePoint: CachePointBlock
    end

    -- Configuration information for the tools that you pass to a model. For more information, see Tool use (function calling) in the Amazon Bedrock User Guide.
    record ToolConfiguration
        -- An array of tools that you want to pass to a model.
        tools: {Tool}
        -- If supported by model, forces the model to request a tool.
        toolChoice: ToolChoice
    end

    record ConverseInput
        -- Specifies the model or throughput with which to run inference, or the prompt resource to use in inference. The value depends on the resource that you use: If you use a base model, specify the model ID or its ARN. For a list of model IDs for base models, see Amazon Bedrock base model IDs (on-demand throughput) in the Amazon Bedrock User Guide. If you use an inference profile, specify the inference profile ID or its ARN. For a list of inference profile IDs, see Supported Regions and models for cross-region inference in the Amazon Bedrock User Guide. If you use a provisioned model, specify the ARN of the Provisioned Throughput. For more information, see Run inference using a Provisioned Throughput in the Amazon Bedrock User Guide. If you use a custom model, first purchase Provisioned Throughput for it. Then specify the ARN of the resulting provisioned model. For more information, see Use a custom model in Amazon Bedrock in the Amazon Bedrock User Guide. To include a prompt that was defined in Prompt management, specify the ARN of the prompt version to use. The Converse API doesn't support imported models.
        modelId: string
        -- The messages that you want to send to the model.
        messages: {Message}
        -- A prompt that provides instructions or context to the model about the task it should perform, or the persona it should adopt during the conversation.
        system: {SystemContentBlock}
        -- Inference parameters to pass to the model. Converse and ConverseStream support a base set of inference parameters. If you need to pass additional parameters that the model supports, use the additionalModelRequestFields request field.
        inferenceConfig: InferenceConfiguration
        -- Configuration information for the tools that the model can use when generating a response. For information about models that support tool use, see Supported models and model features.
        toolConfig: ToolConfiguration
        -- Configuration information for a guardrail that you want to use in the request. If you include guardContent blocks in the content field in the messages field, the guardrail operates only on those messages. If you include no guardContent blocks, the guardrail operates on all messages in the request body and in any included prompt resource.
        guardrailConfig: GuardrailConfiguration
        -- Additional inference parameters that the model supports, beyond the base set of inference parameters that Converse and ConverseStream support in the inferenceConfig field. For more information, see Model parameters.
        additionalModelRequestFields: any
        -- Contains a map of variables in a prompt from Prompt management to objects containing the values to fill in for them when running model invocation. This field is ignored if you don't specify a prompt resource in the modelId field.
        promptVariables: {string : PromptVariableValues}
        -- Additional model parameters field paths to return in the response. Converse and ConverseStream return the requested fields as a JSON Pointer object in the additionalModelResponseFields field. The following is example JSON for additionalModelResponseFieldPaths. [ "/stop_sequence" ] For information about the JSON Pointer syntax, see the Internet Engineering Task Force (IETF) documentation. Converse and ConverseStream reject an empty JSON Pointer or incorrectly structured JSON Pointer with a 400 error code. if the JSON Pointer is valid, but the requested field is not in the model response, it is ignored by Converse.
        additionalModelResponseFieldPaths: {string}
        -- Key-value pairs that you can use to filter invocation logs.
        requestMetadata: {string : string}
        -- Model performance settings for the request.
        performanceConfig: PerformanceConfiguration
        -- Specifies the processing tier configuration used for serving the request.
        serviceTier: ServiceTier
        -- Output configuration for a model response.
        outputConfig: OutputConfig
    end

    -- Metrics for a call to Converse.
    record ConverseMetrics
        -- The latency of the call to Converse, in milliseconds.
        latencyMs: number
    end

    -- The output from a call to Converse.
    record ConverseOutput
        -- The message that the model generates.
        message: Message
    end

    enum StopReason
        "end_turn"
        "tool_use"
        "max_tokens"
        "stop_sequence"
        "guardrail_intervened"
        "content_filtered"
        "malformed_model_output"
        "malformed_tool_use"
        "model_context_window_exceeded"
    end

    -- A Top level guardrail trace object. For more information, see ConverseTrace.
    record GuardrailTraceAssessment
        -- The output from the model.
        modelOutput: {string}
        -- The input assessment.
        inputAssessment: {string : GuardrailAssessment}
        -- the output assessments.
        outputAssessments: {string : {GuardrailAssessment}}
        -- Provides the reason for the action taken when harmful content is detected.
        actionReason: string
    end

    -- A prompt router trace.
    record PromptRouterTrace
        -- The ID of the invoked model.
        invokedModelId: string
    end

    -- The trace object in a response from Converse.
    record ConverseTrace
        -- The guardrail trace object.
        guardrail: GuardrailTraceAssessment
        -- The request's prompt router.
        promptRouter: PromptRouterTrace
    end

    -- Cache creation metrics for a specific TTL duration
    record CacheDetail
        -- TTL duration for these cached tokens
        ttl: string
        -- Number of tokens written to cache with this TTL (cache creation tokens)
        inputTokens: number
    end

    -- The tokens used in a message API inference call.
    record TokenUsage
        -- The number of tokens sent in the request to the model.
        inputTokens: number
        -- The number of tokens that the model generated for the request.
        outputTokens: number
        -- The total of input tokens and tokens generated by the model.
        totalTokens: number
        -- The number of input tokens read from the cache for the request.
        cacheReadInputTokens: number
        -- The number of input tokens written to the cache for the request.
        cacheWriteInputTokens: number
        -- Detailed breakdown of cache writes by TTL. Empty if no cache creation occurred. Sorted by TTL duration (1h before 5m).
        cacheDetails: {CacheDetail}
    end

    record ConverseOperationOutput
        -- The result from the call to Converse.
        output: ConverseOutput
        -- The reason why the model stopped generating output.
        stopReason: string
        -- The total number of tokens used in the call to Converse. The total includes the tokens input to the model and the tokens generated by the model.
        usage: TokenUsage
        -- Metrics for the call to Converse.
        metrics: ConverseMetrics
        -- Additional fields in the response that are unique to the model.
        additionalModelResponseFields: any
        -- A trace object that contains information about the Guardrail behavior.
        trace: ConverseTrace
        -- Model performance settings for the request.
        performanceConfig: PerformanceConfiguration
        -- Specifies the processing tier configuration used for serving the request.
        serviceTier: ServiceTier
    end

    -- The request failed due to an error while processing the model.
    record ModelErrorException
        message: string
        -- The original status code.
        originalStatusCode: number
        -- The resource name.
        resourceName: string
    end

    -- The model specified in the request is not ready to serve inference requests. The AWS SDK will automatically retry the operation up to 5 times. For information about configuring automatic retries, see Retry behavior in the AWS SDKs and Tools reference guide.
    record ModelNotReadyException
        message: string
    end

    -- The request took too long to process. Processing time exceeded the model timeout length.
    record ModelTimeoutException
        message: string
    end

    enum GuardrailStreamProcessingMode
        "sync"
        "async"
    end

    -- Configuration information for a guardrail that you use with the ConverseStream action.
    record GuardrailStreamConfiguration
        -- The identifier for the guardrail.
        guardrailIdentifier: string
        -- The version of the guardrail.
        guardrailVersion: string
        -- The trace behavior for the guardrail.
        trace: string
        -- The processing mode. The processing mode. For more information, see Configure streaming response behavior in the Amazon Bedrock User Guide.
        streamProcessingMode: string
    end

    record ConverseStreamInput
        -- Specifies the model or throughput with which to run inference, or the prompt resource to use in inference. The value depends on the resource that you use: If you use a base model, specify the model ID or its ARN. For a list of model IDs for base models, see Amazon Bedrock base model IDs (on-demand throughput) in the Amazon Bedrock User Guide. If you use an inference profile, specify the inference profile ID or its ARN. For a list of inference profile IDs, see Supported Regions and models for cross-region inference in the Amazon Bedrock User Guide. If you use a provisioned model, specify the ARN of the Provisioned Throughput. For more information, see Run inference using a Provisioned Throughput in the Amazon Bedrock User Guide. If you use a custom model, first purchase Provisioned Throughput for it. Then specify the ARN of the resulting provisioned model. For more information, see Use a custom model in Amazon Bedrock in the Amazon Bedrock User Guide. To include a prompt that was defined in Prompt management, specify the ARN of the prompt version to use. The Converse API doesn't support imported models.
        modelId: string
        -- The messages that you want to send to the model.
        messages: {Message}
        -- A prompt that provides instructions or context to the model about the task it should perform, or the persona it should adopt during the conversation.
        system: {SystemContentBlock}
        -- Inference parameters to pass to the model. Converse and ConverseStream support a base set of inference parameters. If you need to pass additional parameters that the model supports, use the additionalModelRequestFields request field.
        inferenceConfig: InferenceConfiguration
        -- Configuration information for the tools that the model can use when generating a response. For information about models that support streaming tool use, see Supported models and model features.
        toolConfig: ToolConfiguration
        -- Configuration information for a guardrail that you want to use in the request. If you include guardContent blocks in the content field in the messages field, the guardrail operates only on those messages. If you include no guardContent blocks, the guardrail operates on all messages in the request body and in any included prompt resource.
        guardrailConfig: GuardrailStreamConfiguration
        -- Additional inference parameters that the model supports, beyond the base set of inference parameters that Converse and ConverseStream support in the inferenceConfig field. For more information, see Model parameters.
        additionalModelRequestFields: any
        -- Contains a map of variables in a prompt from Prompt management to objects containing the values to fill in for them when running model invocation. This field is ignored if you don't specify a prompt resource in the modelId field.
        promptVariables: {string : PromptVariableValues}
        -- Additional model parameters field paths to return in the response. Converse and ConverseStream return the requested fields as a JSON Pointer object in the additionalModelResponseFields field. The following is example JSON for additionalModelResponseFieldPaths. [ "/stop_sequence" ] For information about the JSON Pointer syntax, see the Internet Engineering Task Force (IETF) documentation. Converse and ConverseStream reject an empty JSON Pointer or incorrectly structured JSON Pointer with a 400 error code. if the JSON Pointer is valid, but the requested field is not in the model response, it is ignored by Converse.
        additionalModelResponseFieldPaths: {string}
        -- Key-value pairs that you can use to filter invocation logs.
        requestMetadata: {string : string}
        -- Model performance settings for the request.
        performanceConfig: PerformanceConfiguration
        -- Specifies the processing tier configuration used for serving the request.
        serviceTier: ServiceTier
        -- Output configuration for a model response.
        outputConfig: OutputConfig
    end

    -- Contains incremental updates to the source content text during streaming responses, allowing clients to build up the cited content progressively.
    record CitationSourceContentDelta
        -- An incremental update to the text content from the source document that is being cited.
        text: string
    end

    -- Contains incremental updates to citation information during streaming responses. This allows clients to build up citation data progressively as the response is generated.
    record CitationsDelta
        -- The title or identifier of the source document being cited.
        title: string
        -- The source from the original search result that provided the cited content.
        source: string
        -- The specific content from the source document that was referenced or cited in the generated response.
        sourceContent: {CitationSourceContentDelta}
        -- Specifies the precise location within a source document where cited content can be found. This can include character-level positions, page numbers, or document chunks depending on the document type and indexing method.
        location: CitationLocation
    end

    -- A streaming delta event that contains incremental image data during streaming responses.
    record ImageBlockDelta
        -- The incremental image source data for this delta event.
        source: ImageSource
        -- Error information if this image delta could not be processed.
        error: ErrorBlock
    end

    -- Contains content regarding the reasoning that is carried out by the model with respect to the content in the content block. Reasoning refers to a Chain of Thought (CoT) that the model generates to enhance the accuracy of its final response.
    record ReasoningContentBlockDelta
        -- The reasoning that the model used to return the output.
        text: string
        -- The content in the reasoning that was encrypted by the model provider for safety reasons. The encryption doesn't affect the quality of responses.
        redactedContent: string
        -- A token that verifies that the reasoning text was generated by the model. If you pass a reasoning block back to the API in a multi-turn conversation, include the text and its signature unmodified.
        signature: string
    end

    -- Contains incremental updates to tool results information during streaming responses. This allows clients to build up tool results data progressively as the response is generated.
    record ToolResultBlockDelta
        -- The reasoning the model used to return the output.
        text: string
        -- The JSON schema for the tool result content block. see JSON Schema Reference.
        json: any
    end

    -- The delta for a tool use block.
    record ToolUseBlockDelta
        -- The input for a requested tool.
        input: string
    end

    -- A block of content in a streaming response.
    record ContentBlockDelta
        -- The content text.
        text: string
        -- Information about a tool that the model is requesting to use.
        toolUse: ToolUseBlockDelta
        -- An incremental update that contains the results from a tool call.
        toolResult: {ToolResultBlockDelta}
        -- Contains content regarding the reasoning that is carried out by the model. Reasoning refers to a Chain of Thought (CoT) that the model generates to enhance the accuracy of its final response.
        reasoningContent: ReasoningContentBlockDelta
        -- Incremental citation information that is streamed as part of the response generation process.
        citation: CitationsDelta
        -- A streaming delta event containing incremental image data.
        image: ImageBlockDelta
    end

    -- The content block delta event.
    record ContentBlockDeltaEvent
        -- The delta for a content block delta event.
        delta: ContentBlockDelta
        -- The block index for a content block delta event.
        contentBlockIndex: number
    end

    -- The initial event in a streaming image block that indicates the start of image content.
    record ImageBlockStart
        -- The format of the image data that will be streamed in subsequent delta events.
        format: string
    end

    -- The start of a tool result block. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record ToolResultBlockStart
        -- The ID of the tool that was used to generate this tool result block.
        toolUseId: string
        -- The status of the tool result block.
        status: string
    end

    -- The start of a tool use block. For more information, see Call a tool with the Converse API in the Amazon Bedrock User Guide.
    record ToolUseBlockStart
        -- The ID for the tool request.
        toolUseId: string
        -- The name of the tool that the model is requesting to use.
        name: string
    end

    -- Content block start information.
    record ContentBlockStart
        -- Information about a tool that the model is requesting to use.
        toolUse: ToolUseBlockStart
        -- The
        toolResult: ToolResultBlockStart
        -- The initial event indicating the start of a streaming image block.
        image: ImageBlockStart
    end

    -- Content block start event.
    record ContentBlockStartEvent
        -- Start information about a content block start event.
        start: ContentBlockStart
        -- The index for a content block start event.
        contentBlockIndex: number
    end

    -- A content block stop event.
    record ContentBlockStopEvent
        -- The index for a content block.
        contentBlockIndex: number
    end

    -- The start of a message.
    record MessageStartEvent
        -- The role for the message.
        role: string
    end

    -- The stop event for a message.
    record MessageStopEvent
        -- The reason why the model stopped generating output.
        stopReason: string
        -- The additional model response fields.
        additionalModelResponseFields: any
    end

    -- Metrics for the stream.
    record ConverseStreamMetrics
        -- The latency for the streaming request, in milliseconds.
        latencyMs: number
    end

    -- The trace object in a response from ConverseStream.
    record ConverseStreamTrace
        -- The guardrail trace object.
        guardrail: GuardrailTraceAssessment
        -- The request's prompt router.
        promptRouter: PromptRouterTrace
    end

    -- A conversation stream metadata event.
    record ConverseStreamMetadataEvent
        -- Usage information for the conversation stream event.
        usage: TokenUsage
        -- The metrics for the conversation stream metadata event.
        metrics: ConverseStreamMetrics
        -- The trace object in the response from ConverseStream that contains information about the guardrail behavior.
        trace: ConverseStreamTrace
        -- Model performance configuration metadata for the conversation stream event.
        performanceConfig: PerformanceConfiguration
        -- Specifies the processing tier configuration used for serving the request.
        serviceTier: ServiceTier
    end

    -- An error occurred while streaming the response. Retry your request.
    record ModelStreamErrorException
        message: string
        -- The original status code.
        originalStatusCode: number
        -- The original message.
        originalMessage: string
    end

    -- The messages output stream
    record ConverseStreamOutput
        -- Message start information.
        messageStart: MessageStartEvent
        -- Start information for a content block.
        contentBlockStart: ContentBlockStartEvent
        -- The messages output content block delta.
        contentBlockDelta: ContentBlockDeltaEvent
        -- Stop information for a content block.
        contentBlockStop: ContentBlockStopEvent
        -- Message stop information.
        messageStop: MessageStopEvent
        -- Metadata for the converse output stream.
        metadata: ConverseStreamMetadataEvent
        -- An internal server error occurred. Retry your request.
        internalServerException: InternalServerException
        -- A streaming error occurred. Retry your request.
        modelStreamErrorException: ModelStreamErrorException
        -- The input fails to satisfy the constraints specified by Amazon Bedrock. For troubleshooting this error, see ValidationError in the Amazon Bedrock User Guide.
        validationException: ValidationException
        -- Your request was denied due to exceeding the account quotas for Amazon Bedrock. For troubleshooting this error, see ThrottlingException in the Amazon Bedrock User Guide.
        throttlingException: ThrottlingException
        -- The service isn't currently available. For troubleshooting this error, see ServiceUnavailable in the Amazon Bedrock User Guide
        serviceUnavailableException: ServiceUnavailableException
    end

    record ConverseStreamOperationOutput
        -- The output stream that the model generated.
        stream: function(): string, string
    end

    enum Trace
        "ENABLED"
        "DISABLED"
        "ENABLED_FULL"
    end

    record InvokeModelInput
        -- The prompt and inference parameters in the format specified in the contentType in the header. You must provide the body in JSON format. To see the format and content of the request and response bodies for different models, refer to Inference parameters. For more information, see Run inference in the Bedrock User Guide.
        body: string
        -- The MIME type of the input data in the request. You must specify application/json.
        contentType: string
        -- The desired MIME type of the inference body in the response. The default value is application/json.
        accept: string
        -- The unique identifier of the model to invoke to run inference. The modelId to provide depends on the type of model or throughput that you use: If you use a base model, specify the model ID or its ARN. For a list of model IDs for base models, see Amazon Bedrock base model IDs (on-demand throughput) in the Amazon Bedrock User Guide. If you use an inference profile, specify the inference profile ID or its ARN. For a list of inference profile IDs, see Supported Regions and models for cross-region inference in the Amazon Bedrock User Guide. If you use a provisioned model, specify the ARN of the Provisioned Throughput. For more information, see Run inference using a Provisioned Throughput in the Amazon Bedrock User Guide. If you use a custom model, specify the ARN of the custom model deployment (for on-demand inference) or the ARN of your provisioned model (for Provisioned Throughput). For more information, see Use a custom model in Amazon Bedrock in the Amazon Bedrock User Guide. If you use an imported model, specify the ARN of the imported model. You can get the model ARN from a successful call to CreateModelImportJob or from the Imported models page in the Amazon Bedrock console.
        modelId: string
        -- Specifies whether to enable or disable the Bedrock trace. If enabled, you can see the full Bedrock trace.
        trace: string
        -- The unique identifier of the guardrail that you want to use. If you don't provide a value, no guardrail is applied to the invocation. An error will be thrown in the following situations. You don't provide a guardrail identifier but you specify the amazon-bedrock-guardrailConfig field in the request body. You enable the guardrail but the contentType isn't application/json. You provide a guardrail identifier, but guardrailVersion isn't specified.
        guardrailIdentifier: string
        -- The version number for the guardrail. The value can also be DRAFT.
        guardrailVersion: string
        -- Model performance settings for the request.
        performanceConfigLatency: string
        -- Specifies the processing tier type used for serving the request.
        serviceTier: string
        -- Key-value pairs that you can use to filter invocation logs.
        requestMetadata: string
    end

    record InvokeModelOutput
        -- Inference response from the model in the format specified in the contentType header. To see the format and content of the request and response bodies for different models, refer to Inference parameters.
        body: string
        -- The MIME type of the inference result.
        contentType: string
        -- Model performance settings for the request.
        performanceConfigLatency: string
        -- Specifies the processing tier type used for serving the request.
        serviceTier: string
    end

    -- Payload content for the bidirectional input. The input is an audio stream.
    record BidirectionalInputPayloadPart
        -- The audio content for the bidirectional input.
        bytes: string
    end

    -- Payload content, the speech chunk, for the bidirectional input of the invocation step.
    record InvokeModelWithBidirectionalStreamInput
        -- The audio chunk that is used as input for the invocation step.
        chunk: BidirectionalInputPayloadPart
    end

    record InvokeModelWithBidirectionalStreamOperationInput
        -- The model ID or ARN of the model ID to use. Currently, only amazon.nova-sonic-v1:0 is supported.
        modelId: string
        -- The prompt and inference parameters in the format specified in the BidirectionalInputPayloadPart in the header. You must provide the body in JSON format. To see the format and content of the request and response bodies for different models, refer to Inference parameters. For more information, see Run inference in the Bedrock User Guide.
        body: function(): string, string
    end

    -- Output from the bidirectional stream. The output is speech and a text transcription.
    record BidirectionalOutputPayloadPart
        -- The speech output of the bidirectional stream.
        bytes: string
    end

    -- Output from the bidirectional stream that was used for model invocation.
    record InvokeModelWithBidirectionalStreamOutput
        -- The speech chunk that was provided as output from the invocation step.
        chunk: BidirectionalOutputPayloadPart
        -- The request encountered an unknown internal error.
        internalServerException: InternalServerException
        -- The request encountered an error with the model stream.
        modelStreamErrorException: ModelStreamErrorException
        -- The input fails to satisfy the constraints specified by an Amazon Web Services service.
        validationException: ValidationException
        -- The request was denied due to request throttling.
        throttlingException: ThrottlingException
        -- The connection was closed because a request was not received within the timeout period.
        modelTimeoutException: ModelTimeoutException
        -- The request has failed due to a temporary failure of the server.
        serviceUnavailableException: ServiceUnavailableException
    end

    record InvokeModelWithBidirectionalStreamOperationOutput
        -- Streaming response from the model in the format specified by the BidirectionalOutputPayloadPart header.
        body: function(): string, string
    end

    record InvokeModelWithResponseStreamInput
        -- The prompt and inference parameters in the format specified in the contentType in the header. You must provide the body in JSON format. To see the format and content of the request and response bodies for different models, refer to Inference parameters. For more information, see Run inference in the Bedrock User Guide.
        body: string
        -- The MIME type of the input data in the request. You must specify application/json.
        contentType: string
        -- The desired MIME type of the inference body in the response. The default value is application/json.
        accept: string
        -- The unique identifier of the model to invoke to run inference. The modelId to provide depends on the type of model or throughput that you use: If you use a base model, specify the model ID or its ARN. For a list of model IDs for base models, see Amazon Bedrock base model IDs (on-demand throughput) in the Amazon Bedrock User Guide. If you use an inference profile, specify the inference profile ID or its ARN. For a list of inference profile IDs, see Supported Regions and models for cross-region inference in the Amazon Bedrock User Guide. If you use a provisioned model, specify the ARN of the Provisioned Throughput. For more information, see Run inference using a Provisioned Throughput in the Amazon Bedrock User Guide. If you use a custom model, specify the ARN of the custom model deployment (for on-demand inference) or the ARN of your provisioned model (for Provisioned Throughput). For more information, see Use a custom model in Amazon Bedrock in the Amazon Bedrock User Guide. If you use an imported model, specify the ARN of the imported model. You can get the model ARN from a successful call to CreateModelImportJob or from the Imported models page in the Amazon Bedrock console.
        modelId: string
        -- Specifies whether to enable or disable the Bedrock trace. If enabled, you can see the full Bedrock trace.
        trace: string
        -- The unique identifier of the guardrail that you want to use. If you don't provide a value, no guardrail is applied to the invocation. An error is thrown in the following situations. You don't provide a guardrail identifier but you specify the amazon-bedrock-guardrailConfig field in the request body. You enable the guardrail but the contentType isn't application/json. You provide a guardrail identifier, but guardrailVersion isn't specified.
        guardrailIdentifier: string
        -- The version number for the guardrail. The value can also be DRAFT.
        guardrailVersion: string
        -- Model performance settings for the request.
        performanceConfigLatency: string
        -- Specifies the processing tier type used for serving the request.
        serviceTier: string
        -- Key-value pairs that you can use to filter invocation logs.
        requestMetadata: string
    end

    -- Payload content included in the response.
    record PayloadPart
        -- Base64-encoded bytes of payload data.
        bytes: string
    end

    -- Definition of content in the response stream.
    record ResponseStream
        -- Content included in the response.
        chunk: PayloadPart
        -- An internal server error occurred. Retry your request.
        internalServerException: InternalServerException
        -- An error occurred while streaming the response. Retry your request.
        modelStreamErrorException: ModelStreamErrorException
        -- Input validation failed. Check your request parameters and retry the request.
        validationException: ValidationException
        -- Your request was throttled because of service-wide limitations. Resubmit your request later or in a different region. You can also purchase Provisioned Throughput to increase the rate or number of tokens you can process.
        throttlingException: ThrottlingException
        -- The request took too long to process. Processing time exceeded the model timeout length.
        modelTimeoutException: ModelTimeoutException
        -- The service isn't available. Try again later.
        serviceUnavailableException: ServiceUnavailableException
    end

    record InvokeModelWithResponseStreamOutput
        -- Inference response from the model in the format specified by the contentType header. To see the format and content of this field for different models, refer to Inference parameters.
        body: function(): string, string
        -- The MIME type of the inference result.
        contentType: string
        -- Model performance settings for the request.
        performanceConfigLatency: string
        -- Specifies the processing tier type used for serving the request.
        serviceTier: string
    end

    -- The inputs from a Converse API request for token counting. This structure mirrors the input format for the Converse operation, allowing you to count tokens for conversation-based inference requests.
    record ConverseTokensRequest
        -- An array of messages to count tokens for.
        messages: {Message}
        -- The system content blocks to count tokens for. System content provides instructions or context to the model about how it should behave or respond. The token count will include any system content provided.
        system: {SystemContentBlock}
        -- The toolConfig of Converse input request to count tokens for. Configuration information for the tools that the model can use when generating a response.
        toolConfig: ToolConfiguration
        -- The additionalModelRequestFields of Converse input request to count tokens for. Use this field when you want to pass additional parameters that the model supports.
        additionalModelRequestFields: any
    end

    -- The body of an InvokeModel API request for token counting. This structure mirrors the input format for the InvokeModel operation, allowing you to count tokens for raw text inference requests.
    record InvokeModelTokensRequest
        -- The request body to count tokens for, formatted according to the model's expected input format. To learn about the input format for different models, see Model inference parameters and responses.
        body: string
    end

    -- The input value for token counting. The value should be either an InvokeModel or Converse request body.
    record CountTokensInput
        -- An InvokeModel request for which to count tokens. Use this field when you want to count tokens for a raw text input that would be sent to the InvokeModel operation.
        invokeModel: InvokeModelTokensRequest
        -- A Converse request for which to count tokens. Use this field when you want to count tokens for a conversation-based input that would be sent to the Converse operation.
        converse: ConverseTokensRequest
    end

    record CountTokensOperationInput
        -- The unique identifier or ARN of the foundation model to use for token counting. Each model processes tokens differently, so the token count is specific to the model you specify.
        modelId: string
        -- The input for which to count tokens. The structure of this parameter depends on whether you're counting tokens for an InvokeModel or Converse request: For InvokeModel requests, provide the request body in the invokeModel field For Converse requests, provide the messages and system content in the converse field The input format must be compatible with the model specified in the modelId parameter.
        input: CountTokensInput
    end

    record CountTokensOutput
        -- The number of tokens in the provided input according to the specified model's tokenization rules. This count represents the number of input tokens that would be processed if the same input were sent to the model in an inference request. Use this value to estimate costs and ensure your inputs stay within model token limits.
        inputTokens: number
    end

end

return M
