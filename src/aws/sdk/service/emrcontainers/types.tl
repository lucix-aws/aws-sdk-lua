        createdBy: string
        -- The date and time when the job run has finished.
        finishedAt: number
        -- Additional details of the job run state.
        stateDetails: string
        -- The reasons why the job run has failed.
        failureReason: string
        -- The assigned tags of the job run.
        tags: {string : string}
        -- The configuration of the retry policy that the job runs on.
        retryPolicyConfiguration: RetryPolicyConfiguration
        -- The current status of the retry policy executed on the job.
        retryPolicyExecution: RetryPolicyExecution
    end

    -- The values of StartJobRun API requests used in job runs started using the job
    -- template.
    record JobTemplateData
        -- The execution role ARN of the job run.
        executionRoleArn: string
        -- The release version of Amazon EMR.
        releaseLabel: string
        -- The configuration settings that are used to override defaults configuration.
        configurationOverrides: ParametricConfigurationOverrides
        jobDriver: JobDriver
        -- The configuration of parameters existing in the job template.
        parameterConfiguration: {string : TemplateParameterConfiguration}
        -- The tags assigned to jobs started using the job template.
        jobTags: {string : string}
    end

    record StartJobRunInput
        -- The name of the job run.
        name: string
        -- The virtual cluster ID for which the job run request is submitted.
        virtualClusterId: string
        -- The client idempotency token of the job run request.
        clientToken: string
        -- The execution role ARN for the job run.
        executionRoleArn: string
        -- The Amazon EMR release version to use for the job run.
        releaseLabel: string
        -- The job driver for the job run.
        jobDriver: JobDriver
        -- The configuration overrides for the job run.
        configurationOverrides: ConfigurationOverrides
        -- The tags assigned to job runs.
        tags: {string : string}
        -- The job template ID to be used to start the job run.
        jobTemplateId: string
        -- The values of job template parameters to start a job run.
        jobTemplateParameters: {string : string}
        -- The retry policy configuration for the job run.
        retryPolicyConfiguration: RetryPolicyConfiguration
    end

    record CreateJobTemplateInput
        -- The specified name of the job template.
        name: string
        -- The client token of the job template.
        clientToken: string
        -- The job template data which holds values of StartJobRun API request.
        jobTemplateData: JobTemplateData
        -- The tags that are associated with the job template.
        tags: {string : string}
        -- The KMS key ARN used to encrypt the job template.
        kmsKeyArn: string
    end

    record DescribeJobRunOutput
        -- The output displays information about a job run.
        jobRun: JobRun
    end

    record DescribeManagedEndpointOutput
        -- This output displays information about a managed endpoint.
        endpoint: Endpoint
    end

    -- This entity describes a job template. Job template stores values of StartJobRun API
    -- request in a template and can be used to start a job run. Job template allows two use
    -- cases: avoid repeating recurring StartJobRun API request values, enforcing certain values
    -- in StartJobRun API request.
    record JobTemplate
        -- The name of the job template.
        name: string
        -- The ID of the job template.
        id: string
        -- The ARN of the job template.
        arn: string
        -- The date and time when the job template was created.
        createdAt: number
        -- The user who created the job template.
        createdBy: string
        -- The tags assigned to the job template.
        tags: {string : string}
        -- The job template data which holds values of StartJobRun API request.
        jobTemplateData: JobTemplateData
        -- The KMS key ARN used to encrypt the job template.
        kmsKeyArn: string
        -- The error message in case the decryption of job template fails.
        decryptionError: string
    end

    record DescribeJobTemplateOutput
        -- This output displays information about the specified job template.
        jobTemplate: JobTemplate
    end

    record ListJobRunsOutput
        -- This output lists information about the specified job runs.
        jobRuns: {JobRun}
        -- This output displays the token for the next set of job runs.
        nextToken: string
    end

    record ListManagedEndpointsOutput
        -- The managed endpoints to be listed.
        endpoints: {Endpoint}
        -- The token for the next set of endpoints to return.
        nextToken: string
    end

    record ListJobTemplatesOutput
        -- This output lists information about the specified job templates.
        templates: {JobTemplate}
        -- This output displays the token for the next set of job templates.
        nextToken: string
    end

end

return M
