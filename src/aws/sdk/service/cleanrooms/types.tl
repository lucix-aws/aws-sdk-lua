    -- A column within a schema relation, derived from the underlying table.
    record Column
        -- The name of the column.
        name: string
    end

    enum SchemaConfiguration
        "DIFFERENTIAL_PRIVACY"
    end

    enum SchemaStatusReasonCode
        "ANALYSIS_RULE_MISSING"
        "ANALYSIS_TEMPLATES_NOT_CONFIGURED"
        "ANALYSIS_PROVIDERS_NOT_CONFIGURED"
        "DIFFERENTIAL_PRIVACY_POLICY_NOT_CONFIGURED"
        "ID_MAPPING_TABLE_NOT_POPULATED"
        "COLLABORATION_ANALYSIS_RULE_NOT_CONFIGURED"
        "ADDITIONAL_ANALYSES_NOT_CONFIGURED"
        "RESULT_RECEIVERS_NOT_CONFIGURED"
        "ADDITIONAL_ANALYSES_NOT_ALLOWED"
        "RESULT_RECEIVERS_NOT_ALLOWED"
        "ANALYSIS_RULE_TYPES_NOT_COMPATIBLE"
        "INTERMEDIATE_TABLE_NOT_POPULATED"
        "INTERMEDIATE_TABLE_ANALYSIS_RULE_MISSING"
        "INTERMEDIATE_TABLE_BASE_TABLE_REMOVED"
        "INTERMEDIATE_TABLE_INHERITED_CONSTRAINTS_VIOLATED"
        "INTERMEDIATE_TABLE_DISALLOWED_BY_DATA_PROVIDER"
        "INTERMEDIATE_TABLE_RETENTION_PERIOD_EXPIRED"
    end

    -- A reason why the schema status is set to its current value.
    record SchemaStatusReason
        -- The schema status reason code.
        code: string
        -- An explanation of the schema status reason code.
        message: string
    end

    enum SchemaStatus
        "READY"
        "NOT_READY"
    end

    -- Information about the schema status. A status of READY means that based on the schema analysis rule, queries of the given analysis rule type are properly configured to run queries on this schema.
    record SchemaStatusDetail
        -- The status of the schema, indicating if it is ready to query.
        status: string
        -- The reasons why the schema status is set to its current state.
        reasons: {SchemaStatusReason}
        -- The analysis rule type for which the schema status has been evaluated.
        analysisRuleType: string
        -- The configuration details of the schema analysis rule for the given type.
        configurations: {string}
        -- The type of analysis that can be performed on the schema. A schema can have an analysisType of DIRECT_ANALYSIS, ADDITIONAL_ANALYSIS_FOR_AUDIENCE_GENERATION, or both.
        analysisType: string
    end

    -- Contains the schema type properties for a configured table association.
    record ConfiguredTableAssociationSchemaTypeProperties
        -- The unique identifier of the configured table association.
        configuredTableAssociationId: string
    end

    enum IdNamespaceType
        "SOURCE"
        "TARGET"
    end

    -- The input source of the ID mapping table.
    record IdMappingTableInputSource
        -- The unique identifier of the ID namespace association.
        idNamespaceAssociationId: string
    end

    -- Additional properties that are specific to the type of the associated schema.
    record IdMappingTableSchemaTypeProperties
        -- Defines which ID namespace associations are used to create the ID mapping table.
        idMappingTableInputSource: {IdMappingTableInputSource}
        -- The unique identifier of the ID mapping table.
        idMappingTableId: string
    end

    -- Contains the schema type properties for an intermediate table.
    record IntermediateTableSchemaTypeProperties
        -- The unique identifier of the intermediate table.
        intermediateTableId: string
    end

    -- Information about the schema type properties.
    record SchemaTypeProperties
        -- The ID mapping table for the schema type properties.
        idMappingTable: IdMappingTableSchemaTypeProperties
        -- The schema type properties for an intermediate table.
        intermediateTable: IntermediateTableSchemaTypeProperties
        -- The schema type properties for a configured table association.
        configuredTableAssociation: ConfiguredTableAssociationSchemaTypeProperties
    end

    enum SelectedAnalysisMethod
        "DIRECT_QUERY"
        "DIRECT_JOB"
    end

    enum SchemaType
        "TABLE"
        "ID_MAPPING_TABLE"
        "INTERMEDIATE_TABLE"
    end

    -- A schema is a relation within a collaboration.
    record Schema
        -- The columns for the relation that this schema represents.
        columns: {Column}
        -- The partition keys for the dataset underlying this schema.
        partitionKeys: {Column}
        -- The analysis rule types that are associated with the schema. Currently, only one entry is present.
        analysisRuleTypes: {string}
        -- The analysis method for the schema. DIRECT_QUERY allows SQL queries to be run directly on this table. DIRECT_JOB allows PySpark jobs to be run directly on this table. MULTIPLE allows both SQL queries and PySpark jobs to be run directly on this table.
        analysisMethod: string
        -- The selected analysis methods for the schema.
        selectedAnalysisMethods: {string}
        -- The unique account ID for the Amazon Web Services account that owns the schema.
        creatorAccountId: string
        -- A name for the schema. The schema relation is referred to by this name when queried by a protected query.
        name: string
        -- The unique ID for the collaboration that the schema belongs to.
        collaborationId: string
        -- The unique Amazon Resource Name (ARN) for the collaboration that the schema belongs to.
        collaborationArn: string
        -- A description for the schema.
        description: string
        -- The time at which the schema was created.
        createTime: number
        -- The most recent time at which the schema was updated.
        updateTime: number
        -- Details about the status of the schema. Currently, only one entry is present.
        schemaStatusDetails: {SchemaStatusDetail}
        -- The Amazon Resource Name (ARN) of the schema resource.
        resourceArn: string
        -- The schema type properties.
        schemaTypeProperties: SchemaTypeProperties
    end

    record BatchGetSchemaOutput
        -- The retrieved list of schemas.
        schemas: {Schema}
        -- Error reasons for schemas that could not be retrieved. One error is returned for every schema that could not be retrieved.
        errors: {BatchGetSchemaError}
    end

    -- Defines the information that's necessary to retrieve an analysis rule schema. Schema analysis rules are uniquely identiﬁed by a combination of the schema name and the analysis rule type for a given collaboration.
    record SchemaAnalysisRuleRequest
        -- The name of the analysis rule schema that you are requesting.
        name: string
    end

    record BatchGetSchemaAnalysisRuleInput
        -- The unique identifier of the collaboration that contains the schema analysis rule.
