        ReportJobId: string
    end

    -- Contains information from your report job about your report destination.
    record ReportDestination
        -- The unique name of the Amazon S3 bucket that receives your reports.
        S3BucketName: string
        -- The object key that uniquely identifies your reports in your S3 bucket.
        S3Keys: {string}
    end

    -- Contains detailed information about a report job. A report job compiles a report based
    -- on a report plan and publishes it to Amazon S3.
    record ReportJob
        -- The identifier for a report job. A unique, randomly generated, Unicode, UTF-8 encoded
        -- string that is at most 1,024 bytes long. Report job IDs cannot be edited.
        ReportJobId: string
        -- An Amazon Resource Name (ARN) that uniquely identifies a resource. The format of the ARN
        -- depends on the resource type.
        ReportPlanArn: string
        -- Identifies the report template for the report. Reports are built using a report
        -- template. The report templates are:
        -- RESOURCE_COMPLIANCE_REPORT | CONTROL_COMPLIANCE_REPORT | BACKUP_JOB_REPORT |
        -- COPY_JOB_REPORT | RESTORE_JOB_REPORT
        ReportTemplate: string
        -- The date and time that a report job is created, in Unix format and Coordinated Universal
        -- Time (UTC). The value of CreationTime is accurate to milliseconds. For
        -- example, the value 1516925490.087 represents Friday, January 26, 2018 12:11:30.087
        -- AM.
        CreationTime: number
        -- The date and time that a report job is completed, in Unix format and Coordinated
        -- Universal Time (UTC). The value of CompletionTime is accurate to milliseconds.
        -- For example, the value 1516925490.087 represents Friday, January 26, 2018 12:11:30.087
        -- AM.
        CompletionTime: number
        -- The status of a report job. The statuses are:
        -- CREATED | RUNNING | COMPLETED | FAILED
        -- COMPLETED means that the report is available for your review at your
        -- designated destination. If the status is FAILED, review the
        -- StatusMessage for the reason.
        Status: string
        -- A message explaining the status of the report job.
        StatusMessage: string
        -- The S3 bucket name and S3 keys for the destination where the report job publishes the
        -- report.
        ReportDestination: ReportDestination
    end

    record DescribeReportJobOutput
        -- The information about a report job, including its completion and creation times,
        -- report destination, unique report job ID, Amazon Resource Name (ARN), report template,
        -- status, and status message.
        ReportJob: ReportJob
    end

    record DescribeReportPlanInput
        -- The unique name of a report plan.
        ReportPlanName: string
    end

    -- Contains detailed information about a report plan.
    record ReportPlan
        -- An Amazon Resource Name (ARN) that uniquely identifies a resource. The format of the ARN
        -- depends on the resource type.
        ReportPlanArn: string
        -- The unique name of the report plan. This name is between 1 and 256 characters starting
        -- with a letter, and consisting of letters (a-z, A-Z), numbers (0-9), and underscores
        -- (_).
        ReportPlanName: string
        -- An optional description of the report plan with a maximum 1,024 characters.
        ReportPlanDescription: string
        -- Identifies the report template for the report. Reports are built using a report
        -- template. The report templates are:
        -- RESOURCE_COMPLIANCE_REPORT | CONTROL_COMPLIANCE_REPORT | BACKUP_JOB_REPORT |
        -- COPY_JOB_REPORT | RESTORE_JOB_REPORT
        -- If the report template is RESOURCE_COMPLIANCE_REPORT or
        -- CONTROL_COMPLIANCE_REPORT, this API resource also describes the report
        -- coverage by Amazon Web Services Regions and frameworks.
        ReportSetting: ReportSetting
        -- Contains information about where and how to deliver your reports, specifically your
        -- Amazon S3 bucket name, S3 key prefix, and the formats of your reports.
        ReportDeliveryChannel: ReportDeliveryChannel
        -- The deployment status of a report plan. The statuses are:
        -- CREATE_IN_PROGRESS | UPDATE_IN_PROGRESS | DELETE_IN_PROGRESS |
        -- COMPLETED
        DeploymentStatus: string
        -- The date and time that a report plan is created, in Unix format and Coordinated
        -- Universal Time (UTC). The value of CreationTime is accurate to milliseconds.
        -- For example, the value 1516925490.087 represents Friday, January 26, 2018 12:11:30.087
        -- AM.
        CreationTime: number
        -- The date and time that a report job associated with this report plan last attempted to
        -- run, in Unix format and Coordinated Universal Time (UTC). The value of
        -- LastAttemptedExecutionTime is accurate to milliseconds. For example, the
        -- value 1516925490.087 represents Friday, January 26, 2018 12:11:30.087 AM.
        LastAttemptedExecutionTime: number
        -- The date and time that a report job associated with this report plan last successfully
        -- ran, in Unix format and Coordinated Universal Time (UTC). The value of
        -- LastSuccessfulExecutionTime is accurate to milliseconds. For example, the
        -- value 1516925490.087 represents Friday, January 26, 2018 12:11:30.087 AM.
        LastSuccessfulExecutionTime: number
    end

    record DescribeReportPlanOutput
        -- Returns details about the report plan that is specified by its name. These details
        -- include the report plan's Amazon Resource Name (ARN), description, settings, delivery
        -- channel, deployment status, creation time, and last attempted and successful run
        -- times.
        ReportPlan: ReportPlan
    end

    record DescribeRestoreJobInput
        -- Uniquely identifies the job that restores a recovery point.
        RestoreJobId: string
    end

    -- Contains information about the restore testing plan that
    -- Backup used to initiate the restore job.
    record RestoreJobCreator
        -- An Amazon Resource Name (ARN) that uniquely identifies
        -- a restore testing plan.
        RestoreTestingPlanArn: string
    end

    enum RestoreDeletionStatus
        "DELETING"
        "FAILED"
        "SUCCESSFUL"
    end

    enum RestoreJobStatus
        "PENDING"
        "RUNNING"
        "COMPLETED"
        "ABORTED"
        "FAILED"
    end

    enum RestoreValidationStatus
        "FAILED"
        "SUCCESSFUL"
        "TIMED_OUT"
        "VALIDATING"
    end

    record DescribeRestoreJobOutput
        -- Returns the account ID that owns the restore job.
        AccountId: string
        -- Uniquely identifies the job that restores a recovery point.
        RestoreJobId: string
        -- An ARN that uniquely identifies a recovery point; for example,
        -- arn:aws:backup:us-east-1:123456789012:recovery-point:1EB3B5E7-9EB0-435A-A80B-108B488B0D45.
        RecoveryPointArn: string
        -- The Amazon Resource Name (ARN) of the original resource that was backed up. This provides context about what resource is being restored.
        SourceResourceArn: string
        -- The Amazon Resource Name (ARN) of the backup vault containing the recovery point being restored. This helps identify vault access policies and permissions.
        BackupVaultArn: string
        -- The date and time that a restore job is created, in Unix format and Coordinated
        -- Universal Time (UTC). The value of CreationDate is accurate to milliseconds.
        -- For example, the value 1516925490.087 represents Friday, January 26, 2018 12:11:30.087
        -- AM.
        CreationDate: number
        -- The date and time that a job to restore a recovery point is completed, in Unix format
        -- and Coordinated Universal Time (UTC). The value of CompletionDate is accurate
        -- to milliseconds. For example, the value 1516925490.087 represents Friday, January 26, 2018
        -- 12:11:30.087 AM.
        CompletionDate: number
        -- Status code specifying the state of the job that is initiated by Backup to
        -- restore a recovery point.
        Status: string
        -- A message showing the status of a job to restore a recovery point.
        StatusMessage: string
        -- Contains an estimated percentage that is complete of a job at the time the job status
        -- was queried.
        PercentDone: string
        -- The size, in bytes, of the restored resource.
        BackupSizeInBytes: number
        -- Specifies the IAM role ARN used to create the target recovery point; for example,
        -- arn:aws:iam::123456789012:role/S3Access.
        IamRoleArn: string
        -- The amount of time in minutes that a job restoring a recovery point is expected to
        -- take.
        ExpectedCompletionTimeMinutes: number
        -- The Amazon Resource Name (ARN) of the resource that
        -- was created by the restore job.
        -- The format of the ARN depends on the resource type of the backed-up
        -- resource.
        CreatedResourceArn: string
        -- Returns metadata associated with a restore job listed by resource type.
        ResourceType: string
        -- The creation date of the recovery point made by the specifed restore job.
        RecoveryPointCreationDate: number
        -- Contains identifying information about the creation of a restore job.
        CreatedBy: RestoreJobCreator
        -- The status of validation run on the indicated
        -- restore job.
        ValidationStatus: string
        -- The status message.
        ValidationStatusMessage: string
        -- The status of the data generated by the restore test.
        DeletionStatus: string
        -- This describes the restore job deletion status.
        DeletionStatusMessage: string
        -- This is a boolean value indicating whether the restore job is a parent (composite) restore job.
        IsParent: boolean
        -- This is the unique identifier of the parent restore job for the selected restore job.
        ParentJobId: string
    end

    record DescribeScanJobInput
        -- Uniquely identifies a request to Backup to scan a resource.
        ScanJobId: string
    end

    -- Contains identifying information about the creation of a scan job, including the backup plan and rule that initiated the scan.
    record ScanJobCreator
        -- An Amazon Resource Name (ARN) that uniquely identifies a backup plan; for example,
        -- arn:aws:backup:us-east-1:123456789012:plan:8F81F553-3A74-4A3F-B93D-B3360DC80C50.
        BackupPlanArn: string
        -- The ID of the backup plan.
        BackupPlanId: string
        -- Unique, randomly generated, Unicode, UTF-8 encoded strings that are at most 1,024 bytes
        -- long. Version IDs cannot be edited.
        BackupPlanVersion: string
        -- Uniquely identifies the backup rule that initiated the scan job.
        BackupRuleId: string
    end

    enum ScanResourceType
        "EBS"
        "EC2"
        "S3"
    end

    enum ScanResultStatus
        "NO_THREATS_FOUND"
        "THREATS_FOUND"
        "UNKNOWN"
    end

    -- Contains information about the results of a scan job.
    record ScanResultInfo
        -- The status of the scan results.
        -- Valid values: THREATS_FOUND | NO_THREATS_FOUND | UNKNOWN.
        ScanResultStatus: string
    end

    enum ScanState
        "CANCELED"
        "COMPLETED"
        "COMPLETED_WITH_ISSUES"
        "CREATED"
        "FAILED"
        "RUNNING"
    end

    record DescribeScanJobOutput
        -- Returns the account ID that owns the scan job.
        -- Pattern: ^[0-9]{12}$
        AccountId: string
        -- An Amazon Resource Name (ARN) that uniquely identifies a backup vault; for example,
        -- arn:aws:backup:us-east-1:123456789012:backup-vault:aBackupVault
        BackupVaultArn: string
        -- The name of a logical container where backups are stored. Backup vaults are identified by names that are
        -- unique to the account used to create them and the Amazon Web Services Region where they are created.
        -- Pattern: ^[a-zA-Z0-9\-\_\.]{2,50}$
        BackupVaultName: string
        -- The date and time that a backup index finished creation, in Unix format and Coordinated
        -- Universal Time (UTC). The value of CompletionDate is accurate to milliseconds.
        -- For example, the value 1516925490.087 represents Friday, January 26, 2018 12:11:30.087
        -- AM.
        CompletionDate: number
        -- The point in time the scan job scanned up to for a continuous backup.
        ContinuousScanEndTime: number
        -- The point in time the scan job started scan from for a continuous backup.
        ContinuousScanStartTime: number
        CreatedBy: ScanJobCreator
        -- The date and time that a backup index finished creation, in Unix format and Coordinated
        -- Universal Time (UTC). The value of CreationDate is accurate to milliseconds.
        -- For example, the value 1516925490.087 represents Friday, January 26, 2018 12:11:30.087
        -- AM.
        CreationDate: number
        -- An Amazon Resource Name (ARN) that uniquely identifies a backup vault; for example,
        -- arn:aws:iam::123456789012:role/S3Access.
        IamRoleArn: string
        -- The scanning engine used for the corresponding scan job. Currently only GUARDUTY is supported.
        MalwareScanner: string
        -- An ARN that uniquely identifies the target recovery point for scanning.; for example,
        -- arn:aws:backup:us-east-1:123456789012:recovery-point:1EB3B5E7-9EB0-435A-A80B-108B488B0D45.
        RecoveryPointArn: string
        -- An ARN that uniquely identifies the source resource of the corresponding recovery point ARN.
        ResourceArn: string
        -- The non-unique name of the resource that belongs to the specified backup.
        ResourceName: string
        -- The type of Amazon Web Services Resource to be backed up; for example, an Amazon Elastic Block Store (Amazon EBS) volume.
        -- Pattern: ^[a-zA-Z0-9\-\_\.]{1,50}$
        ResourceType: string
        -- An ARN that uniquely identifies the base recovery point for scanning. This field will only be populated when an incremental scan job has taken place.
        ScanBaseRecoveryPointArn: string
        -- The scan ID generated by Amazon GuardDuty for the corresponding Scan Job ID request from Backup.
        ScanId: string
        -- The scan job ID that uniquely identified the request to Backup.
        ScanJobId: string
        -- Specifies the scan type used for the scan job.
        ScanMode: string
        -- Contains the ScanResultsStatus for the scanning job and returns THREATS_FOUND or NO_THREATS_FOUND for completed jobs.
        ScanResult: ScanResultInfo
        -- Specifies the scanner IAM role ARN used to for the scan job.
        ScannerRoleArn: string
        -- The current state of a scan job.
        State: string
        -- A detailed message explaining the status of the job to back up a resource.
        StatusMessage: string
    end

