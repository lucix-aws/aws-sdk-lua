    enum DataDeletionPolicy
        "RETAIN"
        "DELETE"
    end

    -- The specific filters applied to your data source content. You can filter out or include certain content.
    record PatternObjectFilter
        -- The supported object type or content type of the data source.
        objectType: string
        -- A list of one or more inclusion regular expression patterns to include certain object types that adhere to the pattern. If you specify an inclusion and exclusion filter/pattern and both match a document, the exclusion filter takes precedence and the document isn’t crawled.
        inclusionFilters: {string}
        -- A list of one or more exclusion regular expression patterns to exclude certain object types that adhere to the pattern. If you specify an inclusion and exclusion filter/pattern and both match a document, the exclusion filter takes precedence and the document isn’t crawled.
        exclusionFilters: {string}
    end

    -- The configuration of filtering certain objects or content types of the data source.
    record PatternObjectFilterConfiguration
        -- The configuration of specific filters applied to your data source content. You can filter out or include certain content.
        filters: {PatternObjectFilter}
    end

    enum CrawlFilterConfigurationType
        "PATTERN"
    end

    -- The configuration of filtering the data source content. For example, configuring regular expression patterns to include or exclude certain content.
    record CrawlFilterConfiguration
        -- The configuration of filtering certain objects or content types of the data source.
        patternObjectFilter: PatternObjectFilterConfiguration
    end

    -- The configuration of the Confluence content. For example, configuring specific types of Confluence content.
    record ConfluenceCrawlerConfiguration
        -- The configuration of filtering the Confluence content. For example, configuring regular expression patterns to include or exclude certain content.
        filterConfiguration: CrawlFilterConfiguration
    end

    enum ConfluenceAuthType
        "BASIC"
        "OAUTH2_CLIENT_CREDENTIALS"
    end

    enum ConfluenceHostType
        "SAAS"
