        Entities: {PiiEntity}
    end

    record DetectSentimentInput
        -- A UTF-8 text string. The maximum string size is 5 KB.
        Text: string
        -- The language of the input documents. You can specify any of the primary languages
        -- supported by Amazon Comprehend. All documents must be in the same language.
        LanguageCode: string
    end

    record DetectSentimentOutput
        -- The inferred sentiment that Amazon Comprehend has the highest level of confidence
        -- in.
        Sentiment: string
        -- An object that lists the sentiments, and their corresponding confidence
        -- levels.
        SentimentScore: SentimentScore
    end

    record DetectSyntaxInput
        -- A UTF-8 string. The maximum string size is 5 KB.
        Text: string
        -- The language code of the input documents. You can specify any of the following languages
        -- supported by Amazon Comprehend: German ("de"), English ("en"), Spanish ("es"), French ("fr"),
        -- Italian ("it"), or Portuguese ("pt").
        LanguageCode: string
    end

    record DetectSyntaxOutput
        -- A collection of syntax tokens describing the text. For each token, the response provides
        -- the text, the token type, where the text begins and ends, and the level of confidence that
        -- Amazon Comprehend has that the token is correct. For a list of token types, see
        -- Syntax in the Comprehend Developer Guide.
        SyntaxTokens: {SyntaxToken}
    end

    record DetectTargetedSentimentInput
        -- A UTF-8 text string. The maximum string length is 5 KB.
        Text: string
        -- The language of the input documents. Currently, English is the only supported language.
        LanguageCode: string
    end

    record DetectTargetedSentimentOutput
        -- Targeted sentiment analysis for each of the entities identified in the input text.
        Entities: {TargetedSentimentEntity}
    end

    -- One of the of text strings. Each string has a size limit of 1KB.
    record TextSegment
        -- The text content.
        Text: string
    end

    record DetectToxicContentInput
        -- A list of up to 10 text strings. Each string has a maximum size of 1 KB, and
        -- the maximum size of the list is 10 KB.
        TextSegments: {TextSegment}
        -- The language of the input text. Currently, English is the only supported language.
        LanguageCode: string
    end

    enum ToxicContentType
        "GRAPHIC"
        "HARASSMENT_OR_ABUSE"
        "HATE_SPEECH"
        "INSULT"
        "PROFANITY"
        "SEXUAL"
        "VIOLENCE_OR_THREAT"
    end

    -- Toxic content analysis result for one string. For more information about toxicity detection, see Toxicity detection in the Amazon Comprehend Developer Guide
    record ToxicContent
        -- The name of the toxic content type.
        Name: string
        -- Model confidence in the detected content type. Value range is zero to one, where one is highest confidence.
        Score: number
    end

    -- Toxicity analysis result for one string. For more information about toxicity detection, see Toxicity detection in the Amazon Comprehend Developer Guide.
    record ToxicLabels
        -- Array of toxic content types identified in the string.
        Labels: {ToxicContent}
        -- Overall toxicity score for the string. Value range is zero to one, where one is the highest confidence.
        Toxicity: number
    end

    record DetectToxicContentOutput
        -- Results of the content moderation analysis.
        -- Each entry in the results list contains a list of toxic content types identified in
        -- the text, along with a confidence score for each content type.
        -- The results list also includes a toxicity score for each entry in the results list.
        ResultList: {ToxicLabels}
    end

    record ImportModelInput
        -- The Amazon Resource Name (ARN) of the custom model to import.
        SourceModelArn: string
        -- The name to assign to the custom model that is created in Amazon Comprehend by this
        -- import.
        ModelName: string
        -- The version name given to the custom model that is created by this import. Version names
        -- can have a maximum of 256 characters. Alphanumeric characters, hyphens (-) and underscores (_)
        -- are allowed. The version name must be unique among all models with the same classifier name in
        -- the account/Region.
        VersionName: string
        -- ID for the KMS key that Amazon Comprehend uses to encrypt
        -- trained custom models. The ModelKmsKeyId can be either of the following formats:
        -- KMS Key ID: "1234abcd-12ab-34cd-56ef-1234567890ab"
        -- Amazon Resource Name (ARN) of a KMS Key:
        -- "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
        ModelKmsKeyId: string
        -- The Amazon Resource Name (ARN) of the IAM role that
        -- grants Amazon Comprehend permission to use Amazon Key Management Service (KMS) to encrypt or decrypt the custom
        -- model.
        DataAccessRoleArn: string
        -- Tags to associate with the custom model that is created by this import. A tag is a
        -- key-value pair that adds as a metadata to a resource used by Amazon Comprehend. For example, a
        -- tag with "Sales" as the key might be added to a resource to indicate its use by the sales
        -- department.
        Tags: {Tag}
    end

    record ImportModelOutput
        -- The Amazon Resource Name (ARN) of the custom model being imported.
