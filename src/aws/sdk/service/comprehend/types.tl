    record DescribeEntityRecognizerInput
        -- The Amazon Resource Name (ARN) that identifies the entity recognizer.
        EntityRecognizerArn: string
    end

    -- Output data configuration.
    record EntityRecognizerOutputDataConfig
        -- The Amazon S3 prefix for the data lake location of the flywheel statistics.
        FlywheelStatsS3Prefix: string
    end

    -- Detailed information about the accuracy of an entity recognizer for a specific entity
    -- type.
    record EntityTypesEvaluationMetrics
        -- A measure of the usefulness of the recognizer results for a specific entity type in the
        -- test data. High precision means that the recognizer returned substantially more relevant
        -- results than irrelevant ones.
        Precision: number
        -- A measure of how complete the recognizer results are for a specific entity type in the
        -- test data. High recall means that the recognizer returned most of the relevant results.
        Recall: number
        -- A measure of how accurate the recognizer results are for a specific entity type in the
        -- test data. It is derived from the Precision and Recall values. The
        -- F1Score is the harmonic average of the two scores. The highest score is 1, and
        -- the worst score is 0.
        F1Score: number
    end

    -- Individual item from the list of entity types in the metadata of an entity
    -- recognizer.
    record EntityRecognizerMetadataEntityTypesListItem
        -- Type of entity from the list of entity types in the metadata of an entity recognizer.
        Type: string
        -- Detailed information about the accuracy of the entity recognizer for a specific item on
        -- the list of entity types.
        EvaluationMetrics: EntityTypesEvaluationMetrics
        -- Indicates the number of times the given entity type was seen in the training data.
        NumberOfTrainMentions: number
    end

    -- Detailed information about the accuracy of an entity recognizer.
    record EntityRecognizerEvaluationMetrics
        -- A measure of the usefulness of the recognizer results in the test data. High precision
        -- means that the recognizer returned substantially more relevant results than irrelevant ones.
        Precision: number
        -- A measure of how complete the recognizer results are for the test data. High recall means
        -- that the recognizer returned most of the relevant results.
        Recall: number
        -- A measure of how accurate the recognizer results are for the test data. It is derived from
        -- the Precision and Recall values. The F1Score is the
        -- harmonic average of the two scores. For plain text entity recognizer models, the range is 0 to 100,
        -- where 100 is the best score. For PDF/Word entity recognizer models, the range is 0 to 1,
        -- where 1 is the best score.
        F1Score: number
    end

    -- Detailed information about an entity recognizer.
    record EntityRecognizerMetadata
        -- The number of documents in the input data that were used to train the entity recognizer.
        -- Typically this is 80 to 90 percent of the input documents.
        NumberOfTrainedDocuments: number
        -- The number of documents in the input data that were used to test the entity recognizer.
        -- Typically this is 10 to 20 percent of the input documents.
        NumberOfTestDocuments: number
        -- Detailed information about the accuracy of an entity recognizer.
        EvaluationMetrics: EntityRecognizerEvaluationMetrics
        -- Entity types from the metadata of an entity recognizer.
        EntityTypes: {EntityRecognizerMetadataEntityTypesListItem}
    end

    -- Describes information about an entity recognizer.
    record EntityRecognizerProperties
        -- The Amazon Resource Name (ARN) that identifies the entity recognizer.
        EntityRecognizerArn: string
        -- The language of the input documents. All documents must be in the same language. Only
        -- English ("en") is currently supported.
        LanguageCode: string
        -- Provides the status of the entity recognizer.
        Status: string
        -- A description of the status of the recognizer.
        Message: string
        -- The time that the recognizer was submitted for processing.
        SubmitTime: number
        -- The time that the recognizer creation completed.
        EndTime: number
        -- The time that training of the entity recognizer started.
        TrainingStartTime: number
        -- The time that training of the entity recognizer was completed.
        TrainingEndTime: number
        -- The input data properties of an entity recognizer.
        InputDataConfig: EntityRecognizerInputDataConfig
        -- Provides information about an entity recognizer.
        RecognizerMetadata: EntityRecognizerMetadata
        -- The Amazon Resource Name (ARN) of the IAM role that
        -- grants Amazon Comprehend read access to your input data.
        DataAccessRoleArn: string
        -- ID for the Amazon Web Services Key Management Service (KMS) key that Amazon Comprehend uses to encrypt
        -- data on the storage volume attached to the ML compute instance(s) that process the analysis
        -- job. The VolumeKmsKeyId can be either of the following formats:
        -- KMS Key ID: "1234abcd-12ab-34cd-56ef-1234567890ab"
        -- Amazon Resource Name (ARN) of a KMS Key:
        -- "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
        VolumeKmsKeyId: string
        -- Configuration parameters for a private Virtual Private Cloud (VPC) containing the
        -- resources you are using for your custom entity recognizer. For more information, see Amazon
        -- VPC.
        VpcConfig: VpcConfig
        -- ID for the KMS key that Amazon Comprehend uses to encrypt
        -- trained custom models. The ModelKmsKeyId can be either of the following formats:
        -- KMS Key ID: "1234abcd-12ab-34cd-56ef-1234567890ab"
        -- Amazon Resource Name (ARN) of a KMS Key:
        -- "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
        ModelKmsKeyId: string
        -- The version name you assigned to the entity recognizer.
        VersionName: string
        -- The Amazon Resource Name (ARN) of the source model. This model was imported from a
        -- different Amazon Web Services account to create the entity recognizer model in your Amazon Web Services account.
        SourceModelArn: string
        -- The Amazon Resource Number (ARN) of the flywheel
        FlywheelArn: string
        -- Output data configuration.
        OutputDataConfig: EntityRecognizerOutputDataConfig
    end

    record DescribeEntityRecognizerOutput
        -- Describes information associated with an entity recognizer.
        EntityRecognizerProperties: EntityRecognizerProperties
    end

