            for k, _ in pairs(b) do if a[k] == nil then return false end end
            return true
        end
        assert.is_true(deep_eq(result.properties, expected_props), "properties mismatch")
    end)

    it("Required mode succeeds through the bus ARN account.", function()
        local params = {
            Region = "us-east-1",
            EventBusArn = "arn:aws:events:us-east-1:210987654321:event-busv2/owner-bus/abcdefghij0123456789abcde",
            AccountIdEndpointMode = "required",
        }
        local result, err = endpoint.resolve(ruleset, params)
        assert.is_not_nil(result, "expected endpoint but got error: " .. tostring(err))
        assert.are.equal("https://210987654321.eventsv2.us-east-1.amazonaws.com", result.url)
        assert.is_not_nil(result.properties, "missing properties")
        local expected_props = {
            metricValues = {
            "O",
        },
        }
        local function deep_eq(a, b)
            if type(a) ~= type(b) then return false end
            if type(a) ~= "table" then return a == b end
            for k, v in pairs(a) do if not deep_eq(v, b[k]) then return false end end
            for k, _ in pairs(b) do if a[k] == nil then return false end end
            return true
        end
        assert.is_true(deep_eq(result.properties, expected_props), "properties mismatch")
    end)

    it("Account-based endpoint in the aws-cn partition when mode is preferred, composing the cn DNS suffix.", function()
        local params = {
            Region = "cn-north-1",
            AccountId = "123456789012",
            AccountIdEndpointMode = "preferred",
        }
        local result, err = endpoint.resolve(ruleset, params)
        assert.is_not_nil(result, "expected endpoint but got error: " .. tostring(err))
        assert.are.equal("https://123456789012.eventsv2.cn-north-1.amazonaws.com.cn", result.url)
        assert.is_not_nil(result.properties, "missing properties")
        local expected_props = {
            metricValues = {
            "O",
        },
        }
        local function deep_eq(a, b)
            if type(a) ~= type(b) then return false end
            if type(a) ~= "table" then return a == b end
            for k, v in pairs(a) do if not deep_eq(v, b[k]) then return false end end
            for k, _ in pairs(b) do if a[k] == nil then return false end end
            return true
        end
        assert.is_true(deep_eq(result.properties, expected_props), "properties mismatch")
    end)

end)
