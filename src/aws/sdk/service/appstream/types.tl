        "VPC_CONFIGURATION_SECURITY_GROUP_IDS"
        "DOMAIN_JOIN_INFO"
        "IAM_ROLE_ARN"
        "USB_DEVICE_FILTER_STRINGS"
        "SESSION_SCRIPT_S3_LOCATION"
        "MAX_SESSIONS_PER_INSTANCE"
        "VOLUME_CONFIGURATION"
    end

    record GetExportImageTaskInput
        -- The unique identifier of the export image task to retrieve information about.
        TaskId: string
    end

    record GetExportImageTaskOutput
        -- Information about the export image task, including its current state, created date, and any error details.
        ExportImageTask: ExportImageTask
    end

    record ListAssociatedFleetsInput
        -- The name of the stack.
        StackName: string
        -- The pagination token to use to retrieve the next page of results for this operation. If this value is null, it retrieves the first page.
        NextToken: string
    end

    record ListAssociatedFleetsOutput
        -- The name of the fleet.
        Names: {string}
        -- The pagination token to use to retrieve the next page of results for this operation. If there are no more pages, this value is null.
        NextToken: string
    end

    record ListAssociatedStacksInput
        -- The name of the fleet.
        FleetName: string
        -- The pagination token to use to retrieve the next page of results for this operation. If this value is null, it retrieves the first page.
        NextToken: string
    end

    record ListAssociatedStacksOutput
        -- The name of the stack.
        Names: {string}
        -- The pagination token to use to retrieve the next page of results for this operation. If there are no more pages, this value is null.
        NextToken: string
    end

    record ListEntitledApplicationsInput
        -- The name of the stack with which the entitlement is associated.
        StackName: string
        -- The name of the entitlement.
        EntitlementName: string
        -- The pagination token used to retrieve the next page of results for this operation.
        NextToken: string
        -- The maximum size of each page of results.
        MaxResults: number
    end

    record ListEntitledApplicationsOutput
        -- The entitled applications.
        EntitledApplications: {EntitledApplication}
        -- The pagination token used to retrieve the next page of results for this operation.
        NextToken: string
    end

    record ListExportImageTasksInput
        -- Optional filters to apply when listing export image tasks. Filters help you narrow down the results based on specific criteria.
        Filters: {Filter}
        -- The maximum number of export image tasks to return in a single request. The valid range is 1-500, with a default of 50.
        MaxResults: number
        -- The pagination token from a previous request. Use this to retrieve the next page of results when there are more tasks than the MaxResults limit.
        NextToken: string
    end

    record ListExportImageTasksOutput
        -- The list of export image tasks that match the specified criteria.
        ExportImageTasks: {ExportImageTask}
        -- The pagination token to use for retrieving the next page of results. This field is only present when there are more results available.
        NextToken: string
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        ResourceArn: string
    end

    record ListTagsForResourceOutput
        -- The information about the tags.
        Tags: {string : string}
    end

