        -- The workflow's ID.
        workflowId: string
        -- The workflow version name.
        versionName: string
        -- The workflow version status.
        status: string
        -- The workflow version's tags.
        tags: {string : string}
        -- The universally unique identifier (UUID) value for this workflow version.
        uuid: string
