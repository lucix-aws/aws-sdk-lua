        integerValue: number
        -- A long value.
        longValue: number
        -- A string value.
        stringValue: string
        -- A list of multiple values.
        listValue: {DataValue}
        -- An object that maps strings to multiple DataValue objects.
        mapValue: {string : DataValue}
        -- A value that relates a component to another component.
