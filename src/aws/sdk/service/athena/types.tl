    enum QueryResultType
        "DATA_MANIFEST"
        "DATA_ROWS"
    end

    record GetQueryResultsInput
        -- The unique ID of the query execution.
        QueryExecutionId: string
        -- A token generated by the Athena service that specifies where to continue
        -- pagination if a previous request was truncated. To obtain the next set of pages, pass in
        -- the NextToken from the response object of the previous page call.
        NextToken: string
        -- The maximum number of results (rows) to return in this request.
        MaxResults: number
        -- When you set this to DATA_ROWS or empty, GetQueryResults
        -- returns the query results in rows. If set to DATA_MANIFEST, it returns the
        -- manifest file in rows. Only the query types CREATE TABLE AS SELECT,
        -- UNLOAD, and INSERT can generate a manifest file. If you
        -- use DATA_MANIFEST for other query types, the query will fail.
        QueryResultType: string
    end

    enum ColumnNullable
        "NOT_NULL"
        "NULLABLE"
        "UNKNOWN"
    end

    -- Information about the columns in a query execution result.
    record ColumnInfo
        -- The catalog to which the query results belong.
        CatalogName: string
        -- The schema name (database name) to which the query results belong.
        SchemaName: string
        -- The table name for the query results.
        TableName: string
        -- The name of the column.
        Name: string
        -- A column label.
        Label: string
        -- The data type of the column.
        Type: string
        -- For DECIMAL data types, specifies the total number of digits, up to 38.
        -- For performance reasons, we recommend up to 18 digits.
        Precision: number
        -- For DECIMAL data types, specifies the total number of digits in the
        -- fractional part of the value. Defaults to 0.
        Scale: number
        -- Unsupported constraint. This value always shows as UNKNOWN.
        Nullable: string
        -- Indicates whether values in the column are case-sensitive.
        CaseSensitive: boolean
    end

    -- The metadata that describes the column structure and data types of a table of query
    -- results. To return a ResultSetMetadata object, use GetQueryResults.
    record ResultSetMetadata
        -- Information about the columns returned in a query result metadata.
        ColumnInfo: {ColumnInfo}
    end

    -- A piece of data (a field in the table).
    record Datum
        -- The value of the datum.
        VarCharValue: string
    end

    -- The rows that make up a query result table.
    record Row
        -- The data that populates a row in a query result table.
        Data: {Datum}
    end

    -- The metadata and rows that make up a query result set. The metadata describes the
    -- column structure and data types. To return a ResultSet object, use GetQueryResults.
    record ResultSet
        -- The rows in the table.
        Rows: {Row}
        -- The metadata that describes the column structure and data types of a table of query
        -- results.
        ResultSetMetadata: ResultSetMetadata
    end

    record GetQueryResultsOutput
        -- The number of rows inserted with a CREATE TABLE AS SELECT, INSERT
        -- INTO, or UPDATE statement.
        UpdateCount: number
        -- The results of the query execution.
        ResultSet: ResultSet
        -- A token generated by the Athena service that specifies where to continue
        -- pagination if a previous request was truncated. To obtain the next set of pages, pass in
        -- the NextToken from the response object of the previous page call.
        NextToken: string
    end

    record GetQueryRuntimeStatisticsInput
        -- The unique ID of the query execution.
        QueryExecutionId: string
    end

    -- Statistics such as input rows and bytes read by the query, rows and bytes output by
    -- the query, and the number of rows written by the query.
    record QueryRuntimeStatisticsRows
        -- The number of rows read to execute the query.
        InputRows: number
        -- The number of bytes read to execute the query.
        InputBytes: number
        -- The number of bytes returned by the query.
        OutputBytes: number
        -- The number of rows returned by the query.
        OutputRows: number
    end

    -- Timeline statistics such as query queue time, planning time, execution time, service
    -- processing time, and total execution time.
    record QueryRuntimeStatisticsTimeline
        -- The number of milliseconds that the query was in your query queue waiting for
        -- resources. Note that if transient errors occur, Athena might automatically
        -- add the query back to the queue.
        QueryQueueTimeInMillis: number
        -- The number of milliseconds that Athena spends on preprocessing before it
        -- submits the query to the engine.
        ServicePreProcessingTimeInMillis: number
        -- The number of milliseconds that Athena took to plan the query processing
        -- flow. This includes the time spent retrieving table partitions from the data source.
        -- Note that because the query engine performs the query planning, query planning time is a
        -- subset of engine processing time.
        QueryPlanningTimeInMillis: number
        -- The number of milliseconds that the query took to execute.
        EngineExecutionTimeInMillis: number
        -- The number of milliseconds that Athena took to finalize and publish the
        -- query results after the query engine finished running the query.
        ServiceProcessingTimeInMillis: number
        -- The number of milliseconds that Athena took to run the query.
        TotalExecutionTimeInMillis: number
    end

    record GetResourceDashboardInput
        -- The The Amazon Resource Name (ARN) for a session.
        ResourceARN: string
    end

    record GetResourceDashboardOutput
        -- The Live UI/Persistence UI url for a session.
        Url: string
    end

    record GetSessionInput
        -- The session ID.
        SessionId: string
    end

    -- Contains session configuration information.
    record SessionConfiguration
        -- The ARN of the execution role used to access user resources for Spark sessions and
        -- Identity Center enabled workgroups. This property applies only to Spark enabled
        -- workgroups and Identity Center enabled workgroups.
        ExecutionRole: string
        -- The Amazon S3 location that stores information for the notebook.
        WorkingDirectory: string
        -- The idle timeout in seconds for the session.
        IdleTimeoutSeconds: number
        -- The idle timeout in seconds for the session.
        SessionIdleTimeoutInMinutes: number
        EncryptionConfiguration: EncryptionConfiguration
    end

    -- Contains statistics for a session.
    record SessionStatistics
        -- The data processing unit execution time for a session in milliseconds.
        DpuExecutionInMillis: number
    end

    enum SessionState
        "CREATING"
        "CREATED"
        "IDLE"
        "BUSY"
        "TERMINATING"
        "TERMINATED"
        "DEGRADED"
        "FAILED"
    end

    -- Contains information about the status of a session.
    record SessionStatus
        -- The date and time that the session started.
        StartDateTime: number
        -- The most recent date and time that the session was modified.
        LastModifiedDateTime: number
        -- The date and time that the session ended.
        EndDateTime: number
        -- The date and time starting at which the session became idle. Can be empty if the
        -- session is not currently idle.
        IdleSinceDateTime: number
        -- The state of the session. A description of each state follows.
        -- CREATING - The session is being started, including acquiring
        -- resources.
        -- CREATED - The session has been started.
        -- IDLE - The session is able to accept a calculation.
        -- BUSY - The session is processing another task and is unable to accept a
        -- calculation.
        -- TERMINATING - The session is in the process of shutting down.
        -- TERMINATED - The session and its resources are no longer running.
        -- DEGRADED - The session has no healthy coordinators.
        -- FAILED - Due to a failure, the session and its resources are no longer
        -- running.
        State: string
        -- The reason for the session state change (for example, canceled because the session was
        -- terminated).
        StateChangeReason: string
    end

    record GetSessionOutput
        -- The session ID.
        SessionId: string
        -- The session description.
        Description: string
        -- The workgroup to which the session belongs.
        WorkGroup: string
        -- The engine version used by the session (for example, PySpark engine version
        -- 3). You can get a list of engine versions by calling ListEngineVersions.
        EngineVersion: string
        -- Contains engine configuration information like DPU usage.
        EngineConfiguration: EngineConfiguration
        -- The notebook version.
        NotebookVersion: string
        MonitoringConfiguration: MonitoringConfiguration
        -- Contains the workgroup configuration information used by the session.
        SessionConfiguration: SessionConfiguration
        -- Contains information about the status of the session.
        Status: SessionStatus
        -- Contains the DPU execution time.
        Statistics: SessionStatistics
    end

    record GetSessionEndpointInput
        -- The session ID.
        SessionId: string
    end

    record GetSessionEndpointOutput
        -- The endpoint for connecting to the session.
        EndpointUrl: string
        -- Authentication token for the connection
        AuthToken: string
        -- Expiration time of the auth token.
        AuthTokenExpirationTime: number
    end

    record GetSessionStatusInput
        -- The session ID.
        SessionId: string
    end

    record GetSessionStatusOutput
        -- The session ID.
        SessionId: string
        -- Contains information about the status of the session.
        Status: SessionStatus
    end

