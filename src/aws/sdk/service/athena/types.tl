    record GetCalculationExecutionInput
        -- The calculation execution UUID.
        CalculationExecutionId: string
    end

    -- Contains information about an application-specific calculation result.
    record CalculationResult
        -- The Amazon S3 location of the stdout file for the calculation.
        StdOutS3Uri: string
        -- The Amazon S3 location of the stderr error messages file for the
        -- calculation.
        StdErrorS3Uri: string
        -- The Amazon S3 location of the folder for the calculation results.
        ResultS3Uri: string
        -- The data format of the calculation result.
        ResultType: string
    end

    -- Contains statistics for a notebook calculation.
    record CalculationStatistics
        -- The data processing unit execution time in milliseconds for the calculation.
        DpuExecutionInMillis: number
        -- The progress of the calculation.
        Progress: string
    end

    enum CalculationExecutionState
        "CREATING"
        "CREATED"
        "QUEUED"
        "RUNNING"
        "CANCELING"
        "CANCELED"
        "COMPLETED"
        "FAILED"
    end

    -- Contains information about the status of a notebook calculation.
    record CalculationStatus
        -- The date and time the calculation was submitted for processing.
        SubmissionDateTime: number
        -- The date and time the calculation completed processing.
        CompletionDateTime: number
        -- The state of the calculation execution. A description of each state follows.
        -- CREATING - The calculation is in the process of being created.
        -- CREATED - The calculation has been created and is ready to run.
        -- QUEUED - The calculation has been queued for processing.
        -- RUNNING - The calculation is running.
        -- CANCELING - A request to cancel the calculation has been received and the
        -- system is working to stop it.
        -- CANCELED - The calculation is no longer running as the result of a cancel
        -- request.
        -- COMPLETED - The calculation has completed without error.
        -- FAILED - The calculation failed and is no longer running.
        State: string
        -- The reason for the calculation state change (for example, the calculation was canceled
        -- because the session was terminated).
        StateChangeReason: string
    end

    record GetCalculationExecutionOutput
        -- The calculation execution UUID.
        CalculationExecutionId: string
        -- The session ID that the calculation ran in.
        SessionId: string
        -- The description of the calculation execution.
        Description: string
        -- The Amazon S3 location in which calculation results are stored.
        WorkingDirectory: string
        -- Contains information about the status of the calculation.
        Status: CalculationStatus
        -- Contains information about the data processing unit (DPU) execution time and progress.
        -- This field is populated only when statistics are available.
        Statistics: CalculationStatistics
        -- Contains result information. This field is populated only if the calculation is
        -- completed.
        Result: CalculationResult
    end

    record GetCalculationExecutionCodeInput
        -- The calculation execution UUID.
        CalculationExecutionId: string
    end

    record GetCalculationExecutionCodeOutput
        -- The unencrypted code that was executed for the calculation.
        CodeBlock: string
    end

    record GetCalculationExecutionStatusInput
        -- The calculation execution UUID.
        CalculationExecutionId: string
    end

    record GetCalculationExecutionStatusOutput
        -- Contains information about the calculation execution status.
        Status: CalculationStatus
        -- Contains information about the DPU execution time and progress.
        Statistics: CalculationStatistics
    end

    record GetCapacityAssignmentConfigurationInput
        -- The name of the capacity reservation to retrieve the capacity assignment configuration
        -- for.
        CapacityReservationName: string
    end

    -- A mapping between one or more workgroups and a capacity reservation.
    record CapacityAssignment
        -- The list of workgroup names for the capacity assignment.
        WorkGroupNames: {string}
    end

    -- Assigns Athena workgroups (and hence their queries) to capacity
    -- reservations. A capacity reservation can have only one capacity assignment
    -- configuration, but the capacity assignment configuration can be made up of multiple
    -- individual assignments. Each assignment specifies how Athena queries can
    -- consume capacity from the capacity reservation that their workgroup is mapped to.
    record CapacityAssignmentConfiguration
        -- The name of the reservation that the capacity assignment configuration is for.
        CapacityReservationName: string
        -- The list of assignments that make up the capacity assignment configuration.
        CapacityAssignments: {CapacityAssignment}
    end

    record GetCapacityAssignmentConfigurationOutput
        -- The requested capacity assignment configuration for the specified capacity
        -- reservation.
        CapacityAssignmentConfiguration: CapacityAssignmentConfiguration
    end

    record GetCapacityReservationInput
        -- The name of the capacity reservation.
        Name: string
    end

    enum CapacityAllocationStatus
        "PENDING"
        "SUCCEEDED"
        "FAILED"
    end

    -- Contains the submission time of a single allocation request for a capacity reservation
    -- and the most recent status of the attempted allocation.
    record CapacityAllocation
        -- The status of the capacity allocation.
        Status: string
        -- The status message of the capacity allocation.
        StatusMessage: string
        -- The time when the capacity allocation was requested.
        RequestTime: number
        -- The time when the capacity allocation request was completed.
        RequestCompletionTime: number
    end

    enum CapacityReservationStatus
        "PENDING"
        "ACTIVE"
        "CANCELLING"
        "CANCELLED"
        "FAILED"
        "UPDATE_PENDING"
    end

    -- A reservation for a specified number of data processing units (DPUs). When a
    -- reservation is initially created, it has no DPUs. Athena allocates DPUs
    -- until the allocated amount equals the requested amount.
    record CapacityReservation
        -- The name of the capacity reservation.
        Name: string
        -- The status of the capacity reservation.
        Status: string
        -- The number of data processing units requested.
        TargetDpus: number
        -- The number of data processing units currently allocated.
        AllocatedDpus: number
        LastAllocation: CapacityAllocation
        -- The time of the most recent capacity allocation that succeeded.
        LastSuccessfulAllocationTime: number
        -- The time in UTC epoch millis when the capacity reservation was created.
        CreationTime: number
    end

    record GetCapacityReservationOutput
        -- The requested capacity reservation structure.
        CapacityReservation: CapacityReservation
    end

    record GetDatabaseInput
        -- The name of the data catalog that contains the database to return.
        CatalogName: string
        -- The name of the database to return.
        DatabaseName: string
        -- The name of the workgroup for which the metadata is being fetched. Required if
        -- requesting an IAM Identity Center enabled Glue Data Catalog.
        WorkGroup: string
    end

    -- Contains metadata information for a database in a data catalog.
    record Database
        -- The name of the database.
