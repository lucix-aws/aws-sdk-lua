        status: string
    end

    record ListFiltersOutput
        -- A list of returned filters.
        Filters: {FilterSummary}
        -- A token for getting the next set of filters (if they exist).
        nextToken: string
    end

    record ListMetricAttributionMetricsInput
        -- The Amazon Resource Name (ARN) of the metric attribution to retrieve attributes for.
        metricAttributionArn: string
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        nextToken: string
        -- The maximum number of metrics to return in one page of results.
        maxResults: number
    end

    record ListMetricAttributionMetricsOutput
        -- The metrics for the specified metric attribution.
        metrics: {MetricAttribute}
        -- Specify the pagination token from a previous ListMetricAttributionMetricsResponse request to retrieve the next page of results.
        nextToken: string
    end

    record ListMetricAttributionsInput
        -- The metric attributions' dataset group Amazon Resource Name (ARN).
        datasetGroupArn: string
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        nextToken: string
        -- The maximum number of metric attributions to return in one page of results.
        maxResults: number
    end

    -- Provides a summary of the properties of a metric attribution. For a complete listing, call the DescribeMetricAttribution.
    record MetricAttributionSummary
        -- The name of the metric attribution.
        name: string
        -- The metric attribution's Amazon Resource Name (ARN).
        metricAttributionArn: string
        -- The metric attribution's status.
        status: string
        -- The metric attribution's creation date time.
        creationDateTime: number
        -- The metric attribution's last updated date time.
        lastUpdatedDateTime: number
        -- The metric attribution's failure reason.
        failureReason: string
    end

    record ListMetricAttributionsOutput
        -- The list of metric attributions.
        metricAttributions: {MetricAttributionSummary}
        -- Specify the pagination token from a previous request to retrieve the next page of results.
        nextToken: string
    end

    enum RecipeProvider
        "SERVICE"
    end

    record ListRecipesInput
        -- The default is SERVICE.
        recipeProvider: string
        -- A token returned from the previous call to ListRecipes for getting
        -- the next set of recipes (if they exist).
        nextToken: string
        -- The maximum number of recipes to return.
        maxResults: number
        -- Filters returned recipes by domain for a Domain dataset group. Only recipes (Domain dataset group use cases)
        -- for this domain are included in the response. If you don't specify a domain, all recipes are returned.
        domain: string
    end

    -- Provides a summary of the properties of a recipe. For a complete listing, call the
    -- DescribeRecipe API.
    record RecipeSummary
        -- The name of the recipe.
        name: string
        -- The Amazon Resource Name (ARN) of the recipe.
        recipeArn: string
        -- The status of the recipe.
        status: string
        -- The date and time (in Unix time) that the recipe was created.
        creationDateTime: number
        -- The date and time (in Unix time) that the recipe was last updated.
        lastUpdatedDateTime: number
        -- The domain of the recipe (if the recipe is a Domain dataset group use case).
        domain: string
    end

    record ListRecipesOutput
        -- The list of available recipes.
        recipes: {RecipeSummary}
        -- A token for getting the next set of recipes.
        nextToken: string
    end

    record ListRecommendersInput
        -- The Amazon Resource Name (ARN) of the Domain dataset group to list the recommenders for. When
        -- a Domain dataset group is not specified, all the recommenders associated with the account are listed.
        datasetGroupArn: string
        -- A token returned from the previous call to ListRecommenders for getting
        -- the next set of recommenders (if they exist).
        nextToken: string
        -- The maximum number of recommenders to return.
        maxResults: number
    end

    -- Provides a summary of the properties of the recommender.
    record RecommenderSummary
        -- The name of the recommender.
        name: string
        -- The Amazon Resource Name (ARN) of the recommender.
        recommenderArn: string
        -- The Amazon Resource Name (ARN) of the Domain dataset group that contains the recommender.
        datasetGroupArn: string
        -- The Amazon Resource Name (ARN) of the recipe (Domain dataset group use case) that the recommender was created for.
        recipeArn: string
        -- The configuration details of the recommender.
        recommenderConfig: RecommenderConfig
        -- The status of the recommender. A recommender can be in one of the following states:
        -- CREATE PENDING > CREATE IN_PROGRESS > ACTIVE -or- CREATE FAILED
        -- STOP PENDING > STOP IN_PROGRESS > INACTIVE > START PENDING > START IN_PROGRESS > ACTIVE
        -- DELETE PENDING > DELETE IN_PROGRESS
        status: string
        -- The date and time (in Unix format) that the recommender was created.
        creationDateTime: number
        -- The date and time (in Unix format) that the recommender was last updated.
        lastUpdatedDateTime: number
    end

    record ListRecommendersOutput
        -- A list of the recommenders.
        recommenders: {RecommenderSummary}
        -- A token for getting the next set of recommenders (if they exist).
        nextToken: string
    end

    record ListSchemasInput
        -- A token returned from the previous call to ListSchemas for getting
        -- the next set of schemas (if they exist).
        nextToken: string
        -- The maximum number of schemas to return.
        maxResults: number
    end

    -- Provides a summary of the properties of a dataset schema. For a complete listing, call the
    -- DescribeSchema API.
    record DatasetSchemaSummary
        -- The name of the schema.
        name: string
        -- The Amazon Resource Name (ARN) of the schema.
        schemaArn: string
        -- The date and time (in Unix time) that the schema was created.
        creationDateTime: number
        -- The date and time (in Unix time) that the schema was last updated.
        lastUpdatedDateTime: number
        -- The domain of a schema that you created for a dataset in a Domain dataset group.
        domain: string
    end

    record ListSchemasOutput
        -- A list of schemas.
        schemas: {DatasetSchemaSummary}
        -- A token used to get the next set of schemas (if they exist).
        nextToken: string
    end

    record ListSolutionsInput
        -- The Amazon Resource Name (ARN) of the dataset group.
        datasetGroupArn: string
        -- A token returned from the previous call to ListSolutions for getting
        -- the next set of solutions (if they exist).
        nextToken: string
        -- The maximum number of solutions to return.
        maxResults: number
    end

    -- Provides a summary of the properties of a solution. For a complete listing, call the
    -- DescribeSolution API.
    record SolutionSummary
        -- The name of the solution.
        name: string
        -- The Amazon Resource Name (ARN) of the solution.
        solutionArn: string
        -- The status of the solution.
        -- A solution can be in one of the following states:
        -- CREATE PENDING > CREATE IN_PROGRESS > ACTIVE -or- CREATE FAILED
        -- DELETE PENDING > DELETE IN_PROGRESS
        status: string
        -- The date and time (in Unix time) that the solution was created.
        creationDateTime: number
        -- The date and time (in Unix time) that the solution was last updated.
        lastUpdatedDateTime: number
        -- The Amazon Resource Name (ARN) of the recipe used by the solution.
        recipeArn: string
    end

    record ListSolutionsOutput
        -- A list of the current solutions.
        solutions: {SolutionSummary}
        -- A token for getting the next set of solutions (if they exist).
        nextToken: string
    end

    record ListSolutionVersionsInput
        -- The Amazon Resource Name (ARN) of the solution.
        solutionArn: string
        -- A token returned from the previous call to ListSolutionVersions for getting
        -- the next set of solution versions (if they exist).
        nextToken: string
        -- The maximum number of solution versions to return.
        maxResults: number
    end

    record ListSolutionVersionsOutput
        -- A list of solution versions describing the version properties.
        solutionVersions: {SolutionVersionSummary}
        -- A token for getting the next set of solution versions (if they exist).
        nextToken: string
    end

    record ListTagsForResourceInput
        -- The resource's Amazon Resource Name (ARN).
        resourceArn: string
    end

    record ListTagsForResourceOutput
        -- The resource's tags.
        tags: {Tag}
    end

    record StartRecommenderInput
        -- The Amazon Resource Name (ARN) of the recommender to start.
        recommenderArn: string
    end

    record StartRecommenderOutput
        -- The Amazon Resource Name (ARN) of the recommender you started.
        recommenderArn: string
    end

    record StopRecommenderInput
        -- The Amazon Resource Name (ARN) of the recommender to stop.
        recommenderArn: string
    end

    record StopRecommenderOutput
        -- The Amazon Resource Name (ARN) of the recommender you stopped.
        recommenderArn: string
    end

    record StopSolutionVersionCreationInput
        -- The Amazon Resource Name (ARN) of the solution version you want to stop creating.
        solutionVersionArn: string
    end

    record StopSolutionVersionCreationOutput
    end

    record TagResourceInput
        -- The resource's Amazon Resource Name (ARN).
        resourceArn: string
        -- Tags to apply to the resource. For more information see Tagging Amazon Personalize resources.
        tags: {Tag}
    end

    record TagResourceOutput
    end

    -- The request contains more tag keys than can be associated with a resource (50 tag keys per resource).
    record TooManyTagKeysException
        message: string
    end

    record UntagResourceInput
        -- The resource's Amazon Resource Name (ARN).
        resourceArn: string
        -- The keys of the tags to be removed.
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateCampaignInput
        -- The Amazon Resource Name (ARN) of the campaign.
        campaignArn: string
        -- The Amazon Resource Name (ARN) of a new model to deploy. To specify the latest solution version of your solution,
        -- specify the ARN of your solution in SolutionArn/$LATEST format.
        -- You must use this format if you set syncWithLatestSolutionVersion to True in the
        -- CampaignConfig.
        -- To deploy a model that isn't the latest solution version of your solution, specify the ARN of the solution version.
        -- For more information about automatic campaign updates, see
        -- Enabling automatic campaign updates.
        solutionVersionArn: string
        -- Specifies the requested minimum provisioned transactions (recommendations) per second that
        -- Amazon Personalize will support. A high minProvisionedTPS will increase your bill. We recommend starting with 1 for minProvisionedTPS (the default). Track
        -- your usage using Amazon CloudWatch metrics, and increase the minProvisionedTPS
        -- as necessary.
        minProvisionedTPS: number
        -- The configuration details of a campaign.
        campaignConfig: CampaignConfig
    end

    record UpdateCampaignOutput
        -- The same campaign ARN as given in the request.
        campaignArn: string
    end

    record UpdateDatasetInput
        -- The Amazon Resource Name (ARN) of the dataset that you want to update.
        datasetArn: string
        -- The Amazon Resource Name (ARN) of the new schema you want use.
        schemaArn: string
    end

    record UpdateDatasetOutput
        -- The Amazon Resource Name (ARN) of the dataset you updated.
        datasetArn: string
    end

    record UpdateMetricAttributionInput
        -- Add new metric attributes to the metric attribution.
        addMetrics: {MetricAttribute}
        -- Remove metric attributes from the metric attribution.
        removeMetrics: {string}
        -- An output config for the metric attribution.
        metricsOutputConfig: MetricAttributionOutput
        -- The Amazon Resource Name (ARN) for the metric attribution to update.
        metricAttributionArn: string
    end

    record UpdateMetricAttributionOutput
        -- The Amazon Resource Name (ARN) for the metric attribution that you updated.
        metricAttributionArn: string
    end

    record UpdateRecommenderInput
        -- The Amazon Resource Name (ARN) of the recommender to modify.
        recommenderArn: string
        -- The configuration details of the recommender.
        recommenderConfig: RecommenderConfig
    end

    record UpdateRecommenderOutput
        -- The same recommender Amazon Resource Name (ARN) as given in the request.
        recommenderArn: string
    end

    record UpdateSolutionInput
        -- The Amazon Resource Name (ARN) of the solution to update.
        solutionArn: string
        -- Whether the solution uses automatic training to create new solution versions (trained models). You can change the training
        -- frequency by specifying a schedulingExpression in the AutoTrainingConfig as part of solution
        -- configuration.
        -- If you turn on automatic training, the first automatic training starts within one hour after the solution update
        -- completes. If you manually create a solution version within the hour, the solution skips the first automatic training.
        -- For more information about automatic training,
        -- see Configuring automatic training.
        -- After training starts, you can
        -- get the solution version's Amazon Resource Name (ARN) with the ListSolutionVersions API operation.
        -- To get its status, use the DescribeSolutionVersion.
        performAutoTraining: boolean
        -- Whether to perform incremental training updates on your model. When enabled, this allows the model to learn from new data more frequently without requiring full retraining, which enables near real-time personalization. This parameter is supported only for solutions that use the semantic-similarity recipe.
        performIncrementalUpdate: boolean
        -- The new configuration details of the solution.
        solutionUpdateConfig: SolutionUpdateConfig
    end

    record UpdateSolutionOutput
        -- The same solution Amazon Resource Name (ARN) as given in the request.
        solutionArn: string
    end

end

return M
