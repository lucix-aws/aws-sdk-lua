    enum RecoveryInstanceDataReplicationState
        "STOPPED"
        "INITIATING"
        "INITIAL_SYNC"
        "BACKLOG"
        "CREATING_SNAPSHOT"
        "CONTINUOUS"
        "PAUSED"
        "RESCAN"
        "STALLED"
        "DISCONNECTED"
        "REPLICATION_STATE_NOT_AVAILABLE"
        "NOT_STARTED"
    end

