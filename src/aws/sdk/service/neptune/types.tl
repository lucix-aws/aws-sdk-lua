        -- remove authorization for any Amazon account to copy or restore the DB cluster snapshot. If you
        -- specify all, an Amazon account whose account ID is explicitly added to the
        -- restore attribute can still copy or restore a manual DB cluster snapshot.
        ValuesToRemove: {string}
