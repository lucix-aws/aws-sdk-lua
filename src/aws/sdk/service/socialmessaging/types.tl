        templateUseCase: string
        -- The industries the template is designed for.
        templateIndustry: {string}
        -- The header text of the template.
        templateHeader: string
        -- The body text of the template.
        templateBody: string
        -- The buttons included in the template.
        templateButtons: {LibraryTemplateButtonList}
        -- The ID of the template in Meta's library.
        templateId: string
        -- Example parameter values for the template body, used to demonstrate how dynamic content appears in the template.
        templateBodyExampleParams: {string}
    end

    record ListWhatsAppTemplateLibraryOutput
        -- A list of templates from Meta's library.
        metaLibraryTemplates: {MetaLibraryTemplateDefinition}
        -- The token to retrieve the next page of results, if any.
        nextToken: string
    end

    record PublishWhatsAppFlowInput
        -- The ID of the WhatsApp Business Account associated with this Flow.
        id: string
        -- The unique identifier of the Flow to publish.
        flowId: string
    end

    record PublishWhatsAppFlowOutput
    end

    record PutWhatsAppBusinessAccountEventDestinationsInput
        -- The unique identifier of your WhatsApp Business Account. WABA identifiers are formatted as
        -- waba-01234567890123456789012345678901. Use
        -- ListLinkedWhatsAppBusinessAccounts to list all WABAs and their details.
        id: string
        -- An array of WhatsAppBusinessAccountEventDestination event destinations.
        eventDestinations: {WhatsAppBusinessAccountEventDestination}
    end

    record PutWhatsAppBusinessAccountEventDestinationsOutput
    end

    record SendWhatsAppConversionEventInput
        -- The ID of the WhatsApp Business Account associated with the dataset, formatted as waba-01234567890123456789012345678901.
        id: string
        -- The Meta-generated dataset ID to send the event to.
        datasetId: string
        -- The raw Meta Conversions API event payload as a JSON blob. See Meta's server event parameters for the supported format.
        eventData: string
    end

    record SendWhatsAppConversionEventOutput
        -- The unique identifier for the conversion event request.
        requestId: string
    end

    record UpdateWhatsAppFlowInput
        -- The ID of the WhatsApp Business Account associated with this Flow.
        id: string
        -- The unique identifier of the Flow to update.
        flowId: string
        -- The updated name for the Flow.
        flowName: string
        -- The updated categories for the Flow.
        categories: {string}
    end

    record UpdateWhatsAppFlowOutput
    end

    record UpdateWhatsAppFlowAssetsInput
        -- The ID of the WhatsApp Business Account associated with this Flow.
        id: string
        -- The unique identifier of the Flow whose assets to update.
        flowId: string
        -- The updated Flow JSON definition. Maximum size is 10 MB.
        flowJson: string
    end

    record UpdateWhatsAppFlowAssetsOutput
        -- A list of validation errors returned by Meta, if any. Validation errors must be resolved before the Flow can be published.
        validationErrors: {string}
    end

    record UpdateWhatsAppMessageTemplateInput
        -- The ID of the WhatsApp Business Account associated with this template.
        id: string
        -- The numeric ID of the template assigned by Meta.
        metaTemplateId: string
        -- The name of the message template. Use together with templateLanguageCode as an alternative to metaTemplateId to identify a template.
        templateName: string
        -- The language code of the message template (for example, en or en_US). Use together with templateName as an alternative to metaTemplateId to identify a template.
        templateLanguageCode: string
        -- The format specification for parameters in the template, this can be either 'named' or 'positional'.
        parameterFormat: string
        -- The new category for the template (for example, UTILITY or MARKETING).
        templateCategory: string
        -- The updated components of the template as a JSON blob (maximum 3000 characters).
        templateComponents: string
        -- When true, disables click tracking for call-to-action URL buttons in the template.
        ctaUrlLinkTrackingOptedOut: boolean
    end

    record UpdateWhatsAppMessageTemplateOutput
    end

    record PostWhatsAppMessageMediaInput
        -- The ID of the phone number to associate with the WhatsApp media file. The phone number
        -- identifiers are formatted as phone-number-id-01234567890123456789012345678901.
        -- Use GetLinkedWhatsAppBusinessAccount
        -- to find a phone number's id.
        originationPhoneNumberId: string
        -- The source presign url of the media file.
        sourceS3PresignedUrl: S3PresignedUrl
        -- The source S3 url for the media file.
        sourceS3File: S3File
    end

    record PostWhatsAppMessageMediaOutput
        -- The unique identifier of the posted WhatsApp message.
        mediaId: string
    end

    record SendWhatsAppMessageInput
        -- The ID of the phone number used to send the WhatsApp message. If you are sending a media
        -- file only the originationPhoneNumberId used to upload the file can be used.
        -- Phone number identifiers are formatted as
        -- phone-number-id-01234567890123456789012345678901. Use
        -- GetLinkedWhatsAppBusinessAccount to find a phone number's
        -- id.
        originationPhoneNumberId: string
        -- The message to send through WhatsApp. The length is in KB. The message field passes through a WhatsApp
        -- Message object, see Messages in the WhatsApp Business Platform Cloud API
        -- Reference.
        message: string
        -- The API version for the request formatted as v{VersionNumber}. For a list of supported API versions and Amazon Web Services Regions, see
        -- Amazon Web Services End User Messaging Social API Service Endpoints in the Amazon Web Services General Reference.
        metaApiVersion: string
    end

    record SendWhatsAppMessageOutput
        -- The unique identifier of the message.
        messageId: string
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the resource to retrieve the tags from.
        resourceArn: string
    end

    record ListTagsForResourceOutput
        -- The status code of the response.
        statusCode: number
        -- The tags for the resource.
        tags: {Tag}
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the resource to tag.
        resourceArn: string
        -- The tags to add to the resource.
        tags: {Tag}
    end

    record TagResourceOutput
        -- The status code of the tag resource operation.
        statusCode: number
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource to remove tags from.
        resourceArn: string
        -- The keys of the tags to remove from the resource.
        tagKeys: {string}
    end

    record UntagResourceOutput
        -- The status code of the untag resource operation.
        statusCode: number
    end

end

return M
