        -- specific controls for which the enablement status couldn't be retrieved in specified standards when
        -- calling BatchUpdateStandardsControlAssociations.
        StandardsControlAssociationId: StandardsControlAssociationId
        -- The error code for the unprocessed standard and control association. The NOT_FOUND value has been deprecated and
        -- replaced by the RESOURCE_NOT_FOUND value.
        ErrorCode: string
        -- The reason why the standard and control association was unprocessed.
        ErrorReason: string
    end

