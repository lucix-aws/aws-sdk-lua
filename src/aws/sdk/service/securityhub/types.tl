        -- Represents a value for the rule priority.
        RuleOrder: number
        -- A description of the automation rule.
        Description: string
        -- The name of the automation rule.
        RuleName: string
        -- The filtering type and configuration of the automation rule.
        Criteria: Criteria
        -- A list of actions to be performed when the rule criteria is met.
        Actions: {AutomationRulesActionV2}
    end

    record GetFindingStatisticsV2Input
        -- Specifies how security findings should be aggregated and organized in the statistical analysis.
        -- It can accept up to 5 groupBy fields in a single call.
        GroupByRules: {GroupByRule}
        -- Limits the results to findings from specific organizational units or from the delegated administrator's organization.
        -- Only the delegated administrator account can use this parameter. Other accounts receive an AccessDeniedException.
        -- This parameter is optional. If you omit it, the delegated administrator sees statistics from all accounts across the entire organization. Other accounts see only statistics for their own findings.
        -- You can specify up to 10 entries in Scopes.AwsOrganizations. If multiple entries are specified, the entries are combined using OR logic.
        Scopes: FindingScopes
        -- Orders the aggregation count in descending or ascending order.
        -- Descending order is the default.
        SortOrder: string
        -- The maximum number of results to be returned.
        MaxStatisticResults: number
    end

    record GetResourcesStatisticsV2Input
        -- How resource statistics should be aggregated and organized in the response.
        GroupByRules: {ResourceGroupByRule}
        -- Limits the results to resources from specific organizational units or from the delegated administrator's organization.
        -- Only the delegated administrator account can use this parameter. Other accounts receive an AccessDeniedException.
        -- This parameter is optional. If you omit it, the delegated administrator sees statistics from all accounts across the entire organization. Other accounts see only statistics for their own resources.
        -- You can specify up to 10 entries in Scopes.AwsOrganizations. If multiple entries are specified, the entries are combined using OR logic.
        Scopes: ResourceScopes
        -- Sorts aggregated statistics.
        SortOrder: string
        -- The maximum number of results to be returned.
        MaxStatisticResults: number
    end

end

