    -- client-generated idempotency token that, when provided in a request, ensures the request
    -- cannot be repeated with a changed parameter. If a request is received with the same
    -- parameters and a token is included, the request returns information about the initial
    -- request that used that token.
    record ClientRequestTokenRequiredException
        -- Any message associated with the exception.
        message: string
    end

    record CreateApprovalRuleTemplateInput
        -- The name of the approval rule template. Provide descriptive names, because this name
        -- is applied to the approval rules created automatically in associated
        -- repositories.
        approvalRuleTemplateName: string
        -- The content of the approval rule that is created on pull requests in associated
        -- repositories. If you specify one or more destination references (branches), approval
        -- rules are created in an associated repository only if their destination references
        -- (branches) match those specified in the template.
        -- When you create the content of the approval rule template, you can specify
        -- approvers in an approval pool in one of two ways:
        -- CodeCommitApprovers: This option only
        -- requires an Amazon Web Services account and a resource. It can be used for both IAM users
        -- and federated access users whose name matches the provided resource name.
        -- This is a very powerful option that offers a great deal of flexibility. For
        -- example, if you specify the Amazon Web Services account 123456789012
        -- and Mary_Major, all of the following are counted as
        -- approvals coming from that user:
        -- An IAM user in the account
        -- (arn:aws:iam::123456789012:user/Mary_Major)
        -- A federated user identified in IAM as Mary_Major
        -- (arn:aws:sts::123456789012:federated-user/Mary_Major)
        -- This option does not recognize an active session of someone assuming the
        -- role of CodeCommitReview with a role session name of
        -- Mary_Major
        -- (arn:aws:sts::123456789012:assumed-role/CodeCommitReview/Mary_Major)
        -- unless you include a wildcard (*Mary_Major).
        -- Fully qualified ARN: This option allows
        -- you to specify the fully qualified Amazon Resource Name (ARN) of the IAM
        -- user or role.
        -- For more information about IAM ARNs, wildcards, and formats, see IAM
        -- Identifiers in the IAM User Guide.
        approvalRuleTemplateContent: string
        -- The description of the approval rule template. Consider providing a description that
        -- explains what this template does and when it might be appropriate to associate it with
        -- repositories.
        approvalRuleTemplateDescription: string
    end

    record CreateApprovalRuleTemplateOutput
        -- The content and structure of the created approval rule template.
        approvalRuleTemplate: ApprovalRuleTemplate
    end

    -- The content of the approval rule template is not valid.
    record InvalidApprovalRuleTemplateContentException
        -- Any message associated with the exception.
        message: string
    end

    -- The description for the approval rule template is not valid because it exceeds the
    -- maximum characters allowed for a description. For more information about limits in CodeCommit,
    -- see Quotas in the CodeCommit User Guide.
    record InvalidApprovalRuleTemplateDescriptionException
        -- Any message associated with the exception.
        message: string
    end

    -- The maximum number of approval rule templates has been exceeded for this Amazon Web Services Region.
    record NumberOfRuleTemplatesExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- A commit ID was not specified.
    record CommitIdRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- Represents the input of a create branch operation.
    record CreateBranchInput
        -- The name of the repository in which you want to create the new branch.
        repositoryName: string
        -- The name of the new branch to create.
        branchName: string
        -- The ID of the commit to point the new branch to.
        commitId: string
    end

    record CreateBranchOutput
    end

    -- The specified reference name is not valid.
    record InvalidBranchNameException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified commit ID is not valid.
    record InvalidCommitIdException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit message is too long. Provide a shorter string.
    record CommitMessageLengthExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- A file that is deleted as part of a commit.
    record DeleteFileEntry
        -- The full path of the file to be deleted, including the name of the file.
        filePath: string
    end

    -- Information about a source file that is part of changes made in a commit.
    record SourceFileSpecifier
        -- The full path to the file, including the name of the file.
        filePath: string
        -- Whether to remove the source file from the parent commit.
        isMove: boolean
    end

    -- Information about a file added or updated as part of a commit.
    record PutFileEntry
        -- The full path to the file in the repository, including the name of the file.
        filePath: string
        -- The extrapolated file mode permissions for the file. Valid values include EXECUTABLE and NORMAL.
        fileMode: string
        -- The content of the file, if a source file is not specified.
        fileContent: string
        -- The name and full path of the file that contains the changes you want to make as part of the commit,
        -- if you are not providing the file content directly.
        sourceFile: SourceFileSpecifier
    end

    -- Information about the file mode changes.
    record SetFileModeEntry
        -- The full path to the file, including the name of the file.
        filePath: string
        -- The file mode for the file.
        fileMode: string
    end

    record CreateCommitInput
        -- The name of the repository where you create the commit.
        repositoryName: string
        -- The name of the branch where you create the commit.
        branchName: string
        -- The ID of the commit that is the parent of the commit you create. Not required if this
        -- is an empty repository.
        parentCommitId: string
        -- The name of the author who created the commit. This information is used as both the
        -- author and committer for the commit.
        authorName: string
        -- The email address of the person who created the commit.
        email: string
        -- The commit message you want to include in the commit. Commit messages are limited to
        -- 256 KB. If no message is specified, a default message is used.
        commitMessage: string
        -- If the commit contains deletions, whether to keep a folder or folder structure if the
        -- changes leave the folders empty. If true, a ..gitkeep file is created for empty folders.
        -- The default is false.
        keepEmptyFolders: boolean
        -- The files to add or update in this commit.
        putFiles: {PutFileEntry}
        -- The files to delete in this commit. These files still exist in earlier commits.
        deleteFiles: {DeleteFileEntry}
        -- The file modes to update for files in this commit.
        setFileModes: {SetFileModeEntry}
    end

    -- A file to be added, updated, or deleted as part of a commit.
    record FileMetadata
        -- The full path to the file to be added or updated, including the name of the
        -- file.
        absolutePath: string
        -- The blob ID that contains the file information.
        blobId: string
        -- The extrapolated file mode permissions for the file. Valid values include EXECUTABLE and NORMAL.
        fileMode: string
    end

    record CreateCommitOutput
        -- The full commit ID of the commit that contains your committed file changes.
        commitId: string
        -- The full SHA-1 pointer of the tree information for the commit that contains the commited file changes.
        treeId: string
        -- The files added as part of the committed file changes.
        filesAdded: {FileMetadata}
        -- The files updated as part of the commited file changes.
        filesUpdated: {FileMetadata}
        -- The files deleted as part of the committed file changes.
        filesDeleted: {FileMetadata}
    end

    -- A file cannot be added to the repository because the specified path name has the same name as a file that already exists in this repository.
    -- Either provide a different name for the file, or specify a different path for the file.
    record DirectoryNameConflictsWithFileNameException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because both a source file and file content have been
    -- specified for the same file. You cannot provide both. Either specify a source file or
    -- provide the file content directly.
    record FileContentAndSourceFileSpecifiedException
        -- Any message associated with the exception.
        message: string
    end

    -- The file cannot be added because it is too large. The maximum file size is 6 MB, and
    -- the combined file content change size is 7 MB. Consider making these changes using a Git
    -- client.
    record FileContentSizeLimitExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified file does not exist. Verify that you have used the correct file name,
    -- full path, and extension.
    record FileDoesNotExistException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because no files have been specified as added, updated, or changed (PutFile or DeleteFile) for the commit.
    record FileEntryRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because no file mode has been specified. A file mode is
    -- required to update mode permissions for a file.
    record FileModeRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- A file cannot be added to the repository because the specified file name has the same name as a directory in this repository. Either provide
    -- another name for the file, or add the file in a directory that does not match the file name.
    record FileNameConflictsWithDirectoryNameException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because a specified file path points to a submodule. Verify that the destination files
    -- have valid file paths that do not point to a submodule.
    record FilePathConflictsWithSubmodulePathException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because at least one of the overall changes in the commit results in a
    -- folder whose contents exceed the limit of 6 MB. Either reduce the number and size of your changes,
    -- or split the changes across multiple folders.
    record FolderContentSizeLimitExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified deletion parameter is not valid.
    record InvalidDeletionParameterException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified email address either contains one or more characters that are not allowed, or it exceeds the maximum number of characters
    -- allowed for an email address.
    record InvalidEmailException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified file mode permission is not valid. For a list of valid file mode permissions, see PutFile.
    record InvalidFileModeException
        -- Any message associated with the exception.
        message: string
    end

    -- The parent commit ID is not valid. The commit ID cannot be empty, and must match the head commit ID for the branch of the repository where you
    -- want to add or update a file.
    record InvalidParentCommitIdException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified path is not valid.
    record InvalidPathException
        -- Any message associated with the exception.
        message: string
    end

    -- The number of specified files to change as part of this commit exceeds the maximum number of files
    -- that can be changed in a single commit. Consider using a Git client for these changes.
    record MaximumFileEntriesExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- The user name is not valid because it has exceeded the character limit for author names.
    record NameLengthExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because no changes will be made to the repository as a result of this commit. A commit must contain at least one change.
    record NoChangeException
        -- Any message associated with the exception.
        message: string
    end

    -- The parent commit ID is not valid because it does not exist. The specified parent commit ID does not exist in the specified branch of the repository.
    record ParentCommitDoesNotExistException
        -- Any message associated with the exception.
        message: string
    end

    -- The file could not be added because the provided parent commit ID is not the current tip of the specified branch. To view the full commit ID of the current head
    -- of the branch, use GetBranch.
    record ParentCommitIdOutdatedException
        -- Any message associated with the exception.
        message: string
    end

    -- A parent commit ID is required. To view the full commit ID of a branch in a repository, use GetBranch or a Git command
    -- (for example, git pull or git log).
    record ParentCommitIdRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- The folderPath for a location cannot be null.
    record PathRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because one or more files specified in the commit reference both a file and a folder.
    record PutFileEntryConflictException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because one of the changes specifies copying or moving a .gitkeep file.
    record RestrictedSourceFileException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because one or more changes in this commit duplicate actions in the same file path. For example,
    -- you cannot make the same delete request to the same file in the same file path twice, or make a delete request and a move request to the same
    -- file as part of the same commit.
    record SamePathRequestException
        -- Any message associated with the exception.
        message: string
    end

    -- The commit cannot be created because no source files or file content have been specified for the commit.
    record SourceFileOrContentRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- Returns information about a target for a pull request.
    record Target
        -- The name of the repository that contains the pull request.
        repositoryName: string
        -- The branch of the repository that contains the changes for the pull request. Also known as the source branch.
        sourceReference: string
        -- The branch of the repository where the pull request changes are merged. Also known as
        -- the destination branch.
        destinationReference: string
    end

    record CreatePullRequestInput
        -- The title of the pull request. This title is used to identify the pull request to
        -- other users in the repository.
        title: string
        -- A description of the pull request.
        description: string
        -- The targets for the pull request, including the source of the code to be reviewed (the
        -- source branch) and the destination where the creator of the pull request intends the
        -- code to be merged after the pull request is closed (the destination branch).
        targets: {Target}
        -- A unique, client-generated idempotency token that, when provided in a request, ensures
        -- the request cannot be repeated with a changed parameter. If a request is received with
        -- the same parameters and a token is included, the request returns information about the
        -- initial request that used that token.
        -- The Amazon Web ServicesSDKs prepopulate client request tokens. If you are using an Amazon Web ServicesSDK, an
        -- idempotency token is created for you.
        clientRequestToken: string
    end

    enum PullRequestStatusEnum
        "OPEN"
        "CLOSED"
    end

    -- Returns information about a merge or potential merge between a source reference and a destination reference in a pull request.
    record MergeMetadata
        -- A Boolean value indicating whether the merge has been made.
        isMerged: boolean
        -- The Amazon Resource Name (ARN) of the user who merged the branches.
        mergedBy: string
        -- The commit ID for the merge commit, if any.
        mergeCommitId: string
        -- The merge strategy used in the merge.
        mergeOption: string
    end

    -- Returns information about a pull request target.
    record PullRequestTarget
        -- The name of the repository that contains the pull request source and destination branches.
        repositoryName: string
        -- The branch of the repository that contains the changes for the pull request. Also known as the source branch.
        sourceReference: string
        -- The branch of the repository where the pull request changes are merged. Also known as
        -- the destination branch.
        destinationReference: string
        -- The full commit ID that is the tip of the destination branch. This is the commit where the pull request was or will be merged.
        destinationCommit: string
        -- The full commit ID of the tip of the source branch used to create the pull request. If
        -- the pull request branch is updated by a push while the pull request is open, the commit
        -- ID changes to reflect the new tip of the branch.
        sourceCommit: string
        -- The commit ID of the most recent commit that the source branch and the destination branch have in common.
        mergeBase: string
        -- Returns metadata about the state of the merge, including whether the merge has been made.
        mergeMetadata: MergeMetadata
    end

    -- Returns information about a pull request.
    record PullRequest
        -- The system-generated ID of the pull request.
        pullRequestId: string
        -- The user-defined title of the pull request. This title is displayed in the list of
        -- pull requests to other repository users.
        title: string
        -- The user-defined description of the pull request. This description can be used to clarify what should be reviewed and other details of the request.
        description: string
        -- The day and time of the last user or system activity on the pull request, in timestamp format.
        lastActivityDate: number
        -- The date and time the pull request was originally created, in timestamp format.
        creationDate: number
        -- The status of the pull request. Pull request status can only change from OPEN to CLOSED.
        pullRequestStatus: string
        -- The Amazon Resource Name (ARN) of the user who created the pull request.
        authorArn: string
        -- The targets of the pull request, including the source branch and destination branch for the pull request.
        pullRequestTargets: {PullRequestTarget}
        -- A unique, client-generated idempotency token that, when provided in a request, ensures
        -- the request cannot be repeated with a changed parameter. If a request is received with
        -- the same parameters and a token is included, the request returns information about the
        -- initial request that used that token.
        clientRequestToken: string
        -- The system-generated revision ID for the pull request.
        revisionId: string
        -- The approval rules applied to the pull request.
        approvalRules: {ApprovalRule}
    end

    record CreatePullRequestOutput
        -- Information about the newly created pull request.
        pullRequest: PullRequest
    end

    -- The client request token is not valid. Either the token is not in a valid format, or
    -- the token has been used in a previous request and cannot be reused.
    record IdempotencyParameterMismatchException
        -- Any message associated with the exception.
        message: string
    end

    -- The client request token is not valid.
    record InvalidClientRequestTokenException
        -- Any message associated with the exception.
        message: string
    end

    -- The pull request description is not valid. Descriptions cannot be more than 1,000
    -- characters.
    record InvalidDescriptionException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified reference name format is not valid. Reference names must conform to the
    -- Git references format (for example, refs/heads/main). For more information, see Git Internals -
    -- Git References or consult your Git documentation.
    record InvalidReferenceNameException
        -- Any message associated with the exception.
        message: string
    end

    -- The target for the pull request is not valid. A target must contain the full values for the repository name, source branch, and destination branch for the pull request.
    record InvalidTargetException
        -- Any message associated with the exception.
        message: string
    end

    -- The targets for the pull request is not valid or not in a valid format. Targets are a list of target objects. Each target object must contain the full values for
    -- the repository name, source branch, and destination branch for a pull request.
    record InvalidTargetsException
        -- Any message associated with the exception.
        message: string
    end

    -- The title of the pull request is not valid. Pull request titles cannot exceed 100 characters in length.
    record InvalidTitleException
        -- Any message associated with the exception.
        message: string
    end

    -- You cannot create the pull request because the repository has too many open pull requests.
    -- The maximum number of open pull requests for a repository is 1,000. Close one or more open pull requests, and then try again.
    record MaximumOpenPullRequestsExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- You cannot include more than one repository in a pull request. Make sure you have specified only one repository name in your request, and then try again.
    record MultipleRepositoriesInPullRequestException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified reference does not exist. You must provide a full commit ID.
    record ReferenceDoesNotExistException
        -- Any message associated with the exception.
        message: string
    end

    -- A reference name is required, but none was provided.
    record ReferenceNameRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified reference is not a supported type.
    record ReferenceTypeNotSupportedException
        -- Any message associated with the exception.
        message: string
    end

    -- The source branch and destination branch for the pull request are the same. You must
    -- specify different branches for the source and destination.
    record SourceAndDestinationAreSameException
        -- Any message associated with the exception.
        message: string
    end

    -- A pull request target is required. It cannot be empty or null. A pull request target must contain the full values for the repository name, source branch, and destination branch for the pull request.
    record TargetRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- An array of target objects is required. It cannot be empty or null.
    record TargetsRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- A pull request title is required. It cannot be empty or null.
    record TitleRequiredException
        -- Any message associated with the exception.
        message: string
    end

    record CreatePullRequestApprovalRuleInput
        -- The system-generated ID of the pull request for which you want to create the approval rule.
        pullRequestId: string
        -- The name for the approval rule.
        approvalRuleName: string
        -- The content of the approval rule, including the number of approvals needed and the structure of an approval pool defined for approvals, if any. For more information
        -- about approval pools, see the CodeCommit User Guide.
        -- When you create the content of the approval rule, you can specify approvers in an
        -- approval pool in one of two ways:
        -- CodeCommitApprovers: This option only
        -- requires an Amazon Web Services account and a resource. It can be used for both IAM users
        -- and federated access users whose name matches the provided resource name.
        -- This is a very powerful option that offers a great deal of flexibility. For
        -- example, if you specify the Amazon Web Services account 123456789012
        -- and Mary_Major, all of the following would be counted
        -- as approvals coming from that user:
        -- An IAM user in the account
        -- (arn:aws:iam::123456789012:user/Mary_Major)
        -- A federated user identified in IAM as Mary_Major
        -- (arn:aws:sts::123456789012:federated-user/Mary_Major)
        -- This option does not recognize an active session of someone assuming the
        -- role of CodeCommitReview with a role session name of
        -- Mary_Major
        -- (arn:aws:sts::123456789012:assumed-role/CodeCommitReview/Mary_Major)
        -- unless you include a wildcard (*Mary_Major).
        -- Fully qualified ARN: This option allows
        -- you to specify the fully qualified Amazon Resource Name (ARN) of the IAM
        -- user or role.
        -- For more information about IAM ARNs, wildcards, and formats, see
        -- IAM
        -- Identifiers in the IAM User Guide.
        approvalRuleContent: string
    end

    record CreatePullRequestApprovalRuleOutput
        -- Information about the created approval rule.
        approvalRule: ApprovalRule
    end

    -- The content for the approval rule is not valid.
    record InvalidApprovalRuleContentException
        -- Any message associated with the exception.
        message: string
    end

    -- The name for the approval rule is not valid.
    record InvalidApprovalRuleNameException
        -- Any message associated with the exception.
        message: string
    end

    -- The pull request ID is not valid. Make sure that you have provided the full ID and that the pull request is in the specified repository, and then try again.
    record InvalidPullRequestIdException
        -- Any message associated with the exception.
        message: string
    end

    -- The approval rule cannot be added. The pull request has the maximum number of approval rules associated with it.
    record NumberOfRulesExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- The pull request status cannot be updated because it is already closed.
    record PullRequestAlreadyClosedException
        -- Any message associated with the exception.
        message: string
    end

    -- The pull request ID could not be found. Make sure that you have specified the correct repository name and pull request ID, and then try again.
    record PullRequestDoesNotExistException
        -- Any message associated with the exception.
        message: string
    end

    -- A pull request ID is required, but none was provided.
    record PullRequestIdRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- Represents the input of a create repository operation.
    record CreateRepositoryInput
        -- The name of the new repository to be created.
        -- The repository name must be unique across the calling Amazon Web Services account. Repository names
        -- are limited to 100 alphanumeric, dash, and underscore characters, and cannot include
        -- certain characters. For more information about the limits on repository names, see
        -- Quotas in the CodeCommit User Guide. The
        -- suffix .git is prohibited.
        repositoryName: string
        -- A comment or description about the new repository.
        -- The description field for a repository accepts all HTML characters and all valid
        -- Unicode characters. Applications that do not HTML-encode the description and display
        -- it in a webpage can expose users to potentially malicious code. Make sure that you
        -- HTML-encode the description field in any application that uses this API to display
        -- the repository description on a webpage.
        repositoryDescription: string
        -- One or more tag key-value pairs to use when tagging this repository.
        tags: {string : string}
        -- The ID of the encryption key. You can view the ID of an encryption key in the KMS console, or use the KMS APIs to
        -- programmatically retrieve a key ID. For more information about acceptable values for kmsKeyID, see
        -- KeyId in the Decrypt API description in
        -- the Key Management Service API Reference.
        -- If no key is specified, the default aws/codecommit Amazon Web Services managed key is used.
        kmsKeyId: string
    end

    -- Represents the output of a create repository operation.
    record CreateRepositoryOutput
        -- Information about the newly created repository.
        repositoryMetadata: RepositoryMetadata
    end

    -- The Key Management Service encryption key is not valid.
    record EncryptionKeyInvalidIdException
        -- Any message associated with the exception.
        message: string
    end

    -- A KMS encryption key was used to try and encrypt or decrypt a repository, but either the repository or the key was not
    -- in a valid state to support the operation.
    record EncryptionKeyInvalidUsageException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified repository description is not valid.
    record InvalidRepositoryDescriptionException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified tag is not valid. Key names cannot be prefixed with aws:.
    record InvalidSystemTagUsageException
        -- Any message associated with the exception.
        message: string
    end

    -- The map of tags is not valid.
    record InvalidTagsMapException
        -- Any message associated with the exception.
        message: string
    end

    -- The requested action is not allowed.
    record OperationNotAllowedException
        -- Any message associated with the exception.
        message: string
    end

    -- A repository resource limit was exceeded.
    record RepositoryLimitExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified repository name already exists.
    record RepositoryNameExistsException
        -- Any message associated with the exception.
        message: string
    end

    -- The tag policy is not valid.
    record TagPolicyException
        -- Any message associated with the exception.
        message: string
    end

    -- The maximum number of tags for an CodeCommit resource has been exceeded.
    record TooManyTagsException
        -- Any message associated with the exception.
        message: string
    end

    -- The merge cannot be completed because the target branch has been modified. Another user might have modified the target branch while the merge was in progress. Wait a few minutes, and then try again.
    record ConcurrentReferenceUpdateException
        -- Any message associated with the exception.
        message: string
    end

    enum ReplacementTypeEnum
        "KEEP_BASE"
        "KEEP_SOURCE"
        "KEEP_DESTINATION"
        "USE_NEW_CONTENT"
    end

    -- Information about a replacement content entry in the conflict of a merge or pull request operation.
    record ReplaceContentEntry
        -- The path of the conflicting file.
        filePath: string
        -- The replacement type to use when determining how to resolve the conflict.
        replacementType: string
        -- The base-64 encoded content to use when the replacement type is USE_NEW_CONTENT.
        content: string
        -- The file mode to apply during conflict resoltion.
        fileMode: string
    end

    -- If AUTOMERGE is the conflict resolution strategy, a list of inputs to use when
    -- resolving conflicts during a merge.
    record ConflictResolution
        -- Files to have content replaced as part of the merge conflict resolution.
        replaceContents: {ReplaceContentEntry}
        -- Files to be deleted as part of the merge conflict resolution.
        deleteFiles: {DeleteFileEntry}
        -- File modes that are set as part of the merge conflict resolution.
        setFileModes: {SetFileModeEntry}
    end

    record CreateUnreferencedMergeCommitInput
        -- The name of the repository where you want to create the unreferenced merge commit.
        repositoryName: string
        -- The branch, tag, HEAD, or other fully qualified reference used to identify a commit
        -- (for example, a branch name or a full commit ID).
        sourceCommitSpecifier: string
        -- The branch, tag, HEAD, or other fully qualified reference used to identify a commit
        -- (for example, a branch name or a full commit ID).
        destinationCommitSpecifier: string
        -- The merge option or strategy you want to use to merge the code.
        mergeOption: string
        -- The level of conflict detail to use. If unspecified, the default FILE_LEVEL is used,
        -- which returns a not-mergeable result if the same file has differences in both branches.
        -- If LINE_LEVEL is specified, a conflict is considered not mergeable if the same file in
        -- both branches has differences on the same line.
        conflictDetailLevel: string
        -- Specifies which branch to use when resolving conflicts, or whether to attempt
        -- automatically merging two versions of a file. The default is NONE, which requires any
        -- conflicts to be resolved manually before the merge operation is successful.
        conflictResolutionStrategy: string
        -- The name of the author who created the unreferenced commit. This information is used
        -- as both the author and committer for the commit.
        authorName: string
        -- The email address for the person who created the unreferenced commit.
        email: string
        -- The commit message for the unreferenced commit.
        commitMessage: string
        -- If the commit contains deletions, whether to keep a folder or folder structure if the
        -- changes leave the folders empty. If this is specified as true, a .gitkeep file is
        -- created for empty folders. The default is false.
        keepEmptyFolders: boolean
        -- If AUTOMERGE is the conflict resolution strategy, a list of inputs to use when
        -- resolving conflicts during a merge.
        conflictResolution: ConflictResolution
    end

    record CreateUnreferencedMergeCommitOutput
        -- The full commit ID of the commit that contains your merge results.
        commitId: string
        -- The full SHA-1 pointer of the tree information for the commit that contains the merge results.
        treeId: string
    end

    -- The specified conflict resolution list is not valid.
    record InvalidConflictResolutionException
        -- Any message associated with the exception.
        message: string
    end

    -- Automerge was specified for resolving the conflict, but the replacement type is not valid or content is missing.
    record InvalidReplacementContentException
        -- Any message associated with the exception.
        message: string
    end

    -- Automerge was specified for resolving the conflict, but the specified replacement type is not valid.
    record InvalidReplacementTypeException
        -- Any message associated with the exception.
        message: string
    end

    -- The pull request cannot be merged automatically into the destination branch. You must manually merge the branches and resolve any conflicts.
    record ManualMergeRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- The number of allowed conflict resolution entries was exceeded.
    record MaximumConflictResolutionEntriesExceededException
        -- Any message associated with the exception.
        message: string
    end

    -- More than one conflict resolution entries exists for the conflict. A conflict can have only one conflict resolution entry.
    record MultipleConflictResolutionEntriesException
        -- Any message associated with the exception.
        message: string
    end

    -- USE_NEW_CONTENT was specified, but no replacement content has been provided.
    record ReplacementContentRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- A replacement type is required.
    record ReplacementTypeRequiredException
        -- Any message associated with the exception.
        message: string
    end

    record DeleteApprovalRuleTemplateInput
        -- The name of the approval rule template to delete.
        approvalRuleTemplateName: string
    end

    record DeleteApprovalRuleTemplateOutput
        -- The system-generated ID of the deleted approval rule template. If the template has
        -- been previously deleted, the only response is a 200 OK.
        approvalRuleTemplateId: string
    end

    -- The specified branch is the default branch for the repository, and cannot be deleted. To delete this branch, you must first set another branch as the default branch.
    record DefaultBranchCannotBeDeletedException
        -- Any message associated with the exception.
        message: string
    end

    -- Represents the input of a delete branch operation.
    record DeleteBranchInput
        -- The name of the repository that contains the branch to be deleted.
        repositoryName: string
        -- The name of the branch to delete.
        branchName: string
    end

    -- Represents the output of a delete branch operation.
    record DeleteBranchOutput
        -- Information about the branch deleted by the operation, including the branch name and the commit ID that was the tip of the branch.
        deletedBranch: BranchInfo
    end

    -- This comment has already been deleted. You cannot edit or delete a deleted comment.
    record CommentDeletedException
        -- Any message associated with the exception.
        message: string
    end

    -- No comment exists with the provided ID. Verify that you have used the correct ID, and
    -- then try again.
    record CommentDoesNotExistException
        -- Any message associated with the exception.
        message: string
    end

    -- The comment ID is missing or null. A comment ID is required.
    record CommentIdRequiredException
        -- Any message associated with the exception.
        message: string
    end

    record DeleteCommentContentInput
        -- The unique, system-generated ID of the comment. To get this ID, use GetCommentsForComparedCommit
        -- or GetCommentsForPullRequest.
        commentId: string
    end

    -- Returns information about a specific comment.
    record Comment
        -- The system-generated comment ID.
        commentId: string
        -- The content of the comment.
        content: string
        -- The ID of the comment for which this comment is a reply, if any.
        inReplyTo: string
        -- The date and time the comment was created, in timestamp format.
        creationDate: number
        -- The date and time the comment was most recently modified, in timestamp format.
        lastModifiedDate: number
        -- The Amazon Resource Name (ARN) of the person who posted the comment.
        authorArn: string
        -- A Boolean value indicating whether the comment has been deleted.
        deleted: boolean
        -- A unique, client-generated idempotency token that, when provided in a request, ensures
        -- the request cannot be repeated with a changed parameter. If a request is received with
        -- the same parameters and a token is included, the request returns information about the
        -- initial request that used that token.
        clientRequestToken: string
        -- The emoji reactions to a comment, if any, submitted by the user whose credentials are associated with the call to the API.
        callerReactions: {string}
        -- A string to integer map that represents the number of individual users who have responded to a comment with the specified reactions.
        reactionCounts: {string : number}
    end

    record DeleteCommentContentOutput
        -- Information about the comment you just deleted.
        comment: Comment
    end

    -- The comment ID is not in a valid format. Make sure that you have provided the full comment ID.
    record InvalidCommentIdException
        -- Any message associated with the exception.
        message: string
    end

    record DeleteFileInput
        -- The name of the repository that contains the file to delete.
        repositoryName: string
        -- The name of the branch where the commit that deletes the file is made.
        branchName: string
        -- The fully qualified path to the file that to be deleted, including the full name and
        -- extension of that file. For example, /examples/file.md is a fully qualified path to a
        -- file named file.md in a folder named examples.
        filePath: string
        -- The ID of the commit that is the tip of the branch where you want to create the commit
        -- that deletes the file. This must be the HEAD commit for the branch. The commit that
        -- deletes the file is created from this commit ID.
        parentCommitId: string
        -- If a file is the only object in the folder or directory, specifies whether to delete
        -- the folder or directory that contains the file. By default, empty folders are deleted.
        -- This includes empty folders that are part of the directory structure. For example, if
        -- the path to a file is dir1/dir2/dir3/dir4, and dir2 and dir3 are empty, deleting the
        -- last file in dir4 also deletes the empty folders dir4, dir3, and dir2.
        keepEmptyFolders: boolean
        -- The commit message you want to include as part of deleting the file. Commit messages
        -- are limited to 256 KB. If no message is specified, a default message is used.
        commitMessage: string
        -- The name of the author of the commit that deletes the file. If no name is specified,
        -- the user's ARN is used as the author name and committer name.
        name: string
        -- The email address for the commit that deletes the file. If no email address is
        -- specified, the email address is left blank.
        email: string
    end

    record DeleteFileOutput
        -- The full commit ID of the commit that contains the change that deletes the file.
        commitId: string
        -- The blob ID removed from the tree as part of deleting the file.
        blobId: string
        -- The full SHA-1 pointer of the tree information for the commit that contains the delete file change.
        treeId: string
        -- The fully qualified path to the file to be deleted, including the full name and
        -- extension of that file.
        filePath: string
    end

    record DeletePullRequestApprovalRuleInput
        -- The system-generated ID of the pull request that contains the approval rule you want to delete.
        pullRequestId: string
        -- The name of the approval rule you want to delete.
        approvalRuleName: string
    end

    record DeletePullRequestApprovalRuleOutput
        -- The ID of the deleted approval rule.
        -- If the approval rule was deleted in an earlier API call, the response is 200 OK without
        -- content.
        approvalRuleId: string
    end

    -- Represents the input of a delete repository operation.
    record DeleteRepositoryInput
        -- The name of the repository to delete.
        repositoryName: string
    end

    -- Represents the output of a delete repository operation.
    record DeleteRepositoryOutput
        -- The ID of the repository that was deleted.
        repositoryId: string
    end

    record DescribeMergeConflictsInput
        -- The name of the repository where you want to get information about a merge conflict.
        repositoryName: string
        -- The branch, tag, HEAD, or other fully qualified reference used to identify a commit
        -- (for example, a branch name or a full commit ID).
        destinationCommitSpecifier: string
        -- The branch, tag, HEAD, or other fully qualified reference used to identify a commit
        -- (for example, a branch name or a full commit ID).
        sourceCommitSpecifier: string
        -- The merge option or strategy you want to use to merge the code.
        mergeOption: string
        -- The maximum number of merge hunks to include in the output.
        maxMergeHunks: number
        -- The path of the target files used to describe the conflicts.
        filePath: string
        -- The level of conflict detail to use. If unspecified, the default FILE_LEVEL is used,
        -- which returns a not-mergeable result if the same file has differences in both branches.
        -- If LINE_LEVEL is specified, a conflict is considered not mergeable if the same file in
        -- both branches has differences on the same line.
        conflictDetailLevel: string
        -- Specifies which branch to use when resolving conflicts, or whether to attempt
        -- automatically merging two versions of a file. The default is NONE, which requires any
        -- conflicts to be resolved manually before the merge operation is successful.
        conflictResolutionStrategy: string
        -- An enumeration token that, when provided in a request, returns the next batch of the
        -- results.
        nextToken: string
    end

    record DescribeMergeConflictsOutput
        -- Contains metadata about the conflicts found in the merge.
        conflictMetadata: ConflictMetadata
        -- A list of merge hunks of the differences between the files or lines.
        mergeHunks: {MergeHunk}
        -- An enumeration token that can be used in a request to return the next batch of the results.
        nextToken: string
        -- The commit ID of the destination commit specifier that was used in the merge evaluation.
        destinationCommitId: string
        -- The commit ID of the source commit specifier that was used in the merge evaluation.
        sourceCommitId: string
        -- The commit ID of the merge base.
        baseCommitId: string
    end

    enum PullRequestEventType
        "PULL_REQUEST_CREATED"
        "PULL_REQUEST_STATUS_CHANGED"
        "PULL_REQUEST_SOURCE_REFERENCE_UPDATED"
        "PULL_REQUEST_MERGE_STATE_CHANGED"
        "PULL_REQUEST_APPROVAL_RULE_CREATED"
        "PULL_REQUEST_APPROVAL_RULE_UPDATED"
        "PULL_REQUEST_APPROVAL_RULE_DELETED"
        "PULL_REQUEST_APPROVAL_RULE_OVERRIDDEN"
        "PULL_REQUEST_APPROVAL_STATE_CHANGED"
    end

    record DescribePullRequestEventsInput
        -- The system-generated ID of the pull request. To get this ID, use ListPullRequests.
        pullRequestId: string
        -- Optional. The pull request event type about which you want to return information.
        pullRequestEventType: string
        -- The Amazon Resource Name (ARN) of the user whose actions resulted in the event.
        -- Examples include updating the pull request with more commits or changing the status of a
        -- pull request.
        actorArn: string
        -- An enumeration token that, when provided in a request, returns the next batch of the
        -- results.
        nextToken: string
        -- A non-zero, non-negative integer used to limit the number of returned results.
        -- The default is 100 events, which is also the maximum number of events that can be returned in a result.
        maxResults: number
    end

    -- Metadata about the pull request that is used when comparing the pull request source with its destination.
    record PullRequestCreatedEventMetadata
        -- The name of the repository where the pull request was created.
        repositoryName: string
        -- The commit ID on the source branch used when the pull request was created.
        sourceCommitId: string
        -- The commit ID of the tip of the branch specified as the destination branch when the pull request was created.
        destinationCommitId: string
        -- The commit ID of the most recent commit that the source branch and the destination branch have in common.
        mergeBase: string
    end

    -- Returns information about the change in the merge state for a pull request event.
    record PullRequestMergedStateChangedEventMetadata
        -- The name of the repository where the pull request was created.
        repositoryName: string
        -- The name of the branch that the pull request is merged into.
        destinationReference: string
        -- Information about the merge state change event.
        mergeMetadata: MergeMetadata
    end

    -- Information about an update to the source branch of a pull request.
    record PullRequestSourceReferenceUpdatedEventMetadata
        -- The name of the repository where the pull request was updated.
        repositoryName: string
        -- The full commit ID of the commit in the destination branch that was the tip of the branch at the time the pull request was updated.
        beforeCommitId: string
        -- The full commit ID of the commit in the source branch that was the tip of the branch at the time the pull request was updated.
        afterCommitId: string
        -- The commit ID of the most recent commit that the source branch and the destination branch have in common.
        mergeBase: string
    end

    -- Information about a change to the status of a pull request.
    record PullRequestStatusChangedEventMetadata
        -- The changed status of the pull request.
        pullRequestStatus: string
    end

    -- Returns information about a pull request event.
    record PullRequestEvent
        -- The system-generated ID of the pull request.
        pullRequestId: string
        -- The day and time of the pull request event, in timestamp format.
        eventDate: number
        -- The type of the pull request event (for example, a status change event
        -- (PULL_REQUEST_STATUS_CHANGED) or update event
        -- (PULL_REQUEST_SOURCE_REFERENCE_UPDATED)).
        pullRequestEventType: string
        -- The Amazon Resource Name (ARN) of the user whose actions resulted in the event.
        -- Examples include updating the pull request with more commits or changing the status of a
        -- pull request.
        actorArn: string
        -- Information about the source and destination branches for the pull request.
        pullRequestCreatedEventMetadata: PullRequestCreatedEventMetadata
        -- Information about the change in status for the pull request event.
        pullRequestStatusChangedEventMetadata: PullRequestStatusChangedEventMetadata
        -- Information about the updated source branch for the pull request event.
        pullRequestSourceReferenceUpdatedEventMetadata: PullRequestSourceReferenceUpdatedEventMetadata
        -- Information about the change in mergability state for the pull request event.
        pullRequestMergedStateChangedEventMetadata: PullRequestMergedStateChangedEventMetadata
        -- Information about a pull request event.
        approvalRuleEventMetadata: ApprovalRuleEventMetadata
        -- Information about an approval state change for a pull request.
        approvalStateChangedEventMetadata: ApprovalStateChangedEventMetadata
        -- Information about an approval rule override event for a pull request.
        approvalRuleOverriddenEventMetadata: ApprovalRuleOverriddenEventMetadata
    end

    record DescribePullRequestEventsOutput
        -- Information about the pull request events.
        pullRequestEvents: {PullRequestEvent}
        -- An enumeration token that can be used in a request to return the next batch of the results.
        nextToken: string
    end

    -- The Amazon Resource Name (ARN) is not valid. Make sure that you have provided the full ARN for the user who initiated the change for the pull request,
    -- and then try again.
    record InvalidActorArnException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified number of maximum results is not valid.
    record InvalidMaxResultsException
        -- Any message associated with the exception.
        message: string
    end

    -- The pull request event type is not valid.
    record InvalidPullRequestEventTypeException
        -- Any message associated with the exception.
        message: string
    end

    record DisassociateApprovalRuleTemplateFromRepositoryInput
        -- The name of the approval rule template to disassociate from a specified repository.
        approvalRuleTemplateName: string
        -- The name of the repository you want to disassociate from the template.
        repositoryName: string
    end

    record DisassociateApprovalRuleTemplateFromRepositoryOutput
    end

    record EvaluatePullRequestApprovalRulesInput
        -- The system-generated ID of the pull request you want to evaluate.
        pullRequestId: string
        -- The system-generated ID for the pull request revision. To retrieve the most recent
        -- revision ID for a pull request, use
        -- GetPullRequest.
        revisionId: string
    end

    -- Returns information about the approval rules applied to a pull request and whether conditions have been met.
    record Evaluation
        -- Whether the state of the pull request is approved.
        approved: boolean
        -- Whether the approval rule requirements for the pull request have been overridden and no longer need to be met.
        overridden: boolean
        -- The names of the approval rules that have had their conditions met.
        approvalRulesSatisfied: {string}
        -- The names of the approval rules that have not had their conditions met.
        approvalRulesNotSatisfied: {string}
    end

    record EvaluatePullRequestApprovalRulesOutput
        -- The result of the evaluation, including the names of the rules whose conditions have been met (if any), the names of the rules whose conditions have
        -- not been met (if any), whether the pull request is in the approved state, and whether the pull request approval rule has been set aside by an override.
        evaluation: Evaluation
    end

    -- The revision ID is not valid. Use GetPullRequest to determine the value.
    record InvalidRevisionIdException
        -- Any message associated with the exception.
        message: string
    end

    -- A revision ID is required, but was not provided.
    record RevisionIdRequiredException
        -- Any message associated with the exception.
        message: string
    end

    -- The revision ID provided in the request does not match the current revision ID. Use GetPullRequest to retrieve the current revision ID.
    record RevisionNotCurrentException
        -- Any message associated with the exception.
        message: string
    end

    record GetApprovalRuleTemplateInput
        -- The name of the approval rule template for which you want to get information.
        approvalRuleTemplateName: string
    end

    record GetApprovalRuleTemplateOutput
        -- The content and structure of the approval rule template.
        approvalRuleTemplate: ApprovalRuleTemplate
    end

    -- The specified file exceeds the file size limit for CodeCommit. For more information about limits in CodeCommit, see
    -- Quotas in the CodeCommit User Guide.
    record FileTooLargeException
        -- Any message associated with the exception.
        message: string
    end

    -- Represents the input of a get blob operation.
    record GetBlobInput
        -- The name of the repository that contains the blob.
        repositoryName: string
        -- The ID of the blob, which is its SHA-1 pointer.
        blobId: string
    end

    -- Represents the output of a get blob operation.
    record GetBlobOutput
        -- The content of the blob, usually a file.
        content: string
    end

    -- The specified blob is not valid.
    record InvalidBlobIdException
        -- Any message associated with the exception.
        message: string
    end

    -- Represents the input of a get branch operation.
    record GetBranchInput
        -- The name of the repository that contains the branch for which you want to retrieve information.
        repositoryName: string
        -- The name of the branch for which you want to retrieve information.
        branchName: string
    end

    -- Represents the output of a get branch operation.
    record GetBranchOutput
        -- The name of the branch.
        branch: BranchInfo
    end

    record GetCommentInput
        -- The unique, system-generated ID of the comment. To get this ID, use GetCommentsForComparedCommit
        -- or GetCommentsForPullRequest.
        commentId: string
    end

    record GetCommentOutput
        -- The contents of the comment.
        comment: Comment
    end

    record GetCommentReactionsInput
        -- The ID of the comment for which you want to get reactions information.
        commentId: string
        -- Optional. The Amazon Resource Name (ARN) of the user or identity for which you want to get reaction information.
        reactionUserArn: string
        -- An enumeration token that, when provided in a request, returns the next batch of the results.
        nextToken: string
        -- A non-zero, non-negative integer used to limit the number of returned results. The default is the same as the allowed maximum, 1,000.
        maxResults: number
    end

    -- Information about the values for reactions to a comment. CodeCommit supports a limited set of reactions.
    record ReactionValueFormats
        -- The Emoji Version 1.0 graphic of the reaction. These graphics are interpreted slightly differently on different operating systems.
        emoji: string
        -- The emoji short code for the reaction. Short codes are interpreted slightly differently on different operating systems.
        shortCode: string
        -- The Unicode codepoint for the reaction.
        unicode: string
    end

    -- Information about the reaction values provided by users on a comment.
    record ReactionForComment
        -- The reaction for a specified comment.
        reaction: ReactionValueFormats
        -- The Amazon Resource Names (ARNs) of users who have provided reactions to the comment.
        reactionUsers: {string}
        -- A numerical count of users who reacted with the specified emoji whose identities have been subsequently deleted
        -- from IAM. While these IAM users or roles no longer exist, the reactions might still appear in total reaction counts.
        reactionsFromDeletedUsersCount: number
    end

    record GetCommentReactionsOutput
        -- An array of reactions to the specified comment.
        reactionsForComment: {ReactionForComment}
        -- An enumeration token that can be used in a request to return the next batch of the results.
        nextToken: string
    end

    -- The Amazon Resource Name (ARN) of the user or identity is not valid.
    record InvalidReactionUserArnException
        -- Any message associated with the exception.
        message: string
    end

    record GetCommentsForComparedCommitInput
        -- The name of the repository where you want to compare commits.
        repositoryName: string
        -- To establish the directionality of the comparison, the full commit ID of the before
        -- commit.
        beforeCommitId: string
        -- To establish the directionality of the comparison, the full commit ID of the after
        -- commit.
        afterCommitId: string
        -- An enumeration token that when provided in a request, returns the next batch of the results.
        nextToken: string
        -- A non-zero, non-negative integer used to limit the number of returned results. The
        -- default is 100 comments, but you can configure up to 500.
        maxResults: number
    end

    enum RelativeFileVersionEnum
        "BEFORE"
        "AFTER"
    end

    -- Returns information about the location of a change or comment in the comparison between two commits or a pull request.
    record Location
        -- The name of the file being compared, including its extension and subdirectory, if any.
        filePath: string
        -- The position of a change in a compared file, in line number format.
        filePosition: number
        -- In a comparison of commits or a pull request, whether the change is in the before or
        -- after of that comparison.
        relativeFileVersion: string
    end

    -- Returns information about comments on the comparison between two commits.
    record CommentsForComparedCommit
        -- The name of the repository that contains the compared commits.
        repositoryName: string
        -- The full commit ID of the commit used to establish the before of the
        -- comparison.
        beforeCommitId: string
        -- The full commit ID of the commit used to establish the after of the comparison.
        afterCommitId: string
        -- The full blob ID of the commit used to establish the before of the comparison.
        beforeBlobId: string
        -- The full blob ID of the commit used to establish the after of the comparison.
        afterBlobId: string
        -- Location information about the comment on the comparison, including the file name,
        -- line number, and whether the version of the file where the comment was made is BEFORE or
        -- AFTER.
        location: Location
        -- An array of comment objects. Each comment object contains information about a comment on the comparison
        -- between commits.
        comments: {Comment}
    end

    record GetCommentsForComparedCommitOutput
        -- A list of comment objects on the compared commit.
        commentsForComparedCommitData: {CommentsForComparedCommit}
        -- An enumeration token that can be used in a request to return the next batch of the results.
        nextToken: string
    end

    record GetCommentsForPullRequestInput
        -- The system-generated ID of the pull request. To get this ID, use ListPullRequests.
        pullRequestId: string
        -- The name of the repository that contains the pull request. Requirement is conditional: repositoryName must be specified when
        -- beforeCommitId and afterCommitId are included.
        repositoryName: string
        -- The full commit ID of the commit in the destination branch that was the tip of the branch at the time the pull request was created. Requirement is conditional:
        -- beforeCommitId must be specified when repositoryName is included.
        beforeCommitId: string
        -- The full commit ID of the commit in the source branch that was the tip of the branch at the time the comment was made. Requirement is conditional:
        -- afterCommitId must be specified when repositoryName is included.
        afterCommitId: string
        -- An enumeration token that, when provided in a request, returns the next batch of the
        -- results.
        nextToken: string
        -- A non-zero, non-negative integer used to limit the number of returned results. The default is 100 comments.
        -- You can return up to 500 comments with a single request.
        maxResults: number
    end

    -- Returns information about comments on a pull request.
    record CommentsForPullRequest
        -- The system-generated ID of the pull request.
        pullRequestId: string
        -- The name of the repository that contains the pull request.
        repositoryName: string
        -- The full commit ID of the commit that was the tip of the destination branch when the
        -- pull request was created. This commit is superceded by the after commit in the source
        -- branch when and if you merge the source branch into the destination branch.
        beforeCommitId: string
        -- The full commit ID of the commit that was the tip of the source branch at the time the
        -- comment was made.
        afterCommitId: string
        -- The full blob ID of the file on which you want to comment on the destination commit.
        beforeBlobId: string
        -- The full blob ID of the file on which you want to comment on the source commit.
        afterBlobId: string
        -- Location information about the comment on the pull request, including the file name,
        -- line number, and whether the version of the file where the comment was made is BEFORE
        -- (destination branch) or AFTER (source branch).
        location: Location
        -- An array of comment objects. Each comment object contains information about a comment on the pull request.
        comments: {Comment}
    end

    record GetCommentsForPullRequestOutput
        -- An array of comment objects on the pull request.
        commentsForPullRequestData: {CommentsForPullRequest}
        -- An enumeration token that can be used in a request to return the next batch of the results.
        nextToken: string
    end

    -- The repository does not contain any pull requests with that pull request ID. Use GetPullRequest to verify the correct repository name for the pull request ID.
    record RepositoryNotAssociatedWithPullRequestException
        -- Any message associated with the exception.
        message: string
    end

    -- The specified commit ID does not exist.
    record CommitIdDoesNotExistException
        -- Any message associated with the exception.
        message: string
    end

    -- Represents the input of a get commit operation.
    record GetCommitInput
        -- The name of the repository to which the commit was made.
        repositoryName: string
        -- The commit ID. Commit IDs are the full SHA ID of the commit.
        commitId: string
    end

