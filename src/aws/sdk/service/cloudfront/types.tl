        OriginEndpointArn: string
    end

    -- A list of CloudFront VPC origins.
    record VpcOriginList
        -- The marker associated with the VPC origins list.
        Marker: string
        -- The next marker associated with the VPC origins list.
        NextMarker: string
        -- The maximum number of items included in the list.
        MaxItems: number
        -- A flag that indicates whether more VPC origins remain to be listed. If your results were truncated, you can make a follow-up pagination request using the Marker request parameter to retrieve more VPC origins in the list.
        IsTruncated: boolean
        -- The number of VPC origins in the list.
        Quantity: number
        -- The items of the VPC origins list.
        Items: {VpcOriginSummary}
    end

    record ListVpcOriginsOutput
        -- List of VPC origins.
        VpcOriginList: VpcOriginList
    end

    record PublishConnectionFunctionInput
        -- The connection function ID.
        Id: string
        -- The current version (ETag value) of the connection function.
        IfMatch: string
    end

    record PublishConnectionFunctionOutput
        -- The connection function summary.
        ConnectionFunctionSummary: ConnectionFunctionSummary
    end

    record PublishFunctionInput
        -- The name of the function that you are publishing.
        Name: string
        -- The current version (ETag value) of the function that you are publishing, which you can get using DescribeFunction.
        IfMatch: string
    end

    record PublishFunctionOutput
        -- Contains configuration information and metadata about a CloudFront function.
        FunctionSummary: FunctionSummary
    end

    record PutResourcePolicyInput
        -- The Amazon Resource Name (ARN) of the CloudFront resource for which the policy is being created.
        ResourceArn: string
        -- The JSON-formatted resource policy to create.
        PolicyDocument: string
    end

    record PutResourcePolicyOutput
        -- The Amazon Resource Name (ARN) of the CloudFront resource for which the policy was created.
        ResourceArn: string
    end

    -- The request to add tags to a CloudFront resource.
    record TagResourceInput
        -- An ARN of a CloudFront resource.
        Resource: string
        -- A complex type that contains zero or more Tag elements.
        Tags: Tags
    end

    record TagResourceOutput
    end

    record TestConnectionFunctionInput
        -- The connection function ID.
        Id: string
        -- The current version (ETag value) of the connection function.
        IfMatch: string
        -- The connection function stage.
        Stage: string
        -- The connection object.
        ConnectionObject: string
    end

    -- A connection function test result.
    record ConnectionFunctionTestResult
        -- The connection function summary.
        ConnectionFunctionSummary: ConnectionFunctionSummary
        -- The connection function compute utilization.
        ComputeUtilization: string
        -- The connection function execution logs.
        ConnectionFunctionExecutionLogs: {string}
        -- The connection function error message.
        ConnectionFunctionErrorMessage: string
        -- The connection function output.
        ConnectionFunctionOutput: string
    end

    record TestConnectionFunctionOutput
        -- The connection function test result.
        ConnectionFunctionTestResult: ConnectionFunctionTestResult
    end

    -- The CloudFront function failed.
    record TestFunctionFailed
        Message: string
    end

    record TestFunctionInput
        -- The name of the function that you are testing.
        Name: string
        -- The current version (ETag value) of the function that you are testing, which you can get using DescribeFunction.
        IfMatch: string
        -- The stage of the function that you are testing, either DEVELOPMENT or LIVE.
        Stage: string
        -- The event object to test the function with. For more information about the structure of the event object, see Testing functions in the Amazon CloudFront Developer Guide.
        EventObject: string
    end

    -- Contains the result of testing a CloudFront function with TestFunction.
    record TestResult
        -- Contains configuration information and metadata about the CloudFront function that was tested.
        FunctionSummary: FunctionSummary
        -- The amount of time that the function took to run as a percentage of the maximum allowed time. For example, a compute utilization of 35 means that the function completed in 35% of the maximum allowed time.
        ComputeUtilization: string
        -- Contains the log lines that the function wrote (if any) when running the test.
        FunctionExecutionLogs: {string}
        -- If the result of testing the function was an error, this field contains the error message.
        FunctionErrorMessage: string
        -- The event object returned by the function. For more information about the structure of the event object, see Event object structure in the Amazon CloudFront Developer Guide.
        FunctionOutput: string
    end

    record TestFunctionOutput
        -- An object that represents the result of running the function with the provided event object.
        TestResult: TestResult
    end

    -- A complex type that contains zero or more Tag elements.
    record TagKeys
        -- A complex type that contains Tag key elements.
        Items: {string}
    end

    -- The request to remove tags from a CloudFront resource.
    record UntagResourceInput
        -- An ARN of a CloudFront resource.
        Resource: string
        -- A complex type that contains zero or more Tag key elements.
        TagKeys: TagKeys
    end

    record UntagResourceOutput
    end

    record UpdateAnycastIpListInput
        -- The ID of the Anycast static IP list.
        Id: string
        -- The IP address type for the Anycast static IP list. You can specify one of the following options: ipv4 only ipv6 only dualstack - Allocate a list of both IPv4 and IPv6 addresses
        IpAddressType: string
        -- A list of IPAM CIDR configurations that specify the IP address ranges and IPAM pool settings for updating the Anycast static IP list.
        IpamCidrConfigs: {IpamCidrConfig}
        -- The current version (ETag value) of the Anycast static IP list that you are updating.
        IfMatch: string
    end

    record UpdateAnycastIpListOutput
        AnycastIpList: AnycastIpList
        -- The current version of the Anycast static IP list.
        ETag: string
    end

