    record UpdateVpcOriginInput
        -- The VPC origin endpoint configuration.
        VpcOriginEndpointConfig: VpcOriginEndpointConfig
        -- The VPC origin ID.
        Id: string
        -- The VPC origin to update, if a match occurs.
