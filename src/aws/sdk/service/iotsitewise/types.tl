    record ColumnInformation
        -- The name of the column.
        name: string
    end

    -- Contains the response for the GetQueryResults operation.
    record GetQueryResultsOutput
        -- A list of column metadata for the query results. Each entry contains the column name and data type. Present when the query status is COMPLETED.
        columnInfo: {ColumnInformation}
        -- The result rows. Each row is a list of string column values, positional to match the columnInfo order. Present when the query status is COMPLETED.
        rows: {{string}}
        -- The token for the next set of results, or null if there are no additional results.
        nextToken: string
    end

    -- Input for the GetSearchResults operation.
    record GetSearchResultsInput
        -- The identifier of the search whose results are retrieved.
        searchId: string
        -- The name of the workspace the search belongs to.
        workspaceName: string
        -- The maximum number of results to return in a single page. Valid range is 1 to 10,000; if
        -- omitted, a service-defined default is used.
        maxResults: number
        -- The pagination token returned by a previous GetSearchResults call. Provide it to retrieve the
        -- next page of results; omit it to retrieve the first page.
        nextToken: string
    end

    -- A single matching segment of time-series data returned by a search.
    record SearchResult
        -- The identifier of the search that produced this result.
        searchId: string
        -- The name of the workspace the search ran against.
        workspaceName: string
        -- The identifier of the dataset that contains the matching data.
        datasetId: string
        -- The identifier of the time series that contains the matching data.
        timeSeriesId: string
        -- The start of the matching time-series segment, in nanoseconds since the Unix epoch.
        startTimestamp: TimeInNanos
        -- The end of the matching time-series segment, in nanoseconds since the Unix epoch.
        endTimestamp: TimeInNanos
        -- The timestamp of the most relevant point within the matching segment, in nanoseconds since the
        -- Unix epoch.
        topTimestamp: TimeInNanos
        -- The relevance score of this result. Higher scores indicate a stronger match.
        score: number
    end

    -- Output of the GetSearchResults operation.
    record GetSearchResultsOutput
        -- A page of search results, ordered by descending relevance score.
        searchResults: {SearchResult}
        -- The pagination token to use in a subsequent GetSearchResults call to retrieve the next page.
        -- Absent when there are no more results.
        nextToken: string
    end

    record InvokeAssistantInput
        -- The ID assigned to a conversation. IoT SiteWise automatically generates a unique ID for you, and this parameter is never required.
        -- However, if you prefer to have your own ID, you must specify it here in UUID format. If you specify your own ID, it must be globally unique.
        conversationId: string
        -- A text message sent to the SiteWise Assistant by the user.
        message: string
        -- Specifies if to turn trace on or not. It is used to track the SiteWise Assistant's
        -- reasoning, and data access process.
        enableTrace: boolean
    end

    -- Contains the cited text from the data source.
    record Content
        -- The cited text from the data source.
        text: string
    end

    -- Contains location information about the cited text and where it's stored.
    record Location
        -- The URI of the location.
        uri: string
    end

    -- The data source for the dataset.
    record Source
        -- Contains the ARN of the dataset. If the source is Kendra, it's the ARN of the Kendra index.
        arn: string
        -- Contains the location information where the cited text is originally stored.
        -- For example, if the data source is Kendra, and the text synchronized is from an S3 bucket, then the location refers to an S3 object.
        location: Location
    end

    -- Contains information about the dataset use and it's source.
    record DataSetReference
        -- The ARN of the dataset.
        -- The format is arn:${Partition}:iotsitewise:${Region}:${Account}:dataset/${DatasetId}.
        datasetArn: string
        -- The data source for the dataset.
        source: Source
    end

    -- Contains the reference information.
    record Reference
        -- Contains the dataset reference information.
        dataset: DataSetReference
    end

    -- Contains text content to which the SiteWise Assistant refers to, and generate the final response.
    -- It also contains information about the source.
    record Citation
        -- Contains information about the data source.
        reference: Reference
        -- Contains the cited text from the data source.
        content: Content
    end

    -- This contains the SiteWise Assistant's response and the corresponding citation.
    record InvocationOutput
        -- The text message of the SiteWise Assistant's response.
        message: string
        -- A list of citations, and related information for the SiteWise Assistant's response.
        citations: {Citation}
    end

    -- Contains tracing information of the SiteWise Assistant's reasoning and data access.
    record Trace
        -- The cited text from the data source.
        text: string
    end

    -- Contains the response, citation, and trace from the SiteWise Assistant.
    record ResponseStream
        -- Contains tracing information of the SiteWise Assistant's reasoning and data access.
        trace: Trace
        -- Contains the SiteWise Assistant's response.
        output: InvocationOutput
        accessDeniedException: AccessDeniedException
        conflictingOperationException: ConflictingOperationException
        internalFailureException: InternalFailureException
        invalidRequestException: InvalidRequestException
        limitExceededException: LimitExceededException
        resourceNotFoundException: ResourceNotFoundException
        throttlingException: ThrottlingException
    end

    record InvokeAssistantOutput
        body: function(): string, string
        -- The ID of the conversation, in UUID format. This ID uniquely identifies the conversation within IoT SiteWise.
        conversationId: string
    end

