        -- Accepts * to reject the delete request if an active version
        -- (specified using matchForVersionType as ACTIVE) already exists for the asset model.
        ifNoneMatch: string
        -- Specifies the asset model version type (LATEST or ACTIVE) used in
        -- conjunction with If-Match or If-None-Match headers to determine the target ETag for the delete operation.
        matchForVersionType: string
    end

