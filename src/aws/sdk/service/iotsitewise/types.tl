    record DataBindingValueFilter
        -- Filter criteria for matching data bindings based on a specific asset. Used to list all
        -- data bindings referencing a particular asset or its properties.
        asset: AssetBindingValueFilter
        -- Filter criteria for matching data bindings based on a specific asset model. Used to list
        -- all data bindings referencing a particular asset model or its properties.
        assetModel: AssetModelBindingValueFilter
        -- Filter criteria for matching data bindings based on a specific asset property. Used to
        -- list all data bindings referencing a particular property of an asset.
        assetProperty: AssetPropertyBindingValueFilter
        -- Filter criteria for matching data bindings based on a specific asset model property. Used
        -- to list all data bindings referencing a particular property of an asset model.
        assetModelProperty: AssetModelPropertyBindingValueFilter
    end

    record ListComputationModelDataBindingUsagesInput
        -- A filter used to limit the returned data binding usages based on specific data binding
