        -- The ID of the asset. This can be either the actual ID in UUID format, or else externalId: followed by the external ID, if it has one.
        -- For more information, see Referencing objects with external IDs in the IoT SiteWise User Guide.
        assetId: string
        -- The ID of a composite model on this asset. This can be either the actual ID in UUID format, or else externalId: followed by the external ID, if it has one.
        -- For more information, see Referencing objects with external IDs in the IoT SiteWise User Guide.
        assetCompositeModelId: string
    end

