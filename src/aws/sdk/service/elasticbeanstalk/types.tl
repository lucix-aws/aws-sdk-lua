    -- Represents summary information about the health of an instance. For more information,
    -- see Health Colors and Statuses.
    record InstanceHealthSummary
        -- Grey. AWS Elastic Beanstalk and the health agent are
        -- reporting no data on an instance.
        NoData: number
        -- Grey. AWS Elastic Beanstalk and the health agent are
        -- reporting an insufficient amount of data on an instance.
        Unknown: number
        -- Grey. An operation is in progress on an instance within the
        -- command timeout.
        Pending: number
        -- Green. An instance is passing health checks and the health
        -- agent is not reporting any problems.
        Ok: number
        -- Green. An operation is in progress on an instance.
        Info: number
        -- Yellow. The health agent is reporting a moderate number of
        -- request failures or other issues for an instance or environment.
        Warning: number
        -- Red. The health agent is reporting a high number of request
        -- failures or other issues for an instance or environment.
        Degraded: number
        -- Red. The health agent is reporting a very high number of
        -- request failures or other issues for an instance or environment.
        Severe: number
    end

    -- Health details for an AWS Elastic Beanstalk environment.
    record DescribeEnvironmentHealthOutput
        -- The environment's name.
        EnvironmentName: string
        -- The health status of the
        -- environment. For example, Ok.
        HealthStatus: string
        -- The environment's operational status. Ready, Launching,
        -- Updating, Terminating, or Terminated.
        Status: string
        -- The health color of the
        -- environment.
        Color: string
        -- Descriptions of the data that contributed to the environment's current health
        -- status.
        Causes: {string}
        -- Application request metrics for the environment.
        ApplicationMetrics: ApplicationMetrics
        -- Summary health information for the instances in the environment.
        InstancesHealth: InstanceHealthSummary
        -- The date and time that the health information was retrieved.
        RefreshedAt: number
    end

