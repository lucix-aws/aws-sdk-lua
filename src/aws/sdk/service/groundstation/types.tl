        -- GUID of the agent task.
        taskId: string
        -- Presigned URL for uploading agent task response logs.
        presignedLogUrl: string
    end

    -- Input for the GetMinuteUsage operation.
    record GetMinuteUsageInput
        -- The month being requested, with a value of 1-12.
        month: number
        -- The year being requested, in the format of YYYY.
        year: number
    end

    -- Output for the GetMinuteUsage operation.
    record GetMinuteUsageOutput
        -- Returns whether or not an account has signed up for the reserved minutes pricing plan, specific to the month being requested.
        isReservedMinutesCustomer: boolean
        -- Total number of reserved minutes allocated, specific to the month being requested.
        totalReservedMinuteAllocation: number
        -- Upcoming minutes scheduled for an account, specific to the month being requested.
        upcomingMinutesScheduled: number
        -- Total scheduled minutes for an account, specific to the month being requested.
        totalScheduledMinutes: number
        -- Estimated number of minutes remaining for an account, specific to the month being requested.
        estimatedMinutesRemaining: number
    end

    -- Input for the GetMissionProfile operation.
    record GetMissionProfileInput
        -- UUID of a mission profile.
        missionProfileId: string
    end

    -- Output for the GetMissionProfile operation.
    record GetMissionProfileOutput
        -- UUID of a mission profile.
        missionProfileId: string
        -- ARN of a mission profile.
        missionProfileArn: string
        -- Name of a mission profile.
        name: string
        -- Region of a mission profile.
        region: string
        -- Amount of time prior to contact start you'd like to receive a CloudWatch event indicating an upcoming pass.
        contactPrePassDurationSeconds: number
        -- Amount of time after a contact ends that you'd like to receive a CloudWatch event indicating the pass has finished.
        contactPostPassDurationSeconds: number
        -- Smallest amount of time in seconds that you'd like to see for an available contact. AWS Ground Station will not present you with contacts shorter than this duration.
        minimumViableContactDurationSeconds: number
        -- A list of lists of ARNs. Each list of ARNs is an edge, with a from Config and a to Config.
        dataflowEdges: {{string}}
        -- ARN of a tracking Config.
        trackingConfigArn: string
        -- ARN of a telemetry sink Config.
        telemetrySinkConfigArn: string
        -- Tags assigned to a mission profile.
        tags: {string : string}
        -- KMS key to use for encrypting streams.
        streamsKmsKey: KmsKey
        -- Role to use for encrypting streams with KMS key.
        streamsKmsRole: string
    end

    -- Input for the GetSatellite operation.
    record GetSatelliteInput
        -- UUID of a satellite.
        satelliteId: string
    end

    -- Output for the GetSatellite operation.
    record GetSatelliteOutput
        -- UUID of a satellite.
        satelliteId: string
        -- ARN of a satellite.
        satelliteArn: string
        -- NORAD satellite ID number.
        noradSatelliteID: number
        -- A list of ground stations to which the satellite is on-boarded.
        groundStations: {string}
        -- The current ephemeris being used to compute the trajectory of the satellite.
        currentEphemeris: EphemerisMetaData
    end

    record ListAntennasInput
        -- ID of a ground station.
        groundStationId: string
        -- Maximum number of antennas returned.
        maxResults: number
        -- Next token returned in the request of a previous ListAntennas call. Used to get the next page of results.
        nextToken: string
    end

    record ListAntennasOutput
        -- List of antennas.
        antennaList: {AntennaListItem}
        -- Next token to be used in a subsequent ListAntennas call to retrieve the next page of results.
        nextToken: string
    end

    enum ReservationType
        "MAINTENANCE"
        "CONTACT"
    end

    record ListGroundStationReservationsInput
        -- ID of a ground station.
        groundStationId: string
        -- Start time of the reservation window in UTC.
        startTime: number
        -- End time of the reservation window in UTC.
        endTime: number
        -- Types of reservations to filter by.
        reservationTypes: {string}
        -- Maximum number of ground station reservations returned.
        maxResults: number
        -- Next token returned in the request of a previous ListGroundStationReservations call. Used to get the next page of results.
        nextToken: string
    end

    enum MaintenanceType
        "PLANNED"
        "UNPLANNED"
    end

    -- Details of a maintenance reservation.
    record MaintenanceReservationDetails
        -- Type of maintenance.
        maintenanceType: string
    end

    -- Details of a ground station reservation.
    record ReservationDetails
        -- Details of a maintenance reservation.
        maintenance: MaintenanceReservationDetails
        -- Details of a contact reservation.
        contact: ContactReservationDetails
    end

    -- Item in a list of ground station reservations.
    record GroundStationReservationListItem
        -- Type of a ground station reservation.
        reservationType: string
        -- ID of a ground station.
        groundStationId: string
        -- Name of an antenna.
        antennaName: string
        -- Start time of a ground station reservation in UTC.
        startTime: number
        -- End time of a ground station reservation in UTC.
        endTime: number
        -- Details of a ground station reservation.
        reservationDetails: ReservationDetails
    end

    record ListGroundStationReservationsOutput
        -- List of ground station reservations.
        reservationList: {GroundStationReservationListItem}
        -- Next token to be used in a subsequent ListGroundStationReservations call to retrieve the next page of results.
        nextToken: string
    end

    -- Input for the ListGroundStations operation.
    record ListGroundStationsInput
        -- Satellite ID to retrieve on-boarded ground stations.
        satelliteId: string
        -- Maximum number of ground stations returned.
        maxResults: number
        -- Next token that can be supplied in the next call to get the next page of ground stations.
        nextToken: string
    end

    -- Information about the ground station data.
    record GroundStationData
        -- ID of a ground station.
        groundStationId: string
        -- Name of a ground station.
        groundStationName: string
        -- Ground station Region.
        region: string
    end

    -- Output for the ListGroundStations operation.
    record ListGroundStationsOutput
        -- Next token that can be supplied in the next call to get the next page of ground stations.
        nextToken: string
        -- List of ground stations.
        groundStationList: {GroundStationData}
    end

    -- Input for the ListTagsForResource operation.
    record ListTagsForResourceInput
        -- ARN of a resource.
        resourceArn: string
    end

    -- Output for the ListTagsForResource operation.
    record ListTagsForResourceOutput
        -- Tags assigned to a resource.
        tags: {string : string}
    end

    -- Input for the ListMissionProfiles operation.
    record ListMissionProfilesInput
        -- Maximum number of mission profiles returned.
        maxResults: number
        -- Next token returned in the request of a previous ListMissionProfiles call. Used to get the next page of results.
        nextToken: string
    end

    -- Item in a list of mission profiles.
    record MissionProfileListItem
        -- UUID of a mission profile.
        missionProfileId: string
        -- ARN of a mission profile.
        missionProfileArn: string
        -- Region of a mission profile.
        region: string
        -- Name of a mission profile.
        name: string
    end

    -- Output for the ListMissionProfiles operation.
    record ListMissionProfilesOutput
        -- Next token returned in the response of a previous ListMissionProfiles call. Used to get the next page of results.
        nextToken: string
        -- List of mission profiles.
        missionProfileList: {MissionProfileListItem}
    end

    -- Input for the UpdateMissionProfile operation.
    record UpdateMissionProfileInput
        -- UUID of a mission profile.
        missionProfileId: string
        -- Name of a mission profile.
        name: string
        -- Amount of time after a contact ends that you'd like to receive a Ground Station Contact State Change event indicating the pass has finished.
        contactPrePassDurationSeconds: number
        -- Amount of time after a contact ends that you'd like to receive a Ground Station Contact State Change event indicating the pass has finished.
        contactPostPassDurationSeconds: number
        -- Smallest amount of time in seconds that you'd like to see for an available contact. AWS Ground Station will not present you with contacts shorter than this duration.
        minimumViableContactDurationSeconds: number
        -- A list of lists of ARNs. Each list of ARNs is an edge, with a from Config and a to Config.
        dataflowEdges: {{string}}
        -- ARN of a tracking Config.
        trackingConfigArn: string
        -- ARN of a telemetry sink Config.
        telemetrySinkConfigArn: string
        -- KMS key to use for encrypting streams.
        streamsKmsKey: KmsKey
        -- Role to use for encrypting streams with KMS key.
        streamsKmsRole: string
    end

    -- Response containing the ID of a mission profile.
    record UpdateMissionProfileOutput
        -- UUID of a mission profile.
        missionProfileId: string
    end

    -- Input for the ListSatellites operation.
    record ListSatellitesInput
        -- Maximum number of satellites returned.
        maxResults: number
        -- Next token that can be supplied in the next call to get the next page of satellites.
        nextToken: string
    end

    -- Item in a list of satellites.
    record SatelliteListItem
        -- UUID of a satellite.
        satelliteId: string
        -- ARN of a satellite.
        satelliteArn: string
        -- NORAD satellite ID number.
        noradSatelliteID: number
        -- A list of ground stations to which the satellite is on-boarded.
        groundStations: {string}
        -- The current ephemeris being used to compute the trajectory of the satellite.
        currentEphemeris: EphemerisMetaData
    end

    -- Output for the ListSatellites operation.
    record ListSatellitesOutput
        -- Next token that can be supplied in the next call to get the next page of satellites.
        nextToken: string
        -- List of satellites.
        satellites: {SatelliteListItem}
    end

    -- Input for the TagResource operation.
    record TagResourceInput
        -- ARN of a resource tag.
        resourceArn: string
        -- Tags assigned to a resource.
        tags: {string : string}
    end

    -- Output for the TagResource operation.
    record TagResourceOutput
    end

    -- Input for the UntagResource operation.
    record UntagResourceInput
        -- ARN of a resource.
        resourceArn: string
        -- Keys of a resource tag.
        tagKeys: {string}
    end

    -- Output for the UntagResource operation.
    record UntagResourceOutput
    end

end

return M
