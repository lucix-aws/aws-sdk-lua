    record UpdateServiceSyncConfigOutput
        -- The detailed data of the Proton Ops file.
        serviceSyncConfig: ServiceSyncConfig
    end

    record CreateServiceTemplateInput
        -- The name of the service template.
        name: string
        -- The name of the service template as displayed in the developer interface.
        displayName: string
        -- A description of the service template.
        description: string
        -- A customer provided encryption key that's used to encrypt data.
        encryptionKey: string
        -- By default, Proton provides a service pipeline for your service. When this parameter is
        -- included, it indicates that an Proton service pipeline isn't provided
        -- for your service. After it's included, it can't be changed. For more
        -- information, see Template
        -- bundles in the Proton User Guide.
        pipelineProvisioning: string
        -- An optional list of metadata items that you can associate with the Proton service template.
        -- A tag is a key-value pair.
        -- For more information, see Proton resources and tagging in the
        -- Proton User Guide.
        tags: {Tag}
    end

    -- Detailed data of an Proton service template resource.
    record ServiceTemplate
        -- The name of the service template.
        name: string
        -- The Amazon Resource Name (ARN) of the service template.
        arn: string
        -- The time when the service template was created.
        createdAt: number
        -- The time when the service template was last modified.
        lastModifiedAt: number
        -- The service template name as displayed in the developer interface.
        displayName: string
        -- A description of the service template.
        description: string
        -- The recommended version of the service template.
        recommendedVersion: string
        -- The customer provided service template encryption key that's used to encrypt data.
        encryptionKey: string
        -- If pipelineProvisioning is true, a service pipeline is included
        -- in the service template. Otherwise, a service pipeline isn't included in
        -- the service template.
        pipelineProvisioning: string
    end

    record CreateServiceTemplateOutput
        -- The service template detail data that's returned by Proton.
        serviceTemplate: ServiceTemplate
    end

    record DeleteServiceTemplateInput
        -- The name of the service template to delete.
        name: string
    end

    record DeleteServiceTemplateOutput
        -- The detailed data of the service template being deleted.
        serviceTemplate: ServiceTemplate
    end

    record GetServiceTemplateInput
        -- The name of the service template that you want to get detailed data for.
        name: string
    end

    record GetServiceTemplateOutput
        -- The detailed data of the requested service template.
        serviceTemplate: ServiceTemplate
    end

    record ListServiceTemplatesInput
        -- A token that indicates the location of the next service template in the array of service
        -- templates, after the list of service templates previously requested.
        nextToken: string
        -- The maximum number of service templates to list.
        maxResults: number
    end

    -- Summary data of an Proton service template resource.
    record ServiceTemplateSummary
        -- The name of the service template.
        name: string
        -- The Amazon Resource Name (ARN) of the service template.
        arn: string
        -- The time when the service template was created.
        createdAt: number
        -- The time when the service template was last modified.
        lastModifiedAt: number
        -- The service template name as displayed in the developer interface.
        displayName: string
        -- A description of the service template.
        description: string
        -- The recommended version of the service template.
        recommendedVersion: string
        -- If pipelineProvisioning is true, a service pipeline is included
        -- in the service template, otherwise a service pipeline isn't included in
        -- the service template.
        pipelineProvisioning: string
    end

    record ListServiceTemplatesOutput
        -- A token that indicates the location of the next service template in the array of service
        -- templates, after the current requested list of service templates.
        nextToken: string
        -- An array of service templates with detail data.
        templates: {ServiceTemplateSummary}
    end

    record UpdateServiceTemplateInput
        -- The name of the service template to update.
        name: string
        -- The name of the service template to update that's displayed in the developer
        -- interface.
        displayName: string
        -- A description of the service template update.
        description: string
    end

    record UpdateServiceTemplateOutput
        -- The service template detail data that's returned by Proton.
        serviceTemplate: ServiceTemplate
    end

    -- Compatible environment template data.
    record CompatibleEnvironmentTemplateInput
        -- The compatible environment template name.
        templateName: string
        -- The major version of the compatible environment template.
        majorVersion: string
    end

    enum ServiceTemplateSupportedComponentSourceType
        "DIRECTLY_DEFINED"
    end

    record CreateServiceTemplateVersionInput
        -- When included, if two identical requests are made with the same client token, Proton
        -- returns the service template version that the first request created.
        clientToken: string
        -- The name of the service template.
        templateName: string
        -- A description of the new version of a service template.
        description: string
        -- To create a new minor version of the service template, include a major
        -- Version.
        -- To create a new major and minor version of the service template,
        -- exclude
        -- major Version.
        majorVersion: string
        -- An object that includes the template bundle S3 bucket path and name for the new version of
        -- a service template.
        source: TemplateVersionSourceInput
        -- An array of environment template objects that are compatible with the new service template
        -- version. A service instance based on this service template version can run in environments
        -- based on compatible templates.
        compatibleEnvironmentTemplates: {CompatibleEnvironmentTemplateInput}
        -- An optional list of metadata items that you can associate with the Proton service template
        -- version. A tag is a key-value pair.
        -- For more information, see Proton resources and tagging in the
        -- Proton User Guide.
        tags: {Tag}
        -- An array of supported component sources. Components with supported sources can be attached
        -- to service instances based on this service template version.
        -- For more information about components, see
        -- Proton components in the
        -- Proton User Guide.
        supportedComponentSources: {string}
    end

    -- Compatible environment template data.
    record CompatibleEnvironmentTemplate
        -- The compatible environment template name.
        templateName: string
        -- The major version of the compatible environment template.
        majorVersion: string
    end

    -- Detailed data of an Proton service template version resource.
    record ServiceTemplateVersion
        -- The name of the version of a service template.
        templateName: string
        -- The latest major version that's associated with the version of a service template.
        majorVersion: string
        -- The minor version of a service template.
        minorVersion: string
        -- The recommended minor version of the service template.
        recommendedMinorVersion: string
        -- The service template version status.
        status: string
        -- A service template version status message.
        statusMessage: string
        -- A description of the version of a service template.
        description: string
        -- The Amazon Resource Name (ARN) of the version of a service template.
        arn: string
        -- The time when the version of a service template was created.
        createdAt: number
        -- The time when the version of a service template was last modified.
        lastModifiedAt: number
        -- An array of compatible environment template names for the major version of a service
        -- template.
        compatibleEnvironmentTemplates: {CompatibleEnvironmentTemplate}
        -- The schema of the version of a service template.
        schema: string
        -- An array of supported component sources. Components with supported sources can be attached
        -- to service instances based on this service template version.
        -- For more information about components, see
        -- Proton components in the
        -- Proton User Guide.
        supportedComponentSources: {string}
    end

    record CreateServiceTemplateVersionOutput
        -- The service template version summary of detail data that's returned by Proton.
        serviceTemplateVersion: ServiceTemplateVersion
    end

    record DeleteServiceTemplateVersionInput
        -- The name of the service template.
        templateName: string
        -- The service template major version to delete.
        majorVersion: string
        -- The service template minor version to delete.
        minorVersion: string
    end

    record DeleteServiceTemplateVersionOutput
        -- The detailed data of the service template version being deleted.
        serviceTemplateVersion: ServiceTemplateVersion
    end

    record GetServiceTemplateVersionInput
        -- The name of the service template a version of which you want to get detailed data
        -- for.
        templateName: string
        -- To get service template major version detail data, include major
        -- Version.
        majorVersion: string
        -- To get service template minor version detail data, include
        -- minorVersion.
        minorVersion: string
    end

    record GetServiceTemplateVersionOutput
        -- The detailed data of the requested service template version.
        serviceTemplateVersion: ServiceTemplateVersion
    end

    record ListServiceTemplateVersionsInput
        -- A token that indicates the location of the next major or minor version in the array of
        -- major or minor versions of a service template, after the list of major or minor versions that
        -- was previously requested.
        nextToken: string
        -- The maximum number of major or minor versions of a service template to list.
        maxResults: number
        -- The name of the service template.
        templateName: string
        -- To view a list of minor of versions under a major version of a service template, include
        -- major Version.
        -- To view a list of major versions of a service template, exclude
        -- major Version.
        majorVersion: string
    end

    -- Summary data of an Proton service template version resource.
    record ServiceTemplateVersionSummary
        -- The name of the service template.
        templateName: string
        -- The latest major version that's associated with the version of a service template.
        majorVersion: string
        -- The minor version of a service template.
        minorVersion: string
        -- The recommended minor version of the service template.
        recommendedMinorVersion: string
        -- The service template minor version status.
        status: string
        -- A service template minor version status message.
        statusMessage: string
        -- A description of the version of a service template.
        description: string
        -- The Amazon Resource Name (ARN) of the version of a service template.
        arn: string
        -- The time when the version of a service template was created.
        createdAt: number
        -- The time when the version of a service template was last modified.
        lastModifiedAt: number
    end

    record ListServiceTemplateVersionsOutput
        -- A token that indicates the location of the next major or minor version in the array of
        -- major or minor versions of a service template, after the current requested list of service
        -- major or minor versions.
        nextToken: string
        -- An array of major or minor versions of a service template with detail data.
        templateVersions: {ServiceTemplateVersionSummary}
    end

    record UpdateServiceTemplateVersionInput
        -- The name of the service template.
        templateName: string
        -- To update a major version of a service template, include major
        -- Version.
        majorVersion: string
        -- To update a minor version of a service template, include minorVersion.
        minorVersion: string
        -- A description of a service template version to update.
        description: string
        -- The status of the service template minor version to update.
        status: string
        -- An array of environment template objects that are compatible with this service template
        -- version. A service instance based on this service template version can run in environments
        -- based on compatible templates.
        compatibleEnvironmentTemplates: {CompatibleEnvironmentTemplateInput}
        -- An array of supported component sources. Components with supported sources can be attached
        -- to service instances based on this service template version.
        -- A change to supportedComponentSources doesn't impact existing component
        -- attachments to instances based on this template version. A change only affects later
        -- associations.
        -- For more information about components, see
        -- Proton components in the
        -- Proton User Guide.
        supportedComponentSources: {string}
    end

    record UpdateServiceTemplateVersionOutput
        -- The service template version detail data that's returned by Proton.
        serviceTemplateVersion: ServiceTemplateVersion
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the Proton resource to apply customer tags to.
        resourceArn: string
        -- A list of customer tags to apply to the Proton resource.
        tags: {Tag}
    end

    record TagResourceOutput
    end

    record CreateTemplateSyncConfigInput
        -- The name of your registered template.
        templateName: string
        -- The type of the registered template.
        templateType: string
        -- The provider type for your repository.
        repositoryProvider: string
        -- The repository name (for example, myrepos/myrepo).
        repositoryName: string
        -- The repository branch for your template.
        branch: string
        -- A repository subdirectory path to your template bundle directory. When included, Proton limits the template bundle search to this
        -- repository directory.
        subdirectory: string
    end

    -- The detail data for a template sync configuration.
    record TemplateSyncConfig
        -- The template name.
        templateName: string
        -- The template type.
        templateType: string
        -- The repository provider.
        repositoryProvider: string
        -- The repository name (for example, myrepos/myrepo).
        repositoryName: string
        -- The repository branch.
        branch: string
        -- A subdirectory path to your template bundle version.
        subdirectory: string
    end

    record CreateTemplateSyncConfigOutput
        -- The template sync configuration detail data that's returned by Proton.
        templateSyncConfig: TemplateSyncConfig
    end

    record DeleteTemplateSyncConfigInput
        -- The template name.
        templateName: string
        -- The template type.
        templateType: string
    end

    record DeleteTemplateSyncConfigOutput
        -- The template sync configuration detail data that's returned by Proton.
        templateSyncConfig: TemplateSyncConfig
    end

    record GetTemplateSyncConfigInput
        -- The template name.
        templateName: string
        -- The template type.
        templateType: string
    end

    record GetTemplateSyncConfigOutput
        -- The template sync configuration detail data that's returned by Proton.
        templateSyncConfig: TemplateSyncConfig
    end

    record UpdateTemplateSyncConfigInput
        -- The synced template name.
        templateName: string
        -- The synced template type.
        templateType: string
        -- The repository provider.
        repositoryProvider: string
        -- The repository name (for example, myrepos/myrepo).
        repositoryName: string
        -- The repository branch for your template.
        branch: string
        -- A subdirectory path to your template bundle version. When included, limits the template bundle search to this repository directory.
        subdirectory: string
    end

    record UpdateTemplateSyncConfigOutput
        -- The template sync configuration detail data that's returned by Proton.
        templateSyncConfig: TemplateSyncConfig
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource to remove customer tags from.
        resourceArn: string
        -- A list of customer tag keys that indicate the customer tags to be removed from the resource.
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

end

return M
