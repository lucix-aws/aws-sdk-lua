        -- The repository branch.
        branch: string
        -- The directory in the repository.
        directory: string
    end

    record ListRepositorySyncDefinitionsOutput
        -- A token that indicates the location of the next repository sync definition in the array of repository sync definitions, after the current requested
        -- list of repository sync definitions.
        nextToken: string
        -- An array of repository sync definitions.
