    -- Revision detail data for a commit and push that activates a sync attempt
    record Revision
        -- The repository name.
        repositoryName: string
        -- The repository provider.
        repositoryProvider: string
        -- The secure hash algorithm (SHA) hash for the revision.
        sha: string
        -- The repository directory changed by a commit and push that activated the sync attempt.
        directory: string
        -- The repository branch.
        branch: string
    end

    -- Detail data for a resource sync event.
    record ResourceSyncEvent
        -- The external ID for the event.
        externalId: string
        -- The time when the event occurred.
        time: number
        -- A resource sync event.
        event: string
    end

    enum ResourceSyncStatus
        "INITIATED"
        "IN_PROGRESS"
        "SUCCEEDED"
        "FAILED"
    end

    -- Detail data for a resource sync attempt activated by a push to a repository.
    record ResourceSyncAttempt
        -- Detail data for the initial repository commit, path and push.
        initialRevision: Revision
        -- Detail data for the target revision.
        targetRevision: Revision
        -- The resource that is synced to.
        target: string
        -- The time when the sync attempt started.
        startedAt: number
        -- The status of the sync attempt.
        status: string
        -- An array of events with detail data.
        events: {ResourceSyncEvent}
    end

    record GetServiceInstanceSyncStatusOutput
        -- The detailed data of the latest sync with the service instance.
        latestSync: ResourceSyncAttempt
        -- The detailed data of the latest successful sync with the service instance.
        latestSuccessfulSync: ResourceSyncAttempt
        -- The service instance sync desired state that's returned by Proton
        desiredState: Revision
    end

    enum TemplateType
        "ENVIRONMENT"
        "SERVICE"
    end

    record GetTemplateSyncStatusInput
        -- The template name.
        templateName: string
        -- The template type.
        templateType: string
        -- The template major version.
        templateVersion: string
    end

    record GetTemplateSyncStatusOutput
        -- The details of the last sync that's returned by Proton.
        latestSync: ResourceSyncAttempt
        -- The details of the last successful sync that's returned by Proton.
        latestSuccessfulSync: ResourceSyncAttempt
        -- The template sync desired state that's returned by Proton.
        desiredState: Revision
    end

