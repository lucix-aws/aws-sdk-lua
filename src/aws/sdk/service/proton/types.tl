    record GetServiceSyncBlockerSummaryInput
        -- The name of the service that you want to get the service sync blocker summary for. If
        -- given only the service name, all instances are blocked.
        serviceName: string
        -- The name of the service instance that you want to get the service sync blocker summary
        -- for. If given bothe the instance name and the service name, only the instance is
        -- blocked.
        serviceInstanceName: string
    end

    -- Detailed data of the context of the sync blocker.
    record SyncBlockerContext
        -- The key for the sync blocker context.
        key: string
        -- The value of the sync blocker context.
        value: string
    end

    enum BlockerStatus
        "ACTIVE"
        "RESOLVED"
    end

    enum BlockerType
        "AUTOMATED"
    end

    -- Detailed data of the sync blocker.
    record SyncBlocker
        -- The ID of the sync blocker.
        id: string
        -- The status of the sync blocker.
        status: string
        -- The reason why the sync blocker was created.
        createdReason: string
        -- The time when the sync blocker was created.
        createdAt: number
        -- The contexts for the sync blocker.
        contexts: {SyncBlockerContext}
        -- The reason the sync blocker was resolved.
        resolvedReason: string
        -- The time the sync blocker was resolved.
        resolvedAt: number
    end

    -- If a service instance is manually updated, Proton wants to prevent accidentally overriding
    -- a manual change.
    -- A blocker is created because of the manual update or deletion of a service instance. The
    -- summary describes the blocker as being active or resolved.
    record ServiceSyncBlockerSummary
        -- The name of the service that you want to get the sync blocker summary for. If given a
        -- service instance name and a service name, it will return the blockers only applying to the
        -- instance that is blocked.
        -- If given only a service name, it will return the blockers that apply to all of the
        -- instances. In order to get the blockers for a single instance, you will need to make two
        -- distinct calls, one to get the sync blocker summary for the service and the other to get the
        -- sync blocker for the service instance.
        serviceName: string
        -- The name of the service instance that you want sync your service configuration
        -- with.
        serviceInstanceName: string
        -- The latest active blockers for the synced service.
        latestBlockers: {SyncBlocker}
    end

    record GetServiceSyncBlockerSummaryOutput
        -- The detailed data of the requested service sync blocker summary.
        serviceSyncBlockerSummary: ServiceSyncBlockerSummary
    end

    record UpdateServiceSyncBlockerInput
        -- The ID of the service sync blocker.
        id: string
        -- The reason the service sync blocker was resolved.
        resolvedReason: string
    end

    record UpdateServiceSyncBlockerOutput
        -- The name of the service that you want to update the service sync blocker for.
        serviceName: string
        -- The name of the service instance that you want to update the service sync blocker
        -- for.
        serviceInstanceName: string
        -- The detailed data on the service sync blocker that was updated.
        serviceSyncBlocker: SyncBlocker
    end

