    record StartMedicalStreamTranscriptionInput
        -- Specify the language code that represents the language spoken in your audio.
        -- Amazon Transcribe Medical only supports US English (en-US).
        LanguageCode: string
        -- The sample rate of the input audio (in hertz). Amazon Transcribe Medical supports a
        -- range from 16,000 Hz to 48,000 Hz. Note that the sample rate you specify must match that
        -- of your audio.
        MediaSampleRateHertz: number
        -- Specify the encoding used for the input audio. Supported formats are:
        -- FLAC
        -- OPUS-encoded audio in an Ogg container
        -- PCM (only signed 16-bit little-endian audio formats, which does not include
        -- WAV)
        -- For more information, see Media formats.
