        limitId: string
        -- Sets the status of the limit. You can mark the limit active, or you can stop usage of the limit and either complete existing tasks or cancel any existing tasks immediately.
        status: string
    end

    record UpdateQueueLimitAssociationOutput
    end

    -- The type of search filter to apply.
    record SearchFilterExpression
        -- Filters based on date and time.
        dateTimeFilter: DateTimeFilterExpression
        -- Filters by parameter.
        parameterFilter: ParameterFilterExpression
        -- Filters by a specified search term.
        searchTermFilter: SearchTermFilterExpression
        -- Filters by a string.
        stringFilter: StringFilterExpression
        -- Filters by a list of strings.
        stringListFilter: StringListFilterExpression
        -- Filters by group.
        groupFilter: SearchGroupedFilterExpressions
    end

    -- The search terms for a resource.
    record SearchGroupedFilterExpressions
        -- The filters to use for the search.
        filters: {SearchFilterExpression}
        -- The operators to include in the search.
        operator: string
    end

    -- Shared input fields for all Search operations (filterExpressions, sortExpressions, itemOffset, pageSize).
    record SearchJobsInput
        -- The farm ID of the job.
        farmId: string
        -- The search terms for a resource.
        filterExpressions: SearchGroupedFilterExpressions
        -- The search terms for a resource.
        sortExpressions: {SearchSortExpression}
        -- The offset for the search results.
        itemOffset: number
        -- Specifies the number of results to return.
        pageSize: number
        -- The queue ID to use in the job search.
        queueIds: {string}
    end

    -- Shared input fields for all Search operations (filterExpressions, sortExpressions, itemOffset, pageSize).
    record SearchStepsInput
        -- The farm ID to use for the step search.
        farmId: string
        -- The search terms for a resource.
        filterExpressions: SearchGroupedFilterExpressions
        -- The search terms for a resource.
        sortExpressions: {SearchSortExpression}
        -- The offset for the search results.
        itemOffset: number
        -- Specifies the number of results to return.
        pageSize: number
        -- The queue IDs in the step search.
        queueIds: {string}
        -- The job ID to use in the step search.
        jobId: string
    end

    -- Shared input fields for all Search operations (filterExpressions, sortExpressions, itemOffset, pageSize).
    record SearchTasksInput
        -- The farm ID of the task.
        farmId: string
        -- The search terms for a resource.
        filterExpressions: SearchGroupedFilterExpressions
        -- The search terms for a resource.
        sortExpressions: {SearchSortExpression}
        -- The offset for the search results.
        itemOffset: number
        -- Specifies the number of results to return.
        pageSize: number
        -- The queue IDs to include in the search.
        queueIds: {string}
        -- The job ID for the task search.
        jobId: string
    end

    -- Shared input fields for all Search operations (filterExpressions, sortExpressions, itemOffset, pageSize).
    record SearchWorkersInput
        -- The farm ID in the workers search.
        farmId: string
        -- The search terms for a resource.
        filterExpressions: SearchGroupedFilterExpressions
        -- The search terms for a resource.
        sortExpressions: {SearchSortExpression}
        -- The offset for the search results.
        itemOffset: number
        -- Specifies the number of results to return.
        pageSize: number
        -- The fleet ID of the workers to search for.
        fleetIds: {string}
    end

end

return M
