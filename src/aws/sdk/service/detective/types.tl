        -- Each pagination token expires after 24 hours.
        NextToken: string
    end

    record ListInvitationsInput
        -- For requests to retrieve the next page of results, the pagination token that was
        -- returned with the previous page of results. The initial request does not include a
        -- pagination token.
        NextToken: string
        -- The maximum number of behavior graph invitations to return in the response. The total
        -- must be less than the overall limit on the number of results to return, which is currently
        -- 200.
        MaxResults: number
    end

    record ListInvitationsOutput
        -- The list of behavior graphs for which the member account has open or accepted
        -- invitations.
        Invitations: {MemberDetail}
        -- If there are more behavior graphs remaining in the results, then this is the pagination
        -- token to use to request the next page of behavior graphs.
        NextToken: string
    end

    record ListMembersInput
        -- The ARN of the behavior graph for which to retrieve the list of member accounts.
        GraphArn: string
        -- For requests to retrieve the next page of member account results, the pagination token
        -- that was returned with the previous page of results. The initial request does not include a
        -- pagination token.
        NextToken: string
        -- The maximum number of member accounts to include in the response. The total must be less
        -- than the overall limit on the number of results to return, which is currently 200.
        MaxResults: number
    end

    record ListMembersOutput
        -- The list of member accounts in the behavior graph.
        -- For invited accounts, the results include member accounts that did not pass verification
        -- and member accounts that have not yet accepted the invitation to the behavior graph. The
        -- results do not include member accounts that were removed from the behavior graph.
        -- For the organization behavior graph, the results do not include organization accounts
        -- that the Detective administrator account has not enabled as member
        -- accounts.
        MemberDetails: {MemberDetail}
        -- If there are more member accounts remaining in the results, then use this pagination
        -- token to request the next page of member accounts.
        NextToken: string
    end

    record ListOrganizationAdminAccountsInput
        -- For requests to get the next page of results, the pagination token that was returned
        -- with the previous set of results. The initial request does not include a pagination
        -- token.
        NextToken: string
        -- The maximum number of results to return.
        MaxResults: number
    end

    record ListOrganizationAdminAccountsOutput
        -- The list of Detective administrator accounts.
        Administrators: {Administrator}
        -- If there are more accounts remaining in the results, then this is the pagination token
        -- to use to request the next page of accounts.
        NextToken: string
    end

    record ListTagsForResourceInput
        -- The ARN of the behavior graph for which to retrieve the tag values.
        ResourceArn: string
    end

    record ListTagsForResourceOutput
        -- The tag values that are assigned to the behavior graph. The request returns up to 50 tag
        -- values.
        Tags: {string : string}
    end

    record RejectInvitationInput
        -- The ARN of the behavior graph to reject the invitation to.
        -- The member account's current member status in the behavior graph must be
        -- INVITED.
        GraphArn: string
    end

    record RejectInvitationOutput
    end

    record StartInvestigationInput
        -- The Amazon Resource Name (ARN) of the behavior graph.
        GraphArn: string
        -- The unique Amazon Resource Name (ARN) of the IAM user and IAM role.
        EntityArn: string
        -- The data and time when the investigation began. The value is an UTC ISO8601 formatted string. For example, 2021-08-18T16:35:56.284Z.
        ScopeStartTime: number
        -- The data and time when the investigation ended. The value is an UTC ISO8601 formatted
        -- string. For example, 2021-08-18T16:35:56.284Z.
        ScopeEndTime: number
    end

    record StartInvestigationOutput
        -- The investigation ID of the investigation report.
        InvestigationId: string
    end

    record StartMonitoringMemberInput
        -- The ARN of the behavior graph.
        GraphArn: string
        -- The account ID of the member account to try to enable.
        -- The account must be an invited member account with a status of
        -- ACCEPTED_BUT_DISABLED.
        AccountId: string
    end

    record StartMonitoringMemberOutput
    end

    record TagResourceInput
        -- The ARN of the behavior graph to assign the tags to.
        ResourceArn: string
        -- The tags to assign to the behavior graph. You can add up to 50 tags. For each tag, you
        -- provide the tag key and the tag value. Each tag key can contain up to 128 characters. Each
        -- tag value can contain up to 256 characters.
        Tags: {string : string}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The ARN of the behavior graph to remove the tags from.
        ResourceArn: string
        -- The tag keys of the tags to remove from the behavior graph. You can remove up to 50 tags
        -- at a time.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateDatasourcePackagesInput
        -- The ARN of the behavior graph.
        GraphArn: string
        -- The data source package to start for the behavior graph.
        DatasourcePackages: {string}
    end

    record UpdateDatasourcePackagesOutput
    end

    record UpdateInvestigationStateInput
        -- The Amazon Resource Name (ARN) of the behavior graph.
        GraphArn: string
        -- The investigation ID of the investigation report.
        InvestigationId: string
        -- The current state of the investigation. An archived investigation indicates you have completed reviewing the investigation.
        State: string
    end

    record UpdateInvestigationStateOutput
    end

    record UpdateOrganizationConfigurationInput
        -- The ARN of the organization behavior graph.
        GraphArn: string
        -- Indicates whether to automatically enable new organization accounts as member accounts
        -- in the organization behavior graph.
        AutoEnable: boolean
    end

    record UpdateOrganizationConfigurationOutput
    end

end

return M
