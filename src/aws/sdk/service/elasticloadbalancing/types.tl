        Instances: {Instance}
    end

    -- Contains the output of RegisterInstancesWithLoadBalancer.
    record RegisterInstancesWithLoadBalancerOutput
        -- The updated list of instances for the load balancer.
        Instances: {Instance}
    end

    -- The key of a tag.
    record TagKeyOnly
        -- The name of the key.
        Key: string
    end

    -- Contains the parameters for RemoveTags.
    record RemoveTagsInput
        -- The name of the load balancer. You can specify a maximum of one load balancer name.
        LoadBalancerNames: {string}
        -- The list of tag keys to remove.
        Tags: {TagKeyOnly}
    end

    -- Contains the output of RemoveTags.
    record RemoveTagsOutput
    end

    -- The load balancer does not have a listener configured at the specified port.
    record ListenerNotFoundException
        Message: string
    end

    -- Contains the parameters for SetLoadBalancerListenerSSLCertificate.
    record SetLoadBalancerListenerSSLCertificateInput
        -- The name of the load balancer.
        LoadBalancerName: string
        -- The port that uses the specified SSL certificate.
        LoadBalancerPort: number
        -- The Amazon Resource Name (ARN) of the SSL certificate.
        SSLCertificateId: string
    end

    -- Contains the output of SetLoadBalancerListenerSSLCertificate.
    record SetLoadBalancerListenerSSLCertificateOutput
    end

    -- Contains the parameters for SetLoadBalancerPoliciesForBackendServer.
    record SetLoadBalancerPoliciesForBackendServerInput
        -- The name of the load balancer.
        LoadBalancerName: string
        -- The port number associated with the EC2 instance.
        InstancePort: number
        -- The names of the policies. If the list is empty, then all current polices are removed from the EC2 instance.
        PolicyNames: {string}
    end

    -- Contains the output of SetLoadBalancerPoliciesForBackendServer.
    record SetLoadBalancerPoliciesForBackendServerOutput
    end

    -- Contains the parameters for SetLoadBalancePoliciesOfListener.
    record SetLoadBalancerPoliciesOfListenerInput
        -- The name of the load balancer.
        LoadBalancerName: string
        -- The external port of the load balancer.
        LoadBalancerPort: number
        -- The names of the policies. This list must include all policies to be enabled. If you omit a policy that is currently enabled, it is disabled. If the list is empty, all current policies are disabled.
        PolicyNames: {string}
    end

    -- Contains the output of SetLoadBalancePoliciesOfListener.
    record SetLoadBalancerPoliciesOfListenerOutput
    end

end

return M
