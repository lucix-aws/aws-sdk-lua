    enum CodeRepositoryProviderType
        "GITHUB"
        "GITLAB_SELF_MANAGED"
    end

    -- Contains details about a code repository associated with a finding.
    record CodeRepositoryDetails
        -- The name of the project in the code repository.
        projectName: string
        -- The Amazon Resource Name (ARN) of the code security integration associated with the
        -- repository.
        integrationArn: string
        -- The type of repository provider (such as GitHub, GitLab, etc.).
        providerType: string
    end

    enum ScanStatusReason
        "PENDING_INITIAL_SCAN"
        "ACCESS_DENIED"
        "INTERNAL_ERROR"
        "UNMANAGED_EC2_INSTANCE"
        "UNSUPPORTED_OS"
        "SCAN_ELIGIBILITY_EXPIRED"
        "RESOURCE_TERMINATED"
        "SUCCESSFUL"
        "NO_RESOURCES_FOUND"
        "IMAGE_SIZE_EXCEEDED"
        "SCAN_FREQUENCY_MANUAL"
        "SCAN_FREQUENCY_SCAN_ON_PUSH"
        "EC2_INSTANCE_STOPPED"
        "PENDING_DISABLE"
        "NO_INVENTORY"
        "STALE_INVENTORY"
        "EXCLUDED_BY_TAG"
        "UNSUPPORTED_RUNTIME"
        "UNSUPPORTED_MEDIA_TYPE"
        "UNSUPPORTED_CONFIG_FILE"
        "DEEP_INSPECTION_PACKAGE_COLLECTION_LIMIT_EXCEEDED"
        "DEEP_INSPECTION_DAILY_SSM_INVENTORY_LIMIT_EXCEEDED"
        "DEEP_INSPECTION_COLLECTION_TIME_LIMIT_EXCEEDED"
        "DEEP_INSPECTION_NO_INVENTORY"
        "AGENTLESS_INSTANCE_STORAGE_LIMIT_EXCEEDED"
        "AGENTLESS_INSTANCE_COLLECTION_TIME_LIMIT_EXCEEDED"
        "PENDING_REVIVAL_SCAN"
        "INTEGRATION_CONNECTION_LOST"
        "ACCESS_DENIED_TO_ENCRYPTION_KEY"
        "UNSUPPORTED_LANGUAGE"
        "NO_SCAN_CONFIGURATION_ASSOCIATED"
        "SCAN_IN_PROGRESS"
        "IMAGE_ARCHIVED"
        "UNSUPPORTED_CODE_ARTIFACTS"
        "RESOURCE_UNMANAGED"
        "RESOURCE_STOPPED"
    end

    enum ScanStatusCode
        "ACTIVE"
        "INACTIVE"
    end

    -- The status of the scan.
    record ScanStatus
        -- The status code of the scan.
        statusCode: string
        -- The scan status. Possible return values and descriptions are:
        -- ACCESS_DENIED - Resource access policy restricting Amazon Inspector access. Please
        -- update the IAM policy.
        -- ACCESS_DENIED_TO_ENCRYPTION_KEY - The KMS key policy doesn't allow Amazon Inspector
        -- access. Update the key policy.
        -- DEEP_INSPECTION_COLLECTION_TIME_LIMIT_EXCEEDED - Amazon Inspector failed to extract
        -- the package inventory because the package collection time exceeding the maximum threshold
        -- of 15 minutes.
        -- DEEP_INSPECTION_DAILY_SSM_INVENTORY_LIMIT_EXCEEDED - The SSM agent couldn't
        -- send inventory to Amazon Inspector because the SSM quota for Inventory data collected per instance per
        -- day has already been reached for this instance.
        -- DEEP_INSPECTION_NO_INVENTORY - The Amazon Inspector plugin hasn't yet been able to
        -- collect an inventory of packages for this instance. This is usually the result of a pending
        -- scan, however, if this status persists after 6 hours, use SSM to ensure that
        -- the required Amazon Inspector associations exist and are running for the instance.
        -- DEEP_INSPECTION_PACKAGE_COLLECTION_LIMIT_EXCEEDED - The instance has
        -- exceeded the 5000 package limit for Amazon Inspector Deep inspection. To resume Deep inspection for
        -- this instance you can try to adjust the custom paths associated with the account.
        -- EC2_INSTANCE_STOPPED - This EC2 instance is in a stopped state, therefore,
        -- Amazon Inspector will pause scanning. The existing findings will continue to exist until the instance
        -- is terminated. Once the instance is re-started, Inspector will automatically start scanning
        -- the instance again. Please note that you will not be charged for this instance while it's
        -- in a stopped state.
        -- EXCLUDED_BY_TAG - This resource was not scanned because it has been
        -- excluded by a tag.
        -- IMAGE_SIZE_EXCEEDED - Reserved for future use.
        -- INTEGRATION_CONNNECTION_LOST - Amazon Inspector couldn't communicate with the source
        -- code management platform.
        -- INTERNAL_ERROR - Amazon Inspector has encountered an internal error for this resource.
        -- Amazon Inspector service will automatically resolve the issue and resume the scanning. No action
        -- required from the user.
        -- NO_INVENTORY - Amazon Inspector couldn't find software application inventory to scan
        -- for vulnerabilities. This might be caused due to required Amazon Inspector associations being deleted
        -- or failing to run on your resource. Please verify the status of
        -- InspectorInventoryCollection-do-not-delete association in the SSM console
        -- for the resource. Additionally, you can verify the instance's inventory in the SSM Fleet
        -- Manager console.
        -- NO_RESOURCES_FOUND - Reserved for future use.
        -- NO_SCAN_CONFIGURATION_ASSOCIATED - The code repository resource doesn't
        -- have an associated scan configuration.
        -- PENDING_DISABLE - This resource is pending cleanup during disablement. The
        -- customer will not be billed while a resource is in the pending disable status.
        -- PENDING_INITIAL_SCAN - This resource has been identified for scanning,
        -- results will be available soon.
        -- RESOURCE_TERMINATED - This resource has been terminated. The findings and
        -- coverage associated with this resource are in the process of being cleaned up.
        -- SCAN_ELIGIBILITY_EXPIRED - The configured scan duration has lapsed for this
        -- image.
        -- SCAN_FREQUENCY_MANUAL - This image will not be covered by Amazon Inspector due to the
        -- repository scan frequency configuration.
        -- SCAN_FREQUENCY_SCAN_ON_PUSH - This image will be scanned one time and will
        -- not new findings because of the scan frequency configuration.
        -- SCAN_IN_PROGRESS - The resource is currently being scanned.
        -- STALE_INVENTORY - Amazon Inspector wasn't able to collect an updated software
        -- application inventory in the last 7 days. Please confirm the required Amazon Inspector associations
        -- still exist and you can still see an updated inventory in the SSM console.
        -- SUCCESSFUL - The scan was successful.
        -- UNMANAGED_EC2_INSTANCE - The EC2 instance is not managed by SSM, please use
        -- the following SSM automation to remediate the issue: https://docs.aws.amazon.com/systems-manager-automation-runbooks/latest/userguide/automation-awssupport-troubleshoot-managed-instance.html.
        -- Once the instance becomes managed by SSM, Inspector will automatically begin scanning this
        -- instance.
        -- UNSUPPORTED_CODE_ARTIFACTS - The function was not scanned because it has an unsupported code artifacts.
        -- UNSUPPORTED_CONFIG_FILE - Reserved for future use.
        -- UNSUPPORTED_LANGUAGE - The scan was unsuccessful because the repository
        -- contains files in an unsupported programming language.
        -- UNSUPPORTED_MEDIA_TYPE - The ECR image has an unsupported media
        -- type.
        -- UNSUPPORTED_OS - Amazon Inspector does not support this OS, architecture, or image
        -- manifest type at this time. To see a complete list of supported operating systems see:
        -- https://docs.aws.amazon.com/inspector/latest/user/supported.html.
        -- UNSUPPORTED_RUNTIME - The function was not scanned because it has an
        -- unsupported runtime. To see a complete list of supported runtimes see: https://docs.aws.amazon.com/inspector/latest/user/supported.html.
        -- IMAGE_ARCHIVED - This image has been archived in Amazon ECR and is no longer available for scanning in Amazon Inspector.
        reason: string
    end

    -- Contains information about on-demand scans performed on a code repository.
    record CodeRepositoryOnDemandScan
        -- The ID of the last commit that was scanned during an on-demand scan.
        lastScannedCommitId: string
        -- The timestamp when the last on-demand scan was performed.
        lastScanAt: number
        scanStatus: ScanStatus
    end

    enum RuleSetCategory
        "SAST"
        "IAC"
        "SCA"
    end

    enum ContinuousIntegrationScanEvent
        "PULL_REQUEST"
        "PUSH"
    end

    -- Contains the continuous integration scan configuration settings applied to a specific
    -- project.
    record ProjectContinuousIntegrationScanConfiguration
        -- The repository event that triggers continuous integration scans for the project.
        supportedEvent: string
        -- The categories of security rules applied during continuous integration scans for the
        -- project.
        ruleSetCategories: {string}
    end

    -- Contains the periodic scan configuration settings applied to a specific project.
    record ProjectPeriodicScanConfiguration
        -- The schedule expression for periodic scans, in cron format, applied to the
        -- project.
        frequencyExpression: string
        -- The categories of security rules applied during periodic scans for the project.
        ruleSetCategories: {string}
    end

    -- Contains the scan configuration settings applied to a specific project in a code
    -- repository.
    record ProjectCodeSecurityScanConfiguration
        -- The periodic scan configurations applied to the project.
        periodicScanConfigurations: {ProjectPeriodicScanConfiguration}
        -- The continuous integration scan configurations applied to the project.
        continuousIntegrationScanConfigurations: {ProjectContinuousIntegrationScanConfiguration}
    end

    -- Contains metadata information about a code repository that is being scanned by Amazon
    -- Inspector.
    record CodeRepositoryMetadata
        -- The name of the project in the code repository.
        projectName: string
        -- The Amazon Resource Name (ARN) of the code security integration associated with the
        -- repository.
        integrationArn: string
        -- The type of repository provider (such as GitHub, GitLab, etc.).
        providerType: string
        -- The visibility setting of the repository (public or private).
        providerTypeVisibility: string
        -- The ID of the last commit that was scanned in the repository.
        lastScannedCommitId: string
        -- The scan configuration settings applied to the code repository.
        scanConfiguration: ProjectCodeSecurityScanConfiguration
        -- Information about on-demand scans performed on the repository.
        onDemandScan: CodeRepositoryOnDemandScan
    end

    enum CodeScanStatus
        "IN_PROGRESS"
        "SUCCESSFUL"
        "FAILED"
        "SKIPPED"
    end

    enum IntegrationStatus
        "PENDING"
        "IN_PROGRESS"
        "ACTIVE"
        "INACTIVE"
        "DISABLING"
    end

    enum IntegrationType
        "GITLAB_SELF_MANAGED"
        "GITHUB"
    end

    -- A summary of information about a code security integration.
    record CodeSecurityIntegrationSummary
        -- The Amazon Resource Name (ARN) of the code security integration.
        integrationArn: string
        -- The name of the code security integration.
        name: string
        -- The current status of the code security integration.
        status: string
        -- The reason for the current status of the code security integration.
        statusReason: string
        -- The timestamp when the code security integration was created.
        createdOn: number
        -- The timestamp when the code security integration was last updated.
        lastUpdateOn: number
        -- The tags associated with the code security integration.
        tags: {string : string}
    end

    -- Configuration settings for continuous integration scans that run automatically when code
    -- changes are made.
    record ContinuousIntegrationScanConfiguration
        -- The repository events that trigger continuous integration scans, such as pull requests
        -- or commits.
        supportedEvents: {string}
    end

    enum PeriodicScanFrequency
        "WEEKLY"
        "MONTHLY"
        "NEVER"
    end

    -- Configuration settings for periodic scans that run on a scheduled basis.
    record PeriodicScanConfiguration
        -- The frequency at which periodic scans are performed (such as weekly or monthly).
        -- If you don't provide the frequencyExpression Amazon Inspector chooses day for the scan
        -- to run. If you provide the frequencyExpression, the schedule must match the
        -- specified frequency.
        frequency: string
        -- The schedule expression for periodic scans, in cron format.
        frequencyExpression: string
    end

    -- Contains the configuration settings for code security scans.
    record CodeSecurityScanConfiguration
        -- Configuration settings for periodic scans that run on a scheduled basis.
        periodicScanConfiguration: PeriodicScanConfiguration
        -- Configuration settings for continuous integration scans that run automatically when code
        -- changes are made.
        continuousIntegrationScanConfiguration: ContinuousIntegrationScanConfiguration
        -- The categories of security rules to be applied during the scan.
        ruleSetCategories: {string}
    end

    -- A summary of an association between a code repository and a scan configuration.
    record CodeSecurityScanConfigurationAssociationSummary
        resource: CodeSecurityResource
    end

    enum ProjectSelectionScope
        "ALL"
    end

    -- Defines the scope of repositories to be included in code security scans.
    record ScopeSettings
        -- The scope of projects to be selected for scanning within the integrated repositories.
        -- Setting the value to ALL applies the scope settings to all existing and future
        -- projects imported into Amazon Inspector.
        projectSelectionScope: string
    end

    -- A summary of information about a code security scan configuration.
    record CodeSecurityScanConfigurationSummary
        -- The Amazon Resource Name (ARN) of the scan configuration.
        scanConfigurationArn: string
        -- The name of the scan configuration.
        name: string
        -- The Amazon Web Services account ID that owns the scan configuration.
        ownerAccountId: string
        -- The frequency at which periodic scans are performed.
        periodicScanFrequency: string
        -- The schedule expression for periodic scans, in cron format.
        frequencyExpression: string
        -- The repository events that trigger continuous integration scans.
        continuousIntegrationScanSupportedEvents: {string}
        -- The categories of security rules applied during the scan.
        ruleSetCategories: {string}
        -- The scope settings that define which repositories will be scanned. If the
        -- ScopeSetting parameter is ALL the scan configuration applies
        -- to all existing and future projects imported into Amazon Inspector.
        scopeSettings: ScopeSettings
        -- The tags associated with the scan configuration.
        tags: {string : string}
    end

    -- Contains information on the code vulnerability identified in your Lambda
    -- function.
    record CodeVulnerabilityDetails
        -- Contains information on where the code vulnerability is located in your code.
        filePath: CodeFilePath
        -- The detector tag associated with the vulnerability. Detector tags group related
        -- vulnerabilities by common themes or tactics. For a list of available tags by programming
        -- language, see Java
        -- tags, or Python tags.
        detectorTags: {string}
        -- A URL containing supporting documentation about the code vulnerability detected.
        referenceUrls: {string}
        -- The identifier for a rule that was used to detect the code vulnerability.
        ruleId: string
        -- The Amazon Resource Name (ARN) of the Lambda layer that the code vulnerability was
        -- detected in.
        sourceLambdaLayerArn: string
        -- The ID for the Amazon CodeGuru detector associated with the finding. For more
        -- information on detectors see Amazon CodeGuru Detector Library.
        detectorId: string
        -- The name of the detector used to identify the code vulnerability. For more information
        -- on detectors see CodeGuru
        -- Detector Library.
        detectorName: string
        -- The Common Weakness Enumeration (CWE) item associated with the detected
        -- vulnerability.
        cwes: {string}
    end

    -- A compute platform.
    record ComputePlatform
        -- The compute platform vendor.
        vendor: string
        -- The compute platform product.
        product: string
        -- The compute platform version.
        version: string
    end

    enum ConfigurationLevel
        "ORGANIZATION"
        "ACCOUNT"
    end

    enum EnablementStatus
        "ENABLED"
        "PENDING_ENABLEMENT"
        "FAILED_TO_ENABLE"
        "PENDING_UPDATE"
        "FAILED_TO_UPDATE"
        "PENDING_DELETION"
        "DELETED"
        "FAILED_TO_DELETE"
    end

    enum ConnectorHealthStatus
        "CONNECTED"
        "DEGRADED"
        "FAILED_TO_CONNECT"
        "PENDING_AUTHORIZATION"
        "PENDING_CONFIGURATION"
        "UNKNOWN"
    end

    -- The health and connectivity status of a connector, including the last time the status was checked and any diagnostic message. Returned as part of the Connector structure.
    record ConnectorHealth
        -- The health status of the connector.
        connectorStatus: string
        -- The date and time when the connector health was last checked.
        lastCheckedAt: number
        -- A message providing additional details about the connector health status.
        message: string
    end

    enum ConnectorCloudProvider
        "AZURE"
    end

    -- Describes a connector that links an external cloud provider to Amazon Inspector for vulnerability scanning.
    record Connector
        -- The Amazon Resource Name (ARN) of the connector.
        connectorArn: string
        -- The name of the connector.
        name: string
        -- A description of the connector.
        description: string
        -- The cloud provider for the connector.
        provider: string
        -- The enablement status of the connector, which indicates whether the connector is active and scanning resources.
        enablementStatus: string
        -- Additional information about the current enablement status of the connector.
        enablementStatusReason: string
        -- The health of the connector, which indicates whether Amazon Inspector can reach and scan the connected resources.
        health: ConnectorHealth
        -- The date and time when the connector was created.
        createdAt: number
        -- The date and time when the connector was last updated.
        updatedAt: number
        -- The Azure regions configured for the connector.
        azureRegions: {string}
        -- The ARN of the Amazon Web Services Config connector associated with this connector.
        awsConfigConnectorArn: string
        -- The Azure scope configuration for the connector.
        scopeConfiguration: AzureScopeConfiguration
        -- The tags associated with the connector.
        tags: {string : string}
        -- Specifies whether the VM scanner is automatically installed on connected resources.
        autoInstallVMScanner: boolean
    end

    enum ConnectorArnComparison
        "EQUALS"
    end

    -- A filter that matches connectors by connector ARN.
    record ConnectorArnFilter
        -- The comparison operator for the connector ARN filter.
        comparison: string
        -- The connector ARN value to filter by.
        value: string
    end

    enum ContainerImagePullDateRescanDuration
        "DAYS_3"
        "DAYS_7"
        "DAYS_14"
        "DAYS_30"
        "DAYS_60"
        "DAYS_90"
        "DAYS_180"
    end

    enum ContainerImageRescanDuration
        "LIFETIME"
        "DAYS_3"
        "DAYS_7"
        "DAYS_30"
        "DAYS_180"
        "DAYS_14"
        "DAYS_60"
        "DAYS_90"
    end

    -- The container image scanning settings for a connector, including how long pushed and pulled images continue to be rescanned for vulnerabilities.
    record ConnectorContainerImageScanConfiguration
        -- The amount of time after a container image is pushed to a repository during which Amazon Inspector continues to rescan the image for vulnerabilities. Valid values are LIFETIME, DAYS_3, DAYS_7, DAYS_14, DAYS_30, DAYS_60, DAYS_90, and DAYS_180.
        pushDuration: string
        -- The amount of time after a container image is last pulled from a repository during which Amazon Inspector continues to rescan the image for vulnerabilities. Valid values are DAYS_3, DAYS_7, DAYS_14, DAYS_30, DAYS_60, DAYS_90, and DAYS_180.
        pullDuration: string
    end

    enum ConnectorTypeComparison
        "EQUALS"
    end

    enum ConnectorType
        "CUSTOMER_MANAGED"
        "SERVICE_LINKED"
    end

    -- A filter that matches connectors by connector type.
    record ConnectorTypeFilter
        -- The comparison operator for the connector type filter.
        comparison: string
        -- The connector type value to filter by.
        value: string
    end

    enum ProviderComparison
        "EQUALS"
    end

    -- A filter that matches connectors by cloud provider.
    record ProviderFilter
        -- The comparison operator for the provider filter.
        comparison: string
        -- The cloud provider value to filter by.
        value: string
    end

    -- Contains the filter criteria for narrowing the results returned by a ListConnectors request. You can filter by connector ARN, Amazon Web Services account ID, Amazon Web Services Config connector ARN, connector type, or cloud provider.
    record ConnectorFilterCriteria
        -- Filter by connector ARNs.
        connectorArns: {ConnectorArnFilter}
        -- Filter by Amazon Web Services account IDs.
        accounts: {StringFilter}
        -- Filter by Amazon Web Services Config connector ARNs.
        awsConfigConnectorArns: {AwsConfigConnectorArnFilter}
        -- Filter by connector type.
        connectorType: {ConnectorTypeFilter}
        -- Filter by cloud provider.
        provider: {ProviderFilter}
    end

    -- The scan settings that Amazon Inspector applies to resources discovered through a connector.
    record ConnectorScanConfiguration
        -- The container image scanning configuration, including push and pull duration settings.
        containerImageScanning: ConnectorContainerImageScanConfiguration
    end

    -- Represents a scan configuration and the connectors it applies to. Returned in the results of a ListConnectorScanConfigurations request.
    record ConnectorScanConfigurationItem
        -- The ARN of the Amazon Web Services Config connector.
        awsConfigConnectorArn: string
        -- The list of connector ARNs associated with this Amazon Web Services Config connector.
        connectorArns: {string}
        -- The scan configuration settings.
        scanConfiguration: ConnectorScanConfiguration
    end

    -- Contains metadata about a container image associated with a covered resource.
    record ContainerImageMetadata
        -- The tags attached to the container image.
        imageTags: {string}
        -- The date and time the container image was pulled.
        imagePulledAt: number
        -- The last time the container image was in use.
        lastInUseAt: number
        -- The number of times the container image is in use.
        inUseCount: number
    end

    -- Contains metadata about a container registry associated with a covered resource.
    record ContainerRegistryMetadata
        -- The name of the container registry.
        name: string
    end

    -- Contains metadata about a container repository associated with a covered resource.
    record ContainerRepositoryMetadata
        -- The name of the container repository.
        name: string
        -- The scan frequency for the container repository.
        scanFrequency: string
    end

    enum GroupKey
        "SCAN_STATUS_CODE"
        "SCAN_STATUS_REASON"
        "ACCOUNT_ID"
        "RESOURCE_TYPE"
        "ECR_REPOSITORY_NAME"
        "PROVIDER"
        "PROVIDER_ACCOUNT_ID"
        "PROVIDER_REGION"
        "PROVIDER_ORG_ID"
    end

    -- a structure that contains information on the count of resources within a group.
    record Counts
        -- The number of resources.
        count: number
        -- The key associated with this group
        groupKey: string
    end

    -- Contains details of a coverage date filter.
    record CoverageDateFilter
        -- A timestamp representing the start of the time period to filter results by.
        startInclusive: number
        -- A timestamp representing the end of the time period to filter results by.
        endInclusive: number
    end

    enum CoverageStringComparison
        "EQUALS"
        "NOT_EQUALS"
    end

    -- Contains details of a coverage string filter.
    record CoverageStringFilter
        -- The operator to compare strings on.
        comparison: string
        -- The value to compare strings on.
        value: string
    end

    enum CoverageMapComparison
        "EQUALS"
    end

    -- Contains details of a coverage map filter.
    record CoverageMapFilter
        -- The operator to compare coverage on.
        comparison: string
        -- The tag key associated with the coverage map filter.
        key: string
        -- The tag value associated with the coverage map filter.
        value: string
    end

    -- The coverage number to be used in the filter.
    record CoverageNumberFilter
        -- The upper inclusive for the coverage number.>
        upperInclusive: number
        -- The lower inclusive for the coverage number.
        lowerInclusive: number
    end

    -- A structure that identifies filter criteria for
    -- GetCoverageStatistics.
    record CoverageFilterCriteria
        -- The scan status code to filter on. Valid values are: ValidationException,
        -- InternalServerException, ResourceNotFoundException,
        -- BadRequestException, and ThrottlingException.
        scanStatusCode: {CoverageStringFilter}
        -- The scan status reason to filter on.
        scanStatusReason: {CoverageStringFilter}
        -- An array of Amazon Web Services account IDs to return coverage statistics for.
        accountId: {CoverageStringFilter}
        -- An array of Amazon Web Services resource IDs to return coverage statistics for.
        resourceId: {CoverageStringFilter}
        -- An array of Amazon Web Services resource types to return coverage statistics for. The values can be
        -- AWS_EC2_INSTANCE, AWS_LAMBDA_FUNCTION,
        -- AWS_ECR_CONTAINER_IMAGE, AWS_ECR_REPOSITORY or
        -- AWS_ACCOUNT.
        resourceType: {CoverageStringFilter}
        -- An array of Amazon Inspector scan types to return coverage statistics for.
        scanType: {CoverageStringFilter}
        -- The Amazon ECR repository name to filter on.
        ecrRepositoryName: {CoverageStringFilter}
        -- The Amazon ECR image tags to filter on.
        ecrImageTags: {CoverageStringFilter}
        -- The Amazon EC2 instance tags to filter on.
        ec2InstanceTags: {CoverageMapFilter}
        -- Returns coverage statistics for Amazon Web Services Lambda functions filtered by function
        -- names.
        lambdaFunctionName: {CoverageStringFilter}
        -- Returns coverage statistics for Amazon Web Services Lambda functions filtered by
        -- tag.
        lambdaFunctionTags: {CoverageMapFilter}
        -- Returns coverage statistics for Amazon Web Services Lambda functions filtered by
        -- runtime.
        lambdaFunctionRuntime: {CoverageStringFilter}
        -- Filters Amazon Web Services resources based on whether Amazon Inspector has checked them for vulnerabilities
        -- within the specified time range.
        lastScannedAt: {CoverageDateFilter}
        -- The filter to search for Amazon EC2 instance coverage by scan mode. Valid values are
        -- EC2_SSM_AGENT_BASED, EC2_AGENTLESS, and EC2_INSPECTOR_AGENT_BASED.
        scanMode: {CoverageStringFilter}
        -- The date an image was last pulled at.
        imagePulledAt: {CoverageDateFilter}
        -- The Amazon ECR image that was last in use.
        ecrImageLastInUseAt: {CoverageDateFilter}
        -- The number of Amazon ECR images in use.
        ecrImageInUseCount: {CoverageNumberFilter}
        -- Filter criteria for code repositories based on project name.
        codeRepositoryProjectName: {CoverageStringFilter}
        -- Filter criteria for code repositories based on provider type (such as GitHub, GitLab,
        -- etc.).
        codeRepositoryProviderType: {CoverageStringFilter}
        -- Filter criteria for code repositories based on visibility setting (public or
        -- private).
        codeRepositoryProviderTypeVisibility: {CoverageStringFilter}
        -- Filter criteria for code repositories based on the ID of the last scanned commit.
        lastScannedCommitId: {CoverageStringFilter}
        -- The cloud provider to filter coverage results by.
        cloudProvider: {CoverageStringFilter}
        -- The cloud provider account ID to filter coverage results by.
        cloudProviderAccountId: {CoverageStringFilter}
        -- The cloud provider region to filter coverage results by.
        cloudProviderRegion: {CoverageStringFilter}
        -- The cloud VM instance tags to filter coverage results by.
        cloudVmInstanceTags: {CoverageMapFilter}
        -- The cloud container image tags to filter coverage results by.
        cloudContainerImageTags: {CoverageStringFilter}
        -- The cloud container repository name to filter coverage results by.
        cloudContainerRepositoryName: {CoverageStringFilter}
        -- The cloud container registry name to filter coverage results by.
        cloudContainerRegistryName: {CoverageStringFilter}
        -- The cloud serverless function name to filter coverage results by.
        cloudServerlessFunctionName: {CoverageStringFilter}
        -- The cloud serverless function runtime to filter coverage results by.
        cloudServerlessFunctionRuntime: {CoverageStringFilter}
        -- The cloud serverless function tags to filter coverage results by.
        cloudServerlessFunctionTags: {CoverageMapFilter}
        -- The cloud provider organization ID to filter coverage results by.
        cloudProviderOrgId: {CoverageStringFilter}
    end

    enum CoverageResourceType
        "AWS_EC2_INSTANCE"
        "AWS_ECR_CONTAINER_IMAGE"
        "AWS_ECR_REPOSITORY"
        "AWS_LAMBDA_FUNCTION"
        "CODE_REPOSITORY"
        "Microsoft.Compute/virtualMachines"
        "Microsoft.ContainerRegistry/registry/containerImage"
        "Microsoft.ContainerRegistry/registry/containerRepository"
        "Microsoft.Web/sites"
        "Microsoft.ContainerRegistry/registries"
    end

    enum Ec2Platform
        "WINDOWS"
        "LINUX"
        "UNKNOWN"
        "MACOS"
    end

    -- Meta data details of an Amazon EC2 instance.
    record Ec2Metadata
        -- The tags attached to the instance.
        tags: {string : string}
        -- The ID of the Amazon Machine Image (AMI) used to launch the instance.
        amiId: string
        -- The platform of the instance.
        platform: string
    end

    -- Information on the Amazon ECR image metadata associated with a finding.
    record EcrContainerImageMetadata
        -- Tags associated with the Amazon ECR image metadata.
        tags: {string}
        -- The date an image was last pulled at.
        imagePulledAt: number
        -- The last time an Amazon ECR image was used in an Amazon ECS task or
        -- Amazon EKS pod.
        lastInUseAt: number
        -- The number of Amazon ECS tasks or Amazon EKS pods where the Amazon ECR container image is in use.
        inUseCount: number
    end

    enum EcrScanFrequency
        "MANUAL"
        "SCAN_ON_PUSH"
        "CONTINUOUS_SCAN"
    end

    -- Information on the Amazon ECR repository metadata associated with a finding.
    record EcrRepositoryMetadata
        -- The name of the Amazon ECR repository.
        name: string
        -- The frequency of scans.
        scanFrequency: string
    end

    -- The Amazon Web Services Lambda function metadata.
    record LambdaFunctionMetadata
        -- The resource tags on an Amazon Web Services Lambda function.
        functionTags: {string : string}
        -- The layers for an Amazon Web Services Lambda function. A Lambda function can have up to
        -- five layers.
        layers: {string}
        -- The name of a function.
        functionName: string
        -- An Amazon Web Services Lambda function's runtime.
        runtime: string
    end

    -- Contains metadata about a serverless function associated with a covered resource.
    record ServerlessFunctionMetadata
        -- The name of the serverless function.
        serverlessFunctionName: string
        -- The runtime of the serverless function.
        runtime: string
        -- The tags associated with the serverless function.
        functionTags: {string : string}
    end

    enum VmPlatform
        "WINDOWS"
        "LINUX"
        "UNKNOWN"
    end

    -- Contains metadata about a virtual machine (VM) instance associated with a covered resource.
    record VmInstanceMetadata
        -- The tags associated with the VM instance.
        tags: {string : string}
        -- The platform of the VM instance.
        platform: string
        -- The inventory hash of the VM instance.
        inventoryHash: string
        -- The image reference of the VM instance.
        vmImageReference: string
    end

    -- An object that contains details about the metadata for an Amazon ECR resource.
    record ResourceScanMetadata
        -- An object that contains details about the repository an Amazon ECR image resides in.
        ecrRepository: EcrRepositoryMetadata
        -- An object that contains details about the container metadata for an Amazon ECR image.
        ecrImage: EcrContainerImageMetadata
        -- An object that contains metadata details for an Amazon EC2 instance.
        ec2: Ec2Metadata
        -- An object that contains metadata details for an Amazon Web Services Lambda
        -- function.
        lambdaFunction: LambdaFunctionMetadata
        -- Contains metadata about scan coverage for a code repository resource.
        codeRepository: CodeRepositoryMetadata
        -- The VM instance metadata associated with a covered resource.
        vmInstance: VmInstanceMetadata
        -- The container image metadata associated with a covered resource.
        containerImage: ContainerImageMetadata
        -- The container repository metadata associated with a covered resource.
        containerRepository: ContainerRepositoryMetadata
        -- The container registry metadata associated with a covered resource.
        containerRegistry: ContainerRegistryMetadata
        -- The serverless function metadata associated with a covered resource.
        serverlessFunction: ServerlessFunctionMetadata
    end

    enum ScanMode
        "EC2_SSM_AGENT_BASED"
        "EC2_AGENTLESS"
        "EC2_INSPECTOR_AGENT_BASED"
        "VM_INSPECTOR_AGENT_BASED"
    end

    enum ScanType
        "NETWORK"
        "PACKAGE"
        "CODE"
    end

    -- An object that contains details about a resource covered by Amazon Inspector.
    record CoveredResource
        -- The type of the covered resource.
        resourceType: string
        -- The ID of the covered resource.
        resourceId: string
        -- The Amazon Web Services account ID of the covered resource.
        accountId: string
        -- The Amazon Inspector scan type covering the resource.
        scanType: string
        -- The status of the scan covering the resource.
        scanStatus: ScanStatus
        -- An object that contains details about the metadata.
        resourceMetadata: ResourceScanMetadata
        -- The date and time the resource was last checked for vulnerabilities.
        lastScannedAt: number
        -- The scan method that is applied to the instance.
        scanMode: string
        -- The cloud provider of the covered resource.
        provider: string
        -- The cloud provider account ID of the covered resource.
        providerAccountId: string
        -- The cloud provider organization ID of the covered resource.
        providerOrgId: string
        -- The cloud provider region of the covered resource.
        providerRegion: string
        -- The cloud provider partition of the covered resource.
        providerPartition: string
    end

    -- Creates CIS targets.
    record CreateCisTargets
        -- The CIS target account ids.
        accountIds: {string}
        -- The CIS target resource tags.
        targetResourceTags: {string : {string}}
    end

    record CreateCisScanConfigurationInput
        -- The scan name for the CIS scan configuration.
        scanName: string
        -- The security level for the CIS scan configuration. Security level refers to the
        -- Benchmark levels that CIS assigns to a profile.
        securityLevel: string
        -- The schedule for the CIS scan configuration.
        schedule: Schedule
        -- The targets for the CIS scan configuration.
        targets: CreateCisTargets
        -- The tags for the CIS scan configuration.
        tags: {string : string}
    end

    record CreateCisScanConfigurationOutput
        -- The scan configuration ARN for the CIS scan configuration.
        scanConfigurationArn: string
    end

    -- Contains details required to create an integration with a self-managed GitLab
    -- instance.
    record CreateGitLabSelfManagedIntegrationDetail
        -- The URL of the self-managed GitLab instance.
        instanceUrl: string
        -- The personal access token used to authenticate with the self-managed GitLab
        -- instance.
        accessToken: string
    end

    -- Contains details required to create a code security integration with a specific
    -- repository provider.
    record CreateIntegrationDetail
        -- Details specific to creating an integration with a self-managed GitLab instance.
        gitlabSelfManaged: CreateGitLabSelfManagedIntegrationDetail
    end

    record CreateCodeSecurityIntegrationInput
        -- The name of the code security integration.
        name: string
        -- The integration details specific to the repository provider type.
        details: CreateIntegrationDetail
        -- The tags to apply to the code security integration.
        tags: {string : string}
    end

    record CreateCodeSecurityIntegrationOutput
        -- The Amazon Resource Name (ARN) of the created code security integration.
        integrationArn: string
        -- The current status of the code security integration.
        status: string
        -- The URL used to authorize the integration with the repository provider.
        authorizationUrl: string
    end

    record CreateCodeSecurityScanConfigurationInput
        -- The name of the scan configuration.
        name: string
        -- The security level for the scan configuration.
        level: string
        -- The configuration settings for the code security scan.
        configuration: CodeSecurityScanConfiguration
