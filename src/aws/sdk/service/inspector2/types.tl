    -- A response that contains the results of a finding aggregation by image layer.
    record ImageLayerAggregationResponse
        -- The repository the layer resides in.
        repository: string
        -- The resource ID of the container image layer.
        resourceId: string
        -- The layer hash.
        layerHash: string
        -- The ID of the Amazon Web Services account that owns the container image hosting the layer
        -- image.
        accountId: string
        -- The cloud service provider associated with this image layer aggregation. Valid values:
        -- AWS – Findings from Amazon Web Services resources.
        -- AZURE – Findings from Microsoft Azure resources.
        cloudProvider: string
        -- The cloud account ID for the image layer aggregation.
        cloudAccountId: string
        -- The cloud organization ID for the image layer aggregation.
        cloudOrgId: string
        -- The cloud Region associated with this image layer aggregation. The value format depends on the cloud provider:
        -- An Amazon Web Services Region, such as us-east-1.
        -- An Azure region, such as eastus.
        cloudRegion: string
        -- The cloud infrastructure partition associated with this image layer aggregation. Valid values:
        -- aws – Amazon Web Services commercial Regions.
        -- aws-cn – Amazon Web Services China Regions.
        -- aws-us-gov – Amazon Web Services GovCloud (US) Regions.
        -- AzureCloud – Azure commercial Regions.
        cloudPartition: string
        -- An object that represents the count of matched findings per severity.
        severityCounts: SeverityCounts
    end

    -- A response that contains the results of an Amazon Web Services Lambda function finding
    -- aggregation.
    record LambdaFunctionAggregationResponse
        -- The resource IDs included in the aggregation results.
        resourceId: string
        -- The Amazon Web Services Lambda function names included in the aggregation results.
        functionName: string
        -- The runtimes included in the aggregation results.
        runtime: string
        -- The tags included in the aggregation results.
        lambdaTags: {string : string}
        -- The ID of the Amazon Web Services account that owns the Amazon Web Services Lambda
        -- function.
        accountId: string
        -- An object that contains the counts of aggregated finding per severity.
        severityCounts: SeverityCounts
        -- The date that the Amazon Web Services Lambda function included in the aggregation results
        -- was last changed.
        lastModifiedAt: number
    end

    -- A response that contains the results of an Amazon Web Services Lambda function layer
    -- finding aggregation.
    record LambdaLayerAggregationResponse
        -- The names of the Amazon Web Services Lambda functions associated with the layers.
        functionName: string
        -- The Resource ID of the Amazon Web Services Lambda function layer.
        resourceId: string
        -- The Amazon Resource Name (ARN) of the Amazon Web Services Lambda function layer.
        layerArn: string
        -- The account ID of the Amazon Web Services Lambda function layer.
        accountId: string
        -- An object that contains the counts of aggregated finding per severity.
        severityCounts: SeverityCounts
    end

    -- A response that contains the results of a finding aggregation by image layer.
    record PackageAggregationResponse
        -- The name of the operating system package.
        packageName: string
        -- The ID of the Amazon Web Services account associated with the findings.
        accountId: string
        -- An object that contains the count of matched findings per severity.
        severityCounts: SeverityCounts
    end

    -- A response that contains details on the results of a finding aggregation by
    -- repository.
    record RepositoryAggregationResponse
        -- The name of the repository associated with the findings.
        repository: string
        -- The ID of the Amazon Web Services account associated with the findings.
        accountId: string
        -- The cloud service provider associated with this repository aggregation. Valid values:
        -- AWS – Findings from Amazon Web Services resources.
        -- AZURE – Findings from Microsoft Azure resources.
        cloudProvider: string
        -- The cloud infrastructure partition associated with this repository aggregation. Valid values:
        -- aws – Amazon Web Services commercial Regions.
        -- aws-cn – Amazon Web Services China Regions.
        -- aws-us-gov – Amazon Web Services GovCloud (US) Regions.
        -- AzureCloud – Azure commercial Regions.
        cloudPartition: string
        -- The cloud Region associated with this repository aggregation. The value format depends on the cloud provider:
        -- An Amazon Web Services Region, such as us-east-1.
        -- An Azure region, such as eastus.
        cloudRegion: string
        -- The cloud organization ID for the repository aggregation.
        cloudOrgId: string
        -- The cloud account ID for the repository aggregation.
        cloudAccountId: string
        -- An object that represent the count of matched findings per severity.
        severityCounts: SeverityCounts
        -- The number of container images impacted by the findings.
        affectedImages: number
    end

    -- A response that contains the results of a serverless function aggregation.
    record ServerlessFunctionAggregationResponse
        -- The resource ID for the serverless function.
        resourceId: string
        -- The cloud service provider associated with this serverless function aggregation. Valid values:
        -- AWS – Findings from Amazon Web Services resources.
        -- AZURE – Findings from Microsoft Azure resources.
        cloudProvider: string
        -- The cloud account ID for the serverless function aggregation.
        cloudAccountId: string
        -- The cloud infrastructure partition associated with this serverless function aggregation. Valid values:
        -- aws – Amazon Web Services commercial Regions.
        -- aws-cn – Amazon Web Services China Regions.
        -- aws-us-gov – Amazon Web Services GovCloud (US) Regions.
        -- AzureCloud – Azure commercial Regions.
        cloudPartition: string
        -- The cloud Region associated with this serverless function aggregation. The value format depends on the cloud provider:
        -- An Amazon Web Services Region, such as us-east-1.
        -- An Azure region, such as eastus.
        cloudRegion: string
        -- The cloud organization ID for the serverless function aggregation.
        cloudOrgId: string
        -- The name of the serverless function.
        functionName: string
        -- The runtime of the serverless function.
        runtime: string
        -- The tags attached to the serverless function.
        tags: {string : string}
        -- The account ID associated with the serverless function.
        accountId: string
        severityCounts: SeverityCounts
        -- The date and time the serverless function was last modified.
        lastModifiedAt: number
        -- The number of active findings with an exploit available for the serverless function.
        exploitAvailableActiveFindingsCount: number
        -- The number of active findings with a fix available for the serverless function.
        fixAvailableActiveFindingsCount: number
    end

    -- A response that contains details on the results of a finding aggregation by
    -- title.
    record TitleAggregationResponse
        -- The title that the findings were aggregated on.
        title: string
        -- The vulnerability ID of the finding.
        vulnerabilityId: string
        -- The ID of the Amazon Web Services account associated with the findings.
        accountId: string
        -- An object that represent the count of matched findings per severity.
        severityCounts: SeverityCounts
    end

    -- A response that contains the results of a VM instance aggregation.
    record VmInstanceAggregationResponse
        -- The resource ID for the VM instance.
        resourceId: string
        -- The cloud service provider associated with this VM instance aggregation. Valid values:
        -- AWS – Findings from Amazon Web Services resources.
        -- AZURE – Findings from Microsoft Azure resources.
        cloudProvider: string
        -- The cloud account ID for the VM instance aggregation.
        cloudAccountId: string
        -- The cloud infrastructure partition associated with this VM instance aggregation. Valid values:
        -- aws – Amazon Web Services commercial Regions.
        -- aws-cn – Amazon Web Services China Regions.
        -- aws-us-gov – Amazon Web Services GovCloud (US) Regions.
        -- AzureCloud – Azure commercial Regions.
        cloudPartition: string
        -- The cloud Region associated with this VM instance aggregation. The value format depends on the cloud provider:
        -- An Amazon Web Services Region, such as us-east-1.
        -- An Azure region, such as eastus.
        cloudRegion: string
        -- The cloud organization ID for the VM instance aggregation.
        cloudOrgId: string
        -- The VM image reference for the VM instance.
        vmImageReference: string
        -- The operating system of the VM instance.
        operatingSystem: string
        -- The tags attached to the VM instance.
        tags: {string : string}
        -- The account ID associated with the VM instance.
        accountId: string
        severityCounts: SeverityCounts
        -- The number of network findings for the VM instance. This field applies only to Amazon Web Services resources.
        networkFindings: number
        -- The number of active findings with an exploit available for the VM instance.
        exploitAvailableActiveFindingsCount: number
        -- The number of active findings with a fix available for the VM instance.
        fixAvailableActiveFindingsCount: number
    end

    -- A structure that contains details about the results of an aggregation type.
    record AggregationResponse
        -- An object that contains details about an aggregation response based on Amazon Web Services account
        -- IDs.
        accountAggregation: AccountAggregationResponse
        -- An object that contains details about an aggregation response based on Amazon Machine
        -- Images (AMIs).
        amiAggregation: AmiAggregationResponse
        -- An object that contains details about an aggregation response based on Amazon ECR container
        -- images.
        awsEcrContainerAggregation: AwsEcrContainerAggregationResponse
        -- An object that contains details about an aggregation response based on Amazon EC2
        -- instances.
        ec2InstanceAggregation: Ec2InstanceAggregationResponse
        -- An object that contains details about an aggregation response based on finding
        -- types.
        findingTypeAggregation: FindingTypeAggregationResponse
        -- An object that contains details about an aggregation response based on container image
        -- layers.
        imageLayerAggregation: ImageLayerAggregationResponse
        -- An object that contains details about an aggregation response based on operating system
        -- package type.
        packageAggregation: PackageAggregationResponse
        -- An object that contains details about an aggregation response based on Amazon ECR
        -- repositories.
        repositoryAggregation: RepositoryAggregationResponse
        -- An object that contains details about an aggregation response based on finding
        -- title.
        titleAggregation: TitleAggregationResponse
        -- An aggregation of findings by Amazon Web Services Lambda layer.
        lambdaLayerAggregation: LambdaLayerAggregationResponse
        -- An aggregation of findings by Amazon Web Services Lambda function.
        lambdaFunctionAggregation: LambdaFunctionAggregationResponse
        -- An object that contains details about an aggregation response based on code
        -- repositories.
        codeRepositoryAggregation: CodeRepositoryAggregationResponse
        -- An object that contains details about an aggregation response based on VM instances.
        vmInstanceAggregation: VmInstanceAggregationResponse
        -- An object that contains details about an aggregation response based on container images.
        containerImageAggregation: ContainerImageAggregationResponse
        -- An object that contains details about an aggregation response based on serverless functions.
        serverlessFunctionAggregation: ServerlessFunctionAggregationResponse
    end

    enum AggregationType
        "FINDING_TYPE"
        "PACKAGE"
        "TITLE"
        "REPOSITORY"
        "AMI"
        "AWS_EC2_INSTANCE"
        "AWS_ECR_CONTAINER"
        "IMAGE_LAYER"
        "ACCOUNT"
        "AWS_LAMBDA_FUNCTION"
        "LAMBDA_LAYER"
        "CODE_REPOSITORY"
        "VM_INSTANCE"
        "CONTAINER_IMAGE"
        "SERVERLESS_FUNCTION"
    end

    enum Architecture
        "X86_64"
        "ARM64"
    end

    -- Identifies a specific resource in a code repository that will be scanned.
    record CodeSecurityResource
        -- The unique identifier of the project in the code repository.
        projectId: string
    end

    -- Contains details about a request to associate a code repository with a scan
    -- configuration.
    record AssociateConfigurationRequest
        -- The Amazon Resource Name (ARN) of the scan configuration.
        scanConfigurationArn: string
        resource: CodeSecurityResource
    end

    record AssociateMemberInput
        -- The Amazon Web Services account ID of the member account to be associated.
        accountId: string
    end

    record AssociateMemberOutput
        -- The Amazon Web Services account ID of the successfully associated member account.
        accountId: string
    end

    -- The request has failed due to an internal failure of the Amazon Inspector service.
    record InternalServerException
        message: string
        -- The number of seconds to wait before retrying the request.
        retryAfterSeconds: number
    end

    -- You have exceeded your service quota. To perform the requested action, remove some of
    -- the relevant resources, or use Service Quotas to request a service quota increase.
    record ServiceQuotaExceededException
        message: string
        -- The ID of the resource that exceeds a service quota.
        resourceId: string
    end

    -- The limit on the number of requests per second was exceeded.
    record ThrottlingException
        message: string
        -- The number of seconds to wait before retrying the request.
        retryAfterSeconds: number
    end

    -- An object that describes a validation exception.
    record ValidationExceptionField
        -- The name of the validation exception.
        name: string
        -- The validation exception message.
        message: string
    end

    enum ValidationExceptionReason
        "CANNOT_PARSE"
        "FIELD_VALIDATION_FAILED"
        "OTHER"
    end

    -- The request has failed validation due to missing required fields or having invalid
    -- inputs.
    record ValidationException
        message: string
        -- The reason for the validation failure.
        reason: string
        -- The fields that failed validation.
        fields: {ValidationExceptionField}
    end

    enum AssociationResultStatusCode
        "INTERNAL_ERROR"
        "ACCESS_DENIED"
        "SCAN_CONFIGURATION_NOT_FOUND"
        "INVALID_INPUT"
        "RESOURCE_NOT_FOUND"
        "QUOTA_EXCEEDED"
    end

    -- The Amazon Web Services Threat Intel Group (ATIG) details for a specific
    -- vulnerability.
    record AtigData
        -- The date and time this vulnerability was first observed.
        firstSeen: number
        -- The date and time this vulnerability was last observed.
        lastSeen: number
        -- The commercial sectors this vulnerability targets.
        targets: {string}
        -- The MITRE ATT&CK tactics, techniques,
        -- and procedures (TTPs) associated with vulnerability.
        ttps: {string}
    end

    -- Represents which scan types are automatically enabled for new members of your Amazon Inspector
    -- organization.
    record AutoEnable
        -- Represents whether Amazon EC2 scans are automatically enabled for new members of your Amazon Inspector
        -- organization.
        ec2: boolean
        -- Represents whether Amazon ECR scans are automatically enabled for new members of your Amazon Inspector
        -- organization.
        ecr: boolean
        -- Represents whether Amazon Web Services Lambda standard scans are automatically enabled
        -- for new members of your Amazon Inspector organization.
        lambda: boolean
        -- Represents whether Lambda code scans are automatically enabled for new members of your
        -- Amazon Inspector organization.
        lambdaCode: boolean
        -- Represents whether code repository scans are automatically enabled for new members of
        -- your Amazon Inspector organization.
        codeRepository: boolean
    end

    enum AwsConfigConnectorArnComparison
        "EQUALS"
    end

    -- A filter that matches connectors by the ARN of the associated Amazon Web Services Config connector.
    record AwsConfigConnectorArnFilter
        -- The comparison operator for the Amazon Web Services Config connector ARN filter.
        comparison: string
        -- The Amazon Web Services Config connector ARN value to filter by.
        value: string
    end

    -- Details of the Amazon EC2 instance involved in a finding.
    record AwsEc2InstanceDetails
        -- The image ID of the Amazon EC2 instance.
        imageId: string
        -- The IPv4 addresses of the Amazon EC2 instance.
        ipV4Addresses: {string}
        -- The IPv6 addresses of the Amazon EC2 instance.
        ipV6Addresses: {string}
        -- The name of the key pair used to launch the Amazon EC2 instance.
        keyName: string
        -- The IAM instance profile ARN of the Amazon EC2 instance.
        iamInstanceProfileArn: string
        -- The VPC ID of the Amazon EC2 instance.
        vpcId: string
        -- The subnet ID of the Amazon EC2 instance.
        subnetId: string
        -- The date and time the Amazon EC2 instance was launched at.
        launchedAt: number
        -- The platform of the Amazon EC2 instance.
        platform: string
    end

    -- The image details of the Amazon ECR container image.
    record AwsEcrContainerImageDetails
        -- The name of the repository the Amazon ECR container image resides in.
        repositoryName: string
        -- The image tags attached to the Amazon ECR container image.
        imageTags: {string}
        -- The date and time the Amazon ECR container image was pushed.
        pushedAt: number
        -- The image author of the Amazon ECR container image.
        author: string
        -- The architecture of the Amazon ECR container image.
        architecture: string
        -- The image hash of the Amazon ECR container image.
        imageHash: string
        -- The registry for the Amazon ECR container image.
        registry: string
        -- The platform of the Amazon ECR container image.
        platform: string
        -- The last time an Amazon ECR image was used in an Amazon ECS task or
        -- Amazon EKS pod.
        lastInUseAt: number
        -- The number of Amazon ECS tasks or Amazon EKS pods where the Amazon ECR container image is in use.
        inUseCount: number
    end

    -- Metadata about tasks where an image was in use.
    record AwsEcsMetadataDetails
        -- The details group information for a task in a cluster.
        detailsGroup: string
        -- The task definition ARN.
        taskDefinitionArn: string
    end

    -- Information about the workload.
    record AwsEksWorkloadInfo
        -- The name of the workload.
        name: string
    end

    -- The metadata for an Amazon EKS pod where an Amazon ECR image is in
    -- use.
    record AwsEksMetadataDetails
        -- The namespace for an Amazon EKS cluster.
        namespace: string
        -- The list of workloads.
        workloadInfoList: {AwsEksWorkloadInfo}
    end

    enum PackageType
        "IMAGE"
        "ZIP"
    end

    enum Runtime
        "NODEJS"
        "NODEJS_12_X"
        "NODEJS_14_X"
        "NODEJS_16_X"
        "JAVA_8"
        "JAVA_8_AL2"
        "JAVA_11"
        "PYTHON_3_7"
        "PYTHON_3_8"
        "PYTHON_3_9"
        "UNSUPPORTED"
        "NODEJS_18_X"
        "GO_1_X"
        "JAVA_17"
        "PYTHON_3_10"
        "PYTHON_3_11"
        "DOTNETCORE_3_1"
        "DOTNET_6"
        "DOTNET_7"
        "RUBY_2_7"
        "RUBY_3_2"
        "DOTNET_10"
        "NODEJS_24_X"
        "NODEJS_22_X"
        "JAVA_21"
        "JAVA_25"
    end

    -- The VPC security groups and subnets that are attached to an Amazon Web Services Lambda
    -- function. For more information, see VPC Settings.
    record LambdaVpcConfig
        -- A list of VPC subnet IDs.
        subnetIds: {string}
        -- The VPC security groups and subnets that are attached to an Amazon Web Services Lambda
        -- function. For more information, see VPC Settings.
        securityGroupIds: {string}
        -- The ID of the VPC.
        vpcId: string
    end

    -- A summary of information about the Amazon Web Services Lambda function.
    record AwsLambdaFunctionDetails
        -- The name of the Amazon Web Services Lambda function.
        functionName: string
        -- The runtime environment for the Amazon Web Services Lambda function.
        runtime: string
        -- The SHA256 hash of the Amazon Web Services Lambda function's deployment package.
        codeSha256: string
        -- The version of the Amazon Web Services Lambda function.
        version: string
        -- The Amazon Web Services Lambda function's execution role.
        executionRoleArn: string
        -- The Amazon Web Services Lambda function's layers. A
        -- Lambda function can have up to five layers.
        layers: {string}
        -- The Amazon Web Services Lambda function's networking configuration.
        vpcConfig: LambdaVpcConfig
        -- The type of deployment package. Set to Image for container image and set
        -- Zip for .zip file archive.
        packageType: string
        -- The instruction set architecture that the Amazon Web Services Lambda function supports.
        -- Architecture is a string array with one of the valid values. The default architecture value
        -- is x86_64.
        architectures: {string}
        -- The date and time that a user last updated the configuration, in ISO 8601
        -- format
        lastModifiedAt: number
    end

    enum ScopeType
        "TENANT"
        "SUBSCRIPTION"
    end

    -- The scope of resources to scan for a single scanning type. Provide this as part of an AzureScopeConfigurationInput when you create or update a connector.
    record ScopeConfigurationInput
        -- The type of scope. Valid values are TENANT, which scans all resources in the Azure tenant, and SUBSCRIPTION, which scans only the resources in the specified Azure subscriptions.
        scopeType: string
        -- The list of scope values. For subscription-level scope, these are Azure subscription IDs.
        scopeValues: {string}
    end

    -- The scope of Azure resources to scan, defined separately for VM, container image, and serverless scanning. Provide this when you create or update an Azure connector.
    record AzureScopeConfigurationInput
        -- The scope configuration input for VM scanning.
        vmScanning: ScopeConfigurationInput
        -- The scope configuration input for container image scanning.
        containerImageScanning: ScopeConfigurationInput
        -- The scope configuration input for serverless scanning.
        serverlessScanning: ScopeConfigurationInput
    end

    -- The Azure-specific configuration details for creating a connector, including the Amazon Web Services Config connector association, scan scope, and regions to scan.
    record AzureProviderDetailCreate
        -- The ARN of the Amazon Web Services Config connector to associate with this connector.
        awsConfigConnectorArn: string
        -- The scope configuration that defines which Azure resources to scan.
        scopeConfiguration: AzureScopeConfigurationInput
        -- The Azure regions to scan.
        azureRegions: {string}
        -- Specifies whether to automatically install the VM scanner on connected Azure resources. Defaults to true.
        autoInstallVMScanner: boolean
    end

    -- The Azure-specific configuration details for updating a connector, including the scan scope and regions to scan.
    record AzureProviderDetailUpdate
        -- The updated Azure regions to scan.
        azureRegions: {string}
        -- The updated scope configuration that defines which Azure resources to scan.
        scopeConfiguration: AzureScopeConfigurationInput
        -- Specifies whether to automatically install the VM scanner on connected Azure resources.
        autoInstallVMScanner: boolean
    end

    enum ScopeState
        "ACTIVE"
        "PENDING"
        "ERROR"
        "DISABLED"
    end

    -- The scope of resources that Amazon Inspector scans for a single scanning type, including the scope level, the targeted resources, and the current state.
    record ScopeConfiguration
        -- The type of scope. Valid values are TENANT, which scans all resources in the Azure tenant, and SUBSCRIPTION, which scans only the resources in the specified Azure subscriptions.
        scopeType: string
        -- The list of scope values. For subscription-level scope, these are Azure subscription IDs.
        scopeValues: {string}
        -- The current state of the scope configuration.
        state: string
        -- The reason for the current state of the scope configuration.
        stateReason: string
    end

    -- The scope of Azure resources that Amazon Inspector scans, defined separately for VM, container image, and serverless scanning. Returned as part of a connector's configuration.
    record AzureScopeConfiguration
        -- The scope configuration for VM scanning.
        vmScanning: ScopeConfiguration
        -- The scope configuration for container image scanning.
        containerImageScanning: ScopeConfiguration
        -- The scope configuration for serverless scanning.
        serverlessScanning: ScopeConfiguration
    end

    -- One or more tags submitted as part of the request is not valid.
    record BadRequestException
        message: string
    end

    record BatchAssociateCodeSecurityScanConfigurationInput
        -- A list of code repositories to associate with the specified scan configuration.
        associateConfigurationRequests: {AssociateConfigurationRequest}
    end

    -- Details about a failed attempt to associate or disassociate a code repository with a
    -- scan configuration.
    record FailedAssociationResult
        -- The Amazon Resource Name (ARN) of the scan configuration that failed to be associated or
        -- disassociated.
        scanConfigurationArn: string
        resource: CodeSecurityResource
        -- The status code indicating why the association or disassociation failed.
        statusCode: string
        -- A message explaining why the association or disassociation failed.
        statusMessage: string
    end

    -- Details about a successful association or disassociation between a code repository and a
    -- scan configuration.
    record SuccessfulAssociationResult
        -- The Amazon Resource Name (ARN) of the scan configuration that was successfully
        -- associated or disassociated.
        scanConfigurationArn: string
        resource: CodeSecurityResource
    end

    record BatchAssociateCodeSecurityScanConfigurationOutput
        -- Details of any code repositories that failed to be associated with the scan
        -- configuration.
        failedAssociations: {FailedAssociationResult}
        -- Details of code repositories that were successfully associated with the scan
        -- configuration.
        successfulAssociations: {SuccessfulAssociationResult}
    end

    -- A conflict occurred. This exception occurs when the same resource is being modified by
    -- concurrent requests.
    record ConflictException
        message: string
        -- The ID of the conflicting resource.
        resourceId: string
        -- The type of the conflicting resource.
        resourceType: string
    end

    -- The operation tried to access an invalid resource. Make sure the resource is specified
    -- correctly.
    record ResourceNotFoundException
        message: string
    end

    -- Contains details about a request to disassociate a code repository from a scan
    -- configuration.
    record DisassociateConfigurationRequest
        -- The Amazon Resource Name (ARN) of the scan configuration to disassociate from a code
        -- repository.
        scanConfigurationArn: string
        resource: CodeSecurityResource
    end

    record BatchDisassociateCodeSecurityScanConfigurationInput
        -- A list of code repositories to disassociate from the specified scan
        -- configuration.
        disassociateConfigurationRequests: {DisassociateConfigurationRequest}
    end

    record BatchDisassociateCodeSecurityScanConfigurationOutput
        -- Details of any code repositories that failed to be disassociated from the scan
        -- configuration.
        failedAssociations: {FailedAssociationResult}
        -- Details of code repositories that were successfully disassociated from the scan
        -- configuration.
        successfulAssociations: {SuccessfulAssociationResult}
    end

    record BatchGetAccountStatusInput
        -- The 12-digit Amazon Web Services account IDs of the accounts to retrieve Amazon Inspector status for.
        accountIds: {string}
    end

    -- An object with details on why an account failed to enable Amazon Inspector.
    record FailedAccount
        -- The Amazon Web Services account ID.
        accountId: string
        -- The status of Amazon Inspector for the account.
        status: string
        -- An object detailing which resources Amazon Inspector is enabled to scan for the account.
        resourceStatus: ResourceStatus
        -- The error code explaining why the account failed to enable Amazon Inspector.
        errorCode: string
        -- The error message received when the account failed to enable Amazon Inspector.
        errorMessage: string
    end

    record BatchGetAccountStatusOutput
        -- An array of objects that provide details on the status of Amazon Inspector for each of the
        -- requested accounts.
        accounts: {AccountState}
        -- An array of objects detailing any accounts that failed to enable Amazon Inspector and why.
        failedAccounts: {FailedAccount}
    end

    record BatchGetCodeSnippetInput
        -- An array of finding ARNs for the findings you want to retrieve code snippets
        -- from.
        findingArns: {string}
    end

    -- Contains information on the lines of code associated with a code snippet.
    record CodeLine
        -- The content of a line of code
        content: string
        -- The line number that a section of code is located at.
        lineNumber: number
    end

    -- A suggested fix for a vulnerability in your Lambda function code.
    record SuggestedFix
        -- The fix's description.
        description: string
        -- The fix's code.
        code: string
    end

    -- Contains information on a code snippet retrieved by Amazon Inspector from a code vulnerability
    -- finding.
    record CodeSnippetResult
        -- The ARN of a finding that the code snippet is associated with.
        findingArn: string
        -- The line number of the first line of a code snippet.
        startLine: number
        -- The line number of the last line of a code snippet.
        endLine: number
        -- Contains information on the retrieved code snippet.
        codeSnippet: {CodeLine}
        -- Details of a suggested code fix.
        suggestedFixes: {SuggestedFix}
    end

    enum CodeSnippetErrorCode
        "INTERNAL_ERROR"
        "ACCESS_DENIED"
        "CODE_SNIPPET_NOT_FOUND"
        "INVALID_INPUT"
    end

    -- Contains information about any errors encountered while trying to retrieve a code
    -- snippet.
    record CodeSnippetError
        -- The ARN of the finding that a code snippet couldn't be retrieved for.
        findingArn: string
        -- The error code for the error that prevented a code snippet from being retrieved.
        errorCode: string
        -- The error message received when Amazon Inspector failed to retrieve a code snippet.
        errorMessage: string
    end

    record BatchGetCodeSnippetOutput
        -- The retrieved code snippets associated with the provided finding ARNs.
        codeSnippetResults: {CodeSnippetResult}
        -- Any errors Amazon Inspector encountered while trying to retrieve the requested code
        -- snippets.
        errors: {CodeSnippetError}
    end

    record BatchGetFindingDetailsInput
        -- A list of finding ARNs.
        findingArns: {string}
    end

    enum FindingDetailsErrorCode
        "INTERNAL_ERROR"
        "ACCESS_DENIED"
        "FINDING_DETAILS_NOT_FOUND"
        "INVALID_INPUT"
    end

    -- Details about an error encountered when trying to return vulnerability data for a
    -- finding.
    record FindingDetailsError
        -- The finding ARN that returned an error.
        findingArn: string
        -- The error code.
        errorCode: string
        -- The error message.
        errorMessage: string
    end

    -- The Cybersecurity and Infrastructure Security Agency (CISA) details for a specific
    -- vulnerability.
    record CisaData
        -- The date and time CISA added this vulnerability to their catalogue.
        dateAdded: number
        -- The date and time CISA expects a fix to have been provided vulnerability.
        dateDue: number
        -- The remediation action recommended by CISA for this vulnerability.
        action: string
    end

    -- Details of the evidence for a vulnerability identified in a finding.
    record Evidence
        -- The evidence rule.
        evidenceRule: string
        -- The evidence details.
        evidenceDetail: string
        -- The evidence severity.
        severity: string
    end

    -- Contains information on when this exploit was observed.
    record ExploitObserved
        -- The date an time when the exploit was last seen.
        lastSeen: number
        -- The date an time when the exploit was first seen.
        firstSeen: number
    end

    -- Details of the vulnerability identified in a finding.
    record FindingDetail
        -- The finding ARN that the vulnerability details are associated with.
        findingArn: string
        -- The Cybersecurity and Infrastructure Security Agency (CISA) details for a specific
        -- vulnerability.
        cisaData: CisaData
        -- The risk score of the vulnerability.
        riskScore: number
        -- Information on the evidence of the vulnerability.
        evidences: {Evidence}
        -- The MITRE adversary tactics, techniques, or procedures (TTPs) associated with the
        -- vulnerability.
        ttps: {string}
        -- The known malware tools or kits that can exploit the vulnerability.
        tools: {string}
        -- Contains information on when this exploit was observed.
        exploitObserved: ExploitObserved
        -- The reference URLs for the vulnerability data.
        referenceUrls: {string}
        -- The Common Weakness Enumerations (CWEs) associated with the vulnerability.
        cwes: {string}
        -- The Exploit Prediction Scoring System (EPSS) score of the vulnerability.
        epssScore: number
    end

    record BatchGetFindingDetailsOutput
        -- A finding's vulnerability details.
        findingDetails: {FindingDetail}
        -- Error information for findings that details could not be returned for.
        errors: {FindingDetailsError}
    end

