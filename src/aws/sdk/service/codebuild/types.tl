        buildsDeleted: {string}
        -- An array of BuildNotDeleted objects that specify the builds that could not be
        -- deleted.
        buildsNotDeleted: {BuildNotDeleted}
    end

    record DeleteFleetInput
        -- The ARN of the compute fleet.
        arn: string
    end

    record DeleteFleetOutput
    end

    record DeleteProjectInput
        -- The name of the build project.
        name: string
    end

    record DeleteProjectOutput
    end

    record DeleteReportInput
        -- The ARN of the report to delete.
        arn: string
    end

    record DeleteReportOutput
    end

    record DeleteReportGroupInput
        -- The ARN of the report group to delete.
        arn: string
        -- If true, deletes any reports that belong to a report group before deleting
        -- the report group.
        -- If false, you must delete any reports in the report group. Use ListReportsForReportGroup to get the reports in a report group. Use DeleteReport to delete the reports. If you call
        -- DeleteReportGroup for a report group that contains one or more reports,
        -- an exception is thrown.
        deleteReports: boolean
    end

    record DeleteReportGroupOutput
    end

    record DeleteResourcePolicyInput
        -- The ARN of the resource that is associated with the resource policy.
        resourceArn: string
    end

    record DeleteResourcePolicyOutput
    end

    record DeleteSourceCredentialsInput
        -- The Amazon Resource Name (ARN) of the token.
        arn: string
    end

    record DeleteSourceCredentialsOutput
        -- The Amazon Resource Name (ARN) of the token.
        arn: string
    end

    record DeleteWebhookInput
        -- The name of the CodeBuild project.
        projectName: string
    end

    record DeleteWebhookOutput
    end

    enum ReportCodeCoverageSortByType
        "LINE_COVERAGE_PERCENTAGE"
        "FILE_PATH"
    end

    enum SortOrderType
        "ASCENDING"
        "DESCENDING"
    end

    record DescribeCodeCoveragesInput
        -- The ARN of the report for which test cases are returned.
        reportArn: string
        -- The nextToken value returned from a previous call to
        -- DescribeCodeCoverages. This specifies the next item to return. To
        -- return the beginning of the list, exclude this parameter.
        nextToken: string
        -- The maximum number of results to return.
        maxResults: number
        -- Specifies if the results are sorted in ascending or descending order.
        sortOrder: string
        -- Specifies how the results are sorted. Possible values are:
        -- FILE_PATH
        -- The results are sorted by file path.
        -- LINE_COVERAGE_PERCENTAGE
        -- The results are sorted by the percentage of lines that are covered.
        sortBy: string
        -- The minimum line coverage percentage to report.
        minLineCoveragePercentage: number
        -- The maximum line coverage percentage to report.
        maxLineCoveragePercentage: number
    end

    -- Contains code coverage report information.
    -- Line coverage measures how many statements your tests cover. A statement is a single
    -- instruction, not including comments, conditionals, etc.
    -- Branch coverage determines if your tests cover every possible branch of a control
    -- structure, such as an if or case statement.
    record CodeCoverage
        -- The identifier of the code coverage report.
        id: string
        -- The ARN of the report.
        reportARN: string
        -- The path of the test report file.
        filePath: string
        -- The percentage of lines that are covered by your tests.
        lineCoveragePercentage: number
        -- The number of lines that are covered by your tests.
        linesCovered: number
        -- The number of lines that are not covered by your tests.
        linesMissed: number
        -- The percentage of branches that are covered by your tests.
        branchCoveragePercentage: number
        -- The number of conditional branches that are covered by your tests.
        branchesCovered: number
        -- The number of conditional branches that are not covered by your tests.
        branchesMissed: number
        -- The date and time that the tests were run.
        expired: number
    end

    record DescribeCodeCoveragesOutput
        -- If there are more items to return, this contains a token that is passed to a subsequent
        -- call to DescribeCodeCoverages to retrieve the next set of items.
        nextToken: string
        -- An array of CodeCoverage objects that contain the results.
