        -- The custom script to run tests on the source and target environments.
        workflowStepAutomationConfiguration: WorkflowStepAutomationConfiguration
        -- The servers on which a step will be run.
        stepTarget: {string}
        -- The outputs of a step.
        outputs: {WorkflowStepOutput}
        -- The previous step.
        previous: {string}
        -- The next step.
        next: {string}
        -- The status of the step.
        status: string
    end

    record UpdateWorkflowStepOutput
        -- The ID of the step.
        id: string
        -- The ID of the step group.
        stepGroupId: string
        -- The ID of the migration workflow.
        workflowId: string
        -- The name of the step.
        name: string
    end

    record CreateWorkflowStepGroupInput
        -- The ID of the migration workflow that will contain the step group.
        workflowId: string
        -- The name of the step group.
        name: string
        -- The description of the step group.
        description: string
        -- The next step group.
        next: {string}
        -- The previous step group.
        previous: {string}
    end

    record CreateWorkflowStepGroupOutput
        -- The ID of the migration workflow that contains the step group.
        workflowId: string
        -- The name of the step group.
        name: string
        -- The ID of the step group.
        id: string
        -- The description of the step group.
        description: string
        -- List of AWS services utilized in a migration workflow.
        tools: {Tool}
        -- The next step group.
        next: {string}
        -- The previous step group.
        previous: {string}
        -- The time at which the step group is created.
        creationTime: number
    end

    record DeleteWorkflowStepGroupInput
        -- The ID of the migration workflow.
        workflowId: string
        -- The ID of the step group you want to delete.
        id: string
    end

    record DeleteWorkflowStepGroupOutput
    end

    record GetWorkflowStepGroupInput
        -- The ID of the step group.
        id: string
        -- The ID of the migration workflow.
        workflowId: string
    end

    record GetWorkflowStepGroupOutput
        -- The ID of the step group.
        id: string
        -- The ID of the migration workflow.
        workflowId: string
        -- The name of the step group.
        name: string
        -- The description of the step group.
        description: string
        -- The status of the step group.
        status: string
        -- The owner of the step group.
        owner: string
        -- The time at which the step group was created.
        creationTime: number
        -- The time at which the step group was last modified.
        lastModifiedTime: number
        -- The time at which the step group ended.
        endTime: number
        -- List of AWS services utilized in a migration workflow.
        tools: {Tool}
        -- The previous step group.
        previous: {string}
        -- The next step group.
        next: {string}
    end

    record ListWorkflowStepGroupsInput
        -- The pagination token.
        nextToken: string
        -- The maximum number of results that can be returned.
        maxResults: number
        -- The ID of the migration workflow.
        workflowId: string
    end

    -- The summary of a step group in a workflow.
    record WorkflowStepGroupSummary
        -- The ID of the step group.
        id: string
        -- The name of the step group.
        name: string
        -- The owner of the step group.
        owner: string
        -- The status of the step group.
        status: string
        -- The previous step group.
        previous: {string}
        -- The next step group.
        next: {string}
    end

    record ListWorkflowStepGroupsOutput
        -- The pagination token.
        nextToken: string
        -- The summary of step groups in a migration workflow.
        workflowStepGroupsSummary: {WorkflowStepGroupSummary}
    end

    record UpdateWorkflowStepGroupInput
        -- The ID of the migration workflow.
        workflowId: string
        -- The ID of the step group.
        id: string
        -- The name of the step group.
        name: string
        -- The description of the step group.
        description: string
        -- The next step group.
        next: {string}
        -- The previous step group.
        previous: {string}
    end

    record UpdateWorkflowStepGroupOutput
        -- The ID of the migration workflow.
        workflowId: string
        -- The name of the step group.
        name: string
        -- The ID of the step group.
        id: string
        -- The description of the step group.
        description: string
        -- List of AWS services utilized in a migration workflow.
        tools: {Tool}
        -- The next step group.
        next: {string}
        -- The previous step group.
        previous: {string}
        -- The time at which the step group was last modified.
        lastModifiedTime: number
    end

end

return M
