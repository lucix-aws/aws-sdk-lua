    record ResourceDetails
        -- Instance ARN that was scanned in the scan entry.
        InstanceArn: string
    end

    enum ScanResult
        "CLEAN"
        "INFECTED"
    end

    -- Represents the result of the scan.
    record ScanResultDetails
        -- An enum value representing possible scan results.
        ScanResult: string
    end

    enum ScanStatus
        "RUNNING"
        "COMPLETED"
        "FAILED"
        "SKIPPED"
    end

    enum ScanType
        "GUARDDUTY_INITIATED"
        "ON_DEMAND"
    end

    enum TriggerType
        "BACKUP"
        "GUARDDUTY"
    end

    -- Represents the reason the scan was triggered.
    record TriggerDetails
        -- The ID of the GuardDuty finding that triggered the malware scan.
        GuardDutyFindingId: string
        -- The description of the scan trigger.
        Description: string
        -- Specifies the trigger type that started the malware scan.
        TriggerType: string
    end

    -- Contains information about malware scans associated with GuardDuty Malware Protection for EC2.
    record Scan
        -- The unique ID of the detector that is associated with the request. To find the detectorId in the current Region, see the Settings page in the GuardDuty console, or run the ListDetectors API.
        DetectorId: string
        -- The unique detector ID of the administrator account that the request is associated with. If the account is an administrator, the AdminDetectorId will be the same as the one used for DetectorId. To find the detectorId in the current Region, see the Settings page in the GuardDuty console, or run the ListDetectors API.
        AdminDetectorId: string
        -- The unique scan ID associated with a scan entry.
        ScanId: string
        -- An enum value representing possible scan statuses.
        ScanStatus: string
        -- Represents the reason for FAILED scan status.
        FailureReason: string
        -- The timestamp of when the scan was triggered.
        ScanStartTime: number
        -- The timestamp of when the scan was finished.
        ScanEndTime: number
        -- Specifies the reason why the scan was initiated.
        TriggerDetails: TriggerDetails
        -- Represents the resources that were scanned in the scan entry.
        ResourceDetails: ResourceDetails
        -- Represents the result of the scan.
        ScanResultDetails: ScanResultDetails
        -- The ID for the account that belongs to the scan.
        AccountId: string
        -- Represents total bytes that were scanned.
        TotalBytes: number
        -- Represents the number of files that were scanned.
        FileCount: number
        -- List of volumes that were attached to the original instance to be scanned.
        AttachedVolumes: {VolumeDetail}
        -- Specifies the scan type that invoked the malware scan.
        ScanType: string
    end

