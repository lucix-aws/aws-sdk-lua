    record CreateFilterOutput
        -- The name of the successfully created filter.
        Name: string
    end

    record CreateInvestigationInput
        -- The unique ID of the GuardDuty detector for the account in which the investigation is created. To find the detectorId in the current Region, see the Settings page in the GuardDuty console, or run the ListDetectors API.
        DetectorId: string
        -- A natural-language description of what to investigate. For example: "Investigate finding 1ab2c3d4e5f6a7b8c9d0e1f2a3b4c5d6 in account 123456789012" "Analyze findings in account with id 123456789012" "Analyze findings in my organization"
        TriggerPrompt: string
        -- The idempotency token for the create request.
        ClientToken: string
    end

    record CreateInvestigationOutput
        -- The unique identifier of the newly created investigation.
        InvestigationId: string
    end

    enum IpSetFormat
        "TXT"
        "STIX"
        "OTX_CSV"
        "ALIEN_VAULT"
        "PROOF_POINT"
        "FIRE_EYE"
    end

    record CreateIPSetInput
        -- The unique ID of the detector of the GuardDuty account for which you want to create an IPSet. To find the detectorId in the current Region, see the Settings page in the GuardDuty console, or run the ListDetectors API.
        DetectorId: string
        -- The user-friendly name to identify the IPSet. Allowed characters are alphanumeric, whitespace, dash (-), and underscores (_).
        Name: string
        -- The format of the file that contains the IPSet.
        Format: string
        -- The URI of the file that contains the IPSet.
        Location: string
        -- A Boolean value that indicates whether GuardDuty is to start using the uploaded IPSet.
        Activate: boolean
        -- The idempotency token for the create request.
        ClientToken: string
        -- The tags to be added to a new IP set resource.
        Tags: {string : string}
        -- The Amazon Web Services account ID that owns the Amazon S3 bucket specified in the location parameter.
        ExpectedBucketOwner: string
    end

    record CreateIPSetOutput
        -- The ID of the IPSet resource.
        IpSetId: string
    end

    enum MalwareProtectionPlanTaggingActionStatus
        "ENABLED"
        "DISABLED"
    end

    -- Information about adding tags to the scanned S3 object after the scan result.
    record MalwareProtectionPlanTaggingAction
        -- Indicates whether or not the tags will added.
        Status: string
    end

    -- Information about whether the tags will be added to the S3 object after scanning.
    record MalwareProtectionPlanActions
        -- Indicates whether the scanned S3 object will have tags about the scan result.
        Tagging: MalwareProtectionPlanTaggingAction
    end

    -- Information about the protected S3 bucket resource.
    record CreateS3BucketResource
        -- Name of the S3 bucket.
        BucketName: string
        -- Information about the specified object prefixes. The S3 object will be scanned only if it belongs to any of the specified object prefixes.
        ObjectPrefixes: {string}
    end

    -- Information about the protected resource that is associated with the created Malware Protection plan. Presently, S3Bucket is the only supported protected resource.
    record CreateProtectedResource
        -- Information about the protected S3 bucket resource.
        S3Bucket: CreateS3BucketResource
    end

    record CreateMalwareProtectionPlanInput
        -- The idempotency token for the create request.
        ClientToken: string
        -- Amazon Resource Name (ARN) of the IAM role that has the permissions to scan and add tags to the associated protected resource.
        Role: string
        -- Information about the protected resource that is associated with the created Malware Protection plan. Presently, S3Bucket is the only supported protected resource.
        ProtectedResource: CreateProtectedResource
        -- Information about whether the tags will be added to the S3 object after scanning.
        Actions: MalwareProtectionPlanActions
        -- Tags added to the Malware Protection plan resource.
        Tags: {string : string}
    end

    record CreateMalwareProtectionPlanOutput
        -- A unique identifier associated with the Malware Protection plan resource.
        MalwareProtectionPlanId: string
