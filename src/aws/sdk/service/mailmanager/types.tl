    -- The request to initiate an export of emails from an archive.
    record StartArchiveExportInput
        -- The identifier of the archive to export emails from.
        ArchiveId: string
        -- Criteria to filter which emails are included in the export.
        Filters: ArchiveFilters
        -- The start of the timestamp range to include emails from.
        FromTimestamp: number
        -- The end of the timestamp range to include emails from.
        ToTimestamp: number
        -- The maximum number of email items to include in the export.
        MaxResults: number
        -- Details on where to deliver the exported email data.
        ExportDestinationConfiguration: ExportDestinationConfiguration
        -- Whether to include message metadata as JSON files in the export.
        IncludeMetadata: boolean
    end

    -- The response from initiating an archive export.
    record StartArchiveExportOutput
        -- The unique identifier for the initiated export job.
        ExportId: string
    end

    -- The request to initiate a search across emails in an archive.
    record StartArchiveSearchInput
        -- The identifier of the archive to search emails in.
        ArchiveId: string
        -- Criteria to filter which emails are included in the search results.
        Filters: ArchiveFilters
        -- The start timestamp of the range to search emails from.
        FromTimestamp: number
        -- The end timestamp of the range to search emails from.
        ToTimestamp: number
        -- The maximum number of search results to return.
        MaxResults: number
    end

    -- The response from initiating an archive search.
    record StartArchiveSearchOutput
        -- The unique identifier for the initiated search job.
        SearchId: string
    end

