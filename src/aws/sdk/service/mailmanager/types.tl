        "ACTIVE"
        "CLOSED"
        "FAILED"
        "ASSOCIATED_VPC_ENDPOINT_DOES_NOT_EXIST"
    end

    record GetIngressPointOutput
        -- The identifier of an ingress endpoint resource.
        IngressPointId: string
        -- A user friendly name for the ingress endpoint.
        IngressPointName: string
        -- The Amazon Resource Name (ARN) of the ingress endpoint resource.
        IngressPointArn: string
        -- The status of the ingress endpoint resource.
        Status: string
        -- The type of ingress endpoint.
        Type: string
        -- The DNS A Record that identifies your ingress endpoint. Configure your DNS Mail Exchange (MX) record with this value to route emails to Mail Manager.
        ARecord: string
        -- The identifier of a rule set resource associated with the ingress endpoint.
        RuleSetId: string
        -- The identifier of the traffic policy resource associated with the ingress endpoint.
        TrafficPolicyId: string
        -- The authentication configuration of the ingress endpoint resource.
        IngressPointAuthConfiguration: IngressPointAuthConfiguration
        -- The network configuration for the ingress point.
        NetworkConfiguration: NetworkConfiguration
        -- The selected Transport Layer Security (TLS) policy of the ingress point.
        TlsPolicy: string
        -- The timestamp of when the ingress endpoint was created.
        CreatedTimestamp: number
        -- The timestamp of when the ingress endpoint was last updated.
        LastUpdatedTimestamp: number
    end

    record GetMemberOfAddressListInput
        -- The unique identifier of the address list to retrieve the address from.
        AddressListId: string
        -- The address to be retrieved from the address list.
        Address: string
    end

    record GetMemberOfAddressListOutput
        -- The address retrieved from the address list.
        Address: string
        -- The timestamp of when the address was created.
        CreatedTimestamp: number
    end

    record GetRelayInput
        -- A unique relay identifier.
        RelayId: string
    end

    record GetRelayOutput
        -- The unique relay identifier.
        RelayId: string
        -- The Amazon Resource Name (ARN) of the relay.
        RelayArn: string
        -- The unique name of the relay.
        RelayName: string
        -- The destination relay server address.
        ServerName: string
        -- The destination relay server port.
        ServerPort: number
        -- The authentication attribute—contains the secret ARN where the customer relay server credentials are stored.
        Authentication: RelayAuthentication
        -- The timestamp of when the relay was created.
        CreatedTimestamp: number
        -- The timestamp of when relay was last updated.
        LastModifiedTimestamp: number
    end

    record GetRuleSetInput
        -- The identifier of an existing rule set to be retrieved.
        RuleSetId: string
    end

    record GetRuleSetOutput
        -- The identifier of the rule set resource.
        RuleSetId: string
        -- The Amazon Resource Name (ARN) of the rule set resource.
        RuleSetArn: string
        -- A user-friendly name for the rule set resource.
        RuleSetName: string
        -- The date of when then rule set was created.
        CreatedDate: number
        -- The date of when the rule set was last modified.
        LastModificationDate: number
        -- The rules contained in the rule set.
        Rules: {Rule}
    end

    record GetTrafficPolicyInput
        -- The identifier of the traffic policy resource.
        TrafficPolicyId: string
    end

    record GetTrafficPolicyOutput
        -- A user-friendly name for the traffic policy resource.
        TrafficPolicyName: string
        -- The identifier of the traffic policy resource.
        TrafficPolicyId: string
        -- The Amazon Resource Name (ARN) of the traffic policy resource.
        TrafficPolicyArn: string
        -- The list of conditions which are in the traffic policy resource.
        PolicyStatements: {PolicyStatement}
        -- The maximum message size in bytes of email which is allowed in by this traffic policy—anything larger will be blocked.
        MaxMessageSizeBytes: number
        -- The default action of the traffic policy.
        DefaultAction: string
        -- The timestamp of when the traffic policy was created.
        CreatedTimestamp: number
        -- The timestamp of when the traffic policy was last updated.
        LastUpdatedTimestamp: number
    end

    -- Details about an import job.
    record ImportJob
        -- The identifier of the import job.
        JobId: string
        -- A user-friendly name for the import job.
        Name: string
        -- The status of the import job.
        Status: string
        -- The pre-signed URL target for uploading the input file.
        PreSignedUrl: string
        -- The number of addresses in the input that were successfully imported into the address list.
        ImportedItemsCount: number
        -- The number of addresses in the input that failed to get imported into address list.
        FailedItemsCount: number
        -- The format of the input for the import job.
        ImportDataFormat: ImportDataFormat
        -- The unique identifier of the address list the import job was created for.
        AddressListId: string
        -- The timestamp of when the import job was created.
        CreatedTimestamp: number
        -- The timestamp of when the import job was started.
        StartTimestamp: number
        -- The timestamp of when the import job was completed.
        CompletedTimestamp: number
        -- The reason for failure of an import job.
        Error: string
    end

    -- The structure of an ingress endpoint resource.
    record IngressPoint
        -- A user friendly name for the ingress endpoint resource.
        IngressPointName: string
        -- The identifier of the ingress endpoint resource.
        IngressPointId: string
        -- The status of the ingress endpoint resource.
        Status: string
        -- The type of ingress endpoint resource.
        Type: string
        -- The DNS A Record that identifies your ingress endpoint. Configure your DNS Mail Exchange (MX) record with this value to route emails to Mail Manager.
        ARecord: string
    end

    record ListIngressPointsInput
        -- The maximum number of ingress endpoint resources that are returned per call. You can use NextToken to obtain further ingress endpoints.
        PageSize: number
        -- If you received a pagination token from a previous call to this API, you can provide it here to continue paginating through the next page of results.
        NextToken: string
    end

    record ListIngressPointsOutput
        -- The list of ingress endpoints.
        IngressPoints: {IngressPoint}
        -- If NextToken is returned, there are more results available. The value of NextToken is a unique pagination token for each page. Make the call again using the returned token to retrieve the next page.
        NextToken: string
    end

    enum IngressPointStatusToUpdate
        "ACTIVE"
        "CLOSED"
    end

    record UpdateIngressPointInput
        -- The identifier for the ingress endpoint you want to update.
        IngressPointId: string
        -- A user friendly name for the ingress endpoint resource.
        IngressPointName: string
        -- The update status of an ingress endpoint.
        StatusToUpdate: string
        -- The identifier of an existing rule set that you attach to an ingress endpoint resource.
        RuleSetId: string
        -- The identifier of an existing traffic policy that you attach to an ingress endpoint resource.
        TrafficPolicyId: string
        -- If you choose an Authenticated ingress endpoint, you must configure either an SMTP password or a secret ARN.
        IngressPointConfiguration: IngressPointConfiguration
        -- The Transport Layer Security (TLS) policy for the ingress point. Valid values are REQUIRED, OPTIONAL. Only ingress endpoints using REQUIRED or OPTIONAL as TlsPolicy can be updated.
        TlsPolicy: string
    end

    record UpdateIngressPointOutput
    end

