        -- The date and time, in ISO-8601 Extended format, for when the maintenance window is scheduled
        -- to become active. The maintenance window won't run before this specified time.
        StartDate: string
        -- The date and time, in ISO-8601 Extended format, for when the maintenance window is scheduled
