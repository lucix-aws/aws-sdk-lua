        -- DescribeInstances in the Amazon EC2 API Reference or describe-instances in the Amazon Web Services CLI Command Reference.
        Name: string
        -- The IP address of the managed node.
        IPAddress: string
        -- The fully qualified host name of the managed node.
        ComputerName: string
        -- The status of the association.
        AssociationStatus: string
        -- The date the association was last run.
        LastAssociationExecutionDate: number
        -- The last date the association was successfully run.
        LastSuccessfulAssociationExecutionDate: number
