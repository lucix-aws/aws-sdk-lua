        AllowUnassociatedTargets: boolean
        -- Whether the maintenance window is enabled.
        Enabled: boolean
        -- If True, then all fields that are required by the CreateMaintenanceWindow operation are also required for this API request. Optional
        -- fields that aren't specified are set to null.
        Replace: boolean
    end

