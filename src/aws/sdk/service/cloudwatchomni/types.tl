    end

    record ListAccessProfilesOutput
        -- The list of access profile summaries.
        items: {AccessProfileSummary}
        -- A token to retrieve the next page of results, or null if there are no more results.
        nextToken: string
    end

    record ListAlertsInput
        -- The unique ID of the space.
        spaceId: string
        -- Filter criteria narrowing which alerts are returned. All members are
        -- optional; the three name/id filters are mutually exclusive.
        filterCriteria: AlertFilterCriteria
        -- The field to sort results by.
        sortBy: string
        -- The order in which to sort results.
        sortOrder: string
        -- A token to retrieve the next page of results.
        nextToken: string
        -- The maximum number of alerts to return per page.
        maxResults: number
    end

    record ListAlertsOutput
        -- The list of alert summaries.
        items: {AlertSummary}
        -- A token to retrieve the next page of results, or null if there are no more results.
        nextToken: string
    end

    record ListDomainAccessGrantsForOrganizationInput
        -- Filter by domain ID.
        domainId: string
        -- Filter by principal ID.
        principalId: string
        -- Filter by principal type.
        principalType: string
        -- Filter by permission level.
        permission: string
        -- A token to retrieve the next page of results. Supply the same filters used
