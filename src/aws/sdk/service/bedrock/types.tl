    end

    record GetFoundationModelAvailabilityInput
        -- The model Id of the foundation model.
        modelId: string
    end

    enum AuthorizationStatus
        "AUTHORIZED"
        "NOT_AUTHORIZED"
    end

    enum EntitlementAvailability
        "AVAILABLE"
        "NOT_AVAILABLE"
    end

    enum RegionAvailability
        "AVAILABLE"
        "NOT_AVAILABLE"
    end

    record GetFoundationModelAvailabilityOutput
        -- The model Id of the foundation model.
        modelId: string
        -- Agreement availability.
        agreementAvailability: AgreementAvailability
        -- Authorization status.
        authorizationStatus: string
        -- Entitlement availability.
        entitlementAvailability: string
        -- Region availability.
        regionAvailability: string
    end

    enum OfferType
        "ALL"
        "PUBLIC"
    end

    record ListFoundationModelAgreementOffersInput
        -- Model Id of the foundation model.
        modelId: string
        -- Type of offer associated with the model.
        offerType: string
    end

    -- The legal term of the agreement.
    record LegalTerm
        -- URL to the legal term document.
        url: string
    end

    -- Describes a support term.
    record SupportTerm
        -- Describes the refund policy.
        refundPolicyDescription: string
    end

    -- Dimensional price rate.
    record DimensionalPriceRate
        -- Dimension for the price rate.
        dimension: string
        -- Single-dimensional rate information.
        price: string
        -- Description of the price rate.
        description: string
        -- Unit associated with the price.
        unit: string
    end

    -- Describes the usage-based pricing term.
    record PricingTerm
        -- Describes a usage price for each dimension.
        rateCard: {DimensionalPriceRate}
    end

    -- Describes the validity terms.
    record ValidityTerm
        -- Describes the agreement duration.
        agreementDuration: string
    end

    -- Describes the usage terms of an offer.
    record TermDetails
        usageBasedPricingTerm: PricingTerm
        -- Describes the legal terms.
        legalTerm: LegalTerm
        -- Describes the support terms.
        supportTerm: SupportTerm
        -- Describes the validity terms.
        validityTerm: ValidityTerm
    end

    -- An offer dictates usage terms for the model.
    record Offer
        -- Offer Id for a model offer.
        offerId: string
        -- Offer token.
        offerToken: string
        -- Details about the terms of the offer.
        termDetails: TermDetails
    end

    record ListFoundationModelAgreementOffersOutput
        -- Model Id of the foundation model.
        modelId: string
        -- List of the offers associated with the specified model.
        offers: {Offer}
    end

    record ListTagsForResourceInput
