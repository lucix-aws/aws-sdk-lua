    enum GettablePolicyStateValues
        "ENABLED"
        "DISABLED"
        "ERROR"
    end

    record GetLifecyclePoliciesInput
        -- The identifiers of the data lifecycle policies.
        PolicyIds: {string}
        -- The activation state.
        State: string
        -- The resource type.
        ResourceTypes: {string}
        -- The target tag for a policy.
