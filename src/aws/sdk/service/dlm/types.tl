    record InternalServerException
        Message: string
        Code: string
    end

    -- Bad request. The request is missing required parameters or has invalid
    -- parameters.
    record InvalidRequestException
        Message: string
        Code: string
        -- The request omitted one or more required parameters.
        RequiredParameters: {string}
        -- The request included parameters that cannot be provided together.
        MutuallyExclusiveParameters: {string}
    end

    -- The request failed because a limit was exceeded.
    record LimitExceededException
        Message: string
        Code: string
        -- Value is the type of resource for which a limit was exceeded.
        ResourceType: string
    end

    enum DefaultPoliciesTypeValues
        "VOLUME"
        "INSTANCE"
        "ALL"
    end

    record DeleteLifecyclePolicyInput
        -- The identifier of the lifecycle policy.
        PolicyId: string
    end

