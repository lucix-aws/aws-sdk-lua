        -- Identifies which operation in a batch has succeeded.
        SuccessfulResponse: BatchReadSuccessfulResponse
        -- Identifies which operation in a batch has failed.
        ExceptionResponse: BatchReadException
    end

    record BatchReadOutput
        -- A list of all the responses for each batch read.
        Responses: {BatchReadOperationResponse}
    end

    enum BatchWriteExceptionType
        "InternalServiceException"
        "ValidationException"
        "InvalidArnException"
        "LinkNameAlreadyInUseException"
        "StillContainsLinksException"
        "FacetValidationException"
        "ObjectNotDetachedException"
        "ResourceNotFoundException"
        "AccessDeniedException"
        "InvalidAttachmentException"
        "NotIndexException"
        "NotNodeException"
        "IndexedAttributeMissingException"
        "ObjectAlreadyDetachedException"
        "NotPolicyException"
        "DirectoryNotEnabledException"
        "LimitExceededException"
        "UnsupportedIndexTypeException"
    end

    -- A BatchWrite exception has occurred.
    record BatchWriteException
        Index: number
        Type: string
        Message: string
    end

    -- Represents the output of a batch add facet to object operation.
    record BatchAddFacetToObject
        -- Represents the facet being added to the object.
        SchemaFacet: SchemaFacet
        -- The attributes to set on the object.
        ObjectAttributeList: {AttributeKeyAndValue}
        -- A reference to the object being mutated.
        ObjectReference: ObjectReference
    end

    -- Represents the output of an AttachObject operation.
    record BatchAttachObject
        -- The parent object reference.
        ParentReference: ObjectReference
        -- The child object reference that is to be attached to the object.
        ChildReference: ObjectReference
        -- The name of the link.
        LinkName: string
    end

    -- Attaches a policy object to a regular object inside a BatchRead operation. For more information, see AttachPolicy and BatchReadRequest$Operations.
    record BatchAttachPolicy
        -- The reference that is associated with the policy object.
        PolicyReference: ObjectReference
        -- The reference that identifies the object to which the policy will be
        -- attached.
        ObjectReference: ObjectReference
    end

    -- Attaches the specified object to the specified index inside a BatchRead operation. For more information, see AttachToIndex and BatchReadRequest$Operations.
    record BatchAttachToIndex
        -- A reference to the index that you are attaching the object to.
        IndexReference: ObjectReference
        -- A reference to the object that you are attaching to the index.
        TargetReference: ObjectReference
    end

    -- Attaches a typed link to a specified source and target object inside a BatchRead operation. For more information, see AttachTypedLink and BatchReadRequest$Operations.
    record BatchAttachTypedLink
        -- Identifies the source object that the typed link will attach to.
        SourceObjectReference: ObjectReference
        -- Identifies the target object that the typed link will attach to.
        TargetObjectReference: ObjectReference
        -- Identifies the typed link facet that is associated with the typed link.
        TypedLinkFacet: TypedLinkSchemaAndFacetName
        -- A set of attributes that are associated with the typed link.
        Attributes: {AttributeNameAndValue}
    end

    -- Creates an index object inside of a BatchRead operation. For more information, see CreateIndex and BatchReadRequest$Operations.
    record BatchCreateIndex
        -- Specifies the attributes that should be indexed on. Currently only a single attribute
        -- is supported.
        OrderedIndexedAttributeList: {AttributeKey}
        -- Indicates whether the attribute that is being indexed has unique values or
        -- not.
        IsUnique: boolean
        -- A reference to the parent object that contains the index object.
        ParentReference: ObjectReference
        -- The name of the link between the parent object and the index object.
        LinkName: string
        -- The batch reference name. See Transaction Support for more information.
        BatchReferenceName: string
    end

    -- Represents the output of a CreateObject operation.
    record BatchCreateObject
        -- A list of FacetArns that will be associated with the object. For more
        -- information, see arns.
        SchemaFacet: {SchemaFacet}
        -- An attribute map, which contains an attribute ARN as the key and attribute value as
        -- the map value.
        ObjectAttributeList: {AttributeKeyAndValue}
        -- If specified, the parent reference to which this object will be attached.
        ParentReference: ObjectReference
        -- The name of the link.
        LinkName: string
        -- The batch reference name. See Transaction Support for more information.
        BatchReferenceName: string
    end

    -- Represents the output of a DeleteObject operation.
    record BatchDeleteObject
        -- The reference that identifies the object.
        ObjectReference: ObjectReference
    end

    -- Detaches the specified object from the specified index inside a BatchRead operation. For more information, see DetachFromIndex and BatchReadRequest$Operations.
    record BatchDetachFromIndex
        -- A reference to the index object.
        IndexReference: ObjectReference
        -- A reference to the object being detached from the index.
        TargetReference: ObjectReference
    end

    -- Represents the output of a DetachObject operation.
    record BatchDetachObject
        -- Parent reference from which the object with the specified link name is
        -- detached.
        ParentReference: ObjectReference
        -- The name of the link.
        LinkName: string
        -- The batch reference name. See Transaction Support for more information.
        BatchReferenceName: string
    end

    -- Detaches the specified policy from the specified directory inside a BatchWrite operation. For more information, see DetachPolicy and BatchWriteRequest$Operations.
    record BatchDetachPolicy
        -- Reference that identifies the policy object.
        PolicyReference: ObjectReference
        -- Reference that identifies the object whose policy object will be detached.
        ObjectReference: ObjectReference
    end

    -- Detaches a typed link from a specified source and target object inside a BatchRead operation. For more information, see DetachTypedLink and BatchReadRequest$Operations.
    record BatchDetachTypedLink
        -- Used to accept a typed link specifier as input.
        TypedLinkSpecifier: TypedLinkSpecifier
    end

    -- A batch operation to remove a facet from an object.
    record BatchRemoveFacetFromObject
        -- The facet to remove from the object.
        SchemaFacet: SchemaFacet
        -- A reference to the object whose facet will be removed.
        ObjectReference: ObjectReference
    end

    enum UpdateActionType
        "CREATE_OR_UPDATE"
        "DELETE"
    end

    -- The action to take on a typed link attribute value. Updates are only supported for attributes which don’t contribute to link identity.
    record LinkAttributeAction
        -- A type that can be either UPDATE_OR_CREATE or DELETE.
        AttributeActionType: string
        -- The value that you want to update to.
        AttributeUpdateValue: TypedAttributeValue
    end

    -- Structure that contains attribute update information.
    record LinkAttributeUpdate
        -- The key of the attribute being updated.
        AttributeKey: AttributeKey
        -- The action to perform as part of the attribute update.
        AttributeAction: LinkAttributeAction
    end

    -- Updates a given typed link’s attributes inside a BatchRead operation. Attributes to be updated must not contribute to the typed link’s identity, as defined by its IdentityAttributeOrder. For more information, see UpdateLinkAttributes and BatchReadRequest$Operations.
    record BatchUpdateLinkAttributes
        -- Allows a typed link specifier to be accepted as input.
        TypedLinkSpecifier: TypedLinkSpecifier
        -- The attributes update structure.
        AttributeUpdates: {LinkAttributeUpdate}
    end

    -- The action to take on the object attribute.
    record ObjectAttributeAction
        -- A type that can be either Update or Delete.
        ObjectAttributeActionType: string
        -- The value that you want to update to.
        ObjectAttributeUpdateValue: TypedAttributeValue
    end

    -- Structure that contains attribute update information.
    record ObjectAttributeUpdate
        -- The key of the attribute being updated.
        ObjectAttributeKey: AttributeKey
        -- The action to perform as part of the attribute update.
        ObjectAttributeAction: ObjectAttributeAction
    end

    -- Represents the output of a BatchUpdate operation.
    record BatchUpdateObjectAttributes
        -- Reference that identifies the object.
        ObjectReference: ObjectReference
        -- Attributes update structure.
        AttributeUpdates: {ObjectAttributeUpdate}
    end

    -- Represents the output of a BatchWrite operation.
    record BatchWriteOperation
        -- Creates an object.
        CreateObject: BatchCreateObject
        -- Attaches an object to a Directory.
        AttachObject: BatchAttachObject
        -- Detaches an object from a Directory.
        DetachObject: BatchDetachObject
        -- Updates a given object's attributes.
        UpdateObjectAttributes: BatchUpdateObjectAttributes
        -- Deletes an object in a Directory.
        DeleteObject: BatchDeleteObject
        -- A batch operation that adds a facet to an object.
        AddFacetToObject: BatchAddFacetToObject
        -- A batch operation that removes a facet from an object.
        RemoveFacetFromObject: BatchRemoveFacetFromObject
        -- Attaches a policy object to a regular object. An object can have a limited number of attached
        -- policies.
        AttachPolicy: BatchAttachPolicy
        -- Detaches a policy from a Directory.
        DetachPolicy: BatchDetachPolicy
        -- Creates an index object. See Indexing and search for more information.
        CreateIndex: BatchCreateIndex
        -- Attaches the specified object to the specified index.
        AttachToIndex: BatchAttachToIndex
        -- Detaches the specified object from the specified index.
        DetachFromIndex: BatchDetachFromIndex
        -- Attaches a typed link to a specified source and target object. For more information, see Typed Links.
        AttachTypedLink: BatchAttachTypedLink
        -- Detaches a typed link from a specified source and target object. For more information, see Typed Links.
        DetachTypedLink: BatchDetachTypedLink
        -- Updates a given object's attributes.
        UpdateLinkAttributes: BatchUpdateLinkAttributes
    end

    record BatchWriteInput
        -- The Amazon Resource Name (ARN) that is associated with the Directory.
        -- For more information, see arns.
        DirectoryArn: string
        -- A list of operations that are part of the batch.
        Operations: {BatchWriteOperation}
    end

    -- The result of a batch add facet to object operation.
    record BatchAddFacetToObjectResponse
    end

    -- Represents the output batch AttachObject response operation.
    record BatchAttachObjectResponse
        -- The ObjectIdentifier of the object that has been attached.
        attachedObjectIdentifier: string
    end

    -- Represents the output of an AttachPolicy response
    -- operation.
    record BatchAttachPolicyResponse
    end

    -- Represents the output of a AttachToIndex response operation.
    record BatchAttachToIndexResponse
        -- The ObjectIdentifier of the object that was attached to the index.
        AttachedObjectIdentifier: string
    end

    -- Represents the output of a AttachTypedLink response operation.
    record BatchAttachTypedLinkResponse
        -- Returns a typed link specifier as output.
        TypedLinkSpecifier: TypedLinkSpecifier
    end

    -- Represents the output of a CreateIndex response operation.
    record BatchCreateIndexResponse
        -- The ObjectIdentifier of the index created by this operation.
        ObjectIdentifier: string
    end

    -- Represents the output of a CreateObject response operation.
    record BatchCreateObjectResponse
        -- The ID that is associated with the object.
        ObjectIdentifier: string
    end

    -- Represents the output of a DeleteObject response operation.
    record BatchDeleteObjectResponse
    end

    -- Represents the output of a DetachFromIndex response operation.
    record BatchDetachFromIndexResponse
        -- The ObjectIdentifier of the object that was detached from the index.
        DetachedObjectIdentifier: string
    end

    -- Represents the output of a DetachObject response operation.
    record BatchDetachObjectResponse
        -- The ObjectIdentifier of the detached object.
        detachedObjectIdentifier: string
    end

    -- Represents the output of a DetachPolicy response operation.
    record BatchDetachPolicyResponse
    end

    -- Represents the output of a DetachTypedLink response operation.
    record BatchDetachTypedLinkResponse
    end

    -- An empty result that represents success.
    record BatchRemoveFacetFromObjectResponse
    end

    -- Represents the output of a UpdateLinkAttributes response operation.
    record BatchUpdateLinkAttributesResponse
    end

    -- Represents the output of a BatchUpdate response operation.
    record BatchUpdateObjectAttributesResponse
        -- ID that is associated with the object.
        ObjectIdentifier: string
    end

    -- Represents the output of a BatchWrite response operation.
    record BatchWriteOperationResponse
        -- Creates an object in a Directory.
        CreateObject: BatchCreateObjectResponse
        -- Attaches an object to a Directory.
        AttachObject: BatchAttachObjectResponse
        -- Detaches an object from a Directory.
        DetachObject: BatchDetachObjectResponse
        -- Updates a given object’s attributes.
        UpdateObjectAttributes: BatchUpdateObjectAttributesResponse
        -- Deletes an object in a Directory.
        DeleteObject: BatchDeleteObjectResponse
        -- The result of an add facet to object batch operation.
        AddFacetToObject: BatchAddFacetToObjectResponse
        -- The result of a batch remove facet from object operation.
        RemoveFacetFromObject: BatchRemoveFacetFromObjectResponse
        -- Attaches a policy object to a regular object. An object can have a limited number of attached
        -- policies.
        AttachPolicy: BatchAttachPolicyResponse
        -- Detaches a policy from a Directory.
        DetachPolicy: BatchDetachPolicyResponse
        -- Creates an index object. See Indexing and search for more information.
        CreateIndex: BatchCreateIndexResponse
        -- Attaches the specified object to the specified index.
        AttachToIndex: BatchAttachToIndexResponse
        -- Detaches the specified object from the specified index.
        DetachFromIndex: BatchDetachFromIndexResponse
        -- Attaches a typed link to a specified source and target object. For more information, see Typed Links.
        AttachTypedLink: BatchAttachTypedLinkResponse
        -- Detaches a typed link from a specified source and target object. For more information, see Typed Links.
        DetachTypedLink: BatchDetachTypedLinkResponse
        -- Represents the output of a BatchWrite response operation.
        UpdateLinkAttributes: BatchUpdateLinkAttributesResponse
    end

    record BatchWriteOutput
        -- A list of all the responses for each batch write.
        Responses: {BatchWriteOperationResponse}
    end

    record CreateDirectoryInput
        -- The name of the Directory. Should be unique per account, per
        -- region.
        Name: string
        -- The Amazon Resource Name (ARN) of the published schema that will be copied into the
        -- data Directory. For more information, see arns.
        SchemaArn: string
    end

    record CreateDirectoryOutput
        -- The ARN that is associated with the Directory. For more information,
        -- see arns.
        DirectoryArn: string
        -- The name of the Directory.
        Name: string
        -- The root object node of the created directory.
        ObjectIdentifier: string
        -- The ARN of the published schema in the Directory. Once a published
        -- schema is copied into the directory, it has its own ARN, which is referred to applied schema
        -- ARN. For more information, see arns.
        AppliedSchemaArn: string
    end

    -- Indicates that a Directory could not be created due to a naming
    -- conflict. Choose a different name and try again.
    record DirectoryAlreadyExistsException
        Message: string
    end

    enum RuleType
        "BINARY_LENGTH"
        "NUMBER_COMPARISON"
        "STRING_FROM_SET"
        "STRING_LENGTH"
    end

    -- Contains an Amazon Resource Name (ARN) and parameters that are associated with the
    -- rule.
    record Rule
        -- The type of attribute validation rule.
        Type: string
        -- The minimum and maximum parameters that are associated with the rule.
        Parameters: {string : string}
    end

    enum FacetAttributeType
        "STRING"
        "BINARY"
        "BOOLEAN"
        "NUMBER"
        "DATETIME"
        "VARIANT"
    end

    -- A facet attribute definition. See Attribute References for more information.
    record FacetAttributeDefinition
        -- The type of the attribute.
        Type: string
        -- The default value of the attribute (if configured).
        DefaultValue: TypedAttributeValue
        -- Whether the attribute is mutable or not.
        IsImmutable: boolean
        -- Validation rules attached to the attribute definition.
        Rules: {string : Rule}
    end

    -- The facet attribute reference that specifies the attribute definition that contains the
    -- attribute facet name and attribute name.
    record FacetAttributeReference
        -- The target facet name that is associated with the facet reference. See Attribute References for more information.
        TargetFacetName: string
        -- The target attribute name that is associated with the facet reference. See Attribute References for more information.
        TargetAttributeName: string
    end

    enum RequiredAttributeBehavior
        "REQUIRED_ALWAYS"
        "NOT_REQUIRED"
    end

    -- An attribute that is associated with the Facet.
    record FacetAttribute
        -- The name of the facet attribute.
        Name: string
        -- A facet attribute consists of either a definition or a reference. This structure
        -- contains the attribute definition. See Attribute References for more information.
        AttributeDefinition: FacetAttributeDefinition
        -- An attribute reference that is associated with the attribute. See Attribute References for more information.
        AttributeReference: FacetAttributeReference
        -- The required behavior of the FacetAttribute.
        RequiredBehavior: string
    end

    enum FacetStyle
        "STATIC"
        "DYNAMIC"
    end

    enum ObjectType
        "NODE"
        "LEAF_NODE"
        "POLICY"
        "INDEX"
    end

    record CreateFacetInput
        -- The schema ARN in which the new Facet will be created. For more
        -- information, see arns.
        SchemaArn: string
        -- The name of the Facet, which is unique for a given schema.
        Name: string
        -- The attributes that are associated with the Facet.
        Attributes: {FacetAttribute}
        -- Specifies whether a given object created from this facet is of type node, leaf node,
        -- policy or index.
        -- Node: Can have multiple children but one parent.
        -- Leaf node: Cannot have children but can have multiple parents.
        -- Policy: Allows you to store a policy document and policy type. For more
        -- information, see Policies.
        -- Index: Can be created with the Index API.
        ObjectType: string
        -- There are two different styles that you can define on any given facet, Static and Dynamic. For static facets, all attributes must be defined in the schema. For dynamic facets, attributes can be defined during data plane operations.
        FacetStyle: string
    end

    record CreateFacetOutput
    end

    -- A facet with the same name already exists.
    record FacetAlreadyExistsException
        Message: string
    end

    -- Occurs when any of the rule parameter keys or values are invalid.
    record InvalidRuleException
        Message: string
    end

    record CreateIndexInput
        -- The ARN of the directory where the index should be created.
        DirectoryArn: string
        -- Specifies the attributes that should be indexed on. Currently only a single attribute
        -- is supported.
        OrderedIndexedAttributeList: {AttributeKey}
        -- Indicates whether the attribute that is being indexed has unique values or
        -- not.
        IsUnique: boolean
        -- A reference to the parent object that contains the index object.
        ParentReference: ObjectReference
        -- The name of the link between the parent object and the index object.
        LinkName: string
    end

    record CreateIndexOutput
        -- The ObjectIdentifier of the index created by this operation.
        ObjectIdentifier: string
    end

    -- Indicates that the requested index type is not supported.
    record UnsupportedIndexTypeException
        Message: string
    end

    record CreateObjectInput
        -- The Amazon Resource Name (ARN) that is associated with the Directory
        -- in which the object will be created. For more information, see arns.
        DirectoryArn: string
        -- A list of schema facets to be associated with the object. Do not provide minor version components. See SchemaFacet for details.
        SchemaFacets: {SchemaFacet}
        -- The attribute map whose attribute ARN contains the key and attribute value as the map
        -- value.
        ObjectAttributeList: {AttributeKeyAndValue}
        -- If specified, the parent reference to which this object will be attached.
        ParentReference: ObjectReference
        -- The name of link that is used to attach this object to a parent.
        LinkName: string
    end

    record CreateObjectOutput
        -- The identifier that is associated with the object.
        ObjectIdentifier: string
    end

    record CreateSchemaInput
        -- The name that is associated with the schema. This is unique to each account and in each
        -- region.
        Name: string
    end

    record CreateSchemaOutput
        -- The Amazon Resource Name (ARN) that is associated with the schema. For more
        -- information, see arns.
        SchemaArn: string
    end

    -- A typed link attribute definition.
    record TypedLinkAttributeDefinition
        -- The unique name of the typed link attribute.
        Name: string
        -- The type of the attribute.
        Type: string
        -- The default value of the attribute (if configured).
        DefaultValue: TypedAttributeValue
        -- Whether the attribute is mutable or not.
        IsImmutable: boolean
        -- Validation rules that are attached to the attribute definition.
        Rules: {string : Rule}
        -- The required behavior of the TypedLinkAttributeDefinition.
        RequiredBehavior: string
    end

    -- Defines the typed links structure and its attributes. To create a typed link facet, use
    -- the CreateTypedLinkFacet API.
    record TypedLinkFacet
        -- The unique name of the typed link facet.
        Name: string
        -- A set of key-value pairs associated with the typed link. Typed link attributes are used when you have data values that are related to the link itself, and not to one of the two objects being linked. Identity attributes also serve to distinguish the link from others of the same type between the same objects.
        Attributes: {TypedLinkAttributeDefinition}
        -- The set of attributes that distinguish links made from this facet from each other, in the order of significance. Listing typed links can filter on the values of these attributes. See ListOutgoingTypedLinks and ListIncomingTypedLinks for details.
        IdentityAttributeOrder: {string}
    end

    record CreateTypedLinkFacetInput
        -- The Amazon Resource Name (ARN) that is associated with the schema. For more
        -- information, see arns.
        SchemaArn: string
        -- Facet structure that is associated with the typed link
        -- facet.
        Facet: TypedLinkFacet
    end

    record CreateTypedLinkFacetOutput
    end

    record DeleteDirectoryInput
        -- The ARN of the directory to delete.
        DirectoryArn: string
    end

    record DeleteDirectoryOutput
        -- The ARN of the deleted directory.
        DirectoryArn: string
    end

    -- A directory that has been deleted and to which access has been attempted. Note: The
    -- requested resource will eventually cease to exist.
    record DirectoryDeletedException
        Message: string
    end

    -- An operation can only operate on a disabled directory.
    record DirectoryNotDisabledException
        Message: string
    end

    record DeleteFacetInput
        -- The Amazon Resource Name (ARN) that is associated with the Facet.
        -- For more information, see arns.
        SchemaArn: string
        -- The name of the facet to delete.
        Name: string
    end

    record DeleteFacetOutput
    end

    -- Occurs when deleting a facet that contains an attribute that is a target to an
    -- attribute reference in a different facet.
    record FacetInUseException
        Message: string
    end

    -- The specified Facet could not be found.
    record FacetNotFoundException
        Message: string
    end

    record DeleteObjectInput
        -- The Amazon Resource Name (ARN) that is associated with the Directory
        -- where the object resides. For more information, see arns.
        DirectoryArn: string
        -- A reference that identifies the object.
        ObjectReference: ObjectReference
    end

    record DeleteObjectOutput
    end

    -- Indicates that the requested operation cannot be completed because the object has not
    -- been detached from the tree.
    record ObjectNotDetachedException
        Message: string
    end

    record DeleteSchemaInput
        -- The Amazon Resource Name (ARN) of the development schema. For more information, see
        -- arns.
        SchemaArn: string
    end

    record DeleteSchemaOutput
        -- The input ARN that is returned as part of the response. For more information, see
        -- arns.
        SchemaArn: string
    end

    -- The object could not be deleted because links still exist. Remove the links and then
    -- try the operation again.
    record StillContainsLinksException
        Message: string
    end

    record DeleteTypedLinkFacetInput
        -- The Amazon Resource Name (ARN) that is associated with the schema. For more
        -- information, see arns.
        SchemaArn: string
        -- The unique name of the typed link facet.
        Name: string
    end

    record DeleteTypedLinkFacetOutput
    end

    record DetachFromIndexInput
        -- The Amazon Resource Name (ARN) of the directory the index and object exist
        -- in.
        DirectoryArn: string
        -- A reference to the index object.
        IndexReference: ObjectReference
        -- A reference to the object being detached from the index.
        TargetReference: ObjectReference
    end

    record DetachFromIndexOutput
        -- The ObjectIdentifier of the object that was detached from the index.
        DetachedObjectIdentifier: string
    end

    -- Indicates that the object is not attached to the index.
    record ObjectAlreadyDetachedException
        Message: string
    end

    record DetachObjectInput
        -- The Amazon Resource Name (ARN) that is associated with the Directory
        -- where objects reside. For more information, see arns.
        DirectoryArn: string
        -- The parent reference from which the object with the specified link name is
        -- detached.
        ParentReference: ObjectReference
        -- The link name associated with the object that needs to be detached.
        LinkName: string
    end

    record DetachObjectOutput
        -- The ObjectIdentifier that was detached from the object.
        DetachedObjectIdentifier: string
    end

    -- Occurs when any invalid operations are performed on an object that is not a node, such
    -- as calling ListObjectChildren for a leaf node object.
    record NotNodeException
        Message: string
    end

    record DetachPolicyInput
        -- The Amazon Resource Name (ARN) that is associated with the Directory
        -- where both objects reside. For more information, see arns.
        DirectoryArn: string
        -- Reference that identifies the policy object.
        PolicyReference: ObjectReference
        -- Reference that identifies the object whose policy object will be detached.
        ObjectReference: ObjectReference
    end

    record DetachPolicyOutput
    end

    record DetachTypedLinkInput
        -- The Amazon Resource Name (ARN) of the directory where you want to detach the typed
        -- link.
        DirectoryArn: string
        -- Used to accept a typed link specifier as input.
        TypedLinkSpecifier: TypedLinkSpecifier
    end

    record DetachTypedLinkOutput
    end

    record DisableDirectoryInput
        -- The ARN of the directory to disable.
        DirectoryArn: string
    end

    record DisableDirectoryOutput
        -- The ARN of the directory that has been disabled.
        DirectoryArn: string
    end

    record EnableDirectoryInput
        -- The ARN of the directory to enable.
        DirectoryArn: string
    end

    record EnableDirectoryOutput
        -- The ARN of the enabled directory.
        DirectoryArn: string
    end

    record GetAppliedSchemaVersionInput
        -- The ARN of the applied schema.
        SchemaArn: string
    end

    record GetAppliedSchemaVersionOutput
        -- Current applied schema ARN, including the minor version in use if one was provided.
        AppliedSchemaArn: string
    end

    record GetDirectoryInput
        -- The ARN of the directory.
        DirectoryArn: string
    end

    enum DirectoryState
        "ENABLED"
        "DISABLED"
        "DELETED"
    end

    -- Directory structure that includes the directory name and directory ARN.
    record Directory
        -- The name of the directory.
        Name: string
        -- The Amazon Resource Name (ARN) that is associated with the directory. For more
        -- information, see arns.
        DirectoryArn: string
        -- The state of the directory. Can be either Enabled, Disabled, or Deleted.
        State: string
        -- The date and time when the directory was created.
        CreationDateTime: number
    end

    record GetDirectoryOutput
        -- Metadata about the directory.
        Directory: Directory
    end

    record GetFacetInput
        -- The Amazon Resource Name (ARN) that is associated with the Facet.
        -- For more information, see arns.
        SchemaArn: string
        -- The name of the facet to retrieve.
        Name: string
    end

    -- A structure that contains Name, ARN, Attributes,
    -- Rules, and
    -- ObjectTypes. See Facets for more information.
    record Facet
        -- The name of the Facet.
        Name: string
        -- The object type that is associated with the facet. See CreateFacetRequest$ObjectType for more details.
        ObjectType: string
        -- There are two different styles that you can define on any given facet, Static and Dynamic. For static facets, all attributes must be defined in the schema. For dynamic facets, attributes can be defined during data plane operations.
        FacetStyle: string
    end

    record GetFacetOutput
        -- The Facet structure that is associated with the facet.
        Facet: Facet
    end

    record GetLinkAttributesInput
        -- The Amazon Resource Name (ARN) that is associated with the Directory where the typed link resides. For more information, see arns or Typed Links.
        DirectoryArn: string
