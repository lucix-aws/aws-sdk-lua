            type = "string",
            name = "ETag",
            target_id = prelude.String.id,
            traits = {
                [traits.HTTP_HEADER] = { name = "ETag" },
            },
        }),
        PricingBucket = schema.new({
            id = id.from(_N, "GetTileOutput", "PricingBucket"),
            type = "string",
            name = "PricingBucket",
            target_id = prelude.String.id,
            traits = {
                [traits.REQUIRED] = {},
                [traits.HTTP_HEADER] = { name = "x-amz-geo-pricing-bucket" },
            },
        }),
    },
})

M.ResourceNotFoundException = schema.new({
    id = id.from(_N, "ResourceNotFoundException"),
    type = "structure",
    traits = {
        [traits.ERROR] = { value = "client" },
    },
    members = {
        Message = schema.new({
            id = id.from(_N, "ResourceNotFoundException", "Message"),
            type = "string",
            name = "Message",
            target_id = prelude.String.id,
            traits = {
                [traits.REQUIRED] = {},
                [traits.JSON_NAME] = { name = "message" },
            },
        }),
    },
})

-- Fix forward references for recursive schemas
for _, _s in pairs(M) do
    local s = _s as {string:any}
    if type(s) == "table" and (s.type == "structure" or s.type == "union") then
        local members = rawget(s, "_members") as {string:{string:any}}
        if members then
            for _, ms in pairs(members) do
                if (ms.type == "structure" or ms.type == "union") and not rawget(ms as {string:any}, "_target") and ms.target_id then
                    rawset(ms as {string:any}, "_target", M[(ms.target_id as {string:string}).name])
                end
            end
        end
    end
end

M.Service = schema.service({
    id = id.from("com.amazonaws.geomaps", "MapsService"),
    version = "2020-11-19",
    traits = {
        [traits.AUTH] = {
            { scheme_id = "aws.auth#sigv4" },
        },
    },
})

