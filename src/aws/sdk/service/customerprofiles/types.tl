    -- destination.
    record ObjectAttribute
        -- An attribute contained within a source object.
        Source: string
        -- A field defined within an object type.
        FieldName: string
        -- The operator used to compare an attribute against a list of values.
        ComparisonOperator: string
        -- A list of attribute values used for comparison.
        Values: {string}
    end

    -- A specific event dimension to be assessed.
    record EventTriggerDimension
        -- A list of object attributes to be evaluated.
        ObjectAttributes: {ObjectAttribute}
    end

    enum EventTriggerLogicalOperator
        "ANY"
        "ALL"
        "NONE"
    end

    -- Specifies the circumstances under which the event should trigger the destination.
    record EventTriggerCondition
        -- A list of dimensions to be evaluated for the event.
        EventTriggerDimensions: {EventTriggerDimension}
        -- The operator used to combine multiple dimensions.
        LogicalOperator: string
    end

    enum PeriodUnit
        "MINUTES"
        "HOURS"
        "DAYS"
        "WEEKS"
        "MONTHS"
    end

    -- Defines a limit and the time period during which it is enforced.
    record Period
        -- The unit of time.
        Unit: string
        -- The amount of time of the specified unit.
        Value: number
        -- The maximum allowed number of destination invocations per profile.
        MaxInvocationsPerProfile: number
        -- If set to true, there is no limit on the number of destination invocations per profile.
        -- The default is false.
        Unlimited: boolean
    end

    -- Defines limits controlling whether an event triggers the destination, based on ingestion
    -- latency and the number of invocations per profile over specific time periods.
    record EventTriggerLimits
        -- In milliseconds. Specifies that an event will only trigger the destination if it is
        -- processed within a certain latency period.
        EventExpiration: number
        -- A list of time periods during which the limits apply.
        Periods: {Period}
    end

    record CreateEventTriggerInput
        -- The unique name of the domain.
        DomainName: string
        -- The unique name of the event trigger.
        EventTriggerName: string
        -- The unique name of the object type.
        ObjectTypeName: string
        -- The description of the event trigger.
        Description: string
        -- A list of conditions that determine when an event should trigger the destination.
        EventTriggerConditions: {EventTriggerCondition}
        -- The destination is triggered only for profiles that meet the criteria of a segment
        -- definition.
        SegmentFilter: string
        -- Defines limits controlling whether an event triggers the destination, based on ingestion
        -- latency and the number of invocations per profile over specific time periods.
        EventTriggerLimits: EventTriggerLimits
        -- An array of key-value pairs to apply to this resource.
        Tags: {string : string}
    end

    record CreateEventTriggerOutput
        -- The unique name of the event trigger.
        EventTriggerName: string
        -- The unique name of the object type.
        ObjectTypeName: string
        -- The description of the event trigger.
        Description: string
        -- A list of conditions that determine when an event should trigger the destination.
        EventTriggerConditions: {EventTriggerCondition}
        -- The destination is triggered only for profiles that meet the criteria of a segment
        -- definition.
        SegmentFilter: string
        -- Defines limits controlling whether an event triggers the destination, based on ingestion
        -- latency and the number of invocations per profile over specific time periods.
        EventTriggerLimits: EventTriggerLimits
        -- The timestamp of when the event trigger was created.
        CreatedAt: number
        -- The timestamp of when the event trigger was most recently updated.
        LastUpdatedAt: number
        -- An array of key-value pairs to apply to this resource.
        Tags: {string : string}
    end

    -- Configuration data for integration workflow.
    record IntegrationConfig
        -- Configuration data for APPFLOW_INTEGRATION workflow type.
        AppflowIntegration: AppflowIntegration
    end

    enum WorkflowType
        "APPFLOW_INTEGRATION"
    end

    record CreateIntegrationWorkflowInput
        -- The unique name of the domain.
        DomainName: string
        -- The type of workflow. The only supported value is APPFLOW_INTEGRATION.
        WorkflowType: string
        -- Configuration data for integration workflow.
        IntegrationConfig: IntegrationConfig
        -- The name of the profile object type.
        ObjectTypeName: string
        -- The Amazon Resource Name (ARN) of the IAM role. Customer Profiles assumes this role to create resources on your behalf as part of workflow execution.
        RoleArn: string
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    record CreateIntegrationWorkflowOutput
        -- Unique identifier for the workflow.
        WorkflowId: string
        -- A message indicating create request was received.
        Message: string
    end

    record CreateProfileInput
        -- The unique name of the domain.
        DomainName: string
        -- An account number that you have assigned to the customer.
        AccountNumber: string
        -- Any additional information relevant to the customer’s profile.
        AdditionalInformation: string
        -- The type of profile used to describe the customer.
        PartyType: string
        -- The name of the customer’s business.
        BusinessName: string
        -- The customer’s first name.
        FirstName: string
        -- The customer’s middle name.
        MiddleName: string
        -- The customer’s last name.
        LastName: string
        -- The customer’s birth date.
        BirthDate: string
        -- The gender with which the customer identifies.
        Gender: string
        -- The customer’s phone number, which has not been specified as a mobile, home, or business
        -- number.
        PhoneNumber: string
        -- The customer’s mobile phone number.
        MobilePhoneNumber: string
        -- The customer’s home phone number.
        HomePhoneNumber: string
        -- The customer’s business phone number.
        BusinessPhoneNumber: string
        -- The customer’s email address, which has not been specified as a personal or business
        -- address.
        EmailAddress: string
        -- The customer’s personal email address.
        PersonalEmailAddress: string
        -- The customer’s business email address.
        BusinessEmailAddress: string
        -- A generic address associated with the customer that is not mailing, shipping, or
        -- billing.
        Address: Address
        -- The customer’s shipping address.
        ShippingAddress: Address
        -- The customer’s mailing address.
        MailingAddress: Address
        -- The customer’s billing address.
        BillingAddress: Address
        -- A key value pair of attributes of a customer profile.
        Attributes: {string : string}
        -- An alternative to PartyType which accepts any string as input.
        PartyTypeString: string
        -- An alternative to Gender which accepts any string as input.
        GenderString: string
        -- The type of the profile.
        ProfileType: string
        -- Object that defines the preferred methods of engagement, per channel.
        EngagementPreferences: EngagementPreferences
    end

    record CreateProfileOutput
        -- The unique identifier of a customer profile.
        ProfileId: string
    end

    enum DiversityCapType
        "PERCENTAGE"
        "VALUE"
    end

    -- Defines a diversity constraint for a single item column, specifying a cap type and a target value or placeholder that controls how many recommended items may share the same column value.
    record DiversityColumn
        -- The name of the item catalog column on which to apply the diversity cap. The column must be defined in the recommender schema.
        Name: string
        -- The type of diversity cap to apply. Valid values are PERCENTAGE (interpret Target as a percentage of returned items) and VALUE (interpret Target as an absolute count).
        CapType: string
        -- The diversity cap target. Either an integer literal (for example, "25") or a placeholder expression of the form $name whose value is supplied at inference time through GetProfileRecommendations.
        Target: string
    end

    -- Configuration that controls diversity of recommendation results by capping the representation of specified item columns.
    record DiversityConfig
        -- A list of up to two diversity columns. Each column defines a cap on the number or percentage of recommended items that share the same value for that column.
        DiversityColumns: {DiversityColumn}
    end

    -- Configuration parameters for events in the personalization system.
    record EventParameters
        -- The type of event being tracked (e.g., 'click', 'purchase', 'view').
        EventType: string
        -- The minimum value threshold that an event must meet to be considered valid.
        EventValueThreshold: number
        -- The weight of the event type. A higher weight means higher importance of the event type for the created solution.
        EventWeight: number
    end

    -- Configuration settings that define how events are processed and tracked.
    record EventsConfig
        -- A list of event parameters configurations that specify how different event types should be handled.
        EventParametersList: {EventParameters}
    end

    -- Configuration settings for inference behavior of the recommender.
    record InferenceConfig
        -- The minimum provisioned transactions per second (TPS) that the recommender supports. The default value is 1. A high MinProvisionedTPS will increase your cost.
        MinProvisionedTPS: number
    end

    -- Configuration settings that define the behavior and parameters of a recommender.
    record RecommenderConfig
        -- Configuration settings for how the recommender processes and uses events.
        EventsConfig: EventsConfig
        -- How often the recommender should retrain its model with new data. If set to 0, automatic retraining will not be enabled.
        TrainingFrequency: number
        -- Configuration settings for how the recommender handles inference requests.
        InferenceConfig: InferenceConfig
        -- A map of dataset type to a list of column names to train on. The _webAnalytics and _catalogItem keys are supported. The column names must be a subset of the columns defined in the recommender schema. If not specified, all columns in the schema are used for training. The following columns are always included in training and do not need to be specified: Item.Id, EventTimestamp, and EventType for _webAnalytics; Id for _catalogItem. Mutually exclusive with ExcludedColumns — both cannot be specified in the same request.
        IncludedColumns: {string : {string}}
        -- A map of dataset type to a list of column names to exclude from training. The _webAnalytics and _catalogItem keys are supported. The column names must be valid columns defined in the recommender schema. All columns in the schema except the listed columns will be used for training. The following columns are mandatory and cannot be excluded: Item.Id, EventTimestamp, and EventType for _webAnalytics; Id for _catalogItem. Mutually exclusive with IncludedColumns — both cannot be specified in the same request.
        ExcludedColumns: {string : {string}}
        -- Configuration for diversity-aware recommendations. When set, the recommender applies diversity constraints defined per item column to reduce over-concentration of similar items in the results.
        DiversityConfig: DiversityConfig
    end

    enum RecommenderRecipeName
        "recommended-for-you"
        "similar-items"
        "frequently-paired-items"
        "popular-items"
        "trending-now"
        "personalized-ranking"
    end

    record CreateRecommenderInput
        -- The unique name of the domain.
        DomainName: string
        -- The name of the recommender.
        RecommenderName: string
        -- The name of the recommeder recipe.
        RecommenderRecipeName: string
        -- The recommender configuration.
        RecommenderConfig: RecommenderConfig
        -- The description of the domain object type.
        Description: string
        -- The name of the recommender schema to use for this recommender. If not specified, the default schema is used.
        RecommenderSchemaName: string
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    record CreateRecommenderOutput
        -- The ARN of the recommender
        RecommenderArn: string
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    record CreateRecommenderFilterInput
        -- The unique name of the domain.
        DomainName: string
        -- The name of the recommender filter. The name must be unique within the domain.
        RecommenderFilterName: string
        -- The filter expression that defines which items to include or exclude from recommendations.
        RecommenderFilterExpression: string
        -- The name of the recommender schema to use for this recommender filter. If not specified, the default schema is used.
        RecommenderSchemaName: string
        -- A description of the recommender filter.
        Description: string
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    record CreateRecommenderFilterOutput
        -- The Amazon Resource Name (ARN) of the recommender filter.
        RecommenderFilterArn: string
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    enum FeatureType
        "TEXTUAL"
        "CATEGORICAL"
    end

    -- Defines a column in a recommender schema, including the target field name and optional feature and content type settings for training.
    record RecommenderSchemaField
        -- The name of the target field in the dataset, such as Location.City or Attributes.MealTime.
        TargetFieldName: string
        -- The data type of the column value. Valid values are String and Number. The default value is String.
        ContentType: string
        -- How the column is treated for model training. Valid values are CATEGORICAL and TEXTUAL.
        FeatureType: string
    end

    record CreateRecommenderSchemaInput
        -- The unique name of the domain.
        DomainName: string
        -- The name of the recommender schema. The name must be unique within the domain.
        RecommenderSchemaName: string
        -- A map of dataset type to column definitions that specifies which data columns to include in the schema. The _webAnalytics and _catalogItem keys are supported.
        Fields: {string : {RecommenderSchemaField}}
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    enum RecommenderSchemaStatus
        "ACTIVE"
        "DELETING"
    end

    record CreateRecommenderSchemaOutput
        -- The Amazon Resource Name (ARN) of the recommender schema.
        RecommenderSchemaArn: string
        -- The name of the recommender schema.
        RecommenderSchemaName: string
        -- A map of dataset type to column definitions included in the schema.
        Fields: {string : {RecommenderSchemaField}}
        -- The timestamp of when the recommender schema was created.
        CreatedAt: number
        -- The status of the recommender schema.
        Status: string
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    -- Object that segments on various Customer profile's fields that are larger than
    -- normal.
    record ExtraLengthValueProfileDimension
        -- The action to segment with.
        DimensionType: string
        -- The values to apply the DimensionType on. To reference a calculated attribute or profile
        -- attribute as a dynamic value, use handlebar notation:
        -- {{_profile.ProfileAttributeName}} or
        -- {{_calculated_attribute.CalculatedAttributeName}}.
        Values: {string}
    end

    enum DateDimensionType
        "BEFORE"
        "AFTER"
        "BETWEEN"
        "NOT_BETWEEN"
        "ON"
    end

    -- Object that segments on various Customer Profile's date fields.
    record DateDimension
        -- The action to segment with.
        DimensionType: string
        -- The values to apply the DimensionType on. To reference a calculated attribute or profile
        -- attribute as a dynamic value, use handlebar notation:
        -- {{_profile.ProfileAttributeName}} or
        -- {{_calculated_attribute.CalculatedAttributeName}}.
        Values: {string}
    end

    enum ProfileTypeDimensionType
        "INCLUSIVE"
        "EXCLUSIVE"
    end

    -- Object to hold the dimension of a profile type field to segment on.
    record ProfileTypeDimension
        -- The action to segment on.
        DimensionType: string
        -- The values to apply the DimensionType on.
        Values: {string}
    end

    -- The object used to segment on attributes within the customer profile.
    record ProfileAttributes
        -- A field to describe values to segment on within account number.
        AccountNumber: ProfileDimension
        -- A field to describe values to segment on within additional information.
        AdditionalInformation: ExtraLengthValueProfileDimension
        -- A field to describe values to segment on within first name.
        FirstName: ProfileDimension
        -- A field to describe values to segment on within last name.
        LastName: ProfileDimension
        -- A field to describe values to segment on within middle name.
        MiddleName: ProfileDimension
        -- A field to describe values to segment on within genderString.
        GenderString: ProfileDimension
        -- A field to describe values to segment on within partyTypeString.
        PartyTypeString: ProfileDimension
        -- A field to describe values to segment on within birthDate.
        BirthDate: DateDimension
        -- A field to describe values to segment on within phone number.
        PhoneNumber: ProfileDimension
        -- A field to describe values to segment on within business name.
        BusinessName: ProfileDimension
        -- A field to describe values to segment on within business phone number.
        BusinessPhoneNumber: ProfileDimension
        -- A field to describe values to segment on within home phone number.
        HomePhoneNumber: ProfileDimension
        -- A field to describe values to segment on within mobile phone number.
        MobilePhoneNumber: ProfileDimension
        -- A field to describe values to segment on within email address.
        EmailAddress: ProfileDimension
        -- A field to describe values to segment on within personal email address.
        PersonalEmailAddress: ProfileDimension
        -- A field to describe values to segment on within business email address.
        BusinessEmailAddress: ProfileDimension
        -- A field to describe values to segment on within address.
        Address: AddressDimension
        -- A field to describe values to segment on within shipping address.
        ShippingAddress: AddressDimension
        -- A field to describe values to segment on within mailing address.
        MailingAddress: AddressDimension
        -- A field to describe values to segment on within billing address.
        BillingAddress: AddressDimension
        -- A field to describe values to segment on within attributes.
        Attributes: {string : AttributeDimension}
        -- A field to describe values to segment on within profile type.
        ProfileType: ProfileTypeDimension
    end

    -- Object that holds what profile and calculated attributes to segment on.
    record Dimension
        -- Object that holds the profile attributes to segment on.
        ProfileAttributes: ProfileAttributes
        -- Object that holds the calculated attributes to segment on.
        CalculatedAttributes: {string : CalculatedAttributeDimension}
    end

    -- The source segments to build off of.
    record SourceSegment
        -- The unique name of the segment definition.
        SegmentDefinitionName: string
    end

    enum IncludeOptions
        "ALL"
        "ANY"
        "NONE"
    end

    -- Contains dimensions that determine what to segment on.
    record Group
        -- Defines the attributes to segment on.
        Dimensions: {Dimension}
        -- Defines the starting source of data.
        SourceSegments: {SourceSegment}
        -- Defines how to interact with the source data.
        SourceType: string
        -- Defines how to interact with the profiles found in the current filtering.
        Type: string
    end

    -- Contains all groups of the segment definition.
    record SegmentGroup
        -- Holds the list of groups within the segment definition.
        Groups: {Group}
        -- Defines whether to include or exclude the profiles that fit the segment criteria.
        Include: string
    end

    enum SegmentSortDataType
        "STRING"
        "NUMBER"
        "DATE"
    end

    enum SegmentSortOrder
        "ASC"
        "DESC"
    end

    enum SortAttributeType
        "PROFILE"
        "CALCULATED"
    end

    -- Defines the characteristics and rules for sorting by a specific attribute.
    record SortAttribute
        -- The name of the attribute to sort by.
        Name: string
        -- The data type of the sort attribute (e.g., string, number, date).
        DataType: string
        -- The sort order for the attribute (ascending or descending).
        Order: string
        -- The type of attribute (e.g., profile, calculated).
        Type: string
    end

    -- Defines how segments should be sorted and ordered in the results.
    record SegmentSort
        -- A list of attributes used to sort the segments and their ordering preferences.
        Attributes: {SortAttribute}
    end

    record CreateSegmentDefinitionInput
        -- The unique name of the domain.
        DomainName: string
        -- The unique name of the segment definition.
        SegmentDefinitionName: string
        -- The display name of the segment definition.
        DisplayName: string
        -- The description of the segment definition.
        Description: string
        -- Specifies the base segments and dimensions for a segment definition along with their
        -- respective relationship.
        SegmentGroups: SegmentGroup
        -- The segment SQL query.
        SegmentSqlQuery: string
        -- The segment sort.
        SegmentSort: SegmentSort
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    record CreateSegmentDefinitionOutput
        -- The name of the segment definition.
        SegmentDefinitionName: string
        -- The display name of the segment definition.
        DisplayName: string
        -- The description of the segment definition.
        Description: string
        -- The timestamp of when the segment definition was created.
        CreatedAt: number
        -- The arn of the segment definition.
        SegmentDefinitionArn: string
        -- The tags used to organize, track, or control access for this resource.
        Tags: {string : string}
    end

    -- Contains all groups of the segment definition.
    record SegmentGroupStructure
        -- Holds the list of groups within the segment definition.
        Groups: {Group}
        -- Define whether to include or exclude the profiles that fit the segment criteria.
        Include: string
    end

