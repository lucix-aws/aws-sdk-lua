    enum StandardIdentifier
        "PROFILE"
        "ASSET"
        "CASE"
        "DEVICE"
        "WEB_ANALYTICS"
        "ORDER"
        "COMMUNICATION_RECORD"
        "AIR_PREFERENCE"
        "HOTEL_PREFERENCE"
        "AIR_BOOKING"
