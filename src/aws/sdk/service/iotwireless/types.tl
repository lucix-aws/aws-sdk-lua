        -- The dimensions of the summary metric.
        Dimensions: {Dimension}
        -- The aggregation period of the summary metric.
        AggregationPeriod: string
        -- The start timestamp for the summary metric query.
        StartTimestamp: number
        -- The end timestamp for the summary metric query.
        EndTimestamp: number
    end

    record GetMetricsInput
        -- The list of queries to retrieve the summary metrics.
        SummaryMetricQueries: {SummaryMetricQuery}
    end

    enum MetricQueryStatus
        "Succeeded"
        "Failed"
    end

    -- The aggregated values of the metric.
    record MetricQueryValue
        -- The minimum of the values of all data points collected during the aggregation
        -- period.
        Min: number
        -- The maximum of the values of all the data points collected during the aggregation
        -- period.
        Max: number
        -- The sum of the values of all data points collected during the aggregation
        -- period.
        Sum: number
        -- The average of the values of all data points collected during the aggregation
        -- period.
        Avg: number
        -- The standard deviation of the values of all data points collected during the
        -- aggregation period.
        Std: number
        -- The 90th percentile of the values of all data points collected during the aggregation
        -- period.
        P90: number
    end

    -- The result of the summary metrics aggregation operation.
    record SummaryMetricQueryResult
        -- The ID of the summary metric results query operation.
        QueryId: string
        -- The status of the summary metric query result.
        QueryStatus: string
        -- The error message for the summary metric query result.
        Error: string
        -- The name of the summary metric query result.
        MetricName: string
        -- The dimensions of the metric.
        Dimensions: {Dimension}
        -- The aggregation period of the metric.
        AggregationPeriod: string
        -- The start timestamp for the summary metric query.
        StartTimestamp: number
        -- The end timestamp for the summary metric query.
        EndTimestamp: number
        -- The timestamp of each aggregation result.
        Timestamps: {number}
        -- The list of aggregated summary metric query results.
        Values: {MetricQueryValue}
        -- The units of measurement to be used for interpreting the aggregation result.
        Unit: string
    end

    record GetMetricsOutput
        -- The list of summary metrics that were retrieved.
        SummaryMetricQueryResults: {SummaryMetricQueryResult}
    end

