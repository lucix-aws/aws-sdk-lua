        -- The new name of the resource.
        -- The following special characters aren't accepted: <>^#~$
        Name: string
        -- A new description of the resource.
        Description: string
        -- The updated wireless device's configuration.
        LoRaWAN: LoRaWANUpdateDevice
        -- The integration status of the Device Location feature for LoRaWAN and Sidewalk devices.
        Positioning: string
        -- The updated sidewalk properties.
        Sidewalk: SidewalkUpdateWirelessDevice
    end

    record UpdateWirelessDeviceOutput
    end

    -- Sidewalk object information for updating an import task.
    record SidewalkUpdateImportInfo
        -- The CSV file contained in an S3 bucket that's used for appending devices to an
        -- existing import task.
        DeviceCreationFile: string
    end

    record UpdateWirelessDeviceImportTaskInput
        -- The identifier of the import task to be updated.
        Id: string
        -- The Sidewalk-related parameters of the import task to be updated.
        Sidewalk: SidewalkUpdateImportInfo
    end

    record UpdateWirelessDeviceImportTaskOutput
    end

    record UpdateWirelessGatewayInput
        -- The ID of the resource to update.
        Id: string
        -- The new name of the resource.
        -- The following special characters aren't accepted: <>^#~$
        Name: string
        -- A new description of the resource.
        Description: string
        JoinEuiFilters: {{string}}
        NetIdFilters: {string}
        -- The MaxEIRP value.
        MaxEirp: number
    end

    record UpdateWirelessGatewayOutput
    end

end

return M
