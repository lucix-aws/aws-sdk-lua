        -- and manifest files written to the output Amazon S3 bucket (OutputConfig).
        -- If you choose to use your own KMS key, you need the following permissions on the KMS key.
        -- kms:CreateGrant
        -- kms:DescribeKey
        -- kms:GenerateDataKey
        -- kms:Decrypt
