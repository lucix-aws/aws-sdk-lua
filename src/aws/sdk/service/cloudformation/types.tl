    record GetGeneratedTemplateInput
        -- The language to use to retrieve for the generated template. Supported values are:
        -- JSON
        -- YAML
        Format: string
        -- The name or Amazon Resource Name (ARN) of the generated template. The format is
        -- arn:${Partition}:cloudformation:${Region}:${Account}:generatedtemplate/${Id}.
        -- For example,
        -- arn:aws:cloudformation:us-east-1:123456789012:generatedtemplate/2e8465c1-9a80-43ea-a3a3-4f2d692fe6dc
        -- .
        GeneratedTemplateName: string
    end

    record GetGeneratedTemplateOutput
        -- The status of the template generation. Supported values are:
        -- CreatePending - the creation of the template is pending.
        -- CreateInProgress - the creation of the template is in progress.
        -- DeletePending - the deletion of the template is pending.
        -- DeleteInProgress - the deletion of the template is in progress.
        -- UpdatePending - the update of the template is pending.
        -- UpdateInProgress - the update of the template is in progress.
        -- Failed - the template operation failed.
        -- Complete - the template operation is complete.
        Status: string
        -- The template body of the generated template, in the language specified by the
        -- Language parameter.
        TemplateBody: string
    end

    record GetHookResultInput
        -- The unique identifier (ID) of the Hook invocation result that you want details about.
        -- You can get the ID from the ListHookResults
        -- operation.
        HookResultId: string
    end

    enum HookTargetAction
        "CREATE"
        "UPDATE"
        "DELETE"
        "IMPORT"
    end

    -- The HookTarget data type.
    record HookTarget
        -- The target type.
        TargetType: string
        -- The target name, for example, AWS::S3::Bucket.
        TargetTypeName: string
        -- The unique identifier of the Hook invocation target.
        TargetId: string
        -- The action that invoked the Hook.
        Action: string
    end

    record GetHookResultOutput
        -- The unique identifier of the Hook result.
        HookResultId: string
        -- The specific point in the provisioning process where the Hook is invoked.
        InvocationPoint: string
        -- The failure mode of the invocation.
        FailureMode: string
        -- The name of the Hook that was invoked.
        TypeName: string
        -- The original public type name of the Hook when an alias is used.
        -- For example, if you activate AWS::Hooks::GuardHook with alias
        -- MyCompany::Custom::GuardHook, then TypeName will be
        -- MyCompany::Custom::GuardHook and OriginalTypeName will be
        -- AWS::Hooks::GuardHook.
        OriginalTypeName: string
        -- The version identifier of the Hook that was invoked.
        TypeVersionId: string
        -- The version identifier of the Hook configuration data that was used during
        -- invocation.
        TypeConfigurationVersionId: string
        -- The Amazon Resource Name (ARN) of the Hook.
        TypeArn: string
        -- The status of the Hook invocation. The following statuses are possible:
        -- HOOK_IN_PROGRESS: The Hook is currently running.
        -- HOOK_COMPLETE_SUCCEEDED: The Hook completed successfully.
        -- HOOK_COMPLETE_FAILED: The Hook completed but failed validation.
        -- HOOK_FAILED: The Hook encountered an error during execution.
        Status: string
        -- A message that provides additional details about the Hook invocation status.
        HookStatusReason: string
        -- The timestamp when the Hook was invoked.
        InvokedAt: number
        -- Information about the target of the Hook invocation.
        Target: HookTarget
        -- A list of objects with additional information and guidance that can help you resolve a
        -- failed Hook invocation.
        Annotations: {Annotation}
    end

    -- The specified target doesn't have any requested Hook invocations.
    record HookResultNotFoundException
        Message: string
    end

