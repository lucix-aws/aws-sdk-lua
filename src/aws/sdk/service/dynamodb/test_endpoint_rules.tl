    it("{Endpoint=https://dynamodb.cn-north-1.api.amazonwebservices.com.cn, Region=cn-north-1}", function()
        local params = {
            Endpoint = "https://dynamodb.cn-north-1.api.amazonwebservices.com.cn",
            Region = "cn-north-1",
        }
