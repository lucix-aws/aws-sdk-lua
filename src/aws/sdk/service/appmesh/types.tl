        -- The gateway route metadata to be matched on.
        metadata: {GrpcGatewayRouteMetadata}
        -- The gateway route port to be matched on.
        port: number
    end

    -- An object that represents a gRPC gateway route.
    record GrpcGatewayRoute
        -- An object that represents the criteria for determining a request match.
        match: GrpcGatewayRouteMatch
        -- An object that represents the action to take if a match is determined.
        action: GrpcGatewayRouteAction
    end

    -- An object that represents the path to rewrite.
    record HttpGatewayRoutePathRewrite
        -- The exact path to rewrite.
        exact: string
    end

    -- An object representing the beginning characters of the route to rewrite.
    record HttpGatewayRoutePrefixRewrite
        -- The default prefix used to replace the incoming route prefix when rewritten.
        defaultPrefix: string
        -- The value used to replace the incoming route prefix when rewritten.
        value: string
    end

    -- An object representing the gateway route to rewrite.
    record HttpGatewayRouteRewrite
        -- The specified beginning characters to rewrite.
        prefix: HttpGatewayRoutePrefixRewrite
        -- The path to rewrite.
        path: HttpGatewayRoutePathRewrite
        -- The host name to rewrite.
        hostname: GatewayRouteHostnameRewrite
    end

    -- An object that represents the action to take if a match is determined.
    record HttpGatewayRouteAction
        -- An object that represents the target that traffic is routed to when a request matches the gateway route.
        target: GatewayRouteTarget
        -- The gateway route action to rewrite.
        rewrite: HttpGatewayRouteRewrite
    end

    -- An object that represents the method and value to match with the header value sent in a
    -- request. Specify one match method.
    record HeaderMatchMethod
        -- The value sent by the client must match the specified value exactly.
        exact: string
        -- The value sent by the client must include the specified characters.
        regex: string
        -- An object that represents the range of values to match on.
        range: MatchRange
        -- The value sent by the client must begin with the specified characters.
        prefix: string
        -- The value sent by the client must end with the specified characters.
        suffix: string
    end

    -- An object that represents the HTTP header in the gateway route.
    record HttpGatewayRouteHeader
        -- A name for the HTTP header in the gateway route that will be matched on.
        name: string
        -- Specify True to match anything except the match criteria. The default value
        -- is False.
        invert: boolean
        -- An object that represents the method and value to match with the header value sent in a
        -- request. Specify one match method.
        match: HeaderMatchMethod
    end

    enum HttpMethod
        "GET"
        "HEAD"
        "POST"
        "PUT"
        "DELETE"
        "CONNECT"
        "OPTIONS"
        "TRACE"
        "PATCH"
    end

    -- An object representing the path to match in the request.
    record HttpPathMatch
        -- The exact path to match on.
        exact: string
        -- The regex used to match the path.
        regex: string
    end

    -- An object representing the query parameter to match.
    record QueryParameterMatch
        -- The exact query parameter to match on.
        exact: string
    end

    -- An object that represents the query parameter in the request.
    record HttpQueryParameter
        -- A name for the query parameter that will be matched on.
        name: string
        -- The query parameter to match on.
        match: QueryParameterMatch
    end

    -- An object that represents the criteria for determining a request match.
    record HttpGatewayRouteMatch
        -- Specifies the path to match requests with. This parameter must always start with
        -- /, which by itself matches all requests to the virtual service name. You
        -- can also match for path-based routing of requests. For example, if your virtual service
        -- name is my-service.local and you want the route to match requests to
        -- my-service.local/metrics, your prefix should be
        -- /metrics.
        prefix: string
        -- The path to match on.
        path: HttpPathMatch
        -- The query parameter to match on.
        queryParameters: {HttpQueryParameter}
        -- The method to match on.
        method: string
        -- The host name to match on.
        hostname: GatewayRouteHostnameMatch
        -- The client request headers to match on.
        headers: {HttpGatewayRouteHeader}
        -- The port number to match on.
        port: number
    end

    -- An object that represents an HTTP gateway route.
    record HttpGatewayRoute
        -- An object that represents the criteria for determining a request match.
        match: HttpGatewayRouteMatch
        -- An object that represents the action to take if a match is determined.
        action: HttpGatewayRouteAction
    end

    -- An object that represents a gateway route specification. Specify one gateway route
    -- type.
    record GatewayRouteSpec
        -- The ordering of the gateway routes spec.
        priority: number
        -- An object that represents the specification of an HTTP gateway route.
        httpRoute: HttpGatewayRoute
        -- An object that represents the specification of an HTTP/2 gateway route.
        http2Route: HttpGatewayRoute
        -- An object that represents the specification of a gRPC gateway route.
        grpcRoute: GrpcGatewayRoute
    end

