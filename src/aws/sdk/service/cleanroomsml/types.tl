    -- Provides information about the training dataset.
    record TrainingDatasetSummary
        -- The time at which the training dataset was created.
        createTime: number
        -- The most recent time at which the training dataset was updated.
        updateTime: number
        -- The Amazon Resource Name (ARN) of the training dataset.
        trainingDatasetArn: string
        -- The name of the training dataset.
        name: string
        -- The status of the training dataset.
        status: string
        -- The description of the training dataset.
        description: string
    end

    record ListTrainingDatasetsOutput
        -- The token value used to access the next page of results.
        nextToken: string
        -- The training datasets that match the request.
        trainingDatasets: {TrainingDatasetSummary}
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource that you want to remove tags from.
        resourceArn: string
        -- The key values of tags that you want to remove.
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

end

return M
