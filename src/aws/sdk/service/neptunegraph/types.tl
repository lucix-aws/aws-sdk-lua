        "CSV"
        "OPEN_CYPHER"
        "PARQUET"
        "NTRIPLES"
    end

    enum ImportTaskStatus
        "INITIALIZING"
        "EXPORTING"
        "ANALYZING_DATA"
        "IMPORTING"
        "REPROVISIONING"
        "ROLLING_BACK"
        "SUCCEEDED"
        "FAILED"
        "CANCELLING"
        "CANCELLED"
        "DELETED"
