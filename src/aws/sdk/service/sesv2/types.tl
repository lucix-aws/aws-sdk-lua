    -- A request to enable or disable the automatic IP address warm-up feature.
    record PutAccountDedicatedIpWarmupAttributesInput
        -- Enables or disables the automatic warm-up feature for dedicated IP addresses that are
        -- associated with your Amazon SES account in the current Amazon Web Services Region. Set to true
        -- to enable the automatic warm-up feature, or set to false to disable
        -- it.
        AutoWarmupEnabled: boolean
    end

    -- An HTTP 200 response if the request succeeds, or an error message if the request
    -- fails.
    record PutAccountDedicatedIpWarmupAttributesOutput
    end

    -- A request to submit new account details.
    record PutAccountDetailsInput
        -- The type of email your account will send.
        MailType: string
        -- The URL of your website. This information helps us better understand the type of
        -- content that you plan to send.
        WebsiteURL: string
        -- The language you would prefer to be contacted with.
        ContactLanguage: string
        -- A description of the types of email that you plan to send.
        UseCaseDescription: string
        -- Additional email addresses that you would like to be notified regarding Amazon SES
        -- matters.
        AdditionalContactEmailAddresses: {string}
        -- Indicates whether or not your account should have production access in the current
        -- Amazon Web Services Region.
        -- If the value is false, then your account is in the
        -- sandbox. When your account is in the sandbox, you can only send
        -- email to verified identities.
        -- If the value is true, then your account has production access. When your
        -- account has production access, you can send email to any address. The sending quota and
        -- maximum sending rate for your account vary based on your specific use case.
        ProductionAccessEnabled: boolean
    end

    -- An HTTP 200 response if the request succeeds, or an error message if the request
    -- fails.
    record PutAccountDetailsOutput
    end

    -- A request to set the pricing plan for your Amazon SES account.
    record PutAccountPricingAttributesInput
        -- The pricing plan to apply to your Amazon SES account. Can be one of the following:
        -- NONE – No pricing plan is applied; billing follows per-feature
        -- pricing.
        -- ESSENTIALS – Baseline Amazon SES capabilities and select premium
        -- features.
        -- PRO – Includes everything in ESSENTIALS, plus
        -- additional premium features for growing senders.
        -- ENTERPRISE – Includes everything in PRO, plus
        -- features intended for large-scale senders.
        Plan: string
    end

    -- An HTTP 200 response if the request succeeds, or an error response if the request
    -- fails.
    record PutAccountPricingAttributesOutput
    end

    -- A request to change the ability of your account to send email.
    record PutAccountSendingAttributesInput
        -- Enables or disables your account's ability to send email. Set to true to
        -- enable email sending, or set to false to disable email sending.
        -- If Amazon Web Services paused your account's ability to send email, you can't use this operation
        -- to resume your account's ability to send email.
        SendingEnabled: boolean
    end

    -- An HTTP 200 response if the request succeeds, or an error message if the request
    -- fails.
    record PutAccountSendingAttributesOutput
    end

    -- A request to change your account's suppression preferences.
    record PutAccountSuppressionAttributesInput
        -- A list that contains the reasons that email addresses will be automatically added to
        -- the suppression list for your account. This list can contain any or all of the
        -- following:
        -- COMPLAINT – Amazon SES adds an email address to the suppression
        -- list for your account when a message sent to that address results in a
        -- complaint.
        -- BOUNCE – Amazon SES adds an email address to the suppression
        -- list for your account when a message sent to that address results in a hard
        -- bounce.
        SuppressedReasons: {string}
        -- An object that contains additional suppression attributes for your account.
        ValidationAttributes: SuppressionValidationAttributes
    end

    -- An HTTP 200 response if the request succeeds, or an error message if the request
    -- fails.
    record PutAccountSuppressionAttributesOutput
    end

    -- A request to submit new account VDM attributes.
    record PutAccountVdmAttributesInput
        -- The VDM attributes that you wish to apply to your Amazon SES account.
        VdmAttributes: VdmAttributes
    end

    record PutAccountVdmAttributesOutput
    end

