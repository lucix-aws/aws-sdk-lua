    record PutConfigurationSetArchivingOptionsInput
        -- The name of the configuration set to associate with a MailManager archive.
        ConfigurationSetName: string
        -- The Amazon Resource Name (ARN) of the MailManager archive that the Amazon SES API v2 sends email
        -- to.
