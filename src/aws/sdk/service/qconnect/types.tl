        isActive: boolean
        -- The version number of the message template version.
        versionNumber: number
        -- The description of the message template.
        description: string
        -- The source configuration summary of the message template.
        sourceConfigurationSummary: MessageTemplateSourceConfigurationSummary
        groupingConfiguration: GroupingConfiguration
        -- The language code value for the language in which the quick response is written. The supported language codes include de_DE, en_US, es_ES, fr_FR, id_ID, it_IT, ja_JP, ko_KR, pt_BR, zh_CN, zh_TW
        language: string
        -- The tags used to organize, track, or control access for this resource.
        tags: {string : string}
    end

    record SearchMessageTemplatesOutput
        -- The results of the message template search.
        results: {MessageTemplateSearchResultData}
        -- If there are additional results, this is the token for the next set of results.
        nextToken: string
    end

    enum QuickResponseFilterOperator
        "EQUALS"
        "PREFIX"
    end

    -- The quick response fields to filter the quick response query results by. The following is the list of supported field names. name description shortcutKey isActive channels language contentType createdTime lastModifiedTime lastModifiedBy groupingConfiguration.criteria groupingConfiguration.values
    record QuickResponseFilterField
        -- The name of the attribute field to filter the quick responses by.
        name: string
        -- The values of attribute field to filter the quick response by.
        values: {string}
        -- The operator to use for filtering.
        operator: string
        -- Whether to treat null value as a match for the attribute field.
        includeNoExistence: boolean
    end

    -- The quick response fields to order the quick response query results by. The following is the list of supported field names. name description shortcutKey isActive channels language contentType createdTime lastModifiedTime lastModifiedBy groupingConfiguration.criteria groupingConfiguration.values
    record QuickResponseOrderField
        -- The name of the attribute to order the quick response query results by.
        name: string
        -- The order at which the quick responses are sorted by.
        order: string
    end

    enum QuickResponseQueryOperator
        "CONTAINS"
        "CONTAINS_AND_PREFIX"
    end

    -- The quick response fields to query quick responses by. The following is the list of supported field names. content name description shortcutKey
    record QuickResponseQueryField
        -- The name of the attribute to query the quick responses by.
        name: string
        -- The values of the attribute to query the quick responses by.
        values: {string}
        -- The operator to use for matching attribute field values in the query.
        operator: string
        -- Whether the query expects only exact matches on the attribute field values. The results of the query will only include exact matches if this parameter is set to false.
        allowFuzziness: boolean
        -- The importance of the attribute field when calculating query result relevancy scores. The value set for this parameter affects the ordering of search results.
        priority: string
    end

    -- Information about the import job.
    record QuickResponseSearchExpression
        -- The quick response query expressions.
        queries: {QuickResponseQueryField}
        -- The configuration of filtering rules applied to quick response query results.
        filters: {QuickResponseFilterField}
        -- The quick response attribute fields on which the query results are ordered.
        orderOnField: QuickResponseOrderField
    end

    record SearchQuickResponsesInput
        -- The identifier of the knowledge base. This should be a QUICK_RESPONSES type knowledge base. Can be either the ID or the ARN. URLs cannot contain the ARN.
        knowledgeBaseId: string
        -- The search expression for querying the quick response.
        searchExpression: QuickResponseSearchExpression
        -- The token for the next set of results. Use the value returned in the previous response in the next request to retrieve the next set of results.
        nextToken: string
        -- The maximum number of results to return per page.
        maxResults: number
        -- The user-defined Amazon Connect contact attributes to be resolved when search results are returned.
        attributes: {string : string}
    end

    -- The result of quick response search.
    record QuickResponseSearchResultData
        -- The Amazon Resource Name (ARN) of the quick response.
        quickResponseArn: string
        -- The identifier of the quick response.
        quickResponseId: string
        -- The Amazon Resource Name (ARN) of the knowledge base.
        knowledgeBaseArn: string
        -- The identifier of the knowledge base. Can be either the ID or the ARN. URLs cannot contain the ARN.
        knowledgeBaseId: string
        -- The name of the quick response.
        name: string
        -- The media type of the quick response content. Use application/x.quickresponse;format=plain for quick response written in plain text. Use application/x.quickresponse;format=markdown for quick response written in richtext.
        contentType: string
        -- The resource status of the quick response.
        status: string
        -- The contents of the quick response.
        contents: QuickResponseContents
        -- The timestamp when the quick response was created.
        createdTime: number
        -- The timestamp when the quick response search result data was last modified.
        lastModifiedTime: number
        -- Whether the quick response is active.
        isActive: boolean
        -- The description of the quick response.
        description: string
        -- The configuration information of the user groups that the quick response is accessible to.
        groupingConfiguration: GroupingConfiguration
        -- The shortcut key of the quick response. The value should be unique across the knowledge base.
        shortcutKey: string
        -- The Amazon Resource Name (ARN) of the user who last updated the quick response search result data.
        lastModifiedBy: string
        -- The Amazon Connect contact channels this quick response applies to. The supported contact channel types include Chat.
        channels: {string}
        -- The language code value for the language in which the quick response is written.
        language: string
        -- The user defined contact attributes that are not resolved when the search result is returned.
        attributesNotInterpolated: {string}
        -- The user defined contact attributes that are resolved when the search result is returned.
        attributesInterpolated: {string}
        -- The tags used to organize, track, or control access for this resource.
        tags: {string : string}
    end

    record SearchQuickResponsesOutput
        -- The results of the quick response search.
        results: {QuickResponseSearchResultData}
        -- The token for the next set of results. Use the value returned in the previous response in the next request to retrieve the next set of results.
        nextToken: string
    end

    record StartContentUploadInput
        -- The identifier of the knowledge base. Can be either the ID or the ARN. URLs cannot contain the ARN.
        knowledgeBaseId: string
        -- The type of content to upload.
        contentType: string
        -- The expected expiration time of the generated presigned URL, specified in minutes.
        presignedUrlTimeToLive: number
    end

    record StartContentUploadOutput
        -- The identifier of the upload.
        uploadId: string
        -- The URL of the upload.
        url: string
        -- The expiration time of the URL as an epoch timestamp.
        urlExpiry: number
        -- The headers to include in the upload.
        headersToInclude: {string : string}
    end

    record StartImportJobInput
        -- The identifier of the knowledge base. Can be either the ID or the ARN. URLs cannot contain the ARN. For importing Amazon Q in Connect quick responses, this should be a QUICK_RESPONSES type knowledge base.
        knowledgeBaseId: string
        -- The type of the import job. For importing quick response resource, set the value to QUICK_RESPONSES.
        importJobType: string
        -- A pointer to the uploaded asset. This value is returned by StartContentUpload.
        uploadId: string
        -- The tags used to organize, track, or control access for this resource.
        clientToken: string
        -- The metadata fields of the imported Amazon Q in Connect resources.
        metadata: {string : string}
        -- The configuration information of the external source that the resource data are imported from.
        externalSourceConfiguration: ExternalSourceConfiguration
    end

    record StartImportJobOutput
        -- The import job.
        importJob: ImportJobData
    end

    record UpdateKnowledgeBaseTemplateUriInput
        -- The identifier of the knowledge base. This should not be a QUICK_RESPONSES type knowledge base. Can be either the ID or the ARN. URLs cannot contain the ARN.
        knowledgeBaseId: string
        -- The template URI to update.
        templateUri: string
    end

    record UpdateKnowledgeBaseTemplateUriOutput
        -- The knowledge base to update.
        knowledgeBase: KnowledgeBaseData
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        resourceArn: string
    end

    record ListTagsForResourceOutput
        -- The tags used to organize, track, or control access for this resource.
        tags: {string : string}
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        resourceArn: string
        -- The tags used to organize, track, or control access for this resource.
        tags: {string : string}
    end

    record TagResourceOutput
    end

    -- Amazon Q in Connect throws this exception if you have too many tags in your tag set.
    record TooManyTagsException
        message: string
        -- The specified resource name.
        resourceName: string
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the resource.
        resourceArn: string
        -- The tag keys.
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

    -- Message content value - can be text, tool invocation, tool result, or reasoning
    record SpanMessageValue
        -- Text message content
        text: SpanTextValue
        -- Tool invocation message content
        toolUse: SpanToolUseValue
        -- Tool result message content
        toolResult: SpanToolResultValue
        reasoning: SpanReasoningValue
    end

    -- Tool result message content
    record SpanToolResultValue
        -- Relates this result back to the tool invocation
        toolUseId: string
        -- The tool results
        values: {SpanMessageValue}
        -- The tool invocation error if failed
        error: string
    end

    -- Configuration for filtering content during retrieval operations.
    record RetrievalFilterConfiguration
        -- Filter configuration that requires all conditions to be met.
        andAll: {RetrievalFilterConfiguration}
        -- Filter configuration for exact equality matching.
        equals: FilterAttribute
        -- Filter configuration for greater than comparison.
        greaterThan: FilterAttribute
        -- Filter configuration for greater than or equal comparison.
        greaterThanOrEquals: FilterAttribute
        -- Filter configuration for less than comparison.
        lessThan: FilterAttribute
        -- Filter configuration for less than or equal comparison.
        lessThanOrEquals: FilterAttribute
        -- Filter configuration for checking if a list contains a value.
        listContains: FilterAttribute
        -- Filter configuration for inequality matching.
        notEquals: FilterAttribute
        -- Filter configuration for exclusion from a set of values.
        notIn: FilterAttribute
        -- Filter configuration where any condition can be met.
        orAll: {RetrievalFilterConfiguration}
        -- Filter configuration for prefix matching.
        startsWith: FilterAttribute
        -- Filter configuration for substring matching.
        stringContains: FilterAttribute
    end

    -- A message in the conversation history with participant role and content values
    record SpanMessage
        -- Unique message identifier
        messageId: string
        -- Message source role
        participant: string
        -- Message timestamp
        timestamp: number
        -- Message content values (text, tool use, tool result, reasoning)
        values: {SpanMessageValue}
    end

    -- Configuration for content retrieval operations.
    record RetrievalConfiguration
        -- The knowledge source configuration for content retrieval.
        knowledgeSource: KnowledgeSource
        -- The filter configuration for content retrieval.
        filter: RetrievalFilterConfiguration
        -- The number of results to retrieve.
        numberOfResults: number
        -- Override setting for the knowledge base search type during retrieval.
        overrideKnowledgeBaseSearchType: string
    end

    record RetrieveInput
        -- The identifier of the Amazon Q in Connect assistant for content retrieval.
        assistantId: string
        -- The configuration for the content retrieval operation.
        retrievalConfiguration: RetrievalConfiguration
        -- The query for content retrieval.
        retrievalQuery: string
    end

    -- Details about the data.
    record DataDetails
        -- Details about the content data.
        contentData: ContentDataDetails
        -- Details about the generative data.
        generativeData: GenerativeDataDetails
        -- Details about the intent data.
        intentDetectedData: IntentDetectedDataDetails
        -- Details about the content data.
        sourceContentData: SourceContentDataDetails
        -- Details about the generative chunk data.
        generativeChunkData: GenerativeChunkDataDetails
        -- Streaming chunk data for email response generation containing partial response content.
        emailResponseChunkData: EmailResponseChunkDataDetails
        -- Streaming chunk data for email overview containing partial overview content.
        emailOverviewChunkData: EmailOverviewChunkDataDetails
        -- Streaming chunk data for email generative answers containing partial knowledge-based response content.
        emailGenerativeAnswerChunkData: EmailGenerativeAnswerChunkDataDetails
        -- Details about case summarization chunk data.
        caseSummarizationChunkData: CaseSummarizationChunkDataDetails
        -- Details about suggested message data.
        suggestedMessageData: SuggestedMessageDataDetails
        -- Details about notes data.
        notesData: NotesDataDetails
        -- Details about notes chunk data.
        notesChunkData: NotesChunkDataDetails
    end

    -- Summary of the data.
    record DataSummary
        -- Reference information about the content.
        reference: DataReference
        -- Details about the data.
        details: DataDetails
    end

    -- Details of streaming chunk data for email generative answers including completion text and references.
    record EmailGenerativeAnswerChunkDataDetails
        -- The partial or complete text content of the generative answer response.
        completion: string
        -- Source references and citations from knowledge base articles used to generate the answer.
        references: {DataSummary}
        -- Token for retrieving the next chunk of streaming response data, if available.
        nextChunkToken: string
    end

    -- Details about the generative chunk data.
    record GenerativeChunkDataDetails
        -- A chunk of the LLM response.
        completion: string
        -- The references used to generate the LLM response.
        references: {DataSummary}
        -- The token for the next set of chunks. Use the value returned in the previous response in the next request to retrieve the next set of chunks.
        nextChunkToken: string
    end

    -- Details about generative data.
    record GenerativeDataDetails
        -- The LLM response.
        completion: string
        -- The references used to generative the LLM response.
        references: {DataSummary}
        -- Details about the generative content ranking data.
        rankingData: RankingData
    end

    -- Information about the recommendation.
    record RecommendationData
        -- The identifier of the recommendation.
        recommendationId: string
        -- The recommended document.
        document: Document
        -- The relevance score of the recommendation.
        relevanceScore: number
        -- The relevance level of the recommendation.
        relevanceLevel: string
        -- Summary of the recommended content.
        data: DataSummary
    end

    -- Information about the result.
    record ResultData
        -- The identifier of the result data.
        resultId: string
        -- The document.
        document: Document
        -- The relevance score of the results.
        relevanceScore: number
        -- Summary of the recommended content.
        data: DataSummary
    end

    -- Contextual attributes capturing operation details, LLM configuration, usage metrics, and conversation data
    record SpanAttributes
        -- Action being performed
        operationName: string
        -- Model provider identifier (e.g., aws.bedrock)
        providerName: string
        -- Error classification if span failed (e.g., throttle, timeout)
        errorType: string
        -- Amazon Connect agent ID
        agentId: string
        -- Amazon Connect instance ARN
        instanceArn: string
        -- Amazon Connect contact identifier
        contactId: string
        -- Amazon Connect contact identifier
        initialContactId: string
        -- Session name
        sessionName: string
        -- AI agent ARN
        aiAgentArn: string
        -- AI agent type
        aiAgentType: string
        -- AI agent name
        aiAgentName: string
        -- AI agent identifier
        aiAgentId: string
        -- AI agent version number
        aiAgentVersion: number
        -- Entity that invoked the AI agent
        aiAgentInvoker: string
        -- AI agent orchestrator use case
        aiAgentOrchestratorUseCase: string
        -- LLM model ID for request (e.g., anthropic.claude-3-sonnet)
        requestModel: string
        -- Maximum tokens configured for generation
        requestMaxTokens: number
        -- Sampling temperature for generation
        temperature: number
        -- Top-p sampling parameter for generation
        topP: number
        -- Actual model used for response (usually matches requestModel)
        responseModel: string
        -- Generation termination reasons (e.g., stop, max_tokens)
        responseFinishReasons: {string}
        -- Number of input tokens in prompt
        usageInputTokens: number
        -- Number of output tokens in response
        usageOutputTokens: number
        -- Total tokens consumed (input + output)
        usageTotalTokens: number
        -- Number of input tokens that were retrieved from cache
        cacheReadInputTokens: number
        -- Number of input tokens that were written to cache in this request
        cacheWriteInputTokens: number
        -- Input message collection sent to LLM
        inputMessages: {SpanMessage}
        -- Output message collection received from LLM
        outputMessages: {SpanMessage}
        -- System prompt instructions
        systemInstructions: {SpanMessageValue}
        -- AI prompt ARN
        promptArn: string
        -- AI prompt identifier
        promptId: string
        -- AI prompt type
        promptType: string
        -- AI prompt name
        promptName: string
        -- AI prompt version number
        promptVersion: number
        -- Time to first token in milliseconds, measured from when Amazon Bedrock was invoked to when the first token was returned
        timeToFirstTokenMs: number
    end

    -- A span represents a unit of work during AI agent execution, capturing timing, status, and contextual attributes.
    record Span
        -- Unique span identifier
        spanId: string
        -- UUID of the Connect AI Assistant resource
        assistantId: string
        -- UUID of the Connect AI Session resource
        sessionId: string
        -- Parent span identifier for hierarchy. Null for root spans.
        parentSpanId: string
        -- Service-defined operation name
        spanName: string
        -- Operation relationship type
        spanType: string
        -- Operation start time in milliseconds since epoch
        startTimestamp: number
        -- Operation end time in milliseconds since epoch
        endTimestamp: number
        -- Span completion status
        status: string
        -- Human-readable error description when status is ERROR or TIMEOUT
        statusDescription: string
        -- The service request ID that initiated the operation
        requestId: string
        -- The origin request identifier for end-to-end tracing.
        originRequestId: string
        -- Span-specific contextual attributes
        attributes: SpanAttributes
    end

    record GetRecommendationsOutput
        -- The recommendations.
        recommendations: {RecommendationData}
        -- The triggers corresponding to recommendations.
        triggers: {RecommendationTrigger}
    end

    record QueryAssistantOutput
        -- The results of the query.
        results: {ResultData}
        -- If there are additional results, this is the token for the next set of results.
        nextToken: string
    end

    record ListSpansOutput
        -- Array of span objects for the session
        spans: {Span}
        -- Pagination token for retrieving additional results
        nextToken: string
    end

end

return M
