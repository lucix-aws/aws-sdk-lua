        arn: string
    end

    record CreateModelManifestInput
        -- The name of the vehicle model to create.
        name: string
        -- A brief description of the vehicle model.
        description: string
        -- A list of nodes, which are a general abstraction of signals.
        nodes: {string}
        -- The Amazon Resource Name (ARN) of a signal catalog.
        signalCatalogArn: string
        -- Metadata that can be used to manage the vehicle model.
        tags: {Tag}
    end

    record CreateModelManifestOutput
        -- The name of the created vehicle model.
        name: string
        -- The ARN of the created vehicle model.
        arn: string
    end

    -- A reason that a signal isn't valid.
    record InvalidSignal
        -- The name of the signal that isn't valid.
        name: string
        -- A message about why the signal isn't valid.
        reason: string
    end

    -- The request couldn't be completed because it contains signals that aren't
    -- valid.
    record InvalidSignalsException
        message: string
        -- The signals which caused the exception.
        invalidSignals: {InvalidSignal}
    end

    enum NodeDataEncoding
        "BINARY"
        "TYPED"
    end

    -- Represents a member of the complex data structure. The data type of the property can
    -- be either primitive or another struct.
    record CustomProperty
        -- The fully qualified name of the custom property. For example, the fully qualified name
        -- of a custom property might be
        -- ComplexDataTypes.VehicleDataTypes.SVMCamera.FPS.
        fullyQualifiedName: string
        -- The data type for the custom property.
        dataType: string
        -- Indicates whether the property is binary data.
        dataEncoding: string
        -- A brief description of the custom property.
        description: string
        -- The deprecation message for the node or the branch that was moved or deleted.
        deprecationMessage: string
        -- A comment in addition to the description.
        comment: string
        -- The fully qualified name of the struct node for the custom property if the data type
        -- of the custom property is Struct or StructArray.
        structFullyQualifiedName: string
    end

    -- An input component that reports the environmental condition of a vehicle.
    -- You can collect data about fluid levels, temperatures, vibrations, or battery
    -- voltage from sensors.
    record Sensor
        -- The fully qualified name of the sensor. For example, the fully qualified name of a
        -- sensor might be Vehicle.Body.Engine.Battery.
        fullyQualifiedName: string
        -- The specified data type of the sensor.
        dataType: string
        -- A brief description of a sensor.
        description: string
        -- The scientific unit of measurement for data collected by the sensor.
        unit: string
        -- A list of possible values a sensor can take.
        allowedValues: {string}
        -- The specified possible minimum value of the sensor.
        min: number
        -- The specified possible maximum value of the sensor.
        max: number
        -- The deprecation message for the node or the branch that was moved or deleted.
        deprecationMessage: string
        -- A comment in addition to the description.
        comment: string
        -- The fully qualified name of the struct node for a sensor if the data type of the
        -- actuator is Struct or StructArray. For example, the struct
        -- fully qualified name of a sensor might be Vehicle.ADAS.CameraStruct.
        structFullyQualifiedName: string
    end

    -- The custom structure represents a complex or higher-order data structure.
    record CustomStruct
        -- The fully qualified name of the custom structure. For example, the fully qualified
        -- name of a custom structure might be
        -- ComplexDataTypes.VehicleDataTypes.SVMCamera.
        fullyQualifiedName: string
        -- A brief description of the custom structure.
        description: string
        -- The deprecation message for the node or the branch that was moved or deleted.
        deprecationMessage: string
        -- A comment in addition to the description.
        comment: string
    end

    -- A general abstraction of a signal. A node can be specified as an actuator, attribute,
    -- branch, or sensor.
    record Node
        -- Information about a node specified as a branch.
        -- A group of signals that are defined in a hierarchical structure.
        branch: Branch
        sensor: Sensor
        -- Information about a node specified as an actuator.
        -- An actuator is a digital representation of a vehicle device.
        actuator: Actuator
        -- Information about a node specified as an attribute.
        -- An attribute represents static information about a vehicle.
        attribute: Attribute
        -- Represents a complex or higher-order data structure.
        struct: CustomStruct
        -- Represents a member of the complex data structure. The datatype of the
        -- property can be either primitive or another struct.
        property: CustomProperty
    end

    record CreateSignalCatalogInput
        -- The name of the signal catalog to create.
        name: string
        -- A brief description of the signal catalog.
        description: string
        -- A list of information about nodes, which are a general abstraction of signals. For
        -- more information, see the API data type.
        nodes: {Node}
        -- Metadata that can be used to manage the signal catalog.
        tags: {Tag}
    end

    record CreateSignalCatalogOutput
        -- The name of the created signal catalog.
        name: string
        -- The ARN of the created signal catalog.
        arn: string
    end

    -- The specified node type doesn't match the expected node type for a node. You can
    -- specify the node type as branch, sensor, actuator, or attribute.
    record InvalidNodeException
        -- The specified node type isn't valid.
        invalidNodes: {Node}
        -- The reason the node validation failed.
        reason: string
        message: string
    end

    record CreateStateTemplateInput
        -- The name of the state template.
        name: string
        -- A brief description of the state template.
        description: string
        -- The ARN of the signal catalog associated with the state template.
        signalCatalogArn: string
        -- A list of signals from which data is collected. The state template properties contain the fully qualified names of the signals.
        stateTemplateProperties: {string}
        -- A list of vehicle attributes to associate with the payload published on the state template's
        -- MQTT topic. (See
        -- Processing last known state vehicle data using MQTT messaging). For example, if you add
        -- Vehicle.Attributes.Make and Vehicle.Attributes.Model attributes, Amazon Web Services IoT FleetWise
        -- will enrich the protobuf encoded payload with those attributes in the extraDimensions
        -- field.
        dataExtraDimensions: {string}
        -- A list of vehicle attributes to associate with user properties of the messages published on the
        -- state template's MQTT topic. (See
        -- Processing last known state vehicle data using MQTT messaging). For example, if you add
        -- Vehicle.Attributes.Make and Vehicle.Attributes.Model attributes, Amazon Web Services IoT FleetWise
        -- will include these attributes as User Properties with the MQTT message.
        -- Default: An empty array
        metadataExtraDimensions: {string}
        -- Metadata that can be used to manage the state template.
        tags: {Tag}
    end

    record CreateStateTemplateOutput
        -- The name of the state template.
        name: string
        -- The Amazon Resource Name (ARN) of the state template.
        arn: string
        -- The unique ID of the state template.
        id: string
    end

    record CreateVehicleInput
        -- The unique ID of the vehicle to create.
        vehicleName: string
        -- The Amazon Resource Name ARN of a vehicle model.
        modelManifestArn: string
        -- The ARN of a decoder manifest.
        decoderManifestArn: string
        -- Static information about a vehicle in a key-value pair. For example:
        -- "engineType" : "1.3 L R2"
        -- To use attributes with Campaigns or State Templates, you must include them using the
        -- request parameters dataExtraDimensions and/or metadataExtraDimensions
        -- (for state templates only) when creating your campaign/state template.
        attributes: {string : string}
        -- An option to create a new Amazon Web Services IoT thing when creating a vehicle, or to validate an
        -- existing Amazon Web Services IoT thing as a vehicle.
        -- Default:
        associationBehavior: string
        -- Metadata that can be used to manage the vehicle.
        tags: {Tag}
        -- Associate state templates with the vehicle. You can monitor the last known state of the vehicle in near real time.
        stateTemplates: {StateTemplateAssociation}
    end

    record CreateVehicleOutput
        -- The unique ID of the created vehicle.
        vehicleName: string
        -- The ARN of the created vehicle.
        arn: string
        -- The ARN of a created or validated Amazon Web Services IoT thing.
        thingArn: string
    end

