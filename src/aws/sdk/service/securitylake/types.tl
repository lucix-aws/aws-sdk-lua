        -- using the returned token to retrieve the next page.
        nextToken: string
    end

    record ListTagsForResourceInput
        -- The Amazon Resource Name (ARN) of the Amazon Security Lake resource for which you want to retrieve the tags.
        resourceArn: string
    end

    record ListTagsForResourceOutput
        -- An array of objects, one for each tag (key and value) that’s associated with the Amazon Security Lake resource.
        tags: {Tag}
    end

    record RegisterDataLakeDelegatedAdministratorInput
        -- The Amazon Web Services account ID of the Security Lake delegated administrator.
        accountId: string
    end

    record RegisterDataLakeDelegatedAdministratorOutput
    end

    record UpdateSubscriberInput
        -- A value created by Security Lake that uniquely identifies your subscription.
        subscriberId: string
        -- The Amazon Web Services identity used to access your data.
        subscriberIdentity: AwsIdentity
        -- The name of the Security Lake account subscriber.
        subscriberName: string
        -- The description of the Security Lake account subscriber.
        subscriberDescription: string
        -- The supported Amazon Web Services services from which logs and events are collected. For
        -- the list of supported Amazon Web Services services, see the Amazon Security Lake User Guide.
        sources: {LogSourceResource}
    end

    record UpdateSubscriberOutput
        -- The updated subscriber information.
        subscriber: SubscriberResource
    end

    record UpdateSubscriberNotificationInput
        -- The subscription ID for which the subscription notification is specified.
        subscriberId: string
        -- The configuration for subscriber notification.
        configuration: NotificationConfiguration
    end

    record UpdateSubscriberNotificationOutput
        -- The subscriber endpoint to which exception messages are posted.
        subscriberEndpoint: string
    end

    record TagResourceInput
        -- The Amazon Resource Name (ARN) of the Amazon Security Lake resource to add or update the tags for.
        resourceArn: string
        -- An array of objects, one for each tag (key and value) to associate with the Amazon Security Lake resource. For each tag, you must
        -- specify both a tag key and a tag value. A tag value cannot be null, but it can be an empty string.
        tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The Amazon Resource Name (ARN) of the Amazon Security Lake resource to remove one or more tags from.
        resourceArn: string
        -- A list of one or more tag keys. For each value in the list, specify the tag key for a tag to remove from the Amazon Security Lake resource.
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateDataLakeExceptionSubscriptionInput
        -- The subscription protocol to which exception messages are posted.
        subscriptionProtocol: string
        -- The account that is subscribed to receive exception notifications.
        notificationEndpoint: string
        -- The time-to-live (TTL) for the exception message to remain. It is the duration of time until which the exception message remains.
        exceptionTimeToLive: number
    end

    record UpdateDataLakeExceptionSubscriptionOutput
    end

end

return M
