    end

    record UpdatePhoneNumberSettingsOutput
    end

    record UpdateProxySessionInput
        -- The Voice Connector ID.
        VoiceConnectorId: string
        -- The proxy session ID.
        ProxySessionId: string
        -- The proxy session capabilities.
