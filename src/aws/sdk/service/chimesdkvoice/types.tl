    end

    record PutVoiceConnectorTerminationCredentialsOutput
    end

    record RestorePhoneNumberInput
        -- The ID of the phone number being restored.
        PhoneNumberId: string
    end

    record RestorePhoneNumberOutput
        -- The restored phone number.
        PhoneNumber: PhoneNumber
    end

    record SearchAvailablePhoneNumbersInput
        -- Confines a search to just the phone numbers associated with the specified area code.
        AreaCode: string
        -- Confines a search to just the phone numbers associated with the specified city.
        City: string
        -- Confines a search to just the phone numbers associated with the specified country.
        Country: string
        -- Confines a search to just the phone numbers associated with the specified state.
        State: string
        -- Confines a search to just the phone numbers associated with the specified toll-free prefix.
        TollFreePrefix: string
        -- Confines a search to just the phone numbers associated with the specified phone number type, either local or toll-free.
        PhoneNumberType: string
        -- The maximum number of results to return.
        MaxResults: number
        -- The token used to return the next page of results.
        NextToken: string
    end

    record SearchAvailablePhoneNumbersOutput
        -- Confines a search to just the phone numbers in the E.164 format.
        E164PhoneNumbers: {string}
        -- The token used to return the next page of results.
        NextToken: string
    end

    record StartSpeakerSearchTaskInput
        -- The Voice Connector ID.
        VoiceConnectorId: string
        -- The transaction ID of the call being analyzed.
        TransactionId: string
        -- The ID of the voice profile domain that will store the voice profile.
        VoiceProfileDomainId: string
        -- The unique identifier for the client request. Use a different token for different speaker search tasks.
        ClientRequestToken: string
        -- Specifies which call leg to stream for speaker search.
        CallLeg: string
    end

    record StartSpeakerSearchTaskOutput
        -- The details of the speaker search task.
        SpeakerSearchTask: SpeakerSearchTask
    end

    -- A well-formed request couldn't be followed due to semantic errors.
    record UnprocessableEntityException
        Code: string
        Message: string
    end

    enum LanguageCode
        "en-US"
    end

    record StartVoiceToneAnalysisTaskInput
        -- The Voice Connector ID.
        VoiceConnectorId: string
        -- The transaction ID.
        TransactionId: string
        -- The language code.
        LanguageCode: string
        -- The unique identifier for the client request. Use a different token for different voice tone analysis
        -- tasks.
        ClientRequestToken: string
    end

    record StartVoiceToneAnalysisTaskOutput
        -- The details of the voice tone analysis task.
        VoiceToneAnalysisTask: VoiceToneAnalysisTask
    end

    record StopSpeakerSearchTaskInput
        -- The Voice Connector ID.
        VoiceConnectorId: string
        -- The speaker search task ID.
        SpeakerSearchTaskId: string
    end

    record StopSpeakerSearchTaskOutput
    end

    record StopVoiceToneAnalysisTaskInput
        -- The Voice Connector ID.
        VoiceConnectorId: string
        -- The ID of the voice tone analysis task.
        VoiceToneAnalysisTaskId: string
    end

    record StopVoiceToneAnalysisTaskOutput
    end

    record TagResourceInput
        -- The ARN of the resource being tagged.
        ResourceARN: string
        -- A list of the tags being added to the resource.
