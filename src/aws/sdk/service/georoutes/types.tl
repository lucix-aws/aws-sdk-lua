        -- The vehicle License Plate.
        LicensePlate: RouteVehicleLicensePlate
        -- Maximum speed specified. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. Unit: kilometers per hour
        MaxSpeed: number
        -- The number of occupants in the vehicle. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. Default value: 1
        Occupancy: number
    end

    -- Options related to the pedestrian. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
    record RoutePedestrianOptions
        -- Walking speed in Kilometers per hour.
        Speed: number
    end

    -- Travel mode options when the provided travel mode is Scooter. For GrabMaps customers, ap-southeast-1 and ap-southeast-5 regions support only LicensePlate options.
    record RouteScooterOptions
        -- Engine type of the vehicle. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        EngineType: string
        -- The vehicle License Plate.
        LicensePlate: RouteVehicleLicensePlate
        -- Maximum speed Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. Unit: kilometers per hour
        MaxSpeed: number
        -- The number of occupants in the vehicle. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. Default value: 1
        Occupancy: number
    end

    enum RouteHazardousCargoType
        "Combustible"
        "Corrosive"
        "Explosive"
        "Flammable"
        "Gas"
        "HarmfulToWater"
        "Organic"
        "Other"
        "Poison"
        "PoisonousInhalation"
        "Radioactive"
    end

    -- Trailer options corresponding to the vehicle.
    record RouteTrailerOptions
        -- Total number of axles of the vehicle.
        AxleCount: number
        -- Number of trailers attached to the vehicle. Default value: 0
        TrailerCount: number
    end

    enum RouteTruckType
        "LightTruck"
        "StraightTruck"
        "Tractor"
    end

    -- Travel mode options when the provided travel mode is Truck. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
    record RouteTruckOptions
        -- Total number of axles of the vehicle.
        AxleCount: number
        -- Engine type of the vehicle.
        EngineType: string
        -- Gross weight of the vehicle including trailers, and goods at capacity. Unit: kilograms
        GrossWeight: number
        -- List of Hazardous cargo contained in the vehicle.
        HazardousCargos: {string}
        -- Height of the vehicle. Unit: centimeters
        Height: number
        -- Height of the vehicle above its first axle. Unit: centimeters
        HeightAboveFirstAxle: number
        -- Kingpin to rear axle length of the vehicle. Unit: centimeters
        KpraLength: number
        -- Length of the vehicle. Unit: c
        Length: number
        -- The vehicle License Plate.
        LicensePlate: RouteVehicleLicensePlate
        -- Maximum speed Unit: kilometers per hour
        MaxSpeed: number
        -- The number of occupants in the vehicle. Default value: 1
        Occupancy: number
        -- Payload capacity of the vehicle and trailers attached. Unit: kilograms
        PayloadCapacity: number
        -- Number of tires on the vehicle.
        TireCount: number
        -- Trailer options corresponding to the vehicle.
        Trailer: RouteTrailerOptions
        -- The type of truck: LightTruck for smaller delivery vehicles, StraightTruck for rigid body trucks, or Tractor for tractor-trailer combinations.
        TruckType: string
        -- The tunnel restriction code. Tunnel categories in this list indicate the restrictions which apply to certain tunnels in Great Britain. They relate to the types of dangerous goods that can be transported through them. Tunnel Category B Risk Level: Limited risk Restrictions: Few restrictions Tunnel Category C Risk Level: Medium risk Restrictions: Some restrictions Tunnel Category D Risk Level: High risk Restrictions: Many restrictions occur Tunnel Category E Risk Level: Very high risk Restrictions: Restricted tunnel
        TunnelRestrictionCode: string
        -- Heaviest weight per axle irrespective of the axle type or the axle group. Meant for usage in countries where the differences in axle types or axle groups are not distinguished. Unit: kilograms
        WeightPerAxle: number
        -- Specifies the total weight for the specified axle group. Meant for usage in countries that have different regulations based on the axle group type. Unit: kilograms
        WeightPerAxleGroup: WeightPerAxleGroup
        -- Width of the vehicle. Unit: centimeters
        Width: number
    end

    -- Travel mode related options for the provided travel mode.
    record RouteTravelModeOptions
        -- Travel mode options when the provided travel mode is Car.
        Car: RouteCarOptions
        -- Travel mode options when the provided travel mode is Pedestrian.
        Pedestrian: RoutePedestrianOptions
        -- Travel mode options when the provided travel mode is Scooter. When travel mode is set to Scooter, then the avoidance option ControlledAccessHighways defaults to true.
        Scooter: RouteScooterOptions
        -- Travel mode options when the provided travel mode is Truck.
        Truck: RouteTruckOptions
    end

    enum RouteTravelStepType
        "Default"
        "TurnByTurn"
    end

    -- Waypoint between the Origin and Destination.
    record RouteWaypoint
        -- Avoids actions for the provided distance. This is typically to consider for users in moving vehicles who may not have sufficient time to make an action at an origin or a destination. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        AvoidActionsForDistance: number
        -- Avoid U-turns for calculation on highways and motorways. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        AvoidUTurns: boolean
        -- GPS Heading at the position. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Heading: number
        -- Options to configure matching the provided position to the road network. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Matching: RouteMatchingOptions
        -- If the waypoint should not be treated as a stop. If yes, the waypoint is passed through and doesn't split the route into different legs. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        PassThrough: boolean
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
        -- Options to configure matching the provided position to a side of the street. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        SideOfStreet: RouteSideOfStreetOptions
        -- Duration of the stop. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. Unit: seconds
        StopDuration: number
    end

    record CalculateRoutesInput
        -- Features that are allowed while calculating a route. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Allow: RouteAllowOptions
        -- Time of arrival at the destination. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. Time format:YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples: 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
        ArrivalTime: string
        -- Features that are avoided while calculating a route. Avoidance is on a best-case basis. If an avoidance can't be satisfied for a particular case, it violates the avoidance and the returned response produces a notice for the violation. For GrabMaps customers, ap-southeast-1 and ap-southeast-5 regions support only ControlledAccessHighways, Ferries, and TollRoads
        Avoid: RouteAvoidanceOptions
        -- Uses the current time as the time of departure.
        DepartNow: boolean
        -- Time of departure from the origin. Time format:YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples: 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
        DepartureTime: string
        -- The final position for the route. In the World Geodetic System (WGS 84) format: [longitude, latitude].
        Destination: {number}
        -- Destination related options. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        DestinationOptions: RouteDestinationOptions
        -- Driver related options. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Driver: RouteDriverOptions
        -- Features to be strictly excluded while calculating the route. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Exclude: RouteExclusionOptions
        -- Measurement system to be used for instructions within steps in the response.
        InstructionsMeasurementSystem: string
        -- Optional: The API key to be used for authorization. Either an API key or valid SigV4 signature must be provided when making a request.
        Key: string
        -- List of languages for instructions within steps in the response. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. Instructions in the requested language are returned only if they are available.
        Languages: {string}
        -- A list of optional additional parameters such as timezone that can be requested for each result. For GrabMaps customers, ap-southeast-1 and ap-southeast-5 regions support only PassThroughWaypoints, Summary, and TravelStepInstructions Elevation: Retrieves the elevation information for each location. Incidents: Provides information on traffic incidents along the route. PassThroughWaypoints: Indicates waypoints that are passed through without stopping. Summary: Returns a summary of the route, including distance and duration. Tolls: Supplies toll cost information along the route. TravelStepInstructions: Provides step-by-step instructions for travel along the route. TruckRoadTypes: Returns information about road types suitable for trucks. TypicalDuration: Gives typical travel duration based on historical data. Zones: Specifies the time zone information for each waypoint.
        LegAdditionalFeatures: {string}
        -- Specifies the format of the geometry returned for each leg of the route. You can choose between two different geometry encoding formats. FlexiblePolyline: A compact and precise encoding format for the leg geometry. For more information on the format, see the GitHub repository for https://github.com/aws-geospatial/polyline. Simple: A less compact encoding, which is easier to decode but may be less precise and result in larger payloads.
        LegGeometryFormat: string
        -- Maximum number of alternative routes to be provided in the response, if available. For GrabMaps customers, ap-southeast-1 and ap-southeast-5 regions support only up to 3 alternative routes.
        MaxAlternatives: number
        -- Controls the trade-off between achieving the shortest travel time (FastestRoute) and achieving the shortest physical distance ((ShortestRoute) when calculating each route in the matrix. Default value: FastestRoute
        OptimizeRoutingFor: string
        -- The start position for the route in World Geodetic System (WGS 84) format: [longitude, latitude].
        Origin: {number}
        -- Specifies how the origin point should be matched to the road network and any routing constraints that apply when the traveler is departing the origin. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        OriginOptions: RouteOriginOptions
        -- A list of optional features such as SpeedLimit that can be requested for a Span. A span is a section of a Leg for which the requested features have the same values. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        SpanAdditionalFeatures: {string}
        -- Toll related options. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Tolls: RouteTollOptions
        -- Traffic related options. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Traffic: RouteTrafficOptions
        -- Specifies the mode of transport when calculating a route. Used in estimating the speed of travel and road compatibility. For GrabMaps customers, ap-southeast-1 and ap-southeast-5 regions support only Car, Pedestrian, and Scooter values. Default value: Car
        TravelMode: string
        -- Travel mode related options for the provided travel mode. For GrabMaps customers, ap-southeast-1 and ap-southeast-5 regions support only Car and Pedestrian travel mode options.
        TravelModeOptions: RouteTravelModeOptions
        -- Type of step returned by the response. Default provides basic steps intended for web based applications. TurnByTurn provides detailed instructions with more granularity intended for a turn based navigation system. For GrabMaps customers, ap-southeast-1 and ap-southeast-5 regions Default does not return any steps.
        TravelStepType: string
        -- List of waypoints between the Origin and Destination. For GrabMaps customers, ap-southeast-1 and ap-southeast-5 regions max length is 100. Max length: 23
        Waypoints: {RouteWaypoint}
    end

    enum RouteResponseNoticeCode
        "MainLanguageNotFound"
        "Other"
        "TravelTimeExceedsDriverWorkHours"
    end

    enum RouteNoticeImpact
        "High"
        "Low"
    end

    -- Notices are additional information returned that indicate issues that occurred during route calculation.
    record RouteResponseNotice
        -- Code corresponding to the issue.
        Code: string
        -- Impact corresponding to the issue. While Low impact notices can be safely ignored, High impact notices must be evaluated further to determine the impact.
        Impact: string
    end

    enum RouteFerryAfterTravelStepType
        "Deboard"
    end

    -- Steps of a leg that must be performed after the travel portion of the leg.
    record RouteFerryAfterTravelStep
        -- Duration of the step. Unit: seconds
        Duration: number
        -- Brief description of the step in the requested language. Only available when the TravelStepType is Default.
        Instruction: string
        -- Type of the step.
        Type: string
    end

    -- Position provided in the request.
    record RouteFerryPlace
        -- The name of the place.
        Name: string
        -- Position provided in the request.
        OriginalPosition: {number}
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
        -- Index of the waypoint in the request.
        WaypointIndex: number
    end

    -- Details corresponding to the arrival for the leg.
    record RouteFerryArrival
        -- The place details.
        Place: RouteFerryPlace
        -- The time.
        Time: string
    end

    enum RouteFerryBeforeTravelStepType
        "Board"
    end

    -- Steps of a leg that must be performed before the travel portion of the leg.
    record RouteFerryBeforeTravelStep
        -- Duration of the step. Unit: seconds
        Duration: number
        -- Brief description of the step in the requested language. Only available when the TravelStepType is Default.
        Instruction: string
        -- Type of the step.
        Type: string
    end

    -- Details corresponding to the departure for the leg.
    record RouteFerryDeparture
        -- The place details.
        Place: RouteFerryPlace
        -- The time.
        Time: string
    end

    enum RouteFerryNoticeCode
        "AccuratePolylineUnavailable"
        "NoSchedule"
        "Other"
        "ViolatedAvoidFerry"
        "ViolatedAvoidRailFerry"
        "SeasonalClosure"
        "PotentialViolatedVehicleRestrictionUsage"
        "ViolatedAvoidAreas"
        "ViolatedVehicleRestriction"
    end

    -- Notices are additional information returned that indicate issues that occurred during route calculation.
    record RouteFerryNotice
        -- Code corresponding to the issue.
        Code: string
        -- Impact corresponding to the issue. While Low impact notices can be safely ignored, High impact notices must be evaluated further to determine the impact.
        Impact: string
    end

    -- The place where the waypoint is passed through and not treated as a stop.
    record RoutePassThroughPlace
        -- Position provided in the request.
        OriginalPosition: {number}
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
        -- Index of the waypoint in the request.
        WaypointIndex: number
    end

    -- If the waypoint should be treated as a stop. If yes, the route is split up into different legs around the stop.
    record RoutePassThroughWaypoint
        -- Offset in the leg geometry corresponding to the start of this step.
        GeometryOffset: number
        -- The place details.
        Place: RoutePassThroughPlace
    end

    -- The localized string.
    record LocalizedString
        -- A list of BCP 47 compliant language codes for the results to be rendered in. The request uses the regional default as the fallback if the requested language can't be provided.
        Language: string
        -- The value of the localized string.
        Value: string
    end

    -- Span computed for the requested SpanAdditionalFeatures.
    record RouteFerrySpan
        -- 3 letter Country code corresponding to the Span.
        Country: string
        -- Distance of the computed span. This feature doesn't split a span, but is always computed on a span split by other properties. Unit: meters
        Distance: number
        -- Duration of the computed span. This feature doesn't split a span, but is always computed on a span split by other properties. Unit: seconds
        Duration: number
        -- Offset in the leg geometry corresponding to the start of this span.
        GeometryOffset: number
        -- Provides an array of names of the ferry span in available languages.
        Names: {LocalizedString}
        -- 2-3 letter Region code corresponding to the Span. This is either a province or a state.
        Region: string
    end

    -- Summarized details of the leg.
    record RouteFerryOverviewSummary
        -- Distance of the step.
        Distance: number
        -- Duration of the step. Unit: seconds
        Duration: number
    end

    -- Summarized details for the leg including travel steps only. The Distance for the travel only portion of the journey is the same as the Distance within the Overview summary.
    record RouteFerryTravelOnlySummary
        -- Total duration in free flowing traffic, which is the best case or shortest duration possible to cover the leg. Unit: seconds
        Duration: number
    end

    -- Summarized details for the leg including travel steps only. The Distance for the travel only portion of the journey is the same as the Distance within the Overview summary.
    record RouteFerrySummary
        -- Summarized details for the leg including before travel, travel and after travel steps.
        Overview: RouteFerryOverviewSummary
        -- Summarized details for the leg including travel steps only. The Distance for the travel only portion of the journey is in meters
        TravelOnly: RouteFerryTravelOnlySummary
    end

    enum RouteFerryTravelStepType
        "Depart"
        "Continue"
        "Arrive"
    end

    -- Steps of a leg that must be performed during the travel portion of the leg.
    record RouteFerryTravelStep
        -- Distance of the step.
        Distance: number
        -- Duration of the step. Unit: seconds
        Duration: number
        -- Offset in the leg geometry corresponding to the start of this step.
        GeometryOffset: number
        -- Brief description of the step in the requested language. Only available when the TravelStepType is Default.
        Instruction: string
        -- Type of the step.
        Type: string
    end

    -- FerryLegDetails is populated when the Leg type is Ferry, and provides additional information that is specific to ferry travel.
    record RouteFerryLegDetails
        -- Steps of a leg that must be performed after the travel portion of the leg.
        AfterTravelSteps: {RouteFerryAfterTravelStep}
        -- Details corresponding to the arrival for the leg.
        Arrival: RouteFerryArrival
        -- Steps of a leg that must be performed before the travel portion of the leg.
        BeforeTravelSteps: {RouteFerryBeforeTravelStep}
        -- Details corresponding to the departure for the leg.
        Departure: RouteFerryDeparture
        -- Notices are additional information returned that indicate issues that occurred during route calculation.
        Notices: {RouteFerryNotice}
        -- Waypoints that were passed through during the leg. This includes the waypoints that were configured with the PassThrough option.
        PassThroughWaypoints: {RoutePassThroughWaypoint}
        -- Route name of the ferry line.
        RouteName: string
        -- Spans that were computed for the requested SpanAdditionalFeatures.
        Spans: {RouteFerrySpan}
        -- Summarized details of the leg.
        Summary: RouteFerrySummary
        -- Steps of a leg that must be performed before the travel portion of the leg.
        TravelSteps: {RouteFerryTravelStep}
    end

    -- The returned Route leg geometry.
    record RouteLegGeometry
        -- An ordered list of positions used to plot a route on a map. LineString and Polyline are mutually exclusive properties.
        LineString: {{number}}
        -- An ordered list of positions used to plot a route on a map in a lossy compression format. LineString and Polyline are mutually exclusive properties.
        Polyline: string
    end

    enum RouteSideOfStreet
        "Left"
        "Right"
    end

    -- Place details corresponding to the arrival or departure.
    record RoutePedestrianPlace
        -- The name of the place.
        Name: string
        -- Position provided in the request.
        OriginalPosition: {number}
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
        -- Options to configure matching the provided position to a side of the street.
        SideOfStreet: string
        -- Index of the waypoint in the request.
        WaypointIndex: number
    end

    -- Details corresponding to the arrival for a leg. Time format:YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples: 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
    record RoutePedestrianArrival
        -- The place details.
        Place: RoutePedestrianPlace
        -- The time.
        Time: string
    end

    -- Details corresponding to the departure for a leg. Time format:YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples: 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
    record RoutePedestrianDeparture
        -- The place details.
        Place: RoutePedestrianPlace
        -- The time.
        Time: string
    end

    enum RoutePedestrianNoticeCode
        "AccuratePolylineUnavailable"
        "Other"
        "ViolatedAvoidDirtRoad"
        "ViolatedAvoidTunnel"
        "ViolatedPedestrianOption"
        "ViolatedAvoidAreas"
    end

    -- Notices are additional information returned that indicate issues that occurred during route calculation.
    record RoutePedestrianNotice
        -- Code corresponding to the issue.
        Code: string
        -- Impact corresponding to the issue. While Low impact notices can be safely ignored, High impact notices must be evaluated further to determine the impact.
        Impact: string
    end

    -- Details about the dynamic speed. Unit: kilometers per hour
    record RouteSpanDynamicSpeedDetails
        -- Estimated speed while traversing the span without traffic congestion. Unit: kilometers per hour
        BestCaseSpeed: number
        -- Estimated time to turn from this span into the next. Unit: seconds
        TurnDuration: number
        -- Estimated speed while traversing the span under typical traffic congestion. Unit: kilometers per hour
        TypicalSpeed: number
    end

    enum RouteSpanPedestrianAccessAttribute
        "Allowed"
        "Indoors"
        "NoThroughTraffic"
        "Park"
        "Stairs"
        "TollRoad"
    end

    enum RouteSpanRoadAttribute
        "Bridge"
        "BuiltUpArea"
        "ControlledAccessHighway"
        "DirtRoad"
        "DividedRoad"
        "Motorway"
        "PrivateRoad"
        "Ramp"
        "RightHandTraffic"
        "Roundabout"
        "Tunnel"
        "UnderConstruction"
    end

    enum RouteDirection
        "East"
        "North"
        "South"
        "West"
    end

    -- The route number.
    record RouteNumber
        -- Directional identifier of the route.
        Direction: string
        -- List of languages for instructions corresponding to the route number.
        Language: string
        -- The route number.
        Value: string
    end

    -- Details about the speed limit corresponding to the span. Unit: kilometers per hour
    record RouteSpanSpeedLimitDetails
        -- Maximum speed. Unit: kilometers per hour
        MaxSpeed: number
        -- If the span doesn't have a speed limit like the Autobahn.
        Unlimited: boolean
    end

    -- Span computed for the requested SpanAdditionalFeatures.
    record RoutePedestrianSpan
        -- Duration of the computed span without traffic congestion. Unit: seconds
        BestCaseDuration: number
        -- 3 letter Country code corresponding to the Span.
        Country: string
        -- Distance of the computed span. This feature doesn't split a span, but is always computed on a span split by other properties.
        Distance: number
        -- Duration of the computed span. This feature doesn't split a span, but is always computed on a span split by other properties. Unit: seconds
        Duration: number
        -- Dynamic speed details corresponding to the span. Unit: kilometers per hour
        DynamicSpeed: RouteSpanDynamicSpeedDetails
        -- A numerical value indicating the functional classification of the road segment corresponding to the span. Classification values are part of the hierarchical network that helps determine a logical and efficient route, and have the following definitions: Roads that allow for high volume, maximum speed traffic movement between and through major metropolitan areas. Roads that are used to channel traffic to functional class 1 roads for travel between and through cities in the shortest amount of time. Roads that intersect functional class 2 roads and provide a high volume of traffic movement at a lower level of mobility than functional class 2 roads. Roads that provide for a high volume of traffic movement at moderate speeds between neighborhoods. Roads with volume and traffic movement below the level of any other functional class.
        FunctionalClassification: number
        -- Offset in the leg geometry corresponding to the start of this span.
        GeometryOffset: number
        -- Incidents corresponding to the span. These index into the Incidents in the parent Leg.
        Incidents: {number}
        -- Provides an array of names of the pedestrian span in available languages.
        Names: {LocalizedString}
        -- Access attributes for a pedestrian corresponding to the span.
        PedestrianAccess: {string}
        -- 2-3 letter Region code corresponding to the Span. This is either a province or a state.
        Region: string
        -- Attributes for the road segment corresponding to the span.
        RoadAttributes: {string}
        -- Designated route name or number corresponding to the span.
        RouteNumbers: {RouteNumber}
        -- Speed limit details corresponding to the span. Unit: kilometers per hour
        SpeedLimit: RouteSpanSpeedLimitDetails
        -- Duration of the computed span under typical traffic congestion. Unit: seconds
        TypicalDuration: number
    end

    -- Provides a summary of a pedestrian route step.
    record RoutePedestrianOverviewSummary
        -- Distance of the step.
        Distance: number
        -- Duration of the step.
        Duration: number
    end

    -- Summarized details for the leg including travel steps.
    record RoutePedestrianTravelOnlySummary
        -- Duration of the step. Unit: seconds
        Duration: number
    end

    -- Summarized details for the leg including before travel, travel and after travel steps.
    record RoutePedestrianSummary
        -- Summarized details for the leg including before travel, travel and after travel steps.
        Overview: RoutePedestrianOverviewSummary
        -- Summarized details for the leg including travel steps only. The Distance for the travel only portion of the journey is in meters
        TravelOnly: RoutePedestrianTravelOnlySummary
    end

    -- Details related to the continue step.
    record RouteContinueStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
    end

    enum RouteRoadType
        "Highway"
        "Rural"
        "Urban"
    end

    -- The road on the route.
    record RouteRoad
        -- Name of the road (localized).
        RoadName: {LocalizedString}
        -- Route number of the road.
        RouteNumber: {RouteNumber}
        -- Names of destinations that can be reached when traveling on the road.
        Towards: {LocalizedString}
        -- The type of road.
        Type: string
    end

    enum RouteSteeringDirection
        "Left"
        "Right"
        "Straight"
    end

    enum RouteTurnIntensity
        "Sharp"
        "Slight"
        "Typical"
    end

    -- Details that are specific to a Keep step.
    record RouteKeepStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    -- Details about the roundabout leg.
    record RouteRoundaboutEnterStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    -- Details about the roundabout step.
    record RouteRoundaboutExitStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Exit to be taken.
        RelativeExit: number
        -- Angle of the roundabout.
        RoundaboutAngle: number
        -- Steering direction for the step.
        SteeringDirection: string
    end

    -- Details about the step.
    record RouteRoundaboutPassStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    -- Labels presented on the sign post.
    record RouteSignpostLabel
        -- Route number of the road.
        RouteNumber: RouteNumber
        -- The Signpost text.
        Text: LocalizedString
    end

    -- Sign post information of the action, applicable only for TurnByTurn steps. See RouteSignpost for details of sub-attributes.
    record RouteSignpost
        -- Labels present on the sign post.
        Labels: {RouteSignpostLabel}
    end

    -- Details related to the turn step.
    record RouteTurnStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    enum RoutePedestrianTravelStepType
        "Arrive"
        "Continue"
        "Depart"
        "Keep"
        "RoundaboutEnter"
        "RoundaboutExit"
        "RoundaboutPass"
        "Turn"
    end

    -- Steps of a leg that must be performed during the travel portion of the leg.
    record RoutePedestrianTravelStep
        -- Details related to the continue step.
        ContinueStepDetails: RouteContinueStepDetails
        -- Details of the current road. See RouteRoad for details of sub-attributes.
        CurrentRoad: RouteRoad
        -- Distance of the step.
        Distance: number
        -- Duration of the step. Unit: seconds
        Duration: number
        -- Exit number of the road exit, if applicable.
        ExitNumber: {LocalizedString}
        -- Offset in the leg geometry corresponding to the start of this step.
        GeometryOffset: number
        -- Brief description of the step in the requested language. Only available when the TravelStepType is Default.
        Instruction: string
        -- Details that are specific to a Keep step.
        KeepStepDetails: RouteKeepStepDetails
        -- Details of the next road. See RouteRoad for details of sub-attributes.
        NextRoad: RouteRoad
        -- Details that are specific to a Roundabout Enter step.
        RoundaboutEnterStepDetails: RouteRoundaboutEnterStepDetails
        -- Details that are specific to a Roundabout Exit step.
        RoundaboutExitStepDetails: RouteRoundaboutExitStepDetails
        -- Details that are specific to a Roundabout Pass step.
        RoundaboutPassStepDetails: RouteRoundaboutPassStepDetails
        -- Sign post information of the action, applicable only for TurnByTurn steps. See RouteSignpost for details of sub-attributes.
        Signpost: RouteSignpost
        -- Details that are specific to a turn step.
        TurnStepDetails: RouteTurnStepDetails
        -- Type of the step.
        Type: string
    end

    -- Details that are specific to a pedestrian leg.
    record RoutePedestrianLegDetails
        -- Details corresponding to the arrival for the leg.
        Arrival: RoutePedestrianArrival
        -- Details corresponding to the departure for the leg.
        Departure: RoutePedestrianDeparture
        -- Notices are additional information returned that indicate issues that occurred during route calculation. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Notices: {RoutePedestrianNotice}
        -- Waypoints that were passed through during the leg. This includes the waypoints that were configured with the PassThrough option.
        PassThroughWaypoints: {RoutePassThroughWaypoint}
        -- Spans that were computed for the requested SpanAdditionalFeatures. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Spans: {RoutePedestrianSpan}
        -- Summarized details of the leg.
        Summary: RoutePedestrianSummary
        -- Steps of a leg that must be performed before the travel portion of the leg.
        TravelSteps: {RoutePedestrianTravelStep}
    end

    enum RouteLegTravelMode
        "Car"
        "Ferry"
        "Pedestrian"
        "Scooter"
        "Truck"
        "CarShuttleTrain"
    end

    enum RouteLegType
        "Ferry"
        "Pedestrian"
        "Vehicle"
    end

    -- Place details corresponding to the arrival or departure.
    record RouteVehiclePlace
        -- The name of the place.
        Name: string
        -- Position provided in the request.
        OriginalPosition: {number}
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
        -- Options to configure matching the provided position to a side of the street.
        SideOfStreet: string
        -- Index of the waypoint in the request.
        WaypointIndex: number
    end

    -- Details corresponding to the arrival for a leg.
    record RouteVehicleArrival
        -- The place details.
        Place: RouteVehiclePlace
        -- The time.
        Time: string
    end

    -- Details corresponding to the departure for the leg.
    record RouteVehicleDeparture
        -- The place details.
        Place: RouteVehiclePlace
        -- The departure time.
        Time: string
    end

    enum RouteVehicleIncidentSeverity
        "Critical"
        "High"
        "Medium"
        "Low"
    end

    enum RouteVehicleIncidentType
        "Accident"
        "Congestion"
        "Construction"
        "DisabledVehicle"
        "LaneRestriction"
        "MassTransit"
        "Other"
        "PlannedEvent"
        "RoadClosure"
        "RoadHazard"
        "Weather"
    end

    -- Incidents corresponding to this leg of the route.
    record RouteVehicleIncident
        -- Brief readable description of the incident.
        Description: string
        -- End timestamp of the incident.
        EndTime: string
        -- Severity of the incident Critical - The part of the route the incident affects is unusable. Major- Major impact on the leg duration, for example stop and go Minor- Minor impact on the leg duration, for example traffic jam Low - Low on duration, for example slightly increased traffic
        Severity: string
        -- Start time of the incident.
        StartTime: string
        -- Type of the incident.
        Type: string
    end

    enum RouteVehicleNoticeCode
        "AccuratePolylineUnavailable"
        "Other"
        "PotentialViolatedAvoidTollRoadUsage"
        "PotentialViolatedCarpoolUsage"
        "PotentialViolatedTurnRestrictionUsage"
        "PotentialViolatedVehicleRestrictionUsage"
        "PotentialViolatedZoneRestrictionUsage"
        "SeasonalClosure"
        "TollsDataTemporarilyUnavailable"
        "TollsDataUnavailable"
        "TollTransponder"
        "ViolatedAvoidControlledAccessHighway"
        "ViolatedAvoidDifficultTurns"
        "ViolatedAvoidDirtRoad"
        "ViolatedAvoidSeasonalClosure"
        "ViolatedAvoidTollRoad"
        "ViolatedAvoidTollTransponder"
        "ViolatedAvoidTruckRoadType"
        "ViolatedAvoidTunnel"
        "ViolatedAvoidUTurns"
        "ViolatedBlockedRoad"
        "ViolatedCarpool"
        "ViolatedEmergencyGate"
        "ViolatedStartDirection"
        "ViolatedTurnRestriction"
        "ViolatedVehicleRestriction"
        "ViolatedZoneRestriction"
        "TravelTimeExceedsDriverWorkHours"
    end

    -- Notice Detail that is a range.
    record RouteNoticeDetailRange
        -- Minimum value for the range.
        Min: number
        -- Maximum value for the range.
        Max: number
    end

    enum RouteWeightConstraintType
        "Current"
        "Gross"
        "Unknown"
    end

    -- The weight constraint for the route. Unit: kilograms
    record RouteWeightConstraint
        -- The type of constraint.
        Type: string
        -- The constraint value. Unit: kilograms
        Value: number
    end

    -- This property contains a summary of violated constraints.
    record RouteViolatedConstraints
        -- This restriction applies to truck cargo, where the resulting route excludes roads on which hazardous materials are prohibited from being transported.
        AllHazardsRestricted: boolean
        -- Total number of axles of the vehicle.
        AxleCount: RouteNoticeDetailRange
        -- List of Hazardous cargo contained in the vehicle.
        HazardousCargos: {string}
        -- The maximum height of the vehicle.
        MaxHeight: number
        -- The maximum Kpra length of the vehicle. Unit: centimeters
        MaxKpraLength: number
        -- The maximum length of the vehicle.
        MaxLength: number
        -- The maximum load capacity of the vehicle. Unit: kilograms
        MaxPayloadCapacity: number
        -- The maximum weight of the route. Unit: kilograms
        MaxWeight: RouteWeightConstraint
        -- The maximum weight per axle of the vehicle. Unit: kilograms
        MaxWeightPerAxle: number
        -- The maximum weight per axle group of the vehicle. Unit: kilograms
        MaxWeightPerAxleGroup: WeightPerAxleGroup
        -- The maximum width of the vehicle.
        MaxWidth: number
        -- The number of occupants in the vehicle. Default value: 1
        Occupancy: RouteNoticeDetailRange
        -- Access radius restrictions based on time.
        RestrictedTimes: string
        -- The time dependent constraint.
        TimeDependent: boolean
        -- Number of trailers attached to the vehicle. Default value: 0
        TrailerCount: RouteNoticeDetailRange
        -- Travel mode corresponding to the leg.
        TravelMode: boolean
        -- Truck road type identifiers. BK1 through BK4 apply only to Sweden. A2,A4,B2,B4,C,D,ET2,ET4 apply only to Mexico. There are currently no other supported values as of 26th April 2024.
        TruckRoadType: string
        -- The type of truck: LightTruck for smaller delivery vehicles, StraightTruck for rigid body trucks, or Tractor for tractor-trailer combinations.
        TruckType: string
        -- The tunnel restriction code. Tunnel categories in this list indicate the restrictions which apply to certain tunnels in Great Britain. They relate to the types of dangerous goods that can be transported through them. Tunnel Category B Risk Level: Limited risk Restrictions: Few restrictions Tunnel Category C Risk Level: Medium risk Restrictions: Some restrictions Tunnel Category D Risk Level: High risk Restrictions: Many restrictions occur Tunnel Category E Risk Level: Very high risk Restrictions: Restricted tunnel
        TunnelRestrictionCode: string
    end

    -- Additional details of the notice.
    record RouteVehicleNoticeDetail
        -- The notice title.
        Title: string
        -- Any violated constraints.
        ViolatedConstraints: RouteViolatedConstraints
    end

    -- Notices are additional information returned that indicate issues that occurred during route calculation.
    record RouteVehicleNotice
        -- Code corresponding to the issue.
        Code: string
        -- Additional details of the notice.
        Details: {RouteVehicleNoticeDetail}
        -- Impact corresponding to the issue. While Low impact notices can be safely ignored, High impact notices must be evaluated further to determine the impact.
        Impact: string
    end

    enum RouteSpanCarAccessAttribute
        "Allowed"
        "NoThroughTraffic"
        "TollRoad"
    end

    enum RouteSpanGateAttribute
        "Emergency"
        "KeyAccess"
        "PermissionRequired"
    end

    enum RouteSpanRailwayCrossingAttribute
        "Protected"
        "Unprotected"
    end

    enum RouteSpanScooterAccessAttribute
        "Allowed"
        "NoThroughTraffic"
        "TollRoad"
    end

    enum RouteSpanTruckAccessAttribute
        "Allowed"
        "NoThroughTraffic"
        "TollRoad"
    end

    -- Span computed for the requested SpanAdditionalFeatures.
    record RouteVehicleSpan
        -- Duration of the computed span without traffic congestion. Unit: seconds
        BestCaseDuration: number
        -- Access attributes for a car corresponding to the span.
        CarAccess: {string}
        -- 3 letter Country code corresponding to the Span.
        Country: string
        -- Distance of the computed span. This feature doesn't split a span, but is always computed on a span split by other properties.
        Distance: number
        -- Duration of the computed span. This feature doesn't split a span, but is always computed on a span split by other properties. Unit: seconds
        Duration: number
        -- Dynamic speed details corresponding to the span. Unit: kilometers per hour
        DynamicSpeed: RouteSpanDynamicSpeedDetails
        -- A numerical value indicating the functional classification of the road segment corresponding to the span. Classification values are part of the hierarchical network that helps determine a logical and efficient route, and have the following definitions: Roads that allow for high volume, maximum speed traffic movement between and through major metropolitan areas. Roads that are used to channel traffic to functional class 1 roads for travel between and through cities in the shortest amount of time. Roads that intersect functional class 2 roads and provide a high volume of traffic movement at a lower level of mobility than functional class 2 roads. Roads that provide for a high volume of traffic movement at moderate speeds between neighborhoods. Roads with volume and traffic movement below the level of any other functional class.
        FunctionalClassification: number
        -- Attributes corresponding to a gate. The gate is present at the end of the returned span.
        Gate: string
        -- Offset in the leg geometry corresponding to the start of this span.
        GeometryOffset: number
        -- Incidents corresponding to the span. These index into the Incidents in the parent Leg.
        Incidents: {number}
        -- Provides an array of names of the vehicle span in available languages.
        Names: {LocalizedString}
        -- Notices are additional information returned that indicate issues that occurred during route calculation.
        Notices: {number}
        -- Attributes corresponding to a railway crossing. The gate is present at the end of the returned span.
        RailwayCrossing: string
        -- 2-3 letter Region code corresponding to the Span. This is either a province or a state.
        Region: string
        -- Attributes for the road segment corresponding to the span.
        RoadAttributes: {string}
        -- Designated route name or number corresponding to the span.
        RouteNumbers: {RouteNumber}
        -- Access attributes for a scooter corresponding to the span.
        ScooterAccess: {string}
        -- Speed limit details corresponding to the span. Unit: kilometers per hour
        SpeedLimit: RouteSpanSpeedLimitDetails
        -- Toll systems are authorities that collect payments for the toll.
        TollSystems: {number}
        -- Access attributes for a truck corresponding to the span.
        TruckAccess: {string}
        -- Truck road type identifiers. BK1 through BK4 apply only to Sweden. A2,A4,B2,B4,C,D,ET2,ET4 apply only to Mexico. There are currently no other supported values as of 26th April 2024.
        TruckRoadTypes: {number}
        -- Duration of the computed span under typical traffic congestion. Unit: seconds
        TypicalDuration: number
        -- Zones corresponding to this leg of the route.
        Zones: {number}
    end

    -- Summarized details of the leg.
    record RouteVehicleOverviewSummary
        -- Total duration in free flowing traffic, which is the best case or shortest duration possible to cover the leg. Unit: seconds
        BestCaseDuration: number
        -- Distance of the step.
        Distance: number
        -- Duration of the step. Unit: seconds
        Duration: number
        -- Duration of the computed span under typical traffic congestion. Unit: seconds
        TypicalDuration: number
    end

    -- Summarized details of the route.
    record RouteVehicleTravelOnlySummary
        -- Total duration in free flowing traffic, which is the best case or shortest duration possible to cover the leg. Unit: seconds
        BestCaseDuration: number
        -- Duration of the step. Unit: seconds
        Duration: number
        -- Duration of the computed span under typical traffic congestion. Unit: seconds
        TypicalDuration: number
    end

    -- Summarized details of the route.
    record RouteVehicleSummary
        -- Summarized details for the leg including before travel, travel and after travel steps.
        Overview: RouteVehicleOverviewSummary
        -- Summarized details for the leg including travel steps only. The Distance for the travel only portion of the journey is in meters
        TravelOnly: RouteVehicleTravelOnlySummary
    end

    -- Locations or sites where the toll fare is collected.
    record RouteTollPaymentSite
        -- Name of the payment site.
        Name: string
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
    end

    -- Price range with a minimum and maximum value, if a range.
    record RouteTollPriceValueRange
        -- Minimum price.
        Min: number
        -- Maximum price.
        Max: number
    end

    -- The toll price.
    record RouteTollPrice
        -- Currency code corresponding to the price. This is the same as Currency specified in the request.
        Currency: string
        -- If the price is an estimate or an exact value.
        Estimate: boolean
        -- Duration for which the price corresponds to. Unit: seconds
        PerDuration: number
        -- If the price is a range or an exact value. If any of the toll fares making up the route is a range, the overall price is also a range.
        Range: boolean
        -- Price range with a minimum and maximum value, if a range.
        RangeValue: RouteTollPriceValueRange
        -- Exact price, if not a range.
        Value: number
    end

    enum RouteTollPassValidityPeriodType
        "Annual"
        "Days"
        "ExtendedAnnual"
        "Minutes"
        "Months"
    end

    -- Period for which the pass is valid.
    record RouteTollPassValidityPeriod
        -- Validity period.
        Period: string
        -- Counts for the validity period.
        PeriodCount: number
    end

    -- Details if the toll rate can be a pass that supports multiple trips.
    record RouteTollPass
        -- If the pass includes the rate for the return leg of the trip.
        IncludesReturnTrip: boolean
        -- If the pass is only valid for senior persons.
        SeniorPass: boolean
        -- If the toll pass can be transferred, and how many times.
        TransferCount: number
        -- Number of trips the pass is valid for.
        TripCount: number
        -- Period for which the pass is valid.
        ValidityPeriod: RouteTollPassValidityPeriod
    end

    enum RouteTollPaymentMethod
        "BankCard"
        "Cash"
        "CashExact"
        "CreditCard"
        "PassSubscription"
        "TravelCard"
        "Transponder"
        "VideoToll"
    end

    -- Transponders for which this toll can be applied.
    record RouteTransponder
        -- Names of the toll system collecting the toll.
        SystemName: string
    end

    -- The toll rate.
    record RouteTollRate
        -- Time when the rate is valid.
        ApplicableTimes: string
        -- Price in the converted currency as specified in the request.
        ConvertedPrice: RouteTollPrice
        -- The Toll rate Id.
        Id: string
        -- Price in the local regional currency.
        LocalPrice: RouteTollPrice
        -- The name of the toll.
        Name: string
        -- Details if the toll rate can be a pass that supports multiple trips.
        Pass: RouteTollPass
        -- Accepted payment methods at the toll.
        PaymentMethods: {string}
        -- Transponders for which this toll can be applied.
        Transponders: {RouteTransponder}
    end

    -- Provides details about toll information along a route, including the payment sites, applicable toll rates, toll systems, and the country associated with the toll collection.
    record RouteToll
        -- The alpha-2 or alpha-3 character code for the country.
        Country: string
        -- Locations or sites where the toll fare is collected.
        PaymentSites: {RouteTollPaymentSite}
        -- Toll rates that need to be paid to travel this leg of the route.
        Rates: {RouteTollRate}
        -- Toll systems are authorities that collect payments for the toll.
        Systems: {number}
    end

    -- Toll systems are authorities that collect payments for the toll.
    record RouteTollSystem
        -- The toll system name.
        Name: string
    end

    -- Details related to the continue highway step.
    record RouteContinueHighwayStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    -- Details related to the enter highway step.
    record RouteEnterHighwayStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    -- Details related to the exit step.
    record RouteExitStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Exit to be taken.
        RelativeExit: number
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    -- Details that are specific to a ramp step.
    record RouteRampStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    enum RouteVehicleTravelStepType
        "Arrive"
        "Continue"
        "ContinueHighway"
        "Depart"
        "EnterHighway"
        "Exit"
        "Keep"
        "Ramp"
        "RoundaboutEnter"
        "RoundaboutExit"
        "RoundaboutPass"
        "Turn"
        "UTurn"
    end

    -- Details related to the U-turn step.
    record RouteUTurnStepDetails
        -- Name of the intersection, if applicable to the step.
        Intersection: {LocalizedString}
        -- Steering direction for the step.
        SteeringDirection: string
        -- Angle of the turn.
        TurnAngle: number
        -- Intensity of the turn.
        TurnIntensity: string
    end

    -- Steps of a leg that correspond to the travel portion of the leg.
    record RouteVehicleTravelStep
        -- Details that are specific to a Continue Highway step.
        ContinueHighwayStepDetails: RouteContinueHighwayStepDetails
        -- Details that are specific to a Continue step.
        ContinueStepDetails: RouteContinueStepDetails
        -- Details of the current road.
        CurrentRoad: RouteRoad
        -- Distance of the step.
        Distance: number
        -- Duration of the step. Unit: seconds
        Duration: number
        -- Details that are specific to a Enter Highway step.
        EnterHighwayStepDetails: RouteEnterHighwayStepDetails
        -- Exit number of the road exit, if applicable.
        ExitNumber: {LocalizedString}
        -- Details that are specific to a Roundabout Exit step.
        ExitStepDetails: RouteExitStepDetails
        -- Offset in the leg geometry corresponding to the start of this step.
        GeometryOffset: number
        -- Brief description of the step in the requested language. Only available when the TravelStepType is Default.
        Instruction: string
        -- Details that are specific to a Keep step.
        KeepStepDetails: RouteKeepStepDetails
        -- Details of the next road. See RouteRoad for details of sub-attributes.
        NextRoad: RouteRoad
        -- Details that are specific to a Ramp step.
        RampStepDetails: RouteRampStepDetails
        -- Details that are specific to a Roundabout Enter step.
        RoundaboutEnterStepDetails: RouteRoundaboutEnterStepDetails
        -- Details that are specific to a Roundabout Exit step.
        RoundaboutExitStepDetails: RouteRoundaboutExitStepDetails
        -- Details that are specific to a Roundabout Pass step.
        RoundaboutPassStepDetails: RouteRoundaboutPassStepDetails
        -- Sign post information of the action, applicable only for TurnByTurn steps. See RouteSignpost for details of sub-attributes.
        Signpost: RouteSignpost
        -- Details that are specific to a Turn step.
        TurnStepDetails: RouteTurnStepDetails
        -- Type of the step.
        Type: string
        -- Details that are specific to a Turn step.
        UTurnStepDetails: RouteUTurnStepDetails
    end

    -- The zone.
    record RouteZone
        -- The zone category.
        Category: string
        -- The name of the zone.
        Name: string
    end

    -- Steps of a leg that correspond to the travel portion of the leg.
    record RouteVehicleLegDetails
        -- Details corresponding to the arrival for the leg.
        Arrival: RouteVehicleArrival
        -- Details corresponding to the departure for the leg.
        Departure: RouteVehicleDeparture
        -- Incidents corresponding to this leg of the route. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Incidents: {RouteVehicleIncident}
        -- Notices are additional information returned that indicate issues that occurred during route calculation. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Notices: {RouteVehicleNotice}
        -- Waypoints that were passed through during the leg. This includes the waypoints that were configured with the PassThrough option.
        PassThroughWaypoints: {RoutePassThroughWaypoint}
        -- Spans that were computed for the requested SpanAdditionalFeatures. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Spans: {RouteVehicleSpan}
        -- Summarized details of the leg.
        Summary: RouteVehicleSummary
        -- Toll related options. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Tolls: {RouteToll}
        -- Toll systems are authorities that collect payments for the toll. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        TollSystems: {RouteTollSystem}
        -- Steps of a leg that must be performed before the travel portion of the leg.
        TravelSteps: {RouteVehicleTravelStep}
        -- Truck road type identifiers. BK1 through BK4 apply only to Sweden. A2,A4,B2,B4,C,D,ET2,ET4 apply only to Mexico. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. There are currently no other supported values as of 26th April 2024.
        TruckRoadTypes: {string}
        -- Zones corresponding to this leg of the route. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Zones: {RouteZone}
    end

    -- A leg is a section of a route from one waypoint to the next. A leg could be of type Vehicle, Pedestrian or Ferry. Legs of different types could occur together within a single route. For example, a car employing the use of a Ferry will contain Vehicle legs corresponding to journey on land, and Ferry legs corresponding to the journey via Ferry.
    record RouteLeg
        -- FerryLegDetails is populated when the Leg type is Ferry, and provides additional information that is specific to ferry travel. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        FerryLegDetails: RouteFerryLegDetails
        -- Geometry of the area to be avoided.
        Geometry: RouteLegGeometry
        -- List of languages for instructions within steps in the response. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Language: string
        -- Details related to the pedestrian leg.
        PedestrianLegDetails: RoutePedestrianLegDetails
        -- Specifies the mode of transport when calculating a route. Used in estimating the speed of travel and road compatibility. Default value: Car
        TravelMode: string
        -- Type of the leg.
        Type: string
        -- Details related to the vehicle leg.
        VehicleLegDetails: RouteVehicleLegDetails
    end

    -- Important labels including names and route numbers that differentiate the current route from the alternatives presented.
    record RouteMajorRoadLabel
        -- Name of the road (localized).
        RoadName: LocalizedString
        -- Route number of the road.
        RouteNumber: RouteNumber
    end

    -- Summary of the route and toll price.
    record RouteTollPriceSummary
        -- Currency code corresponding to the price. This is the same as Currency specified in the request.
        Currency: string
        -- If the price is an estimate or an exact value.
        Estimate: boolean
        -- If the price is a range or an exact value. If any of the toll fares making up the route is a range, the overall price is also a range.
        Range: boolean
        -- Price range with a minimum and maximum value, if a range.
        RangeValue: RouteTollPriceValueRange
        -- Exact price, if not a range.
        Value: number
    end

    -- The toll summary for the complete route.
    record RouteTollSummary
        -- Total toll summary for the complete route. Total is the only summary available today.
        Total: RouteTollPriceSummary
    end

    -- Summarized details for the leg including travel steps only. The Distance for the travel only portion of the journey is the same as the Distance within the Overview summary.
    record RouteSummary
        -- Distance of the route.
        Distance: number
        -- Duration of the route. Unit: seconds
        Duration: number
        -- Toll summary for the complete route.
        Tolls: RouteTollSummary
    end

    -- The route.
    record Route
        -- A leg is a section of a route from one waypoint to the next. A leg could be of type Vehicle, Pedestrian or Ferry. Legs of different types could occur together within a single route. For example, a car employing the use of a Ferry will contain Vehicle legs corresponding to journey on land, and Ferry legs corresponding to the journey via Ferry.
        Legs: {RouteLeg}
        -- Important labels including names and route numbers that differentiate the current route from the alternatives presented.
        MajorRoadLabels: {RouteMajorRoadLabel}
        -- Summarized details of the leg.
        Summary: RouteSummary
    end

    record CalculateRoutesOutput
        -- Specifies the format of the geometry returned for each leg of the route.
        LegGeometryFormat: string
        -- Notices are additional information returned that indicate issues that occurred during route calculation. Not supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
        Notices: {RouteResponseNotice}
        -- The pricing bucket for which the query is charged at.
        PricingBucket: string
        -- The path from the origin to the destination.
        Routes: {Route}
    end

    enum DayOfWeek
        "Monday"
        "Tuesday"
        "Wednesday"
        "Thursday"
        "Friday"
        "Saturday"
        "Sunday"
    end

    -- Geometry of the area to be avoided.
    record WaypointOptimizationAvoidanceAreaGeometry
        -- Geometry defined as a bounding box. The first pair represents the X and Y coordinates (longitude and latitude,) of the southwest corner of the bounding box; the second pair represents the X and Y coordinates (longitude and latitude) of the northeast corner.
        BoundingBox: {number}
    end

    -- The area to be avoided.
    record WaypointOptimizationAvoidanceArea
        -- Geometry of the area to be avoided.
        Geometry: WaypointOptimizationAvoidanceAreaGeometry
    end

    -- Specifies options for areas to avoid. This is a best-effort avoidance setting, meaning the router will try to honor the avoidance preferences but may still include restricted areas if no feasible alternative route exists. If avoidance options are not followed, the response will indicate that the avoidance criteria were violated.
    record WaypointOptimizationAvoidanceOptions
        -- Areas to be avoided.
        Areas: {WaypointOptimizationAvoidanceArea}
        -- Avoidance options for cars-shuttles-trains.
        CarShuttleTrains: boolean
        -- Avoid controlled access highways while calculating the route.
        ControlledAccessHighways: boolean
        -- Avoid dirt roads while calculating the route.
        DirtRoads: boolean
        -- Avoidance options for ferries.
        Ferries: boolean
        -- Avoids roads where the specified toll transponders are the only mode of payment.
        TollRoads: boolean
        -- Avoid tunnels while calculating the route.
        Tunnels: boolean
        -- Avoid U-turns for calculation on highways and motorways.
        UTurns: boolean
    end

    enum WaypointOptimizationClusteringAlgorithm
        "DrivingDistance"
        "TopologySegment"
    end

    -- Driving distance related options.
    record WaypointOptimizationDrivingDistanceOptions
        -- DrivingDistance assigns all the waypoints that are within driving distance of each other into a single cluster.
        DrivingDistance: number
    end

    -- Options for WaypointOptimizationClustering.
    record WaypointOptimizationClusteringOptions
        -- The algorithm to be used. DrivingDistance assigns all the waypoints that are within driving distance of each other into a single cluster. TopologySegment assigns all the waypoints that are within the same topology segment into a single cluster. A Topology segment is a linear stretch of road between two junctions.
        Algorithm: string
        -- Driving distance options to be used when the clustering algorithm is DrivingDistance.
        DrivingDistanceOptions: WaypointOptimizationDrivingDistanceOptions
    end

    -- Hours of entry.
    record WaypointOptimizationAccessHoursEntry
        -- Day of the week.
        DayOfWeek: string
        -- Time of the day.
        TimeOfDay: string
    end

    -- Access hours corresponding to when a destination can be visited.
    record WaypointOptimizationAccessHours
        -- Contains the ID of the starting waypoint in this connection.
        From: WaypointOptimizationAccessHoursEntry
        -- Contains the ID of the ending waypoint in this connection.
        To: WaypointOptimizationAccessHoursEntry
    end

    -- Options to configure matching the provided position to a side of the street.
    record WaypointOptimizationSideOfStreetOptions
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
        -- Strategy that defines when the side of street position should be used. AnyStreet will always use the provided position. Default value: DividedStreetOnly
        UseWith: string
    end

    -- Destination related options.
    record WaypointOptimizationDestinationOptions
        -- Access hours corresponding to when a waypoint can be visited.
        AccessHours: WaypointOptimizationAccessHours
        -- Appointment time at the destination.
        AppointmentTime: string
        -- GPS Heading at the position.
        Heading: number
        -- The waypoint Id.
        Id: string
        -- Service time spent at the destination. At an appointment, the service time should be the appointment duration. Unit: seconds
        ServiceDuration: number
        -- Options to configure matching the provided position to a side of the street.
        SideOfStreet: WaypointOptimizationSideOfStreetOptions
    end

    -- Driver work-rest schedules defined by a short and long cycle. A rest needs to be taken after the short work duration. The short cycle can be repeated until you hit the long work duration, at which point the long rest duration should be taken before restarting. Unit: seconds
    record WaypointOptimizationRestCycleDurations
        -- Resting phase of the cycle. Unit: seconds
        RestDuration: number
        -- Working phase of the cycle. Unit: seconds
        WorkDuration: number
    end

    -- Resting phase of the cycle.
    record WaypointOptimizationRestCycles
        -- Long cycle for a driver work-rest schedule.
        LongCycle: WaypointOptimizationRestCycleDurations
        -- Short cycle for a driver work-rest schedule
        ShortCycle: WaypointOptimizationRestCycleDurations
    end

    -- Pre defined rest profiles for a driver schedule. The only currently supported profile is EU.
    record WaypointOptimizationRestProfile
        -- Pre defined rest profiles for a driver schedule. The only currently supported profile is EU.
        Profile: string
    end

    enum WaypointOptimizationServiceTimeTreatment
        "Rest"
        "Work"
    end

    -- Driver related options.
    record WaypointOptimizationDriverOptions
        -- Driver work-rest schedules defined by a short and long cycle. A rest needs to be taken after the short work duration. The short cycle can be repeated until you hit the long work duration, at which point the long rest duration should be taken before restarting.
        RestCycles: WaypointOptimizationRestCycles
        -- Pre defined rest profiles for a driver schedule. The only currently supported profile is EU.
        RestProfile: WaypointOptimizationRestProfile
        -- If the service time provided at a waypoint/destination should be considered as rest or work. This contributes to the total time breakdown returned within the response.
        TreatServiceTimeAs: string
    end

    -- Specifies strict exclusion options for the route calculation. This setting mandates that the router will avoid any routes that include the specified options, rather than merely attempting to minimize them.
    record WaypointOptimizationExclusionOptions
        -- List of countries to be avoided defined by two-letter or three-letter country codes.
        Countries: {string}
    end

    enum WaypointOptimizationSequencingObjective
        "FastestRoute"
        "ShortestRoute"
    end

    -- Origin related options.
    record WaypointOptimizationOriginOptions
        -- The Origin Id.
        Id: string
    end

    -- Options related to traffic.
    record WaypointOptimizationTrafficOptions
        -- Determines if traffic should be used or ignored while calculating the route. Default value: UseTrafficData
        Usage: string
    end

    enum WaypointOptimizationTravelMode
        "Car"
        "Pedestrian"
        "Scooter"
        "Truck"
    end

    -- Options related to a pedestrian.
    record WaypointOptimizationPedestrianOptions
        -- Walking speed. Unit: kilometers per hour
        Speed: number
    end

    enum WaypointOptimizationHazardousCargoType
        "Combustible"
        "Corrosive"
        "Explosive"
        "Flammable"
        "Gas"
        "HarmfulToWater"
        "Organic"
        "Other"
        "Poison"
        "PoisonousInhalation"
        "Radioactive"
    end

    -- Trailer options corresponding to the vehicle.
    record WaypointOptimizationTrailerOptions
        -- Number of trailers attached to the vehicle. Default value: 0
        TrailerCount: number
    end

    enum WaypointOptimizationTruckType
        "StraightTruck"
        "Tractor"
    end

    -- Travel mode options when the provided travel mode is Truck.
    record WaypointOptimizationTruckOptions
        -- Gross weight of the vehicle including trailers, and goods at capacity. Unit: kilograms
        GrossWeight: number
        -- List of Hazardous cargo contained in the vehicle.
        HazardousCargos: {string}
        -- Height of the vehicle. Unit: centimeters
        Height: number
        -- Length of the vehicle. Unit: centimeters
        Length: number
        -- Trailer options corresponding to the vehicle.
        Trailer: WaypointOptimizationTrailerOptions
        -- The type of truck: LightTruck for smaller delivery vehicles, StraightTruck for rigid body trucks, or Tractor for tractor-trailer combinations.
        TruckType: string
        -- The tunnel restriction code. Tunnel categories in this list indicate the restrictions which apply to certain tunnels in Great Britain. They relate to the types of dangerous goods that can be transported through them. Tunnel Category B Risk Level: Limited risk Restrictions: Few restrictions Tunnel Category C Risk Level: Medium risk Restrictions: Some restrictions Tunnel Category D Risk Level: High risk Restrictions: Many restrictions occur Tunnel Category E Risk Level: Very high risk Restrictions: Restricted tunnel
        TunnelRestrictionCode: string
        -- Heaviest weight per axle irrespective of the axle type or the axle group. Meant for usage in countries where the differences in axle types or axle groups are not distinguished. Unit: kilograms
        WeightPerAxle: number
        -- Width of the vehicle. Unit: centimeters
        Width: number
    end

    -- Travel mode related options for the provided travel mode.
    record WaypointOptimizationTravelModeOptions
        -- Travel mode options when the provided travel mode is Pedestrian.
        Pedestrian: WaypointOptimizationPedestrianOptions
        -- Travel mode options when the provided travel mode is Truck.
        Truck: WaypointOptimizationTruckOptions
    end

    -- Waypoint between the Origin and Destination.
    record WaypointOptimizationWaypoint
        -- Access hours corresponding to when a waypoint can be visited.
        AccessHours: WaypointOptimizationAccessHours
        -- Appointment time at the waypoint.
        AppointmentTime: string
        -- Constraint defining what waypoints are to be visited after this waypoint.
        Before: {number}
        -- GPS Heading at the position.
        Heading: number
        -- The waypoint Id.
        Id: string
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
        -- Service time spent at the waypoint. At an appointment, the service time should be the appointment duration. Unit: seconds
        ServiceDuration: number
        -- Options to configure matching the provided position to a side of the street.
        SideOfStreet: WaypointOptimizationSideOfStreetOptions
    end

    record OptimizeWaypointsInput
        -- Features that are avoided. Avoidance is on a best-case basis. If an avoidance can't be satisfied for a particular case, this setting is ignored.
        Avoid: WaypointOptimizationAvoidanceOptions
        -- Clustering allows you to specify how nearby waypoints can be clustered to improve the optimized sequence.
        Clustering: WaypointOptimizationClusteringOptions
        -- Departure time from the waypoint. Time format:YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples: 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
        DepartureTime: string
        -- The final position for the route in the World Geodetic System (WGS 84) format: [longitude, latitude].
        Destination: {number}
        -- Destination related options.
        DestinationOptions: WaypointOptimizationDestinationOptions
        -- Driver related options.
        Driver: WaypointOptimizationDriverOptions
        -- Features to be strictly excluded while calculating the route.
        Exclude: WaypointOptimizationExclusionOptions
        -- Optional: The API key to be used for authorization. Either an API key or valid SigV4 signature must be provided when making a request.
        Key: string
        -- Specifies the optimization criteria for the calculated sequence. Default value: FastestRoute.
        OptimizeSequencingFor: string
        -- The start position for the route in World Geodetic System (WGS 84) format: [longitude, latitude].
        Origin: {number}
        -- Origin related options.
        OriginOptions: WaypointOptimizationOriginOptions
        -- Traffic-related options.
        Traffic: WaypointOptimizationTrafficOptions
        -- Specifies the mode of transport when calculating a route. Used in estimating the speed of travel and road compatibility. Default value: Car
        TravelMode: string
        -- Travel mode related options for the provided travel mode.
        TravelModeOptions: WaypointOptimizationTravelModeOptions
        -- List of waypoints between the Origin and Destination.
        Waypoints: {WaypointOptimizationWaypoint}
    end

    -- This contains information such as distance and duration from one waypoint to the next waypoint in the sequence.
    record WaypointOptimizationConnection
        -- Distance of the step.
        Distance: number
        -- contains the ID of the starting waypoint in this connection.
        From: string
        -- Resting time before the driver can continue driving.
        RestDuration: number
        -- Contains the ID of the ending waypoint in this connection.
        To: string
        -- Total duration. Unit: seconds
        TravelDuration: number
        -- Duration of a wait step. Unit: seconds
        WaitDuration: number
    end

    enum WaypointOptimizationConstraint
        "AccessHours"
        "AppointmentTime"
        "Before"
        "Heading"
        "ServiceDuration"
        "SideOfStreet"
    end

    -- The failed constraint.
    record WaypointOptimizationFailedConstraint
        -- The failed constraint.
        Constraint: string
        -- Reason for the failed constraint.
        Reason: string
    end

    -- The impeding waypoint.
    record WaypointOptimizationImpedingWaypoint
        -- Failed constraints for an impeding waypoint.
        FailedConstraints: {WaypointOptimizationFailedConstraint}
        -- The waypoint Id.
        Id: string
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
    end

    -- The optimized waypoint.
    record WaypointOptimizationOptimizedWaypoint
        -- Estimated time of arrival at the destination. Time format:YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples: 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
        ArrivalTime: string
        -- Index of the cluster the waypoint is associated with. The index is included in the response only if clustering was performed while processing the request.
        ClusterIndex: number
        -- Estimated time of departure from the origin. Time format:YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples: 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
        DepartureTime: string
        -- The waypoint Id.
        Id: string
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
    end

    -- Time breakdown for the sequence.
    record WaypointOptimizationTimeBreakdown
        -- Resting phase of the cycle. Unit: seconds
        RestDuration: number
        -- Service time spent at the destination. At an appointment, the service time should be the appointment duration. Unit: seconds
        ServiceDuration: number
        -- Traveling phase of the cycle. Unit: seconds
        TravelDuration: number
        -- Waiting phase of the cycle. Unit: seconds
        WaitDuration: number
    end

    record OptimizeWaypointsOutput
        -- Details about the connection from one waypoint to the next, within the optimized sequence.
        Connections: {WaypointOptimizationConnection}
        -- Overall distance to travel the whole sequence.
        Distance: number
        -- Overall duration to travel the whole sequence. Unit: seconds
        Duration: number
        -- Returns waypoints that caused the optimization problem to fail, and the constraints that were unsatisfied leading to the failure.
        ImpedingWaypoints: {WaypointOptimizationImpedingWaypoint}
        -- Waypoints in the order of the optimized sequence.
        OptimizedWaypoints: {WaypointOptimizationOptimizedWaypoint}
        -- The pricing bucket for which the query is charged at.
        PricingBucket: string
        -- Time breakdown for the sequence.
        TimeBreakdown: WaypointOptimizationTimeBreakdown
    end

    -- TracePoint indices for which the provided notice code corresponds to.
    record RoadSnapTracePoint
        -- GPS Heading at the position.
        Heading: number
        -- Position in World Geodetic System (WGS 84) format: [longitude, latitude].
        Position: {number}
        -- Speed at the specified trace point . Unit: kilometers per hour
        Speed: number
        -- Timestamp of the event.
        Timestamp: string
    end

    enum RoadSnapTravelMode
        "Car"
        "Pedestrian"
        "Scooter"
        "Truck"
    end

    enum RoadSnapHazardousCargoType
        "Combustible"
        "Corrosive"
        "Explosive"
        "Flammable"
        "Gas"
        "HarmfulToWater"
        "Organic"
        "Other"
        "Poison"
        "PoisonousInhalation"
        "Radioactive"
    end

    -- Trailer options corresponding to the vehicle.
    record RoadSnapTrailerOptions
        -- Number of trailers attached to the vehicle. Default value: 0
        TrailerCount: number
    end

    -- Travel mode options when the provided travel mode is Truck.
    record RoadSnapTruckOptions
        -- Gross weight of the vehicle including trailers, and goods at capacity. Unit: kilograms
        GrossWeight: number
        -- List of Hazardous cargos contained in the vehicle.
        HazardousCargos: {string}
        -- Height of the vehicle. Unit: centimeters
        Height: number
        -- Length of the vehicle. Unit: centimeters
        Length: number
        -- Trailer options corresponding to the vehicle.
        Trailer: RoadSnapTrailerOptions
        -- The tunnel restriction code. Tunnel categories in this list indicate the restrictions which apply to certain tunnels in Great Britain. They relate to the types of dangerous goods that can be transported through them. Tunnel Category B Risk Level: Limited risk Restrictions: Few restrictions Tunnel Category C Risk Level: Medium risk Restrictions: Some restrictions Tunnel Category D Risk Level: High risk Restrictions: Many restrictions occur Tunnel Category E Risk Level: Very high risk Restrictions: Restricted tunnel
        TunnelRestrictionCode: string
        -- Width of the vehicle in centimeters.
        Width: number
    end

    -- Travel mode related options for the provided travel mode.
    record RoadSnapTravelModeOptions
        -- Travel mode options when the provided travel mode is Truck.
        Truck: RoadSnapTruckOptions
    end

    record SnapToRoadsInput
        -- Optional: The API key to be used for authorization. Either an API key or valid SigV4 signature must be provided when making a request.
        Key: string
        -- Chooses what the returned SnappedGeometry format should be. Default value: FlexiblePolyline
        SnappedGeometryFormat: string
        -- The radius around the provided tracepoint that is considered for snapping. Unit: meters Default value: 300
        SnapRadius: number
        -- List of trace points to be snapped onto the road network.
        TracePoints: {RoadSnapTracePoint}
        -- Specifies the mode of transport when calculating a route. Used in estimating the speed of travel and road compatibility. Default value: Car
        TravelMode: string
        -- Travel mode related options for the provided travel mode.
        TravelModeOptions: RoadSnapTravelModeOptions
    end

    enum RoadSnapNoticeCode
        "TracePointsHeadingIgnored"
        "TracePointsIgnored"
        "TracePointsMovedByLargeDistance"
        "TracePointsNotMatched"
        "TracePointsOutOfSequence"
        "TracePointsSpeedEstimated"
        "TracePointsSpeedIgnored"
    end

    -- Notices provide information around factors that may have influenced snapping in a manner atypical to the standard use cases.
    record RoadSnapNotice
        -- Code corresponding to the issue.
        Code: string
        -- The notice title.
        Title: string
        -- TracePoint indices for which the provided notice code corresponds to.
        TracePointIndexes: {number}
    end

    -- Interpolated geometry for the snapped route that is overlay-able onto a map.
    record RoadSnapSnappedGeometry
        -- An ordered list of positions used to plot a route on a map. LineString and Polyline are mutually exclusive properties.
        LineString: {{number}}
        -- An ordered list of positions used to plot a route on a map in a lossy compression format. LineString and Polyline are mutually exclusive properties.
        Polyline: string
    end

    -- TracePoints snapped onto the road network.
    record RoadSnapSnappedTracePoint
        -- Confidence value for the correctness of this point match.
        Confidence: number
        -- Position of the TracePoint provided within the request, at the same index.
        OriginalPosition: {number}
        -- Snapped position of the TracePoint provided within the request, at the same index.
        SnappedPosition: {number}
    end

    record SnapToRoadsOutput
        -- Notices are additional information returned that indicate issues that occurred during route calculation.
        Notices: {RoadSnapNotice}
        -- The pricing bucket for which the query is charged at.
        PricingBucket: string
        -- The interpolated geometry for the snapped route onto the road network.
        SnappedGeometry: RoadSnapSnappedGeometry
        -- Specifies the format of the geometry returned for each leg of the route.
        SnappedGeometryFormat: string
        -- The trace points snapped onto the road network.
        SnappedTracePoints: {RoadSnapSnappedTracePoint}
    end

end

return M
