        -- The input data config containing an S3 URI for the input manifest file that contains
        -- the list of fraudster registration requests.
        InputDataConfig: InputDataConfig
        -- The output data config containing the S3 location where Voice ID writes the job
        -- output file; you must also include a KMS key ID to encrypt the
        -- file.
        OutputDataConfig: OutputDataConfig
