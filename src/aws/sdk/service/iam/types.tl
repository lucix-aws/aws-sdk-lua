    -- Contains information about an IAM user entity.
    -- This data type is used as a response element in the following operations:
    -- CreateUser
    -- GetUser
    -- ListUsers
    record User
        -- The path to the user. For more information about paths, see IAM identifiers in the
        -- IAM User Guide.
