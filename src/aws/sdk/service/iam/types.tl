        -- included in the response to the ListPolicies operation.
        Description: string
        -- The date and time, in ISO 8601 date-time
        -- format, when the policy was created.
        CreateDate: number
        -- The date and time, in ISO 8601 date-time
        -- format, when the policy was last updated.
