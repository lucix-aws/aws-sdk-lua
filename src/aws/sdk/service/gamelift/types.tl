        -- The maximum number of players allowed across all game sessions that are currently
        -- being hosted across all instances in the fleet location.
        MaximumPlayerSessionCount: number
        -- The fleet location for the fleet utilization information, expressed as an Amazon Web Services Region
        -- code, such as us-west-2.
        Location: string
    end

    record DescribeFleetLocationUtilizationOutput
        -- Utilization information for the requested fleet location. Utilization objects are
        -- returned only for fleets and locations that currently exist.
        FleetUtilization: FleetUtilization
