        description: string
        language: string
        -- num of phrases in the entity
        numOfPhrases: number
        lastModifiedTime: number
    end

    -- Summarized information about an entity
    record DataAutomationLibraryEntitySummary
        vocabulary: VocabularyEntitySummary
    end

    -- List DataAutomationLibraryEntities Response
    record ListDataAutomationLibraryEntitiesOutput
        -- List of entities
        entities: {DataAutomationLibraryEntitySummary}
        -- Pagination token for retrieving the next set of results
        nextToken: string
    end

    record ListTagsForResourceInput
        resourceARN: string
    end

    record ListTagsForResourceOutput
        tags: {Tag}
    end

    record TagResourceInput
        resourceARN: string
        tags: {Tag}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        resourceARN: string
        tagKeys: {string}
    end

    record UntagResourceOutput
    end

end

return M
