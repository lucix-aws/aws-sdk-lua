    end

    record DetectDocumentTextInput
        -- The input document as base64-encoded bytes or an Amazon S3 object. If you use the AWS CLI
        -- to call Amazon Textract operations, you can't pass image bytes. The document must be an image
        -- in JPEG or PNG format.
        -- If you're using an AWS SDK to call Amazon Textract, you might not need to base64-encode
        -- image bytes that are passed using the Bytes field.
        Document: Document
    end

    record DetectDocumentTextOutput
        -- Metadata about the document. It contains the number of pages that are detected in the
        -- document.
        DocumentMetadata: DocumentMetadata
        -- An array of Block objects that contain the text that's detected in the
        -- document.
        Blocks: {Block}
        DetectDocumentTextModelVersion: string
    end

    -- A structure that holds information regarding a detected signature on a page.
    record DetectedSignature
        -- The page a detected signature was found on.
        Page: number
    end

    -- Contains information about the pages of a document, defined by logical boundary.
    record SplitDocument
        -- The index for a given document in a DocumentGroup of a specific Type.
        Index: number
        -- An array of page numbers for a for a given document, ordered by logical boundary.
        Pages: {number}
    end

    -- A structure containing information about an undetected signature on a page where it was expected but not found.
    record UndetectedSignature
        -- The page where a signature was expected but not found.
        Page: number
    end

    -- Summary information about documents grouped by the same document type.
    record DocumentGroup
        -- The type of document that Amazon Textract has detected. See Analyze Lending Response Objects for a list of all types returned by Textract.
        Type: string
        -- An array that contains information about the pages of a document, defined by logical boundary.
        SplitDocuments: {SplitDocument}
        -- A list of the detected signatures found in a document group.
        DetectedSignatures: {DetectedSignature}
        -- A list of any expected signatures not found in a document group.
        UndetectedSignatures: {UndetectedSignature}
    end

    -- The Amazon S3 bucket that contains the document to be processed. It's used by asynchronous
    -- operations.
    -- The input document can be an image file in JPEG or PNG format. It can also be a file in
    -- PDF format.
    record DocumentLocation
        -- The Amazon S3 bucket that contains the input document.
        S3Object: S3Object
    end

    -- The results extracted for a lending document.
    record LendingDetection
        -- The text extracted for a detected value in a lending document.
        Text: string
        -- The selection status of a selection element, such as an option button or check box.
        SelectionStatus: string
        Geometry: Geometry
        -- The confidence level for the text of a detected value in a lending document.
        Confidence: number
    end

    -- Holds the normalized key-value pairs returned by AnalyzeDocument, including the document type, detected text, and geometry.
    record LendingField
        -- The type of the lending document.
        Type: string
        KeyDetection: LendingDetection
        -- An array of LendingDetection objects.
        ValueDetections: {LendingDetection}
    end

    -- Information regarding a detected signature on a page.
    record SignatureDetection
        -- The confidence, from 0 to 100, in the predicted values for a detected signature.
        Confidence: number
        Geometry: Geometry
    end

    -- Holds the structured data returned by AnalyzeDocument for lending documents.
    record LendingDocument
        -- An array of LendingField objects.
        LendingFields: {LendingField}
        -- A list of signatures detected in a lending document.
        SignatureDetections: {SignatureDetection}
    end

    -- Contains information extracted by an analysis operation after using StartLendingAnalysis.
    record Extraction
        -- Holds the structured data returned by AnalyzeDocument for lending documents.
        LendingDocument: LendingDocument
        ExpenseDocument: ExpenseDocument
        IdentityDocument: IdentityDocument
    end

