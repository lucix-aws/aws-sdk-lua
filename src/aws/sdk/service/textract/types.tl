        -- This is a block object, the same as reported when DetectDocumentText is run on a document.
        -- It provides word level recognition of text.
        Blocks: {Block}
    end

    record AnalyzeExpenseOutput
        DocumentMetadata: DocumentMetadata
        -- The expenses detected by Amazon Textract.
        ExpenseDocuments: {ExpenseDocument}
    end

    record AnalyzeIDInput
        -- The document being passed to AnalyzeID.
        DocumentPages: {Document}
    end

    enum ValueType
        "DATE"
    end

    -- Contains information relating to dates in a document, including the type
    -- of value, and the value.
    record NormalizedValue
        -- The value of the date, written as Year-Month-DayTHour:Minute:Second.
        Value: string
        -- The normalized type of the value detected. In this case, DATE.
        ValueType: string
    end

    -- Used to contain the information detected by an AnalyzeID operation.
    record AnalyzeIDDetections
        -- Text of either the normalized field or value associated with it.
        Text: string
        -- Only returned for dates, returns the type of value detected and the date
        -- written in a more machine readable way.
        NormalizedValue: NormalizedValue
        -- The confidence score of the detected text.
        Confidence: number
    end

    -- Structure containing both the normalized type of the extracted information
    -- and the text associated with it. These are extracted as Type and Value respectively.
    record IdentityDocumentField
        Type: AnalyzeIDDetections
        ValueDetection: AnalyzeIDDetections
    end

    -- The structure that lists each document processed in an AnalyzeID operation.
    record IdentityDocument
        -- Denotes the placement of a document in the IdentityDocument list. The first document
        -- is marked 1, the second 2 and so on.
        DocumentIndex: number
        -- The structure used to record information extracted from identity documents.
        -- Contains both normalized field and value of the extracted text.
        IdentityDocumentFields: {IdentityDocumentField}
        -- Individual word recognition, as returned by document detection.
        Blocks: {Block}
    end

    record AnalyzeIDOutput
        -- The list of documents processed by AnalyzeID. Includes a number denoting their place in
        -- the list and the response structure for the document.
        IdentityDocuments: {IdentityDocument}
        DocumentMetadata: DocumentMetadata
        -- The version of the AnalyzeIdentity API being used to process documents.
        AnalyzeIDModelVersion: string
    end

    enum AutoUpdate
        "ENABLED"
        "DISABLED"
    end

    -- Updating or deleting a resource can cause an inconsistent state.
    record ConflictException
        Message: string
        Code: string
    end

    record CreateAdapterInput
        -- The name to be assigned to the adapter being created.
        AdapterName: string
        -- Idempotent token is used to recognize the request. If the same token is used with multiple
        -- CreateAdapter requests, the same session is returned.
        -- This token is employed to avoid unintentionally creating the same session multiple times.
        ClientRequestToken: string
        -- The description to be assigned to the adapter being created.
        Description: string
        -- The type of feature that the adapter is being trained on. Currrenly, supported feature
        -- types are: QUERIES
        FeatureTypes: {string}
        -- Controls whether or not the adapter should automatically update.
        AutoUpdate: string
        -- A list of tags to be added to the adapter.
        Tags: {string : string}
    end

    record CreateAdapterOutput
        -- A string containing the unique ID for the adapter that has been created.
        AdapterId: string
    end

    -- A ClientRequestToken input parameter was reused with an operation, but at
    -- least one of the other input parameters is different from the previous call to the
    -- operation.
    record IdempotentParameterMismatchException
        Message: string
        Code: string
    end

    -- An Amazon Textract service limit was exceeded. For example, if you start too many
    -- asynchronous jobs concurrently, calls to start operations
    -- (StartDocumentTextDetection, for example) raise a LimitExceededException
    -- exception (HTTP status code: 400) until the number of concurrently running jobs is below
    -- the Amazon Textract service limit.
    record LimitExceededException
        Message: string
        Code: string
    end

    -- Returned when a request cannot be completed as it would exceed a maximum service quota.
    record ServiceQuotaExceededException
        Message: string
        Code: string
    end

    -- Indicates that a request was not valid. Check request for proper formatting.
    record ValidationException
        Message: string
        Code: string
    end

    -- Sets whether or not your output will go to a user created bucket. Used to set the name
    -- of the bucket, and the prefix on the output file.
    -- OutputConfig is an optional parameter which lets you adjust where your
    -- output will be placed. By default, Amazon Textract will store the results internally and can
    -- only be accessed by the Get API operations. With OutputConfig enabled, you can
    -- set the name of the bucket the output will be sent to the file prefix of the results where
    -- you can download your results. Additionally, you can set the KMSKeyID
    -- parameter to a customer master key (CMK) to encrypt your output. Without this parameter set
    -- Amazon Textract will encrypt server-side using the AWS managed CMK for Amazon S3.
    -- Decryption of Customer Content is necessary for processing of the documents by Amazon Textract. If your account
    -- is opted out under an AI services opt out policy then all unencrypted Customer Content is immediately and permanently deleted after
    -- the Customer Content has been processed by the service. No copy of of the output is retained by Amazon Textract. For information about how to opt out, see Managing AI services opt-out policy.
    -- For more information on data privacy,
    -- see the Data Privacy
    -- FAQ.
    record OutputConfig
        -- The name of the bucket your output will go to.
        S3Bucket: string
        -- The prefix of the object key that the output will be saved to. When not enabled, the
        -- prefix will be “textract_output".
        S3Prefix: string
    end

    record CreateAdapterVersionInput
        -- A string containing a unique ID for the adapter that will receive a new version.
        AdapterId: string
        -- Idempotent token is used to recognize the request. If the same token is used with multiple
        -- CreateAdapterVersion requests, the same session is returned.
        -- This token is employed to avoid unintentionally creating the same session multiple times.
        ClientRequestToken: string
        -- Specifies a dataset used to train a new adapter version. Takes a ManifestS3Object as the
        -- value.
        DatasetConfig: AdapterVersionDatasetConfig
        -- The identifier for your AWS Key Management Service key (AWS KMS key). Used to encrypt your documents.
        KMSKeyId: string
        OutputConfig: OutputConfig
        -- A set of tags (key-value pairs) that you want to attach to the adapter version.
        Tags: {string : string}
    end

    record CreateAdapterVersionOutput
        -- A string containing the unique ID for the adapter that has received a new version.
        AdapterId: string
        -- A string describing the new version of the adapter.
        AdapterVersion: string
    end

    -- Indicates you do not have decrypt permissions with the KMS key entered, or the KMS key
    -- was entered incorrectly.
    record InvalidKMSKeyException
        Message: string
        Code: string
    end

    -- Returned when an operation tried to access a nonexistent resource.
    record ResourceNotFoundException
        Message: string
        Code: string
    end

