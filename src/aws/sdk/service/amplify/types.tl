    -- The request structure for the start a deployment request.
    record StartDeploymentInput
        -- The unique ID for an Amplify app.
        appId: string
        -- The name of the branch to use for the deployment job.
        branchName: string
        -- The job ID for this deployment that is generated by the CreateDeployment
        -- request.
        jobId: string
        -- The source URL for the deployment that is used when calling
        -- StartDeployment without CreateDeployment. The source URL
        -- can be either an HTTP GET URL that is publicly accessible and downloads a single .zip
        -- file, or an Amazon S3 bucket and prefix.
        sourceUrl: string
        -- The type of source specified by the sourceURL. If the value is
        -- ZIP, the source is a .zip file. If the value is
        -- BUCKET_PREFIX, the source is an Amazon S3 bucket and prefix. If
        -- no value is specified, the default is ZIP.
        sourceUrlType: string
    end

    -- The result structure for the start a deployment request.
    record StartDeploymentOutput
        -- The summary for the job.
        jobSummary: JobSummary
    end

    -- The request structure for the start job request.
    record StartJobInput
        -- The unique ID for an Amplify app.
        appId: string
        -- The name of the branch to use for the job.
        branchName: string
        -- The unique ID for an existing job. This is required if the value of
        -- jobType is RETRY.
        jobId: string
        -- Describes the type for the job. The job type RELEASE starts a new job
        -- with the latest change from the specified branch. This value is available only for apps
        -- that are connected to a repository.
        -- The job type RETRY retries an existing job. If the job type value is
        -- RETRY, the jobId is also required.
        jobType: string
        -- A descriptive reason for starting the job.
        jobReason: string
        -- The commit ID from a third-party repository provider for the job.
        commitId: string
        -- The commit message from a third-party repository provider for the job.
        commitMessage: string
        -- The commit date and time for the job.
        commitTime: number
    end

    -- The result structure for the run job request.
    record StartJobOutput
        -- The summary for the job.
        jobSummary: JobSummary
    end

