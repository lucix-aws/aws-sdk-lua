        Type: string
        Message: string
    end

    -- Lambda could not unzip the deployment package.
    record InvalidZipFileException
        Type: string
        Message: string
    end

    enum InvocationType
        "Event"
        "RequestResponse"
        "DryRun"
    end

    enum LogType
        "None"
        "Tail"
    end

    record InvokeInput
        -- The name or ARN of the Lambda function, version, or alias. Name formats Function name – my-function (name-only), my-function:v1 (with alias). Function ARN – arn:aws:lambda:us-west-2:123456789012:function:my-function. Partial ARN – 123456789012:function:my-function. You can append a version number or alias to any of the formats. The length constraint applies only to the full ARN. If you specify only the function name, it is limited to 64 characters in length.
        FunctionName: string
        -- Choose from the following options. RequestResponse (default) – Invoke the function synchronously. Keep the connection open until the function returns a response or times out. The API response includes the function response and additional data. Event – Invoke the function asynchronously. Send events that fail multiple times to the function's dead-letter queue (if one is configured). The API response only includes a status code. DryRun – Validate parameter values and verify that the user or role has permission to invoke the function.
        InvocationType: string
        -- Set to Tail to include the execution log in the response. Applies to synchronously invoked functions only.
        LogType: string
        -- Up to 3,583 bytes of base64-encoded data about the invoking client to pass to the function in the context object. Lambda passes the ClientContext object to your function for synchronous invocations only.
        ClientContext: string
        -- A unique name for the durable execution. If you invoke a durable function using a name that already exists with the same payload, Lambda returns the existing execution instead of creating a duplicate. If the payload differs, Lambda returns a DurableExecutionAlreadyStartedException error. If not specified, Lambda generates a unique identifier automatically. For more information, see Execution names.
        DurableExecutionName: string
        -- The JSON that you want to provide to your Lambda function as input. The maximum payload size is 6 MB for synchronous invocations and 1 MB for asynchronous invocations. You can enter the JSON directly. For example, --payload '{ "key": "value" }'. You can also specify a file path. For example, --payload file://payload.json.
        Payload: string
        -- Specify a version or alias to invoke a published version of the function.
        Qualifier: string
        -- The identifier of the tenant in a multi-tenant Lambda function.
        TenantId: string
    end

    record InvokeOutput
        -- The HTTP status code is in the 200 range for a successful request. For the RequestResponse invocation type, this status code is 200. For the Event invocation type, this status code is 202. For the DryRun invocation type, the status code is 204.
        StatusCode: number
        -- If present, indicates that an error occurred during function execution. Details about the error are included in the response payload.
        FunctionError: string
        -- The last 4 KB of the execution log, which is base64-encoded.
        LogResult: string
        -- The response from the function, or an error object.
        Payload: string
        -- The version of the function that executed. When you invoke a function with an alias, this indicates which version the alias resolved to.
        ExecutedVersion: string
        -- The ARN of the durable execution that was started. This is returned when invoking a durable function and provides a unique identifier for tracking the execution.
        DurableExecutionArn: string
    end

    -- The Lambda function doesn't support the invocation mode requested. For example, calling Invoke with InvocationType=RequestResponse on a function configured for asynchronous-only invocation, or vice versa. For more information about invocation types, see Invoking Lambda functions.
    record ModeNotSupportedException
        -- The exception type.
        Type: string
        -- The exception message.
        message: string
    end

    -- The function has no published versions available.
    record NoPublishedVersionException
        -- The exception type.
        Type: string
        Message: string
    end

    -- Lambda has detected your function being invoked in a recursive loop with other Amazon Web Services resources and stopped your function's invocation.
    record RecursiveInvocationException
        -- The exception type.
        Type: string
        -- The exception message.
        Message: string
    end

    -- The request payload exceeded the Invoke request body JSON input quota. For more information, see Lambda quotas.
    record RequestTooLargeException
        Type: string
        message: string
    end

    -- The function is inactive and its VPC connection is no longer available. Wait for the VPC connection to reestablish and try again.
    record ResourceNotReadyException
        -- The exception type.
        Type: string
        -- The exception message.
        message: string
    end

    -- The Lambda function couldn't make a network connection to the configured S3 Files access point.
    record S3FilesMountConnectivityException
        -- The exception type.
        Type: string
        -- The exception message.
        Message: string
    end

    -- The Lambda function couldn't mount the configured S3 Files access point due to a permission or configuration issue.
    record S3FilesMountFailureException
        -- The exception type.
        Type: string
        -- The exception message.
        Message: string
    end

    -- The Lambda function made a network connection to the configured S3 Files access point, but the mount operation timed out.
    record S3FilesMountTimeoutException
        -- The exception type.
        Type: string
        -- The exception message.
        Message: string
    end

    -- The request payload exceeded the maximum allowed size for serialized request entities.
    record SerializedRequestEntityTooLargeException
        -- The error type.
        Type: string
        message: string
    end

    -- The request would exceed a service quota. For more information about Lambda service quotas, see Lambda quotas. To request a quota increase, see Requesting a quota increase in the Service Quotas User Guide.
    record ServiceQuotaExceededException
        -- The exception type.
        Type: string
        -- The exception message.
        Message: string
    end

    -- The afterRestore() runtime hook encountered an error. For more information, check the Amazon CloudWatch logs.
    record SnapStartException
        Type: string
        Message: string
    end

    -- Lambda is initializing your function. You can invoke the function when the function state becomes Active.
    record SnapStartNotReadyException
        Type: string
        Message: string
    end

    -- Lambda couldn't regenerate the SnapStart snapshot for the function. SnapStart-enabled functions periodically regenerate snapshots when their underlying runtime or dependencies change; this regeneration failed. Wait for Lambda to retry, or update the function's configuration to trigger a new snapshot. For more information, see Lambda SnapStart.
    record SnapStartRegenerationFailureException
        -- The exception type.
        Type: string
        -- The exception message.
        Message: string
    end

    -- Lambda couldn't restore the snapshot within the timeout limit.
    record SnapStartTimeoutException
        Type: string
        Message: string
    end

    -- Lambda couldn't set up VPC access for the Lambda function because one or more configured subnets has no available IP addresses.
    record SubnetIPAddressLimitReachedException
        Type: string
        Message: string
    end

    -- The content type of the Invoke request body is not JSON.
    record UnsupportedMediaTypeException
        Type: string
        message: string
    end

    record InvokeAsyncInput
        -- The name or ARN of the Lambda function. Name formats Function name – my-function. Function ARN – arn:aws:lambda:us-west-2:123456789012:function:my-function. Partial ARN – 123456789012:function:my-function. The length constraint applies only to the full ARN. If you specify only the function name, it is limited to 64 characters in length.
        FunctionName: string
        -- The JSON that you want to provide to your Lambda function as input.
