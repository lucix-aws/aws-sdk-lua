    record AssociateTargetsWithJobInput
        -- A list of thing group ARNs that define the targets of the job.
        targets: {string}
        -- The unique identifier you assigned to this job when it was created.
        jobId: string
        -- An optional comment string describing why the job was associated with the
        -- targets.
        comment: string
        -- The namespace used to indicate that a job is a customer-managed job.
        -- When you specify a value for this parameter, Amazon Web Services IoT Core sends jobs notifications to
