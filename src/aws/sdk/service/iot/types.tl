    -- The value of a command parameter used to create a command execution.
    -- The commandParameterValue can only have one of the below fields
    -- listed.
    record CommandParameterValue
        -- An attribute of type String. For example:
        -- "S": "Hello"
        S: string
        -- An attribute of type Boolean. For example:
        -- "BOOL": true
        B: boolean
        -- An attribute of type Integer (Thirty-Two Bits).
        I: number
        -- An attribute of type Long.
        L: number
        -- An attribute of type Double (Sixty-Four Bits).
        D: number
        -- An attribute of type Binary. For example:
        -- "B": "dGhpcyB0ZXh0IGlzIGJhc2U2NC1lbmNvZGVk"
        BIN: string
        -- An attribute of type unsigned long.
        UL: string
    end

    enum CommandParameterType
        "STRING"
        "INTEGER"
        "DOUBLE"
        "LONG"
        "UNSIGNEDLONG"
        "BOOLEAN"
        "BINARY"
    end

    enum CommandParameterValueComparisonOperator
        "EQUALS"
        "NOT_EQUALS"
        "LESS_THAN"
        "LESS_THAN_EQUALS"
        "GREATER_THAN"
        "GREATER_THAN_EQUALS"
        "IN_SET"
        "NOT_IN_SET"
        "IN_RANGE"
        "NOT_IN_RANGE"
    end

    -- The numerical range value type to compare a command parameter value against.
    record CommandParameterValueNumberRange
        -- The minimum value of a numerical range of a command parameter value.
        min: string
        -- The maximum value of a numerical range of a command parameter value.
        max: string
    end

    -- The comparison operand used to compare the defined value against the value supplied in request.
    record CommandParameterValueComparisonOperand
        -- An operand of number value type, defined as a string.
        number: string
        -- A List of operands of numerical value type, defined as strings.
        numbers: {string}
        -- An operand of string value type.
        string: string
        -- A List of operands of string value type.
        strings: {string}
        -- An operand of numerical range value type.
        numberRange: CommandParameterValueNumberRange
    end

    -- A condition for the command parameter that must be evaluated to true for successful creation of a command execution.
    record CommandParameterValueCondition
        -- The comparison operator for the command parameter.
        -- IN_RANGE, and NOT_IN_RANGE operators include boundary values.
        comparisonOperator: string
        -- The comparison operand for the command parameter.
        operand: CommandParameterValueComparisonOperand
    end

    -- A map of key-value pairs that describe the command.
    record CommandParameter
        -- The name of a specific parameter used in a command and command execution.
        name: string
        -- Parameter value that overrides the default value, if set.
        value: CommandParameterValue
        -- The default value used to describe the command. This is the value assumed by the
        -- parameter if no other value is assigned to it.
        defaultValue: CommandParameterValue
        -- The list of conditions that a command parameter value must satisfy to create a command execution.
        valueConditions: {CommandParameterValueCondition}
        -- The description of the command parameter.
        description: string
    end

    enum CommandNamespace
        "AWS-IoT"
        "AWS-IoT-FleetWise"
    end

    -- The command payload object that contains the instructions for the device
    -- to process.
    record CommandPayload
        -- The static payload file for the command.
        content: string
        -- The content type that specifies the format type of the payload file. This
        -- field must use a type/subtype format, such as application/json.
        -- For information about various content types, see Common MIME types.
        contentType: string
    end

    enum OutputFormat
        "JSON"
        "CBOR"
    end

    -- Configures the command to treat the payloadTemplate as a JSON document for preprocessing.
    -- This preprocessor substitutes placeholders with parameter values to generate the command execution request payload.
    record AwsJsonSubstitutionCommandPreprocessorConfig
        -- Converts the command preprocessor result to the format defined by this parameter, before sending it to the device.
        outputFormat: string
    end

    -- Configuration that determines how the payloadTemplate is processed by the service to generate the final payload sent to
    -- devices at StartCommandExecution API invocation.
    record CommandPreprocessor
        -- Configuration for the JSON substitution preprocessor.
        awsJsonSubstitution: AwsJsonSubstitutionCommandPreprocessorConfig
    end

    record CreateCommandInput
        -- A unique identifier for the command. We recommend using UUID. Alpha-numeric
        -- characters, hyphens, and underscores are valid for use here.
        commandId: string
        -- The namespace of the command. The MQTT reserved topics and validations will be used
        -- for command executions according to the namespace setting.
        namespace: string
        -- The user-friendly name in the console for the command. This name doesn't have to be
        -- unique. You can update the user-friendly name after you define it.
        displayName: string
        -- A short text decription of the command.
        description: string
        -- The payload object for the static command.
        -- You can upload a static payload file from your local storage that contains the
        -- instructions for the device to process. The payload file can use any format. To
        -- make sure that the device correctly interprets the payload, we recommend you to
        -- specify the payload content type.
        payload: CommandPayload
        -- The payload template for the dynamic command.
        -- This parameter is required for dynamic commands where the
        -- command execution placeholders are supplied either from mandatoryParameters or when
        -- StartCommandExecution is invoked.
        payloadTemplate: string
        -- Configuration that determines how payloadTemplate is processed to generate command execution payload.
        -- This parameter is required for dynamic commands, along with payloadTemplate,
        -- and mandatoryParameters.
        preprocessor: CommandPreprocessor
        -- A list of parameters that are used by StartCommandExecution API for
        -- execution payload generation.
        mandatoryParameters: {CommandParameter}
        -- The IAM role that you must provide when using the AWS-IoT-FleetWise namespace.
        -- The role grants IoT Device Management the permission to access IoT FleetWise resources
        -- for generating the payload for the command. This field is not supported when you use the
        -- AWS-IoT namespace.
        roleArn: string
        -- Name-value pairs that are used as metadata to manage a command.
        tags: {Tag}
    end

    record CreateCommandOutput
        -- The unique identifier for the command.
        commandId: string
        -- The Amazon Resource Number (ARN) of the command. For example,
        -- arn:aws:iot:::command/
        commandArn: string
