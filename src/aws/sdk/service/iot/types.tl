    -- The input for the DescribeCACertificate operation.
    record DescribeCACertificateInput
        -- The CA certificate identifier.
        certificateId: string
    end

    enum CertificateMode
        "DEFAULT"
        "SNI_ONLY"
    end

    enum CACertificateStatus
        "ACTIVE"
        "INACTIVE"
    end

    -- When the certificate is valid.
    record CertificateValidity
        -- The certificate is not valid before this date.
        notBefore: number
        -- The certificate is not valid after this date.
        notAfter: number
    end

    -- Describes a CA certificate.
    record CACertificateDescription
        -- The CA certificate ARN.
        certificateArn: string
        -- The CA certificate ID.
        certificateId: string
        -- The status of a CA certificate.
        status: string
        -- The CA certificate data, in PEM format.
        certificatePem: string
        -- The owner of the CA certificate.
        ownedBy: string
        -- The date the CA certificate was created.
        creationDate: number
        -- Whether the CA certificate configured for auto registration of device certificates.
        -- Valid values are "ENABLE" and "DISABLE"
        autoRegistrationStatus: string
        -- The date the CA certificate was last modified.
        lastModifiedDate: number
        -- The customer version of the CA certificate.
        customerVersion: number
        -- The generation ID of the CA certificate.
        generationId: string
        -- When the CA certificate is valid.
        validity: CertificateValidity
        -- The mode of the CA.
        -- All the device certificates that are registered using this CA will be registered
        -- in the same mode as the CA. For more information about certificate mode for device certificates, see certificate mode.
        certificateMode: string
    end

    -- The registration configuration.
    record RegistrationConfig
        -- The template body.
        templateBody: string
        -- The ARN of the role.
        roleArn: string
        -- The name of the provisioning template.
        templateName: string
    end

    -- The output from the DescribeCACertificate operation.
    record DescribeCACertificateOutput
        -- The CA certificate description.
        certificateDescription: CACertificateDescription
        -- Information about the registration configuration.
        registrationConfig: RegistrationConfig
    end

    -- The input for the DescribeCertificate operation.
    record DescribeCertificateInput
        -- The ID of the certificate. (The last part of the certificate ARN contains the
        -- certificate ID.)
        certificateId: string
    end

    enum CertificateStatus
        "ACTIVE"
        "INACTIVE"
        "REVOKED"
        "PENDING_TRANSFER"
        "REGISTER_INACTIVE"
        "PENDING_ACTIVATION"
    end

    -- Data used to transfer a certificate to an Amazon Web Services account.
    record TransferData
        -- The transfer message.
        transferMessage: string
        -- The reason why the transfer was rejected.
        rejectReason: string
        -- The date the transfer took place.
        transferDate: number
        -- The date the transfer was accepted.
        acceptDate: number
        -- The date the transfer was rejected.
        rejectDate: number
    end

    -- Describes a certificate.
    record CertificateDescription
        -- The ARN of the certificate.
        certificateArn: string
        -- The ID of the certificate.
        certificateId: string
        -- The certificate ID of the CA certificate used to sign this certificate.
        caCertificateId: string
        -- The status of the certificate.
        status: string
        -- The certificate data, in PEM format.
        certificatePem: string
        -- The ID of the Amazon Web Services account that owns the certificate.
        ownedBy: string
        -- The ID of the Amazon Web Services account of the previous owner of the certificate.
        previousOwnedBy: string
        -- The date and time the certificate was created.
        creationDate: number
        -- The date and time the certificate was last modified.
        lastModifiedDate: number
        -- The customer version of the certificate.
        customerVersion: number
        -- The transfer data.
        transferData: TransferData
        -- The generation ID of the certificate.
        generationId: string
        -- When the certificate is valid.
        validity: CertificateValidity
        -- The mode of the certificate.
        -- DEFAULT: A certificate in DEFAULT mode is either generated by
        -- Amazon Web Services IoT Core or registered with an issuer certificate authority (CA) in DEFAULT mode. Devices with
        -- certificates in DEFAULT mode aren't required to send the Server Name
        -- Indication (SNI) extension when connecting to Amazon Web Services IoT Core. However, to use features such as
        -- custom domains and VPC endpoints, we recommend that you use the SNI extension when
        -- connecting to Amazon Web Services IoT Core.
        -- SNI_ONLY: A certificate in SNI_ONLY mode is registered without an issuer CA. Devices with certificates
        -- in SNI_ONLY mode must send the SNI extension when connecting to Amazon Web Services IoT Core.
        -- For more information about the value for SNI extension, see Transport security in IoT.
        certificateMode: string
    end

    -- The output of the DescribeCertificate operation.
    record DescribeCertificateOutput
        -- The description of the certificate.
        certificateDescription: CertificateDescription
    end

    record DescribeCertificateProviderInput
        -- The name of the certificate provider.
        certificateProviderName: string
    end

    record DescribeCertificateProviderOutput
        -- The name of the certificate provider.
        certificateProviderName: string
        -- The ARN of the certificate provider.
        certificateProviderArn: string
        -- The Lambda function ARN that's associated with the certificate provider.
        lambdaFunctionArn: string
        -- A list of the operations that the certificate provider will use to generate certificates.
        -- Valid value: CreateCertificateFromCsr.
        accountDefaultForOperations: {string}
        -- The date-time string that indicates when the certificate provider was created.
        creationDate: number
        -- The date-time string that indicates when the certificate provider was last updated.
        lastModifiedDate: number
    end

