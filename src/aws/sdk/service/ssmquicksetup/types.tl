        -- Returns details about the settings for Quick Setup in the requesting Amazon Web Services account and Amazon Web Services Region.
        ServiceSettings: ServiceSettings
    end

    record ListConfigurationManagersInput
        -- The token to use when requesting a specific set of items from a list.
        StartingToken: string
        -- Specifies the maximum number of configuration managers that are returned by the
        -- request.
        MaxItems: number
        -- Filters the results returned by the request.
        Filters: {Filter}
    end

    record ListConfigurationManagersOutput
        -- The configuration managers returned by the request.
        ConfigurationManagersList: {ConfigurationManagerSummary}
        -- The token to use when requesting the next set of configuration managers. If there
        -- are no additional operations to return, the string is empty.
        NextToken: string
    end

    record ListConfigurationsInput
        -- The token to use when requesting a specific set of items from a list.
        StartingToken: string
        -- Specifies the maximum number of configurations that are returned by the
        -- request.
        MaxItems: number
        -- Filters the results returned by the request.
        Filters: {Filter}
        -- The ARN of the configuration manager.
        ManagerArn: string
        -- The ID of the configuration definition.
        ConfigurationDefinitionId: string
    end

    record ListConfigurationsOutput
        -- An array of configurations.
        ConfigurationsList: {ConfigurationSummary}
        -- The token to use when requesting the next set of items. If there are no additional items to
        -- return, the string is empty.
        NextToken: string
    end

    record ListQuickSetupTypesInput
    end

    -- Information about the Quick Setup type.
    record QuickSetupTypeOutput
        -- The type of the Quick Setup configuration.
        Type: string
        -- The latest version number of the configuration.
        LatestVersion: string
    end

    record ListQuickSetupTypesOutput
        -- An array of Quick Setup types.
        QuickSetupTypeList: {QuickSetupTypeOutput}
    end

    record ListTagsForResourceInput
        -- The ARN of the resource the tag is assigned to.
        ResourceArn: string
    end

    -- Key-value pairs of metadata.
    record TagEntry
        -- The key for the tag.
        Key: string
        -- The value for the tag.
        Value: string
    end

    record ListTagsForResourceOutput
        -- Key-value pairs of metadata assigned to the resource.
        Tags: {TagEntry}
    end

    record TagResourceInput
        -- The ARN of the resource to tag.
        ResourceArn: string
        -- Key-value pairs of metadata to assign to the resource.
        Tags: {string : string}
    end

    record TagResourceOutput
    end

    record UntagResourceInput
        -- The ARN of the resource to remove tags from.
        ResourceArn: string
        -- The keys of the tags to remove from the resource.
        TagKeys: {string}
    end

    record UntagResourceOutput
    end

    record UpdateConfigurationDefinitionInput
        -- The ARN of the configuration manager associated with the definition to
        -- update.
        ManagerArn: string
        -- The ID of the configuration definition you want to update.
        Id: string
        -- The version of the Quick Setup type to use.
        TypeVersion: string
        -- The parameters for the configuration definition type.
        Parameters: {string : string}
        -- The name of the IAM role used to deploy local
        -- configurations.
        LocalDeploymentExecutionRoleName: string
        -- The ARN of the IAM role used to administrate local configuration
        -- deployments.
        LocalDeploymentAdministrationRoleArn: string
    end

    record UpdateConfigurationDefinitionOutput
    end

    record UpdateConfigurationManagerInput
        -- The ARN of the configuration manager.
        ManagerArn: string
        -- A name for the configuration manager.
        Name: string
        -- A description of the configuration manager.
        Description: string
    end

    record UpdateConfigurationManagerOutput
    end

    record UpdateServiceSettingsInput
        -- The IAM role used to enable Explorer.
        ExplorerEnablingRoleArn: string
    end

    record UpdateServiceSettingsOutput
    end

end

return M
