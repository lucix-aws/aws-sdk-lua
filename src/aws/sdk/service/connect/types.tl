        "CONTACTS_HANDLED_OUTBOUND"
        "CONTACTS_HOLD_ABANDONS"
        "CONTACTS_TRANSFERRED_IN"
        "CONTACTS_TRANSFERRED_OUT"
        "CONTACTS_TRANSFERRED_IN_FROM_QUEUE"
        "CONTACTS_TRANSFERRED_OUT_FROM_QUEUE"
        "CONTACTS_MISSED"
