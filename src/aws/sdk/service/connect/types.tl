        -- Unit: COUNT
        -- Statistic: SUM
        -- UI name: Callback contacts
        -- handled
        -- CONTACTS_ABANDONED
        -- Unit: COUNT
        -- Statistic: SUM
        -- UI name: Contacts abandoned
