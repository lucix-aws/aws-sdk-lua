    record DescribeDataTableInput
        -- The unique identifier for the Amazon Connect instance.
        InstanceId: string
        -- The unique identifier for the data table. Must also accept the table ARN with or without a version alias. If no
        -- alias is provided, the default behavior is identical to providing the $LATEST alias.
        DataTableId: string
    end

    -- Represents a data table in Amazon Connect. A data table is a JSON-like data structure where attributes and
    -- values are dynamically set by customers. Customers can reference table values within call flows, applications, views,
    -- and workspaces to pinpoint dynamic configuration that changes their contact center's behavior in a predetermined and
    -- safe way.
    record DataTable
        -- The human-readable name of the data table. Must be unique within the instance and conform to Connect naming
        -- standards.
        Name: string
        -- The unique identifier for the data table. Does not include version aliases.
        Id: string
        -- The Amazon Resource Name (ARN) for the data table. Does not include version aliases.
        Arn: string
        -- The IANA timezone identifier used when resolving time based dynamic values. Required even if no time slices are
        -- specified.
        TimeZone: string
        -- An optional description of the data table's purpose and contents.
        Description: string
        -- The data level that concurrent value edits are locked on. One of DATA_TABLE, PRIMARY_VALUE, ATTRIBUTE, VALUE,
        -- and NONE. Determines how concurrent edits are handled when multiple users attempt to modify values
        -- simultaneously.
        ValueLockLevel: string
        -- The lock version information used for optimistic locking and table versioning. Changes with each update to
        -- prevent concurrent modification conflicts.
        LockVersion: DataTableLockVersion
        -- A unique identifier and alias for customer managed versions (not $LATEST or $SAVED).
        Version: string
        -- A description of the customer managed version.
        VersionDescription: string
        -- The current status of the data table. One of PUBLISHED or SAVED.
        Status: string
        -- The timestamp when the data table was created.
        CreatedTime: number
        -- The timestamp when the data table or any of its properties were last modified.
        LastModifiedTime: number
        -- The Amazon Web Services Region where the data table was last modified, used for region replication.
        LastModifiedRegion: string
        -- Key-value pairs for attribute based access control (TBAC or ABAC) and organization.
        Tags: {string : string}
    end

    record DescribeDataTableOutput
        -- The complete data table information including metadata, configuration, and versioning details.
        DataTable: DataTable
    end

    record DescribeDataTableAttributeInput
        -- The unique identifier for the Amazon Connect instance.
        InstanceId: string
        -- The unique identifier for the data table. Must also accept the table ARN with or without a version alias.
        DataTableId: string
        -- The name of the attribute to retrieve detailed information for.
        AttributeName: string
    end

    -- Represents an attribute (column) in a data table. Attributes define the schema and validation rules for values
    -- that can be stored in the table. They specify the data type, constraints, and whether the attribute is used as a
    -- primary key for record identification.
    record DataTableAttribute
        -- The unique identifier for the attribute within the data table.
        AttributeId: string
        -- The human-readable name of the attribute. Must be unique within the data table and conform to Connect naming
        -- standards.
        Name: string
        -- The type of value allowed for this attribute. Must be one of TEXT, TEXT_LIST, NUMBER, NUMBER_LIST, or BOOLEAN.
        -- Determines how values are validated and processed.
        ValueType: string
        -- An optional description explaining the purpose and usage of this attribute.
        Description: string
        -- The unique identifier of the data table that contains this attribute.
        DataTableId: string
        -- The Amazon Resource Name (ARN) of the data table that contains this attribute.
        DataTableArn: string
        -- Boolean indicating whether this attribute is used as a primary key for record identification. Primary attributes
        -- must have unique value combinations and cannot contain expressions.
        Primary: boolean
        -- The version identifier for this attribute, used for versioning and change tracking.
        Version: string
        -- The lock version for this attribute, used for optimistic locking to prevent concurrent modification
        -- conflicts.
        LockVersion: DataTableLockVersion
        -- The timestamp when this attribute was last modified.
        LastModifiedTime: number
        -- The Amazon Web Services Region where this attribute was last modified, used for region replication.
        LastModifiedRegion: string
        -- The validation rules applied to values of this attribute. Based on JSON Schema Draft 2020-12 with additional
        -- Connect-specific validations for data integrity.
        Validation: Validation
    end

    record DescribeDataTableAttributeOutput
        -- The complete attribute information including configuration, validation rules, lock version, and metadata.
        Attribute: DataTableAttribute
    end

