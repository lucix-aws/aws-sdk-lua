    -- Contains the name, thresholds, and metric filters.
    record MetricDataV2
        -- The metric name or metricId, thresholds, and metric filters of the returned metric.
        Metric: MetricV2
        -- The corresponding value of the metric returned in the response.
        Value: number
    end

    -- The interval period with the start and end time for the metrics.
    record MetricInterval
        -- The interval period provided in the API request.
        Interval: string
        -- The timestamp, in UNIX Epoch time format. Start time is based on the interval period selected.
        StartTime: number
        -- The timestamp, in UNIX Epoch time format. End time is based on the interval period selected. For example, If
        -- IntervalPeriod is selected THIRTY_MIN, StartTime and EndTime in
        -- the API request differs by 1 day, then 48 results are returned in the response. Each result is aggregated by the 30
        -- minutes period, with each StartTime and EndTime differing by 30 minutes.
        EndTime: number
    end

    -- Contains information about the metric results.
    record MetricResultV2
        -- The dimension for the metrics.
        Dimensions: {string : string}
        -- The interval period with the start and end time for the metrics.
        MetricInterval: MetricInterval
        -- The set of metrics.
        Collections: {MetricDataV2}
    end

    record GetMetricDataV2Output
        -- If there are additional results, this is the token for the next set of results.
        NextToken: string
        -- Information about the metrics requested in the API request If no grouping is specified, a summary of metric data
        -- is returned.
        MetricResults: {MetricResultV2}
    end

    record GetPromptFileInput
        -- The identifier of the Connect Customer instance. You can find the instance ID in the Amazon Resource Name (ARN) of the instance.
        InstanceId: string
        -- A unique identifier for the prompt.
        PromptId: string
    end

    record GetPromptFileOutput
        -- A generated URL to the prompt that can be given to an unauthorized user so they can access the prompt in
        -- S3.
        PromptPresignedUrl: string
        -- The timestamp when this resource was last modified.
        LastModifiedTime: number
        -- The Amazon Web Services Region where this resource was last modified.
        LastModifiedRegion: string
    end

    record GetTaskTemplateInput
        -- The identifier of the Connect Customer instance. You can find the instance ID in the Amazon Resource Name (ARN) of the instance.
        InstanceId: string
        -- A unique identifier for the task template.
        TaskTemplateId: string
        -- The system generated version of a task template that is associated with a task, when the task is created.
        SnapshotVersion: string
    end

    record GetTaskTemplateOutput
        -- The identifier of the Connect Customer instance. You can find the instance ID in the Amazon Resource Name (ARN) of the instance.
        InstanceId: string
        -- A unique identifier for the task template.
        Id: string
        -- The Amazon Resource Name (ARN).
        Arn: string
        -- The name of the task template.
        Name: string
        -- The description of the task template.
        Description: string
        -- The identifier of the flow that runs by default when a task is created by referencing this template.
        ContactFlowId: string
        -- The ContactFlowId for the flow that will be run if this template is used to create a self-assigned task.
        SelfAssignFlowId: string
        -- Constraints that are applicable to the fields listed.
        -- Although this parameter is marked as optional in the API model, the service requires it when calling CreateTaskTemplate or UpdateTaskTemplate.
        -- The RequiredFields array must contain at least one element, and the field of type NAME must be included in RequiredFields.
        Constraints: TaskTemplateConstraints
        -- The default values for fields when a task is created by referencing this template.
        Defaults: TaskTemplateDefaults
        -- Fields that are part of the template.
        Fields: {TaskTemplateField}
        -- Marks a template as ACTIVE or INACTIVE for a task to refer to it.
        -- Tasks can only be created from ACTIVE templates.
        -- If a template is marked as INACTIVE, then a task that refers to this template cannot be created.
        Status: string
        -- The timestamp when the task template was last modified.
        LastModifiedTime: number
        -- The timestamp when the task template was created.
        CreatedTime: number
        -- The tags used to organize, track, or control access for this resource. For example, { "Tags": {"key1":"value1", "key2":"value2"} }.
        Tags: {string : string}
    end

    record GetTestCaseExecutionSummaryInput
        -- The identifier of the Amazon Connect instance.
        InstanceId: string
        -- The identifier of the test case.
        TestCaseId: string
        -- The identifier of the test case execution.
        TestCaseExecutionId: string
    end

    -- Contains summary statistics about a test case execution.
    record ObservationSummary
        -- The total number of observations in the test case.
        TotalObservations: number
        -- The number of observations that passed during execution.
        ObservationsPassed: number
        -- The number of observations that failed during execution.
        ObservationsFailed: number
    end

    enum TestCaseExecutionStatus
        "INITIATED"
        "PASSED"
        "FAILED"
        "IN_PROGRESS"
        "STOPPED"
    end

    record GetTestCaseExecutionSummaryOutput
        -- The timestamp when the test case execution started.
        StartTime: number
        -- The timestamp when the test case execution ended.
