    record DescribeAuthenticationProfileInput
        -- A unique identifier for the authentication profile.
        AuthenticationProfileId: string
        -- The identifier of the Connect Customer instance. You can find the instance ID in the Amazon Resource Name (ARN) of the instance.
        InstanceId: string
    end

    -- This API is in preview release for Connect Customer and is subject to change. To
    -- request access to this API, contact Amazon Web Services Support.
    -- Information about an authentication profile. An authentication profile is a resource that stores the
    -- authentication settings for users in your contact center. You use authentication profiles to set up IP address range
    -- restrictions and session timeouts. For more information, see Set IP address restrictions or session
    -- timeouts.
    record AuthenticationProfile
        -- A unique identifier for the authentication profile.
        Id: string
        -- The Amazon Resource Name (ARN) for the authentication profile.
        Arn: string
        -- The name for the authentication profile.
        Name: string
        -- The description for the authentication profile.
        Description: string
        -- A list of IP address range strings that are allowed to access the Connect Customer instance. For more
        -- information about how to configure IP addresses, see Configure IP address based access
        -- control in the Connect Customer Administrator Guide.
        AllowedIps: {string}
        -- A list of IP address range strings that are blocked from accessing the Connect Customer instance. For more
        -- information about how to configure IP addresses, see Configure IP address based access
        -- control in the Connect Customer Administrator Guide.
        BlockedIps: {string}
        -- Shows whether the authentication profile is the default authentication profile for the Connect Customer
        -- instance. The default authentication profile applies to all agents in an Connect Customer instance, unless
        -- overridden by another authentication profile.
        IsDefault: boolean
        -- The timestamp when the authentication profile was created.
        CreatedTime: number
        -- The timestamp when the authentication profile was last modified.
        LastModifiedTime: number
        -- The Amazon Web Services Region where the authentication profile was last modified.
        LastModifiedRegion: string
        -- The short lived session duration configuration for users logged in to Connect Customer, in minutes. This value
        -- determines the maximum possible time before an agent is authenticated. For more information, see Configure the session duration in the Connect Customer Administrator Guide.
        PeriodicSessionDuration: number
        -- The long lived session duration for users logged in to Connect Customer, in minutes. After this time period,
        -- users must log in again. For more information, see Configure the session
        -- duration in the Connect Customer Administrator Guide.
        MaxSessionDuration: number
        -- The period, in minutes, before an agent is automatically signed out of the contact center when they go
        -- inactive.
        SessionInactivityDuration: number
        -- Determines if automatic logout on user inactivity is enabled.
        SessionInactivityHandlingEnabled: boolean
    end

    record DescribeAuthenticationProfileOutput
        -- The authentication profile object being described.
        AuthenticationProfile: AuthenticationProfile
    end

    record DescribeContactInput
        -- The identifier of the Connect Customer instance. You can find the instance ID in the Amazon Resource Name (ARN) of the instance.
        InstanceId: string
        -- The identifier of the contact.
        ContactId: string
    end

    enum AnsweringMachineDetectionStatus
        "ANSWERED"
        "UNDETECTED"
        "ERROR"
        "HUMAN_ANSWERED"
        "SIT_TONE_DETECTED"
        "SIT_TONE_BUSY"
        "SIT_TONE_INVALID_NUMBER"
        "FAX_MACHINE_DETECTED"
        "VOICEMAIL_BEEP"
        "VOICEMAIL_NO_BEEP"
        "AMD_UNRESOLVED"
        "AMD_UNANSWERED"
        "AMD_ERROR"
        "AMD_NOT_APPLICABLE"
    end

    enum ParticipantType
        "ALL"
        "MANAGER"
        "AGENT"
        "CUSTOMER"
        "THIRDPARTY"
    end

    -- Information about a participant's interactions in a contact.
    record ParticipantMetrics
        -- The Participant's ID.
        ParticipantId: string
        -- Information about the conversation participant. Following are the participant types: [Agent, Customer,
        -- Supervisor].
        ParticipantType: string
        -- A boolean flag indicating whether the chat conversation was abandoned by a Participant.
        ConversationAbandon: boolean
        -- Number of chat messages sent by Participant.
        MessagesSent: number
        -- Number of chat messages sent by Participant.
        NumResponses: number
        -- Number of chat characters sent by Participant.
        MessageLengthInChars: number
        -- Total chat response time by Participant.
        TotalResponseTimeInMillis: number
        -- Maximum chat response time by Participant.
        MaxResponseTimeInMillis: number
        -- Timestamp of last chat message by Participant.
        LastMessageTimestamp: number
    end

    -- Information about the overall participant interactions at the contact level.
    record ChatContactMetrics
        -- A boolean flag indicating whether multiparty chat or supervisor barge were enabled on this contact.
        MultiParty: boolean
        -- The number of chat messages on the contact.
        TotalMessages: number
        -- The total number of bot and automated messages on a chat contact.
        TotalBotMessages: number
        -- The total number of characters from bot and automated messages on a chat contact.
        TotalBotMessageLengthInChars: number
        -- The time it took for a contact to end after the last customer message.
        ConversationCloseTimeInMillis: number
        -- The number of conversation turns in a chat contact, which represents the back-and-forth exchanges between
        -- customer and other participants.
        ConversationTurnCount: number
        -- The agent first response timestamp for a chat contact.
        AgentFirstResponseTimestamp: number
        -- The time for an agent to respond after obtaining a chat contact.
        AgentFirstResponseTimeInMillis: number
    end

    -- Information about how agent, bot, and customer interact in a chat contact.
    record ChatMetrics
        -- Information about the overall participant interactions at the contact level.
        ChatContactMetrics: ChatContactMetrics
        -- Information about agent interactions in a contact.
        AgentMetrics: ParticipantMetrics
        -- Information about customer interactions in a contact.
        CustomerMetrics: ParticipantMetrics
    end

    -- A map of string key/value pairs that contain user-defined attributes which are lightly typed within the contact.
    -- This object is used only for task contacts.
    record ContactDetails
        -- The name of the contact details.
        Name: string
        -- Teh description of the contact details.
        Description: string
    end

    enum Status
        "COMPLETE"
        "IN_PROGRESS"
        "DELETED"
    end

    -- Information about the contact evaluations where the key is the FormId, which is a unique identifier for the
    -- form.
    record ContactEvaluation
        -- The FormId of the contact evaluation.
        FormId: string
        -- The Amazon Resource Name for the evaluation form. It is always present.
        EvaluationArn: string
        -- The status of the evaluation.
        Status: string
        -- The date and time when the evaluation was started, in UTC time.
        StartTimestamp: number
        -- The date and time when the evaluation was submitted, in UTC time.
        EndTimestamp: number
        -- The date and time when the evaluation was deleted, in UTC time.
        DeleteTimestamp: number
        -- The path where evaluation was exported.
        ExportLocation: string
    end

    -- Information about the Customer on the contact.
    record Customer
        -- Information regarding Customer’s device.
        DeviceInfo: DeviceInfo
        Capabilities: ParticipantCapabilities
    end

    -- Information about the endpoint.
    record EndpointInfo
        -- Type of endpoint.
        Type: string
        -- Address of the endpoint.
        Address: string
        -- Display name of the endpoint.
        DisplayName: string
    end

    -- Information about customer’s voice activity.
    record CustomerVoiceActivity
        -- Timestamp that measures the beginning of the customer greeting from an outbound voice call.
        GreetingStartTimestamp: number
        -- Timestamp that measures the end of the customer greeting from an outbound voice call.
        GreetingEndTimestamp: number
    end

    -- Information about the call disconnect experience.
    record DisconnectDetails
        -- Indicates the potential disconnection issues for a call. This field is not populated if the service does not
        -- detect potential issues.
        PotentialDisconnectIssue: string
    end

    -- Information about the global resiliency configuration for the contact, including traffic distribution details.
    record GlobalResiliencyMetadata
        -- The current AWS region in which the contact is active. This indicates where the contact is being processed in real-time.
        ActiveRegion: string
        -- The AWS region where the contact was originally created and initiated. This may differ from the ActiveRegion if the contact has been transferred across regions.
        OriginRegion: string
        -- The identifier of the traffic distribution group.
        TrafficDistributionGroupId: string
    end

    -- Contact data associated with quick connect operations.
    record QuickConnectContactData
        -- The contact ID for quick connect contact data.
        ContactId: string
        -- Timestamp when the quick connect contact was initiated.
        InitiationTimestamp: number
        -- The quick connect ID.
        QuickConnectId: string
        -- The name of the quick connect.
        QuickConnectName: string
        -- The type of the quick connect.
        QuickConnectType: string
    end

    -- Metadata information for next contact.
    record NextContactMetadata
        -- Quick connect contact data for the next contact metadata.
        QuickConnectContactData: QuickConnectContactData
    end

    enum NextContactType
        "QUICK_CONNECT"
    end

    -- Entry representing the next contact in a sequence.
    record NextContactEntry
        -- The type of the next contact entry.
        Type: string
        -- Metadata for the next contact entry.
        NextContactMetadata: NextContactMetadata
    end

    -- Information about the quality of the Customer's media connection
    record CustomerQualityMetrics
        -- Information about the audio quality of the Customer
        Audio: AudioQualityMetricsInfo
    end

    -- Information about the quality of the participant's media connection.
    record QualityMetrics
        -- Information about the quality of Agent media connection.
        Agent: AgentQualityMetrics
        -- Information about the quality of Customer media connection.
        Customer: CustomerQualityMetrics
    end

    -- If this contact was queued, this contains information about the queue.
    record QueueInfo
        -- The unique identifier for the queue.
        Id: string
        -- The timestamp when the contact was added to the queue.
        EnqueueTimestamp: number
    end

    enum MediaStreamType
        "AUDIO"
        "VIDEO"
    end

    enum RecordingStatus
        "AVAILABLE"
        "DELETED"
    end

    -- Information about a voice recording, chat transcript, or screen recording.
    record RecordingInfo
        -- Where the recording/transcript is stored.
        StorageType: string
        -- The location, in Amazon S3, for the recording/transcript.
        Location: string
        -- Information about the media stream used during the conversation.
        MediaStreamType: string
        -- Information about the conversation participant, whether they are an agent or contact. The participant types are
        -- as follows:
        -- All
        -- Manager
        -- Agent
        -- Customer
        -- Thirdparty
        -- Supervisor
        ParticipantType: string
        -- The number that identifies the Kinesis Video Streams fragment where the customer audio stream started.
        FragmentStartNumber: string
        -- The number that identifies the Kinesis Video Streams fragment where the customer audio stream stopped.
        FragmentStopNumber: string
        -- When the conversation of the last leg of the recording started in UTC time.
        StartTimestamp: number
        -- When the conversation of the last leg of recording stopped in UTC time.
        StopTimestamp: number
        -- The status of the recording/transcript.
        Status: string
        -- If the recording/transcript was deleted, this is the reason entered for the deletion.
        DeletionReason: string
        -- The location, in Amazon S3, for the unprocessed transcript if any media processing was performed.
        UnprocessedTranscriptLocation: string
    end

    -- An object to specify the expiration of a routing step.
    record Expiry
        -- The number of seconds to wait before expiring the routing step.
        DurationInSeconds: number
        -- The timestamp indicating when the routing step expires.
        ExpiryTimestamp: number
    end

    -- An object to define AgentsCriteria.
    record MatchCriteria
        -- An object to define agentIds.
        AgentsCriteria: AgentsCriteria
    end

    -- An Object to define the minimum and maximum proficiency levels.
    record Range
        -- The minimum proficiency level of the range.
        MinProficiencyLevel: number
        -- The maximum proficiency level of the range.
        MaxProficiencyLevel: number
    end

    -- An object to specify the predefined attribute condition.
    record AttributeCondition
        -- The name of predefined attribute.
        Name: string
        -- The value of predefined attribute.
        Value: string
        -- The proficiency level of the condition.
        ProficiencyLevel: number
        -- An Object to define the minimum and maximum proficiency levels.
        Range: Range
        -- An object to define AgentsCriteria.
        MatchCriteria: MatchCriteria
        -- The operator of the condition.
        ComparisonOperator: string
    end

    enum RoutingCriteriaStepStatus
        "ACTIVE"
        "INACTIVE"
        "JOINED"
        "EXPIRED"
    end

    -- Information about the task template used to create this contact.
    record TaskTemplateInfoV2
        -- The Amazon Resource Name (ARN) of the task template used to create this contact.
        Arn: string
        -- The name of the task template used to create this contact.
        Name: string
    end

    -- Information about Connect Customer Wisdom.
    record WisdomInfo
        -- The Amazon Resource Name (ARN) of the Wisdom session.
        SessionArn: string
        -- The array of AI agents involved in the contact.
        AiAgents: {AiAgentInfo}
    end

    record DescribeContactEvaluationInput
        -- The identifier of the Connect Customer instance. You can find the instance ID in the Amazon Resource Name (ARN) of the instance.
        InstanceId: string
        -- A unique identifier for the contact evaluation.
        EvaluationId: string
    end

    enum QuestionRuleCategoryAutomationCondition
        "PRESENT"
        "NOT_PRESENT"
    end

    -- The milliseconds offset for transcript reference in suggested answer.
    record EvaluationSuggestedAnswerTranscriptMillisecondOffsets
        -- Offset in milliseconds from the beginning of the transcript.
        BeginOffsetMillis: number
    end

    -- Information about the point of interest in transcript provided to evaluation.
    record EvaluationTranscriptPointOfInterest
        -- Offset in milliseconds from the beginning of transcript.
        MillisecondOffsets: EvaluationSuggestedAnswerTranscriptMillisecondOffsets
        -- Segment of transcript.
        TranscriptSegment: string
    end

    -- The Contact Lens category used by evaluation automation.
    record EvaluationAutomationRuleCategory
        -- A category label.
        Category: string
        -- An automation condition for a Contact Lens category.
        Condition: string
        -- A point of interest in a contact transcript that indicates match of condition.
        PointsOfInterest: {EvaluationTranscriptPointOfInterest}
    end

    -- Analysis details providing explanation for Contact Lens automation decision.
    record EvaluationContactLensAnswerAnalysisDetails
        -- A list of match rule categories.
        MatchedRuleCategories: {EvaluationAutomationRuleCategory}
    end

    -- An analysis for a generative AI answer to the question.
    record EvaluationGenAIAnswerAnalysisDetails
        -- Generative AI automation answer justification.
        Justification: string
        -- Generative AI automation answer analysis points of interest.
        PointsOfInterest: {EvaluationTranscriptPointOfInterest}
    end

    -- Detailed analysis results of the automated answer to the evaluation question.
    record EvaluationQuestionAnswerAnalysisDetails
        -- Analysis results from the generative AI automation for the question.
        GenAI: EvaluationGenAIAnswerAnalysisDetails
        -- Analysis results from the Contact Lens automation for the question.
        ContactLens: EvaluationContactLensAnswerAnalysisDetails
    end

    enum EvaluationQuestionAnswerAnalysisType
        "CONTACT_LENS_DATA"
        "GEN_AI"
    end

    enum EvaluationTranscriptType
        "RAW"
        "REDACTED"
    end

    -- Details of the input data used for automated question processing.
    record EvaluationQuestionInputDetails
        -- Transcript type.
        TranscriptType: string
    end

    enum EvaluationSuggestedAnswerStatus
        "IN_PROGRESS"
        "FAILED"
        "SUCCEEDED"
    end

    -- Information about answer data for a contact evaluation. Answer data must be either string, numeric, or not
    -- applicable.
    record EvaluationAnswerData
        -- The string value for an answer in a contact evaluation.
        StringValue: string
        -- The numeric value for an answer in a contact evaluation.
        NumericValue: number
        -- String values provided as answers to evaluation questions.
        StringValues: {string}
        -- Date and time value provided as an answer to an evaluation question.
        DateTimeValue: string
        -- The flag to mark the question as not applicable.
        NotApplicable: boolean
    end

    -- The information about the suggested answer for the question.
    record EvaluationSuggestedAnswer
        Value: EvaluationAnswerData
        -- The status of the suggested answer. D
        Status: string
        -- Details about the input used to question automation.
        Input: EvaluationQuestionInputDetails
        -- Type of analysis used to provide suggested answer.
        AnalysisType: string
        -- Detailed analysis results.
        AnalysisDetails: EvaluationQuestionAnswerAnalysisDetails
    end

    -- Information about output answers for a contact evaluation.
    record EvaluationAnswerOutput
        -- The value for an answer in a contact evaluation.
        Value: EvaluationAnswerData
        -- The system suggested value for an answer in a contact evaluation.
        SystemSuggestedValue: EvaluationAnswerData
        -- Automation suggested answers for the questions.
        SuggestedAnswers: {EvaluationSuggestedAnswer}
    end

    enum EvaluationType
        "STANDARD"
        "CALIBRATION"
    end

    -- Information about the evaluation acknowledgement.
    record EvaluationAcknowledgement
        -- When the agent acknowledged the evaluation.
        AcknowledgedTime: number
        -- The agent who acknowledged the evaluation.
        AcknowledgedBy: string
        -- A comment from the agent when they confirmed they acknowledged the evaluation.
        AcknowledgerComment: string
    end

    enum AutoEvaluationStatus
        "IN_PROGRESS"
        "FAILED"
        "SUCCEEDED"
    end

    -- Details about automated evaluations.
    record AutoEvaluationDetails
        -- Whether automated evaluation is enabled.
        AutoEvaluationEnabled: boolean
        -- The status of the contact auto-evaluation.
        AutoEvaluationStatus: string
    end

    enum ContactParticipantRole
        "AGENT"
        "SYSTEM"
        "CUSTOM_BOT"
        "CUSTOMER"
    end

    -- Information about a contact participant in the evaluation.
    record EvaluationContactParticipant
        -- The role of the contact participant.
        ContactParticipantRole: string
        -- The identifier for the contact participant.
        ContactParticipantId: string
    end

    -- A comment provided when requesting an evaluation review.
    record EvaluationReviewRequestComment
        -- The text content of the review request comment.
        Comment: string
        -- The timestamp when the evaluation review request comment was created.
        CreatedTime: number
        -- The user who created the evaluation review request comment.
        CreatedBy: string
    end

    -- Metadata information about an evaluation review.
    record EvaluationReviewMetadata
        -- The unique identifier for the evaluation review.
        ReviewId: string
        -- The timestamp when the evaluation review was requested.
        RequestedTime: number
        -- The user who requested the evaluation review.
        RequestedBy: string
        -- The timestamp when the evaluation review was created.
        CreatedTime: number
        -- The user who created the evaluation review.
        CreatedBy: string
        -- Comments provided when requesting the evaluation review.
        ReviewRequestComments: {EvaluationReviewRequestComment}
    end

    -- Information about scores of a contact evaluation item (section or question).
    record EvaluationScore
        -- The score percentage for an item in a contact evaluation.
        Percentage: number
        -- The flag to mark the item as not applicable for scoring.
        NotApplicable: boolean
        -- The flag that marks the item as automatic fail. If the item or a child item gets an automatic fail answer, this
        -- flag will be true.
        AutomaticFail: boolean
        -- Weight applied to this evaluation score.
        AppliedWeight: number
        -- The points earned for the item.
        EarnedPoints: number
        -- The maximum base points possible for the item.
        MaxBasePoint: number
        -- The performance category for the score.
        PerformanceCategory: string
    end

    -- Metadata information about a contact evaluation.
    record EvaluationMetadata
        -- The identifier of the contact in this instance of Connect Customer.
        ContactId: string
        -- The Amazon Resource Name (ARN) of the user who last updated the evaluation.
        EvaluatorArn: string
        -- The identifier of the agent who performed the contact.
        ContactAgentId: string
        -- The calibration session ID that this evaluation belongs to.
        CalibrationSessionId: string
        -- The overall score of the contact evaluation.
        Score: EvaluationScore
        -- Information related to automated evaluation.
        AutoEvaluation: AutoEvaluationDetails
        -- Information related to evaluation acknowledgement.
        Acknowledgement: EvaluationAcknowledgement
        -- Information about reviews of this evaluation.
        Review: EvaluationReviewMetadata
        -- Information about a contact participant in this evaluation.
        ContactParticipant: EvaluationContactParticipant
        -- Identifier of the sampling job.
        SamplingJobId: string
    end

    -- Information about notes for a contact evaluation.
    record EvaluationNote
        -- The note for an item (section or question) in a contact evaluation.
        -- Even though a note in an evaluation can have up to 3072 chars, there is also a limit on the total number of
        -- chars for all the notes in the evaluation combined. Assuming there are N questions in the evaluation being
        -- submitted, then the max char limit for all notes combined is N x 1024.
        Value: string
    end

    enum EvaluationStatus
        "DRAFT"
        "SUBMITTED"
        "REVIEW_REQUESTED"
        "UNDER_REVIEW"
    end

    -- Information about a contact evaluation.
    record Evaluation
        -- A unique identifier for the contact evaluation.
        EvaluationId: string
        -- The Amazon Resource Name (ARN) for the contact evaluation resource.
        EvaluationArn: string
        -- Metadata about the contact evaluation.
        Metadata: EvaluationMetadata
        -- A map of question identifiers to answer value.
        Answers: {string : EvaluationAnswerOutput}
        -- A map of question identifiers to note value.
        Notes: {string : EvaluationNote}
        -- The status of the contact evaluation.
        Status: string
        -- A map of item (section or question) identifiers to score value.
        Scores: {string : EvaluationScore}
        -- The timestamp for when the evaluation was created.
        CreatedTime: number
        -- The timestamp for when the evaluation was last updated.
        LastModifiedTime: number
        -- Type of the evaluation.
        EvaluationType: string
        -- The tags used to organize, track, or control access for this resource. For example, { "Tags": {"key1":"value1", "key2":"value2"} }.
        Tags: {string : string}
    end

    -- The flow has not been published.
    record ContactFlowNotPublishedException
        Message: string
    end

    record DescribeContactFlowInput
        -- The identifier of the Connect Customer instance.
        InstanceId: string
        -- The identifier of the flow.
        ContactFlowId: string
    end

    enum ContactFlowState
        "ACTIVE"
        "ARCHIVED"
    end

    -- Contains information about a flow.
    record ContactFlow
        -- The Amazon Resource Name (ARN) of the flow.
        Arn: string
        -- The identifier of the flow.
        Id: string
        -- The name of the flow.
        Name: string
        -- The type of the flow. For descriptions of the available types, see Choose a flow type in the
        -- Connect Customer Administrator Guide.
        Type: string
        -- The type of flow.
        State: string
        -- The status of the flow.
        Status: string
        -- The description of the flow.
        Description: string
        -- The JSON string that represents the content of the flow. For an example, see Example
        -- flow in Connect Customer Flow language.
        -- Length Constraints: Minimum length of 1. Maximum length of 256000.
        Content: string
        -- The tags used to organize, track, or control access for this resource. For example, { "Tags": {"key1":"value1", "key2":"value2"} }.
        Tags: {string : string}
        -- Indicates the checksum value of the flow content.
        FlowContentSha256: string
        -- The identifier of the flow version.
        Version: number
        -- The description of the flow version.
        VersionDescription: string
        -- The time at which the flow was last modified.
        LastModifiedTime: number
        -- The region in which the flow was last modified
        LastModifiedRegion: string
    end

    record DescribeContactFlowOutput
        -- Information about the flow.
        ContactFlow: ContactFlow
    end

    record DescribeContactFlowModuleInput
        -- The identifier of the Connect Customer instance. You can find the instance ID in the Amazon Resource Name (ARN) of the instance.
        InstanceId: string
        -- The identifier of the flow module.
        ContactFlowModuleId: string
    end

    enum ContactFlowModuleState
        "ACTIVE"
        "ARCHIVED"
    end

    enum ContactFlowModuleStatus
        "PUBLISHED"
        "SAVED"
    end

    -- Contains information about a flow module.
    record ContactFlowModule
        -- The Amazon Resource Name (ARN).
        Arn: string
        -- The identifier of the flow module.
        Id: string
        -- The name of the flow module.
        Name: string
        -- The JSON string that represents the content of the flow. For an example, see Example
        -- flow in Connect Customer Flow language.
        Content: string
        -- The description of the flow module.
        Description: string
        -- The type of flow module.
        State: string
        -- The status of the flow module.
        Status: string
        -- The tags used to organize, track, or control access for this resource. For example, { "Tags": {"key1":"value1", "key2":"value2"} }.
        Tags: {string : string}
        -- Hash of the module content for integrity verification.
        FlowModuleContentSha256: string
        -- The version of the flow module.
        Version: number
        -- Description of the version.
        VersionDescription: string
        -- The configuration settings for the flow module.
        Settings: string
        -- The external invocation configuration for the flow module
        ExternalInvocationConfiguration: ExternalInvocationConfiguration
    end

    record DescribeContactFlowModuleOutput
        -- Information about the flow module.
        ContactFlowModule: ContactFlowModule
    end

